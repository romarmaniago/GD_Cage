<!-- Modal: guest broadcast by Telegram chat ID (separate from agent announcement modal) -->
<style>
	#modal-new-broadcast .broadcast-chat-ids {
		font-family: ui-monospace, Consolas, monospace;
		font-size: 0.875rem;
	}
	/* Guest broadcast SweetAlert: sariling progress — hindi Bootstrap .progress-bar (tinatanggal ang animation/transition kapag prefers-reduced-motion). */
	@keyframes bc-swal-indet-slide {
		0% {
			transform: translateX(-100%);
		}
		100% {
			transform: translateX(280%);
		}
	}
	@keyframes bc-swal-indet-pulse {
		0%,
		100% {
			opacity: 0.35;
		}
		50% {
			opacity: 1;
		}
	}
	.bc-swal-indet-track {
		height: 12px;
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.1);
		overflow: hidden;
		position: relative;
	}
	.bc-swal-indet-chunk {
		position: absolute;
		left: 0;
		top: 0;
		height: 100%;
		width: 40%;
		border-radius: inherit;
		background: linear-gradient(90deg, #0d6efd, #6ea8fe);
		animation: bc-swal-indet-slide 1.05s ease-in-out infinite;
		will-change: transform;
	}
	@media (prefers-reduced-motion: reduce) {
		.bc-swal-indet-chunk {
			animation: bc-swal-indet-pulse 1s ease-in-out infinite;
			width: 100%;
			transform: none;
		}
	}
	.bc-swal-fill-track {
		height: 10px;
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.1);
		overflow: hidden;
	}
	.bc-swal-fill-inner {
		height: 100%;
		width: 0;
		border-radius: inherit;
		transition: width 0.45s ease;
	}
	.swal2-container .bc-swal-timer-bar {
		background: #0d6efd !important;
		opacity: 1 !important;
	}
	#modal-new-broadcast .broadcast-picture-dropzone {
		position: relative;
		min-height: 220px;
		border: 2px dashed #cbd5e1;
		border-radius: 0.375rem;
		background-color: #f8fafc;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}
	#modal-new-broadcast .broadcast-picture-dropzone.is-dragover {
		border-color: #0d6efd;
		background-color: rgba(13, 110, 253, 0.07);
	}
	#modal-new-broadcast .broadcast-picture-dropzone-inner {
		pointer-events: none;
		text-align: center;
		padding: 1rem 1.25rem;
		color: #64748b;
		font-size: 0.95rem;
		line-height: 1.4;
		max-width: 28rem;
	}
	#modal-new-broadcast .broadcast-picture-dropzone-inner i {
		font-size: 2.5rem;
		display: block;
		margin-bottom: 0.5rem;
		color: #94a3b8;
	}
	#modal-new-broadcast .broadcast-picture-input {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		cursor: pointer;
		z-index: 2;
	}
</style>
<div class="modal fade" id="modal-new-broadcast" role="dialog" aria-labelledby="modal-new-broadcast-label" aria-hidden="true"
	data-keyboard="false" data-bs-backdrop="static">
	<div class="modal-dialog modal-dialog-centered modal-xl" role="document">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="block-title text-white" id="modal-new-broadcast-label"><%= __('modal_new_broadcast.title') %></h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<form id="form-new-broadcast" enctype="multipart/form-data">
					<div class="row mb-3">
						<div class="col-sm-12">
							<label class="form-label"><%= __('modal_new_broadcast.guest_chat_ids') %></label>
							<% const _broadcastChatIdsPlaceholder = __('modal_new_broadcast.chat_ids_placeholder'); %>
							<textarea
								class="form-control broadcast-chat-ids"
								id="broadcast-chat-ids"
								name="chat_ids_text"
								rows="6"
								<% if (_broadcastChatIdsPlaceholder && String(_broadcastChatIdsPlaceholder).trim()) { %>placeholder="<%= _broadcastChatIdsPlaceholder %>"<% } %>
								autocomplete="off"></textarea>
							<% const _broadcastChatIdsHint = __('modal_new_broadcast.chat_ids_hint'); %>
							<% if (_broadcastChatIdsHint && String(_broadcastChatIdsHint).trim()) { %>
							<small class="form-text text-muted"><%= _broadcastChatIdsHint %></small>
							<% } %>
						</div>
					</div>

					<div class="row mb-3">
						<div class="col-sm-12">
							<label class="form-label"><%= __('modal_new_broadcast.message') %></label>
							<textarea
								class="form-control"
								id="broadcast-message"
								name="message"
								rows="4"
								placeholder="<%= __('modal_new_broadcast.message_placeholder') %>"></textarea>
							<small class="form-text text-muted"><%= __('modal_new_broadcast.message_hint') %></small>
						</div>
					</div>

					<div class="row mb-3">
						<div class="col-sm-12">
							<label class="form-label" for="broadcast-picture"><%= __('modal_new_broadcast.picture') %></label>
							<div class="mb-2">
							<div class="broadcast-picture-dropzone" id="broadcast-picture-dropzone">
								<input
									type="file"
									class="broadcast-picture-input"
									id="broadcast-picture"
									name="picture"
									accept="image/*"
									aria-label="<%= __('modal_new_broadcast.picture') %>">
								<div class="broadcast-picture-dropzone-inner">
									<i class="fa fa-cloud-upload" aria-hidden="true"></i>
									<span><%= __('modal_new_broadcast.picture_dropzone_hint') %></span>
								</div>
							</div>
							<small class="form-text text-muted"><%= __('modal_new_broadcast.picture_formats_hint') %></small>
							</div>
							<div id="broadcast-picture-preview-container" class="d-none mt-2">
								<img id="broadcast-picture-preview" src="" alt="Preview" class="img-thumbnail" style="max-width: 300px; max-height: 300px;">
								<button type="button" class="btn btn-sm btn-danger ms-2" id="broadcast-remove-picture-btn">
									<i class="fa fa-times"></i> <%= __('modal_new_broadcast.remove') %>
								</button>
							</div>
						</div>
					</div>

					<div class="modal-footer">
						<button type="submit" class="btn btn-sm btn-primary" id="submit-broadcast-btn">
							<i class="fa fa-paper-plane"></i> <%= __('modal_new_broadcast.send') %>
						</button>
						<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('modal_new_broadcast.close') %></button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
<script>
window.broadcastModalTranslations = {
	validation_error: "<%= __('modal_new_broadcast.validation_error') %>",
	please_enter_message_or_picture: "<%= __('modal_new_broadcast.please_enter_message_or_picture') %>",
	please_enter_chat_ids: "<%= __('modal_new_broadcast.please_enter_chat_ids') %>",
	sending: "<%= __('modal_new_broadcast.sending') %>",
	sending_to_recipients: "<%= __('modal_new_broadcast.sending_to_recipients') %>",
	partial_success: "<%= __('modal_new_broadcast.partial_success') %>",
	success: "<%= __('modal_new_broadcast.success') %>",
	error: "<%= __('modal_new_broadcast.error') %>",
	failed_to_send: "<%= __('modal_new_broadcast.failed_to_send') %>",
	error_occurred: "<%= __('modal_new_broadcast.error_occurred') %>",
	send: "<%= __('modal_new_broadcast.send') %>"
};
</script>
