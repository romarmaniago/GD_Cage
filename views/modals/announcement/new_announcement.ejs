<!-- Modal for New Announcement -->
<style>
	#modal-new-announcement .announcement-agent-cb,
	#modal-new-announcement .announcement-select-all-cb {
		width: 1rem;
		height: 1rem;
		border: 2px solid #1f3a8a;
		border-radius: 0.25rem;
		background-color: #fff;
		cursor: pointer;
		accent-color: #1f3a8a;
		flex-shrink: 0;
	}
	#modal-new-announcement .announcement-agent-cb {
		margin-top: 0.2em;
	}
	#modal-new-announcement .announcement-select-all-cb {
		margin-top: 0;
	}
	#modal-new-announcement .announcement-agent-cb:checked,
	#modal-new-announcement .announcement-select-all-cb:checked {
		background-color: #1f3a8a;
		border-color: #1f3a8a;
	}
	#modal-new-announcement .announcement-agent-cb:focus,
	#modal-new-announcement .announcement-select-all-cb:focus {
		border-color: #1f3a8a;
		box-shadow: 0 0 0 0.2rem rgba(31, 58, 138, 0.28);
	}
	#modal-new-announcement .announcement-agents-search-wrap {
		max-width: 220px;
		flex: 0 0 auto;
	}
	#modal-new-announcement .announcement-picture-dropzone {
		position: relative;
		min-height: 220px;
		border: 2px dashed #cbd5e1;
		border-radius: 0.375rem;
		background-color: #f8fafc;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}
	#modal-new-announcement .announcement-picture-dropzone.is-dragover {
		border-color: #1f3a8a;
		background-color: rgba(31, 58, 138, 0.07);
	}
	#modal-new-announcement .announcement-picture-dropzone-inner {
		pointer-events: none;
		text-align: center;
		padding: 1rem 1.25rem;
		color: #64748b;
		font-size: 0.95rem;
		line-height: 1.4;
		max-width: 28rem;
	}
	#modal-new-announcement .announcement-picture-dropzone-inner i {
		font-size: 2.5rem;
		display: block;
		margin-bottom: 0.5rem;
		color: #94a3b8;
	}
	#modal-new-announcement .announcement-picture-input {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		cursor: pointer;
		z-index: 2;
	}
</style>
<div class="modal fade" id="modal-new-announcement" role="dialog" aria-labelledby="modal-new-announcement-label" aria-hidden="true"
	data-keyboard="false" data-bs-backdrop="static">
	<div class="modal-dialog modal-dialog-centered modal-xl" role="document">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="block-title text-white" id="modal-new-announcement-label"><%= __('modal_new_announcement.new_announcement') %></h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			
			<div class="modal-body">
				<form id="form-new-announcement" enctype="multipart/form-data">
					<div class="row mb-3">
						<div class="col-sm-12">
							<label class="form-label"><%= __('modal_new_announcement.message') %></label>
							<textarea 
								class="form-control" 
								id="announcement-message" 
								name="message" 
								rows="5" 
								placeholder="<%= __('modal_new_announcement.message_placeholder') %>"></textarea>
							<small class="form-text text-muted"><%= __('modal_new_announcement.message_hint') %></small>
						</div>
					</div>
					
					<div class="row mb-3">
						<div class="col-sm-12">
							<label class="form-label" for="announcement-picture"><%= __('modal_new_announcement.picture') %></label>
							<div class="mb-2">
							<div class="announcement-picture-dropzone" id="announcement-picture-dropzone">
								<input
									type="file"
									class="announcement-picture-input"
									id="announcement-picture"
									name="picture"
									accept="image/*"
									aria-label="<%= __('modal_new_announcement.picture') %>">
								<div class="announcement-picture-dropzone-inner">
									<i class="fa fa-cloud-upload" aria-hidden="true"></i>
									<span><%= __('modal_new_announcement.picture_dropzone_hint') %></span>
								</div>
							</div>
							<small class="form-text text-muted"><%= __('modal_new_announcement.picture_formats_hint') %></small>
							</div>
							<div id="picture-preview-container" class="d-none mt-2">
								<img id="picture-preview" src="" alt="Preview" class="img-thumbnail" style="max-width: 300px; max-height: 300px;">
								<button type="button" class="btn btn-sm btn-danger ms-2" id="remove-picture-btn">
									<i class="fa fa-times"></i> <%= __('modal_new_announcement.remove') %>
								</button>
							</div>
						</div>
					</div>

					<div class="row mb-3">
						<div class="col-sm-12">
							<label class="form-label">Recipients (Telegram)</label>
							<div class="d-flex align-items-center justify-content-between gap-2 flex-wrap w-100 mb-2">
								<div class="d-flex align-items-center gap-1 flex-shrink-0">
									<input type="checkbox" class="form-check-input announcement-select-all-cb mt-0 flex-shrink-0" id="announcement-select-all-cb" autocomplete="off">
									<label class="form-check-label small mb-0 text-nowrap" for="announcement-select-all-cb">Select all</label>
								</div>
								<div class="announcement-agents-search-wrap flex-shrink-0">
									<input type="search" class="form-control form-control-sm w-100" id="announcement-agents-search" placeholder="Search" autocomplete="off">
								</div>
							</div>
							<div class="border rounded p-2" style="max-height: 260px; overflow-y: auto;">
								<div id="announcement-agents-list" class="row g-2"></div>
							</div>
						</div>
					</div>
					
					<div class="modal-footer">
						<button type="submit" class="btn btn-sm btn-primary" id="submit-announcement-btn">
							<i class="fa fa-paper-plane"></i> <%= __('modal_new_announcement.send_announcement') %>
						</button>
						<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('modal_new_announcement.close') %></button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
<script>
window.announcementModalTranslations = {
	validation_error: "<%= __('modal_new_announcement.validation_error') %>",
	please_enter_message_or_picture: "<%= __('modal_new_announcement.please_enter_message_or_picture') %>",
	please_select_at_least_one_agent: "Please select at least one agent.",
	loading_agents: "Loading agents...",
	load_agents_failed: "Could not load the agent list.",
	no_agents_available: "No active agents with a Telegram ID.",
	sending: "<%= __('modal_new_announcement.sending') %>",
	success: "<%= __('modal_new_announcement.success') %>",
	error: "<%= __('modal_new_announcement.error') %>",
	failed_to_send: "<%= __('modal_new_announcement.failed_to_send') %>",
	error_occurred: "<%= __('modal_new_announcement.error_occurred') %>",
	send_announcement: "<%= __('modal_new_announcement.send_announcement') %>"
};
</script>
