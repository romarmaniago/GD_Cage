<!-- MODAL: Account Ledger -->
<div class="modal fade" id="modal-account-ledger" tabindex="-1" aria-labelledby="modal-account-ledgerLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
       <div class="modal-content">
         
         <!-- Modal Header -->
         <div class="modal-header bg-primary">
          <h5 class="modal-title text-white" id="modal-account-ledgerLabel">
            Records | <span id="agency_name_modal"></span>
          </h5>
          
          <div class="d-flex align-items-center ms-auto gap-2">
             <button class="btn btn-primary-subtle" onclick="addAgent()">
               <i class="fa fa-plus"></i> New Guest
             </button>
             
           </div>
         </div>
         
         <!-- Modal Body -->
         <div class="modal-body">
           
           <!-- Dito natin ilalagay ang table at ibang elemento -->
           
           <!-- Kung kailangan mo pa rin ng permissions -->
           <div id="user-role" data-permissions="<%= permissions %>"></div>
           
           <table id="modal-account-tbl" class="table table-bordered table-responsive">
             <thead>
               <tr>
                 <th>NAME</th>
                 <th>ACCOUNT #</th>            
                 <th>TELEGRAM CHAT ID</th>
                 <th>CONTACT #</th>
                 <th>REMARKS</th>
                 <th>TOTAL BALANCE</th>
                 <th>ACTION</th>
               </tr>
             </thead>
             <tfoot>
              <tr>
                <th colspan="5">SUB TOTAL</th>
                <th colspan="1" id="SUB_TOTAL_SUM_VALUE">0.00</th>
                <th colspan="1"></th>
              </tr>
               <tr>
                 <th colspan="5">GRAND TOTAL</th>
                 <th colspan="1" id="TOTAL_SUM_VALUE">0.00</th>
                 <th colspan="1"></th>
               </tr>
             </tfoot>
           </table>
         </div>
         <div class="modal-footer">
				
					<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Close</button>
				</div>
       </div>
     </div>
   </div>
  
  <div class="modal fade" id="modal-transfer-agency" tabindex="-1" aria-labelledby="modal-transfer-agencyLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header bg-primary">
          <h5 class="modal-title text-white" id="modal-transfer-agencyLabel">Change Line</h5>
        </div>

        <form id="transfer-agency-form">
          <div class="modal-body">
            <input type="hidden" id="transfer_from_agency_id" name="fromAgencyId">
            <!-- Comma-separated agent IDs to PUT /agency/remove after a successful transfer (set from Agents delete flow) -->
            <input type="hidden" id="transfer_archive_agency_ids_after" value="" aria-hidden="true">

            <div class="mb-2 transfer-meta d-flex justify-content-between align-items-center">
              <div class="text-muted">
                <strong id="transfer_from_agency_name">-</strong>
              </div>
              <div class="text-muted text-end">
                Selected: <strong id="transfer_selected_count">0</strong>
              </div>
            </div>

            <div class="mb-3 border rounded p-2">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label mb-0">Select Accounts</label>
                <div class="form-check mb-0">
                  <input class="form-check-input" type="checkbox" id="transfer_select_all_accounts">
                  <label class="form-check-label small" for="transfer_select_all_accounts">Select all</label>
                </div>
              </div>
              <div class="mb-2">
                <div class="position-relative">
                  <input
                    type="text"
                    class="form-control form-control-sm pe-4"
                    id="transfer_account_search"
                    placeholder="Search account code or name..."
                  >
                  <button
                    type="button"
                    id="transfer_account_search_clear"
                    class="btn position-absolute end-0 top-50 translate-middle-y me-2 p-0 border-0 bg-transparent d-none"
                    aria-label="Clear search"
                  >
                    <i class="fa fa-times text-muted small"></i>
                  </button>
                </div>
              </div>
              <div id="transfer-account-list" class="small">
                <div class="text-muted">Loading accounts...</div>
              </div>
            </div>

            <div class="mb-3">
              <label for="transfer_to_agency_id" class="form-label">Transfer To</label>
              <select class="form-select" id="transfer_to_agency_id" name="toAgencyId" required>
                <option value="">Select target line</option>
              </select>
            </div>
          </div>

          <div class="modal-footer">
            <button type="submit" class="btn btn-sm btn-primary" id="btn-submit-transfer-agency">Transfer</button>
            <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </form>
      </div>
    </div>
  </div>
   
   <!-- Kung gusto mo isama pa rin ang iba pang modals (new_account, edit_account, etc.) -->
  
   
   <!-- CUSTOM STYLES para sa table mo -->
   <style>
    #modal-account-tbl {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
    table-layout: fixed;
    word-wrap: break-word;
}

/* Header styles */
#modal-account-tbl thead th {
    background: var(--bs-primary-bg-subtle);
    color: var(--bs-primary);
    font-weight: 500;
    padding: 12px 15px;
    text-align: left;
    border: none;
}

/* Row styles */
#modal-account-tbl tbody tr {
    border-bottom: 1px solid #eee;
}

/* Cell styles - default allow wrapping */
#modal-account-tbl td {
    padding: 12px 15px;
    color: #666;
    white-space: normal;
    overflow: visible;
}

/* REMARKS column (5th column) - allow text wrapping with max width */
#modal-account-tbl th:nth-child(5),
#modal-account-tbl td:nth-child(5) {
    max-width: 200px;
    word-wrap: break-word;
    white-space: normal;
    overflow-wrap: break-word;
}

/* TOTAL BALANCE column (6th column) - right align */
#modal-account-tbl th:nth-child(6),
#modal-account-tbl td:nth-child(6) {
    text-align: right;
    color: #333;
}

/* ACTION column (last column) - keep on one line */
#modal-account-tbl th:last-child,
#modal-account-tbl td:last-child {
    white-space: nowrap;
}

#modal-account-tbl tbody tr:hover {
  background-color: #f5f5f5 !important;
}

#transfer-account-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 12px;
  row-gap: 2px;
  max-height: min(48vh, 420px);
  min-height: 140px;
  overflow-y: auto;
  padding-right: 4px;
}

.transfer-account-col {
  min-width: 0;
}

.transfer-account-col .form-check-label {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: inline-block;
  max-width: 100%;
}

.transfer-meta .text-muted {
  font-size: 16px;
  line-height: 1.4;
}


/* Footer total row */


#modal-account-tbl tfoot th {
    padding: 10px;
    font-weight: 600;
   
    color: #333;
    background-color: #f4f6fa;
    border-top: 2px solid #dee2e6;
}

            
            @media (max-width: 768px) {
                #modal-account-tbl {
                    font-size: 10px; /* Mas maliit sa mobile */
                }
            
                #modal-account-tbl th,
                #modal-account-tbl td {
                    padding: 5px;
                }
            }
     
     /* Itago ang text na "Show" at "entries" sa DataTables */
     .dataTables_length label {
       font-size: 0; /* Itatago ang text */
     }
     
     /* Panatilihin ang dropdown na nakikita */
     .dataTables_length select {
       font-size: 12px; /* Ibalik ang font size ng dropdown */
     }
     
     /* Adjust spacing and alignment for date range picker */
     .dataTables_wrapper .row {
       margin-bottom: 15px;
       font-size: 12px; /* Pareho sa commission-tbl */
     }
     
     /* Flexbox layout for the date range picker */
     .input-daterange {
       display: flex;
       justify-content: space-between;
       position: relative;
       left: 7.5rem;
       top: 4rem;
       max-width: 300px;
       font-size: 12px; /* Pareho sa commission-tbl */
     }
     
     /* Styling for form controls */
     .input-daterange .form-control {
       flex: 1;
       margin-right: 5px;
       max-width: 120px;
       font-size: 12px; /* Pareho sa commission-tbl */
       padding: 8px; /* Pareho sa cell padding ng table */
     }
     
     /* Remove margin from the last input */
     .input-daterange .form-control:last-child {
       margin-right: 0;
     }
     
     /* Responsive tweaks */
     @media (max-width: 768px) {
       .dataTables_wrapper .row,
       .input-daterange,
       .input-daterange .form-control {
         font-size: 10px; /* Mas maliit sa mobile */
       }
       
       .input-daterange .form-control {
         padding: 5px; /* Mas maliit na padding */
       }

       #transfer-account-list {
        grid-template-columns: 1fr;
       }
     }


   </style>
   
   
 
   