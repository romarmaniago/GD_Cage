<script>
(function () {
    const accountPhoto = document.getElementById('account_photo');
    const zoomedImage = document.getElementById('zoomed-image');
    const modalChangePhoto = document.getElementById('modal-change-photo');
    const prevImg = document.getElementById('change-photo-previous');
    const dropzone = document.getElementById('change-photo-dropzone');
    const fileInput = document.getElementById('change-photo-file-input');
    const placeholder = document.getElementById('change-photo-placeholder');
    const changePhotoLoading = document.getElementById('change-photo-loading');
    const newPreview = document.getElementById('change-photo-new-preview');
    const saveBtn = document.getElementById('change-photo-save-btn');

    var changePhotoFaceFile = null;
    var changePhotoPassportFile = null;
    var changePhotoExtract = null;
    var changePhotoScanning = false;

    function resetChangePhotoPending() {
        changePhotoFaceFile = null;
        changePhotoPassportFile = null;
        changePhotoExtract = null;
        changePhotoScanning = false;
    }

    function setChangePhotoScanningUI(isScanning) {
        changePhotoScanning = !!isScanning;
        if (dropzone) dropzone.classList.toggle('is-scanning', !!isScanning);
        if (changePhotoLoading) changePhotoLoading.classList.toggle('d-none', !isScanning);
        if (placeholder && isScanning) placeholder.classList.add('d-none');
        if (isScanning && newPreview) {
            newPreview.classList.add('d-none');
            newPreview.src = '';
        }
    }

    function showChangePhotoPreview(previewSrc, faceFile) {
        setChangePhotoScanningUI(false);
        changePhotoFaceFile = faceFile;
        newPreview.src = previewSrc;
        newPreview.classList.remove('d-none');
        placeholder.classList.add('d-none');
        if (saveBtn) saveBtn.disabled = !changePhotoFaceFile;
    }

    function appendPassportFieldsToFormData(formData, extract) {
        if (!extract || !changePhotoPassportFile) return;
        formData.append('passportImage', changePhotoPassportFile);
        formData.append('txtDocumentType', extract.document_type || '');
        formData.append('txtCountryCode', extract.country_code || '');
        formData.append('txtPassportNo', extract.passport_number || '');
        formData.append('txtFullName', extract.full_name || '');
        formData.append('txtNationality', extract.nationality || '');
        formData.append('txtDateOfBirth', extract.date_of_birth || '');
        formData.append('txtExpiryDate', extract.expiry_date || '');
        formData.append('txtGender', extract.gender || '');
        formData.append('txtMrzLine', extract.mrz_line || '');
    }

    function runChangePhotoScan(file) {
        resetChangePhotoPending();
        if (saveBtn) saveBtn.disabled = true;
        setChangePhotoScanningUI(true);

        function finishWithFaceOnly(dataUrl) {
            if (typeof window.cropFaceFromDataUrl !== 'function') {
                changePhotoFaceFile = file;
                showChangePhotoPreview(dataUrl, file);
                return Promise.resolve();
            }
            return window.cropFaceFromDataUrl(dataUrl).then(function (face) {
                showChangePhotoPreview(face.previewDataUrl || dataUrl, face.file);
            }).catch(function () {
                changePhotoFaceFile = file;
                showChangePhotoPreview(dataUrl, file);
            });
        }

        var scanPromise;
        if (typeof window.extractPassportFromFile === 'function') {
            scanPromise = window.extractPassportFromFile(file).then(function (r) {
                var extract = r.extract;
                if (!extract || extract.is_passport === false) {
                    return finishWithFaceOnly(r.dataUrl || '');
                }
                changePhotoExtract = extract;
                changePhotoPassportFile = file;
                if (typeof window.cropFaceFromDataUrl !== 'function') {
                    throw new Error('Face crop is not available. Please refresh the page.');
                }
                return window.cropFaceFromDataUrl(r.dataUrl).then(function (face) {
                    showChangePhotoPreview(face.previewDataUrl || r.dataUrl, face.file);
                });
            }).catch(function (err) {
                return new Promise(function (resolve, reject) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        var dataUrl = e.target && e.target.result ? String(e.target.result) : '';
                        finishWithFaceOnly(dataUrl).then(resolve).catch(reject);
                    };
                    reader.onerror = function () { reject(err); };
                    reader.readAsDataURL(file);
                });
            });
        } else {
            scanPromise = new Promise(function (resolve, reject) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var dataUrl = e.target && e.target.result ? String(e.target.result) : '';
                    finishWithFaceOnly(dataUrl).then(resolve).catch(reject);
                };
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        return scanPromise
            .catch(function (err) {
                resetChangePhotoPending();
                setChangePhotoScanningUI(false);
                if (placeholder) placeholder.classList.remove('d-none');
                var msg = (err && err.message) ? err.message : 'Failed to process image.';
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Image processing failed', text: msg });
                } else {
                    alert(msg);
                }
            })
            .finally(function () {
                if (changePhotoScanning) setChangePhotoScanningUI(false);
            });
    }

    // Zoom preview on hover
    accountPhoto.addEventListener('mouseover', function () {
        zoomedImage.src = accountPhoto.src;
        zoomedImage.classList.add('show');
    });
    accountPhoto.addEventListener('mouseout', function () {
        zoomedImage.classList.remove('show');
    });

    // Passport Details button
    var btnPassportDetails = document.getElementById('btn-passport-details');
    var modalPassportDetails = document.getElementById('modal-passport-details');
    if (btnPassportDetails && modalPassportDetails) {
        btnPassportDetails.addEventListener('click', function () {
            var accountId = document.getElementById('account_id_add') && document.getElementById('account_id_add').value;
            if (typeof window.prepareGuestPortalChildModal === 'function') {
                window.prepareGuestPortalChildModal($(modalPassportDetails));
            }
            var Modal = typeof bootstrap !== 'undefined' ? bootstrap.Modal : (typeof Bootstrap !== 'undefined' ? Bootstrap.Modal : null);
            if (Modal) Modal.getOrCreateInstance(modalPassportDetails).show();
            else $(modalPassportDetails).modal('show');
            document.getElementById('passport-details-loading').classList.remove('d-none');
            document.getElementById('passport-details-empty').classList.add('d-none');
            document.getElementById('passport-details-content').classList.add('d-none');

            // If no account yet (New Guest flow) but we have a pending extraction from the upload, show it immediately.
            if (!accountId && window.__pendingPassportExtract) {
                document.getElementById('passport-details-loading').classList.add('d-none');
                document.getElementById('passport-details-content').classList.remove('d-none');
                var p = window.__pendingPassportExtract || {};
                document.getElementById('p-doc-type').textContent = p.document_type || '—';
                document.getElementById('p-country').textContent = p.country_code || '—';
                document.getElementById('p-passport-no').textContent = p.passport_number || '—';
                document.getElementById('p-full-name').textContent = p.full_name || '—';
                document.getElementById('p-nationality').textContent = p.nationality || '—';
                document.getElementById('p-dob').textContent = p.date_of_birth || '—';
                document.getElementById('p-expiry').textContent = p.expiry_date || '—';
                document.getElementById('p-gender').textContent = p.gender || '—';
                document.getElementById('p-contact').textContent = '—';
                document.getElementById('p-telegram').textContent = '—';
                document.getElementById('p-remarks').textContent = '—';
                var img = document.getElementById('passport-detail-image');
                if (window.__pendingPassportImageDataUrl) {
                    img.src = window.__pendingPassportImageDataUrl;
                    img.style.display = '';
                } else {
                    img.style.display = 'none';
                }
                return;
            }

            if (!accountId) {
                document.getElementById('passport-details-loading').classList.add('d-none');
                document.getElementById('passport-details-empty').classList.remove('d-none');
                return;
            }

            Promise.all([
                fetch('/account_passport_details/' + accountId).then(function (res) { return res.json(); }).catch(function () { return null; }),
                fetch('/account_passportphoto_data/' + accountId).then(function (res) { return res.json(); }).catch(function () { return []; })
            ])
                .then(function (results) {
                    var data = results[0];
                    var accountRows = results[1];
                    var accountInfo = Array.isArray(accountRows) && accountRows.length ? accountRows[0] : null;
                    var hasPassport = !!(data && typeof data === 'object' && !data.error);
                    document.getElementById('passport-details-loading').classList.add('d-none');

                    // Always show Info table so Details section (contact/telegram/remarks) is visible
                    // even when passport fields are not available yet.
                    document.getElementById('passport-details-content').classList.remove('d-none');
                    document.getElementById('passport-details-empty').classList.add('d-none');

                    document.getElementById('p-doc-type').textContent = hasPassport ? (data.DOCUMENT_TYPE || '—') : '—';
                    document.getElementById('p-country').textContent = hasPassport ? (data.COUNTRY_CODE || '—') : '—';
                    document.getElementById('p-passport-no').textContent = hasPassport ? (data.PASSPORT_NO || '—') : '—';
                    document.getElementById('p-full-name').textContent = hasPassport ? (data.FULL_NAME || '—') : '—';
                    document.getElementById('p-nationality').textContent = hasPassport ? (data.NATIONALITY || '—') : '—';
                    document.getElementById('p-dob').textContent = hasPassport && data.DATE_OF_BIRTH
                        ? (window.fmtDate ? window.fmtDate(data.DATE_OF_BIRTH, '—') : String(data.DATE_OF_BIRTH).slice(0, 10))
                        : '—';
                    document.getElementById('p-expiry').textContent = hasPassport && data.EXPIRY_DATE
                        ? (window.fmtDate ? window.fmtDate(data.EXPIRY_DATE, '—') : String(data.EXPIRY_DATE).slice(0, 10))
                        : '—';
                    document.getElementById('p-gender').textContent = hasPassport ? (data.GENDER || '—') : '—';
                    document.getElementById('p-contact').textContent = accountInfo && accountInfo.agent_contact ? accountInfo.agent_contact : '—';
                    document.getElementById('p-telegram').textContent = accountInfo && accountInfo.agent_telegram ? accountInfo.agent_telegram : '—';
                    document.getElementById('p-remarks').textContent = accountInfo && accountInfo.agent_remarks ? accountInfo.agent_remarks : '—';
                    var img = document.getElementById('passport-detail-image');
                    if (hasPassport && data.PASSPORT_IMAGE) {
                        img.src = '/PassportUpload/' + data.PASSPORT_IMAGE;
                        img.style.display = '';
                    } else {
                        img.style.display = 'none';
                    }
                })
                .catch(function () {
                    document.getElementById('passport-details-loading').classList.add('d-none');
                    document.getElementById('passport-details-empty').classList.remove('d-none');
                });
        });
    }

    // Passport image zoom on hover (like Guest Portal face)
    var passportDetailImg = document.getElementById('passport-detail-image');
    var passportZoomed = document.getElementById('passport-zoomed-image');
    if (passportDetailImg && passportZoomed) {
        passportDetailImg.addEventListener('mouseover', function () {
            if (passportDetailImg.src && !passportDetailImg.src.endsWith('undefined')) {
                passportZoomed.src = passportDetailImg.src;
                passportZoomed.classList.add('show');
            }
        });
        passportDetailImg.addEventListener('mouseout', function () {
            passportZoomed.classList.remove('show');
        });
    }
    if (modalPassportDetails && passportZoomed) {
        modalPassportDetails.addEventListener('hidden.bs.modal', function () {
            passportZoomed.classList.remove('show');
        });
    }

    // Open change-photo modal when edit icon is clicked (JS so modal shows even when nested/sibling)
    var btnOpenChangePhoto = document.getElementById('btn-open-change-photo');
    if (btnOpenChangePhoto && modalChangePhoto) {
        btnOpenChangePhoto.addEventListener('click', function () {
            if (typeof window.prepareGuestPortalChildModal === 'function') {
                window.prepareGuestPortalChildModal($(modalChangePhoto));
            }
            var Modal = typeof bootstrap !== 'undefined' ? bootstrap.Modal : (typeof Bootstrap !== 'undefined' ? Bootstrap.Modal : null);
            if (Modal) {
                Modal.getOrCreateInstance(modalChangePhoto).show();
            } else {
                $(modalChangePhoto).modal('show');
            }
        });
    }

    // When change-photo modal opens: show previous image, reset new
    if (modalChangePhoto) {
        modalChangePhoto.addEventListener('show.bs.modal', function () {
            prevImg.src = accountPhoto.src || '';
            prevImg.alt = 'Current';
            resetChangePhotoPending();
            if (fileInput) fileInput.value = '';
            setChangePhotoScanningUI(false);
            if (placeholder) placeholder.classList.remove('d-none');
            newPreview.classList.add('d-none');
            newPreview.src = '';
            if (saveBtn) saveBtn.disabled = true;
        });
    }

    function setNewFile(file) {
        if (!file || !file.type.startsWith('image/')) return;
        runChangePhotoScan(file);
    }

    // Click dropzone = open file picker
    if (dropzone && fileInput) {
        dropzone.addEventListener('click', function (e) {
            if (e.target === fileInput || e.target.closest('input')) return;
            fileInput.click();
        });
        fileInput.addEventListener('change', function () {
            var f = this.files && this.files[0];
            setNewFile(f);
        });
    }

    // Drag and drop
    if (dropzone) {
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(function (ev) {
            dropzone.addEventListener(ev, function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (ev === 'dragenter' || ev === 'dragover') dropzone.classList.add('drag-over');
                else dropzone.classList.remove('drag-over');
                if (ev === 'drop') {
                    var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
                    setNewFile(f);
                }
            });
        });
    }

    // Save button
    if (saveBtn) {
        saveBtn.addEventListener('click', function () {
            if (changePhotoScanning) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'info', title: 'Please wait', text: 'Still processing the image.' });
                }
                return;
            }
            if (!changePhotoFaceFile) return;
            var accountIdEl = document.getElementById('account_id_add');
            var accountId = accountIdEl && accountIdEl.value && accountIdEl.value.trim();
            if (!accountId) {
                if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'Error', text: 'Account not found' });
                else alert('Account not found');
                return;
            }
            saveBtn.disabled = true;
            var formData = new FormData();
            formData.append('photo', changePhotoFaceFile);
            appendPassportFieldsToFormData(formData, changePhotoExtract);
            fetch('/account/' + accountId + '/update_photo', { method: 'POST', body: formData })
                .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
                .then(function (result) {
                    if (result.ok && result.data.success) {
                        var savedPhoto = result.data.photo
                            ? '/PassportUpload/' + result.data.photo
                            : newPreview.src;
                        accountPhoto.src = savedPhoto;
                        zoomedImage.src = savedPhoto;
                        prevImg.src = savedPhoto;
                        var modal = bootstrap.Modal.getInstance(modalChangePhoto);
                        if (modal) modal.hide();
                        var successText = result.data.passportUpdated
                            ? 'Profile photo and passport details were updated.'
                            : 'Profile photo saved.';
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({ icon: 'success', title: 'Photo saved', text: successText, timer: 2200, showConfirmButton: false });
                        }
                    } else {
                        var msg = (result.data && result.data.error) ? result.data.error : 'Failed to save photo';
                        if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'Error', text: msg });
                        else alert(msg);
                    }
                })
                .catch(function () {
                    if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to save photo' });
                    else alert('Failed to save photo');
                })
                .finally(function () { saveBtn.disabled = false; });
        });
    }
})();
</script>

