<!-- Account Details Modal -->
<div class="modal fade" id="modal-account-details" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header justify-content-center position-relative guest-portal-header">
                <div class="guest-portal-title-wrap text-center" id="staticBackdropLiveLabel">
                    <img
                        class="guest-portal-logo"
                        src="/assets/images/gd-background-logo22.png"
                        alt="Golden Dragon"
                        decoding="async"
                    >
                    <h5 class="guest-portal-title mb-0">AGENT PORTAL</h5>
                </div>
                <button type="button" class="btn-close position-absolute end-0 me-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Left Side: Account Photo & Details -->
                    <div class="col-xl-3 col-lg-4">
                        <div class="card">
                            <div class="header-title d-flex justify-content-center text-center">
                                <h4 class="card-title mb-0 d-flex flex-column align-items-center">
                                    <span id="agent_code"></span>
                                    <span id="account_name"></span>
                                </h4>
                            </div>
                            <div class="card-body">
                                <form id="add_new_account_details_alt">
                                    <input type="hidden" id="account_id_add" name="txtAccountId">
                                    <input type="hidden" id="account_agent_id" value="">
                                    <input type="hidden" id="total_balanceGuest" name="totalBalanceGuest" />
                                    <img id="zoomed-image" src="" alt="Zoomed Account Photo"> 
                                    <div class="form-group">
                                        <div class="d-flex justify-content-center align-items-center">
                                            <div class="profile-img-edit position-relative d-flex justify-content-center align-items-center flex-wrap">
                                                <!-- Primary account photo -->
                                                <img id="account_photo" src="/assets/images/guest-default-profile.webp" alt="Account Photo" class="theme-color-default-img profile-pic rounded avatar-100" onerror="this.onerror=null;this.src='/assets/images/guest-default-profile.webp';"> 
                                                <!-- Iba pang avatar options... -->
                                                <button type="button" class="upload-icone bg-primary account-photo-upload-label p-0 d-inline-flex align-items-center justify-content-center" id="btn-open-change-photo" title="Change photo">
                                                    <svg class="upload-button icon-14" width="14" viewBox="0 0 24 24" pointer-events="none">
                                                        <path fill="#ffffff" d="M14.06,9L15,9.94L5.92,19H5V18.08L14.06,9M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3M14.06,6.19L3,17.25V21H6.75L17.81,9.94L14.06,6.19Z" />
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="form-group">
                                        <table id="dataTable" class="table table-vcenter table-hover" style="background-color: #f9f9f9; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                                            <thead>
                                                <tr>
                                                    <th class="text-center" style="width: 100%; font-size: 12px; padding: 10px 0; background-color: #F5E7BD; color: #1a1a1a;"><%= __('modal_account_details.total_balance') %></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td class="fw-bold text-center" style="font-size: 24px; color: #333;">
                                                        <span class="total_balance"></span>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="form-group d-none" id="credit-iou-card">
                                        <table class="table table-vcenter table-hover" style="background-color: #f9f9f9; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                                            <thead>
                                                <tr>
                                                    <th class="text-center text-white" style="width: 100%; font-size: 12px; padding: 10px 0; background-color: #1e3a5f;"><%= __('modal_account_details.credit_iou') %></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td class="fw-bold text-center" style="font-size: 24px; color: #333;">
                                                        <span class="credit_balance"></span>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="form-group">
                                        <div class="form-check">
                                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="1" id="cash_trans" name="txtTrans">
                                            <label class="form-check-label" for="cash_trans">
                                                <span class="d-flex align-items-center"><%= __('modal_account_details.deposit') %></span>
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="2" id="deposit_trans" name="txtTrans">
                                            <label class="form-check-label" for="deposit_trans">
                                                <span class="d-flex align-items-center"><%= __('modal_account_details.withdraw') %></span>
                                            </label>
                                        </div>
                                        <!-- <div class="form-check">
                                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="3" id="issue_trans" name="txtTrans">
                                            <label class="form-check-label" for="issue_trans">
                                                <span class="d-flex align-items-center"><%= __('modal_account_details.credit') %></span>
                                            </label>
                                        </div> -->
                                        <div class="form-check">
                                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="transfer_trans" name="transferAction" onclick="transfer_account()">
                                            <label class="form-check-label" for="transfer_trans">
                                                <span class="d-flex align-items-center"><%= __('modal_account_details.transfer_account') %></span>
                                            </label>
                                        </div>
                                    </div>
                                 
                                    
                                    <div class="form-group">
                                        <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
                                               class="form-control txtAmount txtAmount_alt" name="txtAmount" placeholder="<%= __('modal_account_details.amount_placeholder') %>" required>
                                    </div>
                                    <div class="form-group">
                                        <input type="text" name="txtRemarks" class="form-control remarks remarks_alt" placeholder="<%= __('modal_account_details.remarks_placeholder') %>">
                                    </div>
                                    
                                    <div class="form-group">
                                        <input class="form-check-input mb-3" type="checkbox" id="sendToTelegram" name="sendToTelegram" style="display: none;" checked>
                                        <label class="form-check-label ms-2" for="sendToTelegram" style="display: none;">
                                            <%= __('modal_account_details.send_to_telegram') %>
                                        </label>
                                        <button type="submit" class="btn btn-primary-subtle w-100">
                                            <i class="fa fa-check-circle me-1"></i><%= __('modal_account_details.update') %>
                                        </button>
                                    </div>
                                    
                                    <div class="form-group mb-0">
                                        <button type="button" class="btn btn-info-subtle w-100" id="balanceCheckBtn">
                                            <i class="fa fa-exclamation-circle me-1"></i> <%= __('modal_account_details.balance_check') %>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-9 col-lg-8">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div class="header-title flex-grow-1 min-w-0">
                                    <div class="d-flex flex-nowrap align-items-center gap-2 w-100" style="min-width: 0;">
                                        <label for="agent_remarks_notice" class="mb-0 small fw-semibold text-nowrap"><%= __('modal_account_details.remarks') %></label>
                                        <input type="text" id="agent_remarks_notice" class="form-control form-control-sm flex-grow-1 min-w-0" style="min-width: 5rem;" placeholder="<%= __('modal_account_details.remarks_placeholder') %>" autocomplete="off" maxlength="5000" aria-label="<%= __('modal_account_details.agent_remarks') %>">
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <!-- Removed daterangepicker input and filter button -->
                                </div>
                            </div>
                                <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 guest-portal-action-row">
                                    <button type="button" class="btn btn-sm btn-success" id="btn-guest-portal-game-start"><%= __('modal_account_details.game_start') %></button>
                                    <div class="d-flex flex-wrap justify-content-end gap-2 ms-auto">
                                        <button type="button" class="btn btn-sm btn-success" id="btn-filter-deposit">Deposit</button>
                                        <button type="button" class="btn btn-sm btn-warning" id="btn-filter-withdraw">Withdraw</button>
                                        <button type="button" class="btn btn-sm btn-info" id="btn-filter-transfer">Transfer</button>
                                        <button type="button" class="btn btn-sm btn-alt-secondary" id="btn-reset-account-details-filter" data-bs-toggle="tooltip" data-bs-placement="top" title="Reset filter">
                                            <i class="fa fa-refresh"></i>
                                        </button>
                                        <button class="btn btn-sm btn-success" onclick="game_history($('#account_id').val() || $('#account_id_add').val())">Game</button>
                                        <button type="button" class="btn btn-sm btn-primary" id="btn-credit">Credit</button>
                                        <button type="button" class="btn btn-sm btn-secondary" id="btn-passport-details" title="Info">
                                            <i class="fa fa-id-card me-1"></i>Info
                                        </button>
                                    </div>
                                </div>
                                <input type="hidden" id="account_id">
                                <div id="guest-portal-daterange-host" class="d-none" aria-hidden="true">
                                    <div id="guest-portal-daterange-wrap" class="guest-portal-daterange-wrap">
                                        <input type="text" id="guest-portal-daterange" class="form-control form-control-sm guest-portal-daterange" placeholder="<%= __('modal_account_details.select_date_range') %>" autocomplete="off" readonly>
                                    </div>
                                </div>
                                <div id="guest-portal-print-export-host" class="d-none" aria-hidden="true">
                                    <div id="guest-portal-print-export" class="guest-portal-print-export">
                                        <button type="button" class="btn btn-alt-success" id="btn-guest-portal-print">
                                            <i class="fa fa-print me-1" aria-hidden="true"></i><%= __('modal_account_details.print') %>
                                        </button>
                                        <button type="button" class="btn btn-success" id="btn-guest-portal-export">
                                            <i class="fa fa-file-excel me-1" aria-hidden="true"></i><%= __('modal_account_details.export') %>
                                        </button>
                                    </div>
                                </div>
                                <table id="accountDetails" class="table table-bordered nowrap table-responsive" style="width: 100%;">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 150px;"><%= __('modal_account_details.date') %></th>
                                            <th class="text-center" style="width: 200px;"><%= __('modal_account_details.transaction') %></th>
                                            <th class="text-center" style="width: 100px;"><%= __('modal_account_details.amount') %></th>
                                            <th class="text-center" style="width: 110px;"><%= __('modal_account_details.balance_after') %></th>
                                            <th class="text-center" style="width: 150px;"><%= __('modal_account_details.remarks') %></th>
                                            <th class="text-center account-ledger-actions-col" style="width: 110px;"><%= __('modal_account_details.action') %></th>
                                            <th class="d-none account-ledger-id-col" aria-hidden="true"></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
                        <%= __('modal_account_details.close') %>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Account Ledger (Super Admin only) -->
<div class="modal fade" id="modal-edit-account-ledger" tabindex="-1" aria-labelledby="modalEditAccountLedgerLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="modalEditAccountLedgerLabel"><%= __('modal_account_details.edit_transaction') %></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-ledger-id" value="">
                <div class="mb-3">
                    <label class="form-label mb-1" for="edit-ledger-amount"><%= __('modal_account_details.amount') %></label>
                    <input type="text" class="form-control" id="edit-ledger-amount" onkeypress="return onlyNumberKey(event)" data-type="number" placeholder="<%= __('modal_account_details.amount_placeholder') %>" autocomplete="off">
                </div>
                <div class="mb-0">
                    <label class="form-label mb-1" for="edit-ledger-remarks"><%= __('modal_account_details.remarks') %></label>
                    <input type="text" class="form-control" id="edit-ledger-remarks" maxlength="500" placeholder="<%= __('modal_account_details.remarks_placeholder') %>" autocomplete="off">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('modal_account_details.close') %></button>
                <button type="button" class="btn btn-sm btn-primary" id="btn-save-edit-ledger"><%= __('modal_account_details.save') %></button>
            </div>
        </div>
    </div>
</div>

<!-- Guest Portal ledger receipt slip -->
<div class="modal fade" id="modal-guest-portal-receipt" tabindex="-1" aria-labelledby="modalGuestPortalReceiptLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered guest-portal-receipt-dialog">
        <div class="modal-content guest-portal-receipt-content position-relative">
            <button type="button" class="btn-close guest-portal-receipt-close-btn" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-body p-0">
                <div id="guest-portal-receipt-container" class="guest-portal-receipt-container"></div>
            </div>
        </div>
    </div>
</div>

<!-- Credit Details Modal (Per Account) -->
<div class="modal fade" id="modal-credit-details" tabindex="-1" aria-labelledby="modalCreditDetailsLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered credit-modal-xl">
        <div class="modal-content border-0 shadow-sm">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white d-flex align-items-center gap-2" id="modalCreditDetailsLabel">
                    <i class="fa fa-credit-card"></i>
                    <span>Credit Details - <span id="credit-account-title"></span></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="credit-details-loading" class="text-center py-4 d-none">
                    <div class="spinner-border text-primary mb-2" role="status"><span class="visually-hidden">Loading...</span></div>
                    <p class="text-muted mb-0">Loading credit details...</p>
                </div>
                <div class="row g-2 mb-3 credit-balance-row">
                    <div class="col-12 col-md-6">
                        <div class="credit-balance-box">
                            <label class="form-label text-muted small mb-1">Cash Credit</label>
                            <div id="credit-junket-balance" class="credit-balance-value">0</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="credit-balance-box">
                            <label class="form-label text-muted small mb-1">Game Credit</label>
                            <div id="credit-game-balance" class="credit-balance-value">0</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end mb-2">
                    <button type="button" class="btn btn-sm btn-primary" id="btn-credit-return">
                        Return Credit
                    </button>
                </div>
                <div class="credit-history-dt-wrap credit-history-card table-responsive">
                    <table class="table marker-history-table w-100 mb-0" id="credit-details-table">
                        <thead>
                            <tr>
                                <th>ACCOUNT NAME</th>
                                <th class="text-center" style="width: 130px;">AMOUNT</th>
                                <th>TRANSACTION TYPE</th>
                                <th class="text-center" style="width: 180px;">DATE</th>
                                <th style="width: 220px;">REMARKS</th>
                            </tr>
                        </thead>
                        <tbody id="credit-details-body"></tbody>
                    </table>
                </div>
            </div>
            <!-- <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Close</button>
            </div> -->
        </div>
    </div>
</div>

<!-- Return Credit Modal (Credit Details page) -->
<div class="modal fade" id="modal-credit-return" tabindex="-1" aria-labelledby="modalCreditReturnLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="modalCreditReturnLabel">Return Credit</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="credit-return-account-id" />
                <input type="hidden" id="credit-return-junket-balance" />
                <input type="hidden" id="credit-return-game-balance" />

                <div class="row g-2 mb-3 credit-balance-row">
                    <div class="col-12 col-md-6">
                        <div class="credit-balance-box">
                            <label class="form-label text-muted small mb-1">Cash Credit</label>
                            <div id="credit-return-junket-balance-display" class="credit-balance-value">0</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="credit-balance-box">
                            <label class="form-label text-muted small mb-1">Game Credit</label>
                            <div id="credit-return-game-balance-display" class="credit-balance-value">0</div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex flex-wrap justify-content-center" style="column-gap: 2.25rem; row-gap: 0.75rem;">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="creditReturnSource" id="credit-return-source-credit" value="credit" required>
                            <label class="form-check-label" for="credit-return-source-credit">Cash Credit</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="creditReturnSource" id="credit-return-source-buyin" value="buyin" required>
                            <label class="form-check-label" for="credit-return-source-buyin">Game Credit</label>
                        </div>
                    </div>
                    <label class="form-label mb-1 mt-2" for="credit-return-balance">Balance</label>
                    <input type="text" class="form-control" id="credit-return-balance" value="" readonly>
                </div>

                <div class="mb-3">
                    <div class="d-flex flex-wrap justify-content-center" style="column-gap: 2.25rem; row-gap: 0.75rem;">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="creditReturnTransType" id="credit-return-trans-cash" value="11" required>
                            <label class="form-check-label" for="credit-return-trans-cash">Cash</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="creditReturnTransType" id="credit-return-trans-deposit" value="12" required>
                            <label class="form-check-label" for="credit-return-trans-deposit">Deposit</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label mb-1" for="credit-return-amount">Amount</label>
                    <input type="text" class="form-control" id="credit-return-amount" placeholder="Enter amount" autocomplete="off">
                </div>

                <div class="mb-0">
                    <label class="form-label mb-1" for="credit-return-remarks">Remarks (optional)</label>
                    <input type="text" class="form-control" id="credit-return-remarks" maxlength="500" placeholder="Remarks" autocomplete="off">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-primary" id="btn-save-credit-return">Save</button>
                <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Cancel</button>               
            </div>
        </div>
    </div>
</div>

<!-- Passport Details Modal -->
<div class="modal fade" id="modal-passport-details" tabindex="-1" aria-labelledby="modalPassportDetailsLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content passport-details-modal-content border-0 shadow-lg overflow-hidden">
            <div class="modal-header passport-details-header py-3 px-4">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-semibold" id="modalPassportDetailsLabel">
                    <i class="fa fa-id-card"></i> Info
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-white passport-details-body">
                <div id="passport-details-loading" class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;"><span class="visually-hidden">Loading...</span></div>
                    <p class="text-muted mb-0"><%= __('modal_account_details.passport_loading') %></p>
                </div>
                <div id="passport-details-empty" class="text-center d-flex flex-column align-items-center justify-content-center h-100 d-none">
                    <div class="passport-empty-icon mb-3">
                        <i class="fa fa-id-card-o text-secondary"></i>
                    </div>
                    <p class="text-muted mb-0 text-center w-100"><%= __('modal_account_details.passport_empty') %></p>
                </div>
                <div id="passport-details-content" class="d-none">
                    <div class="row g-4 align-items-stretch">
                        <div class="col-12 col-md-5 d-flex">
                            <div class="passport-image-wrapper rounded-3 overflow-hidden position-relative w-100 d-flex align-items-center justify-content-center">
                                <img id="passport-detail-image" src="" alt="Passport" class="passport-detail-img w-100">
                                <div class="passport-hover-hint"><i class="fa fa-search-plus me-1"></i>Hover to enlarge</div>
                                <img id="passport-zoomed-image" src="" alt="Passport zoomed" class="passport-zoomed">
                            </div>
                        </div>
                        <div class="col-12 col-md-7 d-flex">
                            <div class="passport-details-card rounded-3 overflow-hidden w-100">
                                <table class="table table-bordered passport-modal-details-table mb-0 w-100">
                                    <tbody>
                                        <tr><th colspan="2" class="passport-section-title">Details</th></tr>
                                        <tr><th scope="row">Contact no.</th><td id="p-contact">—</td></tr>
                                        <tr><th scope="row">Telegram chat id</th><td id="p-telegram">—</td></tr>
                                        <tr><th scope="row">Remarks</th><td id="p-remarks">—</td></tr>
                                        <tr class="passport-section-gap"><td colspan="2"></td></tr>
                                        <tr><th colspan="2" class="passport-section-title">Passport Details</th></tr>
                                        <tr><th scope="row"><%= __('modal_account_details.passport_lbl_document_type') %></th><td id="p-doc-type">—</td></tr>
                                        <tr><th scope="row"><%= __('modal_account_details.passport_lbl_country_code') %></th><td id="p-country">—</td></tr>
