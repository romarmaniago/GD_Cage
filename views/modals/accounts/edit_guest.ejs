<style>
body.modal-open #modal-edit-guest-table.show {
	z-index: 1065;
}
body.modal-open .modal-backdrop.show ~ .modal-backdrop.show {
	z-index: 1060;
}
</style>
<div class="modal fade" id="modal-edit-guest-table" tabindex="-1" aria-labelledby="modal-edit-guest-table-label" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white" id="modal-edit-guest-table-label"><%= typeof __ !== 'undefined' ? __('agency.edit_guest') : 'Edit Guest' %></h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="edit_guest_form">
				<div class="modal-body">
					<input type="hidden" id="edit_guest_id" name="txtGuestId">
					<div class="mb-0">
						<label for="edit_guest_name_input" class="form-label">Guest Name</label>
						<input type="text" class="form-control" id="edit_guest_name_input" name="txtGuestName" required maxlength="150">
					</div>
					<div class="mt-2 mb-0">
						<label for="edit_guest_membership_input" class="form-label">Membership No</label>
						<input type="text" class="form-control" id="edit_guest_membership_input" name="txtMembershipNo" required inputmode="numeric" autocomplete="off" placeholder="8–10 digits">
					</div>
					<div class="mt-2 mb-0">
						<label for="edit_guest_remarks_input" class="form-label">Remarks</label>
						<textarea class="form-control" id="edit_guest_remarks_input" name="txtRemarks" rows="2" maxlength="500"></textarea>
					</div>
				</div>
				<div class="modal-footer">
					<button type="submit" class="btn btn-primary btn-sm" id="btn-update-guest-table">Update</button>
					<button type="button" class="btn btn-alt-secondary btn-sm" data-bs-dismiss="modal">Close</button>
				</div>
			</form>
		</div>
	</div>
</div>
