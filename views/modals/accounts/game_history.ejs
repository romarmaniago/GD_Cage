    display: inline-flex;

    align-items: center;

    gap: 0.4rem;

    margin: 0;

    flex: 0 0 auto;

}



#modal-game-history #game-history-daterange-mount .flatpickr-wrapper {

    flex: 0 0 auto;

}



#modal-game-history #game-history-daterange-mount .form-control,

#modal-game-history #game-history-daterange-mount .flatpickr-alt-input {

    border-radius: 8px;

    font-size: 0.8125rem;

    background-color: #fff;

}



#modal-game-history .game-history-table-card {

    background: linear-gradient(180deg, #fafbfc 0%, #ffffff 48px);

    border: 1px solid rgba(15, 23, 42, 0.08);

    border-radius: 12px;

    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);

    padding: 0;

    overflow: auto;

}



#modal-game-history .game-history-table-card #game-history-tbl {

    border: none;

    margin-bottom: 0;

}



#modal-game-history .game-history-table-card #game-history-tbl > thead > tr > th {

    border-top: none;

    border-bottom: 1px solid #e9ecef;

}



#modal-game-history .game-history-table-card #game-history-tbl > tbody > tr > td {

    border-top: none;

    border-bottom: 1px solid #f1f3f5;

}



#modal-game-history .game-history-table-card #game-history-tbl > tbody > tr:last-child > td {

    border-bottom: none;

}

</style>



<script>

(function() {

    let gameHistoryModal = null;

    let gameHistoryDataTable = null;

    let gameHistoryDateFilterRegistered = false;

    let gameHistoryDatePicker = null;

    let gameHistoryToolbarBound = false;

    let gameHistoryAccountId = null;

    let ghRangeStart = null;

    let ghRangeEnd = null;



    const parseYmd = (str) => {

        if (!str) return null;

        const d = new Date(String(str).trim().slice(0, 10) + 'T00:00:00');

        return isNaN(d.getTime()) ? null : d;

    };



    function registerGameHistoryDateFilter() {

        if (gameHistoryDateFilterRegistered) return;

        if (!($.fn.dataTable && $.fn.dataTable.ext)) return;

        gameHistoryDateFilterRegistered = true;

        $.fn.dataTable.ext.search.push(function (settings, data) {

            if (settings.nTable.id !== 'game-history-tbl') return true;

            if (!ghRangeStart && !ghRangeEnd) return true;

            const rowDate = parseYmd(data[0]);

            if (!rowDate) return false;

            if (ghRangeStart && rowDate < ghRangeStart) return false;

            if (ghRangeEnd && rowDate > ghRangeEnd) return false;

            return true;

        });

    }



    const atMidnight = (d) => new Date(d.getFullYear(), d.getMonth(), d.getDate());



    // Same month-end cut-off default range used by the other date filters.

    function getDefaultGhRange() {

        if (window.MonthEndCutoffRange && typeof window.MonthEndCutoffRange.getMonthEndCutoffRange === 'function') {

            const r = window.MonthEndCutoffRange.getMonthEndCutoffRange();

            return { start: atMidnight(r.startAt), end: atMidnight(r.endAt), defaultDate: r.defaultDate };

        }

        const now = new Date();

        const y = now.getFullYear();

        const m = now.getMonth();

        const startAt = new Date(y, m, 0);

        const endAt = new Date(y, m + 1, 0);

        endAt.setDate(endAt.getDate() - 1);

        return { start: atMidnight(startAt), end: atMidnight(endAt), defaultDate: [startAt, endAt] };

    }



    function applyDefaultGhRange() {

        const d = getDefaultGhRange();

        ghRangeStart = d.start;

        ghRangeEnd = d.end;

        if (gameHistoryDatePicker) gameHistoryDatePicker.setDate(d.defaultDate, false);

    }



    function initGameHistoryDatePicker() {

        if (gameHistoryDatePicker || typeof flatpickr === 'undefined') return;

        const def = getDefaultGhRange();

        gameHistoryDatePicker = flatpickr('#game-history-daterange', {

            mode: 'range',

            showMonths: 3,

            defaultDate: def.defaultDate,

            onChange: function (selectedDates) {

                if (selectedDates.length === 2) {

                    ghRangeStart = new Date(selectedDates[0].getFullYear(), selectedDates[0].getMonth(), selectedDates[0].getDate());

                    ghRangeEnd = new Date(selectedDates[1].getFullYear(), selectedDates[1].getMonth(), selectedDates[1].getDate());

                } else if (selectedDates.length === 0) {

                    ghRangeStart = null;

                    ghRangeEnd = null;

                } else {

                    return;

                }

                if (gameHistoryDataTable) gameHistoryDataTable.draw();

            }

        });

        applyDefaultGhRange();

    }



    function resetGameHistoryDateFilter() {

        applyDefaultGhRange();

    }



    function placeGameHistoryDateFilter() {

        const $mount = $('#game-history-daterange-mount');

        const $length = $('#game-history-tbl_wrapper .dataTables_length').first();

        if ($mount.length && $length.length &&

            !($mount.hasClass('is-placed') && $mount.prev()[0] === $length[0])) {

            $mount.detach().insertAfter($length).addClass('is-placed');

        }



        const $actions = $('#game-history-actions-mount');

        const $filter = $('#game-history-tbl_wrapper .dataTables_filter').first();

        if ($actions.length && $filter.length &&

            !($actions.hasClass('is-placed') && $actions.next()[0] === $filter[0])) {

            $actions.detach().insertBefore($filter).addClass('is-placed');

        }

    }



    const stripHtml = (v) => String(v == null ? '' : v)

        .replace(/<[^>]*>/g, ' ')

        .replace(/&nbsp;/g, ' ')

        .replace(/\s+/g, ' ')

        .trim();



    function getGameHistoryTablePayload() {

        const headers = [];

        $('#game-history-tbl thead th').each(function () {

            headers.push($(this).text().trim());

        });

        const rows = [];

        if (gameHistoryDataTable) {

            gameHistoryDataTable.rows({ search: 'applied', order: 'applied' }).every(function (rowIdx) {

                const row = [];

                for (let c = 0; c < headers.length; c++) {

                    row.push(stripHtml(gameHistoryDataTable.cell(rowIdx, c).render('display')));

                }

                rows.push(row);

            });

        }

        return { headers, rows };

    }



    function getGameHistoryRangeLabel() {

        const val = $('#game-history-daterange').val();

        return val ? val.replace(/\s+to\s+/i, ' to ') : 'All dates';

    }



    function getGameHistoryExportFilename() {

        const now = new Date();

        const ts = now.getFullYear() + ('0' + (now.getMonth() + 1)).slice(-2) + ('0' + now.getDate()).slice(-2);

        const acct = gameHistoryAccountId ? ('-' + gameHistoryAccountId) : '';

        return 'GameHistory' + acct + '-' + ts + '.xlsx';

    }



    function notifyGameHistory(icon, title, text) {

        if (typeof Swal !== 'undefined') {

            Swal.fire({ icon: icon, title: title, text: text, confirmButtonColor: '#0d6efd' });

        } else {

            alert(text);

        }

    }



    function printGameHistory() {

        const payload = getGameHistoryTablePayload();

        if (!payload.rows.length) {

            notifyGameHistory('info', 'Print', 'No rows to print for the current filter.');

            return;

        }

        const headerHtml = payload.headers.map((h) => '<th>' + stripHtml(h) + '</th>').join('');

        const rowsHtml = payload.rows.map((row) => (

            '<tr>' + row.map((cell) => '<td>' + stripHtml(cell) + '</td>').join('') + '</tr>'

        )).join('');



        const totalText = (id) => {

            const el = document.getElementById(id);

            return el ? stripHtml(el.textContent) : '0';

        };

        const footHtml = '<tr class="total-row">' +

            '<td colspan="5">TOTAL</td>' +

            '<td>' + totalText('gh-total-buyin') + '</td>' +

            '<td>' + totalText('gh-total-cashout') + '</td>' +

            '<td>' + totalText('gh-total-winloss') + '</td>' +

            '<td>' + totalText('gh-total-total-rolling') + '</td>' +

            '<td>&mdash;</td>' +

            '<td>' + totalText('gh-total-commission') + '</td>' +

            '<td>' + totalText('gh-total-addchg') + '</td>' +

            '<td>' + totalText('gh-total-totalsettle') + '</td>' +

            '<td>&mdash;</td>' +

            '</tr>';



        const iframe = document.createElement('iframe');

        iframe.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;';

        document.body.appendChild(iframe);

        const fw = iframe.contentWindow;

        const fd = fw.document;

        fd.open();

        fd.write([

            '<!doctype html><html><head><title>Game History</title><style>',

            '@page{size:A4 landscape;margin:10mm;}',

            '*{box-sizing:border-box;}body{font-family:Arial,Helvetica,sans-serif;margin:0;color:#212529;}',

            'h2{margin:0 0 4px;font-size:16px;}.subtitle{margin:0 0 12px;font-size:12px;color:#6c757d;}',

            'table{width:100%;border-collapse:collapse;font-size:9px;}',

            'th,td{border:1px solid #adb5bd;padding:3px 5px;text-align:right;white-space:nowrap;}',

            'th{background:#e9ecef;text-align:center;}',

            'td:nth-child(1),td:nth-child(2),td:nth-child(3),td:nth-child(4),td:nth-child(5),td:nth-child(10),td:nth-child(14){text-align:left;}',

            'tfoot .total-row td{background:#e9ecef;font-weight:bold;text-align:right;}',

            'tfoot .total-row td:first-child{text-align:center;}',

            '</style></head><body>',

            '<h2>Game History</h2>',

            '<div class="subtitle">', stripHtml(getGameHistoryRangeLabel()), '</div>',

            '<table><thead><tr>', headerHtml, '</tr></thead><tbody>', rowsHtml, '</tbody><tfoot>', footHtml, '</tfoot></table>',

            '</body></html>'

        ].join(''));

        fd.close();



        const cleanup = () => setTimeout(() => {

            if (iframe && iframe.parentNode) iframe.parentNode.removeChild(iframe);

        }, 300);

        fw.onafterprint = cleanup;

        setTimeout(() => { fw.focus(); fw.print(); cleanup(); }, 250);

    }



    function exportGameHistory() {

        const payload = getGameHistoryTablePayload();

        if (!payload.rows.length) {

            notifyGameHistory('info', 'Export', 'No rows to export for the current filter.');

            return;

        }

        const outName = getGameHistoryExportFilename();

        const $btn = $('#btn-game-history-export');

        $btn.prop('disabled', true);

        fetch('/account_game_history/export_xlsx', {

            method: 'POST',

            headers: { 'Content-Type': 'application/json' },

            credentials: 'same-origin',

            body: JSON.stringify({ headers: payload.headers, rows: payload.rows, filename: outName })

        })

            .then((res) => {

                if (!res.ok) {

                    return res.json().catch(() => ({})).then((j) => {

                        throw new Error((j && j.error) ? j.error : 'Export failed');

                    });

                }

                return res.blob();

            })

            .then((blob) => {

                const link = document.createElement('a');

                link.href = URL.createObjectURL(blob);

                link.download = outName;

                document.body.appendChild(link);

                link.click();

                document.body.removeChild(link);

                URL.revokeObjectURL(link.href);

            })

            .catch((err) => notifyGameHistory('error', 'Error', err.message || 'Export failed'))

            .finally(() => $btn.prop('disabled', false));

    }



    function bindGameHistoryToolbar() {

        if (gameHistoryToolbarBound) return;

        gameHistoryToolbarBound = true;

        $('#btn-game-history-print').on('click', function (e) { e.preventDefault(); printGameHistory(); });

        $('#btn-game-history-export').on('click', function (e) { e.preventDefault(); exportGameHistory(); });

    }



    const formatProgramDate = (val) => {

        if (!val) return '-';

        if (typeof moment !== 'undefined') {

            const m = moment.utc(val).utcOffset(8);

            if (m.isValid()) return m.format('YYYY-MM-DD');

        }

        if (typeof window.fmtDate === 'function') return window.fmtDate(val, '-');
        const d = new Date(val);
        return isNaN(d.getTime()) ? '-' : window.fmtDate ? window.fmtDate(d, '-') : '-';

    };



    const formatDate = (val) => {

        if (!val) return '';

        if (typeof moment !== 'undefined') {

            const m = moment.utc(val).utcOffset(8);

            if (m.isValid()) return m.format('YYYY-MM-DD HH:mm');

        }

        if (typeof window.fmtDtUtc8 === 'function') return window.fmtDtUtc8(val, '');
        const d = new Date(val);
        return isNaN(d.getTime()) ? '' : '';

    };



    const formatAmount = (val) => {
        const num = Number(val || 0);
        if (window.fmtAmt) return window.fmtAmt(num);
        return num.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    };

    const formatCashoutAmount = (val) => {
        if (window.fmtOut) return window.fmtOut(val);
        return formatAmount(val);
    };

    const formatSignedAmountDisplay = (val) => {
        const num = Number(val || 0);
        if (window.fmtSigned) return window.fmtSigned(num);
        if (num < 0) return '(' + Math.abs(num).toLocaleString('en-US') + ')';
        return formatAmount(num);
    };



    function updateGameHistoryTotals(rows) {

        const totalIds = [

            'gh-total-buyin',

            'gh-total-cashout',

            'gh-total-winloss',

            'gh-total-total-rolling',

            'gh-total-commission',

            'gh-total-addchg',

            'gh-total-totalsettle'

        ];

        if (!rows || !rows.length) {

            totalIds.forEach(id => {

                const el = document.getElementById(id);

                if (el) el.textContent = '0';

            });

            const winlossEl = document.getElementById('gh-total-winloss');

            if (winlossEl) winlossEl.classList.remove('gh-total-winloss-negative');

            return;

        }

        let buyIn = 0, cashOut = 0, totalRolling = 0, commission = 0, addChg = 0, totalSettle = 0, winLoss = 0;

        rows.forEach(r => {

            buyIn += Number(r.BUY_IN) || 0;

            cashOut += Number(r.CASH_OUT) || 0;

            totalRolling += Number(r.TOTAL_ROLLING) || 0;

            commission += Number(r.COMMISSION) || 0;

            addChg += Number(r.ADD_CHG) || 0;

            totalSettle += Number(r.TOTAL_SETTLE) || 0;

            winLoss += Number(r.WIN_LOSS) || 0;

        });

        const setHtml = (id, html) => {
            const el = document.getElementById(id);
            if (el) el.innerHTML = html;
        };

        const set = (id, val) => {
            const el = document.getElementById(id);
            if (el) el.textContent = formatAmount(val);
        };

        set('gh-total-buyin', buyIn);

        setHtml('gh-total-cashout', formatCashoutAmount(cashOut));

        set('gh-total-total-rolling', totalRolling);

        set('gh-total-commission', commission);

        set('gh-total-addchg', addChg);

        set('gh-total-totalsettle', totalSettle);

        setHtml('gh-total-winloss', formatSignedAmountDisplay(winLoss));

        const winlossEl = document.getElementById('gh-total-winloss');

        if (winlossEl) {
            if (winLoss < 0) winlossEl.classList.add('gh-total-winloss-negative', 'text-danger');
            else winlossEl.classList.remove('gh-total-winloss-negative', 'text-danger');
        }

    }



    async function loadGameHistoryRows(accountId, guestId) {

        try {

            gameHistoryAccountId = accountId;

            const url = guestId

                ? `/account_game_history/${accountId}?guestId=${encodeURIComponent(guestId)}`

                : `/account_game_history/${accountId}`;

            const res = await fetch(url);

            const rows = await res.json();

            const dataRows = rows || [];



            registerGameHistoryDateFilter();



            if (gameHistoryDataTable) {

                gameHistoryDataTable.clear().rows.add(dataRows).draw();

                return;

            }



            gameHistoryDataTable = $('#game-history-tbl').DataTable({

                data: dataRows,

                order: [[1, 'desc']],

                pageLength: 10,

                autoWidth: false,

                columnDefs: [

                    { className: 'col-program-date', width: '95px', targets: 0 },

                    { width: '150px', targets: 1 },

                    { width: '100px', targets: 2 },

                    { width: '80px', targets: 3 },

                    { className: 'col-guest', width: '150px', targets: 4 },

                    { className: 'col-buyin', width: '130px', targets: 5 },

                    { className: 'col-cashout', width: '130px', targets: 6 },

                    { className: 'col-winloss', width: '130px', targets: 7 },

                    { className: 'col-total-rolling', width: '130px', targets: 8 },

                    { className: 'col-game-rate', width: '120px', targets: 9 },

                    { className: 'col-commission', width: '100px', targets: 10 },

                    { className: 'col-add-chg', width: '100px', targets: 11 },

                    { className: 'col-total-settle', width: '110px', targets: 12 },

                    { className: 'col-game-end', width: '150px', targets: 13 }

                ],

                language: {

                    search: 'Search:',

                    info: 'Showing _START_ to _END_ of _TOTAL_ entries',

                    paginate: {

                        previous: 'Previous',

                        next: 'Next'

                    },

                    emptyTable: 'No game history available'

                },

                columns: [

                    {

                        data: 'PROGRAM_DATE',

                        className: 'text-center col-program-date',

                        render: function (data, type, row) {

                            const raw = data || row.PROGRAM_DATE || row.game_date_start;

                            if (type === 'sort' || type === 'type') {

                                if (typeof moment !== 'undefined') {

                                    const m = moment.utc(raw).utcOffset(8);

                                    return m.isValid() ? m.valueOf() : 0;

                                }

                                const t = Date.parse(raw);

                                return isNaN(t) ? 0 : t;

                            }

                            return formatProgramDate(raw);

                        }

                    },

                    {

                        data: 'game_date_start',

                        className: 'text-center',

                        render: function (data, type) {

                            if (type === 'sort' || type === 'type') {

                                const t = Date.parse(data);

                                return isNaN(t) ? 0 : t;

                            }

                            return formatDate(data);

                        }

                    },

                    {

                        data: 'GAME_TYPE',

                        className: 'text-center',

                        render: function (data) { return data || '-'; }

                    },

                    {

                        data: 'game_list_id',

                        className: 'text-center',

                        render: function (data) { return data || ''; }

                    },

                    {

                        data: 'guest_name',

                        className: 'col-guest',

                        render: function (data) { return data || '-'; }

                    },

                    {

                        data: 'BUY_IN',

                        className: 'col-buyin',

                        render: function (data) { return formatAmount(data); }

                    },

                    {

                        data: 'CASH_OUT',

                        className: 'col-cashout',

                        render: function (data) { return formatCashoutAmount(data); }

                    },

                    {

                        data: 'WIN_LOSS',

                        className: 'col-winloss',

                        render: function (data) { return formatSignedAmountDisplay(data); }

                    },

                    {

                        data: 'TOTAL_ROLLING',

                        className: 'col-total-rolling',

                        render: function (data) { return formatAmount(data); }

                    },

                    {

                        data: null,

                        className: 'col-game-rate',

                        render: function (_data, _type, row) {

                            let badge = '';

                            if (row.COMMISSION_TYPE == 1) {

                                badge = '<span class="badge commission-badge commission-badge-r" title="Rolling Game">R</span>';

                            } else if (row.COMMISSION_TYPE == 2) {

                                badge = '<span class="badge commission-badge commission-badge-s" title="Shared Game">S</span>';

                            } else if (row.COMMISSION_TYPE == 3) {

                                badge = '<span class="badge commission-badge commission-badge-l" title="Loosing Game">L</span>';

                            }

                            return `${row.COMMISSION_PERCENTAGE || 0}% ${badge}`;

                        }

                    },

                    {

                        data: 'COMMISSION',

                        className: 'col-commission',

                        render: function (data) { return formatAmount(data); }

                    },

                    {

                        data: 'ADD_CHG',

                        className: 'col-add-chg',

                        render: function (data) { return formatAmount(data); }

                    },

                    {

                        data: 'TOTAL_SETTLE',

                        className: 'col-total-settle',

                        render: function (data) { return formatAmount(data); }

                    },

                    {

                        data: null,

                        className: 'col-game-end',

                        render: function (_data, _type, row) {

                            if (row.game_status == 2) {

                                return '<span class="badge bg-primary-subtle text-primary" style="font-size:10px !important;">ON GAME</span>';

                            } else if (row.game_status == 3) {

                                return '<span class="badge bg-warning-subtle text-warning" style="font-size:10px !important;">PENDING</span>';

                            } else if (row.GAME_ENDED) {

                                if (typeof moment !== 'undefined') {

                                    return moment.utc(row.GAME_ENDED).utcOffset(8).format('YYYY-MM-DD HH:mm');

                                }

                                if (typeof window.fmtDtUtc8 === 'function') {
                                    return window.fmtDtUtc8(row.GAME_ENDED, '-');
                                }
                                return '-';

                            }

                            return '-';

                        }

                    }

                ]

            });

            gameHistoryDataTable.on('draw', function () {

                const filtered = gameHistoryDataTable.rows({ search: 'applied' }).data().toArray();

                updateGameHistoryTotals(filtered);

            });

            placeGameHistoryDateFilter();

            initGameHistoryDatePicker();

            bindGameHistoryToolbar();

            gameHistoryDataTable.draw();

        } catch (err) {

            console.error('Error loading game history', err);

            if (gameHistoryDataTable) {

                gameHistoryDataTable.clear().draw();

            }

        }

    }



    function getGameHistoryModal() {

        if (!gameHistoryModal) {

            const modalElement = document.getElementById('modal-game-history');

            if (modalElement && typeof bootstrap !== 'undefined') {

                gameHistoryModal = new bootstrap.Modal(modalElement);

            } else {

                console.error('Modal element #modal-game-history not found or Bootstrap not loaded');

                return null;

            }

        }

        return gameHistoryModal;

    }



    window.game_history = async function(accountId, guestId) {

        if (!accountId) {

            accountId = document.getElementById('account_id')?.value ||

                       document.getElementById('account_id_add')?.value;

        }



        if (!accountId) {

            alert('Account ID not found');

            return;

        }



        const modal = getGameHistoryModal();

        if (modal) {

            resetGameHistoryDateFilter();

            await loadGameHistoryRows(accountId, guestId);

            if (typeof window.prepareGuestPortalChildModal === 'function') {
                window.prepareGuestPortalChildModal($('#modal-game-history'));
            }

            modal.show();

        } else {

            console.error('Game history modal not initialized');

        }

    };

})();

</script>


