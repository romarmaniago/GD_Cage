}



#game-history-tbl th.col-buyin,

#game-history-tbl td.col-buyin,

#game-history-tbl th.col-cashout,

#game-history-tbl td.col-cashout,

#game-history-tbl th.col-winloss,

#game-history-tbl td.col-winloss,

#game-history-tbl th.col-total-rolling,

#game-history-tbl td.col-total-rolling {

    width: 130px !important;

    min-width: 130px !important;

    max-width: 130px !important;

    box-sizing: border-box;

}



#game-history-tbl th.col-cashout,

#game-history-tbl td.col-cashout,

#game-history-tbl th.col-commission,

#game-history-tbl td.col-commission,

#game-history-tbl th.col-add-chg,

#game-history-tbl td.col-add-chg,

#game-history-tbl th.col-total-settle,

#game-history-tbl td.col-total-settle {

    text-align: right !important;

    padding-right: 12px;

}



#game-history-tbl th.col-game-end,

#game-history-tbl td.col-game-end {

    text-align: center !important;

}



