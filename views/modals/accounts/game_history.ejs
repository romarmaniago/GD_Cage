<!-- Game History Modal -->

<div class="modal fade" id="modal-game-history" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">

  <div class="modal-dialog modal-xl modal-dialog-centered">

    <div class="modal-content">

      <div class="modal-header bg-primary">

        <h5 class="modal-title text-white">

          <i class="fa fa-gamepad me-2"></i>Game History

        </h5>

        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

      </div>

      <div class="modal-body">

        <div id="game-history-daterange-mount" class="gh-daterange-wrap">

          <input type="text" id="game-history-daterange" class="form-control form-control-sm" placeholder="Select date range" readonly>

        </div>

        <div id="game-history-actions-mount">

          <button type="button" id="btn-game-history-print" class="btn btn-alt-success game-history-action-btn">

            <i class="fa fa-print" aria-hidden="true"></i> Print

          </button>

          <button type="button" id="btn-game-history-export" class="btn btn-success game-history-action-btn">

            <i class="fa fa-file-excel" aria-hidden="true"></i> Export

          </button>

        </div>

        <div class="game-history-table-card table-responsive">

          <table class="table nowrap small-text mb-0" style="width:100%" id="game-history-tbl">

            <thead class="table-light">

              <tr>

                <th class="text-center col-program-date">PROGRAM DATE</th>

                <th class="text-center">GAME START</th>

                <th class="text-center">TYPE</th>

                <th class="text-center">GAME #</th>

                <th class="text-center col-guest">GUEST</th>

                <th class="text-center col-buyin">BUY-IN</th>

                <th class="text-center col-cashout">CASH-OUT</th>

                <th class="text-center col-winloss">WIN/LOSS</th>

                <th class="text-center col-total-rolling">ROLLING</th>

                <th class="text-center col-game-rate">GAME RATE</th>

                <th class="text-center col-commission">COMMISSION</th>

                <th class="text-center col-add-chg">ADD CHG</th>

                <th class="text-center col-total-settle">TOTAL SETTLE</th>

                <th class="text-center col-game-end">GAME END</th>

              </tr>

            </thead>

            <tbody>

            </tbody>

            <tfoot class="game-history-tfoot-total">

              <tr id="game-history-totals-row">

                <td class="text-center" colspan="5">TOTAL</td>

                <td class="col-buyin" id="gh-total-buyin">0</td>

                <td class="col-cashout" id="gh-total-cashout">0</td>

                <td class="col-winloss" id="gh-total-winloss">0</td>

                <td class="col-total-rolling" id="gh-total-total-rolling">0</td>

                <td class="col-game-rate text-center">—</td>

                <td class="col-commission" id="gh-total-commission">0</td>

                <td class="col-add-chg" id="gh-total-addchg">0</td>

                <td class="col-total-settle" id="gh-total-totalsettle">0</td>

                <td class="col-game-end text-center">—</td>

              </tr>

            </tfoot>

          </table>

        </div>

      </div>

    </div>

  </div>

</div>



<style>

#modal-game-history .modal-dialog.modal-xl {

    max-width: 1720px;

    width: 1720px;

}



@media (max-width: 1600px) {

    #modal-game-history .modal-dialog.modal-xl {

        max-width: 100%;

