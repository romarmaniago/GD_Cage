<div class="modal fade" id="modal-gi-agent-group" role="dialog" aria-labelledby="modal-gi-agent-group-title"
	aria-hidden="true" data-keyboard="false" data-bs-backdrop="static">
	<div class="modal-dialog modal-dialog-centered modal-lg" role="document">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="block-title text-white" id="modal-gi-agent-group-title"><%= __('categorize_group.new_group') %></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form id="form-gi-agent-group">
					<input type="hidden" id="gi-agent-group-id" value="" />
					<div class="mb-3">
						<label class="form-label" for="gi-agent-group-name"><%= __('categorize_group.group_name') %></label>
						<input type="text" class="form-control" id="gi-agent-group-name" name="groupName"
							placeholder="<%= __('categorize_group.group_name_placeholder') %>" required maxlength="100" />
					</div>
					<div class="mb-3">
						<label class="form-label" for="gi-agent-group-agent-picker"><%= __('categorize_group.select_agents') %></label>
						<select class="form-select" id="gi-agent-group-agent-picker" style="width: 100%;"
							data-placeholder="<%= __('categorize_group.search_agent_placeholder') %>">
							<option value=""></option>
						</select>
						<div class="form-text"><%= __('categorize_group.select_agents_hint') %></div>
						<div id="gi-agent-group-selected" class="gi-agent-selected-list mt-2" aria-live="polite"></div>
					</div>
					<div class="modal-footer px-0 pb-0">
						<button type="submit" class="btn btn-sm btn-primary" data-view-only-disable><%= __('categorize_group.save') %></button>
						<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('categorize_group.cancel') %></button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
