<div class="modal fade" id="modal-game-row-note" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="gameRowNoteLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-primary py-2">
				<h6 class="modal-title text-white mb-0" id="gameRowNoteLabel">Note — Game #<span id="game-row-note-game-id-label"></span></h6>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="game_row_note_form">
				<div class="modal-body">
					<input type="hidden" id="game_row_note_game_id">
					<div class="mb-2">
						<label class="form-label mb-1" for="game_row_note_text">Note</label>
						<input type="text" class="form-control" id="game_row_note_text" maxlength="255" placeholder="Optional short note" autocomplete="off">
					</div>
					<label class="form-label mb-1">Background color</label>
					<div class="row-note-pickers mb-2">
						<div class="row-note-picker" data-kind="bg">
							<button type="button" class="row-note-picker-btn js-row-note-picker-toggle" title="Fill Color" aria-label="Fill Color">
								<span class="row-note-picker-icon"><i class="fa fa-fill-drip" aria-hidden="true"></i><span class="row-note-picker-bar"></span></span>
								<i class="fa fa-caret-down row-note-picker-caret" aria-hidden="true"></i>
							</button>
							<div class="row-note-palette"></div>
							<input type="hidden" id="game_row_note_bg">
						</div>
					</div>
				</div>
				<div class="modal-footer py-2">
					<button type="submit" id="submit-game-row-note-btn" class="btn btn-sm btn-primary">Save</button>
					<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Close</button>
				</div>
			</form>
		</div>
	</div>
			<div class="row-note-colors-dlg" id="row-note-colors-dlg" role="dialog" aria-label="Colors">
				<div class="row-note-colors-box">
					<div class="row-note-colors-head">
						<span>Colors</span>
						<button type="button" class="js-row-note-colors-cancel" aria-label="Close">&times;</button>
					</div>
					<div class="row-note-colors-body">
						<div class="row-note-colors-main">
							<div class="row-note-colors-tabs">
								<button type="button" class="active" data-pane="standard">Standard</button>
								<button type="button" data-pane="custom">Custom</button>
							</div>
							<div class="row-note-colors-pane active" data-pane="standard">
								<div class="mb-1">Colors:</div>
								<svg id="row-note-honeycomb" aria-label="Standard colors"></svg>
							</div>
							<div class="row-note-colors-pane" data-pane="custom">
								<div class="mb-1">Colors:</div>
								<div class="row-note-spectrum-wrap">
									<div class="row-note-spectrum" id="row-note-spectrum"><span class="row-note-spectrum-mark"></span></div>
									<div class="row-note-lum" id="row-note-lum"><span class="row-note-lum-mark"></span></div>
								</div>
								<div class="row-note-rgb">
									<label for="row-note-rgb-r">Red:</label><input type="number" id="row-note-rgb-r" min="0" max="255">
									<label for="row-note-rgb-g">Green:</label><input type="number" id="row-note-rgb-g" min="0" max="255">
									<label for="row-note-rgb-b">Blue:</label><input type="number" id="row-note-rgb-b" min="0" max="255">
									<label for="row-note-rgb-hex">Hex:</label><input type="text" id="row-note-rgb-hex" maxlength="7">
								</div>
							</div>
						</div>
						<div class="row-note-colors-side">
							<button type="button" class="btn btn-sm btn-primary js-row-note-colors-ok">OK</button>
							<button type="button" class="btn btn-sm btn-alt-secondary js-row-note-colors-cancel">Cancel</button>
							<div class="row-note-colors-preview">
								<div>New</div>
								<span id="row-note-colors-new"></span>
								<span id="row-note-colors-current"></span>
								<div>Current</div>
							</div>
						</div>
					</div>
				</div>
			</div>
</div>
