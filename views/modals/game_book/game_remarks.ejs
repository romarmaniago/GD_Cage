<div class="modal fade" id="modal-game-remarks" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white">Remarks - <span id="game-remarks-agent-code"></span></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="form-game-remarks">
				<div class="modal-body">
					<input type="hidden" id="game-remarks-game-id" />
					<label for="game-remarks-text" class="form-label">Remarks</label>
					<textarea id="game-remarks-text" class="form-control" rows="4" maxlength="500" placeholder="Enter remarks for this game..."></textarea>
				</div>
				<div class="modal-footer">
					<button type="submit" id="game-remarks-save-btn" class="btn btn-primary">Save</button>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				</div>
			</form>
		</div>
	</div>
</div>
