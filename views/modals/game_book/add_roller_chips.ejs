<div class="modal fade" id="modal-add-roller-chips" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
		<div class="modal-header bg-primary">
			<h5 class="modal-title text-white" id="staticBackdropLiveLabel">Roller Chips - <span id="roller-chips-agent-code"></span></h5>
			<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
		</div>
		<form id="add_roller_chips">
		<div class="modal-body">
			<span class="d-none" id="roller-availableNN" aria-hidden="true">0</span>
			<span class="d-none" id="roller-availableCC" aria-hidden="true">0</span>
			<input type="hidden" name="game_id" class="game_list_id">
			
			<!-- Summary Display (Total ADD, Total RETURN, Net ADD) -->
			<div class="alert alert-info" role="alert" style="padding: 10px; margin-bottom: 15px;">
				<small>
					<table style="margin-top:4px;width:100%;border-collapse:collapse;">
						<tr>
							<td style="padding:4px 0;font-weight:600;">Total ADD :</td>
							<td style="padding:4px 0;text-align:right;">
								<div>NN: <span id="roller-chips-total-add-nn">0</span></div>
								<div>CC: <span id="roller-chips-total-add-cc">0</span></div>
							</td>
						</tr>
						<tr>
							<td style="padding:4px 0;font-weight:600;">Total RETURN:</td>
							<td style="padding:4px 0;text-align:right;">
								<div>NN: <span id="roller-chips-total-return-nn">0</span></div>
								<div>CC: <span id="roller-chips-total-return-cc">0</span></div>
							</td>
						</tr>
						<tr>
							<td style="padding:4px 0;font-weight:600;color:red;">Required RETURN:</td>
							<td style="padding:4px 0;text-align:right;">
								<span id="roller-chips-required-return-total" style="color:red;font-weight:bold;">0</span>
							</td>
						</tr>
					</table>
				</small>
			</div>

			<!-- Input Fields -->
			<div class="row mb-2">
				<div class="col-sm-6">
					<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center txtRollerNN" placeholder="NN Chips" name="txtRollerNN">
					<small id="roller-chips-remaining-hint" class="d-block mt-1 text-danger fw-semibold" style="display: none;"></small>
				</div>
				<div class="col-sm-6">
					<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center txtRollerCC" placeholder="CC Chips" name="txtRollerCC">
				</div>
			</div>
			<br>
			<!-- Radio Buttons for ADD/RETURN -->
			<div class="row mb-3 justify-content-center">
				<div class="col-sm-4 text-center">
					<div class="form-check justify-content-center d-flex">
						<input class="form-check-input" type="radio" name="txtTransType" id="rollerAdd" value="1">
						<label class="form-check-label" for="rollerAdd">
							ADD
						</label>
					</div>
				</div>
				<div class="col-sm-4 text-center">
					<div class="form-check justify-content-center d-flex">
						<input class="form-check-input" type="radio" name="txtTransType" id="rollerReturn" value="2">
						<label class="form-check-label" for="rollerReturn">
							RETURN
						</label>
					</div>
				</div>
			</div>
		</div>
		<div class="modal-footer">
			<button type="submit" id="submit-roller-chips-btn" class="btn btn-sm btn-primary">
				Save
			</button>
			<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
				Close
			</button>
		</div>
		</div>
	</div>
	</form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
	const modal = document.getElementById('modal-add-roller-chips');
	if (!modal) return;

	function rollerParseAvail(el) {
		if (!el) return 0;
		const raw = (el.textContent || el.innerText || '').replace(/[^0-9.-]+/g, '');
		const n = parseFloat(raw);
		return Number.isFinite(n) ? Math.max(0, n) : 0;
	}
	function rollerAvailableNN() {
		return rollerParseAvail(document.getElementById('roller-availableNN'));
	}
	function rollerAvailableCC() {
		return rollerParseAvail(document.getElementById('roller-availableCC'));
	}
	function rollerIsAddSelected() {
		const checked = document.querySelector('#modal-add-roller-chips input[name="txtTransType"]:checked');
		return !!(checked && checked.value === '1');
	}
	function rollerSwalWarn(title, text) {
		if (typeof Swal !== 'undefined') {
			Swal.fire({ icon: 'warning', title: title, text: text, confirmButtonColor: '#3a57e8' });
		} else {
			window.alert(title + '\n\n' + text);
		}
	}

	modal.addEventListener('shown.bs.modal', function () {
		fetch('/game_list_available_chips', { credentials: 'same-origin' })
			.then(function (r) {
				if (!r.ok) throw new Error('bad status');
				return r.json();
			})
			.then(function (data) {
				const nnEl = document.getElementById('roller-availableNN');
				const ccEl = document.getElementById('roller-availableCC');
				const nn = Number(data && data.availableNN) || 0;
				const cc = Number(data && data.availableCC) || 0;
				if (nnEl) nnEl.textContent = nn.toLocaleString('en-US');
				if (ccEl) ccEl.textContent = cc.toLocaleString('en-US');
			})
			.catch(function () {
				const nnEl = document.getElementById('roller-availableNN');
				const ccEl = document.getElementById('roller-availableCC');
				if (nnEl) nnEl.textContent = '0';
				if (ccEl) ccEl.textContent = '0';
			});
	});

	const nnInput = document.querySelector('#modal-add-roller-chips .txtRollerNN');
	const ccInput = document.querySelector('#modal-add-roller-chips .txtRollerCC');
	const transRadios = document.querySelectorAll('#modal-add-roller-chips input[name="txtTransType"]');

	function validateRollerNNInline() {
		if (!nnInput) return;
		const raw = (nnInput.value || '').toString().replace(/,/g, '');
		const trimmed = raw.trim();

		if (!trimmed) {
			nnInput.classList.remove('is-invalid');
			return;
		}

		const value = Number(trimmed);

		if (!Number.isFinite(value) || value <= 0 || value % 1000 !== 0) {
			nnInput.classList.add('is-invalid');
			return;
		}

		nnInput.classList.remove('is-invalid');

		// Cage availability applies only when adding roller chips from inventory (ADD).
		if (!rollerIsAddSelected()) return;

		const avail = rollerAvailableNN();
		if (value > avail) {
			rollerSwalWarn(
				'Exceeds Available NN Chips',
				'ADD cannot exceed ' + avail.toLocaleString('en-US') + ' NN Chips available.'
			);
			nnInput.value = '';
			nnInput.classList.remove('is-invalid');
			nnInput.focus();
		}
	}

	function validateRollerCCInline() {
		if (!ccInput) return;
		const raw = (ccInput.value || '').toString().replace(/,/g, '');
		const trimmed = raw.trim();
		if (!trimmed) return;

		const value = Number(trimmed);
		if (!Number.isFinite(value) || value < 0) return;

		if (!rollerIsAddSelected()) return;

		const avail = rollerAvailableCC();
		if (value > avail) {
			rollerSwalWarn(
				'Exceeds Available CC Chips',
				'ADD cannot exceed ' + avail.toLocaleString('en-US') + ' CC Chips available.'
			);
			ccInput.value = '';
			ccInput.focus();
		}
	}

	function onRollerInputChange() {
		if (typeof updateRollerChipsRemainingHint === 'function') {
			updateRollerChipsRemainingHint();
		}
	}

	if (nnInput) {
		nnInput.addEventListener('input', validateRollerNNInline);
		nnInput.addEventListener('input', onRollerInputChange);
	}
	if (ccInput) {
		ccInput.addEventListener('input', validateRollerCCInline);
		ccInput.addEventListener('input', onRollerInputChange);
	}

	transRadios.forEach(function (r) {
		r.addEventListener('change', function () {
			validateRollerNNInline();
			validateRollerCCInline();
			onRollerInputChange();
		});
	});
});
</script>
