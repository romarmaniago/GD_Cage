<%
const _sqlNNChipsBuyin = typeof sqlNNChipsBuyin !== 'undefined' ? sqlNNChipsBuyin : [{ NNChipsBuyin: 0 }];
const _sqlNNChipsCashout = typeof sqlNNChipsCashout !== 'undefined' ? sqlNNChipsCashout : [{ NNChipsCashout: 0 }];
const _sqlAccountNNChips = typeof sqlAccountNNChips !== 'undefined' ? sqlAccountNNChips : [{ TOTAL_NN: 0 }];
const _sqlTotalCashOutRolling = typeof sqlTotalCashOutRolling !== 'undefined' ? sqlTotalCashOutRolling : [{ TOTAL_CASHOUT: 0 }];
const _sqlTotalRealRolling = typeof sqlTotalRealRolling !== 'undefined' ? sqlTotalRealRolling : [{ TOTAL_REAL_ROLLING: 0 }];
const _sqlNNChipsRolling = typeof sqlNNChipsRolling !== 'undefined' ? sqlNNChipsRolling : [{ NNChipsRolling: 0 }];
const _sqlCCChipsRolling = typeof sqlCCChipsRolling !== 'undefined' ? sqlCCChipsRolling : [{ CCChipsRolling: 0 }];
const _sqlNNBuyin = typeof sqlNNBuyin !== 'undefined' ? sqlNNBuyin : [{ NNBuyin: 0 }];
const _sqlNNReturn = typeof sqlNNReturn !== 'undefined' ? sqlNNReturn : [{ NNReturn: 0 }];
const _sqlRollerNNSubtract = typeof sqlRollerNNSubtract !== 'undefined' ? sqlRollerNNSubtract : [{ ROLLER_NN_SUBTRACT: 0 }];
const _sqlRollerNNAdd = typeof sqlRollerNNAdd !== 'undefined' ? sqlRollerNNAdd : [{ ROLLER_NN_ADD: 0 }];
const _sqlCCChipsBuyin = typeof sqlCCChipsBuyin !== 'undefined' ? sqlCCChipsBuyin : [{ CCChipsBuyin: 0 }];
const _sqlCCChipsCashout = typeof sqlCCChipsCashout !== 'undefined' ? sqlCCChipsCashout : [{ CCChipsCashout: 0 }];
const _sqlAccountCCChipsReturn = typeof sqlAccountCCChipsReturn !== 'undefined' ? sqlAccountCCChipsReturn : [{ CC_CHIPS_RETURN: 0 }];
const _sqlCCChipsBuyinGame = typeof sqlCCChipsBuyinGame !== 'undefined' ? sqlCCChipsBuyinGame : [{ TOTAL_CC: 0 }];
const _sqlCCBuyin = typeof sqlCCBuyin !== 'undefined' ? sqlCCBuyin : [{ CCBuyin: 0 }];
const _sqlCCReturn = typeof sqlCCReturn !== 'undefined' ? sqlCCReturn : [{ CCReturn: 0 }];
const _sqlRollerCCSubtract = typeof sqlRollerCCSubtract !== 'undefined' ? sqlRollerCCSubtract : [{ ROLLER_CC_SUBTRACT: 0 }];
const _sqlRollerCCAdd = typeof sqlRollerCCAdd !== 'undefined' ? sqlRollerCCAdd : [{ ROLLER_CC_ADD: 0 }];
%>
<div class="modal fade" id="modal-new-game-list" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered new-game-list-modal-dialog">
        <div class="new-game-modal-cluster">
        <div class="modal-content new-game-main-content">
        <div class="modal-header bg-primary">
            <h5 class="modal-title text-white" id="staticBackdropLiveLabel"><%= __('modal_new_game_list.new_game') %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="add_game_list">
        <div class="modal-body">
            <h6 class="d-none" id="availableNN"><%- ( (+_sqlNNChipsBuyin[0].NNChipsBuyin || 0) -
                (+_sqlNNChipsCashout[0].NNChipsCashout || 0) -
                 (+_sqlAccountNNChips[0].TOTAL_NN || 0) +
                 (+_sqlTotalCashOutRolling[0].TOTAL_CASHOUT || 0) -
                 (+_sqlTotalRealRolling[0].TOTAL_REAL_ROLLING || 0)   +
                (+_sqlNNChipsRolling[0].NNChipsRolling || 0) +
                (+_sqlCCChipsRolling[0].CCChipsRolling || 0) + (+_sqlNNBuyin[0].NNBuyin
                 || 0) - (+_sqlNNReturn[0].NNReturn || 0) -
                 (+_sqlRollerNNSubtract[0].ROLLER_NN_SUBTRACT || 0) +
                 (+_sqlRollerNNAdd[0].ROLLER_NN_ADD || 0) ).toLocaleString('en-US') %></h6>
            <h6 id="availableCC" class="d-none"><%- ( (+_sqlCCChipsBuyin[0].CCChipsBuyin || 0) -
                (+_sqlCCChipsCashout[0].CCChipsCashout || 0) +
                 (+_sqlTotalRealRolling[0].TOTAL_REAL_ROLLING || 0) -
                 (+_sqlCCChipsRolling[0].CCChipsRolling || 0) -
                 (+_sqlNNChipsRolling[0].NNChipsRolling || 0) +
                 (+_sqlAccountCCChipsReturn[0].CC_CHIPS_RETURN || 0) -
                 (+_sqlCCChipsBuyinGame[0].TOTAL_CC || 0) + (+_sqlCCBuyin[0].CCBuyin ||
                 0) - (+_sqlCCReturn[0].CCReturn || 0) -
                 (+_sqlRollerCCSubtract[0].ROLLER_CC_SUBTRACT || 0) +
                 (+_sqlRollerCCAdd[0].ROLLER_CC_ADD || 0) ).toLocaleString('en-US') %></h6>
             
          
                <input type="hidden" id="total_balanceGuest1" name="totalBalanceGuest1" readonly/>
                <span class="d-none" id="new-game-nn-balance-base" aria-hidden="true">0</span>
                <span class="d-none" id="new-game-cc-balance-base" aria-hidden="true">0</span>
                <span class="d-none" id="new-game-agent-code-label" aria-hidden="true"></span>
                <span class="d-none" id="new-game-guest-name-label" aria-hidden="true"></span>
                <div class="row mb-2">
                    <div class="col-6">
                        <input type="text" class="form-control" name="txtProgramDate" id="txtProgramDate" autocomplete="off" placeholder="YYYY-MM-DD" style="max-width: 13.5rem;" />
                    </div>
                </div>

              <div class="row mb-3">
                  <div class="col-sm-6">
                      <input type="hidden" id="txtGuestId" name="txtGuestId" value="">
                      <select class="js-select2 form-select" id="txtTrans" name="txtAccountCode" style="width: 100%;" data-placeholder="<%= __('modal_new_game_list.choose_account_placeholder') %>" required>
                      </select>
                  </div>

                  <div class="col-sm-6">
                    <select class="js-select2 form-select" id="txtGuestGame" style="width: 100%;" data-placeholder="Select guest (optional)" disabled>
                        <option value="">--SELECT GUEST--</option>
                    </select>
                </div>
              </div>

             

              <div class="row mb-2 d-none" id="new-game-base-amount-row">
                  <div class="col-sm-6">
                      <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control" name="txtNN" id="txtNN" placeholder="<%= __('modal_new_game_list.nn_placeholder') %>" />
                  </div>
                  <div class="col-sm-6">
                      <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control" name="txtCC" id="txtCC" placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" />
                  </div>
              </div>

              <div id="split-new-game-row" class="new-game-input-sheet">
                  <div class="new-game-section">
                      <div class="new-game-field-grid">
                          <label class="form-label mb-0" for="splitCashNN">Cash</label>
                          <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
                              class="form-control text-center new-game-nn-input new-game-cash-input" placeholder="NN Chips" id="splitCashNN" autocomplete="off" />
                          <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
                              class="form-control text-center new-game-cash-input" placeholder="CC Chips" id="splitCashCC" autocomplete="off" />
                      </div>
                      <div class="new-game-field-grid">
                          <label class="form-label mb-0" for="splitDepNN">Deposit</label>
                          <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
                              class="form-control text-center new-game-nn-input new-game-deposit-input" placeholder="NN Chips" id="splitDepNN" autocomplete="off" />
                          <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
                              class="form-control text-center new-game-deposit-input" placeholder="CC Chips" id="splitDepCC" autocomplete="off" />
                      </div>
                      <div class="new-game-field-grid">
                          <label class="form-label mb-0" for="splitCreditNN">Credit</label>
                          <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
                              class="form-control text-center new-game-nn-input new-game-credit-input" placeholder="NN Chips" id="splitCreditNN" autocomplete="off" />
                          <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
                              class="form-control text-center new-game-credit-input" placeholder="CC Chips" id="splitCreditCC" autocomplete="off" />
                      </div>
                  </div>
              </div>
              <hr style="border: 1px solid">
               <!-- ROLLER CHIPS Section -->
               <div class="row mb-2">
                <div class="col-sm-12">
                    <label class="form-label"><strong>Roller Chips</strong></label>
               
                </div>
            </div>
            <div class="row mb-2 align-items-center">
                <div class="col-sm-6">
                    <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control" name="txtRollerNN" id="txtRollerNN" placeholder="Roller NN Chips" />
                </div>
                <div class="col-sm-6 d-flex align-items-center new-game-type-radios flex-wrap gap-3 gap-sm-4">
                    <div class="form-check mb-0">
                        <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="live" name="txtGameType" value="LIVE" required>
                        <label class="form-check-label" for="live"><%= __('modal_new_game_list.live') %></label>
                    </div>
                    <div class="form-check mb-0">
                        <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="telebet" name="txtGameType" value="TELEBET" required>
                        <label class="form-check-label" for="telebet"><%= __('modal_new_game_list.telebet') %></label>
                    </div>
                </div>
                <div class="col-sm-6" style="display: none;">
                    <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control" name="txtRollerCC" id="txtRollerCC" placeholder="Roller CC Chips" />
                </div>
            </div>

              <hr style="border: 1px solid">
              <div class="row mb-2 align-items-center g-2">
                  <div class="col-sm-5">
                      <select class="form-select" name="txtCommisionType" id="commissionType" style="width: 100%;" required>
                          <option value="" disabled><%= __('modal_new_game_list.select_game') %></option>
                          <option value="1" selected><%= __('modal_new_game_list.rolling_game') %></option>
                          <option value="2"><%= __('modal_new_game_list.shared_game') %></option>
                          <option value="3"><%= __('modal_new_game_list.loosing_game') %></option>
                      </select>
                  </div>

                  <div class="col-sm-2" id="commissionRateWrap">
                      <input type="number" class="form-control" step="0.1" min="0" max="100" name="txtCommisionRate" id="commissionRate" placeholder="%" />
                  </div>
              </div>
        </div>
        <div class="modal-footer">
            <button type="submit" id="submit-game-list-btn" class="btn btn-sm btn-primary" data-label="<%= __('modal_new_game_list.save') %>"><%= __('modal_new_game_list.save') %></button>
            <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('modal_new_game_list.close') %></button>
        </div>
        </form>
        </div>

        <div class="new-game-side-panels new-game-side-panels-empty" id="new-game-side-panels">
            <div class="new-game-side-resize-handle" id="new-game-side-resize-handle" title="Drag to resize" aria-hidden="true">⇔</div>
            <div class="new-game-side-panel d-none" id="new-game-cash-panel" aria-hidden="true">
                <div class="new-game-side-panel-title">Cash</div>
                <div class="new-game-panel-sheet">
                    <div class="new-game-cash-balance-head">
                        <div class="new-game-balance-head-cell">Current NN Balance Of Company</div>
                        <div class="new-game-balance-head-cell">Anticipated NN Balance Of Company</div>
                        <div class="new-game-balance-head-cell">Current CC Balance Of Company</div>
                        <div class="new-game-balance-head-cell">Anticipated CC Balance Of Company</div>
                    </div>
                    <div class="new-game-cash-balance-values">
                        <div class="new-game-balance-value-cell" id="new-game-cash-nn-current">—</div>
                        <div class="new-game-balance-value-cell" id="new-game-cash-nn-anticipated">—</div>
                        <div class="new-game-balance-value-cell" id="new-game-cash-cc-current">—</div>
                        <div class="new-game-balance-value-cell" id="new-game-cash-cc-anticipated">—</div>
                    </div>
                    <div class="new-game-processing-row">
                        <div class="new-game-processing-col">
                            <div class="new-game-processing-head">Processing Amount</div>
                            <div class="new-game-processing-body" id="new-game-cash-processing-wrap">
                                <span id="new-game-cash-processing">0</span>
                            </div>
                        </div>
                        <div class="new-game-remarks-col">
                            <div class="new-game-processing-head">Cash Buy In</div>
                            <div class="new-game-remarks-body">
                                <input type="text" class="form-control form-control-sm text-center new-game-cash-remarks-input" id="new-game-cash-remarks" name="txtCashRemarks" placeholder="Remarks" autocomplete="off" form="add_game_list">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="new-game-side-panel d-none" id="new-game-deposit-panel" aria-hidden="true">
                <div class="new-game-side-panel-title">Deposit</div>
                <div class="new-game-panel-sheet">
                    <div class="new-game-balance-head">
                        <div class="new-game-balance-head-cell" id="new-game-deposit-current-label">Current Balance Of Account</div>
                        <div class="new-game-balance-head-cell" id="new-game-deposit-anticipated-label">Anticipated Balance Of Account</div>
                    </div>
                    <div class="new-game-balance-values">
                        <div class="new-game-balance-value-cell" id="new-game-deposit-current">—</div>
                        <div class="new-game-balance-value-cell" id="new-game-deposit-anticipated">—</div>
                    </div>
                    <div class="new-game-processing-row">
                        <div class="new-game-processing-col">
                            <div class="new-game-processing-head">Processing Amount</div>
                            <div class="new-game-processing-body" id="new-game-deposit-processing-wrap">
                                <span id="new-game-deposit-processing">0</span>
                            </div>
                        </div>
                        <div class="new-game-remarks-col">
                            <div class="new-game-processing-head">Remarks</div>
                            <div class="new-game-remarks-body">
                                <input type="text" class="form-control form-control-sm text-center new-game-deposit-remarks-input" id="new-game-deposit-remarks" name="txtDepositRemarks" placeholder="Remarks" autocomplete="off" form="add_game_list">
                            </div>
                        </div>
                    </div>
                    <div class="new-game-history-wrap">
                        <table class="table table-bordered table-sm mb-0 new-game-history-tbl">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Transaction</th>
                                    <th class="text-end">Amount</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody id="new-game-deposit-history-body">
                                <tr class="text-muted">
                                    <td colspan="4" class="text-center small py-2">No history.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="new-game-side-panel d-none new-game-side-panel-credit" id="new-game-credit-panel" aria-hidden="true">
                <div class="new-game-side-panel-title">Credit</div>
                <div class="new-game-panel-sheet new-game-credit-sheet">
                    <div class="new-game-credit-summary-grid">
                        <div class="new-game-credit-summary-col">
                            <div class="new-game-balance-head-cell" id="new-game-credit-current-label">Current Credit Balance Of Account</div>
                            <div class="new-game-balance-value-cell text-amount-negative" id="new-game-credit-current">—</div>
                        </div>
                        <div class="new-game-credit-summary-col">
                            <div class="new-game-balance-head-cell" id="new-game-credit-anticipated-label">Anticipated Credit Balance Of Account</div>
                            <div class="new-game-balance-value-cell text-amount-negative" id="new-game-credit-anticipated">—</div>
                        </div>
                        <div class="new-game-credit-guest-cols" id="new-game-credit-guest-cols"></div>
                    </div>
                    <div class="new-game-credit-processing-row">
                        <div class="new-game-credit-proc-col">
                            <div class="new-game-processing-head">Processing Amount</div>
                            <div class="new-game-processing-body" id="new-game-credit-processing-wrap">
                                <span id="new-game-credit-processing">0</span>
                            </div>
                        </div>
                        <div class="new-game-credit-proc-col">
                            <div class="new-game-processing-head">채무자 Debtor</div>
                            <div class="new-game-credit-party-body new-game-credit-debtor-body" id="new-game-credit-debtor">
                                <div id="new-game-credit-debtor-account">—</div>
                                <div class="new-game-credit-debtor-guest" id="new-game-credit-debtor-guest">—</div>
                            </div>
                        </div>
                        <div class="new-game-credit-proc-col">
                            <div class="new-game-processing-head">보증인 Guarantor</div>
                            <div class="new-game-credit-party-body new-game-credit-guarantor-body">
                                <input type="text" class="form-control form-control-sm text-center new-game-credit-guarantor-input" id="new-game-credit-guarantor" name="txtCreditGuarantor" placeholder="Guarantor" autocomplete="off" form="add_game_list">
                            </div>
                        </div>
                        <div class="new-game-credit-proc-col">
                            <div class="new-game-processing-head">Credit Buy In</div>
                            <div class="new-game-remarks-body">
                                <input type="text" class="form-control form-control-sm text-center new-game-credit-remarks-input" id="new-game-credit-remarks" name="txtCreditRemarks" placeholder="Remarks" autocomplete="off" form="add_game_list">
                            </div>
                        </div>
                    </div>
                    <div class="new-game-history-wrap new-game-credit-history-wrap">
                        <table class="table table-bordered table-sm mb-0 new-game-history-tbl new-game-credit-history-tbl">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Transaction</th>
                                    <th colspan="2" class="text-center">채무자 Debtor</th>
                                    <th>보증인 Guarantor</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end">Balance</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody id="new-game-credit-history-body">
                                <tr class="text-muted">
                                    <td colspan="8" class="text-center small py-2">No history.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </div>
</div>

<style>
#modal-new-game-list .select2-container {
    z-index: 1060;
}
#modal-new-game-list .select2-dropdown {
    z-index: 9999;
}
#modal-new-game-list .new-game-main-content {
    width: 32rem;
    max-width: 100%;
    flex-shrink: 0;
    position: relative;
}
#modal-new-game-list.show,
#modal-new-game-list.showing {
    display: flex !important;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
}
#modal-new-game-list .new-game-list-modal-dialog {
    max-width: calc(100vw - 1.5rem);
    width: max-content;
    margin: 0 auto;
}
#modal-new-game-list .new-game-modal-cluster {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.75rem;
    margin: 0 auto;
}
#modal-new-game-list .new-game-side-panels {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 36rem;
    flex-shrink: 0;
    align-self: flex-start;
    min-height: 0;
    position: relative;
    pointer-events: auto;
}
#modal-new-game-list .new-game-side-panels:not(.new-game-side-panels-empty) {
    display: flex;
    max-height: calc(100vh - 4.5rem);
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
}
#modal-new-game-list .new-game-side-resize-handle {
    position: absolute;
    right: -0.45rem;
    top: 0;
    bottom: 0;
    width: 0.85rem;
    cursor: ew-resize;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6c757d;
    font-size: 0.72rem;
    line-height: 1;
    user-select: none;
    touch-action: none;
    border-left: 1px solid #ced4da;
    border-right: 1px solid #ced4da;
    background: linear-gradient(90deg, #f8f9fa 0%, #fff 50%, #f8f9fa 100%);
    border-radius: 0.2rem;
    opacity: 0.85;
}
#modal-new-game-list .new-game-side-resize-handle:hover,
#modal-new-game-list .new-game-side-resize-handle.is-dragging {
    opacity: 1;
    color: #0d6efd;
    border-color: #0d6efd;
    background: #e7f1ff;
}
#modal-new-game-list .new-game-side-panels.new-game-side-panels-empty .new-game-side-resize-handle {
    display: none;
}
body.new-game-side-resize-active {
    cursor: ew-resize !important;
    user-select: none !important;
}
#modal-new-game-list .new-game-side-panels.new-game-side-panels-empty,
#modal-new-game-list .new-game-side-panels:not(:has(.new-game-side-panel:not(.d-none))) {
    display: none;
    width: 0;
    min-width: 0;
    gap: 0;
    overflow: hidden;
}
#modal-new-game-list .new-game-side-panel {
    background: #fff;
    border: 1px solid #dee2e6;
    border-radius: 0.35rem;
    box-shadow: 0 0.35rem 1rem rgba(0, 0, 0, 0.12);
    overflow: hidden;
    pointer-events: auto;
}
#modal-new-game-list .new-game-side-panel-title {
    background: #0d6efd;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    text-align: center;
    padding: 0.35rem 0.5rem;
}
#modal-new-game-list .new-game-panel-sheet {
    display: flex;
    flex-direction: column;
}
#modal-new-game-list .new-game-cash-balance-head,
#modal-new-game-list .new-game-balance-head {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
}
#modal-new-game-list .new-game-balance-head {
    grid-template-columns: 1fr 1fr;
}
#modal-new-game-list .new-game-balance-head-cell {
    background: #cfe2ff;
    color: #1a1a1a;
    font-size: 0.68rem;
    font-weight: 600;
    text-align: center;
    padding: 0.45rem 0.35rem;
    border-bottom: 1px solid #dee2e6;
    line-height: 1.25;
}
#modal-new-game-list .new-game-balance-head-cell + .new-game-balance-head-cell {
    border-left: 1px solid #dee2e6;
}
#modal-new-game-list .new-game-cash-balance-values,
#modal-new-game-list .new-game-balance-values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid #dee2e6;
}
#modal-new-game-list .new-game-balance-values {
    grid-template-columns: 1fr 1fr;
}
#modal-new-game-list .new-game-balance-value-cell {
    padding: 0.55rem 0.35rem;
    text-align: center;
    font-weight: 700;
