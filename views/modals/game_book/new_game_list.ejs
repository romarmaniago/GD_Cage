<%
const _sqlNNChipsBuyin = typeof sqlNNChipsBuyin !== 'undefined' ? sqlNNChipsBuyin : [{ NNChipsBuyin: 0 }];
const _sqlNNChipsCashout = typeof sqlNNChipsCashout !== 'undefined' ? sqlNNChipsCashout : [{ NNChipsCashout: 0 }];
const _sqlAccountNNChips = typeof sqlAccountNNChips !== 'undefined' ? sqlAccountNNChips : [{ TOTAL_NN: 0 }];
const _sqlTotalCashOutRolling = typeof sqlTotalCashOutRolling !== 'undefined' ? sqlTotalCashOutRolling : [{ TOTAL_CASHOUT: 0 }];
const _sqlTotalRealRolling = typeof sqlTotalRealRolling !== 'undefined' ? sqlTotalRealRolling : [{ TOTAL_REAL_ROLLING: 0 }];
const _sqlNNChipsRolling = typeof sqlNNChipsRolling !== 'undefined' ? sqlNNChipsRolling : [{ NNChipsRolling: 0 }];
const _sqlCCChipsRolling = typeof sqlCCChipsRolling !== 'undefined' ? sqlCCChipsRolling : [{ CCChipsRolling: 0 }];
const _sqlNNBuyin = typeof sqlNNBuyin !== 'undefined' ? sqlNNBuyin : [{ NNBuyin: 0 }];
const _sqlNNReturn = typeof sqlNNReturn !== 'undefined' ? sqlNNReturn : [{ NNReturn: 0 }];
const _sqlRollerNNSubtract = typeof sqlRollerNNSubtract !== 'undefined' ? sqlRollerNNSubtract : [{ ROLLER_NN_SUBTRACT: 0 }];
const _sqlRollerNNAdd = typeof sqlRollerNNAdd !== 'undefined' ? sqlRollerNNAdd : [{ ROLLER_NN_ADD: 0 }];
const _sqlCCChipsBuyin = typeof sqlCCChipsBuyin !== 'undefined' ? sqlCCChipsBuyin : [{ CCChipsBuyin: 0 }];
const _sqlCCChipsCashout = typeof sqlCCChipsCashout !== 'undefined' ? sqlCCChipsCashout : [{ CCChipsCashout: 0 }];
const _sqlAccountCCChipsReturn = typeof sqlAccountCCChipsReturn !== 'undefined' ? sqlAccountCCChipsReturn : [{ CC_CHIPS_RETURN: 0 }];
const _sqlCCChipsBuyinGame = typeof sqlCCChipsBuyinGame !== 'undefined' ? sqlCCChipsBuyinGame : [{ TOTAL_CC: 0 }];
const _sqlCCBuyin = typeof sqlCCBuyin !== 'undefined' ? sqlCCBuyin : [{ CCBuyin: 0 }];
const _sqlCCReturn = typeof sqlCCReturn !== 'undefined' ? sqlCCReturn : [{ CCReturn: 0 }];
const _sqlRollerCCSubtract = typeof sqlRollerCCSubtract !== 'undefined' ? sqlRollerCCSubtract : [{ ROLLER_CC_SUBTRACT: 0 }];
const _sqlRollerCCAdd = typeof sqlRollerCCAdd !== 'undefined' ? sqlRollerCCAdd : [{ ROLLER_CC_ADD: 0 }];
%>
<div class="modal fade" id="modal-new-game-list" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
