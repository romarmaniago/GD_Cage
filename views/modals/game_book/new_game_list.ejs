    const creditAnticipatedEl = document.getElementById('new-game-credit-anticipated');
    const creditProcessingEl = document.getElementById('new-game-credit-processing');
    const creditProcessingWrap = document.getElementById('new-game-credit-processing-wrap');
    const creditDebtorAccountEl = document.getElementById('new-game-credit-debtor-account');
    const creditDebtorGuestEl = document.getElementById('new-game-credit-debtor-guest');
    const creditGuarantorInput = document.getElementById('new-game-credit-guarantor');
    const creditRemarksInput = document.getElementById('new-game-credit-remarks');
    const creditGuestColsEl = document.getElementById('new-game-credit-guest-cols');
    const creditHistoryBody = document.getElementById('new-game-credit-history-body');

    let ledgerHistory = [];
    let creditHistory = [];
    let creditMeta = { totalCredit: 0, balanceCredit: 0, balanceBuyin: 0, guestBalances: [], agentCode: '', agentName: '', agencyName: '' };
    let cashEngaged = false;
    let depositEngaged = false;
    let creditEngaged = false;

    const parseAmt = function (raw) {
        const s = (raw || '').toString().replace(/,/g, '').trim();
        if (!s) return 0;
        const n = Number(s);
        return Number.isFinite(n) ? n : 0;
    };

    const formatAmt = function (n) {
        return Math.round(n).toLocaleString('en-US');
    };

    const formatNegativeAmt = function (n) {
        const abs = Math.round(Math.abs(parseAmt(n)));
        if (!abs) return '0';
        return '(' + formatAmt(abs) + ')';
    };

    const formatCreditOwed = function (amount) {
        const owed = Math.max(0, parseAmt(amount));
        if (!owed) return '0';
        return formatNegativeAmt(owed);
    };

    const hasRowInput = function (nnId, ccId) {
        const nn = (document.getElementById(nnId) && document.getElementById(nnId).value || '').replace(/,/g, '').trim();
        const cc = (document.getElementById(ccId) && document.getElementById(ccId).value || '').replace(/,/g, '').trim();
        return !!(nn || cc);
    };

    const getAgentCode = function () {
        const sel = document.getElementById('txtTrans');
        if (sel && sel.value && sel.selectedOptions && sel.selectedOptions[0]) {
            const text = (sel.selectedOptions[0].text || '').trim();
            if (text) return text;
        }
        return (agentCodeEl && agentCodeEl.textContent || '').trim() || 'Account';
    };

    const hasSelectedAccount = function () {
        const sel = document.getElementById('txtTrans');
        return !!(sel && String(sel.value || '').trim());
    };

    const getGuestName = function () {
        const sel = document.getElementById('txtGuestGame');
        if (sel && sel.selectedOptions && sel.selectedOptions[0]) {
            const val = sel.value;
            if (val) return (sel.selectedOptions[0].text || '').trim();
        }
        return (guestNameEl && guestNameEl.textContent || '').trim();
    };

    const extractAccountCode = function (raw) {
        const s = String(raw || '').trim();
        if (!s) return '';
        const match = s.match(/\(([^)]+)\)\s*$/);
        if (match) return match[1].trim();
        return s;
    };

    const getCreditAccountCode = function () {
        if (creditMeta && creditMeta.agentCode) {
            return extractAccountCode(creditMeta.agentCode);
        }
        const sel = document.getElementById('txtTrans');
        if (sel && sel.value && sel.selectedOptions && sel.selectedOptions[0]) {
            const dataCode = sel.selectedOptions[0].getAttribute('data-agent-code');
            if (dataCode) return String(dataCode).trim();
            return extractAccountCode((sel.selectedOptions[0].text || '').trim());
        }
        return extractAccountCode(getAgentCode()) || 'Account';
    };

    const syncAgentGuestLabels = function () {
        if (agentCodeEl) agentCodeEl.textContent = getAgentCode();
        if (guestNameEl) guestNameEl.textContent = getGuestName();
    };

    const shouldShowCashPanel = function () {
        return hasRowInput('splitCashNN', 'splitCashCC');
    };

    const shouldShowDepositPanel = function () {
        return hasRowInput('splitDepNN', 'splitDepCC');
    };

    const shouldShowCreditPanel = function () {
        return hasRowInput('splitCreditNN', 'splitCreditCC');
    };

    const computeCashProcessing = function () {
        return parseAmt(document.getElementById('splitCashNN') && document.getElementById('splitCashNN').value) +
            parseAmt(document.getElementById('splitCashCC') && document.getElementById('splitCashCC').value);
    };

    const computeDepositProcessing = function () {
        return parseAmt(document.getElementById('splitDepNN') && document.getElementById('splitDepNN').value) +
            parseAmt(document.getElementById('splitDepCC') && document.getElementById('splitDepCC').value);
    };

    const computeCreditProcessing = function () {
        return parseAmt(document.getElementById('splitCreditNN') && document.getElementById('splitCreditNN').value) +
            parseAmt(document.getElementById('splitCreditCC') && document.getElementById('splitCreditCC').value);
    };

    const setProcessingDisplay = function (el, wrap, processing) {
        if (!el || !wrap) return;
        if (processing < 0) {
            el.textContent = formatNegativeAmt(processing);
        } else {
            el.textContent = formatAmt(processing);
        }
        wrap.classList.toggle('is-negative', processing < 0);
        wrap.classList.toggle('is-positive', processing > 0);
    };

    const applyHistoryWrapHeights = function () {
        modal.querySelectorAll('.new-game-history-wrap').forEach(function (wrap) {
            const tbl = wrap.querySelector('table');
            if (!tbl) return;
            const head = tbl.querySelector('thead');
            const sampleRow = tbl.querySelector('tbody tr:not(.text-muted)');
            const headH = head ? head.getBoundingClientRect().height : 28;
            const rowH = sampleRow ? sampleRow.getBoundingClientRect().height : 26;
            wrap.style.maxHeight = Math.ceil(headH + rowH * 5) + 'px';
        });
    };

    const applySidePanelsDefaultWidth = function () {
        const sidePanels = document.getElementById('new-game-side-panels');
        if (!sidePanels || sidePanels.dataset.userSized === '1') return;
        const creditOpen = creditPanel && !creditPanel.classList.contains('d-none');
        sidePanels.style.width = creditOpen ? '40rem' : '36rem';
    };

    const resetSidePanelsWidth = function () {
        const sidePanels = document.getElementById('new-game-side-panels');
        if (!sidePanels) return;
        delete sidePanels.dataset.userSized;
        sidePanels.style.width = '';
    };

    const wireSidePanelsResize = function () {
        const sidePanels = document.getElementById('new-game-side-panels');
        const resizeHandle = document.getElementById('new-game-side-resize-handle');
        const cluster = modal.querySelector('.new-game-modal-cluster');
        if (!sidePanels || !resizeHandle || !cluster) return;

        const minWidth = 18 * 16;
        let dragging = false;
        let startX = 0;
        let startWidth = 0;

        const getMaxWidth = function () {
            const mainContent = modal.querySelector('.new-game-main-content');
            const mainWidth = mainContent ? mainContent.getBoundingClientRect().width : 512;
            const gap = 12;
            const padding = 24;
            return Math.max(minWidth, window.innerWidth - padding - mainWidth - gap - 32);
        };

        const onMove = function (e) {
            if (!dragging) return;
            const nextWidth = Math.min(getMaxWidth(), Math.max(minWidth, startWidth + (e.clientX - startX)));
            sidePanels.style.width = nextWidth + 'px';
        };

        const onStop = function () {
            if (!dragging) return;
            dragging = false;
            resizeHandle.classList.remove('is-dragging');
            document.body.classList.remove('new-game-side-resize-active');
            window.removeEventListener('mousemove', onMove);
            window.removeEventListener('mouseup', onStop);
        };

        resizeHandle.addEventListener('mousedown', function (e) {
            if (sidePanels.classList.contains('new-game-side-panels-empty')) return;
            e.preventDefault();
            e.stopPropagation();
            dragging = true;
            startX = e.clientX;
            startWidth = sidePanels.getBoundingClientRect().width;
            sidePanels.dataset.userSized = '1';
            resizeHandle.classList.add('is-dragging');
            document.body.classList.add('new-game-side-resize-active');
            window.addEventListener('mousemove', onMove);
            window.addEventListener('mouseup', onStop);
        });
    };

    const togglePanel = function (panel, visible) {
        if (!panel) return;
        panel.classList.toggle('d-none', !visible);
        panel.setAttribute('aria-hidden', visible ? 'false' : 'true');
        syncSidePanelsLayout();
    };

    const syncSidePanelsLayout = function () {
        const sidePanels = document.getElementById('new-game-side-panels');
        if (!sidePanels) return;
        const anyVisible =
            (cashPanel && !cashPanel.classList.contains('d-none')) ||
            (depositPanel && !depositPanel.classList.contains('d-none')) ||
            (creditPanel && !creditPanel.classList.contains('d-none'));
        sidePanels.classList.toggle('new-game-side-panels-empty', !anyVisible);
        applySidePanelsDefaultWidth();
    };

    const getCreditHistoryDebtorParts = function (row) {
        const code = extractAccountCode((row && row.AGENT_CODE) || creditMeta.agentCode || getCreditAccountCode());
        const guest = row && row.GUEST_NAME ? String(row.GUEST_NAME).trim() : '';
        return { account: code || '—', guest: guest || '—' };
    };

    const parseCreditRemarks = function (remarks) {
        const raw = String(remarks || '').trim();
        if (!raw) return { remarks: '', guarantor: '' };
        const idx = raw.indexOf('Guarantor:');
        if (idx === -1) return { remarks: raw, guarantor: '' };
        const remarksPart = raw.slice(0, idx).replace(/\|\s*$/, '').trim();
        const guarantor = raw.slice(idx + 'Guarantor:'.length).trim();
        return { remarks: remarksPart, guarantor: guarantor };
    };

    const renderGuestCreditBreakdown = function () {
        if (!creditGuestColsEl) return;
        const guests = Array.isArray(creditMeta.guestBalances) ? creditMeta.guestBalances : [];
        if (!guests.length) {
            creditGuestColsEl.innerHTML = '';
            return;
        }
        let html = '';
        guests.forEach(function (g) {
            const bal = Number(g.creditBalance) || 0;
            if (bal <= 0) return;
            const name = (g.guestName || '').trim() || 'Guest';
            html += '<div class="new-game-credit-guest-col">' +
                '<div class="new-game-balance-head-cell">' + name + '</div>' +
                '<div class="new-game-balance-value-cell text-amount-negative">' + formatCreditOwed(bal) + '</div>' +
                '</div>';
        });
        creditGuestColsEl.innerHTML = html;
    };

    const getCreditReturnSourceLabel = function (desc) {
        const normalized = String(desc || '').trim().toUpperCase();
        if (normalized === 'RETURN_SOURCE:CREDIT') return 'Junket Credit';
        if (normalized === 'RETURN_SOURCE:BUYIN') return 'Game Credit';
        return '';
    };

    const renderCreditTransactionLabel = function (row) {
        const info = row.TRANSACTION_INFO || '';
        const parts = String(info).split('-');
        const transactionId = parseInt(parts[0], 10);
        const transactionType = parseInt(parts[1], 10);
        const sourceLabel = getCreditReturnSourceLabel(row.TRANSACTION_DESC);
        switch (transactionId) {
            case 3: return 'Cash Credit';
            case 10: return 'Chips Credit';
            case 11: return sourceLabel ? (sourceLabel + ' Returned thru Cash') : 'Credit Returned thru Cash';
            case 12: return sourceLabel ? (sourceLabel + ' Returned thru Deposit') : 'Credit Returned thru Deposit';
            default:
                return transactionType === 4 ? 'Chips Return thru Credit' : 'Credit';
        }
    };

    const isCreditOutTxn = function (row) {
        const info = row && row.TRANSACTION_INFO;
        if (!info) return false;
        const transactionId = parseInt(String(info).split('-')[0], 10);
        return transactionId === 3 || transactionId === 10;
    };

    const computeCreditHistoryBalances = function (rows) {
        const chronological = rows.slice().reverse();
        let running = 0;
        const balanceById = {};
        chronological.forEach(function (row) {
            const amount = parseAmt(row.AMOUNT);
            if (isCreditOutTxn(row)) {
                running += amount;
            } else {
                running = Math.max(0, running - amount);
            }
            if (row.IDNo != null) balanceById[row.IDNo] = running;
        });
        return balanceById;
    };

    const renderCreditHistoryTable = function (pendingAmount, pendingRemarks, pendingGuarantor) {
        if (!creditHistoryBody) return;
        const rows = creditHistory.slice();
        const balanceById = computeCreditHistoryBalances(rows);
        let html = '';

        rows.forEach(function (row) {
            const amount = parseAmt(row.AMOUNT);
            const isOut = isCreditOutTxn(row);
            const displayAmt = isOut ? formatNegativeAmt(amount) : formatAmt(amount);
            const amtClass = 'text-end' + (isOut ? ' text-amount-negative' : '');
            const balance = balanceById[row.IDNo] != null ? balanceById[row.IDNo] : 0;
            const debtor = getCreditHistoryDebtorParts(row);
            const parsed = parseCreditRemarks(row.REMARKS);
            html += '<tr>' +
                '<td>' + formatHistoryDate(row.ENCODED_DT || row.encoded_date) + '</td>' +
                '<td>' + renderCreditTransactionLabel(row) + '</td>' +
                '<td class="new-game-debtor-account">' + debtor.account + '</td>' +
                '<td>' + debtor.guest + '</td>' +
                '<td>' + (parsed.guarantor || '—') + '</td>' +
                '<td class="' + amtClass + '">' + displayAmt + '</td>' +
                '<td class="text-end text-amount-negative">' + formatCreditOwed(balance) + '</td>' +
                '<td>' + (parsed.remarks || '—') + '</td>' +
                '</tr>';
        });

        if (pendingAmount > 0) {
            const currentOwed = Math.max(0, parseAmt(creditMeta.totalCredit));
            const pendingBalance = currentOwed + pendingAmount;
            const code = getCreditAccountCode();
            const guest = getGuestName() || '—';
            html += '<tr class="is-pending">' +
                '<td>' + formatHistoryDate(new Date()) + '</td>' +
                '<td>Chips Credit</td>' +
                '<td class="new-game-debtor-account">' + (code || '—') + '</td>' +
                '<td>' + guest + '</td>' +
                '<td>' + (pendingGuarantor || '—') + '</td>' +
                '<td class="text-end text-amount-negative">' + formatNegativeAmt(pendingAmount) + '</td>' +
                '<td class="text-end text-amount-negative">' + formatCreditOwed(pendingBalance) + '</td>' +
                '<td>' + (pendingRemarks || '—') + '</td>' +
                '</tr>';
        }

        if (!html) {
            html = '<tr class="text-muted"><td colspan="8" class="text-center small py-2">No history.</td></tr>';
        }

        creditHistoryBody.innerHTML = html;
        requestAnimationFrame(applyHistoryWrapHeights);
    };

    const formatHistoryDate = function (raw) {
        if (!raw) return '—';
        const d = new Date(raw);
        if (Number.isNaN(d.getTime())) return String(raw);
        return (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
    };

    const renderDepositHistory = function (pendingAmount, pendingRemarks) {
        if (!depositHistoryBody) return;
        let html = '';
        ledgerHistory.forEach(function (row) {
            const txn = row.TRANSACTION || row.TRANSACTION_DESC || '—';
            const amount = parseAmt(row.AMOUNT);
            const isNeg = (txn || '').toUpperCase().indexOf('WITHDRAW') !== -1;
            html += '<tr>' +
                '<td>' + formatHistoryDate(row.encoded_date || row.ENCODED_DT) + '</td>' +
                '<td>' + txn + '</td>' +
                '<td class="text-end' + (isNeg ? ' text-amount-negative' : '') + '">' +
                    (isNeg ? formatNegativeAmt(amount) : formatAmt(amount)) + '</td>' +
                '<td>' + (row.REMARKS || '—') + '</td>' +
                '</tr>';
        });
        if (pendingAmount > 0) {
            html += '<tr class="is-pending">' +
                '<td>' + formatHistoryDate(new Date()) + '</td>' +
                '<td>Chips Buy In</td>' +
                '<td class="text-end">' + formatAmt(pendingAmount) + '</td>' +
                '<td>' + (pendingRemarks || '—') + '</td>' +
                '</tr>';
        }
        if (!html) {
            html = '<tr class="text-muted"><td colspan="4" class="text-center small py-2">No history.</td></tr>';
        }
        depositHistoryBody.innerHTML = html;
    };

    const updateDebtorDisplay = function () {
        const code = getCreditAccountCode();
        const guest = getGuestName();
        if (creditDebtorAccountEl) creditDebtorAccountEl.textContent = code || '—';
        if (creditDebtorGuestEl) {
            creditDebtorGuestEl.textContent = guest || '—';
            creditDebtorGuestEl.classList.toggle('d-none', !guest);
        }
    };

    const updateCashPanel = function () {
        const show = hasSelectedAccount() && (cashEngaged || shouldShowCashPanel());
        if (!show) {
            togglePanel(cashPanel, false);
            return;
        }
        togglePanel(cashPanel, true);
        const baseNN = parseAmt(nnBaseEl && nnBaseEl.textContent);
        const baseCC = parseAmt(ccBaseEl && ccBaseEl.textContent);
        const cashNn = parseAmt(document.getElementById('splitCashNN') && document.getElementById('splitCashNN').value);
        const cashCc = parseAmt(document.getElementById('splitCashCC') && document.getElementById('splitCashCC').value);
        const hasInput = shouldShowCashPanel();
        const processing = computeCashProcessing();

        if (cashNnCurrentEl) cashNnCurrentEl.textContent = formatAmt(baseNN);
        if (cashNnAnticipatedEl) cashNnAnticipatedEl.textContent = hasInput ? formatAmt(Math.max(0, baseNN - cashNn)) : '—';
        if (cashCcCurrentEl) cashCcCurrentEl.textContent = formatAmt(baseCC);
        if (cashCcAnticipatedEl) cashCcAnticipatedEl.textContent = hasInput ? formatAmt(Math.max(0, baseCC - cashCc)) : '—';
        setProcessingDisplay(cashProcessingEl, cashProcessingWrap, hasInput ? processing : 0);
    };

    const updateDepositPanel = function () {
        const show = hasSelectedAccount() && (depositEngaged || shouldShowDepositPanel());
        if (!show) {
            togglePanel(depositPanel, false);
            return;
        }
        const code = getCreditAccountCode();
        const base = parseAmt(accountBaseEl && accountBaseEl.value);
        const processing = computeDepositProcessing();
        const hasInput = shouldShowDepositPanel();
        const pendingRemarks = depositRemarksInput ? depositRemarksInput.value.trim() : '';

        if (depositCurrentLabelEl) depositCurrentLabelEl.textContent = 'Current Balance Of ' + code;
        if (depositAnticipatedLabelEl) depositAnticipatedLabelEl.textContent = 'Anticipated Balance Of ' + code;
        if (depositCurrentEl) depositCurrentEl.textContent = formatAmt(base);
        if (depositAnticipatedEl) depositAnticipatedEl.textContent = hasInput ? formatAmt(Math.max(0, base - processing)) : '—';
        setProcessingDisplay(depositProcessingEl, depositProcessingWrap, hasInput ? processing : 0);
        renderDepositHistory(hasInput ? processing : 0, pendingRemarks);
        togglePanel(depositPanel, true);
    };

    const updateCreditPanel = function () {
        const show = hasSelectedAccount() && (creditEngaged || shouldShowCreditPanel());
        if (!show) {
            togglePanel(creditPanel, false);
            return;
        }
        const code = getCreditAccountCode();
        const base = parseAmt(creditMeta.totalCredit);
        const processing = computeCreditProcessing();
        const hasInput = shouldShowCreditPanel();
        const anticipated = base + processing;
        const pendingRemarks = creditRemarksInput ? creditRemarksInput.value.trim() : '';
        const pendingGuarantor = creditGuarantorInput ? creditGuarantorInput.value.trim() : '';

        if (creditCurrentLabelEl) creditCurrentLabelEl.textContent = 'Current Credit Balance Of ' + code;
        if (creditAnticipatedLabelEl) creditAnticipatedLabelEl.textContent = 'Anticipated Credit Balance Of ' + code;
        if (creditCurrentEl) creditCurrentEl.textContent = formatCreditOwed(base);
        if (creditAnticipatedEl) creditAnticipatedEl.textContent = hasInput ? formatCreditOwed(anticipated) : '—';
        renderGuestCreditBreakdown();
        setProcessingDisplay(creditProcessingEl, creditProcessingWrap, hasInput ? -processing : 0);
        updateDebtorDisplay();
        renderCreditHistoryTable(hasInput ? processing : 0, pendingRemarks, pendingGuarantor);
        togglePanel(creditPanel, true);
    };

    const updateBalanceSummary = function () {
        const active = document.activeElement;
        if (hasSelectedAccount()) {
            if (isCashGroupFocused(active)) cashEngaged = true;
            if (isDepositGroupFocused(active)) depositEngaged = true;
            if (isCreditGroupFocused(active)) creditEngaged = true;
        } else {
            cashEngaged = false;
            depositEngaged = false;
            creditEngaged = false;
        }
        syncAgentGuestLabels();
        updateCashPanel();
        updateDepositPanel();
        updateCreditPanel();
    };

    const resetBalanceDisplay = function () {
        cashEngaged = false;
        depositEngaged = false;
        creditEngaged = false;
        resetSidePanelsWidth();
        togglePanel(cashPanel, false);
        togglePanel(depositPanel, false);
        togglePanel(creditPanel, false);
        if (cashRemarksInput) cashRemarksInput.value = '';
        if (depositRemarksInput) depositRemarksInput.value = '';
        if (creditRemarksInput) creditRemarksInput.value = '';
        if (creditGuarantorInput) creditGuarantorInput.value = '';
        ledgerHistory = [];
        creditHistory = [];
        creditMeta = { totalCredit: 0, balanceCredit: 0, balanceBuyin: 0, guestBalances: [], agentCode: '', agentName: '', agencyName: '' };
        if (creditGuestColsEl) creditGuestColsEl.innerHTML = '';
        if (depositHistoryBody) {
            depositHistoryBody.innerHTML = '<tr class="text-muted"><td colspan="4" class="text-center small py-2">No history.</td></tr>';
        }
        if (creditHistoryBody) {
            creditHistoryBody.innerHTML = '<tr class="text-muted"><td colspan="8" class="text-center small py-2">No history.</td></tr>';
        }
    };

    const loadCompanyBalances = function () {
        return fetch('/game_list_company_balance', { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
            .then(function (data) {
                if (nnBaseEl) nnBaseEl.textContent = String(Number(data && data.nnChipsBalance) || 0);
                if (ccBaseEl) ccBaseEl.textContent = String(Number(data && data.ccChipsBalance) || 0);
            })
            .catch(function () {
                if (nnBaseEl) nnBaseEl.textContent = '0';
                if (ccBaseEl) ccBaseEl.textContent = '0';
            });
    };

    const loadAccountBalance = function () {
        const accountId = document.getElementById('txtTrans') && document.getElementById('txtTrans').value;
        if (!accountId) {
            if (accountBaseEl) accountBaseEl.value = '0';
            ledgerHistory = [];
            return Promise.resolve();
        }
        return fetch('/account_details_data_deposit/' + encodeURIComponent(accountId), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
            .then(function (data) {
                ledgerHistory = Array.isArray(data) ? data : [];
                let depositAmount = 0;
                let withdrawAmount = 0;
                let markerReturn = 0;
                let markerDepositAmount = 0;
                ledgerHistory.forEach(function (row) {
                    const amount = parseAmt(row.AMOUNT);
                    const txn = row.TRANSACTION || '';
                    if (txn === 'DEPOSIT') depositAmount += amount;
                    else if (txn === 'WITHDRAW') withdrawAmount += amount;
                    else if (txn === 'IOU RETURN DEPOSIT') markerReturn += amount;
                    else if (txn === 'MARKER REDEEM') markerDepositAmount += amount;
                });
                const total = depositAmount + markerDepositAmount - withdrawAmount - markerReturn;
                if (accountBaseEl) accountBaseEl.value = String(total);
            })
            .catch(function () {
                ledgerHistory = [];
                if (accountBaseEl) accountBaseEl.value = '0';
            });
    };

    const loadCreditContext = function () {
        const accountId = document.getElementById('txtTrans') && document.getElementById('txtTrans').value;
        if (!accountId) {
            creditHistory = [];
            creditMeta = { totalCredit: 0, balanceCredit: 0, balanceBuyin: 0, guestBalances: [], agentCode: '', agentName: '', agencyName: '' };
            if (creditGuestColsEl) creditGuestColsEl.innerHTML = '';
            return Promise.resolve();
        }
        return fetch('/game_list_cashout_credit/' + encodeURIComponent(accountId), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
            .then(function (data) {
                creditMeta = {
                    totalCredit: Number(data && data.totalCredit) || 0,
                    balanceCredit: Number(data && data.balanceCredit) || 0,
                    balanceBuyin: Number(data && data.balanceBuyin) || 0,
                    guestBalances: Array.isArray(data && data.guestBalances) ? data.guestBalances : [],
                    agentCode: (data && data.agentCode) || '',
                    agentName: (data && data.agentName) || '',
                    agencyName: (data && data.agencyName) || ''
                };
                creditHistory = Array.isArray(data && data.history) ? data.history : [];
            })
            .catch(function () {
                creditHistory = [];
                creditMeta = { totalCredit: 0, balanceCredit: 0, balanceBuyin: 0, guestBalances: [], agentCode: '', agentName: '', agencyName: '' };
                if (creditGuestColsEl) creditGuestColsEl.innerHTML = '';
            });
    };

    const loadModalBalances = function () {
        resetBalanceDisplay();
        syncAgentGuestLabels();
        return Promise.all([loadCompanyBalances(), loadAccountBalance(), loadCreditContext()])
            .then(updateBalanceSummary);
    };

    const allowSidePanelFocus = function (e) {
        if (!e.target || !e.target.closest) return;
        if (
            e.target.closest('#new-game-side-panels') ||
            e.target.closest('.select2-container') ||
            e.target.closest('.select2-dropdown')
        ) {
            e.stopImmediatePropagation();
        }
    };

    window.disengageNewGameSidePanels = function () {
        cashEngaged = false;
        depositEngaged = false;
        creditEngaged = false;
        updateBalanceSummary();
    };

    const releaseFocusTrap = function () {
        if (window.bootstrap && bootstrap.Modal) {
            const instance = bootstrap.Modal.getInstance(modal) || bootstrap.Modal.getOrCreateInstance(modal, { focus: false });
            if (instance) {
                instance._config.focus = false;
                if (instance._focustrap && typeof instance._focustrap.deactivate === 'function') {
                    instance._focustrap.deactivate();
                }
            }
        }
        window.addEventListener('focusin', allowSidePanelFocus, true);
    };

    const restoreFocusTrap = function () {
        window.removeEventListener('focusin', allowSidePanelFocus, true);
    };

    const isDepositGroupFocused = function (activeEl) {
        if (!activeEl) return false;
        if (depositRemarksInput && activeEl === depositRemarksInput) return true;
        return activeEl.classList && activeEl.classList.contains('new-game-deposit-input');
    };

    const isCreditGroupFocused = function (activeEl) {
        if (!activeEl) return false;
        if (creditRemarksInput && activeEl === creditRemarksInput) return true;
        if (creditGuarantorInput && activeEl === creditGuarantorInput) return true;
        return activeEl.classList && activeEl.classList.contains('new-game-credit-input');
    };

    const isCashGroupFocused = function (activeEl) {
        if (!activeEl) return false;
        if (cashRemarksInput && activeEl === cashRemarksInput) return true;
        return activeEl.classList && activeEl.classList.contains('new-game-cash-input');
    };

    const wireSideField = function (inputEl, panelType) {
        if (!inputEl) return;
        inputEl.addEventListener('mousedown', function (e) { e.stopPropagation(); });
        inputEl.addEventListener('focus', function () {
            if (!hasSelectedAccount()) return;
            if (panelType === 'cash') cashEngaged = true;
            else if (panelType === 'deposit') depositEngaged = true;
            else creditEngaged = true;
            updateBalanceSummary();
        });
        inputEl.addEventListener('input', function () {
            updateBalanceSummary();
        });
        inputEl.addEventListener('blur', function () {
            setTimeout(function () {
                const active = document.activeElement;
                if (panelType === 'cash' && isCashGroupFocused(active)) return;
                if (panelType === 'deposit' && isDepositGroupFocused(active)) return;
                if (panelType === 'credit' && isCreditGroupFocused(active)) return;
                if (panelType === 'cash' && !shouldShowCashPanel()) { cashEngaged = false; updateBalanceSummary(); }
                if (panelType === 'deposit' && !shouldShowDepositPanel()) { depositEngaged = false; updateBalanceSummary(); }
                if (panelType === 'credit' && !shouldShowCreditPanel()) { creditEngaged = false; updateBalanceSummary(); }
            }, 0);
        });
    };

    const wirePanelInputs = function (selector, type) {
        const inputs = modal.querySelectorAll(selector);
        const hasInputFn = type === 'cash' ? shouldShowCashPanel : (type === 'deposit' ? shouldShowDepositPanel : shouldShowCreditPanel);
        inputs.forEach(function (inputEl) {
            inputEl.addEventListener('focus', function () {
                if (!hasSelectedAccount()) return;
                if (type === 'cash') cashEngaged = true;
                else if (type === 'deposit') depositEngaged = true;
                else creditEngaged = true;
                updateBalanceSummary();
            });
            inputEl.addEventListener('input', function () {
                updateBalanceSummary();
                if (typeof newGameListRefreshCommissionRate === 'function') newGameListRefreshCommissionRate();
            });
            inputEl.addEventListener('blur', function () {
                setTimeout(function () {
                    const active = document.activeElement;
                    let stillFocused = false;
                    inputs.forEach(function (el) { if (el === active) stillFocused = true; });
                    if (type === 'cash' && isCashGroupFocused(active)) stillFocused = true;
                    if (type === 'deposit' && isDepositGroupFocused(active)) stillFocused = true;
                    if (type === 'credit' && isCreditGroupFocused(active)) stillFocused = true;
                    if (!stillFocused && !hasInputFn()) {
                        if (type === 'cash') cashEngaged = false;
                        else if (type === 'deposit') depositEngaged = false;
                        else creditEngaged = false;
                        updateBalanceSummary();
                    }
                }, 0);
            });
        });
    };

    wirePanelInputs('.new-game-cash-input', 'cash');
    wirePanelInputs('.new-game-deposit-input', 'deposit');
    wirePanelInputs('.new-game-credit-input', 'credit');
    wireSideField(cashRemarksInput, 'cash');
    wireSideField(depositRemarksInput, 'deposit');
    wireSideField(creditRemarksInput, 'credit');
    wireSideField(creditGuarantorInput, 'credit');

    modal.querySelectorAll('.new-game-field-grid label[for="splitCashNN"]').forEach(function (labelEl) {
        labelEl.style.cursor = 'pointer';
        labelEl.addEventListener('click', function () {
            if (!hasSelectedAccount()) return;
            cashEngaged = true;
            updateCashPanel();
        });
    });

    modal.querySelectorAll('.new-game-field-grid label[for="splitCreditNN"]').forEach(function (labelEl) {
        labelEl.style.cursor = 'pointer';
        labelEl.addEventListener('click', function () {
            if (!hasSelectedAccount()) return;
            creditEngaged = true;
            updateCreditPanel();
        });
    });

    modal.addEventListener('shown.bs.modal', function () {
        releaseFocusTrap();
        loadModalBalances();
    });
    modal.addEventListener('hidden.bs.modal', function () {
        restoreFocusTrap();
        resetBalanceDisplay();
    });

    wireSidePanelsResize();
    syncSidePanelsLayout();

    window.refreshNewGameListModalBalances = function () {
        return loadModalBalances();
    };
    window.updateNewGameBalanceSummary = updateBalanceSummary;
});
</script>



