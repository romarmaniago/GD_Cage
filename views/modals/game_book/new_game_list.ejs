<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

/** Parsed from #availableNN / #availableCC (server-rendered); negative display treated as 0. */
function newGameListAvailableNN() {
    const el = document.getElementById('availableNN');
    if (!el) return 0;
    const raw = (el.innerText || '').replace(/[^0-9.-]+/g, '');
    const n = parseFloat(raw);
    return Number.isFinite(n) ? Math.max(0, n) : 0;
}
function newGameListAvailableCC() {
    const el = document.getElementById('availableCC');
    if (!el) return 0;
    const raw = (el.innerText || '').replace(/[^0-9.-]+/g, '');
    const n = parseFloat(raw);
    return Number.isFinite(n) ? Math.max(0, n) : 0;
}

function newGameListSplitSumNN() {
    return ['splitCashNN', 'splitDepNN', 'splitCreditNN'].reduce(function (acc, id) {
        const el = document.getElementById(id);
        const v = (el && el.value || '').toString().replace(/,/g, '').trim();
        return acc + (v === '' ? 0 : (parseFloat(v) || 0));
    }, 0);
}
function newGameListSplitSumCC() {
    return ['splitCashCC', 'splitDepCC', 'splitCreditCC'].reduce(function (acc, id) {
        const el = document.getElementById(id);
        const v = (el && el.value || '').toString().replace(/,/g, '').trim();
        return acc + (v === '' ? 0 : (parseFloat(v) || 0));
    }, 0);
}

function newGameListSplitBuyinEnabled() {
    const el = document.getElementById('enableSplitNewGame');
    return !!(el && el.checked);
}

document.addEventListener("DOMContentLoaded", function () {
    const txtNN = document.getElementById("txtNN");
    const txtRollerNN = document.getElementById("txtRollerNN");

    function getAvailableChips() {
        return newGameListAvailableNN();
    }

    // Live validation: NN values must be positive thousands (1,000 / 2,000 / 3,000 ...)
    function validateNnThousandsInline(inputEl) {
        if (!inputEl) return true;

        const raw = (inputEl.value || '').toString().replace(/,/g, '');
        const trimmed = raw.trim();

        // Allow empty field (validated later depending on context)
        if (!trimmed) {
            inputEl.classList.remove('is-invalid');
            return true;
        }

        const value = parseFloat(trimmed) || 0;

        if (value <= 0 || value % 1000 !== 0) {
            inputEl.classList.add('is-invalid');
            return false;
        }

        inputEl.classList.remove('is-invalid');
        return true;
    }

    if (txtNN) {
        txtNN.addEventListener("input", function () {
            // Thousands-only validation first
            const isValidThousands = validateNnThousandsInline(this);
            if (!isValidThousands) return;

            if (newGameListSplitBuyinEnabled()) return;

            const inputVal = parseFloat(this.value.replace(/,/g, "")) || 0;
            const rollerNNVal = parseFloat((txtRollerNN && txtRollerNN.value || '').replace(/,/g, '')) || 0;
            const available = getAvailableChips();

            if (inputVal + rollerNNVal > available) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Exceeds Available NN Chips',
                    text: `You only have ${available.toLocaleString()} Chips available (including Roller NN).`,
                    confirmButtonColor: '#3a57e8'
                });

                this.value = ""; // clear input
                this.classList.remove('is-invalid');
                this.focus();
            }
        });
    }

    if (txtRollerNN) {
        txtRollerNN.addEventListener("input", function () {
            validateNnThousandsInline(this);
            const rollerVal = parseFloat((this.value || '').replace(/,/g, '')) || 0;
            const nnVal = newGameListSplitBuyinEnabled()
                ? newGameListSplitSumNN()
                : (parseFloat((txtNN && txtNN.value || '').replace(/,/g, '')) || 0);
            const available = getAvailableChips();
            if (rollerVal > 0 && nnVal + rollerVal > available) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Exceeds Available NN Chips',
                    text: `You only have ${available.toLocaleString()} Chips available (NN buy-in + Roller NN).`,
                    confirmButtonColor: '#3a57e8'
                });
                this.value = '';
                this.classList.remove('is-invalid');
                this.focus();
            }
        });
    }
});

document.addEventListener('DOMContentLoaded', function () {
    const splitToggle = document.getElementById('enableSplitNewGame');
    const splitRow = document.getElementById('split-new-game-row');
    const transTypeRow = document.querySelector('#modal-new-game-list input[name="txtTransType"]')?.closest('.row.mb-2');
    const transTypeRadios = document.querySelectorAll('#modal-new-game-list input[name="txtTransType"]');
    const baseAmountRow = document.querySelector('#modal-new-game-list #txtNN')?.closest('.row');
    const splitInputs = [
        document.getElementById('splitCashNN'),
        document.getElementById('splitCashCC'),
        document.getElementById('splitDepNN'),
        document.getElementById('splitDepCC'),
        document.getElementById('splitCreditNN'),
        document.getElementById('splitCreditCC')
    ];

    const validateNnSplitInput = function (inputEl) {
        if (!inputEl) return;
        const id = inputEl.id || '';
        const isNnField = id.toLowerCase().includes('nn');
        const raw = (inputEl.value || '').toString().replace(/,/g, '').trim();
        if (!raw) {
            inputEl.classList.remove('is-invalid');
            return;
        }
        const n = Number(raw);
        const invalid = !Number.isFinite(n) || n < 0 || (isNnField && n > 0 && n % 1000 !== 0);
        inputEl.classList.toggle('is-invalid', invalid);
    };

    splitInputs.forEach(function (inputEl) {
        if (!inputEl) return;
        inputEl.addEventListener('input', function () {
            validateNnSplitInput(inputEl);
            const id = (inputEl.id || '').toLowerCase();
            const avNN = newGameListAvailableNN();
            const avCC = newGameListAvailableCC();
            if (id.includes('nn')) {
                const rollerNNVal = parseFloat((document.getElementById('txtRollerNN') && document.getElementById('txtRollerNN').value || '').replace(/,/g, '')) || 0;
                const totalNN = newGameListSplitSumNN() + rollerNNVal;
                if (totalNN > avNN) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Exceeds Available NN Chips',
                        text: 'Split NN total (plus Roller NN) cannot exceed ' + avNN.toLocaleString() + ' Chips.',
                        confirmButtonColor: '#3a57e8'
                    });
                    inputEl.value = '';
                    inputEl.classList.remove('is-invalid');
                    inputEl.focus();
                    return;
                }
            }
            if (id.includes('cc')) {
                const rollerCCVal = parseFloat((document.getElementById('txtRollerCC') && document.getElementById('txtRollerCC').value || '').replace(/,/g, '')) || 0;
                const totalCC = newGameListSplitSumCC() + rollerCCVal;
                if (totalCC > avCC) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Exceeds Available CC Chips',
                        text: 'Split CC total (plus Roller CC) cannot exceed ' + avCC.toLocaleString() + ' Chips.',
                        confirmButtonColor: '#3a57e8'
                    });
                    inputEl.value = '';
                    inputEl.classList.remove('is-invalid');
                    inputEl.focus();
                }
            }
        });
    });

    if (!splitToggle) return;
    splitToggle.addEventListener('change', function () {
        const isOn = !!this.checked;
        if (splitRow) splitRow.style.display = isOn ? '' : 'none';
        if (baseAmountRow) baseAmountRow.style.display = isOn ? 'none' : '';
        if (transTypeRow) transTypeRow.style.display = isOn ? 'none' : '';
        transTypeRadios.forEach(function (radio) {
            radio.disabled = isOn;
            if (isOn) radio.checked = false;
        });
        if (!isOn) {
            splitInputs.forEach(function (inputEl) {
                if (!inputEl) return;
                inputEl.value = '';
                inputEl.classList.remove('is-invalid');
            });
        }
    });
});

document.addEventListener("DOMContentLoaded", function () {
    const txtCC = document.getElementById("txtCC");
    const txtRollerCC = document.getElementById("txtRollerCC");

    function getAvailableCCChips() {
        return newGameListAvailableCC();
    }

    if (txtCC) {
        txtCC.addEventListener("input", function () {
            if (newGameListSplitBuyinEnabled()) return;

            const inputVal = parseFloat(this.value.replace(/,/g, "")) || 0;
            const rollerCCVal = parseFloat((txtRollerCC && txtRollerCC.value || '').replace(/,/g, '')) || 0;
            const available = getAvailableCCChips();

            if (inputVal + rollerCCVal > available) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Exceeds Available CC Chips',
                    text: `You only have ${available.toLocaleString()} Chips available (including Roller CC).`,
                    confirmButtonColor: '#3a57e8'
                });

                this.value = "";
                this.focus();
            }
        });
    }

    if (txtRollerCC) {
        txtRollerCC.addEventListener("input", function () {
            const rollerVal = parseFloat((this.value || '').replace(/,/g, '')) || 0;
            const ccVal = newGameListSplitBuyinEnabled()
                ? newGameListSplitSumCC()
                : (parseFloat((txtCC && txtCC.value || '').replace(/,/g, '')) || 0);
            const available = getAvailableCCChips();
            if (rollerVal > 0 && ccVal + rollerVal > available) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Exceeds Available CC Chips',
                    text: `You only have ${available.toLocaleString()} Chips available (CC buy-in + Roller CC).`,
                    confirmButtonColor: '#3a57e8'
                });
                this.value = '';
                this.focus();
            }
        });
    }
});
    
document.addEventListener('DOMContentLoaded', function () {
    const commissionType = document.getElementById('commissionType');
    const commissionRate = document.getElementById('commissionRate');
    const form = document.getElementById('add_game_list');

    // Set default commission rates
    let defaultRollingGameRate = 1.50;  // Default for Rolling Game (CASH/DEPOSIT)
    let defaultSharedGameRate = 50;    // Default for Shared Game (CASH/DEPOSIT and Marker)
    let defaultMarkerRollingRate = 1.50;  // Default for Rolling Game (Marker)

    // Initialize commission rate based on selected commission type
    const setCommissionRate = () => {
        // Check if elements exist
        if (!commissionType || !commissionRate) {
            return; // Exit early if elements don't exist
        }

        // Get selected transaction with null check
        const selectedTransactionRadio = document.querySelector('input[name="txtTransType"]:checked');
        const selectedTransaction = selectedTransactionRadio ? selectedTransactionRadio.value : null;

        // Handle different commission type logic based on transaction
        if (commissionType.value === "1") { // Rolling Game
            commissionRate.setAttribute("step", "0.05"); // 0.05 increment for Rolling Game only
            if (selectedTransaction === "3") { // Marker selected
                commissionRate.value = defaultMarkerRollingRate; // Set to 0% for Marker
                commissionRate.setAttribute("min", "0"); // Minimum 0% for Marker
            } else {
                commissionRate.value = defaultRollingGameRate; // Default 1.5% for CASH/DEPOSIT
                commissionRate.setAttribute("min", "0"); // Minimum 1.4% for Rolling Game (CASH/DEPOSIT)
            }
        } else if (commissionType.value === "2") { // Shared Game
            commissionRate.setAttribute("step", "0.1"); // Shared keeps its own increment (keydown 2.5)
            commissionRate.value = defaultSharedGameRate; // Default 50% for both CASH/DEPOSIT and Marker
            commissionRate.setAttribute("min", "50"); // Minimum 50% for Shared Game
        }
    };

    // Listen to commission type changes (Rolling, Shared, etc.)
    if (commissionType && commissionRate) {
        commissionType.addEventListener('change', function () {
            setCommissionRate();
        });
    }

    // Listen to transaction type changes (CASH/DEPOSIT or MARKER)
    const transactionTypeRadios = document.querySelectorAll('input[name="txtTransType"]');
    transactionTypeRadios.forEach(radio => {
        radio.addEventListener('change', function () {
            setCommissionRate();
        });
    });

    // Set initial step and rate (Rolling Game selected by default)
    // Only call if elements exist
    if (commissionType && commissionRate) {
        setCommissionRate();
    }

    // Event listener for keydown (Arrow Up & Arrow Down)
    if (commissionRate && commissionType) {
        commissionRate.addEventListener('keydown', function (event) {
            if (commissionType.value === "1") { // Rolling Game: increment/decrement by 0.05
                if (event.key === "ArrowUp") {
                    event.preventDefault();
                    incrementRollingGameRate();
                } else if (event.key === "ArrowDown") {
                    event.preventDefault();
                    decrementRollingGameRate();
                }
            } else if (commissionType.value === "2") { // Shared Game: increment/decrement by 2.5
                if (event.key === "ArrowUp") {
                    event.preventDefault();
                    incrementSharedGameRate();
                } else if (event.key === "ArrowDown") {
                    event.preventDefault();
                    decrementSharedGameRate();
                }
            }
        });
    }

    // Function to increment Shared Game commission rate by 2.5%
    const incrementSharedGameRate = () => {
        if (!commissionRate) return;
        let currentRate = parseFloat(commissionRate.value);
        let newRate = currentRate + 2.5;
        if (newRate <= 100) { // Limit to max 100%
            commissionRate.value = newRate.toFixed(1);
        }
    };

    // Function to decrement Shared Game commission rate by 2.5%
    const decrementSharedGameRate = () => {
        if (!commissionRate) return;
        let currentRate = parseFloat(commissionRate.value);
        let newRate = currentRate - 2.5;
        if (newRate >= 45) { // Limit to min 45%
            commissionRate.value = newRate.toFixed(1);
        }
    };

    // Function to increment Rolling Game commission rate by 0.05%
    const incrementRollingGameRate = () => {
        if (!commissionRate) return;
        let currentRate = parseFloat(commissionRate.value) || 0;
        let newRate = currentRate + 0.05;
        if (newRate <= 100) {
            commissionRate.value = newRate.toFixed(2);
        }
    };

    // Function to decrement Rolling Game commission rate by 0.05%
    const decrementRollingGameRate = () => {
        if (!commissionRate) return;
        let currentRate = parseFloat(commissionRate.value) || 0;
        let newRate = currentRate - 0.05;
        if (newRate >= 0) {
            commissionRate.value = newRate.toFixed(2);
        }
    };

    // Handle form submission (if needed)
    form.addEventListener('submit', function (event) {
        event.preventDefault(); // Prevent default form submission
        // Perform your submit logic here, e.g., using AJAX
        // Swal.fire('Game added successfully!'); // Show success message
        // Close the modal if needed
        // $('#modal-new-game-list').modal('hide'); // Uncomment if using Bootstrap modal
    });
});


</script>



