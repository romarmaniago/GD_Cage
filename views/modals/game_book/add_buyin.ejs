<div class="modal fade" id="modal-add-buyin" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
					<div class="modal-header bg-primary">
						<h5 class="modal-title text-white" id="staticBackdropLiveLabel">Add Buy In - <span id="buyin-agent-code"></span></h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<form id="add_buyin">
					<div class="modal-body">
						<span class="d-none" id="buyin-availableNN" aria-hidden="true">0</span>
						<span class="d-none" id="buyin-availableCC" aria-hidden="true">0</span>
						<input type="hidden" id="total_amount_addbuyin" name="txtTotalAmountBuyin" />
						
						<input type="hidden" name="game_id" class="game_list_id">
						<input type="hidden" name="txtAccountCode" class="txtAccountCode">

						<div class="row mb-4">
							<div class="col-sm-12">
								<input type="hidden" class="form-control text-center"  id="total_balanceGuest2" name="totalBalanceGuest2" readonly/>
								<input type="text" class="form-control text-center"  id="total_balanceGuest2GameList"  readonly/>
							</div>
						</div>

						<div class="row mb-4" id="buyin-nncc-row">
							<div class="col-sm-6">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="form-control text-center txtNN" placeholder="NN Chips" name="txtNN">
							</div>

								<div class="col-sm-6">
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center txtCC" placeholder="CC Chips" name="txtCC">
								</div>
							</div>

							<div class="row mb-2" id="buyin-trans-type-row">
								<div class="col-sm-4">
									<div class="form-check">
										<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="1" id="cash" name="txtTransType">
										<label class="form-check-label" for="cash">
											<span class="d-flex align-items-center">
												Cash
											</span>
										</label>
									</div>
								</div>
								<div class="col-sm-4">
									<div class="form-check">
										<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="2" id="deposit" name="txtTransType">
										<label class="form-check-label" for="deposit">
											<span class="d-flex align-items-center">
												Deposit
											</span>
										</label>
									</div>
								</div>
								<div class="col-sm-4">
									<div class="form-check">
										<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="3" id="marker" name="txtTransType">
										<label class="form-check-label" for="marker">
											<span class="d-flex align-items-center">
												Credit
											</span>
										</label>
									</div>
								</div>
							</div>

							<div class="row mb-2">
								<div class="col-sm-12 d-flex align-items-center justify-content-between">
									<div class="form-check mb-0">
										<input class="form-check-input" type="checkbox" id="enableSplitBuyin">
										<label class="form-check-label" for="enableSplitBuyin">
											Split Additional Buy-in 
										</label>
									</div>
								</div>
							</div>

							<div class="row mb-3" id="split-buyin-row" style="display:none;">
								<div class="col-sm-6 mb-2 mb-sm-0">
									<div class="border rounded p-2 h-100">
										<div class="fw-semibold small text-muted mb-2">NN Chips</div>
										<div class="mb-2">
											<label class="form-label mb-1">Cash</label>
											<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center" id="splitBuyinCashNN" placeholder="NN Chips">
										</div>
										<div class="mb-2">
											<label class="form-label mb-1">Deposit</label>
											<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center" id="splitBuyinDepNN" placeholder="NN Chips">
										</div>
										<div>
											<label class="form-label mb-1">Credit</label>
											<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center" id="splitBuyinCreditNN" placeholder="NN Chips">
										</div>
									</div>
								</div>
								<div class="col-sm-6">
									<div class="border rounded p-2 h-100">
										<div class="fw-semibold small text-muted mb-2">CC Chips</div>
										<div class="mb-2">
											<label class="form-label mb-1">Cash</label>
											<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center" id="splitBuyinCashCC" placeholder="CC Chips">
										</div>
										<div class="mb-2">
											<label class="form-label mb-1">Deposit</label>
											<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center" id="splitBuyinDepCC" placeholder="CC Chips">
										</div>
										<div>
											<label class="form-label mb-1">Credit</label>
											<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center" id="splitBuyinCreditCC" placeholder="CC Chips">
										</div>
									</div>
								</div>
							</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
	const modal = document.getElementById('modal-add-buyin');
	if (!modal) return;

	function addBuyinParseAvailEl(el) {
		if (!el) return 0;
		const raw = (el.textContent || el.innerText || '').replace(/[^0-9.-]+/g, '');
		const n = parseFloat(raw);
		return Number.isFinite(n) ? Math.max(0, n) : 0;
	}
	function addBuyinAvailableNN() {
		return addBuyinParseAvailEl(document.getElementById('buyin-availableNN'));
	}
	function addBuyinAvailableCC() {
		return addBuyinParseAvailEl(document.getElementById('buyin-availableCC'));
	}
	function addBuyinSplitBuyinEnabled() {
		const el = document.getElementById('enableSplitBuyin');
		return !!(el && el.checked);
	}
	function addBuyinSplitSumNN() {
		return ['splitBuyinCashNN', 'splitBuyinDepNN', 'splitBuyinCreditNN'].reduce(function (acc, id) {
			const el = document.getElementById(id);
			const v = (el && el.value || '').toString().replace(/,/g, '').trim();
			return acc + (v === '' ? 0 : (parseFloat(v) || 0));
		}, 0);
	}
	function addBuyinSplitSumCC() {
		return ['splitBuyinCashCC', 'splitBuyinDepCC', 'splitBuyinCreditCC'].reduce(function (acc, id) {
			const el = document.getElementById(id);
			const v = (el && el.value || '').toString().replace(/,/g, '').trim();
			return acc + (v === '' ? 0 : (parseFloat(v) || 0));
		}, 0);
	}
	function addBuyinSwalWarn(title, text) {
		if (typeof Swal !== 'undefined') {
			Swal.fire({ icon: 'warning', title: title, text: text, confirmButtonColor: '#3a57e8' });
		} else {
			window.alert(title + '\n\n' + text);
		}
	}

	modal.addEventListener('shown.bs.modal', function () {
		fetch('/game_list_available_chips', { credentials: 'same-origin' })
			.then(function (r) {
				if (!r.ok) throw new Error('bad status');
				return r.json();
			})
			.then(function (data) {
				const nnEl = document.getElementById('buyin-availableNN');
				const ccEl = document.getElementById('buyin-availableCC');
				const nn = Number(data && data.availableNN) || 0;
				const cc = Number(data && data.availableCC) || 0;
				if (nnEl) nnEl.textContent = nn.toLocaleString();
				if (ccEl) ccEl.textContent = cc.toLocaleString();
			})
			.catch(function () {
				const nnEl = document.getElementById('buyin-availableNN');
				const ccEl = document.getElementById('buyin-availableCC');
				if (nnEl) nnEl.textContent = '0';
				if (ccEl) ccEl.textContent = '0';
			});
	});

	const nnInput = document.querySelector('#modal-add-buyin .txtNN');
	if (nnInput) {
		nnInput.addEventListener('input', function () {
			const raw = (this.value || '').toString().replace(/,/g, '');
			const trimmed = raw.trim();

			if (!trimmed) {
				this.classList.remove('is-invalid');
				return;
			}

			const value = Number(trimmed);

			if (!Number.isFinite(value) || value <= 0 || value % 1000 !== 0) {
				this.classList.add('is-invalid');
				return;
			}

			this.classList.remove('is-invalid');

			if (addBuyinSplitBuyinEnabled()) return;

			const avail = addBuyinAvailableNN();
			if (value > avail) {
				addBuyinSwalWarn(
					'Exceeds Available NN Chips',
					'You only have ' + avail.toLocaleString() + ' NN Chips available.'
				);
				this.value = '';
				this.classList.remove('is-invalid');
				this.focus();
			}
		});
	}

	const ccInput = document.querySelector('#modal-add-buyin .txtCC');
	if (ccInput) {
		ccInput.addEventListener('input', function () {
			const raw = (this.value || '').toString().replace(/,/g, '');
			const trimmed = raw.trim();
			if (!trimmed) return;

			const value = Number(trimmed);
			if (!Number.isFinite(value) || value < 0) return;

			if (addBuyinSplitBuyinEnabled()) return;

			const avail = addBuyinAvailableCC();
			if (value > avail) {
				addBuyinSwalWarn(
					'Exceeds Available CC Chips',
					'You only have ' + avail.toLocaleString() + ' CC Chips available.'
				);
				this.value = '';
				this.focus();
			}
		});
	}

	const splitToggle = document.getElementById('enableSplitBuyin');
	const splitRow = document.getElementById('split-buyin-row');
	const nnccRow = document.getElementById('buyin-nncc-row');
	const transTypeRow = document.getElementById('buyin-trans-type-row');
	const radios = document.querySelectorAll('#modal-add-buyin input[name="txtTransType"]');
	const splitInputs = [
		document.getElementById('splitBuyinCashNN'),
		document.getElementById('splitBuyinCashCC'),
		document.getElementById('splitBuyinDepNN'),
		document.getElementById('splitBuyinDepCC'),
		document.getElementById('splitBuyinCreditNN'),
		document.getElementById('splitBuyinCreditCC')
	];

	const validateSplit = function (el) {
		if (!el) return;
		const raw = (el.value || '').toString().replace(/,/g, '').trim();
		if (!raw) {
			el.classList.remove('is-invalid');
			return;
		}
		const n = Number(raw);
		const isNN = (el.id || '').toLowerCase().includes('nn');
		const invalid = !Number.isFinite(n) || n < 0 || (isNN && n > 0 && n % 1000 !== 0);
		el.classList.toggle('is-invalid', invalid);
	};
	splitInputs.forEach(function (el) {
		if (!el) return;
		el.addEventListener('input', function () {
			validateSplit(el);
			const id = (el.id || '').toLowerCase();
			const avNN = addBuyinAvailableNN();
			const avCC = addBuyinAvailableCC();
			if (id.includes('nn')) {
				const totalNN = addBuyinSplitSumNN();
				if (totalNN > avNN) {
					addBuyinSwalWarn(
						'Exceeds Available NN Chips',
						'Split NN total cannot exceed ' + avNN.toLocaleString() + ' Chips.'
					);
					el.value = '';
					el.classList.remove('is-invalid');
					el.focus();
					return;
				}
			}
			if (id.includes('cc')) {
				const totalCC = addBuyinSplitSumCC();
				if (totalCC > avCC) {
					addBuyinSwalWarn(
						'Exceeds Available CC Chips',
						'Split CC total cannot exceed ' + avCC.toLocaleString() + ' Chips.'
					);
					el.value = '';
					el.classList.remove('is-invalid');
					el.focus();
				}
			}
		});
	});

	if (splitToggle) {
		splitToggle.addEventListener('change', function () {
			const isOn = this.checked;
			if (splitRow) splitRow.style.display = isOn ? '' : 'none';
			if (nnccRow) nnccRow.style.display = isOn ? 'none' : '';
			if (transTypeRow) transTypeRow.style.display = isOn ? 'none' : '';
			radios.forEach(function (r) { r.disabled = isOn; if (isOn) r.checked = false; });
			if (!isOn) {
				splitInputs.forEach(function (el) {
					if (!el) return;
					el.value = '';
					el.classList.remove('is-invalid');
				});
			}
		});
	}
});
</script>
					<div class="modal-footer">
						<button type="submit" id="submit-buyin-btn" class="btn btn-sm btn-primary" >
							Save
						</button>
						<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
							Close
						</button>
					</div>
				</form>
		</div>
	</div>
</div>
