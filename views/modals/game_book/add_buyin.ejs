<div class="modal fade" id="modal-add-buyin" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered buyin-modal-dialog">
		<div class="buyin-modal-cluster">
		<div class="modal-content buyin-main-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white" id="staticBackdropLiveLabel">Add Buy In - <span id="buyin-agent-code"></span></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="add_buyin">
			<div class="modal-body">
				<span class="d-none" id="buyin-availableNN" aria-hidden="true">0</span>
				<span class="d-none" id="buyin-availableCC" aria-hidden="true">0</span>
				<input type="hidden" id="total_amount_addbuyin" name="txtTotalAmountBuyin" />
				<input type="hidden" name="game_id" class="game_list_id">
				<input type="hidden" name="txtAccountCode" class="txtAccountCode">
				<input type="hidden" id="total_balanceGuest2" name="totalBalanceGuest2" readonly/>
				<span class="d-none" id="buyin-nn-balance-base" aria-hidden="true">0</span>
				<span class="d-none" id="buyin-cc-balance-base" aria-hidden="true">0</span>
				<span class="d-none" id="buyin-agent-code-label" aria-hidden="true"></span>
				<span class="d-none" id="buyin-guest-name-label" aria-hidden="true"></span>

				<div id="split-buyin-row" class="buyin-input-sheet">
					<div class="buyin-section">
						<div class="buyin-field-grid">
							<label class="form-label mb-0" for="splitBuyinCashNN">Cash</label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center buyin-nn-input buyin-cash-input" placeholder="NN Chips" id="splitBuyinCashNN" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center buyin-cash-input" placeholder="CC Chips" id="splitBuyinCashCC" autocomplete="off" />
						</div>
						<div class="buyin-field-grid">
							<label class="form-label mb-0" for="splitBuyinDepNN">Deposit</label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center buyin-nn-input buyin-deposit-input" placeholder="NN Chips" id="splitBuyinDepNN" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center buyin-deposit-input" placeholder="CC Chips" id="splitBuyinDepCC" autocomplete="off" />
						</div>
						<div class="buyin-field-grid">
							<label class="form-label mb-0" for="splitBuyinCreditNN">Credit</label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center buyin-nn-input buyin-credit-input" placeholder="NN Chips" id="splitBuyinCreditNN" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control text-center buyin-credit-input" placeholder="CC Chips" id="splitBuyinCreditCC" autocomplete="off" />
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="submit" id="submit-buyin-btn" class="btn btn-sm btn-primary">Save</button>
				<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Close</button>
			</div>
			</form>
		</div>

        <div class="buyin-side-panels buyin-side-panels-empty" id="buyin-side-panels">
            <div class="buyin-side-resize-handle" id="buyin-side-resize-handle" title="Drag to resize" aria-hidden="true">⇔</div>
            <!-- Cash: two Excel-style boxes — company balances, then the Cash entry -->
            <div class="buyin-side-panel buyin-xl-panel d-none" id="buyin-cash-panel" aria-hidden="true">
                <div class="xl-box">
                    <div class="xl-grid xl-grid-4">
                        <div class="xl-head">Current NN Balance</div>
                        <div class="xl-head">Anticipated NN Balance</div>
                        <div class="xl-head">Current CC Balance</div>
                        <div class="xl-head">Anticipated CC Balance</div>
                        <div class="xl-value" id="buyin-cash-nn-current">—</div>
                        <div class="xl-value" id="buyin-cash-nn-anticipated">—</div>
                        <div class="xl-value" id="buyin-cash-cc-current">—</div>
                        <div class="xl-value" id="buyin-cash-cc-anticipated">—</div>
                    </div>
                </div>
                <div class="xl-box">
                    <div class="xl-title">Cash</div>
                    <div class="xl-grid xl-grid-2">
                        <div class="xl-head">Processing Amount</div>
                        <div class="xl-head">Remarks</div>
                        <div class="xl-value buyin-processing-body" id="buyin-cash-processing-wrap">
                            <span id="buyin-cash-processing">0</span>
                        </div>
                        <div class="xl-value xl-input-cell">
                            <input type="text" class="form-control form-control-sm text-center buyin-cash-remarks-input" id="buyin-cash-remarks" name="txtCashRemarks" placeholder="Remarks" autocomplete="off" form="add_buyin">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Deposit: one Excel-style box — balances, entry, then the account ledger with running balance -->
            <div class="buyin-side-panel buyin-xl-panel d-none" id="buyin-deposit-panel" aria-hidden="true">
                <div class="xl-box">
                    <div class="xl-title">Deposit</div>
                    <div class="xl-grid xl-grid-2">
                        <div class="xl-head" id="buyin-deposit-current-label">Current Balance of Account</div>
                        <div class="xl-head" id="buyin-deposit-anticipated-label">Anticipated Balance of Account</div>
                        <div class="xl-value xl-row-sep" id="buyin-deposit-current">—</div>
                        <div class="xl-value xl-row-sep" id="buyin-deposit-anticipated">—</div>
                        <div class="xl-head">Processing Amount</div>
                        <div class="xl-head">Remarks</div>
                        <div class="xl-value buyin-processing-body" id="buyin-deposit-processing-wrap">
                            <span id="buyin-deposit-processing">0</span>
                        </div>
                        <div class="xl-value xl-input-cell">
                            <input type="text" class="form-control form-control-sm text-center buyin-deposit-remarks-input" id="buyin-deposit-remarks" name="txtDepositRemarks" placeholder="Remarks" autocomplete="off" form="add_buyin">
                        </div>
                    </div>
                    <div class="buyin-history-wrap xl-history-wrap">
                        <table class="xl-history-tbl xl-deposit-tbl buyin-history-tbl">
                            <thead>
                                <tr>
                                    <th>Date &amp; Time</th>
                                    <th>Amount</th>
                                    <th>Balance</th>
                                    <th>Transaction</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody id="buyin-deposit-history-body">
                                <tr class="text-muted">
                                    <td colspan="5" class="text-center small py-2">No history.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Credit: one Excel-style box — balances (+ one column per guest), entry, then the credit ledger -->
            <div class="buyin-side-panel buyin-xl-panel d-none buyin-side-panel-credit" id="buyin-credit-panel" aria-hidden="true">
                <div class="xl-box">
                    <div class="xl-title">Credit</div>
                    <!-- Columns flow head-over-value; guest columns are added by renderGuestCreditBreakdown() -->
                    <div class="xl-grid xl-grid-cols">
                        <div class="xl-head" id="buyin-credit-current-label">Current Credit Balance of Account</div>
                        <div class="xl-value xl-row-sep" id="buyin-credit-current">—</div>
                        <div class="xl-head" id="buyin-credit-anticipated-label">Anticipated Credit Balance of Account</div>
                        <div class="xl-value xl-row-sep" id="buyin-credit-anticipated">—</div>
                        <div class="xl-contents" id="buyin-credit-guest-cols"></div>
                    </div>
                    <div class="xl-grid xl-grid-4">
                        <div class="xl-head">Processing Amount</div>
                        <div class="xl-head">채무자 Debtor</div>
                        <div class="xl-head">보증인 Guarantor</div>
                        <div class="xl-head">Remarks</div>
                        <div class="xl-value buyin-processing-body" id="buyin-credit-processing-wrap">
                            <span id="buyin-credit-processing">0</span>
                        </div>
                        <div class="xl-value xl-debtor-cell" id="buyin-credit-debtor">
                            <div id="buyin-credit-debtor-account">—</div>
                            <div class="xl-debtor-guest" id="buyin-credit-debtor-guest">—</div>
                        </div>
                        <div class="xl-value xl-input-cell">
                            <input type="text" class="form-control form-control-sm text-center buyin-credit-guarantor-input" id="buyin-credit-guarantor" name="txtCreditGuarantor" placeholder="Guarantor" autocomplete="off" form="add_buyin">
                        </div>
                        <div class="xl-value xl-input-cell">
                            <input type="text" class="form-control form-control-sm text-center buyin-credit-remarks-input" id="buyin-credit-remarks" name="txtCreditRemarks" placeholder="Remarks" autocomplete="off" form="add_buyin">
                        </div>
                    </div>
                    <div class="buyin-history-wrap buyin-credit-history-wrap xl-history-wrap">
                        <table class="xl-history-tbl xl-credit-tbl buyin-history-tbl">
                            <thead>
                                <tr>
                                    <th>Date &amp; Time</th>
                                    <th>Account</th>
                                    <th>Debtor</th>
                                    <th>Credit</th>
                                    <th>Balance</th>
                                    <th>Guarantor</th>
                                    <th>Transaction</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody id="buyin-credit-history-body">
                                <tr class="text-muted">
                                    <td colspan="8" class="text-center small py-2">No history.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
		</div>
	</div>
</div>

<style>
#modal-add-buyin .select2-container {
    z-index: 1060;
}
#modal-add-buyin .select2-dropdown {
    z-index: 9999;
}
#modal-add-buyin .buyin-main-content {
    width: 32rem;
    max-width: 100%;
    flex-shrink: 0;
    position: relative;
}
#modal-add-buyin.show,
#modal-add-buyin.showing {
    display: flex !important;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
}
#modal-add-buyin .buyin-modal-dialog {
    max-width: calc(100vw - 1.5rem);
    width: max-content;
    margin: 0 auto;
}
#modal-add-buyin .buyin-modal-cluster {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.75rem;
    margin: 0 auto;
}
#modal-add-buyin .buyin-side-panels {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 36rem;
    flex-shrink: 0;
    align-self: flex-start;
    min-height: 0;
    position: relative;
    pointer-events: auto;
}
#modal-add-buyin .buyin-side-panels:not(.buyin-side-panels-empty) {
    display: flex;
    max-height: calc(100vh - 4.5rem);
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
}
#modal-add-buyin .buyin-side-resize-handle {
    position: absolute;
    right: -0.45rem;
    top: 0;
    bottom: 0;
    width: 0.85rem;
    cursor: ew-resize;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6c757d;
    font-size: 0.72rem;
    line-height: 1;
    user-select: none;
    touch-action: none;
    border-left: 1px solid #ced4da;
    border-right: 1px solid #ced4da;
    background: linear-gradient(90deg, #f8f9fa 0%, #fff 50%, #f8f9fa 100%);
    border-radius: 0.2rem;
    opacity: 0.85;
}
#modal-add-buyin .buyin-side-resize-handle:hover,
#modal-add-buyin .buyin-side-resize-handle.is-dragging {
    opacity: 1;
    color: #0d6efd;
    border-color: #0d6efd;
    background: #e7f1ff;
}
#modal-add-buyin .buyin-side-panels.buyin-side-panels-empty .buyin-side-resize-handle {
    display: none;
}
body.buyin-side-resize-active {
    cursor: ew-resize !important;
    user-select: none !important;
}
#modal-add-buyin .buyin-side-panels.buyin-side-panels-empty,
#modal-add-buyin .buyin-side-panels:not(:has(.buyin-side-panel:not(.d-none))) {
    display: none;
    width: 0;
    min-width: 0;
    gap: 0;
    overflow: hidden;
}
#modal-add-buyin .buyin-side-panel {
    background: #fff;
    border: 1px solid #dee2e6;
    border-radius: 0.35rem;
    box-shadow: 0 0.35rem 1rem rgba(0, 0, 0, 0.12);
    overflow: hidden;
    pointer-events: auto;
}
#modal-add-buyin .buyin-side-panel-title {
    background: linear-gradient(180deg, #f7f4ec 0%, #efe6d2 100%);
    color: #4a3208;
    border-bottom: 2px solid #c8a24c;
    font-size: 0.78rem;
    font-weight: 700;
    text-align: center;
    padding: 0.35rem 0.5rem;
}
#modal-add-buyin .buyin-panel-sheet {
    display: flex;
    flex-direction: column;
}
#modal-add-buyin .buyin-cash-balance-head,
#modal-add-buyin .buyin-balance-head {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
}
#modal-add-buyin .buyin-balance-head {
    grid-template-columns: 1fr 1fr;
}
#modal-add-buyin .buyin-balance-head-cell {
    background: linear-gradient(180deg, #f7f4ec 0%, #efe6d2 100%);
    color: #4a3208;
    font-size: 0.68rem;
    font-weight: 600;
    text-align: center;
    padding: 0.45rem 0.35rem;
    border-bottom: 1px solid #dee2e6;
    line-height: 1.25;
}
#modal-add-buyin .buyin-balance-head-cell + .buyin-balance-head-cell {
    border-left: 1px solid #dee2e6;
}
#modal-add-buyin .buyin-cash-balance-values,
#modal-add-buyin .buyin-balance-values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid #dee2e6;
}
#modal-add-buyin .buyin-balance-values {
    grid-template-columns: 1fr 1fr;
}
#modal-add-buyin .buyin-balance-value-cell {
    padding: 0.55rem 0.35rem;
    text-align: center;
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.2;
    word-break: break-word;
}
#modal-add-buyin .buyin-balance-value-cell + .buyin-balance-value-cell {
    border-left: 1px solid #dee2e6;
}
#modal-add-buyin .buyin-processing-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid #dee2e6;
}
#modal-add-buyin .buyin-processing-col + .buyin-remarks-col {
    border-left: 1px solid #dee2e6;
}
#modal-add-buyin .buyin-processing-head {
    background: linear-gradient(180deg, #f7f4ec 0%, #efe6d2 100%);
    color: #4a3208;
    font-size: 0.72rem;
    font-weight: 600;
    text-align: center;
    padding: 0.45rem 0.4rem;
    border-bottom: 1px solid #dee2e6;
}
#modal-add-buyin .buyin-processing-body {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 0.55rem 0.4rem;
    font-weight: 700;
    font-size: 1rem;
    min-height: 2.35rem;
}
#modal-add-buyin .buyin-processing-body.is-positive {
    color: #198754;
}
#modal-add-buyin .buyin-remarks-body {
    padding: 0.3rem 0.35rem;
    min-height: 2.1rem;
    display: flex;
    align-items: center;
}
#modal-add-buyin .buyin-remarks-body .form-control {
    width: 100%;
    min-width: 0;
    pointer-events: auto;
}
/* Excel-style panel (Cash): yellow headers, black grid lines, two separate boxes */
#modal-add-buyin .buyin-xl-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.6rem;
}
#modal-add-buyin .buyin-xl-panel.d-none {
    display: none !important;
}
#modal-add-buyin .xl-box {
    border: 3px solid #000; /* Excel "Thick Outside Borders" */
    background: #fff;
}
#modal-add-buyin .xl-title {
    padding: 0.2rem 0.4rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #000;
    text-align: center;
    background: #ffe699;
    border-bottom: 1px solid #000;
}
#modal-add-buyin .xl-grid {
    display: grid;
}
#modal-add-buyin .xl-grid-4 { grid-template-columns: repeat(4, 1fr); }
#modal-add-buyin .xl-grid-2 { grid-template-columns: 1fr 1fr; }
#modal-add-buyin .xl-head,
#modal-add-buyin .xl-value {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.4rem;
    font-weight: 700;
    color: #000;
    text-align: center;
    border-right: 1px solid #000;
}
#modal-add-buyin .xl-grid-4 > :nth-child(4n),
#modal-add-buyin .xl-grid-2 > :nth-child(2n) {
    border-right: 0;
}
#modal-add-buyin .xl-head {
    font-size: 0.8rem;
    background: #fff2cc;
    
}
/* line between a value row and the header row below it (also matches the guest columns) */
#modal-add-buyin .xl-grid .xl-row-sep {
    border-bottom: 1px solid #000;
}
#modal-add-buyin .xl-value {
    min-height: 1.9rem;
    font-size: 0.9rem;
    background: #fff;
}
#modal-add-buyin .xl-value.buyin-processing-body {
    padding: 0.2rem 0.4rem;
    min-height: 1.9rem;
    font-size: 0.95rem;
}
#modal-add-buyin .xl-value.buyin-processing-body.is-positive {
    color: #00b050;
}
/*/* Ledger table inside an Excel-style box.
   Separate borders (not collapsed): a sticky header keeps its lines while the rows scroll under it. */
#modal-add-buyin table.xl-history-tbl {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.78rem;
    color: #000;
}
#modal-add-buyin table.xl-history-tbl th {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 0.2rem 0.4rem;
    font-weight: 700;
    text-align: center;
    text-transform: none;
    color: #000;
    background: #f2f2f2;
    border: 0;
    border-top: 1px solid #000;
    border-right: 1px solid #000;
    border-bottom: 1px solid #000;
}
#modal-add-buyin table.xl-history-tbl td {
    padding: 0.15rem 0.4rem;
    white-space: nowrap;
    border: 0;
    border-right: 1px solid #000;
    border-bottom: 1px solid #000;
    background: #fff;
}
#modal-add-buyin table.xl-history-tbl tbody tr:last-child td {
    border-bottom: 0;
}
#modal-add-buyin table.xl-history-tbl th:last-child,
#modal-add-buyin table.xl-history-tbl td:last-child {
    border-right: 0;
}
#modal-add-buyin table.xl-history-tbl td:first-child {
    border-left: 0;
}
#modal-add-buyin table.xl-history-tbl th:last-child,
#modal-add-buyin table.xl-history-tbl td:last-child {
    border-right: 0;
}
#modal-add-buyin table.xl-history-tbl td:first-child {
    font-size: 0.72rem;
}
#modal-add-buyin table.xl-history-tbl td.text-end {
    font-variant-numeric: tabular-nums;
}
#modal-add-buyin table.xl-history-tbl .text-amount-negative {
    color: #ff0000;
}
#modal-add-buyin table.xl-history-tbl tr.is-pending td {
    font-weight: 400;
    background: #e2efda;
}
/* Any number of equal columns, each a head cell over a value cell (Credit balances + guests) */
#modal-add-buyin .xl-grid-cols {
    grid-template-rows: auto auto;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    /* the last column's right line would double the box border */
    margin-right: -1px;
}
#modal-add-buyin .xl-box {
    overflow: hidden;
}
#modal-add-buyin .xl-contents {
    display: contents;
}
#modal-add-buyin .xl-value.text-amount-negative {
    color: #ff0000;
}
#modal-add-buyin .xl-debtor-cell {
    flex-direction: column;
    line-height: 1.15;
}
#modal-add-buyin .xl-debtor-guest {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
}
#modal-add-buyin table.xl-credit-tbl td.xl-debtor-name {
    font-size: 0.68rem;
    text-transform: uppercase;
}
/* Ledger columns sit on the same 8-unit grid as the Excel sheet (fixed widths, not content-sized):
   Deposit = 1 | 1 | 1 | 3 | 2, Credit = 8 x 1 — so the lines meet the 4- / 2-column rows above. */
#modal-add-buyin table.xl-deposit-tbl,
#modal-add-buyin table.xl-credit-tbl {
    table-layout: fixed;
}
#modal-add-buyin table.xl-deposit-tbl th:nth-child(-n+3) { width: 12.5%; }
#modal-add-buyin table.xl-deposit-tbl th:nth-child(4) { width: 37.5%; }
#modal-add-buyin table.xl-deposit-tbl th:nth-child(5) { width: 25%; }
#modal-add-buyin table.xl-credit-tbl th { width: 12.5%; }
#modal-add-buyin table.xl-deposit-tbl td,
#modal-add-buyin table.xl-credit-tbl td {
    overflow: hidden;
    text-overflow: ellipsis;
}
#modal-add-buyin div.xl-history-wrap {
    overflow-x: hidden;
}
#modal-add-buyin table.xl-history-tbl {
    width: calc(100% + var(--xl-sb, 0px));
    max-width: none;
}
#modal-add-buyin .xl-input-cell {
    padding: 0.15rem 0.25rem;
}
#modal-add-buyin .xl-input-cell .form-control {
    width: 100%;
    min-width: 0;
    height: 1.6rem;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    pointer-events: auto;
}
/* History scrollbars: cream / gold like the Agent Portal popups */
#modal-add-buyin .buyin-side-panels,
#modal-add-buyin .buyin-history-wrap {
    scrollbar-width: thin;
    scrollbar-color: #d9c79a #faf6ea;
}
#modal-add-buyin .buyin-side-panels::-webkit-scrollbar,
#modal-add-buyin .buyin-history-wrap::-webkit-scrollbar {
    width: 8px;
