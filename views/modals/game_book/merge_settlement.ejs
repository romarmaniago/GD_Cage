<script>
    $(document).ready(function () {
        var MERGE_MODAL = '#modal-merge-settlement';

        /* --- Number helpers --- */

        // Reads "1,234", "-1,234" and "(1,234)" (parentheses = negative)
        function parseAmount(value) {
            var raw = String(value || '').trim();
            var isNegative = /^\(.*\)$/.test(raw);
            var num = parseFloat(raw.replace(/,/g, '').replace(/[()%]/g, ''));
            if (isNaN(num)) return 0;
            return isNegative ? -Math.abs(num) : num;
        }

        // Settlement / Payment: game_list.js always wraps them in parentheses (even payouts),
        // commission.js sends plain numbers — so parentheses here are display only, not a sign.
        function parseDueAmount(value) {
            var num = parseFloat(String(value || '').replace(/[,()]/g, '').trim());
            return isNaN(num) ? 0 : num;
        }

        function formatAmount(value) {
            return parseAmount(value).toLocaleString('en-US', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });
        }

        // Settlement / Payment: positive = paid out to the guest → red (x);
        // negative = the guest owes (e.g. a Share part) → plain black, like the game receipts
        function formatSettlementDueDisplay(value) {
            var num = parseAmount(value);
            if (num > 0) return { text: '(' + formatAmount(num) + ')', negative: true };
            return { text: formatAmount(Math.abs(num)), negative: false };
        }

        // Negative → red (x)
        function renderSignedAmount($amount, value) {
            var num = Number(value) || 0;
            $amount.text(num < 0 ? '(' + formatAmount(Math.abs(num)) + ')' : formatAmount(num)).toggleClass('is-negative', num < 0);
        }

        function renderDueAmount($amount, value) {
            var display = formatSettlementDueDisplay(value);
            $amount.text(display.text).toggleClass('is-negative', display.negative);
        }

        function formatSettlementRateDisplay(value) {
            var raw = String(value == null ? '' : value).replace(/,/g, '').trim();
            if (!raw) return '';
            return raw.indexOf('%') !== -1 ? raw : raw + '%';
        }

        function formatSettlementPct(value) {
            return Number(value || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) + '%';
        }

        function formatInputWithCommas($input) {
            var raw = String($input.val() || '').replace(/,/g, '').trim();
            if (!raw) {
                $input.val('');
                return;
            }
            var isNegative = $input.attr('data-allow-negative') === '1' && raw.charAt(0) === '-';
            var normalized = raw.replace(/[^\d.]/g, '');
            var firstDot = normalized.indexOf('.');
            if (firstDot !== -1) {
                normalized = normalized.slice(0, firstDot + 1) + normalized.slice(firstDot + 1).replace(/\./g, '');
            }
            if (isNegative && normalized) normalized = '-' + normalized;
            var num = parseFloat(normalized);
            if (isNaN(num)) return;
            $input.val(num.toLocaleString('en-US', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            }));
        }

        function formatInputWithCommasLive($input) {
            var el = $input && $input[0];
            if (!el) return;

            var raw = String(el.value || '');
            var caret = typeof el.selectionStart === 'number' ? el.selectionStart : raw.length;
            var digitsBeforeCaret = raw.slice(0, caret).replace(/[^\d]/g, '').length;

            formatInputWithCommas($input);

            var formatted = String(el.value || '');
            if (!formatted) return;

            var pos = 0;
            var seen = 0;
            while (pos < formatted.length && seen < digitsBeforeCaret) {
                if (/\d/.test(formatted.charAt(pos))) seen++;
                pos++;
            }
            try { el.setSelectionRange(pos, pos); } catch (e) { /* ignore */ }
        }

        function formatRollingRateInput($input) {
            var raw = String($input.val() || '').replace(/,/g, '').trim();
            if (!raw) {
                $input.val('');
                return;
            }
            var normalized = raw.replace(/[^\d.]/g, '');
            var dot = normalized.indexOf('.');
            if (dot !== -1) {
                normalized = normalized.slice(0, dot + 1) + normalized.slice(dot + 1).replace(/\./g, '');
            }
            var intPart = dot === -1 ? normalized : normalized.slice(0, dot);
            var fracPart = dot === -1 ? null : normalized.slice(dot + 1);
            if (intPart === '' && dot === -1 && (fracPart === null || fracPart === '')) {
                $input.val('');
                return;
            }
            var intNum = parseInt(intPart === '' ? '0' : intPart, 10);
            if (isNaN(intNum)) intNum = 0;
            var intStr = intNum.toLocaleString('en-US');
            if (dot !== -1) {
                $input.val(intStr + '.' + (fracPart === null ? '' : fracPart));
                return;
            }
            var num = parseFloat(normalized);
            if (isNaN(num)) return;
            $input.val(num.toLocaleString('en-US', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 4
            }));
        }

        /* --- Main receipt --- */

        // Renders the receipt from the hidden inputs the callers filled (see openMergeSettlementModal)
        function refreshMergeReceiptDisplay($modal) {
            renderSignedAmount($modal.find('#chipsReturnMergeDisplay'), -Math.abs(parseAmount($modal.find('#chipsReturnMerge').val())));
            renderSignedAmount($modal.find('#winLossMergeDisplay'), parseAmount($modal.find('#winLossMerge').val()));
            renderSignedAmount($modal.find('#rollingMergeDisplay'), parseAmount($modal.find('#rollingMerge').val()));
            renderDueAmount($modal.find('#rollingSettlementMergeDisplay .settlement-receipt-amount'), parseDueAmount($modal.find('#rollingSettlementMerge').val()));
            $modal.find('#fbMergeDisplay .settlement-receipt-amount').text(formatAmount($modal.find('#fbMerge').val()));
            renderDueAmount($modal.find('#paymentMergeDisplay .settlement-receipt-amount'), parseDueAmount($modal.find('#paymentMerge').val()));

            // Rate can be the word "Mixed" when the selected games don't share one rate
            var rateRaw = String($modal.find('#rollingRateMerge').val() || '').replace(/%/g, '').trim();
            var rateNum = parseFloat(rateRaw.replace(/,/g, ''));
            $modal.find('#rollingRateMergeDisplay').val(isNaN(rateNum) ? rateRaw : rateNum.toFixed(2) + '%');

            var split = getMergeDefaultSplit($modal);
            $modal.find('#sharePctMerge').val(formatSettlementPct(split.sharePct));
            $modal.find('#rollingPctMerge').val(formatSettlementPct(split.rollingPct));

            var gameIds = String($modal.find('#mergeGameIds').val() || '').split(',').map(function (id) {
                return id.trim();
            }).filter(Boolean);
            $modal.find('#mergeGamesDisplay').text(gameIds.map(function (id) { return '#' + id; }).join(', '));
        }

        // Game's own SHARE / ROLLING %: the shared Share + Rolling split when every selected game has it, else 0 / 100
        function getMergeDefaultSplit($modal) {
            return window.getReceiptRateSplit($modal.data('commissionRow'));
        }

        // Same layout as the game receipt copy text: header + date, account block, then the amount rows
        function buildMergeReceiptSlipText(slipBodyEl) {
            if (!slipBodyEl) return '';
            var textOf = function (selector) {
                var el = slipBodyEl.querySelector(selector);
                return el ? String(el.textContent || '').replace(/\s+/g, ' ').trim() : '';
            };
            var select = slipBodyEl.querySelector('.settlement-receipt-name-select');
            var accountText = select && select.options.length ? String(select.options[select.selectedIndex].text || '').trim() : '';
            var dateText = textOf('.ss-date');
            var dt = typeof moment === 'function' ? moment(dateText, 'M/D/YYYY H:mm', true) : null;
            var blocks = [
                [textOf('.ss-header'), dt && dt.isValid() ? dt.format('YYYY-MM-DD HH:mm') : dateText],
                [accountText.toUpperCase(), textOf('.ss-merge-games')]
            ];

            var prevBlock = null;
            slipBodyEl.querySelectorAll('.ss-row[data-text-label]').forEach(function (row) {
                var input = row.querySelector('.settlement-receipt-input');
                var amountEl = row.querySelector('.settlement-receipt-amount');
                var value = input ? String(input.value || '').trim() : (amountEl ? String(amountEl.textContent || '').trim() : '');
                var line = row.getAttribute('data-text-label') + ' ' + value;
                var block = row.getAttribute('data-text-block');
                if (block && block === prevBlock) blocks[blocks.length - 1].push(line);
                else blocks.push([line]);
                prevBlock = block;
            });

            return blocks.map(function (b) {
                return b.filter(Boolean).join('\n');
            }).join('\n\n');
        }

        function copyMergeReceiptSlipTextButton(slipBodyEl, $btn) {
            if (!slipBodyEl || !$btn || !$btn.length) return;

            var originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>');

            var text = buildMergeReceiptSlipText(slipBodyEl);
            if (!text) {
                $btn.prop('disabled', false).html(originalHtml);
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Receipt has no text to copy.', confirmButtonText: 'OK' });
                }
                return;
            }

            if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
                $btn.prop('disabled', false).html(originalHtml);
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Clipboard is not supported in this browser.', confirmButtonText: 'OK' });
                }
                return;
            }

            navigator.clipboard.writeText(text)
                .then(function () {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'success',
                            title: 'Copied!',
                            text: 'Receipt text copied. You can paste it anywhere.',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    }
                })
                .catch(function (err) {
                    var msg = (err && err.message) ? err.message : 'Unable to copy receipt text.';
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'error', title: 'Copy failed', text: msg, confirmButtonText: 'OK' });
                    }
                })
                .finally(function () {
                    $btn.prop('disabled', false).html(originalHtml);
                });
        }

        // Print uses the receipt itself with the shared receipt styles (_settlement_slip_styles.ejs)
        function openMergeReceiptPrintWindow($modal) {
            var $source = $modal.find('#merge-settlement-receipt-copy-area');
            var $clone = $source.clone();
            $clone.find('input.settlement-receipt-input').each(function () {
                var $input = $(this);
                var $orig = $source.find('#' + this.id);
                $input.replaceWith($('<span></span>').text(String($orig.val() || '').trim()));
            });
            var $select = $clone.find('.settlement-receipt-name-select');
            $select.replaceWith($('<span></span>').text($source.find('.settlement-receipt-name-select option:selected').text()));
            $clone.find('[id]').removeAttr('id');

            var slipStylesEl = document.querySelector('style[data-settlement-slip-styles]');
            var slipStyles = slipStylesEl ? slipStylesEl.textContent : '';
            slipStyles = slipStyles.replace(/url\('\/assets\//g, "url('" + window.location.origin + '/assets/');
            var styles = '@page{size:auto;margin:8mm;}html,body{margin:0;padding:0;}' +
                'body{display:flex;justify-content:center;padding:8mm 0;-webkit-print-color-adjust:exact;print-color-adjust:exact;}' +
                '.settlement-receipt-print-root{width:26.25rem;border:1px solid #222;}' + slipStyles;
            var receiptHtml = $('<div class="settlement-receipt-print-root"></div>').append($clone).prop('outerHTML');

            var iframe = document.createElement('iframe');
            iframe.style.position = 'fixed';
            iframe.style.right = '0';
            iframe.style.bottom = '0';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = '0';
            iframe.setAttribute('aria-hidden', 'true');
            document.body.appendChild(iframe);

            var iframeDoc = iframe.contentWindow.document;
            iframeDoc.open();
            iframeDoc.write('<!doctype html><html><head><title>Multiple Settlement Receipt</title><style>' + styles + '</style></head><body>' + receiptHtml + '</body></html>');
            iframeDoc.close();

            setTimeout(function () {
                iframe.contentWindow.focus();
                iframe.contentWindow.print();
                setTimeout(function () {
                    if (iframe && iframe.parentNode) iframe.parentNode.removeChild(iframe);
                }, 500);
            }, 300);
        }

        $(document).on('click', '#print-merge-settlement-btn', function () {
            openMergeReceiptPrintWindow($(MERGE_MODAL));
        });

        $(MERGE_MODAL).on('click', '.settlement-main-content .js-copy-merge-settlement-slip-image', function (e) {
            e.preventDefault();
            var $btn = $(this);
            var slipBody = document.getElementById('merge-settlement-receipt-copy-area');
            if (typeof window.copyGameReceiptSlipImage === 'function') {
                window.copyGameReceiptSlipImage(slipBody, $btn);
                return;
            }
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Image copy is not available.', confirmButtonText: 'OK' });
            }
        });

        $(MERGE_MODAL).on('click', '.settlement-main-content .js-copy-merge-settlement-slip-text', function (e) {
            e.preventDefault();
            copyMergeReceiptSlipTextButton(document.getElementById('merge-settlement-receipt-copy-area'), $(this));
        });

        /* --- Edit mode: Guest / Agent receipts --- */

        // Guest / Agent settlement. Share + Rolling merges (commissionRow set): the usual formula with the
        // panel's Rate / Share % / Rolling %. Mixed games have no single formula, so the rolling part is the
        // merged Settlement split by rolling (Guest + Agent still add up to it); Share % adds W/L × Share%
        // on that side's rolling, and Rolling % scales the rolling part (0 / 100 = original split).
        function mergePanelSettlement($modal, winLoss, rolling, rate, split, totalRolling) {
            if ($modal.data('commissionRow')) {
                return window.computeSplitPanelSettlement(winLoss, rolling, rate, split.sharePct, split.rollingPct, totalRolling);
            }
            var shareFactor = totalRolling ? rolling / totalRolling : 1;
            var rollingPart = parseDueAmount($modal.find('#rollingSettlementMerge').val()) * shareFactor;
            return Math.round(rollingPart * split.rollingPct / 100 + winLoss * split.sharePct / 100 * shareFactor);
        }

        // Add Charge split: Guest keeps what is typed in its box (default: all of it), Agent takes the rest
        function getMergePanelAddCharge($panel) {
            var $modal = $(MERGE_MODAL);
            var total = parseAmount($modal.find('#fbMerge').val());
            var $guestInput = $modal.find('#merge-settlement-edit-guest-panel [data-field="addCharge"]');
            var guestCharge = $guestInput.length ? Math.max(0, Math.min(total, parseAmount($guestInput.val()))) : total;
            return $panel.is('#merge-settlement-edit-guest-panel') ? guestCharge : total - guestCharge;
        }

        // Panel SHARE / ROLLING %: what is typed in the panel, else the merge's own split
        function getMergePanelSplit($panel) {
            var $share = $panel ? $panel.find('[data-field="sharePct"]') : $();
            var $rolling = $panel ? $panel.find('[data-field="rollingPct"]') : $();
            if (!$share.length || !$rolling.length) {
                return getMergeDefaultSplit($(MERGE_MODAL));
            }
            return { sharePct: parseAmount($share.val()), rollingPct: parseAmount($rolling.val()) };
        }

        function recalcMergeEditPanelTotals($panel) {
            if (!$panel || !$panel.length) return;

            var $modal = $(MERGE_MODAL);
            var rolling = parseAmount($panel.find('[data-field="rolling"]').val());
            var rate = parseAmount($panel.find('[data-field="rollingRate"]').val());
            var winLoss = parseAmount($modal.find('#winLossMerge').val());
            var totalRolling = parseAmount($modal.find('#rollingMerge').val());
            var settlement = mergePanelSettlement($modal, winLoss, rolling, rate, getMergePanelSplit($panel), totalRolling);
            var addCharge = getMergePanelAddCharge($panel);
            var payment = settlement - addCharge;

            renderDueAmount($panel.find('[data-field="rollingSettlementDisplay"] .settlement-receipt-amount'), settlement);
            renderDueAmount($panel.find('[data-field="paymentDisplay"] .settlement-receipt-amount'), payment);
            if (!$panel.find('[data-field="addCharge"]').length) {
                $panel.find('[data-field="addChargeDisplay"] .settlement-receipt-amount').text(formatAmount(addCharge));
            }

            var $rate = $panel.find('[data-field="rollingRate"]');
            if (!$rate.prop('readonly')) {
                $rate.val(formatSettlementRateDisplay($rate.val()));
            }
        }

        // Panel copies of the main receipt; data-field keeps the original id (short names for the edit fields)
        var MERGE_PANEL_FIELDS = {
            rollingRateMergeDisplay: 'rollingRate',
            sharePctMerge: 'sharePct',
            rollingPctMerge: 'rollingPct',
            rollingSettlementMergeDisplay: 'rollingSettlementDisplay',
            fbMergeDisplay: 'addChargeDisplay',
            paymentMergeDisplay: 'paymentDisplay'
        };

        function buildMergeEditPanelReceipt($mainModal, panelKey) {
            var $source = $mainModal.find('#merge-settlement-receipt-copy-area').clone(false);
            $source.removeAttr('id').addClass('settlement-edit-receipt-copy-area');

            $source.find('[id]').each(function () {
                var oldId = this.id;
                this.id = 'merge-settlement-' + panelKey + '-' + oldId;
                $(this).attr('data-field', MERGE_PANEL_FIELDS[oldId] || oldId);
            });
            $source.find('input[name]').removeAttr('name');

            // Name is a read-only echo of the main receipt's chosen account
            var $select = $source.find('select.settlement-receipt-name-select');
            $select.val($mainModal.find('#accNoMerge').val()).prop('disabled', true);

            var $panelBody = $('#merge-settlement-edit-' + panelKey + '-body');
            $panelBody.empty().append($source);
            var $panel = $panelBody.closest('.settlement-edit-panel');

            $panel.find('[data-field="buyInMerge"]').val($mainModal.find('#buyInMerge').val());
            // Rolling is editable here: swap the display for a box (the hidden value is not needed)
            $panel.find('input[type="hidden"][data-field="rollingMerge"]').remove();
            $panel.find('[data-field="rollingMergeDisplay"]').removeClass('is-negative')
                .html('<input class="settlement-receipt-input" type="text" data-field="rolling" data-allow-negative="1" inputmode="decimal">');
            $panel.find('[data-field="rolling"]').val($mainModal.find('#rollingMerge').val()).prop('readonly', false);
            var rateRaw = String($mainModal.find('#rollingRateMergeDisplay').val() || '').replace(/%/g, '').trim();
            $panel.find('[data-field="rollingRate"]').val(rateRaw).prop('readonly', false);
            $panel.find('[data-field="sharePct"]').val($mainModal.find('#sharePctMerge').val()).prop('readonly', false);
            $panel.find('[data-field="rollingPct"]').val($mainModal.find('#rollingPctMerge').val()).prop('readonly', false);

            // Guest gets an Add Charge box (defaults to the full Add Charge); Agent shows the rest
            if (panelKey === 'guest') {
                $panel.find('[data-field="addChargeDisplay"] .settlement-receipt-amount')
                    .html('<input class="settlement-receipt-input" type="text" data-field="addCharge" inputmode="decimal">');
                $panel.find('[data-field="addCharge"]').val(formatAmount($mainModal.find('#fbMerge').val()));
            }

            recalcMergeEditPanelTotals($panel);
            return $panel;
        }

        // Guest + Agent rolling always equals the merged total rolling.
        function syncMergeCounterpartRolling($sourcePanel, clampEdited) {
            var $modal = $(MERGE_MODAL);
            var $guestPanel = $modal.find('#merge-settlement-edit-guest-panel');
            var $agentPanel = $modal.find('#merge-settlement-edit-agent-panel');
            if (!$sourcePanel || !$sourcePanel.length || !$guestPanel.length || !$agentPanel.length) return;

            var totalRolling = parseAmount($modal.find('#rollingMerge').val());
            var isGuest = $sourcePanel.is('#merge-settlement-edit-guest-panel');
            var $otherPanel = isGuest ? $agentPanel : $guestPanel;
            var $sourceInput = $sourcePanel.find('[data-field="rolling"]');
            var edited = parseAmount($sourceInput.val());

            // Each side stays between 0 and the total — works for a negative total rolling too
            edited = Math.max(Math.min(0, totalRolling), Math.min(Math.max(0, totalRolling), edited));
            if (clampEdited) {
                $sourceInput.val(formatAmount(edited));
            }

            var otherRolling = totalRolling - edited;
            $otherPanel.find('[data-field="rolling"]').val(formatAmount(otherRolling));

            recalcMergeEditPanelTotals($sourcePanel);
            recalcMergeEditPanelTotals($otherPanel);
        }

        function formatMergePctInput($input) {
            if ($input.length) {
                $input.val(formatSettlementPct(clampMergeSplitPct($input.val())));
            }
        }

        // Guest Add Charge: 0 .. main Add Charge
        function formatMergeAddChargeInput($input) {
            if (!$input.length) return;
            var total = parseAmount($(MERGE_MODAL).find('#fbMerge').val());
            $input.val(formatAmount(Math.max(0, Math.min(total, parseAmount($input.val())))));
        }

        function recalcMergeEditPanels($modal) {
            recalcMergeEditPanelTotals($modal.find('#merge-settlement-edit-guest-panel'));
            recalcMergeEditPanelTotals($modal.find('#merge-settlement-edit-agent-panel'));
            refreshMergeSplitCalculators($modal);
        }

        /* --- Split calculators (Company / Guest / Agent) --- */

        function clampMergeSplitRate(value, max) {
            var num = parseFloat(String(value == null ? '' : value).replace(/,/g, '').replace(/%/g, '').trim());
            if (isNaN(num)) num = 0;
            var cap = Math.max(0, parseFloat(max) || 0);
            num = Math.min(cap, Math.max(0, num));
            return Math.round(num * 10000) / 10000;
        }

        function clampMergeSplitPct(value) {
            var num = parseFloat(String(value == null ? '' : value).replace(/,/g, '').replace(/%/g, '').trim());
            if (isNaN(num)) num = 0;
            return Math.min(100, Math.max(0, Math.round(num * 100) / 100));
        }

        function formatMergeSplitPctValue(num) {
            var text = String(Math.round(Number(num || 0) * 10000) / 10000);
            return text.replace(/(\.\d*?[1-9])0+$/, '$1').replace(/\.0+$/, '');
        }

        function sanitizeMergeSplitRaw(value) {
            var str = String(value == null ? '' : value).replace(/,/g, '').replace(/%/g, '');
            if (!/^\d*\.?\d*$/.test(str)) {
                var cleaned = str.replace(/[^\d.]/g, '');
                var dot = cleaned.indexOf('.');
                if (dot !== -1) {
                    cleaned = cleaned.slice(0, dot + 1) + cleaned.slice(dot + 1).replace(/\./g, '');
                }
                str = cleaned;
            }
            return str;
        }

        function liveClampMergeSplitInput(value, max) {
            var raw = sanitizeMergeSplitRaw(value);
            var num = parseFloat(raw);
            if (!isNaN(num) && num > max) {
                return formatMergeSplitPctValue(max);
            }
            return raw;
        }

        // Rolling is only ever counted in whole thousands, so split Rolling rounds to the nearest 1,000.
        // The other side's share of the total rolling (same sign as the total; negative totals allowed)
        function remainderRolling(totalRolling, part) {
            var rest = totalRolling - part;
            return totalRolling >= 0 ? Math.max(0, rest) : Math.min(0, rest);
        }

        function roundMergeToThousand(value) {
            return Math.round(Number(value || 0) / 1000) * 1000;
        }

        // Calculator SHARE / ROLLING: text on Company, a box on Guest / Agent (left alone while being typed in)
        function setMergeSplitPctCell($cell, value) {
            if ($cell.is('input')) {
                if (!$cell.is(':focus')) $cell.val(formatSettlementPct(value));
                return;
            }
            $cell.text(formatSettlementPct(value));
        }

        function refreshMergeSplitCalculators($modal) {
            $modal = $modal && $modal.length ? $modal : $(MERGE_MODAL);
            if (Number($modal.data('merge-settlement-edit-mode')) !== 1) return;

            var totalRolling = parseAmount($modal.find('#rollingMerge').val());
            var companyRate = clampMergeSplitRate($modal.find('#merge-calc-company-rate').val(), 100);

            // Company uses the merge's SHARE / ROLLING %; Guest and Agent use what is set in their panels
            var splitWinLoss = parseAmount($modal.find('#winLossMerge').val());
            var companySplit = getMergePanelSplit(null);
            var guestSplit = getMergePanelSplit($modal.find('#merge-settlement-edit-guest-panel'));
            var agentSplit = getMergePanelSplit($modal.find('#merge-settlement-edit-agent-panel'));
            var splitSettlement = function (rollingValue, split) {
                return mergePanelSettlement($modal, splitWinLoss, rollingValue, companyRate, split, totalRolling);
            };

            // Rows on all three calculators: Win/Loss, company RATE, SHARE / ROLLING
            $modal.find('.js-calc-winloss').each(function () {
                renderSignedAmount($(this), splitWinLoss);
            });
            $modal.find('.js-calc-company-rate-display').text(
                companyRate.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 }) + '%'
            );
            [
                ['#merge-settlement-calc-company-panel', companySplit],
                ['#merge-settlement-calc-guest-panel', guestSplit],
                ['#merge-settlement-calc-agent-panel', agentSplit]
            ].forEach(function (entry) {
                var $calc = $modal.find(entry[0]);
                setMergeSplitPctCell($calc.find('.js-calc-share-pct'), entry[1].sharePct);
                setMergeSplitPctCell($calc.find('.js-calc-rolling-pct'), entry[1].rollingPct);
            });

            renderSignedAmount($modal.find('#merge-calc-company-rate-rolling'), totalRolling);
            $modal.find('#merge-calc-company-rate-rate-display').text(formatMergeSplitPctValue(companyRate) + '%');
            var totalSettlement = splitSettlement(totalRolling, companySplit);
            renderDueAmount($modal.find('#merge-calc-company-rate-settlement'), totalSettlement);
            renderSignedAmount($modal.find('#merge-calc-company-pct-rolling'), totalRolling);
            renderDueAmount($modal.find('#merge-calc-company-pct-settlement'), totalSettlement);

            var guestRate = clampMergeSplitRate($modal.find('#merge-calc-guest-rate-input').val(), companyRate);
            var agentRate = Math.max(0, Math.round((companyRate - guestRate) * 10000) / 10000);
            var guestRateRolling = companyRate > 0 ? roundMergeToThousand((totalRolling * guestRate) / companyRate) : 0;
            var agentRateRolling = remainderRolling(totalRolling, guestRateRolling);

            renderSignedAmount($modal.find('#merge-calc-guest-rate-rolling'), guestRateRolling);
            renderDueAmount($modal.find('#merge-calc-guest-rate-settlement'), splitSettlement(guestRateRolling, guestSplit));
            renderSignedAmount($modal.find('#merge-calc-agent-rate-rolling'), agentRateRolling);
            $modal.find('#merge-calc-agent-rate-display').text(formatMergeSplitPctValue(agentRate) + '%');
            renderDueAmount($modal.find('#merge-calc-agent-rate-settlement'), splitSettlement(agentRateRolling, agentSplit));

            var guestPct = clampMergeSplitPct($modal.find('#merge-calc-guest-pct-input').val());
            var agentPct = Math.round((100 - guestPct) * 100) / 100;
            var guestPctRolling = roundMergeToThousand((totalRolling * guestPct) / 100);
            var agentPctRolling = remainderRolling(totalRolling, guestPctRolling);

            renderSignedAmount($modal.find('#merge-calc-guest-pct-rolling'), guestPctRolling);
            renderDueAmount($modal.find('#merge-calc-guest-pct-settlement'), splitSettlement(guestPctRolling, guestSplit));
            renderSignedAmount($modal.find('#merge-calc-agent-pct-rolling'), agentPctRolling);
            $modal.find('#merge-calc-agent-pct-display').text(formatMergeSplitPctValue(agentPct) + '%');
            renderDueAmount($modal.find('#merge-calc-agent-pct-settlement'), splitSettlement(agentPctRolling, agentSplit));
        }

        function restoreMergeOriginalSplitToEditPanels($modal) {
            var rollingVal = $modal.find('#rollingMerge').val();
            var rateRaw = String($modal.find('#rollingRateMergeDisplay').val() || '').replace(/%/g, '').trim();
            [$modal.find('#merge-settlement-edit-guest-panel'), $modal.find('#merge-settlement-edit-agent-panel')].forEach(function ($panel) {
                if (!$panel.length) return;
                $panel.find('[data-field="rolling"]').val(rollingVal);
                $panel.find('[data-field="rollingRate"]').val(rateRaw);
                recalcMergeEditPanelTotals($panel);
            });
        }

        function applyMergeSplitToEditPanels($modal) {
            $modal = $modal && $modal.length ? $modal : $(MERGE_MODAL);
            var $guestPanel = $modal.find('#merge-settlement-edit-guest-panel');
            var $agentPanel = $modal.find('#merge-settlement-edit-agent-panel');
            if (!$guestPanel.length || !$agentPanel.length) return;

            var mode = $modal.data('merge-split-active-mode');
            var totalRolling = parseAmount($modal.find('#rollingMerge').val());

            if (mode === 'rate') {
                var companyRate = clampMergeSplitRate($modal.find('#merge-calc-company-rate').val(), 100);
                var guestRate = clampMergeSplitRate($modal.find('#merge-calc-guest-rate-input').val(), companyRate);
                var guestRolling = companyRate > 0 ? roundMergeToThousand((totalRolling * guestRate) / companyRate) : 0;
                var agentRolling = remainderRolling(totalRolling, guestRolling);

                $guestPanel.find('[data-field="rolling"]').val(formatAmount(guestRolling));
                $agentPanel.find('[data-field="rolling"]').val(formatAmount(agentRolling));
                recalcMergeEditPanelTotals($guestPanel);
                recalcMergeEditPanelTotals($agentPanel);
            } else if (mode === 'pct') {
                var guestPct = clampMergeSplitPct($modal.find('#merge-calc-guest-pct-input').val());
                var guestPctRolling = roundMergeToThousand((totalRolling * guestPct) / 100);
                var agentPctRolling = remainderRolling(totalRolling, guestPctRolling);

                $guestPanel.find('[data-field="rolling"]').val(formatAmount(guestPctRolling));
                $agentPanel.find('[data-field="rolling"]').val(formatAmount(agentPctRolling));
                recalcMergeEditPanelTotals($guestPanel);
                recalcMergeEditPanelTotals($agentPanel);
            } else {
                restoreMergeOriginalSplitToEditPanels($modal);
            }
        }

        function resetMergeSplitCalculators($modal) {
            $modal = $modal && $modal.length ? $modal : $(MERGE_MODAL);
            $modal.removeData('merge-split-active-mode');
            var rateRaw = String($modal.find('#rollingRateMerge').val() || '').replace(/%/g, '').trim();
            $modal.find('#merge-calc-company-rate').val(rateRaw || '0');
            $modal.find('#merge-calc-guest-rate-input, #merge-calc-guest-pct-input').val('0');
            $modal.find('#merge-calc-agent-rate-display, #merge-calc-agent-pct-display').text('0%');
        }

        function syncMergeEditPanelBeforeCopy($panel) {
            if (!$panel || !$panel.length) return;
            formatInputWithCommas($panel.find('[data-field="rolling"]'));
            formatRollingRateInput($panel.find('[data-field="rollingRate"]'));
            $panel.find('[data-field="sharePct"], [data-field="rollingPct"]').each(function () {
                formatMergePctInput($(this));
            });
            formatMergeAddChargeInput($panel.find('[data-field="addCharge"]'));
            recalcMergeEditPanelTotals($panel);
        }

        function getMergeEditPanelSlipBody($panel) {
            if (!$panel || !$panel.length) return null;
            return $panel.find('.settlement-edit-receipt-copy-area')[0] || null;
        }

        function wireMergeEditPanelCopyButtons($panel) {
            if (!$panel || !$panel.length) return;

            $panel.find('.js-copy-merge-settlement-slip-image').off('click.mergeSettlementEditCopy').on('click.mergeSettlementEditCopy', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var $btn = $(this);
                syncMergeEditPanelBeforeCopy($panel);
                var slipBody = getMergeEditPanelSlipBody($panel);
                if (!slipBody) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Receipt is not ready.', confirmButtonText: 'OK' });
                    }
                    return;
                }
                if (typeof window.copyGameReceiptSlipImage === 'function') {
                    window.copyGameReceiptSlipImage(slipBody, $btn);
                    return;
                }
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Image copy is not available.', confirmButtonText: 'OK' });
                }
            });

            $panel.find('.js-copy-merge-settlement-slip-text').off('click.mergeSettlementEditCopy').on('click.mergeSettlementEditCopy', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var $btn = $(this);
                syncMergeEditPanelBeforeCopy($panel);
                copyMergeReceiptSlipTextButton(getMergeEditPanelSlipBody($panel), $btn);
            });
        }

        function setMergeEditMode($modal, enabled) {
            $modal = $modal && $modal.length ? $modal : $(MERGE_MODAL);
            var $cluster = $modal.find('#merge-settlement-modal-cluster');
            var $guestPanel = $modal.find('#merge-settlement-edit-guest-panel');
            var $agentPanel = $modal.find('#merge-settlement-edit-agent-panel');
            var $splitPanels = $modal.find('#merge-settlement-calc-company-panel, #merge-settlement-calc-guest-panel, #merge-settlement-calc-agent-panel');

            $modal.data('merge-settlement-edit-mode', enabled ? 1 : 0);
            $cluster.toggleClass('is-edit-mode', enabled);

            if (enabled) {
                buildMergeEditPanelReceipt($modal, 'guest');
                buildMergeEditPanelReceipt($modal, 'agent');
                wireMergeEditPanelCopyButtons($guestPanel);
                wireMergeEditPanelCopyButtons($agentPanel);
                $guestPanel.removeClass('d-none').attr('aria-hidden', 'false');
                $agentPanel.removeClass('d-none').attr('aria-hidden', 'false');
                $splitPanels.removeClass('d-none').attr('aria-hidden', 'false');
                resetMergeSplitCalculators($modal);
                refreshMergeSplitCalculators($modal);
            } else {
                $guestPanel.addClass('d-none').attr('aria-hidden', 'true');
                $agentPanel.addClass('d-none').attr('aria-hidden', 'true');
                $splitPanels.addClass('d-none').attr('aria-hidden', 'true');
                $modal.find('#merge-settlement-edit-guest-body, #merge-settlement-edit-agent-body').empty();
                resetMergeSplitCalculators($modal);
            }
        }

        function resetMergeSettlementModalView($modal) {
            $modal = $modal && $modal.length ? $modal : $(MERGE_MODAL);
            if (Number($modal.data('merge-settlement-edit-mode')) === 1) {
                setMergeEditMode($modal, false);
            }
        }

        $(MERGE_MODAL).on('shown.bs.modal', function () {
            var $modal = $(this);
            resetMergeSettlementModalView($modal);
            refreshMergeReceiptDisplay($modal);
            setMergeEditMode($modal, true);
        });

        $(MERGE_MODAL).on('hidden.bs.modal', function () {
            resetMergeSettlementModalView($(this));
        });

        // Keep the read-only Name echoes in the Guest/Agent panels in sync with the main receipt's account.
        $(MERGE_MODAL).on('change', '#accNoMerge', function () {
            var selectedValue = $(this).val();
            $(MERGE_MODAL).find('select.settlement-receipt-name-select').not(this).val(selectedValue);
        });

        $(MERGE_MODAL).on('input', '.settlement-edit-panel [data-field="rolling"], .settlement-edit-panel [data-field="rollingRate"]', function () {
            var $input = $(this);
            var $panel = $input.closest('.settlement-edit-panel');
            if ($input.attr('data-field') === 'rolling') {
                formatInputWithCommasLive($input);
                syncMergeCounterpartRolling($panel, false);
                return;
            }
            recalcMergeEditPanelTotals($panel);
        });

        $(MERGE_MODAL).on('blur', '.settlement-edit-panel [data-field="rolling"]', function () {
            var $input = $(this);
            formatInputWithCommas($input);
            syncMergeCounterpartRolling($input.closest('.settlement-edit-panel'), true);
        });

        $(MERGE_MODAL).on('blur', '.settlement-edit-panel [data-field="rollingRate"]', function () {
            formatRollingRateInput($(this));
            recalcMergeEditPanelTotals($(this).closest('.settlement-edit-panel'));
        });

        // SHARE / ROLLING % per panel (also feeds that side's split calculator)
        $(MERGE_MODAL).on('input', '.settlement-edit-panel [data-field="sharePct"], .settlement-edit-panel [data-field="rollingPct"]', function () {
            recalcMergeEditPanels($(MERGE_MODAL));
        });

        $(MERGE_MODAL).on('blur', '.settlement-edit-panel [data-field="sharePct"], .settlement-edit-panel [data-field="rollingPct"]', function () {
            formatMergePctInput($(this));
            recalcMergeEditPanels($(MERGE_MODAL));
        });

        // Guest / Agent calculator SHARE / ROLLING boxes edit the same field on that side's receipt panel
        function copyMergeCalcSplitToEditPanel($input) {
            var editPanelId = $input.closest('.settlement-split-panel').attr('id').replace('-calc-', '-edit-');
            $('#' + editPanelId).find('[data-field="' + $input.attr('data-split-field') + '"]').val($input.val());
        }

        $(MERGE_MODAL).on('input', '.settlement-split-panel [data-split-field]', function () {
            copyMergeCalcSplitToEditPanel($(this));
            recalcMergeEditPanels($(MERGE_MODAL));
        });

        $(MERGE_MODAL).on('blur', '.settlement-split-panel [data-split-field]', function () {
            formatMergePctInput($(this));
            copyMergeCalcSplitToEditPanel($(this));
            recalcMergeEditPanels($(MERGE_MODAL));
        });

        // Guest Add Charge — Agent's Add Charge follows as the remainder
        $(MERGE_MODAL).on('input', '.settlement-edit-panel [data-field="addCharge"]', function () {
            formatInputWithCommasLive($(this));
            recalcMergeEditPanels($(MERGE_MODAL));
        });

        $(MERGE_MODAL).on('blur', '.settlement-edit-panel [data-field="addCharge"]', function () {
            formatMergeAddChargeInput($(this));
            recalcMergeEditPanels($(MERGE_MODAL));
        });

        function handleMergeCompanyRateChange($modal, finalize) {
            var $input = $modal.find('#merge-calc-company-rate');
            var raw = finalize ? formatMergeSplitPctValue(clampMergeSplitRate($input.val(), 100)) : liveClampMergeSplitInput($input.val(), 100);
            $input.val(raw);
            refreshMergeSplitCalculators($modal);
            if ($modal.data('merge-split-active-mode') === 'rate') {
                applyMergeSplitToEditPanels($modal);
            }
        }

        $(MERGE_MODAL).on('input', '#merge-calc-company-rate', function () {
            handleMergeCompanyRateChange($(MERGE_MODAL), false);
        });

        $(MERGE_MODAL).on('blur', '#merge-calc-company-rate', function () {
            handleMergeCompanyRateChange($(MERGE_MODAL), true);
        });

        // Agent's Rate/Percentage are auto-computed — Guest is the only side typed into.
        function handleMergeRateSplitChange($modal, $input, finalize) {
            var companyRate = clampMergeSplitRate($modal.find('#merge-calc-company-rate').val(), 100);
            var raw = finalize ? formatMergeSplitPctValue(clampMergeSplitRate($input.val(), companyRate)) : liveClampMergeSplitInput($input.val(), companyRate);
            $input.val(raw);
            var guestRate = clampMergeSplitRate(raw, companyRate);

            if (guestRate > 0) {
                $modal.data('merge-split-active-mode', 'rate');
            } else if ($modal.data('merge-split-active-mode') === 'rate') {
                $modal.removeData('merge-split-active-mode');
            }

            refreshMergeSplitCalculators($modal);
            applyMergeSplitToEditPanels($modal);
        }

        $(MERGE_MODAL).on('input', '#merge-calc-guest-rate-input', function () {
            handleMergeRateSplitChange($(MERGE_MODAL), $(this), false);
        });

        $(MERGE_MODAL).on('blur', '#merge-calc-guest-rate-input', function () {
            handleMergeRateSplitChange($(MERGE_MODAL), $(this), true);
        });

        function handleMergePctSplitChange($modal, $input, finalize) {
            var raw = finalize ? formatMergeSplitPctValue(clampMergeSplitPct($input.val())) : liveClampMergeSplitInput($input.val(), 100);
            $input.val(raw);
            var guestPct = clampMergeSplitPct(raw);

            if (guestPct > 0) {
                $modal.data('merge-split-active-mode', 'pct');
            } else if ($modal.data('merge-split-active-mode') === 'pct') {
                $modal.removeData('merge-split-active-mode');
            }

            refreshMergeSplitCalculators($modal);
            applyMergeSplitToEditPanels($modal);
        }

        $(MERGE_MODAL).on('input', '#merge-calc-guest-pct-input', function () {
            handleMergePctSplitChange($(MERGE_MODAL), $(this), false);
        });

        $(MERGE_MODAL).on('blur', '#merge-calc-guest-pct-input', function () {
            handleMergePctSplitChange($(MERGE_MODAL), $(this), true);
        });
    });
</script>
