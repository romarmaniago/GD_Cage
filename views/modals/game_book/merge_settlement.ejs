<style>
    #modal-merge-settlement.show,
    #modal-merge-settlement.showing {
        display: flex !important;
        align-items: flex-start;
        justify-content: center;
        overflow-y: auto;
        padding: 0.75rem;
    }

    #modal-merge-settlement .settlement-receipt-dialog {
        --bs-modal-width: 420px;
        max-width: calc(100vw - 1.5rem);
        width: max-content;
        margin: 0 auto;
    }

    #modal-merge-settlement .modal-header {
        background: linear-gradient(160deg, #f1d48a 0%, #c8a24c 100%) !important;
        border-bottom: 1px solid rgba(58, 46, 18, 0.25) !important;
        padding: 0.75rem 1rem;
        min-height: 3.25rem;
        display: flex;
        align-items: center;
    }

    #modal-merge-settlement .modal-header .modal-title {
        color: #3a2e12 !important;
        font-size: 1.15rem;
        font-weight: 600;
        line-height: 1.3;
    }

    #modal-merge-settlement .modal-header .btn-close {
        filter: none;
        opacity: 0.65;
    }

    #modal-merge-settlement .modal-header .btn-close:hover {
        opacity: 1;
    }

    #modal-merge-settlement .modal-content,
    #modal-merge-settlement .modal-body,
    #modal-merge-settlement .modal-footer {
        background: #fff !important;
    }

    /* Receipt rows run edge to edge, like the game receipt cards */
    #modal-merge-settlement .modal-body {
        position: relative;
        padding: 0 0 0.6rem;
    }

    #modal-merge-settlement .settlement-copy-row {
        display: flex;
        justify-content: center;
        gap: 0.35rem;
        width: 100%;
    }

    #modal-merge-settlement .modal-footer .btn,
    #modal-merge-settlement .settlement-copy-row .btn {
        font-size: 0.78rem;
        padding: 0.22rem 0.55rem;
        line-height: 1.25;
    }

    #modal-merge-settlement .settlement-copy-row .btn {
        color: #fff !important;
        background: linear-gradient(135deg, #52525b 0%, #71717a 100%) !important;
        border-color: transparent !important;
        box-shadow: none !important;
    }

    #modal-merge-settlement .modal-footer {
        align-items: center !important;
        justify-content: space-between !important;
        flex-wrap: nowrap;
        gap: 0.5rem !important;
        padding: 0.5rem 1rem 0.75rem;
    }

    #modal-merge-settlement .modal-footer > * {
        margin: 0;
    }

    #modal-merge-settlement .settlement-footer-actions {
        display: flex;
        flex-wrap: nowrap;
        justify-content: flex-end;
        gap: 0.35rem;
        width: auto;
        flex: 0 0 auto;
    }

    /* --- Edit mode: Guest/Agent split-calculator panels (ported from settlement.ejs) --- */

    #modal-merge-settlement .settlement-modal-cluster {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        gap: 0.75rem;
        margin: 0 auto;
    }

    #modal-merge-settlement .settlement-main-content {
        width: 26.25rem;
        max-width: 100%;
        flex-shrink: 0;
    }

    #modal-merge-settlement .settlement-edit-panel {
        width: 26.25rem;
        max-width: 100%;
        flex-shrink: 0;
    }

    #modal-merge-settlement .settlement-edit-panel-card {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 0.35rem;
        box-shadow: 0 0.35rem 1rem rgba(0, 0, 0, 0.12);
        overflow: hidden;
        pointer-events: auto;
        display: flex;
        flex-direction: column;
    }

    #modal-merge-settlement .settlement-edit-panel-body:not(.settlement-split-body) {
        flex: 1 1 auto;
        padding: 0;
    }

    #modal-merge-settlement .settlement-edit-panel-card > .modal-footer {
        flex-shrink: 0;
        margin-top: auto;
    }

    #modal-merge-settlement .settlement-edit-panel-card > .modal-footer .settlement-copy-row {
        margin: 0;
    }

    #modal-merge-settlement .settlement-modal-cluster.is-edit-mode {
        max-width: calc(100vw - 1.5rem);
        overflow-x: auto;
        padding-bottom: 0.25rem;
        display: grid;
        grid-template-columns: 26.25rem 26.25rem 26.25rem;
        gap: 0.75rem;
        align-items: stretch;
    }

    #modal-merge-settlement .settlement-modal-cluster.is-edit-mode > .settlement-main-content,
    #modal-merge-settlement .settlement-modal-cluster.is-edit-mode > .settlement-edit-panel {
        display: flex;
        flex-direction: column;
        min-height: 0;
        width: 100%;
        max-width: 100%;
    }

    #modal-merge-settlement .settlement-modal-cluster.is-edit-mode > .settlement-edit-panel > .settlement-edit-panel-card {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 100%;
    }

    #modal-merge-settlement .settlement-modal-cluster.is-edit-mode .settlement-main-content > form {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    #modal-merge-settlement .settlement-modal-cluster.is-edit-mode .modal-footer {
        margin-top: auto;
        flex-shrink: 0;
        padding: 0.35rem 0.65rem !important;
        gap: 0.5rem !important;
        min-height: 2.35rem;
        justify-content: center !important;
        align-items: center !important;
    }

    #modal-merge-settlement .settlement-modal-cluster.is-edit-mode .modal-footer > * {
        margin: 0;
        width: auto;
    }

    #modal-merge-settlement .settlement-modal-cluster.is-edit-mode .settlement-copy-row {
        flex-wrap: nowrap;
        gap: 0.35rem;
        justify-content: center;
        width: auto;
        margin: 0 auto;
    }

    #modal-merge-settlement .settlement-modal-cluster.is-edit-mode .settlement-main-content .modal-body,
    #modal-merge-settlement .settlement-modal-cluster.is-edit-mode .settlement-edit-panel-body {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }

    #modal-merge-settlement .settlement-modal-cluster.is-edit-mode #merge-settlement-receipt-copy-area,
    #modal-merge-settlement .settlement-modal-cluster.is-edit-mode .settlement-edit-receipt-copy-area {
        flex: 1 1 auto;
        width: 100%;
    }

    /* --- Commission Settlement (Detail): separate panel below the main modal cluster --- */

    #modal-merge-settlement .settlement-modal-outer {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
    }

    #modal-merge-settlement .commission-detail-panels-row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: center;
        gap: 0.75rem;
        max-width: calc(100vw - 1.5rem);
    }

    #modal-merge-settlement .commission-detail-panel {
        width: max-content;
        max-width: 100%;
    }

    #modal-merge-settlement .commission-detail-table .cd-settlement-edit-input {
        position: relative;
        z-index: 2;
        pointer-events: auto !important;
        user-select: text;
        width: 8ch;
        box-sizing: border-box;
        border: none;
        background: #fffef8;
        padding: 0;
        text-align: right;
        font: inherit;
        line-height: 1.4;
        vertical-align: baseline;
        color: inherit;
        cursor: text;
    }

    #modal-merge-settlement .commission-detail-table .cd-settlement-edit-input:focus {
        outline: none;
        background: #f8fbff;
    }

    #modal-merge-settlement .commission-detail-panel-card {
        width: 100%;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 0.35rem;
        box-shadow: 0 0.35rem 1rem rgba(0, 0, 0, 0.12);
        overflow: hidden;
    }

    #modal-merge-settlement .commission-detail-panel-card .modal-header {
        padding: 0.5rem 0.85rem;
        min-height: 0;
    }

    #modal-merge-settlement .commission-detail-panel-card .modal-title {
        font-size: 0.95rem;
    }

    #modal-merge-settlement .commission-detail-panel-body {
        padding: 0.65rem;
    }

    #modal-merge-settlement .commission-detail-table-wrap {
        border: 1px solid var(--gd-marker-gold-border, rgba(58, 46, 18, 0.25));
        border-radius: 10px;
    }

    #modal-merge-settlement .commission-detail-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
        white-space: nowrap;
        margin: 0;
    }

    #modal-merge-settlement .commission-detail-table thead th,
    #modal-merge-settlement .commission-detail-table tbody td,
    #modal-merge-settlement .commission-detail-table tfoot th {
        vertical-align: middle;
        line-height: 1.4;
        padding: 0.5rem 0.65rem;
    }

    #modal-merge-settlement .commission-detail-table thead th:nth-child(1),
    #modal-merge-settlement .commission-detail-table thead th:nth-child(2),
    #modal-merge-settlement .commission-detail-table tbody td:nth-child(1),
    #modal-merge-settlement .commission-detail-table tbody td:nth-child(2) {
        text-align: left;
    }

    #modal-merge-settlement .commission-detail-table thead th:nth-child(n+3),
    #modal-merge-settlement .commission-detail-table tbody td:nth-child(n+3) {
        text-align: right;
    }

    #modal-merge-settlement .commission-detail-table thead th {
        font-weight: 600;
        color: #000;
        text-align: center;
        background: var(--gd-marker-gold-hover, #faf3dc);
        border: none;
        border-bottom: 1px solid var(--gd-marker-gold-border, rgba(58, 46, 18, 0.25));
    }

    #modal-merge-settlement .commission-detail-table thead th.cd-head-gold {
        color: var(--gd-marker-gold-text, #3a2e12);
    }

    #modal-merge-settlement .commission-detail-table tbody tr:nth-child(even) td {
        background-color: #fbf5e4;
    }

    #modal-merge-settlement .commission-detail-table tbody tr:nth-child(odd) td {
        background-color: #fff;
    }

    #modal-merge-settlement .commission-detail-table tbody tr:hover td {
        background-color: var(--gd-marker-gold-hover, #faf3dc);
    }

    #modal-merge-settlement .commission-detail-table tbody td,
    #modal-merge-settlement .commission-detail-table tfoot th {
        border-bottom: 1px solid var(--gd-marker-gold-border, rgba(58, 46, 18, 0.15));
    }

    #modal-merge-settlement .commission-detail-table tbody td.cd-cell-red,
    #modal-merge-settlement .commission-detail-table tfoot th.cd-cell-red,
    #modal-merge-settlement .commission-detail-table .cd-settlement-edit-input.cd-cell-red {
        color: #dc3545;
        font-weight: 700;
    }

    #modal-merge-settlement .commission-detail-table tfoot th {
        text-align: right;
        font-weight: 700;
        background: #f3ecd6;
        border-top: 2px solid var(--gd-marker-gold-border, rgba(58, 46, 18, 0.25));
        border-bottom: none;
    }

    #modal-merge-settlement .commission-detail-table tfoot th:first-child {
        text-align: left;
    }

    /* Account picker sits on the receipt's account line */
    #modal-merge-settlement .settlement-receipt-name-select {
        appearance: auto;
        max-width: 100%;
        border: none;
        background: transparent;
        padding: 0;
        margin: 0;
        font: inherit;
        color: inherit;
        text-transform: uppercase;
        text-align: center;
        text-align-last: center;
        cursor: pointer;
    }

    #modal-merge-settlement .settlement-receipt-name-select:focus {
        outline: none;
    }

    #modal-merge-settlement .settlement-receipt-name-select:disabled {
        appearance: none;
        opacity: 1;
        color: inherit;
        -webkit-text-fill-color: inherit;
        cursor: default;
    }
</style>

<%- include('_settlement_slip_styles') %>

<div class="modal fade" id="modal-merge-settlement" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" tabindex="-1" aria-labelledby="modal-merge-settlement-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered settlement-receipt-dialog">
        <div class="settlement-modal-outer">
        <div class="settlement-modal-cluster" id="merge-settlement-modal-cluster">
        <div class="modal-content settlement-main-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="modal-merge-settlement-label">Multiple Settlement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="merge_settlement_preview_form">
                <input type="hidden" name="merge_game_ids" id="mergeGameIds" value="">

                <div class="modal-body">
                    <%# The callers (game_list.js / commission.js) fill the hidden inputs in their own number formats;
                        refreshMergeReceiptDisplay renders the *Display elements from them when the modal opens. %>
                    <div id="merge-settlement-receipt-copy-area" class="settlement-receipt-body settlement-slip">
                        <div class="settlement-receipt-watermark" aria-hidden="true"></div>
                        <div class="ss-header">* SETTLEMENT *</div>

                        <div class="ss-meta">
                            <div class="ss-meta-row">
                                <div class="ss-meta-tags"></div>
                                <div class="ss-date"><span id="dateMerge"></span> <span id="timeMerge"></span></div>
                                <div class="ss-meta-spacer"></div>
                            </div>
                            <div class="ss-account"><select class="settlement-receipt-name-select" id="accNoMerge"></select></div>
                            <div class="ss-game ss-merge-games" id="mergeGamesDisplay"></div>
                        </div>

                        <div class="ss-row ss-row--buyin ss-gap" data-text-label="* BUY IN" data-text-block="totals">
                            <span class="ss-label">* BUY IN</span>
                            <span class="ss-value"><span class="settlement-receipt-amount"><input class="settlement-receipt-input" type="text" id="buyInMerge" name="txtBuyInMerge" readonly></span></span>
                        </div>
                        <div class="ss-row ss-row--cashout ss-gap" data-text-label="* CASH OUT" data-text-block="totals">
                            <span class="ss-label">* CASH OUT</span>
                            <span class="ss-value"><input type="hidden" id="chipsReturnMerge" name="txtChipsReturnMerge"><span class="settlement-receipt-amount" id="chipsReturnMergeDisplay"></span></span>
                        </div>
                        <div class="ss-row ss-row--summary ss-gap" data-text-label="* WIN / LOSS" data-text-block="totals">
                            <span class="ss-label">* WIN/LOSS</span>
                            <span class="ss-value"><input type="hidden" id="winLossMerge" name="txtWinLossMerge"><span class="settlement-receipt-amount" id="winLossMergeDisplay"></span></span>
                        </div>
                        <div class="ss-row ss-row--summary" data-text-label="* ROLLING" data-text-block="totals">
                            <span class="ss-label">* ROLLING</span>
                            <span class="ss-value"><input type="hidden" id="rollingMerge" name="txtRollingMerge"><span class="settlement-receipt-amount" id="rollingMergeDisplay"></span></span>
                        </div>
                        <div class="ss-row ss-row--rate ss-gap" data-html2canvas-ignore="true">
                            <span class="ss-label">RATE</span>
                            <span class="ss-value"><input type="hidden" id="rollingRateMerge" name="txtRollingRateMerge"><span class="settlement-receipt-amount"><input class="settlement-receipt-input" type="text" id="rollingRateMergeDisplay" readonly></span></span>
                        </div>
                        <div class="ss-row ss-row--split ss-gap" data-html2canvas-ignore="true">
                            <span>SHARE</span><span class="ss-split-value"><input class="settlement-receipt-input ss-pct-input" type="text" id="sharePctMerge" value="0%" inputmode="decimal" readonly></span>
                            <span>ROLLING</span><span class="ss-split-value"><input class="settlement-receipt-input ss-pct-input" type="text" id="rollingPctMerge" value="100%" inputmode="decimal" readonly></span>
                        </div>
                        <div class="ss-row ss-row--settle ss-gap" data-text-label="* SETTLEMENT" data-text-block="settlement">
                            <span class="ss-label">SETTLEMENT</span>
                            <span class="ss-value" id="rollingSettlementMergeDisplay"><input type="hidden" id="rollingSettlementMerge" name="txtRollingSettlementMerge"><span class="settlement-receipt-amount"></span></span>
                        </div>
                        <div class="ss-row ss-row--charge" data-text-label="* ADD CHARGE" data-text-block="settlement">
                            <span class="ss-label">ADD CHARGE</span>
                            <span class="ss-value" id="fbMergeDisplay"><input type="hidden" id="fbMerge" name="txtFNBMerge"><span class="settlement-receipt-amount">0</span></span>
                        </div>
                        <div class="ss-row ss-row--payment" data-text-label="* PAYMENT" data-text-block="settlement">
                            <span class="ss-label">PAYMENT</span>
                            <span class="ss-value" id="paymentMergeDisplay"><input type="hidden" id="paymentMerge" name="txtPaymentMerge"><span class="settlement-receipt-amount"></span></span>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <div class="settlement-copy-row" aria-hidden="false">
                        <button type="button" class="btn btn-sm js-copy-merge-settlement-slip-image"><%= __('modal_settlement.copy_image') %></button>
                        <button type="button" class="btn btn-sm js-copy-merge-settlement-slip-text"><%= __('modal_settlement.copy_text') %></button>
                    </div>
                    <div class="settlement-footer-actions">
                        <button type="button" id="print-merge-settlement-btn" class="btn btn-sm btn-alt-secondary"><%= __('modal_settlement.print') %></button>
                    </div>
                </div>
            </form>
        </div>
        <div class="settlement-edit-panel settlement-edit-panel--guest d-none" id="merge-settlement-edit-guest-panel" aria-hidden="true">
            <div class="settlement-edit-panel-card">
                <div class="modal-header bg-primary">
                    <h5 class="modal-title text-white">Edit Mode (Guest)</h5>
                </div>
                <div class="settlement-edit-panel-body" id="merge-settlement-edit-guest-body"></div>
                <div class="modal-footer flex-column align-items-center gap-2">
                    <div class="settlement-copy-row" aria-hidden="false">
                        <button type="button" class="btn btn-sm js-copy-merge-settlement-slip-image"><%= __('modal_settlement.copy_image') %></button>
                        <button type="button" class="btn btn-sm js-copy-merge-settlement-slip-text"><%= __('modal_settlement.copy_text') %></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="settlement-edit-panel settlement-edit-panel--agent d-none" id="merge-settlement-edit-agent-panel" aria-hidden="true">
            <div class="settlement-edit-panel-card">
                <div class="modal-header bg-primary">
                    <h5 class="modal-title text-white">Edit Mode (Agent)</h5>
                </div>
                <div class="settlement-edit-panel-body" id="merge-settlement-edit-agent-body"></div>
                <div class="modal-footer flex-column align-items-center gap-2">
                    <div class="settlement-copy-row" aria-hidden="false">
                        <button type="button" class="btn btn-sm js-copy-merge-settlement-slip-image"><%= __('modal_settlement.copy_image') %></button>
                        <button type="button" class="btn btn-sm js-copy-merge-settlement-slip-text"><%= __('modal_settlement.copy_text') %></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="settlement-edit-panel settlement-split-panel d-none" id="merge-settlement-calc-company-panel" aria-hidden="true">
            <div class="settlement-edit-panel-card">
                <div class="modal-header bg-primary">
                    <h5 class="modal-title text-white">Company Rate</h5>
                </div>
                <div class="settlement-edit-panel-body settlement-split-body settlement-slip">
                    <div class="ss-row ss-row--rate">
                        <span class="ss-label">RATE</span>
                        <span class="ss-value">
                            <span class="settlement-split-input-wrap">
                                <input type="text" class="settlement-split-input" id="merge-calc-company-rate" value="0" inputmode="decimal" aria-label="Company rate">
                                <span class="settlement-split-pct-suffix">%</span>
                            </span>
                        </span>
                    </div>
                    <div class="ss-row ss-row--split ss-gap">
                        <span>SHARE</span><span class="ss-split-value js-calc-share-pct">0%</span>
                        <span>ROLLING</span><span class="ss-split-value js-calc-rolling-pct">100%</span>
                    </div>
                    <div class="ss-calc-block ss-gap">
                        <div class="ss-calc-title">Rate</div>
                        <div>
                            <div class="ss-calc-row"><span>Win/Loss</span><span class="ss-calc-value js-calc-winloss">0</span></div>
                            <div class="ss-calc-row"><span>Rolling</span><span class="ss-calc-value" id="merge-calc-company-rate-rolling">0</span></div>
                            <div class="ss-calc-row"><span>Rate</span><span class="ss-calc-value" id="merge-calc-company-rate-rate-display">0%</span></div>
                            <div class="ss-calc-row"><span>Settlement</span><span class="ss-calc-value" id="merge-calc-company-rate-settlement">0</span></div>
                        </div>
                    </div>
                    <div class="ss-calc-block ss-gap">
                        <div class="ss-calc-title">Percentage</div>
                        <div>
                            <div class="ss-calc-row"><span>Win/Loss</span><span class="ss-calc-value js-calc-winloss">0</span></div>
                            <div class="ss-calc-row"><span>Rolling</span><span class="ss-calc-value" id="merge-calc-company-pct-rolling">0</span></div>
                            <div class="ss-calc-row"><span>Percentage</span><span class="ss-calc-value">100%</span></div>
                            <div class="ss-calc-row"><span>Settlement</span><span class="ss-calc-value" id="merge-calc-company-pct-settlement">0</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="settlement-edit-panel settlement-split-panel d-none" id="merge-settlement-calc-guest-panel" aria-hidden="true">
            <div class="settlement-edit-panel-card">
                <div class="modal-header bg-primary">
                    <h5 class="modal-title text-white">Edit Mode (Guest)</h5>
                </div>
                <div class="settlement-edit-panel-body settlement-split-body settlement-slip">
                    <div class="ss-row ss-row--rate">
                        <span class="ss-label">RATE</span>
                        <span class="ss-value js-calc-company-rate-display">0%</span>
                    </div>
                    <div class="ss-row ss-row--split ss-gap">
                        <span>SHARE</span><span class="ss-split-value"><input class="settlement-receipt-input ss-pct-input js-calc-share-pct" type="text" value="0%" inputmode="decimal" data-split-field="sharePct" aria-label="Share %"></span>
                        <span>ROLLING</span><span class="ss-split-value"><input class="settlement-receipt-input ss-pct-input js-calc-rolling-pct" type="text" value="100%" inputmode="decimal" data-split-field="rollingPct" aria-label="Rolling %"></span>
                    </div>
                    <div class="ss-calc-block ss-gap">
                        <div class="ss-calc-title">Rate</div>
                        <div>
                            <div class="ss-calc-row"><span>Win/Loss</span><span class="ss-calc-value js-calc-winloss">0</span></div>
                            <div class="ss-calc-row"><span>Rolling</span><span class="ss-calc-value" id="merge-calc-guest-rate-rolling">0</span></div>
                            <div class="ss-calc-row">
                                <span>Rate</span>
                                <span class="ss-calc-value">
                                    <span class="settlement-split-input-wrap">
                                        <input type="text" class="settlement-split-input" id="merge-calc-guest-rate-input" value="0" inputmode="decimal" aria-label="Guest rate split">
                                        <span class="settlement-split-pct-suffix">%</span>
                                    </span>
