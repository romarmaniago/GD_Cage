<div class="modal fade" id="modal-add-cashout" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
		<div class="modal-header bg-primary">
			<h5 class="modal-title text-white" id="staticBackdropLiveLabel">CASH-OUT - <span id="cashout-agent-code"></span></h5>
			<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
		</div>
		<form id="add_cashout">
		<div class="modal-body">
			<input type="hidden" name="game_id" class="game_list_id">
					<input type="hidden" name="txtAccountCode" class="txtAccountCode">
					<input type="hidden" name="txttotal_balance_cashout" id="total_balance_cashout">
					<input type="hidden" name="txtMarkerChipsReturn" id="MarkerChipsReturn">
					<input type="hidden" name="txtTotalRolling" id="TotalRollingCashout">
					<div class="row mb-4" id="nn-cc-row">
						<div class="col-sm-6">
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center txtNN" placeholder="NN Chips" name="txtNN" id="txtNNCashout">
						</div>

						<div class="col-sm-6">
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center txtCC" placeholder="CC Chips" name="txtCC" id="txtCCCashout">
						</div>
					</div>

					<div class="row mb-2" id="trans-type-row">
						<div class="col-sm-4">
							<div class="form-check">
								<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="1" id="cash1" name="txtTransType">
								<label class="form-check-label" for="cash1">
									<span class="d-flex align-items-center">
										Cash
									</span>
								</label>
							</div>
						</div>
						<div class="col-sm-4">
							<div class="form-check">
								<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="2" id="deposit1" name="txtTransType">
								<label class="form-check-label" for="deposit1">
									<span class="d-flex align-items-center">
										Deposit
									</span>
								</label>
							</div>
						</div>
						<div class="col-sm-4">
							<div class="form-check">
								<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="4" id="marker1" name="txtTransType">
								<label class="form-check-label" for="marker1">
									<span class="d-flex align-items-center">
										Credit
									</span>
								</label>
							</div>
						</div>
					</div>

					<div class="row mb-2">
						<div class="col-12 d-flex align-items-center justify-content-between cashout-option-row">
							<div class="form-check mb-0">
								<input class="form-check-input" style="border-color: #8a92a6 !important;" type="checkbox" id="enableSplitCashout">
								<label class="form-check-label" for="enableSplitCashout">
									Split Cash-out
								</label>
							</div>
							<div class="form-check mb-0">
								<input class="form-check-input" style="border-color: #8a92a6 !important;" type="checkbox" id="enableTipCashout" name="optTip" value="1">
								<label class="form-check-label" for="enableTipCashout">
									Tip
								</label>
							</div>
						</div>
					</div>

					<div class="row mb-3" id="split-cashout-row" style="display:none;">
						<div class="col-sm-6 mb-3 mb-sm-0">
							<div class="border rounded p-2 h-100">
								<div class="fw-semibold small text-muted mb-2">NN Chips</div>
								<div class="mb-2">
									<label class="form-label mb-1">Cash</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center" placeholder="NN Chips" id="nnCashAmount">
								</div>
								<div class="mb-2">
									<label class="form-label mb-1">Deposit</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center" placeholder="NN Chips" id="nnDepositAmount">
								</div>
								<div>
									<label class="form-label mb-1">Credit</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center" placeholder="NN Chips" id="nnCreditAmount">
								</div>
							</div>
						</div>
						<div class="col-sm-6">
							<div class="border rounded p-2 h-100">
								<div class="fw-semibold small text-muted mb-2">CC Chips</div>
								<div class="mb-2">
									<label class="form-label mb-1">Cash</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center" placeholder="CC Chips" id="ccCashAmount">
								</div>
								<div class="mb-2">
									<label class="form-label mb-1">Deposit</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center" placeholder="CC Chips" id="ccDepositAmount">
								</div>
								<div>
									<label class="form-label mb-1">Credit</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center" placeholder="CC Chips" id="ccCreditAmount">
								</div>
							</div>
						</div>
					</div>

					<div class="row mb-3" id="tip-amount-row" style="display:none;">
						<div class="col-sm-6 mb-2 mb-sm-0">
							<label class="form-label mb-1" for="tipRollerAmount">Roller</label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center" placeholder="Roller" name="txtTipRoller" id="tipRollerAmount">
						</div>
						<div class="col-sm-6">
							<label class="form-label mb-1" for="tipDealerAmount">Dealer</label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center" placeholder="Dealer" name="txtTipDealer" id="tipDealerAmount">
						</div>
					</div>
				</div>
		<div class="modal-footer">
			<button type="submit" class="btn btn-sm btn-primary" id="submit-cashout-btn">Save</button>

			<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
				Close
			</button>
		</div>
		</div>
	</div>
	</form>
	</div>

	<script>
	document.addEventListener('DOMContentLoaded', function () {
		const nnInput = document.getElementById('txtNNCashout');

		if (nnInput) {
			nnInput.addEventListener('input', function () {
				const raw = (this.value || '').toString().replace(/,/g, '');
				const trimmed = raw.trim();

				// Allow empty while typing
				if (!trimmed) {
					this.classList.remove('is-invalid');
					return;
				}

				const value = Number(trimmed);

				if (!Number.isFinite(value) || value <= 0 || value % 1000 !== 0) {
					this.classList.add('is-invalid');
				} else {
					this.classList.remove('is-invalid');
				}
			});
		}

		const splitToggle = document.getElementById('enableSplitCashout');
		const splitRow = document.getElementById('split-cashout-row');
		const transTypeRow = document.getElementById('trans-type-row');
		const nnCcRow = document.getElementById('nn-cc-row');
		const nnCashInput = document.getElementById('nnCashAmount');
		const nnDepositInput = document.getElementById('nnDepositAmount');
		const nnCreditInput = document.getElementById('nnCreditAmount');
		const ccCashInput = document.getElementById('ccCashAmount');
		const ccDepositInput = document.getElementById('ccDepositAmount');
		const ccCreditInput = document.getElementById('ccCreditAmount');
		const validateNnSplitInput = function (inputEl) {
			if (!inputEl) return;
			const raw = (inputEl.value || '').toString().replace(/,/g, '').trim();
			if (!raw) {
				inputEl.classList.remove('is-invalid');
				return;
			}
			const value = Number(raw);
			if (!Number.isFinite(value) || value < 0 || (value > 0 && value % 1000 !== 0)) {
				inputEl.classList.add('is-invalid');
			} else {
				inputEl.classList.remove('is-invalid');
			}
		};

		if (nnCashInput) {
			nnCashInput.addEventListener('input', function () {
				validateNnSplitInput(nnCashInput);
			});
		}

		if (nnDepositInput) {
			nnDepositInput.addEventListener('input', function () {
				validateNnSplitInput(nnDepositInput);
			});
		}

		if (nnCreditInput) {
			nnCreditInput.addEventListener('input', function () {
				validateNnSplitInput(nnCreditInput);
			});
		}

		const tipToggle = document.getElementById('enableTipCashout');
		const tipRow = document.getElementById('tip-amount-row');
		const tipRollerInput = document.getElementById('tipRollerAmount');
		const tipDealerInput = document.getElementById('tipDealerAmount');

		if (tipToggle) {
			tipToggle.addEventListener('change', function () {
				const isOn = this.checked;
				if (tipRow) {
					tipRow.style.display = isOn ? '' : 'none';
				}
				if (!isOn) {
					if (tipRollerInput) {
						tipRollerInput.value = '';
						tipRollerInput.classList.remove('is-invalid');
					}
					if (tipDealerInput) {
						tipDealerInput.value = '';
						tipDealerInput.classList.remove('is-invalid');
					}
				}
			});
		}

		if (splitToggle) {
			splitToggle.addEventListener('change', function () {
				const isOn = this.checked;

				if (splitRow) {
					splitRow.style.display = isOn ? '' : 'none';
				}

				if (transTypeRow) {
					transTypeRow.style.display = isOn ? 'none' : '';
				}

				if (nnCcRow) {
					nnCcRow.style.display = isOn ? 'none' : '';
				}

				if (!isOn) {
					if (nnCashInput) nnCashInput.value = '';
					if (nnDepositInput) nnDepositInput.value = '';
					if (nnCreditInput) nnCreditInput.value = '';
					if (ccCashInput) ccCashInput.value = '';
					if (ccDepositInput) ccDepositInput.value = '';
					if (ccCreditInput) ccCreditInput.value = '';
					if (nnCashInput) nnCashInput.classList.remove('is-invalid');
					if (nnDepositInput) nnDepositInput.classList.remove('is-invalid');
					if (nnCreditInput) nnCreditInput.classList.remove('is-invalid');
					if (ccCashInput) ccCashInput.classList.remove('is-invalid');
					if (ccDepositInput) ccDepositInput.classList.remove('is-invalid');
					if (ccCreditInput) ccCreditInput.classList.remove('is-invalid');
				} else {
					// When enabling split, clear transaction type radios to avoid confusion
					const transTypeRadios = document.querySelectorAll('input[name="txtTransType"]');
					transTypeRadios.forEach(function (radio) {
						radio.checked = false;
					});
				}
			});
		}

	});
	</script>