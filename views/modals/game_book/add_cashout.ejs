	const getCreditReturnSourceLabel = function (desc) {
		const normalized = String(desc || '').trim().toUpperCase();
		if (normalized === 'RETURN_SOURCE:CREDIT') return 'Junket Credit';
		if (normalized === 'RETURN_SOURCE:BUYIN') return 'Game Credit';
		return '';
	};

	const renderCreditTransactionLabel = function (row) {
		const info = row.TRANSACTION_INFO || '';
		const parts = String(info).split('-');
		const transactionId = parseInt(parts[0], 10);
		const transactionType = parseInt(parts[1], 10);
		const sourceLabel = getCreditReturnSourceLabel(row.TRANSACTION_DESC);
		switch (transactionId) {
			case 3: return 'Cash Credit';
			case 10: return 'Chips Credit';
			case 11: return sourceLabel ? (sourceLabel + ' Returned thru Cash') : 'Credit Returned thru Cash';
			case 12: return sourceLabel ? (sourceLabel + ' Returned thru Deposit') : 'Credit Returned thru Deposit';
			default:
				return transactionType === 4 ? 'Chips Return thru Credit' : 'Credit';
		}
	};

	const isCreditOutTxn = function (row) {
		const info = row && row.TRANSACTION_INFO;
		if (!info) return false;
		const transactionId = parseInt(String(info).split('-')[0], 10);
		return transactionId === 3 || transactionId === 10;
	};

	const computeCreditHistoryBalances = function (rows) {
		const chronological = rows.slice().reverse();
		let running = 0;
		const balanceById = {};
		chronological.forEach(function (row) {
			const amount = parseAmt(row.AMOUNT);
			if (isCreditOutTxn(row)) {
				running += amount;
			} else {
				running = Math.max(0, running - amount);
			}
			if (row.IDNo != null) balanceById[row.IDNo] = running;
		});
		return balanceById;
	};

	const renderCreditHistoryTable = function (pendingAmount, pendingRemarks, pendingGuarantor) {
		if (!creditHistoryBody) return;
		const rows = creditHistory.slice();
		const balanceById = computeCreditHistoryBalances(rows);
		let html = '';

		rows.forEach(function (row) {
			const amount = parseAmt(row.AMOUNT);
			const isOut = isCreditOutTxn(row);
			const displayAmt = isOut ? '-' + formatAmt(amount) : formatAmt(amount);
			const amtClass = 'text-end' + (isOut ? ' text-amount-negative' : '');
			const balance = balanceById[row.IDNo] != null ? balanceById[row.IDNo] : 0;
			const debtor = getCreditHistoryDebtorParts(row);
			const parsed = parseCreditRemarks(row.REMARKS);
			html += '<tr>' +
				'<td>' + formatHistoryDate(row.ENCODED_DT || row.encoded_date) + '</td>' +
				'<td>' + renderCreditTransactionLabel(row) + '</td>' +
				'<td class="cashout-debtor-account">' + debtor.account + '</td>' +
				'<td>' + debtor.guest + '</td>' +
				'<td>' + (parsed.guarantor || '—') + '</td>' +
				'<td class="' + amtClass + '">' + displayAmt + '</td>' +
				'<td class="text-end text-amount-negative">' + formatCreditOwed(balance) + '</td>' +
				'<td>' + (parsed.remarks || '—') + '</td>' +
				'</tr>';
		});

		if (pendingAmount > 0) {
			const currentOwed = Math.max(0, parseAmt(creditMeta.totalCredit));
			const pendingBalance = Math.max(0, currentOwed - pendingAmount);
			const code = getAgentCode();
			const guest = getGuestName() || '—';
			html += '<tr class="is-pending">' +
				'<td>' + formatHistoryDate(new Date()) + '</td>' +
				'<td>Chips Credit</td>' +
				'<td class="cashout-debtor-account">' + (code || '—') + '</td>' +
				'<td>' + guest + '</td>' +
				'<td>' + (pendingGuarantor || '—') + '</td>' +
				'<td class="text-end">' + formatAmt(pendingAmount) + '</td>' +
				'<td class="text-end text-amount-negative">' + formatCreditOwed(pendingBalance) + '</td>' +
				'<td>' + (pendingRemarks || '—') + '</td>' +
				'</tr>';
		}

		if (!html) {
			html = '<tr class="text-muted"><td colspan="8" class="text-center small py-2">No history.</td></tr>';
		}

		creditHistoryBody.innerHTML = html;
		requestAnimationFrame(applyHistoryWrapHeights);
	};

	const updateCreditPanel = function () {
		const show = creditEngaged || shouldShowCreditPanel();
		if (!show) {
			togglePanel(creditPanel, false);
			return;
		}

		const code = getAgentCode();
		const base = parseAmt(creditMeta.totalCredit);
		const processing = computeCreditProcessing();
		const hasInput = shouldShowCreditPanel();
		const anticipated = Math.max(0, base - processing);
		const pendingRemarks = creditRemarksInput ? creditRemarksInput.value.trim() : '';
		const pendingGuarantor = creditGuarantorInput ? creditGuarantorInput.value.trim() : '';

		if (creditCurrentLabelEl) creditCurrentLabelEl.textContent = 'Current Credit Balance Of ' + code;
		if (creditAnticipatedLabelEl) creditAnticipatedLabelEl.textContent = 'Anticipated Credit Balance Of ' + code;
		if (creditCurrentEl) creditCurrentEl.textContent = formatCreditOwed(base);
		if (creditAnticipatedEl) creditAnticipatedEl.textContent = hasInput ? formatCreditOwed(anticipated) : '—';
		renderGuestCreditBreakdown();
		setProcessingDisplay(creditProcessingEl, creditProcessingWrap, hasInput ? processing : 0);
		updateDebtorDisplay();

		renderCreditHistoryTable(hasInput ? processing : 0, pendingRemarks, pendingGuarantor);
		togglePanel(creditPanel, true);
	};

	const updateCashPanel = function () {
		const show = cashEngaged || shouldShowCashPanel();
		if (!show) {
			togglePanel(cashPanel, false);
			return;
		}

		togglePanel(cashPanel, true);
		const base = parseAmt(companyBaseEl && companyBaseEl.textContent);
		const processing = computeCashProcessing();
		const hasInput = shouldShowCashPanel();

		if (cashCurrentEl) cashCurrentEl.textContent = formatAmt(base);
		if (cashAnticipatedEl) cashAnticipatedEl.textContent = hasInput ? formatAmt(base + processing) : '—';
		setProcessingDisplay(cashProcessingEl, cashProcessingWrap, hasInput ? processing : 0);
	};

	const updateDepositPanel = function () {
		const show = depositEngaged || shouldShowDepositPanel();
		if (!show) {
			togglePanel(depositPanel, false);
			return;
		}

		const code = getAgentCode();
		const base = parseAmt(accountBaseEl && accountBaseEl.textContent);
		const processing = computeDepositProcessing();
		const hasInput = shouldShowDepositPanel();
		const anticipated = base + processing;
		const pendingRemarks = remarksInput ? remarksInput.value.trim() : '';

		if (depositCurrentLabelEl) depositCurrentLabelEl.textContent = 'Current Balance Of ' + code;
		if (depositAnticipatedLabelEl) depositAnticipatedLabelEl.textContent = 'Anticipated Balance Of ' + code;
		if (depositCurrentEl) depositCurrentEl.textContent = formatAmt(base);
