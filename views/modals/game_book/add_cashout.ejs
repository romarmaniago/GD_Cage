	const updateBalanceSummary = function () {
		updateCashPanel();
		updateDepositPanel();
		updateCreditPanel();
		updateTipRollerPanel();
		updateTipDealerPanel();
	};

	const resetBalanceDisplay = function () {
		cashEngaged = false;
		depositEngaged = false;
		creditEngaged = false;
		tipRollerEngaged = false;
		tipDealerEngaged = false;
		resetSidePanelsWidth();
		togglePanel(cashPanel, false);
