		if (remarksInput) remarksInput.value = '';
		if (creditRemarksInput) creditRemarksInput.value = '';
		if (creditGuarantorInput) creditGuarantorInput.value = '';
		if (tipRollerNameInput) tipRollerNameInput.value = '';
		if (tipDealerNameInput) tipDealerNameInput.value = '';
		if (tipRollerStatusInput) tipRollerStatusInput.value = '';
		if (tipDealerStatusInput) tipDealerStatusInput.value = '';
		creditHistory = [];
		rollerTipHistory = [];
		dealerTipHistory = [];
		rollerTipBalance = 0;
		dealerTipBalance = 0;
		creditMeta = { totalCredit: 0, balanceCredit: 0, balanceBuyin: 0, guestBalances: [], agentCode: '', agentName: '', agencyName: '' };
		if (creditGuestColsEl) creditGuestColsEl.innerHTML = '';
		if (historyBody) {
			historyBody.innerHTML = '<tr class="text-muted"><td colspan="4" class="text-center small py-2">No history.</td></tr>';
		}
		if (creditHistoryBody) {
			creditHistoryBody.innerHTML = '<tr class="text-muted"><td colspan="8" class="text-center small py-2">No history.</td></tr>';
		}
		if (tipRollerHistoryBody) {
			tipRollerHistoryBody.innerHTML = '<tr class="text-muted"><td colspan="5" class="text-center small py-2">No history.</td></tr>';
		}
		if (tipDealerHistoryBody) {
			tipDealerHistoryBody.innerHTML = '<tr class="text-muted"><td colspan="5" class="text-center small py-2">No history.</td></tr>';
		}
	};

	const loadCompanyBalance = function () {
		return fetch('/game_list_company_balance', { credentials: 'same-origin' })
			.then(function (r) {
				if (!r.ok) throw new Error('bad status');
				return r.json();
			})
			.then(function (data) {
				if (companyBaseEl) companyBaseEl.textContent = String(Number(data && data.cashBalance) || 0);
			})
			.catch(function () {
				if (companyBaseEl) companyBaseEl.textContent = '0';
			});
	};

	const loadAccountBalance = function () {
		const accountInput = modal.querySelector('.txtAccountCode');
		const accountId = accountInput ? accountInput.value : '';
		if (!accountId) {
			if (accountBaseEl) accountBaseEl.textContent = '0';
			ledgerHistory = [];
			return Promise.resolve();
		}

		return fetch('/account_details_data_deposit/' + encodeURIComponent(accountId), { credentials: 'same-origin' })
			.then(function (r) {
				if (!r.ok) throw new Error('bad status');
				return r.json();
			})
			.then(function (data) {
				ledgerHistory = Array.isArray(data) ? data : [];
				let depositAmount = 0;
				let withdrawAmount = 0;
				let markerReturn = 0;
				let markerDepositAmount = 0;

				ledgerHistory.forEach(function (row) {
					const amount = parseAmt(row.AMOUNT);
					const txn = row.TRANSACTION || '';
					if (txn === 'DEPOSIT') depositAmount += amount;
					else if (txn === 'WITHDRAW') withdrawAmount += amount;
					else if (txn === 'IOU RETURN DEPOSIT') markerReturn += amount;
					else if (txn === 'MARKER REDEEM') markerDepositAmount += amount;
				});

				if (accountBaseEl) {
					accountBaseEl.textContent = String(depositAmount + markerDepositAmount - withdrawAmount - markerReturn);
				}
			})
			.catch(function () {
				ledgerHistory = [];
				if (accountBaseEl) accountBaseEl.textContent = '0';
			});
	};

	const loadCreditContext = function () {
		const accountInput = modal.querySelector('.txtAccountCode');
		const accountId = accountInput ? accountInput.value : '';
		if (!accountId) {
			creditHistory = [];
			creditMeta = { totalCredit: 0, balanceCredit: 0, balanceBuyin: 0, guestBalances: [], agentCode: '', agentName: '', agencyName: '' };
			if (creditGuestColsEl) creditGuestColsEl.innerHTML = '';
			return Promise.resolve();
		}

		return fetch('/game_list_cashout_credit/' + encodeURIComponent(accountId), { credentials: 'same-origin' })
			.then(function (r) {
				if (!r.ok) throw new Error('bad status');
				return r.json();
			})
			.then(function (data) {
				creditMeta = {
					totalCredit: Number(data && data.totalCredit) || 0,
					balanceCredit: Number(data && data.balanceCredit) || 0,
					balanceBuyin: Number(data && data.balanceBuyin) || 0,
					guestBalances: Array.isArray(data && data.guestBalances) ? data.guestBalances : [],
					agentCode: (data && data.agentCode) || '',
					agentName: (data && data.agentName) || '',
					agencyName: (data && data.agencyName) || ''
				};
				creditHistory = Array.isArray(data && data.history) ? data.history : [];
			})
			.catch(function () {
				creditHistory = [];
				creditMeta = { totalCredit: 0, balanceCredit: 0, balanceBuyin: 0, guestBalances: [], agentCode: '', agentName: '', agencyName: '' };
				if (creditGuestColsEl) creditGuestColsEl.innerHTML = '';
			});
	};

	const loadTipContext = function () {
		const accountInput = modal.querySelector('.txtAccountCode');
		const accountId = accountInput ? accountInput.value : '';
		if (!accountId) {
			rollerTipHistory = [];
			dealerTipHistory = [];
			rollerTipBalance = 0;
			dealerTipBalance = 0;
			return Promise.resolve();
		}

		return fetch('/game_list_cashout_tips/' + encodeURIComponent(accountId), { credentials: 'same-origin' })
			.then(function (r) {
				if (!r.ok) throw new Error('bad status');
				return r.json();
			})
			.then(function (data) {
				rollerTipBalance = Number(data && data.rollerBalance) || 0;
				dealerTipBalance = Number(data && data.dealerBalance) || 0;
				rollerTipHistory = Array.isArray(data && data.rollerHistory) ? data.rollerHistory : [];
				dealerTipHistory = Array.isArray(data && data.dealerHistory) ? data.dealerHistory : [];
			})
			.catch(function () {
				rollerTipHistory = [];
				dealerTipHistory = [];
				rollerTipBalance = 0;
				dealerTipBalance = 0;
			});
	};

	const loadModalBalances = function () {
		resetBalanceDisplay();
		return Promise.all([
			loadCompanyBalance(),
			loadAccountBalance(),
			loadCreditContext(),
			loadTipContext()
		]).then(updateBalanceSummary);
	};

	const validateNnSplitInput = function (inputEl) {
		if (!inputEl) return;
		const raw = (inputEl.value || '').toString().replace(/,/g, '').trim();
		if (!raw) {
			inputEl.classList.remove('is-invalid');
			return;
		}
		const value = Number(raw);
		if (!Number.isFinite(value) || value < 0 || (value > 0 && value % 1000 !== 0)) {
			inputEl.classList.add('is-invalid');
		} else {
			inputEl.classList.remove('is-invalid');
		}
	};

	const isDepositGroupFocused = function (activeEl) {
		if (!activeEl) return false;
		if (remarksInput && activeEl === remarksInput) return true;
		return activeEl.classList && activeEl.classList.contains('cashout-deposit-input');
	};

	const isCreditGroupFocused = function (activeEl) {
		if (!activeEl) return false;
		if (creditRemarksInput && activeEl === creditRemarksInput) return true;
		if (creditGuarantorInput && activeEl === creditGuarantorInput) return true;
		return activeEl.classList && activeEl.classList.contains('cashout-credit-input');
	};

	const isTipRollerGroupFocused = function (activeEl) {
		if (!activeEl) return false;
		if (tipRollerNameInput && activeEl === tipRollerNameInput) return true;
		if (tipDealerNameInput && activeEl === tipDealerNameInput) return true;
		if (tipRollerStatusInput && activeEl === tipRollerStatusInput) return true;
		if (tipDealerStatusInput && activeEl === tipDealerStatusInput) return true;
		return activeEl.classList && activeEl.classList.contains('cashout-tip-roller-input');
	};

	const isTipDealerGroupFocused = function (activeEl) {
		if (!activeEl) return false;
		if (tipDealerNameInput && activeEl === tipDealerNameInput) return true;
		if (tipDealerStatusInput && activeEl === tipDealerStatusInput) return true;
		return activeEl.classList && activeEl.classList.contains('cashout-tip-dealer-input');
	};

	const syncTipField = function (sourceEl, targetEl) {
		if (!sourceEl || !targetEl || targetEl.value === sourceEl.value) return;
		targetEl.value = sourceEl.value;
	};

	const wireTipMetaField = function (inputEl, panelType, fieldType) {
		if (!inputEl) return;
		inputEl.removeAttribute('readonly');
		inputEl.removeAttribute('disabled');
		inputEl.addEventListener('mousedown', function (e) {
			e.stopPropagation();
		});
		inputEl.addEventListener('focus', function () {
			if (panelType === 'roller') {
				tipRollerEngaged = true;
				if (tipRollerPanel && tipRollerPanel.classList.contains('d-none')) {
					updateTipRollerPanel();
				}
			} else {
				tipDealerEngaged = true;
				if (tipDealerPanel && tipDealerPanel.classList.contains('d-none')) {
					updateTipDealerPanel();
				}
			}
		});
		inputEl.addEventListener('input', function () {
			if (fieldType === 'name') {
				if (panelType === 'roller') {
					syncTipField(tipRollerNameInput, tipDealerNameInput);
				} else {
					syncTipField(tipDealerNameInput, tipRollerNameInput);
				}
			} else {
				if (panelType === 'roller') {
					syncTipField(tipRollerStatusInput, tipDealerStatusInput);
				} else {
					syncTipField(tipDealerStatusInput, tipRollerStatusInput);
				}
			}
			updateBalanceSummary();
		});
		inputEl.addEventListener('blur', function () {
			setTimeout(function () {
				const active = document.activeElement;
				if (panelType === 'roller') {
					if (isTipRollerGroupFocused(active)) return;
					if (!shouldShowTipRollerPanel()) {
						tipRollerEngaged = false;
						updateBalanceSummary();
					}
				} else {
					if (isTipDealerGroupFocused(active) || isTipRollerGroupFocused(active)) return;
					if (!shouldShowTipDealerPanel()) {
						tipDealerEngaged = false;
						updateBalanceSummary();
					}
				}
			}, 0);
		});
	};

	const wireTipRollerSideField = function (inputEl, fieldType) {
		wireTipMetaField(inputEl, 'roller', fieldType);
	};

	const wireCreditSideField = function (inputEl) {
		if (!inputEl) return;
		inputEl.removeAttribute('readonly');
		inputEl.removeAttribute('disabled');
		inputEl.addEventListener('mousedown', function (e) {
			e.stopPropagation();
		});
		inputEl.addEventListener('focus', function () {
			creditEngaged = true;
			if (creditPanel && creditPanel.classList.contains('d-none')) {
				updateCreditPanel();
			}
		});
		inputEl.addEventListener('input', function () {
			updateCreditPanel();
		});
		inputEl.addEventListener('blur', function () {
			setTimeout(function () {
				if (isCreditGroupFocused(document.activeElement)) return;
				if (!shouldShowCreditPanel()) {
					creditEngaged = false;
					updateBalanceSummary();
				}
			}, 0);
		});
	};

	const wirePanelInputs = function (selector, type) {
		const inputs = modal.querySelectorAll(selector);
		const hasInputFn = type === 'cash'
			? shouldShowCashPanel
			: (type === 'deposit'
				? shouldShowDepositPanel
				: (type === 'credit'
					? shouldShowCreditPanel
					: (type === 'tipRoller' ? shouldShowTipRollerPanel : shouldShowTipDealerPanel)));

		inputs.forEach(function (inputEl) {
			inputEl.addEventListener('focus', function () {
				if (type === 'cash') cashEngaged = true;
				else if (type === 'deposit') depositEngaged = true;
				else if (type === 'credit') creditEngaged = true;
				else if (type === 'tipRoller') tipRollerEngaged = true;
				else tipDealerEngaged = true;
				updateBalanceSummary();
			});

			inputEl.addEventListener('input', function () {
				updateBalanceSummary();
			});

			inputEl.addEventListener('blur', function () {
				setTimeout(function () {
					const active = document.activeElement;
					let stillFocused = false;
					inputs.forEach(function (el) {
						if (el === active) stillFocused = true;
					});
					if (type === 'deposit' && isDepositGroupFocused(active)) {
						stillFocused = true;
					}
					if (type === 'credit' && isCreditGroupFocused(active)) {
						stillFocused = true;
					}
					if (type === 'tipRoller' && isTipRollerGroupFocused(active)) {
						stillFocused = true;
					}
					if (type === 'tipDealer' && isTipDealerGroupFocused(active)) {
						stillFocused = true;
					}
					if (!stillFocused && !hasInputFn()) {
						if (type === 'cash') cashEngaged = false;
						else if (type === 'deposit') depositEngaged = false;
						else if (type === 'credit') creditEngaged = false;
						else if (type === 'tipRoller') tipRollerEngaged = false;
						else tipDealerEngaged = false;
						updateBalanceSummary();
					}
				}, 0);
			});
		});
	};

	modal.querySelectorAll('.cashout-nn-input').forEach(function (inputEl) {
		inputEl.addEventListener('input', function () {
			validateNnSplitInput(inputEl);
		});
	});

	wirePanelInputs('.cashout-cash-input', 'cash');
	wirePanelInputs('.cashout-deposit-input', 'deposit');
	wirePanelInputs('.cashout-credit-input', 'credit');
	wirePanelInputs('.cashout-tip-roller-input', 'tipRoller');
	wirePanelInputs('.cashout-tip-dealer-input', 'tipDealer');

	if (remarksInput) {
		remarksInput.removeAttribute('readonly');
		remarksInput.removeAttribute('disabled');

		remarksInput.addEventListener('mousedown', function (e) {
			e.stopPropagation();
		});

		remarksInput.addEventListener('focus', function () {
			depositEngaged = true;
			if (depositPanel && depositPanel.classList.contains('d-none')) {
				updateDepositPanel();
			}
		});
		remarksInput.addEventListener('input', function () {
			updateDepositPanel();
		});
		remarksInput.addEventListener('blur', function () {
			setTimeout(function () {
				if (isDepositGroupFocused(document.activeElement)) return;
				if (!shouldShowDepositPanel()) {
					depositEngaged = false;
					updateBalanceSummary();
				}
			}, 0);
		});
	}

	wireCreditSideField(creditRemarksInput);
	wireCreditSideField(creditGuarantorInput);
	wireTipRollerSideField(tipRollerNameInput, 'name');
	wireTipRollerSideField(tipRollerStatusInput, 'status');
	wireTipMetaField(tipDealerNameInput, 'dealer', 'name');
	wireTipMetaField(tipDealerStatusInput, 'dealer', 'status');
	wireSidePanelsResize();

	modal.addEventListener('shown.bs.modal', function () {
		releaseCashoutFocusTrap();
		loadModalBalances();
	});
	modal.addEventListener('hidden.bs.modal', function () {
		restoreCashoutFocusTrap();
		resetBalanceDisplay();
	});
	syncSidePanelsLayout();

	window.refreshCashoutModalBalances = function (agentCode, guestName) {
		if (agentCodeEl) agentCodeEl.textContent = agentCode || '';
		if (guestNameEl) guestNameEl.textContent = guestName || '';
		return loadModalBalances();
	};
});
</script>
