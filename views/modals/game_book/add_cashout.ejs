<script>
document.addEventListener('DOMContentLoaded', function () {
	const modal = document.getElementById('modal-add-cashout');
	if (!modal) return;

	const companyBaseEl = document.getElementById('cashout-company-balance-base');
	const accountBaseEl = document.getElementById('cashout-account-balance-base');
	const agentCodeEl = document.getElementById('cashout-agent-code-label');
	const guestNameEl = document.getElementById('cashout-guest-name-label');

	const cashPanel = document.getElementById('cashout-cash-panel');
	const depositPanel = document.getElementById('cashout-deposit-panel');
	const creditPanel = document.getElementById('cashout-credit-panel');
	const cashCurrentEl = document.getElementById('cashout-cash-current');
	const cashAnticipatedEl = document.getElementById('cashout-cash-anticipated');
	const cashProcessingEl = document.getElementById('cashout-cash-processing');
	const cashProcessingWrap = document.getElementById('cashout-cash-processing-wrap');

	const depositCurrentLabelEl = document.getElementById('cashout-deposit-current-label');
	const depositAnticipatedLabelEl = document.getElementById('cashout-deposit-anticipated-label');
	const depositCurrentEl = document.getElementById('cashout-deposit-current');
	const depositAnticipatedEl = document.getElementById('cashout-deposit-anticipated');
	const depositProcessingEl = document.getElementById('cashout-deposit-processing');
	const depositProcessingWrap = document.getElementById('cashout-deposit-processing-wrap');
	const remarksInput = document.getElementById('cashout-deposit-remarks');
	const creditCurrentLabelEl = document.getElementById('cashout-credit-current-label');
	const creditAnticipatedLabelEl = document.getElementById('cashout-credit-anticipated-label');
	const creditCurrentEl = document.getElementById('cashout-credit-current');
	const creditAnticipatedEl = document.getElementById('cashout-credit-anticipated');
	const creditGuestColsEl = document.getElementById('cashout-credit-guest-cols');
	const creditProcessingEl = document.getElementById('cashout-credit-processing');
	const creditProcessingWrap = document.getElementById('cashout-credit-processing-wrap');
	const creditDebtorAccountEl = document.getElementById('cashout-credit-debtor-account');
	const creditDebtorGuestEl = document.getElementById('cashout-credit-debtor-guest');
	const creditGuarantorInput = document.getElementById('cashout-credit-guarantor');
	const creditRemarksInput = document.getElementById('cashout-credit-remarks');
	const creditHistoryBody = document.getElementById('cashout-credit-history-body');
	const tipRollerPanel = document.getElementById('cashout-tip-roller-panel');
	const tipDealerPanel = document.getElementById('cashout-tip-dealer-panel');
	const tipRollerCurrentEl = document.getElementById('cashout-tip-roller-current');
	const tipRollerAnticipatedEl = document.getElementById('cashout-tip-roller-anticipated');
	const tipRollerProcessingEl = document.getElementById('cashout-tip-roller-processing');
	const tipRollerProcessingWrap = document.getElementById('cashout-tip-roller-processing-wrap');
	const tipRollerNameInput = document.getElementById('cashout-tip-roller-name');
	const tipDealerNameInput = document.getElementById('cashout-tip-dealer-roller-name');
	const tipRollerStatusInput = document.getElementById('cashout-tip-roller-status');
	const tipDealerStatusInput = document.getElementById('cashout-tip-dealer-roller-status');
	const tipRollerHistoryBody = document.getElementById('cashout-tip-roller-history-body');
	const tipDealerCurrentEl = document.getElementById('cashout-tip-dealer-current');
	const tipDealerAnticipatedEl = document.getElementById('cashout-tip-dealer-anticipated');
	const tipDealerProcessingEl = document.getElementById('cashout-tip-dealer-processing');
	const tipDealerProcessingWrap = document.getElementById('cashout-tip-dealer-processing-wrap');
	const tipDealerHistoryBody = document.getElementById('cashout-tip-dealer-history-body');

	const allowCashoutSidePanelFocus = function (e) {
		if (!e.target || !e.target.closest) return;
		if (e.target.closest('#cashout-side-panels')) {
			e.stopImmediatePropagation();
		}
	};

	const releaseCashoutFocusTrap = function () {
		if (window.bootstrap && bootstrap.Modal) {
			const instance = bootstrap.Modal.getInstance(modal) || bootstrap.Modal.getOrCreateInstance(modal, { focus: false });
			if (instance) {
				instance._config.focus = false;
				if (instance._focustrap && typeof instance._focustrap.deactivate === 'function') {
					instance._focustrap.deactivate();
				}
			}
		}
		window.addEventListener('focusin', allowCashoutSidePanelFocus, true);
	};

	const restoreCashoutFocusTrap = function () {
		window.removeEventListener('focusin', allowCashoutSidePanelFocus, true);
	};
	const historyBody = document.getElementById('cashout-history-body');

	let ledgerHistory = [];
	let creditHistory = [];
	let creditMeta = { totalCredit: 0, balanceCredit: 0, balanceBuyin: 0, guestBalances: [], agentCode: '', agentName: '', agencyName: '' };
	let cashEngaged = false;
	let depositEngaged = false;
	let creditEngaged = false;
	let tipRollerEngaged = false;
	let tipDealerEngaged = false;
	let rollerTipHistory = [];
	let dealerTipHistory = [];
	let rollerTipBalance = 0;
	let dealerTipBalance = 0;
	const HISTORY_VISIBLE_ROWS = 5;

	const parseAmt = function (raw) {
		const s = (raw || '').toString().replace(/,/g, '').trim();
		if (!s) return 0;
		const n = Number(s);
		return Number.isFinite(n) ? n : 0;
	};

	const formatAmt = function (n) {
		return Math.round(n).toLocaleString('en-US');
	};

	const hasRowInput = function (nnId, ccId) {
		const nn = (document.getElementById(nnId) && document.getElementById(nnId).value || '').replace(/,/g, '').trim();
		const cc = (document.getElementById(ccId) && document.getElementById(ccId).value || '').replace(/,/g, '').trim();
		return !!(nn || cc);
	};

	const getAgentCode = function () {
		return (agentCodeEl && agentCodeEl.textContent || '').trim() || 'Account';
	};

	const getGuestName = function () {
		return (guestNameEl && guestNameEl.textContent || '').trim();
	};
	const getTipRollerName = function () {
		return (tipRollerNameInput && tipRollerNameInput.value || '').trim();
	};
	const getTipStatus = function () {
		return (tipRollerStatusInput && tipRollerStatusInput.value || '').trim();
	};

	const getCreditHistoryDebtorParts = function (row) {
		const code = (row && row.AGENT_CODE) || creditMeta.agentCode || getAgentCode();
		const guest = row && row.GUEST_NAME ? String(row.GUEST_NAME).trim() : '';
		return { account: code || '—', guest: guest || '—' };
	};

	const parseCreditRemarks = function (remarks) {
		const raw = String(remarks || '').trim();
		if (!raw) return { remarks: '', guarantor: '' };
		const idx = raw.indexOf('Guarantor:');
		if (idx === -1) return { remarks: raw, guarantor: '' };
		const remarksPart = raw.slice(0, idx).replace(/\|\s*$/, '').trim();
		const guarantor = raw.slice(idx + 'Guarantor:'.length).trim();
		return { remarks: remarksPart, guarantor: guarantor };
	};

	const renderGuestCreditBreakdown = function () {
		if (!creditGuestColsEl) return;
		const guests = Array.isArray(creditMeta.guestBalances) ? creditMeta.guestBalances : [];
		if (!guests.length) {
			creditGuestColsEl.innerHTML = '';
			return;
		}

		let html = '';
		guests.forEach(function (g) {
			const bal = Number(g.creditBalance) || 0;
			if (bal <= 0) return;
			const name = (g.guestName || '').trim() || 'Guest';
			html += '<div class="cashout-credit-guest-col">' +
				'<div class="cashout-balance-head-cell">' + name + '</div>' +
				'<div class="cashout-balance-value-cell text-amount-negative">' + formatCreditOwed(bal) + '</div>' +
				'</div>';
		});

		creditGuestColsEl.innerHTML = html;
	};

	const getDebtorLine = function () {
		const code = getAgentCode();
		const guest = getGuestName();
		if (code && guest) return code + ' ' + guest;
		return code || guest || '—';
	};

	const updateDebtorDisplay = function () {
		const code = getAgentCode();
		const guest = getGuestName();
		if (creditDebtorAccountEl) creditDebtorAccountEl.textContent = code || '—';
		if (creditDebtorGuestEl) {
			creditDebtorGuestEl.textContent = guest || '—';
			creditDebtorGuestEl.classList.toggle('d-none', !guest);
		}
	};

	const shouldShowCashPanel = function () {
		return hasRowInput('nnCashAmount', 'ccCashAmount');
	};

	const shouldShowTipRollerPanel = function () {
		return hasRowInput('tipRollerNn', 'tipRollerCc');
	};

	const shouldShowTipDealerPanel = function () {
		return hasRowInput('tipDealerNn', 'tipDealerCc');
	};

	const shouldShowDepositPanel = function () {
		return hasRowInput('nnDepositAmount', 'ccDepositAmount');
	};

	const shouldShowCreditPanel = function () {
		return hasRowInput('nnCreditAmount', 'ccCreditAmount');
	};

	const computeCreditProcessing = function () {
		return (
			parseAmt(document.getElementById('nnCreditAmount') && document.getElementById('nnCreditAmount').value) +
			parseAmt(document.getElementById('ccCreditAmount') && document.getElementById('ccCreditAmount').value)
		);
	};

	const formatCreditOwed = function (amount) {
		const owed = Math.max(0, parseAmt(amount));
		if (!owed) return '0';
		return '-' + formatAmt(owed);
	};

	const computeCashProcessing = function () {
		const cashLeg =
			parseAmt(document.getElementById('nnCashAmount') && document.getElementById('nnCashAmount').value) +
			parseAmt(document.getElementById('ccCashAmount') && document.getElementById('ccCashAmount').value);
		return -cashLeg;
	};

	const computeTipRollerProcessing = function () {
		return (
			parseAmt(document.getElementById('tipRollerNn') && document.getElementById('tipRollerNn').value) +
			parseAmt(document.getElementById('tipRollerCc') && document.getElementById('tipRollerCc').value)
		);
	};

	const computeTipDealerProcessing = function () {
		return (
			parseAmt(document.getElementById('tipDealerNn') && document.getElementById('tipDealerNn').value) +
			parseAmt(document.getElementById('tipDealerCc') && document.getElementById('tipDealerCc').value)
		);
	};

	const computeDepositProcessing = function () {
		return (
			parseAmt(document.getElementById('nnDepositAmount') && document.getElementById('nnDepositAmount').value) +
			parseAmt(document.getElementById('ccDepositAmount') && document.getElementById('ccDepositAmount').value)
		);
	};

	const setProcessingDisplay = function (el, wrap, processing) {
		if (!el || !wrap) return;
		if (processing < 0) {
			el.textContent = '-' + formatAmt(Math.abs(processing));
		} else {
			el.textContent = formatAmt(processing);
		}
		wrap.classList.toggle('is-negative', processing < 0);
		wrap.classList.toggle('is-positive', processing > 0);
	};

	const togglePanel = function (panel, visible) {
		if (!panel) return;
		panel.classList.toggle('d-none', !visible);
		panel.setAttribute('aria-hidden', visible ? 'false' : 'true');
		syncSidePanelsLayout();
	};

	const applyHistoryWrapHeights = function () {
		modal.querySelectorAll('.cashout-history-wrap').forEach(function (wrap) {
			const tbl = wrap.querySelector('table');
			if (!tbl) return;
			const head = tbl.querySelector('thead');
			const sampleRow = tbl.querySelector('tbody tr:not(.text-muted)');
			const headH = head ? head.getBoundingClientRect().height : 28;
			const rowH = sampleRow ? sampleRow.getBoundingClientRect().height : 26;
			wrap.style.maxHeight = Math.ceil(headH + rowH * HISTORY_VISIBLE_ROWS) + 'px';
		});
	};

	const syncSidePanelsLayout = function () {
		const sidePanels = document.getElementById('cashout-side-panels');
		if (!sidePanels) return;
		const anyVisible =
			(cashPanel && !cashPanel.classList.contains('d-none')) ||
			(depositPanel && !depositPanel.classList.contains('d-none')) ||
			(creditPanel && !creditPanel.classList.contains('d-none')) ||
			(tipRollerPanel && !tipRollerPanel.classList.contains('d-none')) ||
			(tipDealerPanel && !tipDealerPanel.classList.contains('d-none'));
		sidePanels.classList.toggle('cashout-side-panels-empty', !anyVisible);
		applySidePanelsDefaultWidth();
	};

	const applySidePanelsDefaultWidth = function () {
		const sidePanels = document.getElementById('cashout-side-panels');
		if (!sidePanels || sidePanels.dataset.userSized === '1') return;
		const creditOpen = creditPanel && !creditPanel.classList.contains('d-none');
		const tipsOpen =
			(tipRollerPanel && !tipRollerPanel.classList.contains('d-none')) ||
			(tipDealerPanel && !tipDealerPanel.classList.contains('d-none'));
		sidePanels.style.width = (creditOpen || tipsOpen) ? '40rem' : '24rem';
	};

	const resetSidePanelsWidth = function () {
		const sidePanels = document.getElementById('cashout-side-panels');
		if (!sidePanels) return;
		delete sidePanels.dataset.userSized;
		sidePanels.style.width = '';
	};

	const wireSidePanelsResize = function () {
		const sidePanels = document.getElementById('cashout-side-panels');
		const resizeHandle = document.getElementById('cashout-side-resize-handle');
		const cluster = modal.querySelector('.cashout-modal-cluster');
		if (!sidePanels || !resizeHandle || !cluster) return;

		const minWidth = 18 * 16;
		let dragging = false;
		let startX = 0;
		let startWidth = 0;

		const getMaxWidth = function () {
			const clusterRect = cluster.getBoundingClientRect();
			const mainContent = modal.querySelector('.cashout-main-content');
			const mainWidth = mainContent ? mainContent.getBoundingClientRect().width : 512;
			const gap = 12;
			const padding = 24;
			return Math.max(minWidth, window.innerWidth - padding - mainWidth - gap - 32);
		};

		const onMove = function (e) {
			if (!dragging) return;
			const nextWidth = Math.min(getMaxWidth(), Math.max(minWidth, startWidth + (e.clientX - startX)));
			sidePanels.style.width = nextWidth + 'px';
		};

		const onStop = function () {
			if (!dragging) return;
			dragging = false;
			resizeHandle.classList.remove('is-dragging');
			document.body.classList.remove('cashout-side-resize-active');
			window.removeEventListener('mousemove', onMove);
			window.removeEventListener('mouseup', onStop);
		};

		resizeHandle.addEventListener('mousedown', function (e) {
			if (sidePanels.classList.contains('cashout-side-panels-empty')) return;
			e.preventDefault();
			e.stopPropagation();
			dragging = true;
			startX = e.clientX;
			startWidth = sidePanels.getBoundingClientRect().width;
			sidePanels.dataset.userSized = '1';
			resizeHandle.classList.add('is-dragging');
			document.body.classList.add('cashout-side-resize-active');
			window.addEventListener('mousemove', onMove);
			window.addEventListener('mouseup', onStop);
		});
	};

	const formatHistoryDate = function (raw) {
		if (!raw) return '—';
		const d = new Date(raw);
		if (Number.isNaN(d.getTime())) return String(raw);
		return (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
	};

	const isNegativeLedgerTxn = function (txnName) {
		return (txnName || '').toUpperCase().indexOf('WITHDRAW') !== -1;
	};

	const renderHistoryTable = function (pendingAmount, pendingRemarks) {
		if (!historyBody) return;
		const rows = ledgerHistory.slice();
		let html = '';

		rows.forEach(function (row) {
			const txn = row.TRANSACTION || row.TRANSACTION_DESC || '—';
			const amount = parseAmt(row.AMOUNT);
			const isNeg = isNegativeLedgerTxn(txn);
			const displayAmt = (isNeg ? '-' : '') + formatAmt(Math.abs(amount));
			const amtClass = isNeg ? 'text-end text-amount-negative' : 'text-end';
			html += '<tr>' +
				'<td>' + formatHistoryDate(row.encoded_date || row.ENCODED_DT) + '</td>' +
				'<td>' + txn + '</td>' +
				'<td class="' + amtClass + '">' + displayAmt + '</td>' +
				'<td>' + (row.REMARKS || '—') + '</td>' +
				'</tr>';
		});

		if (pendingAmount > 0) {
			html += '<tr class="is-pending">' +
				'<td>' + formatHistoryDate(new Date()) + '</td>' +
				'<td>Chips Deposit</td>' +
				'<td class="text-end">' + formatAmt(pendingAmount) + '</td>' +
				'<td>' + (pendingRemarks || '—') + '</td>' +
				'</tr>';
		}

		if (!html) {
			html = '<tr class="text-muted"><td colspan="4" class="text-center small py-2">No history.</td></tr>';
		}

		historyBody.innerHTML = html;
		requestAnimationFrame(applyHistoryWrapHeights);
	};

	const renderTipHistoryTable = function (bodyEl, rows, pendingAmount, pendingStatus, pendingName, pendingTransaction) {
		if (!bodyEl) return;
		let html = '';

		rows.forEach(function (row) {
			const amount = parseAmt(row.AMOUNT);
			const amtClass = amount < 0 ? 'text-end text-amount-negative' : 'text-end';
			const displayAmt = amount < 0 ? '-' + formatAmt(Math.abs(amount)) : formatAmt(amount);
			html += '<tr>' +
				'<td>' + formatHistoryDate(row.TIP_DATETIME || row.ENCODED_DT) + '</td>' +
				'<td>' + (row.TRANSACTION || '—') + '</td>' +
				'<td class="' + amtClass + '">' + displayAmt + '</td>' +
				'<td>' + (row.STATUS || '—') + '</td>' +
				'<td>' + (row.PERSON_NAME || '—') + '</td>' +
				'</tr>';
		});

		if (pendingAmount > 0) {
			html += '<tr class="is-pending">' +
				'<td>' + formatHistoryDate(new Date()) + '</td>' +
				'<td>' + (pendingTransaction || 'Tip') + '</td>' +
				'<td class="text-end">' + formatAmt(pendingAmount) + '</td>' +
				'<td>' + (pendingStatus || 'Roller') + '</td>' +
				'<td>' + (pendingName || '—') + '</td>' +
				'</tr>';
		}

		if (!html) {
			html = '<tr class="text-muted"><td colspan="5" class="text-center small py-2">No history.</td></tr>';
		}

		bodyEl.innerHTML = html;
		requestAnimationFrame(applyHistoryWrapHeights);
	};

