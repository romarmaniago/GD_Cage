<div class="modal fade" id="modal-add-cashout" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered cashout-modal-dialog">
		<div class="cashout-modal-cluster">
			<div class="modal-content cashout-main-content">
				<div class="modal-header bg-primary">
					<h5 class="modal-title text-white" id="staticBackdropLiveLabel">CASH-OUT - <span id="cashout-agent-code"></span></h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<form id="add_cashout" class="cashout-main-form">
					<div class="modal-body">
						<input type="hidden" name="game_id" class="game_list_id">
						<input type="hidden" name="txtAccountCode" class="txtAccountCode">
						<input type="hidden" name="txttotal_balance_cashout" id="total_balance_cashout">
						<input type="hidden" name="txtMarkerChipsReturn" id="MarkerChipsReturn">
						<input type="hidden" name="txtTotalRolling" id="TotalRollingCashout">
						<span class="d-none" id="cashout-company-balance-base" aria-hidden="true">0</span>
						<span class="d-none" id="cashout-account-balance-base" aria-hidden="true">0</span>
						<span class="d-none" id="cashout-agent-code-label" aria-hidden="true"></span>
						<span class="d-none" id="cashout-guest-name-label" aria-hidden="true"></span>

						<div class="cashout-input-sheet">
							<div class="cashout-section" id="split-cashout-row">
								<div class="cashout-field-grid">
									<label class="form-label mb-0" for="nnCashAmount">Cash</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-nn-input cashout-cash-input" placeholder="NN Chips" id="nnCashAmount">
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-cash-input" placeholder="CC Chips" id="ccCashAmount">
								</div>
								<div class="cashout-field-grid">
									<label class="form-label mb-0" for="nnDepositAmount">Deposit</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-nn-input cashout-deposit-input" placeholder="NN Chips" id="nnDepositAmount">
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-deposit-input" placeholder="CC Chips" id="ccDepositAmount">
								</div>
								<div class="cashout-field-grid">
									<label class="form-label mb-0" for="nnCreditAmount">Credit</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-nn-input cashout-credit-input" placeholder="NN Chips" id="nnCreditAmount">
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-credit-input" placeholder="CC Chips" id="ccCreditAmount">
								</div>
							</div>

							<div class="cashout-section cashout-section-tips" id="tip-amount-row">
								<div class="cashout-field-grid">
									<label class="form-label mb-0" for="tipRollerNn">Tip (Roller)</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-nn-input cashout-tip-roller-input" placeholder="NN Chips" name="txtTipRollerNn" id="tipRollerNn">
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-tip-roller-input" placeholder="CC Chips" name="txtTipRollerCc" id="tipRollerCc">
								</div>
								<div class="cashout-field-grid">
									<label class="form-label mb-0" for="tipDealerNn">Tip (Dealer)</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-nn-input cashout-tip-dealer-input" placeholder="NN Chips" name="txtTipDealerNn" id="tipDealerNn">
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-tip-dealer-input" placeholder="CC Chips" name="txtTipDealerCc" id="tipDealerCc">
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<button type="submit" class="btn btn-sm btn-primary" id="submit-cashout-btn">Save</button>
						<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Close</button>
					</div>
				</form>
			</div>

			<div class="cashout-side-panels cashout-side-panels-empty" id="cashout-side-panels">
				<div class="cashout-side-resize-handle" id="cashout-side-resize-handle" title="Drag to resize" aria-hidden="true">⇔</div>
				<!-- Cash: two Excel-style boxes — company balance, then the Cash entry -->
				<div class="cashout-side-panel cashout-xl-panel d-none" id="cashout-cash-panel" aria-hidden="true">
					<div class="xl-box">
						<div class="xl-grid xl-grid-2">
							<div class="xl-head">Current Balance of Company</div>
							<div class="xl-head">Anticipated Balance of Company</div>
							<div class="xl-value" id="cashout-cash-current">—</div>
							<div class="xl-value" id="cashout-cash-anticipated">—</div>
						</div>
					</div>
					<div class="xl-box">
						<div class="xl-title">Cash</div>
						<div class="xl-grid xl-grid-1">
							<div class="xl-head">Processing Amount</div>
							<div class="xl-value cashout-processing-body" id="cashout-cash-processing-wrap">
								<span id="cashout-cash-processing">0</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Deposit: one Excel-style box — balances, entry, then the account ledger with running balance -->
				<div class="cashout-side-panel cashout-xl-panel d-none" id="cashout-deposit-panel" aria-hidden="true">
					<div class="xl-box">
						<div class="xl-title">Deposit</div>
						<div class="xl-grid xl-grid-2">
							<div class="xl-head" id="cashout-deposit-current-label">Current Balance of Account</div>
							<div class="xl-head" id="cashout-deposit-anticipated-label">Anticipated Balance of Account</div>
							<div class="xl-value xl-row-sep" id="cashout-deposit-current">—</div>
							<div class="xl-value xl-row-sep" id="cashout-deposit-anticipated">—</div>
							<div class="xl-head">Processing Amount</div>
							<div class="xl-head">Remarks</div>
							<div class="xl-value cashout-processing-body" id="cashout-deposit-processing-wrap">
								<span id="cashout-deposit-processing">0</span>
							</div>
							<div class="xl-value xl-input-cell" id="cashout-remarks-slot">
								<input type="text" class="form-control form-control-sm text-center cashout-deposit-remarks-input" id="cashout-deposit-remarks" name="txtDepositRemarks" placeholder="Remarks" autocomplete="off" form="add_cashout">
							</div>
						</div>
						<div class="cashout-history-wrap xl-history-wrap">
							<table class="xl-history-tbl xl-deposit-tbl cashout-history-tbl">
								<thead>
									<tr>
										<th>Date &amp; Time</th>
										<th>Amount</th>
										<th>Balance</th>
										<th>Transaction</th>
										<th>Remarks</th>
									</tr>
								</thead>
								<tbody id="cashout-history-body">
									<tr class="text-muted">
										<td colspan="5" class="text-center small py-2">No history.</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>

				<!-- Credit: one Excel-style box — balances (+ one column per guest), entry, then the credit ledger -->
				<div class="cashout-side-panel cashout-xl-panel d-none cashout-side-panel-credit" id="cashout-credit-panel" aria-hidden="true">
					<div class="xl-box">
						<div class="xl-title">Credit</div>
						<!-- Columns flow head-over-value; guest columns are added by renderGuestCreditBreakdown() -->
						<div class="xl-grid xl-grid-cols">
							<div class="xl-head" id="cashout-credit-current-label">Current Credit Balance of Account</div>
							<div class="xl-value xl-row-sep" id="cashout-credit-current">—</div>
							<div class="xl-head" id="cashout-credit-anticipated-label">Anticipated Credit Balance of Account</div>
							<div class="xl-value xl-row-sep" id="cashout-credit-anticipated">—</div>
							<div class="xl-contents" id="cashout-credit-guest-cols"></div>
						</div>
						<div class="xl-grid xl-grid-4">
							<div class="xl-head">Processing Amount</div>
							<div class="xl-head">채무자 Debtor</div>
							<div class="xl-head">보증인 Guarantor</div>
							<div class="xl-head">Remarks</div>
							<div class="xl-value cashout-processing-body" id="cashout-credit-processing-wrap">
								<span id="cashout-credit-processing">0</span>
							</div>
							<div class="xl-value xl-debtor-cell" id="cashout-credit-debtor">
								<div id="cashout-credit-debtor-account">—</div>
								<div class="xl-debtor-guest" id="cashout-credit-debtor-guest">—</div>
							</div>
							<div class="xl-value xl-input-cell">
								<input type="text" class="form-control form-control-sm text-center cashout-credit-guarantor-input" id="cashout-credit-guarantor" name="txtCreditGuarantor" placeholder="Guarantor" autocomplete="off" form="add_cashout">
							</div>
							<div class="xl-value xl-input-cell">
								<input type="text" class="form-control form-control-sm text-center cashout-credit-remarks-input" id="cashout-credit-remarks" name="txtCreditRemarks" placeholder="Remarks" autocomplete="off" form="add_cashout">
							</div>
						</div>
						<div class="cashout-history-wrap xl-history-wrap cashout-credit-history-wrap">
							<table class="xl-history-tbl cashout-history-tbl xl-credit-tbl">
								<thead>
									<tr>
										<th>Date &amp; Time</th>
										<th>Account</th>
										<th>Debtor</th>
										<th>Credit</th>
										<th>Balance</th>
										<th>Guarantor</th>
										<th>Transaction</th>
										<th>Remarks</th>
									</tr>
								</thead>
								<tbody id="cashout-credit-history-body">
									<tr class="text-muted">
										<td colspan="8" class="text-center small py-2">No history.</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>

				<div class="cashout-tip-panels-row" id="cashout-tip-panels-row">
					<div class="cashout-side-panel cashout-xl-panel d-none cashout-side-panel-tip-roller" id="cashout-tip-roller-panel" aria-hidden="true">
						<div class="xl-box">
							<div class="xl-title">Tip (Roller)</div>
							<!-- 4 equal columns, so the ledger lines below run straight through -->
							<div class="xl-grid xl-grid-tip">
								<div class="xl-head xl-span-2">Current Balance Of Roller Tip</div>
								<div class="xl-head xl-span-2 xl-last">Anticipated Balance Of Roller Tip</div>
								<div class="xl-value xl-span-2 xl-row-sep" id="cashout-tip-roller-current">—</div>
								<div class="xl-value xl-span-2 xl-row-sep xl-last" id="cashout-tip-roller-anticipated">—</div>
								<div class="xl-head xl-span-2">Processing Amount</div>
								<div class="xl-head">Status</div>
								<div class="xl-head xl-last">Name</div>
								<div class="xl-value xl-span-2 cashout-processing-body" id="cashout-tip-roller-processing-wrap">
									<span id="cashout-tip-roller-processing">0</span>
								</div>
								<div class="xl-value xl-input-cell xl-tip-status">
									<input type="text" class="form-control form-control-sm text-center cashout-tip-meta-input" id="cashout-tip-roller-status" name="txtTipStatus" form="add_cashout" placeholder="Roller / GM" autocomplete="off">
								</div>
								<div class="xl-value xl-input-cell xl-last">
									<input type="text" class="form-control form-control-sm text-center cashout-tip-roller-name-input" id="cashout-tip-roller-name" name="txtTipRollerName" form="add_cashout" placeholder="Name" autocomplete="off">
								</div>
							</div>
							<div class="cashout-history-wrap xl-history-wrap">
								<table class="xl-history-tbl xl-tip-tbl cashout-history-tbl">
									<thead>
										<tr>
											<th>Date &amp; Time</th>
											<th>Amount</th>
											<th>Status</th>
											<th>Name</th>
										</tr>
									</thead>
									<tbody id="cashout-tip-roller-history-body">
										<tr class="text-muted">
											<td colspan="4" class="text-center small py-2">No history.</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>

					<div class="cashout-side-panel cashout-xl-panel d-none cashout-side-panel-tip-dealer" id="cashout-tip-dealer-panel" aria-hidden="true">
						<div class="xl-box">
							<div class="xl-title">Tip (Dealer)</div>
							<!-- 4 equal columns, so the ledger lines below run straight through -->
							<div class="xl-grid xl-grid-tip">
								<div class="xl-head xl-span-2">Current Balance Of Dealer Tip</div>
								<div class="xl-head xl-span-2 xl-last">Anticipated Balance Of Dealer Tip</div>
								<div class="xl-value xl-span-2 xl-row-sep" id="cashout-tip-dealer-current">—</div>
								<div class="xl-value xl-span-2 xl-row-sep xl-last" id="cashout-tip-dealer-anticipated">—</div>
								<div class="xl-head xl-span-2">Processing Amount</div>
								<div class="xl-head">Status</div>
								<div class="xl-head xl-last">Name</div>
								<div class="xl-value xl-span-2 cashout-processing-body" id="cashout-tip-dealer-processing-wrap">
									<span id="cashout-tip-dealer-processing">0</span>
								</div>
								<div class="xl-value xl-input-cell xl-tip-status">
									<input type="text" class="form-control form-control-sm text-center cashout-tip-meta-input" id="cashout-tip-dealer-roller-status" placeholder="Roller / GM" autocomplete="off">
								</div>
								<div class="xl-value xl-input-cell xl-last">
									<input type="text" class="form-control form-control-sm text-center cashout-tip-roller-name-input" id="cashout-tip-dealer-roller-name" placeholder="Name" autocomplete="off">
								</div>
							</div>
							<div class="cashout-history-wrap xl-history-wrap">
								<table class="xl-history-tbl xl-tip-tbl cashout-history-tbl">
									<thead>
										<tr>
											<th>Date &amp; Time</th>
											<th>Amount</th>
											<th>Status</th>
											<th>Name</th>
										</tr>
									</thead>
									<tbody id="cashout-tip-dealer-history-body">
										<tr class="text-muted">
											<td colspan="4" class="text-center small py-2">No history.</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
#modal-add-cashout.show,
#modal-add-cashout.showing {
	display: flex !important;
	align-items: center;
	justify-content: center;
	padding: 0.75rem;
}
#modal-add-cashout .cashout-modal-dialog {
	max-width: calc(100vw - 1.5rem);
	width: max-content;
	margin: 0 auto;
}
#modal-add-cashout .cashout-modal-cluster {
	display: flex;
	align-items: flex-start;
	justify-content: center;
	gap: 0.75rem;
	margin: 0 auto;
}
#modal-add-cashout .cashout-main-content {
	width: 32rem;
	max-width: 100%;
	flex-shrink: 0;
}
#modal-add-cashout .cashout-main-form {
	width: 100%;
	display: flex;
	flex-direction: column;
}
#modal-add-cashout .cashout-main-form .modal-body {
	padding: 0.75rem 1rem;
}
#modal-add-cashout .cashout-main-form .modal-footer {
	padding-left: 1rem;
	padding-right: 1rem;
}
#modal-add-cashout .cashout-input-sheet {
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
}
#modal-add-cashout .cashout-section {
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
}
#modal-add-cashout .cashout-section-tips {
	margin-top: 0.25rem;
	padding-top: 0.5rem;
	border-top: 1px solid #dee2e6;
}
#modal-add-cashout .cashout-field-grid {
	display: grid;
	grid-template-columns: 6.75rem minmax(0, 1fr) minmax(0, 1fr);
	column-gap: 0.5rem;
	align-items: center;
}
#modal-add-cashout .cashout-field-grid .form-control {
	width: 100%;
	min-width: 0;
}
#modal-add-cashout .cashout-field-grid label {
	white-space: nowrap;
	font-weight: 500;
}
#modal-add-cashout .cashout-side-panels {
	display: flex;
	flex-direction: column;
	gap: 0.75rem;
	width: 24rem;
	flex-shrink: 0;
	align-self: flex-start;
	min-height: 0;
	position: relative;
	pointer-events: auto;
}
#modal-add-cashout .cashout-side-panels:has(#cashout-credit-panel:not(.d-none)):not([data-user-sized]),
#modal-add-cashout .cashout-side-panels:has(#cashout-tip-panels-row .cashout-side-panel:not(.d-none)):not([data-user-sized]) {
	width: 50rem;
}
#modal-add-cashout .cashout-tip-panels-row {
	display: flex;
	gap: 0.75rem;
	width: 100%;
	min-width: 0;
}
#modal-add-cashout .cashout-tip-panels-row:not(:has(.cashout-side-panel:not(.d-none))) {
	display: none;
}
#modal-add-cashout .cashout-tip-panels-row .cashout-side-panel {
	flex: 1 1 0;
	min-width: 0;
}
#modal-add-cashout .cashout-tip-roller-name-input,
#modal-add-cashout .cashout-tip-meta-input {
	width: 100%;
	min-width: 0;
	pointer-events: auto;
}
#modal-add-cashout .cashout-tip-history-tbl th {
	background: #f5f5f5;
	color: #555;
	text-transform: uppercase;
	font-size: 0.68rem;
	padding: 0.25rem 0.25rem;
}
#modal-add-cashout .cashout-tip-history-tbl td {
	font-size: 0.68rem;
	padding: 0.2rem 0.25rem;
}
#modal-add-cashout .cashout-tip-history-tbl thead th {
	position: sticky;
	top: 0;
	z-index: 2;
	box-shadow: inset 0 -1px 0 #dee2e6;
}
#modal-add-cashout .cashout-side-panels:not(.cashout-side-panels-empty) {
	max-height: calc(100vh - 4.5rem);
	overflow-y: auto;
	overflow-x: hidden;
	overscroll-behavior: contain;
	scrollbar-gutter: stable;
}
#modal-add-cashout .cashout-side-resize-handle {
	position: absolute;
	right: -0.45rem;
	top: 0;
	bottom: 0;
	width: 0.85rem;
	cursor: ew-resize;
	z-index: 3;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #6c757d;
	font-size: 0.72rem;
	line-height: 1;
	user-select: none;
	touch-action: none;
	border-left: 1px solid #ced4da;
	border-right: 1px solid #ced4da;
	background: linear-gradient(90deg, #f8f9fa 0%, #fff 50%, #f8f9fa 100%);
	border-radius: 0.2rem;
	opacity: 0.85;
}
#modal-add-cashout .cashout-side-resize-handle:hover,
#modal-add-cashout .cashout-side-resize-handle.is-dragging {
	opacity: 1;
	color: #0d6efd;
	border-color: #0d6efd;
	background: #e7f1ff;
}
#modal-add-cashout .cashout-side-panels.cashout-side-panels-empty .cashout-side-resize-handle {
	display: none;
}
body.cashout-side-resize-active {
	cursor: ew-resize !important;
	user-select: none !important;
}
#modal-add-cashout .cashout-side-panel {
	pointer-events: auto;
}
#modal-add-cashout .cashout-side-panels.cashout-side-panels-empty,
#modal-add-cashout .cashout-side-panels:not(:has(.cashout-side-panel:not(.d-none))) {
	display: none;
	width: 0;
	min-width: 0;
	gap: 0;
	overflow: hidden;
}
#modal-add-cashout .cashout-credit-debtor-body {
	flex-direction: column;
	gap: 0.15rem;
}
#modal-add-cashout .cashout-credit-guarantor-input {
	width: 100%;
	min-width: 0;
	pointer-events: auto;
}
/* Excel-style panel (Cash): yellow headers, black grid lines, two separate boxes */
#modal-add-cashout .cashout-xl-panel {
	display: flex;
	flex-direction: column;
	gap: 0.75rem;
	padding: 0.6rem;
}
#modal-add-cashout .cashout-xl-panel.d-none {
	display: none !important;
}
#modal-add-cashout .xl-box {
	border: 3px solid #000; /* Excel "Thick Outside Borders" */
	background: #fff;
}
#modal-add-cashout .xl-title {
	padding: 0.2rem 0.4rem;
	font-size: 0.82rem;
	font-weight: 700;
	color: #000;
	text-align: center;
	background: #ffe699;
	border-bottom: 1px solid #000;
}
#modal-add-cashout .xl-grid {
	display: grid;
}
#modal-add-cashout .xl-grid-4 { grid-template-columns: repeat(4, 1fr); }
#modal-add-cashout .xl-grid-2 { grid-template-columns: 1fr 1fr; }
#modal-add-cashout .xl-head,
#modal-add-cashout .xl-value {
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 0.2rem 0.4rem;
	font-weight: 700;
	color: #000;
	text-align: center;
	border-right: 1px solid #000;
}
#modal-add-cashout .xl-grid-4 > :nth-child(4n),
#modal-add-cashout .xl-grid-2 > :nth-child(2n) {
	border-right: 0;
}
#modal-add-cashout .xl-head {
	font-size: 0.8rem;
	background: #fff2cc;
	
}
/* line between a value row and the header row below it (also matches the guest columns) */
#modal-add-cashout .xl-grid .xl-row-sep {
	border-bottom: 1px solid #000;
}
