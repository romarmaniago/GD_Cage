<script>
document.addEventListener('DOMContentLoaded', function () {
	const modal = document.getElementById('modal-add-cashout');
	if (!modal) return;

	const companyBaseEl = document.getElementById('cashout-company-balance-base');
	const accountBaseEl = document.getElementById('cashout-account-balance-base');
	const agentCodeEl = document.getElementById('cashout-agent-code-label');
	const guestNameEl = document.getElementById('cashout-guest-name-label');

	const cashPanel = document.getElementById('cashout-cash-panel');
	const depositPanel = document.getElementById('cashout-deposit-panel');
	const creditPanel = document.getElementById('cashout-credit-panel');
	const cashCurrentEl = document.getElementById('cashout-cash-current');
	const cashAnticipatedEl = document.getElementById('cashout-cash-anticipated');
	const cashProcessingEl = document.getElementById('cashout-cash-processing');
	const cashProcessingWrap = document.getElementById('cashout-cash-processing-wrap');

	const depositCurrentLabelEl = document.getElementById('cashout-deposit-current-label');
	const depositAnticipatedLabelEl = document.getElementById('cashout-deposit-anticipated-label');
	const depositCurrentEl = document.getElementById('cashout-deposit-current');
	const depositAnticipatedEl = document.getElementById('cashout-deposit-anticipated');
	const depositProcessingEl = document.getElementById('cashout-deposit-processing');
	const depositProcessingWrap = document.getElementById('cashout-deposit-processing-wrap');
	const remarksInput = document.getElementById('cashout-deposit-remarks');
	const creditCurrentLabelEl = document.getElementById('cashout-credit-current-label');
	const creditAnticipatedLabelEl = document.getElementById('cashout-credit-anticipated-label');
	const creditCurrentEl = document.getElementById('cashout-credit-current');
	const creditAnticipatedEl = document.getElementById('cashout-credit-anticipated');
	const creditGuestColsEl = document.getElementById('cashout-credit-guest-cols');
	const creditProcessingEl = document.getElementById('cashout-credit-processing');
	const creditProcessingWrap = document.getElementById('cashout-credit-processing-wrap');
	const creditDebtorAccountEl = document.getElementById('cashout-credit-debtor-account');
	const creditDebtorGuestEl = document.getElementById('cashout-credit-debtor-guest');
	const creditGuarantorInput = document.getElementById('cashout-credit-guarantor');
	const creditRemarksInput = document.getElementById('cashout-credit-remarks');
	const creditHistoryBody = document.getElementById('cashout-credit-history-body');
	const tipRollerPanel = document.getElementById('cashout-tip-roller-panel');
	const tipDealerPanel = document.getElementById('cashout-tip-dealer-panel');
	const tipRollerCurrentEl = document.getElementById('cashout-tip-roller-current');
	const tipRollerAnticipatedEl = document.getElementById('cashout-tip-roller-anticipated');
	const tipRollerProcessingEl = document.getElementById('cashout-tip-roller-processing');
	const tipRollerProcessingWrap = document.getElementById('cashout-tip-roller-processing-wrap');
	const tipRollerNameInput = document.getElementById('cashout-tip-roller-name');
	const tipDealerNameInput = document.getElementById('cashout-tip-dealer-roller-name');
	const tipRollerStatusInput = document.getElementById('cashout-tip-roller-status');
	const tipDealerStatusInput = document.getElementById('cashout-tip-dealer-roller-status');
	const tipRollerHistoryBody = document.getElementById('cashout-tip-roller-history-body');
	const tipDealerCurrentEl = document.getElementById('cashout-tip-dealer-current');
	const tipDealerAnticipatedEl = document.getElementById('cashout-tip-dealer-anticipated');
	const tipDealerProcessingEl = document.getElementById('cashout-tip-dealer-processing');
	const tipDealerProcessingWrap = document.getElementById('cashout-tip-dealer-processing-wrap');
	const tipDealerHistoryBody = document.getElementById('cashout-tip-dealer-history-body');

	const allowCashoutSidePanelFocus = function (e) {
		if (!e.target || !e.target.closest) return;
		if (e.target.closest('#cashout-side-panels')) {
			e.stopImmediatePropagation();
		}
	};

	const releaseCashoutFocusTrap = function () {
		if (window.bootstrap && bootstrap.Modal) {
			const instance = bootstrap.Modal.getInstance(modal) || bootstrap.Modal.getOrCreateInstance(modal, { focus: false });
			if (instance) {
				instance._config.focus = false;
				if (instance._focustrap && typeof instance._focustrap.deactivate === 'function') {
					instance._focustrap.deactivate();
				}
			}
		}
		window.addEventListener('focusin', allowCashoutSidePanelFocus, true);
	};

	const restoreCashoutFocusTrap = function () {
		window.removeEventListener('focusin', allowCashoutSidePanelFocus, true);
	};
	const historyBody = document.getElementById('cashout-history-body');

	let ledgerHistory = [];
	let creditHistory = [];
	let creditMeta = { totalCredit: 0, balanceCredit: 0, balanceBuyin: 0, guestBalances: [], agentCode: '', agentName: '', agencyName: '' };
	let cashEngaged = false;
	let depositEngaged = false;
	let creditEngaged = false;
	let creditGuarantorAutocomplete = null;
	let tipAutocompleteInstances = [];
	let tipRollerEngaged = false;
	let tipDealerEngaged = false;
	let rollerTipHistory = [];
	let dealerTipHistory = [];
	let rollerTipBalance = 0;
	let dealerTipBalance = 0;
	const HISTORY_VISIBLE_ROWS = 5;

	const initCreditGuarantorAutocomplete = function () {
		if (!creditGuarantorInput || !window.CreditGuarantorAutocomplete) return;
		creditGuarantorAutocomplete = window.CreditGuarantorAutocomplete.initCreditGuarantorField(creditGuarantorInput, {
			getHistoryRows: function () { return creditHistory; },
			parseRemarks: parseCreditRemarks
		});
	};

	const initTipAutocompletes = function () {
		var AC = window.CreditGuarantorAutocomplete;
		if (!AC) return;
		tipAutocompleteInstances = [
			AC.initTipFieldAutocomplete(tipRollerNameInput, {
				fieldType: 'name',
				getHistoryRows: function () { return rollerTipHistory; }
			}),
			AC.initTipFieldAutocomplete(tipRollerStatusInput, {
				fieldType: 'status',
				getHistoryRows: function () { return rollerTipHistory; },
				defaults: ['Roller', 'GM']
			}),
			AC.initTipFieldAutocomplete(tipDealerNameInput, {
				fieldType: 'name',
				getHistoryRows: function () { return dealerTipHistory; }
			}),
			AC.initTipFieldAutocomplete(tipDealerStatusInput, {
				fieldType: 'status',
				getHistoryRows: function () { return dealerTipHistory; },
				defaults: ['Roller', 'GM', 'Dealer']
			})
		].filter(Boolean);
	};

	const parseAmt = function (raw) {
		const s = (raw || '').toString().replace(/,/g, '').trim();
		if (!s) return 0;
		const n = Number(s);
		return Number.isFinite(n) ? n : 0;
	};

	const formatAmt = function (n) {
		return Math.round(n).toLocaleString('en-US');
	};

	const formatNegativeAmt = function (n) {
		const abs = Math.round(Math.abs(parseAmt(n)));
		if (!abs) return '0';
		return '(' + formatAmt(abs) + ')';
	};

	const hasRowInput = function (nnId, ccId) {
		const nn = (document.getElementById(nnId) && document.getElementById(nnId).value || '').replace(/,/g, '').trim();
		const cc = (document.getElementById(ccId) && document.getElementById(ccId).value || '').replace(/,/g, '').trim();
		return !!(nn || cc);
	};

	const getAgentCode = function () {
		return (agentCodeEl && agentCodeEl.textContent || '').trim() || 'Account';
	};

	const getGuestName = function () {
		return (guestNameEl && guestNameEl.textContent || '').trim();
	};
	const getTipRollerName = function () {
		return (tipRollerNameInput && tipRollerNameInput.value || '').trim();
	};
	const getTipStatus = function () {
		return (tipRollerStatusInput && tipRollerStatusInput.value || '').trim();
	};

	const getCreditHistoryDebtorParts = function (row) {
		const code = (row && row.AGENT_CODE) || creditMeta.agentCode || getAgentCode();
		const guest = row && row.GUEST_NAME ? String(row.GUEST_NAME).trim() : '';
		return { account: code || '—', guest: guest || '—' };
	};

	const parseCreditRemarks = function (remarks) {
		const raw = String(remarks || '').trim();
		if (!raw) return { remarks: '', guarantor: '' };
		const idx = raw.indexOf('Guarantor:');
		if (idx === -1) return { remarks: raw, guarantor: '' };
		const remarksPart = raw.slice(0, idx).replace(/\|\s*$/, '').trim();
		const guarantor = raw.slice(idx + 'Guarantor:'.length).trim();
		return { remarks: remarksPart, guarantor: guarantor };
	};

	const renderGuestCreditBreakdown = function () {
		if (!creditGuestColsEl) return;
		const guests = Array.isArray(creditMeta.guestBalances) ? creditMeta.guestBalances : [];
		if (!guests.length) {
			creditGuestColsEl.innerHTML = '';
			return;
		}
		// The debtor guest's column already includes the amount being paid back.
		const debtorGuest = String(getGuestName() || '').trim().toUpperCase();
		const pending = shouldShowCreditPanel() ? computeCreditProcessing() : 0;
		let html = '';
		guests.forEach(function (g) {
			const name = (g.guestName || '').trim() || 'Guest';
			let bal = Number(g.creditBalance) || 0;
			if (pending > 0 && debtorGuest && name.toUpperCase() === debtorGuest) bal = Math.max(0, bal - pending);
			if (bal <= 0) return;
			// Head and value are separate grid cells (the wrapper is display: contents).
			html += '<div class="xl-head">' + escapeCell(name.toUpperCase()) + '</div>' +
				'<div class="xl-value xl-row-sep text-amount-negative">' + formatCreditOwed(bal) + '</div>';
		});
		creditGuestColsEl.innerHTML = html;
	};

	const getDebtorLine = function () {
		const code = getAgentCode();
		const guest = getGuestName();
		if (code && guest) return code + ' ' + guest;
		return code || guest || '—';
	};

	const updateDebtorDisplay = function () {
		const code = getAgentCode();
		const guest = getGuestName();
		if (creditDebtorAccountEl) creditDebtorAccountEl.textContent = code || '—';
		if (creditDebtorGuestEl) {
			creditDebtorGuestEl.textContent = guest || '—';
			creditDebtorGuestEl.classList.toggle('d-none', !guest);
		}
	};

	const shouldShowCashPanel = function () {
		return hasRowInput('nnCashAmount', 'ccCashAmount');
	};

	const shouldShowTipRollerPanel = function () {
		return hasRowInput('tipRollerNn', 'tipRollerCc');
	};

	const shouldShowTipDealerPanel = function () {
		return hasRowInput('tipDealerNn', 'tipDealerCc');
	};

	const shouldShowDepositPanel = function () {
		return hasRowInput('nnDepositAmount', 'ccDepositAmount');
	};

	const shouldShowCreditPanel = function () {
		return hasRowInput('nnCreditAmount', 'ccCreditAmount');
	};

	const computeCreditProcessing = function () {
		return (
			parseAmt(document.getElementById('nnCreditAmount') && document.getElementById('nnCreditAmount').value) +
			parseAmt(document.getElementById('ccCreditAmount') && document.getElementById('ccCreditAmount').value)
		);
	};

	const creditAmountClass = function (amount) {
		return parseAmt(amount) > 0 ? 'text-amount-negative' : 'text-amount-positive';
	};

	const formatCreditOwed = function (amount) {
		return formatNegativeAmt(amount);
	};

	const computeCashProcessing = function () {
		const cashLeg =
			parseAmt(document.getElementById('nnCashAmount') && document.getElementById('nnCashAmount').value) +
			parseAmt(document.getElementById('ccCashAmount') && document.getElementById('ccCashAmount').value);
		return -cashLeg;
	};

	const computeTipRollerProcessing = function () {
		return (
			parseAmt(document.getElementById('tipRollerNn') && document.getElementById('tipRollerNn').value) +
			parseAmt(document.getElementById('tipRollerCc') && document.getElementById('tipRollerCc').value)
		);
	};

	const computeTipDealerProcessing = function () {
		return (
			parseAmt(document.getElementById('tipDealerNn') && document.getElementById('tipDealerNn').value) +
			parseAmt(document.getElementById('tipDealerCc') && document.getElementById('tipDealerCc').value)
		);
	};

	const computeDepositProcessing = function () {
		return (
			parseAmt(document.getElementById('nnDepositAmount') && document.getElementById('nnDepositAmount').value) +
			parseAmt(document.getElementById('ccDepositAmount') && document.getElementById('ccDepositAmount').value)
		);
	};

	const setProcessingDisplay = function (el, wrap, processing) {
		if (!el || !wrap) return;
		if (processing < 0) {
			el.textContent = formatNegativeAmt(processing);
		} else {
			el.textContent = formatAmt(processing);
		}
		wrap.classList.toggle('is-negative', processing < 0);
		wrap.classList.toggle('is-positive', processing > 0);
	};

	const togglePanel = function (panel, visible) {
		if (!panel) return;
		panel.classList.toggle('d-none', !visible);
		panel.setAttribute('aria-hidden', visible ? 'false' : 'true');
		syncSidePanelsLayout();
	};

	const applyHistoryWrapHeights = function () {
		modal.querySelectorAll('.cashout-history-wrap').forEach(function (wrap) {
			const tbl = wrap.querySelector('table');
			if (!tbl) return;
			const head = tbl.querySelector('thead');
			const sampleRow = tbl.querySelector('tbody tr:not(.text-muted)');
			const headH = head ? head.getBoundingClientRect().height : 28;
			const rowH = sampleRow ? sampleRow.getBoundingClientRect().height : 26;
			wrap.style.maxHeight = Math.ceil(headH + rowH * HISTORY_VISIBLE_ROWS) + 'px';
		});
	};

	const syncSidePanelsLayout = function () {
		const sidePanels = document.getElementById('cashout-side-panels');
		if (!sidePanels) return;
		const anyVisible =
			(cashPanel && !cashPanel.classList.contains('d-none')) ||
			(depositPanel && !depositPanel.classList.contains('d-none')) ||
			(creditPanel && !creditPanel.classList.contains('d-none')) ||
			(tipRollerPanel && !tipRollerPanel.classList.contains('d-none')) ||
			(tipDealerPanel && !tipDealerPanel.classList.contains('d-none'));
		sidePanels.classList.toggle('cashout-side-panels-empty', !anyVisible);
		applySidePanelsDefaultWidth();
	};

	// Keep the row being entered (last row) in view while typing, without manual scrolling.
	// The ledger runs full width under its scrollbar (like a sheet), so its column lines meet the rows above.
	const syncLedgerGutter = function (body) {
		const wrap = body && body.closest('.xl-history-wrap');
		if (!wrap) return;
		wrap.style.setProperty('--xl-sb', Math.max(0, wrap.offsetWidth - wrap.clientWidth) + 'px');
	};

	const revealPendingRow = function (body) {
		syncLedgerGutter(body);
		const row = body && body.querySelector('tr.is-pending');
		if (!row) return;
		const wrap = row.closest('.cashout-history-wrap');
		if (wrap) wrap.scrollTop = wrap.scrollHeight;
		row.scrollIntoView({ block: 'nearest' });
	};

	const applySidePanelsDefaultWidth = function () {
		const sidePanels = document.getElementById('cashout-side-panels');
		if (!sidePanels || sidePanels.dataset.userSized === '1') return;
		const creditOpen = creditPanel && !creditPanel.classList.contains('d-none');
		const tipsOpen =
			(tipRollerPanel && !tipRollerPanel.classList.contains('d-none')) ||
			(tipDealerPanel && !tipDealerPanel.classList.contains('d-none'));
		sidePanels.style.width = (creditOpen || tipsOpen) ? '50rem' : '30rem';
	};

	const resetSidePanelsWidth = function () {
		const sidePanels = document.getElementById('cashout-side-panels');
		if (!sidePanels) return;
		delete sidePanels.dataset.userSized;
		sidePanels.style.width = '';
	};

	const wireSidePanelsResize = function () {
		const sidePanels = document.getElementById('cashout-side-panels');
		const resizeHandle = document.getElementById('cashout-side-resize-handle');
		const cluster = modal.querySelector('.cashout-modal-cluster');
		if (!sidePanels || !resizeHandle || !cluster) return;

		const minWidth = 18 * 16;
		let dragging = false;
		let startX = 0;
		let startWidth = 0;

		const getMaxWidth = function () {
			const clusterRect = cluster.getBoundingClientRect();
			const mainContent = modal.querySelector('.cashout-main-content');
			const mainWidth = mainContent ? mainContent.getBoundingClientRect().width : 512;
			const gap = 12;
			const padding = 24;
			return Math.max(minWidth, window.innerWidth - padding - mainWidth - gap - 32);
		};

		const onMove = function (e) {
			if (!dragging) return;
			const nextWidth = Math.min(getMaxWidth(), Math.max(minWidth, startWidth + (e.clientX - startX)));
			sidePanels.style.width = nextWidth + 'px';
		};

		const onStop = function () {
			if (!dragging) return;
			dragging = false;
			resizeHandle.classList.remove('is-dragging');
			document.body.classList.remove('cashout-side-resize-active');
			window.removeEventListener('mousemove', onMove);
			window.removeEventListener('mouseup', onStop);
		};

		resizeHandle.addEventListener('mousedown', function (e) {
			if (sidePanels.classList.contains('cashout-side-panels-empty')) return;
			e.preventDefault();
			e.stopPropagation();
			dragging = true;
			startX = e.clientX;
			startWidth = sidePanels.getBoundingClientRect().width;
			sidePanels.dataset.userSized = '1';
			resizeHandle.classList.add('is-dragging');
			document.body.classList.add('cashout-side-resize-active');
			window.addEventListener('mousemove', onMove);
			window.addEventListener('mouseup', onStop);
		});
	};

	const formatHistoryDate = function (raw) {
		if (!raw) return '—';
		const d = new Date(raw);
		if (Number.isNaN(d.getTime())) return String(raw);
		return (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
	};

	const isNegativeLedgerTxn = function (txnName) {
		return (txnName || '').toUpperCase().indexOf('WITHDRAW') !== -1;
	};

	// "2026-10-4 0:16"
	const formatLedgerDateTime = function (raw) {
		const d = raw instanceof Date ? raw : new Date(raw);
		if (!raw || Number.isNaN(d.getTime())) return '—';
		return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate() + ' ' +
			d.getHours() + ':' + String(d.getMinutes()).padStart(2, '0');
	};

	const escapeCell = function (value) {
		return String(value == null ? '' : value)
			.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
	};

	// Signed effect on the account balance — same rule as the balance total in loadLedgerHistory.
	const ledgerSignedAmount = function (row) {
		const amount = parseAmt(row.AMOUNT);
		const txn = String(row.TRANSACTION || '').toUpperCase();
		if (txn === 'DEPOSIT' || txn === 'MARKER REDEEM') return amount;
		if (txn === 'WITHDRAW' || txn === 'IOU RETURN DEPOSIT') return -amount;
		return 0;
	};

	// Same TRANSACTION text as the Agent Portal ledger (from AUTO_REMARKS).
	const ledgerTransactionText = function (row) {
		if (typeof window.formatAgentPortalTransactionText === 'function' && row.AUTO_REMARKS) {
			return window.formatAgentPortalTransactionText(row.AUTO_REMARKS);
		}
		return String(row.AUTO_REMARKS || row.TRANSACTION || row.TRANSACTION_DESC || '—').toUpperCase();
	};

	const formatSignedAmt = function (n) {
		return n < 0 ? formatNegativeAmt(Math.abs(n)) : formatAmt(n);
	};

	// Amount / Balance digits line up whether or not the value is in "( )". Started on first render:
	// the shared helper (footer script) loads after this modal's script.
	let depositDigitsAligned = false;
	const alignDepositDigits = function () {
		if (depositDigitsAligned || !window.gdAlignParenNumbers) return;
		depositDigitsAligned = true;
		window.gdAlignParenNumbers('#cashout-history-body', ['td:nth-child(2)', 'td:nth-child(3)']);
	};

	const currentGameId = function () {
		const el = modal && modal.querySelector('.game_list_id');
		return el ? String(el.value || '').trim() : '';
	};

	// Oldest at the top, newest (and the row being entered) at the bottom, with a running balance.
	// Cash Out puts the chips INTO the deposit.
	const renderHistoryTable = function (pendingAmount, pendingRemarks, currentBalance) {
		if (!historyBody) return;
		alignDepositDigits();
		let html = '';
		const rows = ledgerHistory.slice().sort(function (a, b) {
			return (Number(a.account_details_id || a.IDNo) || 0) - (Number(b.account_details_id || b.IDNo) || 0);
		});
		let balance = 0;
		rows.forEach(function (row) {
			const signed = ledgerSignedAmount(row);
			balance += signed;
			html += '<tr>' +
				'<td>' + formatLedgerDateTime(row.encoded_date || row.ENCODED_DT) + '</td>' +
				'<td class="text-end' + (signed < 0 ? ' text-amount-negative' : '') + '">' + formatSignedAmt(signed || parseAmt(row.AMOUNT)) + '</td>' +
				'<td class="text-end' + (balance < 0 ? ' text-amount-negative' : '') + '">' + formatSignedAmt(balance) + '</td>' +
				'<td>' + escapeCell(ledgerTransactionText(row)) + '</td>' +
				'<td>' + escapeCell(row.REMARKS || '—') + '</td>' +
				'</tr>';
		});
		if (pendingAmount > 0) {
			const gameId = currentGameId();
			const after = parseAmt(currentBalance) + pendingAmount;
			html += '<tr class="is-pending">' +
				'<td>' + formatLedgerDateTime(new Date()) + '</td>' +
				'<td class="text-end">' + formatAmt(pendingAmount) + '</td>' +
				'<td class="text-end' + (after < 0 ? ' text-amount-negative' : '') + '">' + formatSignedAmt(after) + '</td>' +
				'<td>DEPOSIT - CHIPS' + (gameId ? ' #' + escapeCell(gameId) : '') + '</td>' +
				'<td>' + escapeCell(pendingRemarks || '') + '</td>' +
				'</tr>';
		}
		if (!html) {
			html = '<tr class="text-muted"><td colspan="5" class="text-center small py-2">No history.</td></tr>';
		}
		historyBody.innerHTML = html;
		requestAnimationFrame(function () {
			applyHistoryWrapHeights();
			revealPendingRow(historyBody);
		});
	};

	let tipDigitsAligned = false;
	const alignTipDigits = function () {
		if (tipDigitsAligned || !window.gdAlignParenNumbers) return;
		tipDigitsAligned = true;
		window.gdAlignParenNumbers('#cashout-tip-panels-row', ['tbody td:nth-child(2)']);
	};

	const renderTipHistoryTable = function (bodyEl, rows, pendingAmount, pendingStatus, pendingName, pendingTransaction) {
		if (!bodyEl) return;
		alignTipDigits();
		let html = '';

		rows.forEach(function (row) {
			const amount = parseAmt(row.AMOUNT);
			const amtClass = amount < 0 ? 'text-end text-amount-negative' : 'text-end';
			const displayAmt = amount < 0 ? formatNegativeAmt(amount) : formatAmt(amount);
			html += '<tr>' +
				'<td>' + formatLedgerDateTime(row.ENCODED_DT) + '</td>' +
				'<td class="' + amtClass + '">' + displayAmt + '</td>' +
				'<td>' + escapeCell(row.STATUS || '—') + '</td>' +
				'<td>' + escapeCell(row.PERSON_NAME || '—') + '</td>' +
				'</tr>';
		});

		if (pendingAmount > 0) {
			html += '<tr class="is-pending">' +
				'<td>' + formatLedgerDateTime(new Date()) + '</td>' +
				'<td class="text-end">' + formatAmt(pendingAmount) + '</td>' +
				'<td>' + escapeCell(pendingStatus || 'Roller') + '</td>' +
				'<td>' + escapeCell(pendingName || '—') + '</td>' +
				'</tr>';
		}

		if (!html) {
			html = '<tr class="text-muted"><td colspan="4" class="text-center small py-2">No history.</td></tr>';
		}

		bodyEl.innerHTML = html;
		requestAnimationFrame(function () {
			applyHistoryWrapHeights();
			revealPendingRow(bodyEl);
		});
	};

	const updateTipRollerPanel = function () {
		const show = tipRollerEngaged || shouldShowTipRollerPanel();
		if (!show) {
			togglePanel(tipRollerPanel, false);
			return;
		}

		const base = parseAmt(rollerTipBalance);
		const processing = computeTipRollerProcessing();
		const hasInput = shouldShowTipRollerPanel();
		const rollerName = getTipRollerName() || '—';
		const tipStatus = getTipStatus() || '—';

		if (tipRollerCurrentEl) tipRollerCurrentEl.textContent = formatAmt(base);
		if (tipRollerAnticipatedEl) tipRollerAnticipatedEl.textContent = hasInput ? formatAmt(base + processing) : '—';
		setProcessingDisplay(tipRollerProcessingEl, tipRollerProcessingWrap, hasInput ? processing : 0);

		renderTipHistoryTable(
			tipRollerHistoryBody,
			rollerTipHistory,
			hasInput ? processing : 0,
			tipStatus,
			rollerName,
			'Roller Tip'
		);
		togglePanel(tipRollerPanel, true);
	};

	const updateTipDealerPanel = function () {
		const show = tipDealerEngaged || shouldShowTipDealerPanel();
		if (!show) {
			togglePanel(tipDealerPanel, false);
			return;
		}

		const base = parseAmt(dealerTipBalance);
		const processing = computeTipDealerProcessing();
		const hasInput = shouldShowTipDealerPanel();
		const rollerName = getTipRollerName() || '—';
		const tipStatus = getTipStatus() || '—';

		if (tipDealerCurrentEl) tipDealerCurrentEl.textContent = formatAmt(base);
		if (tipDealerAnticipatedEl) tipDealerAnticipatedEl.textContent = hasInput ? formatAmt(base + processing) : '—';
		setProcessingDisplay(tipDealerProcessingEl, tipDealerProcessingWrap, hasInput ? processing : 0);

		renderTipHistoryTable(
			tipDealerHistoryBody,
			dealerTipHistory,
			hasInput ? processing : 0,
			tipStatus,
			rollerName,
			'Dealer Tip'
		);
		togglePanel(tipDealerPanel, true);
	};

	const getCreditReturnSourceLabel = function (desc) {
		const normalized = String(desc || '').trim().toUpperCase();
		if (normalized === 'RETURN_SOURCE:CREDIT') return 'Junket Credit';
		if (normalized === 'RETURN_SOURCE:BUYIN') return 'Game Credit';
		return '';
	};

	const renderCreditTransactionLabel = function (row) {
		const info = row.TRANSACTION_INFO || '';
		const parts = String(info).split('-');
		const transactionId = parseInt(parts[0], 10);
		const transactionType = parseInt(parts[1], 10);
		const sourceLabel = getCreditReturnSourceLabel(row.TRANSACTION_DESC);
		switch (transactionId) {
			case 3: return 'Cash Credit';
			case 10: return 'Chips Credit';
			case 11: return sourceLabel ? (sourceLabel + ' Returned thru Cash') : 'Credit Returned thru Cash';
			case 12: return sourceLabel ? (sourceLabel + ' Returned thru Deposit') : 'Credit Returned thru Deposit';
			default:
				return transactionType === 4 ? 'Cash-in' : 'Credit';
		}
	};

	const isCreditOutTxn = function (row) {
		const info = row && row.TRANSACTION_INFO;
		if (!info) return false;
		const transactionId = parseInt(String(info).split('-')[0], 10);
		return transactionId === 3 || transactionId === 10;
	};

	// Transaction column text, Excel style: "Buy In - #100000", "Withdrawal - Cash", ...
	const creditLedgerTransactionText = function (row) {
		switch (row.CREDIT_ACTION) {
			case 'Buy-in': return 'Buy In' + (row.GAME_ID ? ' - #' + row.GAME_ID : '');
			case 'Cash-out': return 'Withdrawal - Cash';
			default: return renderCreditTransactionLabel(row);
		}
	};

	let creditDigitsAligned = false;
	const alignCreditDigits = function () {
		if (creditDigitsAligned || !window.gdAlignParenNumbers) return;
		creditDigitsAligned = true;
		window.gdAlignParenNumbers('#cashout-credit-history-body', ['td:nth-child(4)', 'td:nth-child(5)']);
	};

	const creditLedgerRow = function (cls, dt, account, guest, amountHtml, amountNegative, balance, guarantor, txn, remarks) {
		return '<tr' + (cls ? ' class="' + cls + '"' : '') + '>' +
			'<td>' + formatLedgerDateTime(dt) + '</td>' +
			'<td class="text-center">' + escapeCell(account || '—') + '</td>' +
			'<td class="xl-debtor-name">' + escapeCell(guest || '—') + '</td>' +
			'<td class="text-end' + (amountNegative ? ' text-amount-negative' : '') + '">' + amountHtml + '</td>' +
			'<td class="text-end ' + creditAmountClass(balance) + '">' + formatCreditOwed(balance) + '</td>' +
			'<td class="text-center">' + escapeCell(guarantor || '—') + '</td>' +
			'<td>' + escapeCell(txn) + '</td>' +
			'<td>' + escapeCell(remarks || '') + '</td>' +
			'</tr>';
	};

	// Oldest at the top, newest (and the row being entered) at the bottom.
	const renderCreditHistoryTable = function (pendingAmount, pendingRemarks, pendingGuarantor) {
		if (!creditHistoryBody) return;
		alignCreditDigits();
		const rows = creditHistory.slice().sort(function (a, b) {
			const ta = new Date(a.ENCODED_DT || a.encoded_date).getTime() || 0;
			const tb = new Date(b.ENCODED_DT || b.encoded_date).getTime() || 0;
			return ta - tb || (Number(a.CREDIT_TXN_ID) || 0) - (Number(b.CREDIT_TXN_ID) || 0);
		});
		let html = '';

		rows.forEach(function (row) {
			const amount = parseAmt(row.AMOUNT);
			const isOut = isCreditOutTxn(row);
			const debtor = getCreditHistoryDebtorParts(row);
			const parsed = parseCreditRemarks(row.REMARKS);
			html += creditLedgerRow('', row.ENCODED_DT || row.encoded_date, debtor.account, debtor.guest,
				isOut ? formatNegativeAmt(amount) : formatAmt(amount), isOut,
				parseAmt(row.BALANCE_AFTER), row.GUARANTOR || parsed.guarantor,
				creditLedgerTransactionText(row), parsed.remarks);
		});

		// Cash Out pays the credit back with chips.
		if (pendingAmount > 0) {
			const pendingBalance = parseAmt(creditMeta.totalCredit) - pendingAmount;
			const gameId = currentGameId();
			html += creditLedgerRow('is-pending', new Date(), getAgentCode(), getGuestName(),
				formatAmt(pendingAmount), false, pendingBalance, pendingGuarantor,
				'Chips Return' + (gameId ? ' - #' + gameId : ''), pendingRemarks);
		}

		if (!html) {
			html = '<tr class="text-muted"><td colspan="8" class="text-center small py-2">No history.</td></tr>';
		}

		creditHistoryBody.innerHTML = html;
		requestAnimationFrame(function () {
			applyHistoryWrapHeights();
			revealPendingRow(creditHistoryBody);
		});
	};

	const updateCreditPanel = function () {
		const show = creditEngaged || shouldShowCreditPanel();
		if (!show) {
			togglePanel(creditPanel, false);
			return;
		}

		const code = getAgentCode();
		const base = parseAmt(creditMeta.totalCredit);
		const processing = computeCreditProcessing();
		const hasInput = shouldShowCreditPanel();
		const anticipated = base - processing;
		const pendingRemarks = creditRemarksInput ? creditRemarksInput.value.trim() : '';
		const pendingGuarantor = creditGuarantorInput ? creditGuarantorInput.value.trim() : '';

		if (creditCurrentLabelEl) creditCurrentLabelEl.textContent = 'Current Credit Balance of ' + code;
		if (creditAnticipatedLabelEl) creditAnticipatedLabelEl.textContent = 'Anticipated Credit Balance of ' + code;
		if (creditCurrentEl) {
			creditCurrentEl.textContent = formatCreditOwed(base);
			creditCurrentEl.classList.remove('text-amount-negative', 'text-amount-positive');
			creditCurrentEl.classList.add(creditAmountClass(base));
		}
		if (creditAnticipatedEl) {
			creditAnticipatedEl.textContent = hasInput ? formatCreditOwed(anticipated) : '—';
			creditAnticipatedEl.classList.remove('text-amount-negative', 'text-amount-positive');
			if (hasInput) creditAnticipatedEl.classList.add(creditAmountClass(anticipated));
		}
		renderGuestCreditBreakdown();
		setProcessingDisplay(creditProcessingEl, creditProcessingWrap, hasInput ? processing : 0);
		updateDebtorDisplay();

		renderCreditHistoryTable(hasInput ? processing : 0, pendingRemarks, pendingGuarantor);
		togglePanel(creditPanel, true);
	};

	const updateCashPanel = function () {
		const show = cashEngaged || shouldShowCashPanel();
		if (!show) {
			togglePanel(cashPanel, false);
			return;
		}

		togglePanel(cashPanel, true);
		const base = parseAmt(companyBaseEl && companyBaseEl.textContent);
		const processing = computeCashProcessing();
		const hasInput = shouldShowCashPanel();

		if (cashCurrentEl) cashCurrentEl.textContent = formatAmt(base);
		if (cashAnticipatedEl) cashAnticipatedEl.textContent = hasInput ? formatAmt(base + processing) : '—';
		setProcessingDisplay(cashProcessingEl, cashProcessingWrap, hasInput ? processing : 0);
	};

	const updateDepositPanel = function () {
		const show = depositEngaged || shouldShowDepositPanel();
		if (!show) {
			togglePanel(depositPanel, false);
			return;
		}

		const code = getAgentCode();
		const base = parseAmt(accountBaseEl && accountBaseEl.textContent);
		const processing = computeDepositProcessing();
		const hasInput = shouldShowDepositPanel();
		const anticipated = base + processing;
		const pendingRemarks = remarksInput ? remarksInput.value.trim() : '';

		if (depositCurrentLabelEl) depositCurrentLabelEl.textContent = 'Current Balance of ' + code;
		if (depositAnticipatedLabelEl) depositAnticipatedLabelEl.textContent = 'Anticipated Balance of ' + code;
		if (depositCurrentEl) depositCurrentEl.textContent = formatAmt(base);
		if (depositAnticipatedEl) depositAnticipatedEl.textContent = hasInput ? formatAmt(anticipated) : '—';
		setProcessingDisplay(depositProcessingEl, depositProcessingWrap, hasInput ? processing : 0);
		renderHistoryTable(hasInput ? processing : 0, pendingRemarks, base);
		togglePanel(depositPanel, true);
	};

	const updateBalanceSummary = function () {
		updateCashPanel();
		updateDepositPanel();
		updateCreditPanel();
		updateTipRollerPanel();
		updateTipDealerPanel();
	};

	const resetBalanceDisplay = function () {
		cashEngaged = false;
		depositEngaged = false;
		creditEngaged = false;
		tipRollerEngaged = false;
		tipDealerEngaged = false;
		resetSidePanelsWidth();
		togglePanel(cashPanel, false);
		togglePanel(depositPanel, false);
		togglePanel(creditPanel, false);
		togglePanel(tipRollerPanel, false);
		togglePanel(tipDealerPanel, false);
		if (remarksInput) remarksInput.value = '';
		if (creditRemarksInput) creditRemarksInput.value = '';
		if (creditGuarantorInput) creditGuarantorInput.value = '';
		if (tipRollerNameInput) tipRollerNameInput.value = '';
		if (tipDealerNameInput) tipDealerNameInput.value = '';
		if (tipRollerStatusInput) tipRollerStatusInput.value = '';
		if (tipDealerStatusInput) tipDealerStatusInput.value = '';
		creditHistory = [];
		rollerTipHistory = [];
		dealerTipHistory = [];
		rollerTipBalance = 0;
		dealerTipBalance = 0;
		creditMeta = { totalCredit: 0, balanceCredit: 0, balanceBuyin: 0, guestBalances: [], agentCode: '', agentName: '', agencyName: '' };
		if (creditGuestColsEl) creditGuestColsEl.innerHTML = '';
		if (historyBody) {
			historyBody.innerHTML = '<tr class="text-muted"><td colspan="4" class="text-center small py-2">No history.</td></tr>';
		}
		if (creditHistoryBody) {
			creditHistoryBody.innerHTML = '<tr class="text-muted"><td colspan="8" class="text-center small py-2">No history.</td></tr>';
		}
		if (tipRollerHistoryBody) {
			tipRollerHistoryBody.innerHTML = '<tr class="text-muted"><td colspan="5" class="text-center small py-2">No history.</td></tr>';
		}
		if (tipDealerHistoryBody) {
			tipDealerHistoryBody.innerHTML = '<tr class="text-muted"><td colspan="5" class="text-center small py-2">No history.</td></tr>';
		}
	};

	const loadCompanyBalance = function () {
		return fetch('/game_list_company_balance', { credentials: 'same-origin' })
			.then(function (r) {
				if (!r.ok) throw new Error('bad status');
				return r.json();
			})
			.then(function (data) {
				// Mirror the dashboard PHP figure (Balance Total - NN - CC - RC) so the
				// cashout company-balance base reconciles with the Cage Balance card.
				const cash = Number(data && (data.php_display != null ? data.php_display : data.cashBalance)) || 0;
				if (companyBaseEl) companyBaseEl.textContent = String(cash);
			})
			.catch(function () {
				if (companyBaseEl) companyBaseEl.textContent = '0';
			});
	};

	const loadAccountBalance = function () {
		const accountInput = modal.querySelector('.txtAccountCode');
		const accountId = accountInput ? accountInput.value : '';
		if (!accountId) {
			if (accountBaseEl) accountBaseEl.textContent = '0';
			ledgerHistory = [];
			return Promise.resolve();
		}

		return fetch('/account_details_data_deposit/' + encodeURIComponent(accountId), { credentials: 'same-origin' })
			.then(function (r) {
				if (!r.ok) throw new Error('bad status');
				return r.json();
			})
			.then(function (data) {
				ledgerHistory = Array.isArray(data) ? data : [];
				let depositAmount = 0;
				let withdrawAmount = 0;
				let markerReturn = 0;
				let markerDepositAmount = 0;

				ledgerHistory.forEach(function (row) {
					const amount = parseAmt(row.AMOUNT);
					const txn = row.TRANSACTION || '';
					if (txn === 'DEPOSIT') depositAmount += amount;
					else if (txn === 'WITHDRAW') withdrawAmount += amount;
					else if (txn === 'IOU RETURN DEPOSIT') markerReturn += amount;
					else if (txn === 'MARKER REDEEM') markerDepositAmount += amount;
				});

				if (accountBaseEl) {
					accountBaseEl.textContent = String(depositAmount + markerDepositAmount - withdrawAmount - markerReturn);
				}
			})
			.catch(function () {
				ledgerHistory = [];
				if (accountBaseEl) accountBaseEl.textContent = '0';
			});
	};

	const loadCreditContext = function () {
		const accountInput = modal.querySelector('.txtAccountCode');
		const accountId = accountInput ? accountInput.value : '';
		if (!accountId) {
			creditHistory = [];
			creditMeta = { totalCredit: 0, balanceCredit: 0, balanceBuyin: 0, guestBalances: [], agentCode: '', agentName: '', agencyName: '' };
			if (creditGuestColsEl) creditGuestColsEl.innerHTML = '';
			return Promise.resolve();
		}

		return fetch('/game_list_cashout_credit/' + encodeURIComponent(accountId), { credentials: 'same-origin' })
			.then(function (r) {
				if (!r.ok) throw new Error('bad status');
				return r.json();
			})
			.then(function (data) {
				creditMeta = {
					totalCredit: Number(data && data.totalCredit) || 0,
					balanceCredit: Number(data && data.balanceCredit) || 0,
					balanceBuyin: Number(data && data.balanceBuyin) || 0,
					guestBalances: Array.isArray(data && data.guestBalances) ? data.guestBalances : [],
					agentCode: (data && data.agentCode) || '',
					agentName: (data && data.agentName) || '',
					agencyName: (data && data.agencyName) || ''
				};
				creditHistory = Array.isArray(data && data.history) ? data.history : [];
				initCreditGuarantorAutocomplete();
			})
			.catch(function () {
				creditHistory = [];
				creditMeta = { totalCredit: 0, balanceCredit: 0, balanceBuyin: 0, guestBalances: [], agentCode: '', agentName: '', agencyName: '' };
				if (creditGuestColsEl) creditGuestColsEl.innerHTML = '';
				initCreditGuarantorAutocomplete();
			});
	};

	const loadTipContext = function () {
		const accountInput = modal.querySelector('.txtAccountCode');
		const accountId = accountInput ? accountInput.value : '';
		if (!accountId) {
			rollerTipHistory = [];
			dealerTipHistory = [];
			rollerTipBalance = 0;
			dealerTipBalance = 0;
			return Promise.resolve();
		}

		return fetch('/game_list_cashout_tips/' + encodeURIComponent(accountId), { credentials: 'same-origin' })
			.then(function (r) {
				if (!r.ok) throw new Error('bad status');
				return r.json();
			})
			.then(function (data) {
				rollerTipBalance = Number(data && data.rollerBalance) || 0;
				dealerTipBalance = Number(data && data.dealerBalance) || 0;
				rollerTipHistory = Array.isArray(data && data.rollerHistory) ? data.rollerHistory : [];
				dealerTipHistory = Array.isArray(data && data.dealerHistory) ? data.dealerHistory : [];
				initTipAutocompletes();
				if (window.CreditGuarantorAutocomplete) {
					window.CreditGuarantorAutocomplete.refreshGroup(tipAutocompleteInstances);
				}
			})
			.catch(function () {
				rollerTipHistory = [];
				dealerTipHistory = [];
				rollerTipBalance = 0;
				dealerTipBalance = 0;
				initTipAutocompletes();
			});
	};

	const loadModalBalances = function () {
		resetBalanceDisplay();
		return Promise.all([
			loadCompanyBalance(),
			loadAccountBalance(),
			loadCreditContext(),
			loadTipContext()
		]).then(updateBalanceSummary);
	};

	const validateNnSplitInput = function (inputEl) {
		if (!inputEl) return;
		const raw = (inputEl.value || '').toString().replace(/,/g, '').trim();
		if (!raw) {
			inputEl.classList.remove('is-invalid');
			return;
		}
		const value = Number(raw);
		if (!Number.isFinite(value) || value < 0 || (value > 0 && value % 1000 !== 0)) {
			inputEl.classList.add('is-invalid');
		} else {
			inputEl.classList.remove('is-invalid');
		}
	};

	const isDepositGroupFocused = function (activeEl) {
		if (!activeEl) return false;
		if (remarksInput && activeEl === remarksInput) return true;
		return activeEl.classList && activeEl.classList.contains('cashout-deposit-input');
	};

	const isCreditGroupFocused = function (activeEl) {
		if (!activeEl) return false;
		if (creditRemarksInput && activeEl === creditRemarksInput) return true;
		if (creditGuarantorInput && activeEl === creditGuarantorInput) return true;
		return activeEl.classList && activeEl.classList.contains('cashout-credit-input');
	};

	const isTipRollerGroupFocused = function (activeEl) {
		if (!activeEl) return false;
		if (tipRollerNameInput && activeEl === tipRollerNameInput) return true;
		if (tipDealerNameInput && activeEl === tipDealerNameInput) return true;
		if (tipRollerStatusInput && activeEl === tipRollerStatusInput) return true;
		if (tipDealerStatusInput && activeEl === tipDealerStatusInput) return true;
		return activeEl.classList && activeEl.classList.contains('cashout-tip-roller-input');
	};

	const isTipDealerGroupFocused = function (activeEl) {
		if (!activeEl) return false;
		if (tipDealerNameInput && activeEl === tipDealerNameInput) return true;
		if (tipDealerStatusInput && activeEl === tipDealerStatusInput) return true;
		return activeEl.classList && activeEl.classList.contains('cashout-tip-dealer-input');
	};

	const syncTipField = function (sourceEl, targetEl) {
		if (!sourceEl || !targetEl || targetEl.value === sourceEl.value) return;
		targetEl.value = sourceEl.value;
	};

	const wireTipMetaField = function (inputEl, panelType, fieldType) {
		if (!inputEl) return;
		inputEl.removeAttribute('readonly');
		inputEl.removeAttribute('disabled');
		inputEl.addEventListener('mousedown', function (e) {
			e.stopPropagation();
		});
		inputEl.addEventListener('focus', function () {
			if (panelType === 'roller') {
				tipRollerEngaged = true;
				if (tipRollerPanel && tipRollerPanel.classList.contains('d-none')) {
					updateTipRollerPanel();
				}
			} else {
				tipDealerEngaged = true;
				if (tipDealerPanel && tipDealerPanel.classList.contains('d-none')) {
					updateTipDealerPanel();
				}
			}
		});
		inputEl.addEventListener('input', function () {
			if (fieldType === 'name') {
				if (panelType === 'roller') {
					syncTipField(tipRollerNameInput, tipDealerNameInput);
				} else {
					syncTipField(tipDealerNameInput, tipRollerNameInput);
				}
			} else {
				if (panelType === 'roller') {
					syncTipField(tipRollerStatusInput, tipDealerStatusInput);
				} else {
					syncTipField(tipDealerStatusInput, tipRollerStatusInput);
				}
			}
			updateBalanceSummary();
		});
		inputEl.addEventListener('blur', function () {
			setTimeout(function () {
				const active = document.activeElement;
				if (panelType === 'roller') {
					if (isTipRollerGroupFocused(active)) return;
					if (!shouldShowTipRollerPanel()) {
						tipRollerEngaged = false;
						updateBalanceSummary();
					}
				} else {
					if (isTipDealerGroupFocused(active) || isTipRollerGroupFocused(active)) return;
					if (!shouldShowTipDealerPanel()) {
						tipDealerEngaged = false;
						updateBalanceSummary();
					}
				}
			}, 0);
		});
	};

	const wireTipRollerSideField = function (inputEl, fieldType) {
		wireTipMetaField(inputEl, 'roller', fieldType);
	};

	const wireCreditSideField = function (inputEl) {
		if (!inputEl) return;
		inputEl.removeAttribute('readonly');
		inputEl.removeAttribute('disabled');
		inputEl.addEventListener('mousedown', function (e) {
			e.stopPropagation();
		});
		inputEl.addEventListener('focus', function () {
			creditEngaged = true;
			if (creditPanel && creditPanel.classList.contains('d-none')) {
				updateCreditPanel();
			}
		});
		inputEl.addEventListener('input', function () {
			updateCreditPanel();
		});
		inputEl.addEventListener('blur', function () {
			setTimeout(function () {
				if (isCreditGroupFocused(document.activeElement)) return;
				if (!shouldShowCreditPanel()) {
					creditEngaged = false;
					updateBalanceSummary();
				}
			}, 0);
		});
	};

	const wirePanelInputs = function (selector, type) {
		const inputs = modal.querySelectorAll(selector);
		const hasInputFn = type === 'cash'
			? shouldShowCashPanel
			: (type === 'deposit'
				? shouldShowDepositPanel
				: (type === 'credit'
					? shouldShowCreditPanel
					: (type === 'tipRoller' ? shouldShowTipRollerPanel : shouldShowTipDealerPanel)));

		inputs.forEach(function (inputEl) {
			inputEl.addEventListener('focus', function () {
				if (type === 'cash') cashEngaged = true;
				else if (type === 'deposit') depositEngaged = true;
				else if (type === 'credit') creditEngaged = true;
				else if (type === 'tipRoller') tipRollerEngaged = true;
				else tipDealerEngaged = true;
				updateBalanceSummary();
			});

			inputEl.addEventListener('input', function () {
				if (type === 'credit') {
					const totalOwed = parseAmt(creditMeta.totalCredit);
					const processing = computeCreditProcessing();
					if (processing > 0 && processing > totalOwed) {
						Swal.fire({
							icon: 'error',
							title: 'Insufficient Balance',
							text: 'Credit return exceeds the current credit balance of ' + formatAmt(totalOwed) + '.',
							confirmButtonColor: '#3a57e8'
						});
						inputEl.value = '';
						updateBalanceSummary();
						inputEl.focus();
						return;
					}
				}
				updateBalanceSummary();
			});

			inputEl.addEventListener('blur', function () {
				setTimeout(function () {
					const active = document.activeElement;
					let stillFocused = false;
					inputs.forEach(function (el) {
						if (el === active) stillFocused = true;
					});
					if (type === 'deposit' && isDepositGroupFocused(active)) {
						stillFocused = true;
					}
					if (type === 'credit' && isCreditGroupFocused(active)) {
						stillFocused = true;
					}
					if (type === 'tipRoller' && isTipRollerGroupFocused(active)) {
						stillFocused = true;
					}
					if (type === 'tipDealer' && isTipDealerGroupFocused(active)) {
						stillFocused = true;
					}
					if (!stillFocused && !hasInputFn()) {
						if (type === 'cash') cashEngaged = false;
						else if (type === 'deposit') depositEngaged = false;
						else if (type === 'credit') creditEngaged = false;
						else if (type === 'tipRoller') tipRollerEngaged = false;
						else tipDealerEngaged = false;
						updateBalanceSummary();
					}
				}, 0);
			});
		});
	};

	modal.querySelectorAll('.cashout-nn-input').forEach(function (inputEl) {
		inputEl.addEventListener('input', function () {
			validateNnSplitInput(inputEl);
		});
	});

	wirePanelInputs('.cashout-cash-input', 'cash');
	wirePanelInputs('.cashout-deposit-input', 'deposit');
	wirePanelInputs('.cashout-credit-input', 'credit');
	wirePanelInputs('.cashout-tip-roller-input', 'tipRoller');
	wirePanelInputs('.cashout-tip-dealer-input', 'tipDealer');

	if (remarksInput) {
		remarksInput.removeAttribute('readonly');
		remarksInput.removeAttribute('disabled');

		remarksInput.addEventListener('mousedown', function (e) {
			e.stopPropagation();
		});

		remarksInput.addEventListener('focus', function () {
			depositEngaged = true;
			if (depositPanel && depositPanel.classList.contains('d-none')) {
				updateDepositPanel();
			}
		});
		remarksInput.addEventListener('input', function () {
			updateDepositPanel();
		});
		remarksInput.addEventListener('blur', function () {
			setTimeout(function () {
				if (isDepositGroupFocused(document.activeElement)) return;
				if (!shouldShowDepositPanel()) {
					depositEngaged = false;
					updateBalanceSummary();
				}
			}, 0);
		});
	}

	wireCreditSideField(creditRemarksInput);
	wireCreditSideField(creditGuarantorInput);
	initCreditGuarantorAutocomplete();
	initTipAutocompletes();
	wireTipRollerSideField(tipRollerNameInput, 'name');
	wireTipRollerSideField(tipRollerStatusInput, 'status');
	wireTipMetaField(tipDealerNameInput, 'dealer', 'name');
	wireTipMetaField(tipDealerStatusInput, 'dealer', 'status');
	wireSidePanelsResize();

	modal.addEventListener('shown.bs.modal', function () {
		releaseCashoutFocusTrap();
		loadModalBalances();
	});
	modal.addEventListener('hidden.bs.modal', function () {
		restoreCashoutFocusTrap();
		resetBalanceDisplay();
	});
	syncSidePanelsLayout();

	window.refreshCashoutModalBalances = function (agentCode, guestName) {
		if (agentCodeEl) agentCodeEl.textContent = agentCode || '';
		if (guestNameEl) guestNameEl.textContent = guestName || '';
		return loadModalBalances();
	};
});
</script>
