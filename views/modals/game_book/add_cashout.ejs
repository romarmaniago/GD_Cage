<div class="modal fade" id="modal-add-cashout" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered cashout-modal-dialog">
		<div class="cashout-modal-cluster">
			<div class="modal-content cashout-main-content">
				<div class="modal-header bg-primary">
					<h5 class="modal-title text-white" id="staticBackdropLiveLabel">CASH-OUT - <span id="cashout-agent-code"></span></h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<form id="add_cashout" class="cashout-main-form">
					<div class="modal-body">
						<input type="hidden" name="game_id" class="game_list_id">
						<input type="hidden" name="txtAccountCode" class="txtAccountCode">
						<input type="hidden" name="txttotal_balance_cashout" id="total_balance_cashout">
						<input type="hidden" name="txtMarkerChipsReturn" id="MarkerChipsReturn">
						<input type="hidden" name="txtTotalRolling" id="TotalRollingCashout">
						<span class="d-none" id="cashout-company-balance-base" aria-hidden="true">0</span>
						<span class="d-none" id="cashout-account-balance-base" aria-hidden="true">0</span>
						<span class="d-none" id="cashout-agent-code-label" aria-hidden="true"></span>
						<span class="d-none" id="cashout-guest-name-label" aria-hidden="true"></span>

						<div class="cashout-input-sheet">
							<div class="cashout-section" id="split-cashout-row">
								<div class="cashout-field-grid">
									<label class="form-label mb-0" for="nnCashAmount">Cash</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-nn-input cashout-cash-input" placeholder="NN Chips" id="nnCashAmount">
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-cash-input" placeholder="CC Chips" id="ccCashAmount">
								</div>
								<div class="cashout-field-grid">
									<label class="form-label mb-0" for="nnDepositAmount">Deposit</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-nn-input cashout-deposit-input" placeholder="NN Chips" id="nnDepositAmount">
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-deposit-input" placeholder="CC Chips" id="ccDepositAmount">
								</div>
								<div class="cashout-field-grid">
									<label class="form-label mb-0" for="nnCreditAmount">Credit</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-nn-input cashout-credit-input" placeholder="NN Chips" id="nnCreditAmount">
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-credit-input" placeholder="CC Chips" id="ccCreditAmount">
								</div>
							</div>

							<div class="cashout-section cashout-section-tips" id="tip-amount-row">
								<div class="cashout-field-grid">
									<label class="form-label mb-0" for="tipRollerNn">Tip (Roller)</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-nn-input cashout-tip-roller-input" placeholder="NN Chips" name="txtTipRollerNn" id="tipRollerNn">
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-tip-roller-input" placeholder="CC Chips" name="txtTipRollerCc" id="tipRollerCc">
								</div>
								<div class="cashout-field-grid">
									<label class="form-label mb-0" for="tipDealerNn">Tip (Dealer)</label>
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-nn-input cashout-tip-dealer-input" placeholder="NN Chips" name="txtTipDealerNn" id="tipDealerNn">
									<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
										class="form-control text-center cashout-tip-dealer-input" placeholder="CC Chips" name="txtTipDealerCc" id="tipDealerCc">
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<button type="submit" class="btn btn-sm btn-primary" id="submit-cashout-btn">Save</button>
						<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Close</button>
					</div>
				</form>
			</div>

			<div class="cashout-side-panels cashout-side-panels-empty" id="cashout-side-panels">
				<div class="cashout-side-resize-handle" id="cashout-side-resize-handle" title="Drag to resize" aria-hidden="true">⇔</div>
				<div class="cashout-side-panel d-none" id="cashout-cash-panel" aria-hidden="true">
					<div class="cashout-side-panel-title">Cash</div>
					<div class="cashout-panel-sheet">
						<div class="cashout-balance-head">
							<div class="cashout-balance-head-cell">Current Balance Of Company</div>
							<div class="cashout-balance-head-cell">Anticipated Balance Of Company</div>
						</div>
						<div class="cashout-balance-values">
							<div class="cashout-balance-value-cell" id="cashout-cash-current">—</div>
							<div class="cashout-balance-value-cell" id="cashout-cash-anticipated">—</div>
						</div>
						<div class="cashout-processing-head">Processing Amount</div>
						<div class="cashout-processing-body" id="cashout-cash-processing-wrap">
							<span id="cashout-cash-processing">0</span>
						</div>
					</div>
				</div>

				<div class="cashout-side-panel d-none" id="cashout-deposit-panel" aria-hidden="true">
					<div class="cashout-side-panel-title">Deposit</div>
					<div class="cashout-panel-sheet">
						<div class="cashout-balance-head">
							<div class="cashout-balance-head-cell" id="cashout-deposit-current-label">Current Balance Of Account</div>
							<div class="cashout-balance-head-cell" id="cashout-deposit-anticipated-label">Anticipated Balance Of Account</div>
						</div>
						<div class="cashout-balance-values">
							<div class="cashout-balance-value-cell" id="cashout-deposit-current">—</div>
							<div class="cashout-balance-value-cell" id="cashout-deposit-anticipated">—</div>
						</div>
						<div class="cashout-processing-row">
							<div class="cashout-processing-col">
								<div class="cashout-processing-head">Processing Amount</div>
								<div class="cashout-processing-body" id="cashout-deposit-processing-wrap">
									<span id="cashout-deposit-processing">0</span>
								</div>
							</div>
							<div class="cashout-remarks-col">
								<div class="cashout-processing-head">Remarks</div>
								<div class="cashout-remarks-body" id="cashout-remarks-slot">
									<input type="text" class="form-control form-control-sm text-center cashout-deposit-remarks-input" id="cashout-deposit-remarks" name="txtDepositRemarks" placeholder="Remarks" autocomplete="off" form="add_cashout">
								</div>
							</div>
						</div>
						<div class="cashout-history-wrap">
							<table class="table table-bordered table-sm mb-0 cashout-history-tbl">
								<thead>
									<tr>
										<th>Date</th>
										<th>Transaction</th>
										<th class="text-end">Amount</th>
										<th>Remarks</th>
									</tr>
								</thead>
								<tbody id="cashout-history-body">
									<tr class="text-muted">
										<td colspan="4" class="text-center small py-2">No history.</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>

				<div class="cashout-side-panel d-none cashout-side-panel-credit" id="cashout-credit-panel" aria-hidden="true">
					<div class="cashout-side-panel-title">Credit</div>
					<div class="cashout-panel-sheet cashout-credit-sheet">
						<div class="cashout-credit-summary-grid">
							<div class="cashout-credit-summary-col">
								<div class="cashout-balance-head-cell" id="cashout-credit-current-label">Current Credit Balance Of Account</div>
								<div class="cashout-balance-value-cell text-amount-negative" id="cashout-credit-current">—</div>
							</div>
							<div class="cashout-credit-summary-col">
								<div class="cashout-balance-head-cell" id="cashout-credit-anticipated-label">Anticipated Credit Balance Of Account</div>
								<div class="cashout-balance-value-cell text-amount-negative" id="cashout-credit-anticipated">—</div>
							</div>
							<div class="cashout-credit-guest-cols" id="cashout-credit-guest-cols"></div>
						</div>
						<div class="cashout-credit-processing-row">
							<div class="cashout-credit-proc-col">
								<div class="cashout-processing-head">Processing Amount</div>
								<div class="cashout-processing-body" id="cashout-credit-processing-wrap">
									<span id="cashout-credit-processing">0</span>
								</div>
							</div>
							<div class="cashout-credit-proc-col">
								<div class="cashout-processing-head">채무자 Debtor</div>
								<div class="cashout-credit-party-body cashout-credit-debtor-body" id="cashout-credit-debtor">
									<div id="cashout-credit-debtor-account">—</div>
									<div class="cashout-credit-debtor-guest" id="cashout-credit-debtor-guest">—</div>
								</div>
							</div>
							<div class="cashout-credit-proc-col">
								<div class="cashout-processing-head">보증인 Guarantor</div>
								<div class="cashout-credit-party-body cashout-credit-guarantor-body">
									<input type="text" class="form-control form-control-sm text-center cashout-credit-guarantor-input" id="cashout-credit-guarantor" name="txtCreditGuarantor" placeholder="Guarantor" autocomplete="off" form="add_cashout">
								</div>
							</div>
							<div class="cashout-credit-proc-col">
								<div class="cashout-processing-head">Credit Buy In</div>
								<div class="cashout-remarks-body">
									<input type="text" class="form-control form-control-sm text-center cashout-credit-remarks-input" id="cashout-credit-remarks" name="txtCreditRemarks" placeholder="Remarks" autocomplete="off" form="add_cashout">
								</div>
							</div>
						</div>
						<div class="cashout-history-wrap cashout-credit-history-wrap">
							<table class="table table-bordered table-sm mb-0 cashout-history-tbl cashout-credit-history-tbl">
								<thead>
									<tr>
										<th>Date</th>
										<th>Transaction</th>
										<th colspan="2" class="text-center">채무자 Debtor</th>
										<th>보증인 Guarantor</th>
										<th class="text-end">Amount</th>
										<th class="text-end">Balance</th>
										<th>Remarks</th>
									</tr>
								</thead>
								<tbody id="cashout-credit-history-body">
									<tr class="text-muted">
										<td colspan="8" class="text-center small py-2">No history.</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>

				<div class="cashout-tip-panels-row" id="cashout-tip-panels-row">
					<div class="cashout-side-panel d-none cashout-side-panel-tip-roller" id="cashout-tip-roller-panel" aria-hidden="true">
						<div class="cashout-side-panel-title">Tip (Roller)</div>
						<div class="cashout-panel-sheet">
							<div class="cashout-balance-head">
								<div class="cashout-balance-head-cell">Current Tip Balance</div>
								<div class="cashout-balance-head-cell">Anticipated Tip Balance</div>
							</div>
							<div class="cashout-balance-values">
								<div class="cashout-balance-value-cell" id="cashout-tip-roller-current">—</div>
								<div class="cashout-balance-value-cell" id="cashout-tip-roller-anticipated">—</div>
							</div>
							<div class="cashout-tip-processing-row">
								<div class="cashout-tip-proc-col">
									<div class="cashout-processing-head">Processing Amount</div>
									<div class="cashout-processing-body" id="cashout-tip-roller-processing-wrap">
										<span id="cashout-tip-roller-processing">0</span>
									</div>
								</div>
								<div class="cashout-tip-proc-col">
									<div class="cashout-processing-head">Status</div>
									<div class="cashout-tip-meta-body cashout-tip-name-body">
										<input type="text" class="form-control form-control-sm text-center cashout-tip-meta-input" id="cashout-tip-roller-status" name="txtTipStatus" placeholder="Roller / GM" autocomplete="off" form="add_cashout">
									</div>
								</div>
							<div class="cashout-tip-proc-col">
								<div class="cashout-processing-head">Name</div>
								<div class="cashout-tip-meta-body cashout-tip-name-body">
									<input type="text" class="form-control form-control-sm text-center cashout-tip-roller-name-input" id="cashout-tip-roller-name" name="txtTipRollerName" placeholder="Name" autocomplete="off" form="add_cashout">
								</div>
							</div>
							</div>
							<div class="cashout-history-wrap">
								<table class="table table-bordered table-sm mb-0 cashout-history-tbl cashout-tip-history-tbl">
									<thead>
										<tr>
											<th>Date</th>
											<th>Transaction</th>
											<th class="text-end">Amount</th>
											<th>Status</th>
											<th>Name</th>
										</tr>
									</thead>
									<tbody id="cashout-tip-roller-history-body">
										<tr class="text-muted">
											<td colspan="5" class="text-center small py-2">No history.</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>

					<div class="cashout-side-panel d-none cashout-side-panel-tip-dealer" id="cashout-tip-dealer-panel" aria-hidden="true">
						<div class="cashout-side-panel-title">Tip (Dealer)</div>
						<div class="cashout-panel-sheet">
							<div class="cashout-balance-head">
								<div class="cashout-balance-head-cell">Current Tip Balance</div>
								<div class="cashout-balance-head-cell">Anticipated Tip Balance</div>
							</div>
							<div class="cashout-balance-values">
								<div class="cashout-balance-value-cell" id="cashout-tip-dealer-current">—</div>
								<div class="cashout-balance-value-cell" id="cashout-tip-dealer-anticipated">—</div>
							</div>
							<div class="cashout-tip-processing-row">
								<div class="cashout-tip-proc-col">
									<div class="cashout-processing-head">Processing Amount</div>
									<div class="cashout-processing-body" id="cashout-tip-dealer-processing-wrap">
										<span id="cashout-tip-dealer-processing">0</span>
									</div>
								</div>
								<div class="cashout-tip-proc-col">
									<div class="cashout-processing-head">Status</div>
									<div class="cashout-tip-meta-body cashout-tip-name-body">
										<input type="text" class="form-control form-control-sm text-center cashout-tip-meta-input" id="cashout-tip-dealer-roller-status" placeholder="Roller / GM" autocomplete="off">
									</div>
								</div>
								<div class="cashout-tip-proc-col">
									<div class="cashout-processing-head">Name</div>
									<div class="cashout-tip-meta-body cashout-tip-name-body">
										<input type="text" class="form-control form-control-sm text-center cashout-tip-roller-name-input" id="cashout-tip-dealer-roller-name" placeholder="Name" autocomplete="off">
									</div>
								</div>
							</div>
							<div class="cashout-history-wrap">
								<table class="table table-bordered table-sm mb-0 cashout-history-tbl cashout-tip-history-tbl">
									<thead>
										<tr>
											<th>Date</th>
											<th>Transaction</th>
											<th class="text-end">Amount</th>
											<th>Status</th>
											<th>Name</th>
										</tr>
									</thead>
									<tbody id="cashout-tip-dealer-history-body">
										<tr class="text-muted">
											<td colspan="5" class="text-center small py-2">No history.</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
#modal-add-cashout.show,
#modal-add-cashout.showing {
	display: flex !important;
	align-items: center;
	justify-content: center;
	padding: 0.75rem;
}
#modal-add-cashout .cashout-modal-dialog {
	max-width: calc(100vw - 1.5rem);
	width: max-content;
	margin: 0 auto;
}
#modal-add-cashout .cashout-modal-cluster {
	display: flex;
	align-items: flex-start;
	justify-content: center;
	gap: 0.75rem;
	margin: 0 auto;
}
#modal-add-cashout .cashout-main-content {
	width: 32rem;
	max-width: 100%;
	flex-shrink: 0;
}
#modal-add-cashout .cashout-main-form {
	width: 100%;
	display: flex;
	flex-direction: column;
}
#modal-add-cashout .cashout-main-form .modal-body {
	padding: 0.75rem 1rem;
}
#modal-add-cashout .cashout-main-form .modal-footer {
	padding-left: 1rem;
	padding-right: 1rem;
}
#modal-add-cashout .cashout-input-sheet {
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
}
#modal-add-cashout .cashout-section {
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
}
#modal-add-cashout .cashout-section-tips {
	margin-top: 0.25rem;
	padding-top: 0.5rem;
	border-top: 1px solid #dee2e6;
}
#modal-add-cashout .cashout-field-grid {
	display: grid;
	grid-template-columns: 6.75rem minmax(0, 1fr) minmax(0, 1fr);
	column-gap: 0.5rem;
	align-items: center;
}
#modal-add-cashout .cashout-field-grid .form-control {
	width: 100%;
	min-width: 0;
}
#modal-add-cashout .cashout-field-grid label {
	white-space: nowrap;
	font-weight: 500;
}
#modal-add-cashout .cashout-side-panels {
	display: flex;
	flex-direction: column;
	gap: 0.75rem;
	width: 24rem;
	flex-shrink: 0;
	align-self: flex-start;
	min-height: 0;
	position: relative;
	pointer-events: auto;
}
#modal-add-cashout .cashout-side-panels:has(#cashout-credit-panel:not(.d-none)):not([data-user-sized]),
#modal-add-cashout .cashout-side-panels:has(#cashout-tip-panels-row .cashout-side-panel:not(.d-none)):not([data-user-sized]) {
	width: 40rem;
}
#modal-add-cashout .cashout-tip-panels-row {
	display: flex;
	gap: 0.75rem;
	width: 100%;
	min-width: 0;
}
#modal-add-cashout .cashout-tip-panels-row:not(:has(.cashout-side-panel:not(.d-none))) {
	display: none;
}
#modal-add-cashout .cashout-tip-panels-row .cashout-side-panel {
	flex: 1 1 0;
	min-width: 0;
}
#modal-add-cashout .cashout-tip-processing-row {
	display: grid;
	grid-template-columns: 1fr 0.75fr 0.75fr;
	border-bottom: 1px solid #dee2e6;
}
#modal-add-cashout .cashout-tip-proc-col + .cashout-tip-proc-col {
	border-left: 1px solid #dee2e6;
}
#modal-add-cashout .cashout-tip-meta-body {
	padding: 0.45rem 0.35rem;
	text-align: center;
	font-size: 0.78rem;
	font-weight: 600;
	min-height: 2.35rem;
	display: flex;
	align-items: center;
	justify-content: center;
}
#modal-add-cashout .cashout-tip-name-body {
	padding: 0.3rem 0.35rem;
}
#modal-add-cashout .cashout-tip-roller-name-input,
#modal-add-cashout .cashout-tip-meta-input {
	width: 100%;
	min-width: 0;
	pointer-events: auto;
}
#modal-add-cashout .cashout-tip-history-tbl th {
	background: #cfe2ff;
	font-size: 0.68rem;
	padding: 0.25rem 0.25rem;
}
#modal-add-cashout .cashout-tip-history-tbl td {
	font-size: 0.68rem;
	padding: 0.2rem 0.25rem;
}
#modal-add-cashout .cashout-tip-history-tbl thead th {
	position: sticky;
	top: 0;
	z-index: 2;
	box-shadow: inset 0 -1px 0 #dee2e6;
}
#modal-add-cashout .cashout-side-panels:not(.cashout-side-panels-empty) {
	max-height: calc(100vh - 4.5rem);
	overflow-y: auto;
	overflow-x: hidden;
	overscroll-behavior: contain;
	scrollbar-gutter: stable;
}
#modal-add-cashout .cashout-side-resize-handle {
	position: absolute;
	right: -0.45rem;
	top: 0;
	bottom: 0;
	width: 0.85rem;
	cursor: ew-resize;
	z-index: 3;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #6c757d;
	font-size: 0.72rem;
	line-height: 1;
	user-select: none;
	touch-action: none;
	border-left: 1px solid #ced4da;
	border-right: 1px solid #ced4da;
	background: linear-gradient(90deg, #f8f9fa 0%, #fff 50%, #f8f9fa 100%);
	border-radius: 0.2rem;
	opacity: 0.85;
}
#modal-add-cashout .cashout-side-resize-handle:hover,
#modal-add-cashout .cashout-side-resize-handle.is-dragging {
	opacity: 1;
	color: #0d6efd;
	border-color: #0d6efd;
	background: #e7f1ff;
}
#modal-add-cashout .cashout-side-panels.cashout-side-panels-empty .cashout-side-resize-handle {
	display: none;
}
body.cashout-side-resize-active {
	cursor: ew-resize !important;
	user-select: none !important;
}
#modal-add-cashout .cashout-side-panel {
	pointer-events: auto;
}
#modal-add-cashout .cashout-side-panels.cashout-side-panels-empty,
#modal-add-cashout .cashout-side-panels:not(:has(.cashout-side-panel:not(.d-none))) {
	display: none;
	width: 0;
	min-width: 0;
	gap: 0;
	overflow: hidden;
}
#modal-add-cashout .cashout-credit-summary-grid {
	display: flex;
	border-bottom: 1px solid #dee2e6;
}
#modal-add-cashout .cashout-credit-summary-col {
	flex: 1 1 0;
	min-width: 6.5rem;
	border-right: 1px solid #dee2e6;
	display: flex;
	flex-direction: column;
