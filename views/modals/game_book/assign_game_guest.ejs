<style>
#modal-assign-game-guest .assign-game-guest-history-scroll {
	max-height: 140px;
}
#modal-assign-game-guest .assign-game-guest-history-tbl thead th {
	background: var(--bs-primary-bg-subtle);
	color: var(--bs-primary);
	font-size: 0.75rem;
	font-weight: 600;
}
#modal-assign-game-guest .assign-game-guest-history-tbl tbody td {
	font-size: 0.75rem;
}
#modal-assign-game-guest .assign-game-guest-add-btn {
	width: 32px;
	height: 32px;
	padding: 0;
	display: inline-flex;
	align-items: center;
	justify-content: center;
}
</style>
<div class="modal fade" id="modal-assign-game-guest" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="assignGameGuestLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-primary py-2">
				<h6 class="modal-title text-white mb-0" id="assignGameGuestLabel">Assign guest — Game #<span id="assign-guest-game-id-label"></span></h6>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="assign_game_guest_form">
				<div class="modal-body">
					<input type="hidden" id="assign_guest_game_id" name="game_id">
					<input type="hidden" id="assign_guest_account_id" name="account_id">
					<input type="hidden" id="assign_guest_agent_id" name="agent_id">
					<div class="row mb-0">
						<div class="col-sm-12">
							<div class="d-flex align-items-center mb-3">
								<label class="form-label mb-0" for="assign_game_guest_select">Guest <span class="text-danger">*</span></label>
								<div class="ms-auto d-flex align-items-center gap-2">
									<button type="button" id="btn-assign-game-guest-add" class="btn btn-sm btn-primary assign-game-guest-add-btn" title="Add guest to this line">
										<i class="fa fa-plus" aria-hidden="true"></i>
									</button>
									<button type="button" id="btn-assign-guest-game-history" class="btn btn-sm btn-primary" disabled title="View game history for selected guest">
										<i class="fa fa-history me-1" aria-hidden="true"></i>Game History
									</button>
								</div>
							</div>
							<select class="form-select" id="assign_game_guest_select" name="guest_id" style="width: 100%;" data-placeholder="Select guest" required>
								<option value="">-- Select guest --</option>
							</select>
						</div>
					</div>
					<div id="assign-game-guest-history-wrap" class="mt-3 d-none">
						<div class="table-responsive assign-game-guest-history-scroll">
							<table class="table table-bordered table-hover align-middle nowrap small-text mb-0 assign-game-guest-history-tbl" style="width:100%">
								<thead>
									<tr>
										<th>Date / time</th>
										<th>Previous</th>
										<th>New</th>
									</tr>
								</thead>
								<tbody id="assign-game-guest-history-tbody"></tbody>
							</table>
						</div>
					</div>
				</div>
				<div class="modal-footer py-2">
					<button type="submit" id="submit-assign-game-guest-btn" class="btn btn-sm btn-primary" disabled>Save</button>
					<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Close</button>
				</div>
			</form>
		</div>
	</div>
</div>
