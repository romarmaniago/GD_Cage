<div class="modal fade" id="modal-show-history" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-xl">
		<div class="modal-content">
		<div class="modal-header bg-primary">
			<h5 class="modal-title text-white" id="staticBackdropLiveLabel"><%= __('modal_show_rolling.title') %> - <span id="show-agent-label"></span></h5>
			<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
		</div>
		<div class="modal-body">
			<div class="custom-datatable-entries">
				<div class="table-responsive">  <!-- Dagdag ng table-responsive div -->
				<table id="game_record-tbl" class="table table-bordered table-vcenter js-dataTable-responsive"
						style="font-size: 11px !important;">
						<thead>
							<tr>
								<th class="text-center"><%= __('modal_show_rolling.date') %></th>
								<th class="text-center"><%= __('modal_show_rolling.buyin') %></th>
								<th class="text-center"><%= __('modal_show_rolling.cash_out') %></th>
								<th class="text-center"><%= __('modal_show_rolling.total_rolling') %></th>
								<th class="text-center"><%= __('modal_show_rolling.nn') %></th>
								<th class="text-center"><%= __('modal_show_rolling.cc') %></th>
								<th class="text-center">R/C</th>
								<th class="text-center" ><%= __('modal_show_rolling.action') %></th>
							</tr>
						</thead>
						<tbody>
						</tbody>
					</table>
				</div>
			</div>

			<hr class="my-3">

			<div class="d-flex justify-content-between align-items-center mb-2">
				<div class="fw-semibold text-muted">Services Availed</div>
				<div class="fw-semibold text-muted">Total: <span id="history-services-total" class="text-primary">0</span></div>
			</div>
			<div class="custom-datatable-entries history-services-list-table-wrap">
				<table id="history-services-list-tbl" class="table table-bordered table-vcenter" style="font-size: 11px !important;">
					<thead>
						<tr>
							<th scope="col">Date</th>
							<th scope="col">Service Type</th>
							<th scope="col" class="text-end">Amount</th>
							<th scope="col" class="text-end">Delivery Fee</th>
							<th scope="col">Transaction</th>
							<th scope="col">Remarks</th>
							<th scope="col">Processed By</th>
						</tr>
					</thead>
					<tbody id="history-services-list-body">
						<tr class="text-muted">
							<td colspan="7" class="text-center small">No services availed.</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
		<div class="modal-footer d-flex flex-wrap align-items-center justify-content-between gap-2">
			<div class="rolling-legend text-muted small d-flex align-items-center gap-3 flex-wrap ms-4">
				<span class="d-inline-flex align-items-center gap-1">
					<span class="rolling-legend-swatch" style="background-color: #0d6efd;"></span>
					<span>Credit</span>
				</span>
				<span class="d-inline-flex align-items-center gap-1">
					<span class="rolling-legend-swatch" style="background-color: #198754;"></span>
					<span>Deposit</span>
				</span>
			</div>
			<div class="d-flex align-items-center gap-2">
				<button type="button" class="btn btn-sm btn-alt-success" id="btn-print-game-history">
					<i class="fa fa-print me-1"></i> Print
				</button>
				<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
					<%= __('modal_show_rolling.close') %>
				</button>
			</div>
		</div>
	</div>
	</div>
</div>

<style>
	/* Color only when value is non-zero: Marker = blue, Deposit (including cashout thru deposit) = green */
	#modal-show-history #game_record-tbl .rolling-cell-marker {
		color: #0d6efd;
		font-weight: 500;
	}
	#modal-show-history #game_record-tbl .rolling-cell-deposit {
		color: #198754;
		font-weight: 500;
	}
	#modal-show-history #game_record-tbl .rolling-cell-tip {
		color: #fd7e14;
		font-weight: 500;
	}
	/* Legend in footer */
	.rolling-legend-swatch {
		display: inline-block;
		width: 12px;
		height: 12px;
		border-radius: 2px;
		border: 1px solid rgba(0,0,0,0.1);
	}
	#modal-show-history .history-services-list-table-wrap,
	#modal-show-history .history-services-list-table-wrap .dataTables_wrapper {
		overflow-x: visible;
	}
	#modal-show-history #history-services-list-tbl {
		width: 100% !important;
	}
	#modal-show-history #history-services-list-tbl th,
	#modal-show-history #history-services-list-tbl td {
		white-space: nowrap;
	}
	#modal-show-history #history-services-list-tbl td:nth-child(6) {
		white-space: normal;
		min-width: 120px;
		max-width: 220px;
	}
	#modal-show-history #history-services-list-tbl .services-total-row td {
		border-top: 2px solid #dee2e6;
		font-weight: 700;
	}
</style>

<script>
	(function () {
		var historyServicesPrintColumns = [
			{ header: 'Date', sourceIndex: 0, align: 'left', totalKey: null },
			{ header: 'Service Type', sourceIndex: 1, align: 'left', totalKey: null },
			{ header: 'Amount', sourceIndex: 2, align: 'right', totalKey: 'amount' },
			{ header: 'Delivery Fee', sourceIndex: 3, align: 'right', totalKey: 'fee' },
			{ header: 'Remarks', sourceIndex: 5, align: 'left', totalKey: null }
		];

		function buildHistoryServicesPrintHtml() {
			const $servicesTable = $('#history-services-list-tbl');
			if (!$servicesTable.length) {
				return '';
			}

			let servicesRows = [];
			function readServiceRowCells($row) {
				return $row.children('td').map(function () {
					return $(this).text().trim();
				}).get().slice(0, 7);
			}

			if ($.fn.DataTable.isDataTable($servicesTable)) {
				$servicesTable.DataTable().rows({ search: 'applied' }).nodes().each(function () {
					const cells = readServiceRowCells($(this));
					if (cells.length === 7 && cells[0].toLowerCase() !== 'no services availed.' && cells[0].toUpperCase() !== 'TOTAL') {
						servicesRows.push(cells);
					}
				});
			} else {
				$servicesTable.find('tbody tr').each(function () {
					const cells = readServiceRowCells($(this));
					if (cells.length === 7 && cells[0].toLowerCase() !== 'no services availed.' && cells[0].toUpperCase() !== 'TOTAL') {
						servicesRows.push(cells);
					}
				});
			}

			if (!servicesRows.length) {
				return '';
			}

			const totalLabel = ($('#history-services-total').text() || '0').trim();
			const footerTotals = { amount: 0, fee: 0 };
			const servicesBody = servicesRows.map(function (row) {
				const cols = historyServicesPrintColumns.map(function (col) {
					const value = row[col.sourceIndex] || '';
					if (col.totalKey === 'amount') {
						footerTotals.amount += parseFloat(String(value).replace(/,/g, '')) || 0;
					}
					if (col.totalKey === 'fee') {
						footerTotals.fee += parseFloat(String(value).replace(/,/g, '')) || 0;
					}
					return '<td style="text-align:' + col.align + ';">' + value + '</td>';
				}).join('');
				return '<tr>' + cols + '</tr>';
			}).join('');
			const servicesTotalRow = '<tr class="services-total-row">'
				+ historyServicesPrintColumns.map(function (col, index) {
					var value = '';
					if (index === 0) {
						value = 'TOTAL';
					} else if (col.totalKey === 'amount') {
						value = footerTotals.amount.toLocaleString('en-US');
					} else if (col.totalKey === 'fee') {
						value = footerTotals.fee.toLocaleString('en-US');
					}
					return '<td style="text-align:' + col.align + ';font-weight:700;">' + value + '</td>';
				}).join('')
				+ '</tr>';

			return ''
				+ '<h4 class="services-print-title">Services Availed (Total: ' + totalLabel + ')</h4>'
				+ '<table class="services-print">'
				+ '<colgroup>'
				+ '<col style="width:18%">'
				+ '<col style="width:18%">'
				+ '<col style="width:16%">'
				+ '<col style="width:16%">'
				+ '<col style="width:32%">'
				+ '</colgroup>'
				+ '<thead><tr>'
				+ historyServicesPrintColumns.map(function (col) { return '<th>' + col.header + '</th>'; }).join('')
				+ '</tr></thead>'
				+ '<tbody>' + servicesBody + servicesTotalRow + '</tbody>'
				+ '</table>';
		}

		$(document).off('click', '#btn-print-game-history').on('click', '#btn-print-game-history', function () {
			const table = $('#game_record-tbl').DataTable();
			if (!table) {
				return;
			}

			const headers = $('#game_record-tbl thead th').map(function (index) {
				// Skip Action column (last column)
				if (index === 7) {
					return null;
				}
				return $(this).text().trim();
			}).get().filter(Boolean);

			const rows = table.rows({ search: 'applied' }).data().toArray();
			const bodyHtml = rows.map(function (row) {
				const cols = row.slice(0, 7).map(function (col) {
					return `<td>${col}</td>`;
				}).join('');
				return `<tr>${cols}</tr>`;
			}).join('');

			const servicesPrintHtml = buildHistoryServicesPrintHtml();
			const accountLabel = ($('#show-agent-label').text() || '').trim();

			const printFrame = document.createElement('iframe');
			printFrame.style.position = 'fixed';
			printFrame.style.right = '0';
			printFrame.style.bottom = '0';
			printFrame.style.width = '0';
			printFrame.style.height = '0';
			printFrame.style.border = '0';
			document.body.appendChild(printFrame);

			const frameWindow = printFrame.contentWindow;
			if (!frameWindow) {
				printFrame.remove();
				return;
			}

			const cleanupPrintFrame = function () {
				setTimeout(function () {
					if (printFrame && printFrame.parentNode) {
						printFrame.parentNode.removeChild(printFrame);
					}
				}, 100);
			};

			frameWindow.document.open();
			frameWindow.document.write(`
				<html>
					<head>
						<title>Game Record History</title>
						<style>
							@page { size: auto; margin: 6mm; }
							html, body { width: 100%; margin: 0; padding: 0; }
							body { font-family: Arial, sans-serif; color: #111; }
							h3 { margin: 0 0 8px; font-size: 18px; }
							h4.services-print-title { margin: 20px 0 8px; font-size: 16px; }
							table { border-collapse: collapse; font-size: 12px; border: 1px solid #000; }
							table.game-history-print { width: 100%; table-layout: fixed; }
							table.services-print {
								width: 100%;
								table-layout: fixed;
								margin-top: 4px;
								page-break-inside: avoid;
							}
							th, td { border: 1px solid #000; padding: 6px 8px; vertical-align: top; }
							table.game-history-print th,
							table.game-history-print td { text-align: center; }
							table.services-print th,
							table.services-print td {
								text-align: left;
								white-space: normal;
								word-break: break-word;
								overflow-wrap: anywhere;
								line-height: 1.35;
							}
							table.services-print th:nth-child(1),
							table.services-print td:nth-child(1),
							table.services-print th:nth-child(3),
							table.services-print td:nth-child(3),
							table.services-print th:nth-child(4),
							table.services-print td:nth-child(4) { white-space: nowrap; }
							table.services-print th:nth-child(3),
							table.services-print td:nth-child(3),
							table.services-print th:nth-child(4),
							table.services-print td:nth-child(4) { text-align: right; }
							table.services-print .services-total-row td {
								font-weight: 700;
								background: #e9ecef;
								-webkit-print-color-adjust: exact;
								print-color-adjust: exact;
							}
							th {
								background: #e9ecef;
								-webkit-print-color-adjust: exact;
								print-color-adjust: exact;
							}
						</style>
					</head>
					<body>
						<h3>Game Record History - ${accountLabel}</h3>
						<table class="game-history-print">
							<thead>
								<tr>${headers.map(function (h) { return `<th>${h}</th>`; }).join('')}</tr>
							</thead>
							<tbody>
								${bodyHtml}
							</tbody>
						</table>
						${servicesPrintHtml}
					</body>
				</html>
			`);
			frameWindow.document.close();

			frameWindow.onafterprint = cleanupPrintFrame;
			if (typeof frameWindow.matchMedia === 'function') {
				const mediaQuery = frameWindow.matchMedia('print');
				if (mediaQuery && typeof mediaQuery.addEventListener === 'function') {
					const handleMediaChange = function (event) {
						if (!event.matches) {
							cleanupPrintFrame();
							mediaQuery.removeEventListener('change', handleMediaChange);
						}
					};
					mediaQuery.addEventListener('change', handleMediaChange);
				}
			}

			frameWindow.focus();
			frameWindow.print();
		});
	})();
</script>

<!-- Edit Game Record Modal (Super Admin only) -->
<div class="modal fade" id="modal-edit-game-record" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="editGameRecordLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white" id="editGameRecordLabel">Edit Game Record</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<input type="hidden" id="edit-record-id" />
				<div id="edit-form-buyin" style="display:none;">
					<div class="mb-3">
						<label class="form-label">NN Chips</label>
						<input type="text" class="form-control" id="edit-buyin-nn" data-type="number" inputmode="numeric" />
					</div>
					<div class="mb-3">
						<label class="form-label">CC Chips</label>
						<input type="text" class="form-control" id="edit-buyin-cc" data-type="number" inputmode="numeric" />
					</div>
				</div>
				<div id="edit-form-cashout" style="display:none;">
					<div class="mb-3">
						<label class="form-label">NN Chips</label>
						<input type="text" class="form-control" id="edit-cashout-nn" data-type="number" inputmode="numeric" />
					</div>
					<div class="mb-3">
						<label class="form-label">CC Chips</label>
						<input type="text" class="form-control" id="edit-cashout-cc" data-type="number" inputmode="numeric" />
					</div>
				</div>
				<div id="edit-form-rolling" style="display:none;">
					<div class="mb-3">
						<label class="form-label">CC Chips</label>
						<input type="text" class="form-control" id="edit-rolling-cc" data-type="number" inputmode="numeric" />
					</div>
				</div>
				<div id="edit-form-roller" style="display:none;">
					<div class="mb-3">
						<label class="form-label">Roller NN Chips</label>
						<input type="text" class="form-control" id="edit-roller-nn" data-type="number" inputmode="numeric" />
					</div>
					<div class="mb-3">
						<label class="form-label">Roller CC Chips</label>
						<input type="text" class="form-control" id="edit-roller-cc" data-type="number" inputmode="numeric" />
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-alt-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-primary" id="btn-save-edit-record">Save</button>
			</div>
		</div>
	</div>
</div>