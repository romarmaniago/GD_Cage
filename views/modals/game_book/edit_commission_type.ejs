<div class="modal fade" id="modal-edit-commission-type" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white">Edit Commission Type - <span id="edit-commission-agent-code"></span></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="form-edit-commission-type">
				<div class="modal-body">
					<input type="hidden" id="edit-commission-game-id" />
					<div class="row">
						<div class="col-sm-7 mb-2">
							<label for="edit-commission-type" class="form-label">Type</label>
							<select id="edit-commission-type" class="form-select">
								<option value="1">Rolling Game</option>
								<option value="2">Shared Game</option>
								<option value="3">Share + Rolling</option>
							</select>
						</div>
						<div class="col-sm-5 mb-2">
							<label for="edit-commission-rate" class="form-label">Rate (%)</label>
							<input id="edit-commission-rate" type="number" class="form-control" min="0" max="100" step="0.1" required />
							<div class="invalid-feedback">Please input a valid rate.</div>
						</div>
					</div>
					<!-- Share + Rolling (type 3) -->
					<div class="row d-none" id="edit-commission-share-rolling-wrap">
						<div class="col-sm-6 mb-2">
							<label for="edit-commission-share-pct" class="form-label">Share %</label>
							<input id="edit-commission-share-pct" type="number" class="form-control js-pct-0-100" min="0" max="100" step="0.5" />
							<div class="invalid-feedback">Share % must be between 0 and 100.</div>
						</div>
						<div class="col-sm-6 mb-2">
							<label for="edit-commission-rolling-pct" class="form-label">Rolling %</label>
							<input id="edit-commission-rolling-pct" type="number" class="form-control js-pct-0-100" min="0" max="100" step="0.5" />
							<div class="invalid-feedback">Rolling % must be between 0 and 100.</div>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="submit" id="edit-commission-save-btn" class="btn btn-primary">Update</button>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				</div>
			</form>
		</div>
	</div>
</div>
