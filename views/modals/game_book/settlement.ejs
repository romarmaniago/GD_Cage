<style>
    #modal-settlement .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    #modal-settlement .form-label {
        flex: 1;
        font-size: 0.875rem;
        position: relative;
        margin-right: 1rem;
    }

    #modal-settlement .form-label::after {
        content: ":";
        position: absolute;
        right: -1rem;
    }

    #modal-settlement .form-input {
        width: 150px;
        font-size: 0.875rem;
        padding: 0.375rem 0.75rem;
        border: none;
        border-bottom: 1px solid #ced4da;
        box-shadow: none;
        text-align: right;
    }

    #modal-settlement .form-check-label {
        font-size: 0.875rem;
    }

    #modal-settlement .header-logo {
        max-width: 340px;
    }

    #modal-settlement .block-content.header-with-logo {
        position: relative;
        justify-content: flex-start;
    }

    #modal-settlement .settlement-title {
        position: absolute;
        right: 2rem;
        margin: 0 !important;
    }

    #modal-settlement .block-content {
        padding: 2rem;
    }

    #modal-settlement .small-input-group {
        margin-bottom: 0.5rem;
        margin-left: 23rem;
    }

    #modal-settlement .row {
        margin-bottom: 0.5rem;
    }
    #modal-settlement .settled-image {
        display: block; /* Initially hide images */
        width: 300px; /* Ensure the size is set */
        position: absolute; /* Maintain position if necessary */
        left: 7%;
        top: 60%;
        opacity: 0.9;
        transform: translateY(-50%);
    }
    #modal-settlement .text-primary {
        color: #0665d0  !important;
    }
    #modal-settlement .custom-ok-btn {
        background-color: #00563f !important;
        color: white !important;
    }

    #modal-settlement .receipt-print-only { display: none; }

    #modal-settlement .receipt-print-content {
        width: 100%;
        max-width: 200mm;
        margin: 0 auto;
        color: #000;
        font-family: Arial, sans-serif;
        font-size: 6mm;
        line-height: 1.3;
    }

    #modal-settlement .receipt-brand {
        text-align: center;
        font-weight: 700;
        font-size: 7.5mm;
        margin: 0;
        letter-spacing: 0.3px;
    }

    #modal-settlement .receipt-subtitle {
        text-align: center;
        font-weight: 700;
        font-size: 6.4mm;
        margin: 4mm 0 0;
    }

    #modal-settlement .receipt-datetime {
        text-align: center;
        font-weight: 700;
        font-size: 5.6mm;
        margin: 2mm 0 4mm;
    }

    #modal-settlement .receipt-line {
        border-top: 1px solid #000;
        width: 90%;
        margin: 4mm auto;
    }

    #modal-settlement .receipt-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 3mm;
        width: 72%;
        min-width: 120mm;
        margin: 2mm auto;
    }

    #modal-settlement .receipt-row span:first-child {
        width: 35%;
        text-align: right;
        font-weight: 700;
        white-space: nowrap;
    }

    #modal-settlement .receipt-row span:last-child {
        width: 35%;
        text-align: left;
        font-weight: 700;
        white-space: nowrap;
    }

    #modal-settlement .receipt-total span { font-size: 7mm; }

    @media print {
        #modal-settlement #add_settlement,
        #modal-settlement .modal-header,
        #modal-settlement .header-with-logo,
        #modal-settlement .settled-image,
        #modal-settlement .modal-footer {
            display: none !important;
        }
    }







</style>
