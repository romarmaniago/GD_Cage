    function clampSettlementSplitPct(value) {
        var num = parseFloat(String(value || '').replace(/%/g, '').trim());
        if (isNaN(num)) {
            return 0;
        }
        return Math.min(100, Math.max(0, num));
    }

    function formatCalculatorSettlementDisplay(value) {
        var display = formatSettlementDueDisplay(value);
        return {
            text: display.text,
            negative: display.negative
        };
    }

    function refreshSettlementCalculator($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        if (Number($modal.data('settlement-edit-mode')) !== 1) {
            return;
        }

        var rolling = parseAmount($modal.find('#rolling').val());
        var rate = parseAmount($modal.find('#rollingRate').val());
        var splitPct = clampSettlementSplitPct($modal.find('#calc-split-pct').val());
        var remainPct = Math.max(0, 100 - splitPct);

        var splitRolling = Math.round((rolling * splitPct) / 100);
        var remainRolling = Math.max(0, rolling - splitRolling);
        var totalSettlement = Math.round((rolling * rate) / 100);
        var splitSettlement = Math.round((splitRolling * rate) / 100);
        var remainSettlement = Math.max(0, totalSettlement - splitSettlement);
        var splitDisplay = formatCalculatorSettlementDisplay(splitSettlement);
        var remainDisplay = formatCalculatorSettlementDisplay(remainSettlement);
        var totalDisplay = formatCalculatorSettlementDisplay(totalSettlement);

        $modal.find('#calc-split-pct').val(String(splitPct).replace(/\.0+$/, ''));
        $modal.find('#calc-rolling-split').text(formatAmount(splitRolling));
        $modal.find('#calc-rolling-remain').text(formatAmount(remainRolling));
        $modal.find('#calc-rolling-total').text(formatAmount(rolling));
        $modal.find('#calc-remain-pct').text(remainPct + '%');

        $modal.find('#calc-share-pct-split').text(splitPct + '%');
        var $splitAmtCell = $modal.find('#calc-share-amt-split');
        $splitAmtCell.text(splitDisplay.text).toggleClass('is-negative', splitDisplay.negative);

        $modal.find('#calc-share-pct-remain').text(remainPct + '%');
        var $remainAmtCell = $modal.find('#calc-share-amt-remain');
        $remainAmtCell.text(remainDisplay.text).toggleClass('is-negative', remainDisplay.negative);

        $modal.find('#calc-share-pct-settlement').text('Settlement :');
        var $settlementAmtCell = $modal.find('#calc-share-amt-settlement');
        $settlementAmtCell.text(totalDisplay.text).toggleClass('is-negative', totalDisplay.negative);

        if (splitPct > 0 && Number($modal.data('calculator-split-active')) === 1) {
            applyCalculatorSplitToEditPanels($modal, splitRolling, remainRolling);
        } else if (splitPct <= 0 && Number($modal.data('calculator-split-touched')) === 1) {
            $modal.removeData('calculator-split-active');
            restoreOriginalRollingToEditPanels($modal);
        }
    }

    function restoreOriginalRollingToEditPanels($modal) {
        var rollingVal = $modal.find('#rolling').val();
        var rateRaw = String($modal.find('#rollingRate').val() || '').replace(/%/g, '').trim();
        var $guestPanel = $modal.find('#settlement-edit-guest-panel');
        var $agentPanel = $modal.find('#settlement-edit-agent-panel');

        [$guestPanel, $agentPanel].forEach(function($panel) {
            if (!$panel.length) {
                return;
            }
            $panel.find('[data-field="rolling"]').val(rollingVal);
            $panel.find('[data-field="rollingRate"]').val(rateRaw);
            recalcSettlementEditPanelTotals($panel);
        });
    }

    function applyCalculatorSplitToEditPanels($modal, guestRolling, agentRolling) {
        var $guestPanel = $modal.find('#settlement-edit-guest-panel');
        var $agentPanel = $modal.find('#settlement-edit-agent-panel');

        if ($guestPanel.length) {
            $guestPanel.find('[data-field="rolling"]').val(formatAmount(guestRolling));
            recalcSettlementEditPanelTotals($guestPanel);
        }
        if ($agentPanel.length) {
            $agentPanel.find('[data-field="rolling"]').val(formatAmount(agentRolling));
            recalcSettlementEditPanelTotals($agentPanel);
        }
    }

    // Keep Calculator table in sync with actual Guest/Agent rolling amounts
    function updateCalculatorFromEditPanels($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        if (Number($modal.data('settlement-edit-mode')) !== 1) {
            return;
        }

        var totalRolling = parseAmount($modal.find('#rolling').val());
        var rate = parseAmount($modal.find('#rollingRate').val());
        var guestRolling = parseAmount($modal.find('#settlement-edit-guest-panel [data-field="rolling"]').val());
        var agentRolling = parseAmount($modal.find('#settlement-edit-agent-panel [data-field="rolling"]').val());

        guestRolling = Math.max(0, Math.min(totalRolling, guestRolling));
        agentRolling = Math.max(0, totalRolling - guestRolling);

        var splitPct = totalRolling > 0
            ? Math.round((guestRolling / totalRolling) * 10000) / 100
            : 0;
        var remainPct = Math.max(0, Math.round((100 - splitPct) * 100) / 100);
        var totalSettlement = Math.round((totalRolling * rate) / 100);
        var splitSettlement = Math.round((guestRolling * rate) / 100);
        var remainSettlement = Math.max(0, totalSettlement - splitSettlement);
        var splitDisplay = formatCalculatorSettlementDisplay(splitSettlement);
        var remainDisplay = formatCalculatorSettlementDisplay(remainSettlement);
        var totalDisplay = formatCalculatorSettlementDisplay(totalSettlement);

        $modal.find('#calc-split-pct').val(String(splitPct).replace(/\.0+$/, ''));
        $modal.find('#calc-rolling-split').text(formatAmount(guestRolling));
        $modal.find('#calc-rolling-remain').text(formatAmount(agentRolling));
        $modal.find('#calc-rolling-total').text(formatAmount(totalRolling));
        $modal.find('#calc-remain-pct').text(remainPct + '%');
        $modal.find('#calc-share-pct-split').text(splitPct + '%');
        $modal.find('#calc-share-amt-split').text(splitDisplay.text).toggleClass('is-negative', splitDisplay.negative);
        $modal.find('#calc-share-pct-remain').text(remainPct + '%');
        $modal.find('#calc-share-amt-remain').text(remainDisplay.text).toggleClass('is-negative', remainDisplay.negative);
        $modal.find('#calc-share-pct-settlement').text('Settlement :');
        $modal.find('#calc-share-amt-settlement').text(totalDisplay.text).toggleClass('is-negative', totalDisplay.negative);
    }

    // Guest + Agent rolling always equals main Settlement rolling
    function syncCounterpartRolling($sourcePanel, clampEdited) {
        var $modal = $('#modal-settlement');
        var $guestPanel = $modal.find('#settlement-edit-guest-panel');
        var $agentPanel = $modal.find('#settlement-edit-agent-panel');
        if (!$sourcePanel || !$sourcePanel.length || !$guestPanel.length || !$agentPanel.length) {
            return;
        }

        var totalRolling = parseAmount($modal.find('#rolling').val());
        var isGuest = $sourcePanel.is('#settlement-edit-guest-panel');
        var $otherPanel = isGuest ? $agentPanel : $guestPanel;
        var $sourceInput = $sourcePanel.find('[data-field="rolling"]');
        var edited = parseAmount($sourceInput.val());

        if (clampEdited) {
            edited = Math.max(0, Math.min(totalRolling, edited));
            $sourceInput.val(formatAmount(edited));
        } else if (edited < 0) {
            edited = 0;
        }

        var otherRolling = Math.max(0, totalRolling - Math.min(edited, totalRolling));
        $otherPanel.find('[data-field="rolling"]').val(formatAmount(otherRolling));

        recalcSettlementEditPanelTotals($sourcePanel);
        recalcSettlementEditPanelTotals($otherPanel);
        updateCalculatorFromEditPanels($modal);
    }

    function resetSettlementCalculator($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        $modal.removeData('calculator-split-active');
        $modal.removeData('calculator-split-touched');
        $modal.find('#calc-split-pct').val('0');
        $modal.find('#calc-rolling-split, #calc-rolling-remain, #calc-rolling-total').text('0');
        $modal.find('#calc-remain-pct').text('100%');
        $modal.find('#calc-share-pct-split').text('0%');
        $modal.find('#calc-share-amt-split').text('').removeClass('is-negative');
        $modal.find('#calc-share-pct-remain').text('100%');
        $modal.find('#calc-share-amt-remain').text('').removeClass('is-negative');
        $modal.find('#calc-share-pct-settlement').text('Settlement :');
        $modal.find('#calc-share-amt-settlement').text('').removeClass('is-negative');
        resetBasicCalculator();
    }

    var basicCalcState = {
        display: '0',
        first: null,
        operator: null,
        waitingForSecond: false,
        expression: '',
        justEvaluated: false
    };

    function formatBasicCalcResult(value) {
        var num = Number(value);
        if (!Number.isFinite(num)) {
            return 'Error';
        }
        var abs = Math.abs(num);
        if (abs !== 0 && (abs >= 1e12 || abs < 1e-8)) {
            return String(num);
        }
        var fixed = Math.round(num * 1e10) / 1e10;
        return String(fixed);
    }

    // Comma-format for display only; state stays raw (no commas)
    function formatBasicCalcDisplayText(raw) {
        if (raw === 'Error') {
            return 'Error';
        }
        var str = String(raw == null ? '0' : raw);
        var isNeg = str.charAt(0) === '-';
        if (isNeg) {
            str = str.slice(1);
        }

        var hasDot = str.indexOf('.') !== -1;
        var parts = str.split('.');
        var intRaw = String(parts[0] || '').replace(/[^\d]/g, '');
        if (intRaw === '') {
            intRaw = '0';
        }
        var out = Number(intRaw).toLocaleString('en-US');
        if (hasDot) {
            out += '.' + String(parts[1] || '').replace(/[^\d]/g, '');
        }
        return isNeg ? '-' + out : out;
    }

    function basicCalcOpSymbol(op) {
        if (op === '+') return '+';
        if (op === '-') return '−';
        if (op === '*') return '×';
        if (op === '/') return '÷';
        return op || '';
    }

    function parseBasicCalcDisplay() {
        return parseFloat(String(basicCalcState.display || '0').replace(/,/g, ''));
    }

    function setBasicCalcExpression(text) {
        basicCalcState.expression = text || '';
    }

    function renderBasicCalculator() {
        $('#settlement-basic-calc-expression').text(basicCalcState.expression || '');
        $('#settlement-basic-calc-display').text(formatBasicCalcDisplayText(basicCalcState.display));
    }

    function resetBasicCalculator() {
        basicCalcState.display = '0';
        basicCalcState.first = null;
        basicCalcState.operator = null;
        basicCalcState.waitingForSecond = false;
        basicCalcState.expression = '';
        basicCalcState.justEvaluated = false;
        renderBasicCalculator();
    }

    function applyBasicCalcOperator(a, b, op) {
        if (op === '+') return a + b;
        if (op === '-') return a - b;
        if (op === '*') return a * b;
        if (op === '/') return b === 0 ? NaN : a / b;
        return b;
    }

    function handleBasicCalcKey(key) {
        if (key === 'C') {
            resetBasicCalculator();
            return;
        }

        if (key === 'CE') {
            basicCalcState.display = '0';
            basicCalcState.waitingForSecond = false;
            if (basicCalcState.justEvaluated) {
                setBasicCalcExpression('');
                basicCalcState.justEvaluated = false;
                basicCalcState.first = null;
                basicCalcState.operator = null;
            }
            renderBasicCalculator();
            return;
        }

        if (key === 'BS') {
            if (basicCalcState.justEvaluated) {
                setBasicCalcExpression('');
                basicCalcState.justEvaluated = false;
            }
            if (basicCalcState.waitingForSecond || basicCalcState.display === 'Error') {
                basicCalcState.display = '0';
                basicCalcState.waitingForSecond = false;
            } else if (basicCalcState.display.length <= 1) {
                basicCalcState.display = '0';
            } else {
                basicCalcState.display = basicCalcState.display.slice(0, -1);
            }
            renderBasicCalculator();
            return;
        }

        if (key === '%') {
            var pctVal = parseBasicCalcDisplay();
            if (!Number.isFinite(pctVal)) {
                basicCalcState.display = 'Error';
                setBasicCalcExpression('');
            } else {
                basicCalcState.display = formatBasicCalcResult(pctVal / 100);
            }
            basicCalcState.waitingForSecond = false;
            basicCalcState.justEvaluated = false;
            renderBasicCalculator();
            return;
        }

        if (key === '=' || key === '+' || key === '-' || key === '*' || key === '/') {
            var current = parseBasicCalcDisplay();

            if (key === '=') {
                if (basicCalcState.operator && basicCalcState.first != null) {
                    var eqSecond = basicCalcState.waitingForSecond ? basicCalcState.first : current;
                    var eqResult = applyBasicCalcOperator(basicCalcState.first, eqSecond, basicCalcState.operator);
                    if (!Number.isFinite(eqResult)) {
                        basicCalcState.display = 'Error';
                        setBasicCalcExpression('');
                        basicCalcState.first = null;
                        basicCalcState.operator = null;
                        basicCalcState.waitingForSecond = false;
                        basicCalcState.justEvaluated = false;
                        renderBasicCalculator();
                        return;
                    }
                    setBasicCalcExpression(
                        formatBasicCalcDisplayText(formatBasicCalcResult(basicCalcState.first)) +
                        ' ' + basicCalcOpSymbol(basicCalcState.operator) + ' ' +
                        formatBasicCalcDisplayText(formatBasicCalcResult(eqSecond)) + ' ='
                    );
                    basicCalcState.display = formatBasicCalcResult(eqResult);
                    basicCalcState.first = eqResult;
                    basicCalcState.operator = null;
                    basicCalcState.waitingForSecond = false;
                    basicCalcState.justEvaluated = true;
                }
                renderBasicCalculator();
                return;
            }

            // Operator pressed
            if (basicCalcState.operator && basicCalcState.first != null && !basicCalcState.waitingForSecond && !basicCalcState.justEvaluated) {
                var chainResult = applyBasicCalcOperator(basicCalcState.first, current, basicCalcState.operator);
                if (!Number.isFinite(chainResult)) {
                    basicCalcState.display = 'Error';
                    setBasicCalcExpression('');
                    basicCalcState.first = null;
                    basicCalcState.operator = null;
                    basicCalcState.waitingForSecond = false;
                    basicCalcState.justEvaluated = false;
                    renderBasicCalculator();
                    return;
                }
                basicCalcState.display = formatBasicCalcResult(chainResult);
                basicCalcState.first = chainResult;
            } else if (!basicCalcState.justEvaluated || basicCalcState.first == null) {
                basicCalcState.first = current;
            }

            basicCalcState.operator = key;
            basicCalcState.waitingForSecond = true;
            basicCalcState.justEvaluated = false;
            setBasicCalcExpression(
                formatBasicCalcDisplayText(formatBasicCalcResult(basicCalcState.first)) +
                ' ' + basicCalcOpSymbol(key)
            );
            renderBasicCalculator();
            return;
        }

        if (key === '.') {
            if (basicCalcState.justEvaluated) {
                basicCalcState.display = '0.';
                basicCalcState.first = null;
                basicCalcState.operator = null;
                setBasicCalcExpression('');
                basicCalcState.justEvaluated = false;
                basicCalcState.waitingForSecond = false;
            } else if (basicCalcState.waitingForSecond) {
                basicCalcState.display = '0.';
                basicCalcState.waitingForSecond = false;
            } else if (basicCalcState.display.indexOf('.') === -1) {
                basicCalcState.display += '.';
            }
            renderBasicCalculator();
            return;
        }

        if (/^\d$/.test(key)) {
            if (basicCalcState.justEvaluated) {
                basicCalcState.display = key;
                basicCalcState.first = null;
                basicCalcState.operator = null;
                setBasicCalcExpression('');
                basicCalcState.justEvaluated = false;
                basicCalcState.waitingForSecond = false;
            } else if (basicCalcState.waitingForSecond || basicCalcState.display === '0' || basicCalcState.display === 'Error') {
                basicCalcState.display = key;
                basicCalcState.waitingForSecond = false;
            } else if (basicCalcState.display.replace(/[^\d]/g, '').length < 16) {
                basicCalcState.display += key;
            }
            renderBasicCalculator();
        }
    }

    function syncSettlementEditPanelBeforeCopy($panel) {
        if (!$panel || !$panel.length) {
            return;
        }
        formatInputWithCommas($panel.find('[data-field="rolling"]'));
        formatRollingRateInput($panel.find('[data-field="rollingRate"]'));
        recalcSettlementEditPanelTotals($panel);
    }

    function getSettlementEditPanelSlipBody($panel) {
        if (!$panel || !$panel.length) {
            return null;
        }
        return $panel.find('.settlement-edit-receipt-copy-area')[0] || null;
    }

    function wireSettlementEditPanelCopyButtons($panel) {
        if (!$panel || !$panel.length) {
            return;
        }

        $panel.find('.js-copy-settlement-slip-image').off('click.settlementEditCopy').on('click.settlementEditCopy', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = $(this);
            syncSettlementEditPanelBeforeCopy($panel);
            var slipBody = getSettlementEditPanelSlipBody($panel);
            if (!slipBody) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Receipt is not ready.', confirmButtonText: 'OK' });
                }
                return;
            }
            if (typeof window.copyGameReceiptSlipImage === 'function') {
                window.copyGameReceiptSlipImage(slipBody, $btn);
                return;
            }
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Image copy is not available.', confirmButtonText: 'OK' });
            }
        });

        $panel.find('.js-copy-settlement-slip-text').off('click.settlementEditCopy').on('click.settlementEditCopy', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = $(this);
            syncSettlementEditPanelBeforeCopy($panel);
            copySettlementReceiptSlipTextButton(getSettlementEditPanelSlipBody($panel), $btn);
        });
    }

    function placeSettlementEditButton($modal, inCopyRow) {
        var $editBtn = $modal.find('#edit-settlement-btn');
        if (inCopyRow) {
            $editBtn.detach().appendTo($modal.find('.settlement-main-content .settlement-copy-row'));
            return;
        }
        $editBtn.detach().insertAfter($modal.find('#submit-settlement-btn'));
    }

    function setSettlementEditMode($modal, enabled) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var isSettled = Number($modal.data('is-settled')) === 1;
        var $editBtn = $modal.find('#edit-settlement-btn');
        var $settleBtn = $modal.find('#submit-settlement-btn');
        var $cluster = $modal.find('#settlement-modal-cluster');
        var $guestPanel = $modal.find('#settlement-edit-guest-panel');
        var $agentPanel = $modal.find('#settlement-edit-agent-panel');
        var $calculatorPanel = $modal.find('#settlement-calculator-panel');
        var $basicCalcPanel = $modal.find('#settlement-basic-calc-panel');

        $modal.data('settlement-edit-mode', enabled ? 1 : 0);
        $cluster.toggleClass('is-edit-mode', enabled);

        if (enabled) {
            buildSettlementEditPanelReceipt($modal, 'guest');
            buildSettlementEditPanelReceipt($modal, 'agent');
            wireSettlementEditPanelCopyButtons($guestPanel);
            wireSettlementEditPanelCopyButtons($agentPanel);
            $guestPanel.removeClass('d-none').attr('aria-hidden', 'false');
            $agentPanel.removeClass('d-none').attr('aria-hidden', 'false');
            $calculatorPanel.removeClass('d-none').attr('aria-hidden', 'false');
            $basicCalcPanel.removeClass('d-none').attr('aria-hidden', 'false');
            $modal.removeData('calculator-split-active');
            $modal.removeData('calculator-split-touched');
            refreshSettlementCalculator($modal);
            resetBasicCalculator();
            $editBtn.text('Done');
            $settleBtn.hide();
            $modal.find('#print-settlement-btn').hide();
            $modal.find('.settlement-footer-actions').hide();
            $modal.find('.deposit-cashout-row').hide();
            placeSettlementEditButton($modal, true);
        } else {
            $guestPanel.addClass('d-none').attr('aria-hidden', 'true');
            $agentPanel.addClass('d-none').attr('aria-hidden', 'true');
            $calculatorPanel.addClass('d-none').attr('aria-hidden', 'true');
            $basicCalcPanel.addClass('d-none').attr('aria-hidden', 'true');
            $modal.find('#settlement-edit-guest-body, #settlement-edit-agent-body').empty();
            resetSettlementCalculator($modal);
            $editBtn.text('Edit');
            placeSettlementEditButton($modal, false);
            $modal.find('.settlement-footer-actions').show();
            $modal.find('#print-settlement-btn').show();
            $settleBtn.show();
            if (isSettled) {
                $settleBtn.prop('disabled', true).text('Settled');
            } else {
                $settleBtn.prop('disabled', false).text('Settle');
            }
            $modal.find('.deposit-cashout-row').toggle(!isSettled);
        }
    }

    function resetSettlementModalView($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        if (Number($modal.data('settlement-edit-mode')) === 1) {
            setSettlementEditMode($modal, false);
        }

        var isSettled = Number($modal.data('is-settled')) === 1;
        var $settleBtn = $modal.find('#submit-settlement-btn');

        $settleBtn.show();
        if (isSettled) {
            $settleBtn.prop('disabled', true).text('Settled');
        } else {
            $settleBtn.prop('disabled', false).text('Settle');
        }

        $modal.find('.deposit-cashout-row').toggle(!isSettled);
        $modal.find('#print-settlement-btn').show();
        $modal.find('.settlement-footer-actions').show();
        placeSettlementEditButton($modal, false);
        $modal.find('#edit-settlement-btn').text('Edit').prop('disabled', false);
        $modal.find('#buyIn, #chipsReturn, #winLoss, #rolling, #rollingRate').prop('readonly', true);
        $modal.find('.settlement-service-amount').prop('readonly', true);
        refreshSettlementReceiptDisplay($modal);
        updateSettlementCopyButtons($modal);
    }

    $('#modal-settlement').on('shown.bs.modal', function() {
        resetSettlementModalView($(this));
    });

    $('#modal-settlement').on('hidden.bs.modal', function() {
        resetSettlementModalView($(this));
    });

    $('#edit-settlement-btn').on('click', function() {
        var $modal = $('#modal-settlement');
        var inEditMode = Number($modal.data('settlement-edit-mode')) === 1;
        setSettlementEditMode($modal, !inEditMode);
    });

    $('#modal-settlement').on('click', '.js-settlement-edit-panel-close', function() {
        setSettlementEditMode($('#modal-settlement'), false);
    });

    $('#modal-settlement').on('input', '#calc-split-pct', function() {
        var $modal = $('#modal-settlement');
        var splitPct = clampSettlementSplitPct($(this).val());
        $modal.data('calculator-split-touched', 1);
        if (splitPct > 0) {
            $modal.data('calculator-split-active', 1);
        } else {
            $modal.removeData('calculator-split-active');
        }
        refreshSettlementCalculator($modal);
    });

    $('#modal-settlement').on('blur', '#calc-split-pct', function() {
        var $modal = $('#modal-settlement');
        var splitPct = clampSettlementSplitPct($(this).val());
        $modal.data('calculator-split-touched', 1);
        if (splitPct > 0) {
            $modal.data('calculator-split-active', 1);
        } else {
            $modal.removeData('calculator-split-active');
        }
        $(this).val(String(splitPct).replace(/\.0+$/, ''));
        refreshSettlementCalculator($modal);
    });

    $('#modal-settlement').on('click', '#settlement-basic-calc [data-calc-key]', function(e) {
        e.preventDefault();
        var $calc = $('#settlement-basic-calc');
        $calc.addClass('is-focused').trigger('focus');
        handleBasicCalcKey(String($(this).attr('data-calc-key') || ''));
    });

    $('#modal-settlement').on('mousedown', '#settlement-basic-calc-panel', function(e) {
        if ($(e.target).closest('.btn-close, [data-calc-key]').length) {
            return;
        }
        e.preventDefault();
        $('#settlement-basic-calc').addClass('is-focused').trigger('focus');
    });

    $('#modal-settlement').on('focusin', '#settlement-basic-calc', function() {
        $(this).addClass('is-focused');
    });

    $('#modal-settlement').on('focusout', '#settlement-basic-calc', function() {
        var $calc = $(this);
        setTimeout(function() {
            if (!$calc.is(':focus') && !$calc.find(':focus').length) {
                $calc.removeClass('is-focused');
            }
        }, 0);
    });

    $('#modal-settlement').on('keydown', '#settlement-basic-calc', function(e) {
        if ($(e.target).is('input, textarea, select') || $(e.target).is('[contenteditable="true"]')) {
            return;
        }

        var mapped = null;
        var key = e.key;

        if (key >= '0' && key <= '9') {
            mapped = key;
        } else if (key === '.' || key === ',') {
            mapped = '.';
        } else if (key === '+' || key === '-' || key === '*' || key === '/' || key === '%' || key === '=') {
            mapped = key;
        } else if (key === 'Enter') {
            mapped = '=';
        } else if (key === 'Escape') {
            mapped = 'C';
        } else if (key === 'Backspace') {
            mapped = 'BS';
        } else if (key === 'Delete') {
            mapped = 'CE';
        } else if (key === 'c' || key === 'C') {
            mapped = 'C';
        }

        if (!mapped) {
            return;
        }

        e.preventDefault();
        e.stopPropagation();
        handleBasicCalcKey(mapped);
    });

    $('#modal-settlement').on('input', '.settlement-edit-panel [data-field="rolling"], .settlement-edit-panel [data-field="rollingRate"]', function() {
        var $input = $(this);
        var $panel = $input.closest('.settlement-edit-panel');
        if ($input.attr('data-field') === 'rolling') {
            formatInputWithCommasLive($input);
            syncCounterpartRolling($panel, false);
            return;
        }
        recalcSettlementEditPanelTotals($panel);
    });

    $('#modal-settlement').on('blur', '.settlement-edit-panel [data-field="rolling"]', function() {
        var $input = $(this);
        var $panel = $input.closest('.settlement-edit-panel');
        formatInputWithCommas($input);
        syncCounterpartRolling($panel, true);
    });

    $('#modal-settlement').on('blur', '.settlement-edit-panel [data-field="rollingRate"]', function() {
        formatRollingRateInput($(this));
        recalcSettlementEditPanelTotals($(this).closest('.settlement-edit-panel'));
    });

    $('#print-settlement-btn').on('click', function() {
        var $modal = $(this).closest('.modal');
        syncServiceTotalAndPayment($modal);
        openReceiptPrintWindow($modal);
    });

    $('#modal-settlement').on('click', '.settlement-main-content .js-copy-settlement-slip-image', function(e) {
        e.preventDefault();
        var $btn = $(this);
        var slipBody = document.getElementById('settlement-receipt-copy-area');
        if (typeof window.copyGameReceiptSlipImage === 'function') {
            window.copyGameReceiptSlipImage(slipBody, $btn);
            return;
        }
        if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Image copy is not available.', confirmButtonText: 'OK' });
        }
    });

    $('#modal-settlement').on('click', '.settlement-main-content .js-copy-settlement-slip-text', function(e) {
        e.preventDefault();
        var $btn = $(this);
        var slipBody = document.getElementById('settlement-receipt-copy-area');
        copySettlementReceiptSlipTextButton(slipBody, $btn);
    });
});
</script>