<script>
$(document).ready(function() {
    function cleanValue(value) {
        if (value === undefined || value === null) {
            return '0';
        }

        var text = String(value).trim();
        return text.length ? text : '0';
    }

    function parseAmount(value) {
        var num = parseFloat(String(value || '').replace(/,/g, '').trim());
        return isNaN(num) ? 0 : num;
    }

    function formatAmount(value) {
        // parseAmount strips commas — Number("2,600") is NaN and was showing as Add Charge
        return parseAmount(value).toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });
    }

    function formatSettlementDueDisplay(value) {
        var num = parseAmount(value);
        if (!num) {
            return { text: '0', negative: false };
        }
        return {
            text: '(' + formatAmount(Math.abs(num)) + ')',
            negative: true
        };
    }

    function formatSettlementRateDisplay(value) {
        var raw = String(value == null ? '' : value).replace(/,/g, '').trim();
        if (!raw) {
            return '';
        }
        return raw.indexOf('%') !== -1 ? raw : raw + '%';
    }

    function syncSettlementDateTimeDisplay($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var dateText = cleanValue($modal.find('#date').text());
        var timeText = cleanValue($modal.find('#time').text());
        var formatted = formatReceiptDateTime(dateText, timeText);
        if (/^\d{4}-\d{2}-\d{2}$/.test(dateText) && timeText) {
            var parts = dateText.split('-');
            formatted = parts[0] + '-' + parseInt(parts[1], 10) + '-' + parseInt(parts[2], 10) + ' ' + timeText;
        }
        $modal.find('#dateTime').text(formatted);
    }
    window.syncSettlementDateTimeDisplay = syncSettlementDateTimeDisplay;

    function refreshSettlementReceiptDisplay($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        syncSettlementDateTimeDisplay($modal);

        var settlementDisplay = formatSettlementDueDisplay($modal.find('#rollingSettlement').val());
        $modal.find('#rollingSettlementDisplay .settlement-receipt-amount')
            .text(settlementDisplay.text)
            .toggleClass('is-negative', settlementDisplay.negative);

        var paymentDisplay = formatSettlementDueDisplay($modal.find('#payment').val());
        $modal.find('#paymentDisplay .settlement-receipt-amount')
            .text(paymentDisplay.text)
            .toggleClass('is-negative', paymentDisplay.negative);

        $modal.find('#addChargeDisplay .settlement-receipt-amount').text(formatAmount($modal.find('#fb').val()));

        var $rate = $modal.find('#rollingRate');
        if ($rate.prop('readonly')) {
            $rate.val(formatSettlementRateDisplay($rate.val()));
        }
    }
    window.refreshSettlementReceiptDisplay = refreshSettlementReceiptDisplay;

    function setSettlementAccountDisplay($modal, agentCode, agentName) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var code = String(agentCode == null ? '' : agentCode).trim();
        var name = String(agentName == null ? '' : agentName).trim();
        var full = code ? (code + (name ? ' - ' + name : '')) : (name || 'N/A');
        var prefix = code ? (code + ' - ') : '';
        $modal.find('#accNo').text(full);
        $modal.find('#accNoPrefix').text(prefix);
        $modal.find('#accNoName').text(name);
        $modal.find('.settlement-receipt-prefix-ghost').text(prefix);
    }
    window.setSettlementAccountDisplay = setSettlementAccountDisplay;

    function buildSettlementReceiptSlipText(slipBodyEl) {
        if (!slipBodyEl) {
            return '';
        }

        var lines = [];
        slipBodyEl.querySelectorAll('.settlement-receipt-row').forEach(function(row) {
            var labelEl = row.querySelector('.settlement-receipt-label');
            var labelText = labelEl ? labelEl.textContent.replace(/\s+/g, ' ').trim() : '';
            if (!labelText) {
                return;
            }

            var value = '';
            var input = row.querySelector('.settlement-receipt-input');
            if (input) {
                value = String(input.value || '').trim();
            } else {
                var amountEl = row.querySelector('.settlement-receipt-amount');
                if (amountEl) {
                    value = String(amountEl.textContent || '').replace(/\s+/g, ' ').trim();
                } else {
                    var valueCol = row.querySelector('.settlement-receipt-value-col');
                    if (valueCol) {
                        value = String(valueCol.textContent || '').replace(/\s+/g, ' ').trim();
                    }
                }
            }

            lines.push(labelText + ' : ' + value);
        });

        return lines.join('\n');
    }

    function copySettlementReceiptSlipTextButton(slipBodyEl, $btn) {
        if (!slipBodyEl || !$btn || !$btn.length) {
            return;
        }

        var originalHtml = $btn.html();
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>');

        var text = buildSettlementReceiptSlipText(slipBodyEl);
        if (!text) {
            $btn.prop('disabled', false).html(originalHtml);
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Receipt has no text to copy.', confirmButtonText: 'OK' });
            }
            return;
        }

        if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
            $btn.prop('disabled', false).html(originalHtml);
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Clipboard is not supported in this browser.', confirmButtonText: 'OK' });
            }
            return;
        }

        navigator.clipboard.writeText(text)
            .then(function() {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Copied!',
                        text: 'Receipt text copied. You can paste it anywhere.',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            })
            .catch(function(err) {
                var msg = (err && err.message) ? err.message : 'Unable to copy receipt text.';
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Copy failed', text: msg, confirmButtonText: 'OK' });
                }
            })
            .finally(function() {
                $btn.prop('disabled', false).html(originalHtml);
            });
    }

    function updateSettlementCopyButtons($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        $modal.find('.settlement-copy-row').attr('aria-hidden', 'false');
    }
    window.updateSettlementCopyButtons = updateSettlementCopyButtons;

    function formatReceiptDateTime(dateText, timeText) {
        var dateValue = String(dateText || '').trim();
        var timeValue = String(timeText || '').trim();
        var formattedDate = dateValue;
        var formattedTime = timeValue;

        if (/^\d{4}-\d{2}-\d{2}$/.test(dateValue)) {
            var dateParts = dateValue.split('-');
            formattedDate = dateParts[1] + '/' + dateParts[2] + '/' + dateParts[0];
        }

        if (/^\d{2}:\d{2}:\d{2}$/.test(timeValue)) {
            formattedTime = timeValue.slice(0, 5);
        }

        return cleanValue(formattedDate + ' ' + formattedTime);
    }

    function replaceSettlementPrintInput($clone, inputId, value, bold) {
        var $cloneInput = $clone.find('#' + inputId);
        if (!$cloneInput.length) {
            return;
        }

        var $valueSpan = $('<span class="settlement-receipt-amount settlement-receipt-print-value"></span>').text(value);
        if (bold) {
            $valueSpan.css('font-weight', '700');
        }

        var $amountWrap = $cloneInput.closest('.settlement-receipt-amount');
        if ($amountWrap.length) {
            $amountWrap.replaceWith($valueSpan);
        } else {
            $cloneInput.replaceWith($valueSpan);
        }
    }

    function buildSettlementReceiptPrintNode($modal) {
        refreshSettlementReceiptDisplay($modal);
        var $source = $modal.find('#settlement-receipt-copy-area');
        var $clone = $source.clone();
        $clone.removeAttr('id');

        replaceSettlementPrintInput($clone, 'buyIn', String($source.find('#buyIn').val() || '').trim(), false);
        replaceSettlementPrintInput($clone, 'chipsReturn', String($source.find('#chipsReturn').val() || '').trim(), false);
        replaceSettlementPrintInput($clone, 'winLoss', String($source.find('#winLoss').val() || '').trim(), true);
        replaceSettlementPrintInput($clone, 'rolling', String($source.find('#rolling').val() || '').trim(), true);
        replaceSettlementPrintInput($clone, 'rollingRate', String($source.find('#rollingRate').val() || '').trim(), false);

        $clone.find('[id]').removeAttr('id');
        return $('<div class="settlement-receipt-print-root"></div>').append($clone);
    }

    function getSettlementReceiptPrintStyles() {
        var logoUrl = window.location.origin + '/assets/images/GD-logo.png';
        return [
            '@page{size:auto;margin:8mm;}',
            'html,body{margin:0;padding:0;}',
            'body{font-family:Arial,Helvetica,sans-serif;color:#000;display:flex;justify-content:center;padding:8mm 0;-webkit-print-color-adjust:exact;print-color-adjust:exact;}',
            '.settlement-receipt-print-root{width:100%;display:flex;justify-content:center;}',
            '.settlement-receipt-print-root .settlement-receipt-body{position:relative;font-size:14pt;color:#000;overflow:hidden;min-height:20rem;width:fit-content;min-width:17rem;padding:1.15rem 1.4rem;border:2.5px solid #222;border-radius:0.25rem;display:flex;flex-direction:column;align-items:center;box-sizing:border-box;}',
            '.settlement-receipt-print-root .settlement-receipt-stack{--settlement-label-col:6.75rem;--settlement-value-col:8.5rem;--settlement-receipt-col-gap:0.35rem;width:fit-content;max-width:100%;margin:0 auto;display:flex;flex-direction:column;align-items:center;}',
            '.settlement-receipt-print-root .settlement-receipt-grid{width:100%;margin:0 auto;display:grid;grid-template-columns:var(--settlement-label-col) max-content var(--settlement-value-col);column-gap:var(--settlement-receipt-col-gap);row-gap:0.24rem;align-items:baseline;}',
            '.settlement-receipt-print-root .settlement-receipt-section{display:contents;}',
            '.settlement-receipt-print-root .settlement-receipt-row{display:contents;}',
            '.settlement-receipt-print-root .settlement-receipt-label{grid-column:1;text-align:right;font-weight:700;font-size:14pt;white-space:nowrap;}',
            '.settlement-receipt-print-root .settlement-receipt-colon{grid-column:2;font-weight:700;font-size:14pt;}',
            '.settlement-receipt-print-root .settlement-receipt-value-col{grid-column:3;font-size:14pt;min-width:0;}',
            '.settlement-receipt-print-root .settlement-receipt-grid--meta{--settlement-value-col:max-content;width:fit-content;max-width:100%;}',
            '.settlement-receipt-print-root .settlement-receipt-grid--amounts{width:fit-content;max-width:100%;}',
            '.settlement-receipt-print-root .settlement-receipt-grid--meta .settlement-receipt-value-col{text-align:left;justify-self:start;white-space:nowrap;min-width:max-content;}',
            '.settlement-receipt-print-root .settlement-receipt-grid--amounts .settlement-receipt-value-col--amount{text-align:right;justify-self:stretch;font-variant-numeric:tabular-nums;white-space:nowrap;}',
            '.settlement-receipt-print-root .settlement-receipt-prefix-ghost{display:none;}',
            '.settlement-receipt-print-root .settlement-receipt-amount{display:inline-block;}',
            '.settlement-receipt-print-root .settlement-receipt-print-value{display:inline-block;width:100%;text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums;}',
            '.settlement-receipt-print-root .settlement-receipt-divider{align-self:stretch;border-top:1px solid #c8c8c8;margin:0.55rem 0 0.45rem;height:0;width:100%;}',
            '.settlement-receipt-print-root .settlement-receipt-value-col.is-bold,.settlement-receipt-print-root #winLoss,.settlement-receipt-print-root #rolling{font-weight:700;}',
            '.settlement-receipt-print-root .settlement-receipt-amount.is-negative{color:#dc3545;font-weight:700;}',
            '.settlement-receipt-print-root .settlement-receipt-row--payment{display:grid;grid-column:1 / -1;grid-template-columns:subgrid;column-gap:var(--settlement-receipt-col-gap);background:rgba(253,141,124,0.52);border-radius:0.15rem;padding:0.35rem 0;margin-top:0.35rem;align-items:baseline;}',
            '.settlement-receipt-print-root .settlement-receipt-input{min-width:0;border:none;background:transparent;padding:0;margin:0;font-size:inherit;font-family:inherit;font-weight:inherit;color:inherit;box-shadow:none;outline:none;width:100%;text-align:right;}',
            '.settlement-receipt-print-root .settlement-receipt-watermark{position:absolute;left:50%;top:50%;width:22rem;height:22rem;max-width:92%;max-height:92%;transform:translate(-50%,-50%);background:url("' + logoUrl + '") center center / contain no-repeat;mix-blend-mode:multiply;opacity:0.12;pointer-events:none;z-index:0;user-select:none;}',
