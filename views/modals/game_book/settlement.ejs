        <div class="receipt-row"><span>F&amp;B :</span><span id="printReceiptFnb">0</span></div>
        <div class="receipt-row"><span>Hotel :</span><span id="printReceiptHotel">0</span></div>
        <div class="receipt-row"><span>Incidential :</span><span id="printReceiptIncidential">0</span></div>
