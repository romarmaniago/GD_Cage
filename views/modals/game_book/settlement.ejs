                        <div class="ss-calc-title">Percentage</div>
                        <div>
                            <div class="ss-calc-row"><span>Win/Loss</span><span class="ss-calc-value js-calc-winloss">0</span></div>
                            <div class="ss-calc-row"><span>Rolling</span><span class="ss-calc-value" id="calc-agent-pct-rolling">0</span></div>
                            <div class="ss-calc-row"><span>Percentage</span><span class="ss-calc-value" id="calc-agent-pct-display">0%</span></div>
                            <div class="ss-calc-row"><span>Settlement</span><span class="ss-calc-value" id="calc-agent-pct-settlement">0</span></div>
