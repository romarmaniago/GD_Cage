<style>
    #modal-settlement .settlement-receipt-dialog {
        --bs-modal-width: 460px;
        max-width: 460px;
    }

    #modal-settlement .settlement-receipt-body {
        position: relative;
        font-family: Arial, Helvetica, sans-serif;
        color: #000;
    }

    #modal-settlement .settlement-receipt-grid {
        --settlement-receipt-col-gap: 0.45rem;
        max-width: 380px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(7rem, auto) auto 1fr;
        column-gap: var(--settlement-receipt-col-gap);
        row-gap: 0.18rem;
        align-items: baseline;
        justify-content: center;
    }

    #modal-settlement .settlement-receipt-section {
        display: contents;
    }

    #modal-settlement .settlement-receipt-row {
        display: contents;
    }

    #modal-settlement .settlement-receipt-label {
        grid-column: 1;
        text-align: right;
        font-weight: 700;
        font-size: 0.95rem;
    }

    #modal-settlement .settlement-receipt-colon {
        grid-column: 2;
        font-weight: 700;
        font-size: 0.95rem;
    }

    #modal-settlement .settlement-receipt-value-col {
        grid-column: 3;
        text-align: left;
        font-size: 0.95rem;
        min-width: 0;
    }

    #modal-settlement .settlement-receipt-prefix-ghost {
        visibility: hidden;
        white-space: pre;
        font-weight: 700;
    }

    #modal-settlement .settlement-receipt-value-col--amount {
        white-space: nowrap;
    }

    #modal-settlement .settlement-receipt-value-col.is-bold {
        font-weight: 700;
    }

    #modal-settlement .settlement-receipt-amount.is-negative {
        color: #dc3545;
        font-weight: 700;
    }

    #modal-settlement .settlement-receipt-row--payment {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
        column-gap: var(--settlement-receipt-col-gap);
        background: #ffe5e0;
        border-radius: 0.15rem;
        padding: 0.35rem 0;
        margin-top: 0.35rem;
        align-items: baseline;
    }

    #modal-settlement .settlement-receipt-row--payment .settlement-receipt-label {
        padding-left: 0.5rem;
    }

    #modal-settlement .settlement-receipt-row--payment .settlement-receipt-value-col {
        padding-right: 0.5rem;
    }

    #modal-settlement .settlement-receipt-input {
        width: auto;
        min-width: 4rem;
        border: none;
        background: transparent;
        padding: 0;
        margin: 0;
        font-size: inherit;
        font-family: inherit;
        font-weight: inherit;
        color: inherit;
        text-align: left;
        box-shadow: none;
        outline: none;
    }

    #modal-settlement .settlement-receipt-input:focus {
        box-shadow: none;
        outline: none;
    }

    #modal-settlement #winLoss,
    #modal-settlement #rolling {
        font-weight: 700;
    }

    #modal-settlement .settlement-copy-row {
        display: none !important;
    }

    #modal-settlement .settlement-copy-row.is-visible {
        display: flex !important;
    }

    #modal-settlement .modal-content,
    #modal-settlement .modal-body,
    #modal-settlement .modal-footer {
        background: #fff !important;
    }

    #modal-settlement .modal-body {
        position: relative;
    }

    #modal-settlement .settlement-receipt-watermark {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        height: 100%;
        max-width: 22rem;
        max-height: 22rem;
        background: url("/assets/images/gd-background-logo22.png") center center / contain no-repeat;
        opacity: 0.14;
        pointer-events: none;
        z-index: 0;
        user-select: none;
    }

    #modal-settlement #settlement-receipt-copy-area {
        position: relative;
        overflow: hidden;
        padding: 0.75rem 0.5rem 0.35rem;
        border-radius: 0.2rem;
        min-height: 18rem;
    }

    #modal-settlement #settlement-receipt-copy-area > *:not(.settlement-receipt-watermark) {
        position: relative;
        z-index: 1;
    }

    #modal-settlement .settlement-extra-opts {
        max-width: 380px;
        margin: 0.75rem auto 0;
        text-align: left;
    }

    #modal-settlement .settlement-extra-opts .form-check-label {
        font-size: 0.82rem;
    }

    #modal-settlement #settlement-service-rows {
        display: none;
    }

    #modal-settlement .receipt-print-only { display: none; }

    #modal-settlement .settlement-cutoff-tabs {
        margin: 0;
        padding: 0.75rem 1.5rem;
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        background: #f4f7fb;
        border-bottom: 1px solid #e2e8f0;
    }

    #modal-settlement .settlement-cutoff-tabs .nav-item {
        margin: 0;
    }

    #modal-settlement .settlement-cutoff-tabs .nav-link {
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        padding: 0.5rem 1.15rem;
        color: #5a6a7d;
        border: 1px solid #cfd8e3;
        border-radius: 0.4rem;
        background: #fff;
        line-height: 1.3;
        cursor: pointer;
        transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }

    #modal-settlement .settlement-cutoff-tabs .nav-link:hover:not(.active) {
        color: #0665d0;
        border-color: #9ec5f0;
        background: #eef5fd;
    }

    #modal-settlement .settlement-cutoff-tabs .nav-link.active {
        color: #fff;
        border-color: #0665d0;
        background: #0665d0;
        box-shadow: 0 2px 8px rgba(6, 101, 208, 0.3);
    }

    #modal-settlement .settlement-cutoff-tabs .nav-link:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(6, 101, 208, 0.22);
    }

    #modal-settlement .settlement-cutoff-tabs .nav-link.active:focus {
        box-shadow: 0 2px 8px rgba(6, 101, 208, 0.3), 0 0 0 3px rgba(6, 101, 208, 0.18);
    }

    #modal-settlement #settlement-cutoff-notice {
        margin: 0 1.5rem 0.75rem;
        font-size: 0.8125rem;
    }

    @media print {
        #modal-settlement #add_settlement,
        #modal-settlement .modal-header,
        #modal-settlement .settlement-cutoff-tabs,
        #modal-settlement .modal-footer,
        #modal-settlement .settlement-extra-opts {
            display: none !important;
        }
    }

</style>

<div class="modal fade" id="modal-settlement" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" tabindex="-1" aria-labelledby="modal-settlement-label" aria-hidden="true">
