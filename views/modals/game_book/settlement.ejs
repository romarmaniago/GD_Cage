<script>
$(document).ready(function() {
    function cleanValue(value) {
        if (value === undefined || value === null) {
            return '0';
        }

        var text = String(value).trim();
        return text.length ? text : '0';
    }

    function parseAmount(value) {
        var num = parseFloat(String(value || '').replace(/,/g, '').trim());
        return isNaN(num) ? 0 : num;
    }

    function formatAmount(value) {
        return Number(value || 0).toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });
    }

    function formatSettlementDueDisplay(value) {
        var num = parseAmount(value);
        if (!num) {
            return { text: '0', negative: false };
        }
        return {
            text: '(' + formatAmount(Math.abs(num)) + ')',
            negative: true
        };
    }

    function formatSettlementRateDisplay(value) {
        var raw = String(value == null ? '' : value).replace(/,/g, '').trim();
        if (!raw) {
            return '';
        }
        return raw.indexOf('%') !== -1 ? raw : raw + '%';
    }

    function syncSettlementDateTimeDisplay($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var dateText = cleanValue($modal.find('#date').text());
        var timeText = cleanValue($modal.find('#time').text());
        var formatted = formatReceiptDateTime(dateText, timeText);
        if (/^\d{4}-\d{2}-\d{2}$/.test(dateText) && timeText) {
            var parts = dateText.split('-');
            formatted = parts[0] + '-' + parseInt(parts[1], 10) + '-' + parseInt(parts[2], 10) + ' ' + timeText;
        }
        $modal.find('#dateTime').text(formatted);
    }
