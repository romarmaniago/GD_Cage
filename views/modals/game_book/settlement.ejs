<div class="modal fade" id="modal-settlement-choose-account" tabindex="-1" aria-labelledby="modal-settlement-choose-account-label" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="modal-settlement-choose-account-label"><%= __('modal_settlement.choose_account') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
