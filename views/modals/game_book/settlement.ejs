<script>
$(document).ready(function() {
    function cleanValue(value) {
        if (value === undefined || value === null) {
            return '0';
        }

        var text = String(value).trim();
        return text.length ? text : '0';
    }

    function parseAmount(value) {
        var num = parseFloat(String(value || '').replace(/,/g, '').trim());
        return isNaN(num) ? 0 : num;
    }

    function formatAmount(value) {
        // parseAmount strips commas — Number("2,600") is NaN and was showing as Add Charge
        return parseAmount(value).toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });
    }

    // Settlement / Payment: positive = paid out to the guest → red (x);
    // negative = the guest owes (e.g. a Share part) → plain black, like the game receipts
    function formatSettlementDueDisplay(value) {
        var num = parseAmount(value);
        if (num > 0) {
            return { text: '(' + formatAmount(num) + ')', negative: true };
        }
        return { text: formatAmount(Math.abs(num)), negative: false };
    }

    // Win/Loss: negative shows as (7,000) in red; hidden #winLoss keeps the signed number for calculations
    function renderWinLossDisplay($amount, value) {
        var num = parseAmount(value);
        var text = num < 0 ? '(' + formatAmount(Math.abs(num)) + ')' : formatAmount(num);
        $amount.text(text).toggleClass('is-negative', num < 0);
    }

    function formatSettlementRateDisplay(value) {
        var raw = String(value == null ? '' : value).replace(/,/g, '').trim();
        if (!raw) {
            return '';
        }
        return raw.indexOf('%') !== -1 ? raw : raw + '%';
    }

    function syncSettlementDateTimeDisplay($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var dateText = cleanValue($modal.find('#date').text());
        var timeText = cleanValue($modal.find('#time').text());
        var formatted = formatReceiptDateTime(dateText, timeText);
        if (/^\d{4}-\d{2}-\d{2}$/.test(dateText) && timeText) {
            // Same as game receipts: M/D/YYYY H:mm
            var parts = dateText.split('-');
            var timeParts = timeText.split(':');
            var shortTime = timeParts.length >= 2 ? parseInt(timeParts[0], 10) + ':' + timeParts[1] : timeText;
            formatted = parseInt(parts[1], 10) + '/' + parseInt(parts[2], 10) + '/' + parts[0] + ' ' + shortTime;
        }
        $modal.find('#dateTime').text(formatted);
    }
    window.syncSettlementDateTimeDisplay = syncSettlementDateTimeDisplay;

    // Cash out is chips paid back to the guest — shown as a negative (red, in parentheses)
    function renderCashOutDisplay($amount, value) {
        renderWinLossDisplay($amount, -Math.abs(parseAmount(value)));
    }

    function formatSettlementPct(value) {
        return Number(value || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) + '%';
    }

    function refreshSettlementReceiptDisplay($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        syncSettlementDateTimeDisplay($modal);

        renderWinLossDisplay($modal.find('#winLossDisplay'), $modal.find('#winLoss').val());
        renderCashOutDisplay($modal.find('#chipsReturnDisplay'), $modal.find('#chipsReturn').val());
        // Negative rolling → red (x), like the other amounts
        renderWinLossDisplay($modal.find('#rollingDisplay'), $modal.find('#rolling').val());

        // SHARE / ROLLING % under RATE (see getReceiptRateSplit in commission_calc.js)
        var split = window.getReceiptRateSplit($modal.data('commissionRow'));
        $modal.find('#sharePct').val(formatSettlementPct(split.sharePct));
        $modal.find('#rollingPct').val(formatSettlementPct(split.rollingPct));

        var settlementDisplay = formatSettlementDueDisplay($modal.find('#rollingSettlement').val());
        $modal.find('#rollingSettlementDisplay .settlement-receipt-amount')
            .text(settlementDisplay.text)
            .toggleClass('is-negative', settlementDisplay.negative);

        var paymentDisplay = formatSettlementDueDisplay($modal.find('#payment').val());
        $modal.find('#paymentDisplay .settlement-receipt-amount')
            .text(paymentDisplay.text)
            .toggleClass('is-negative', paymentDisplay.negative);

        $modal.find('#addChargeDisplay .settlement-receipt-amount').text(formatAmount($modal.find('#fb').val()));

        var $rate = $modal.find('#rollingRate');
        if ($rate.prop('readonly')) {
            $rate.val(formatSettlementRateDisplay($rate.val()));
        }
    }
    window.refreshSettlementReceiptDisplay = refreshSettlementReceiptDisplay;

    function setSettlementAccountDisplay($modal, agentCode, agentName, groupName, guestName) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var code = String(agentCode == null ? '' : agentCode).trim();
        var name = String(agentName == null ? '' : agentName).trim();
        var group = String(groupName == null ? '' : groupName).trim();
        var full = code ? (code + (name ? ' - ' + name : '')) : (name || 'N/A');
        $modal.find('#accNo').text(full);
        // Receipt header: "CODE Group" on its own line, name below
        $modal.find('#accNoPrefix').text(code ? (code + (group ? ' ' + group : '')) : '');
        // Receipt shows the guest name; the Agent edit panel uses the agent name (see buildSettlementEditPanelReceipt)
        var guest = String(guestName == null ? '' : guestName).trim();
        if (guest === '-') guest = '';
        $modal.data('settlementAgentName', name);
        $modal.find('#accNoName').text(guest || name);
    }
    window.setSettlementAccountDisplay = setSettlementAccountDisplay;

    function setSettlementGameDisplay($modal, gameType, linkedGameId) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var type = String(gameType == null ? '' : gameType).trim().toUpperCase();
        var linked = parseInt(linkedGameId, 10);
        $modal.find('#gameType')
            .text(type)
            .toggleClass('settlement-game-type--live', type === 'LIVE');
        $modal.find('#gameNoLinked').text(linked ? ' (#' + linked + ')' : '');
    }
    window.setSettlementGameDisplay = setSettlementGameDisplay;

    function buildSettlementReceiptSlipText(slipBodyEl) {
        if (!slipBodyEl) {
            return '';
        }

        // Same layout as the game receipt copy text: header + date, account block, then the
        // amount rows (rows sharing data-text-block print together; RATE / SHARE rows are skipped)
        var textOf = function(selector) {
            var el = slipBodyEl.querySelector(selector);
            return el ? String(el.textContent || '').replace(/\s+/g, ' ').trim() : '';
        };
        var dateText = textOf('.ss-date');
        var dt = typeof moment === 'function' ? moment(dateText, 'M/D/YYYY H:mm', true) : null;
        var blocks = [
            [textOf('.ss-header'), dt && dt.isValid() ? dt.format('YYYY-MM-DD HH:mm') : dateText],
            [
                textOf('.ss-account').toUpperCase(),
                textOf('.ss-guest').toUpperCase(),
                // "#" before the game no. is CSS-only on the card
                [textOf('.settlement-game-type'), '#' + textOf('.ss-game-no') + textOf('.ss-game-linked')].filter(Boolean).join(' ')
            ]
        ];

        var prevBlock = null;
        slipBodyEl.querySelectorAll('.ss-row[data-text-label]').forEach(function(row) {
            var input = row.querySelector('.settlement-receipt-input');
            var amountEl = row.querySelector('.settlement-receipt-amount');
            var value = input ? String(input.value || '').trim() : (amountEl ? String(amountEl.textContent || '').trim() : '');
            var line = row.getAttribute('data-text-label') + ' ' + value;
            var block = row.getAttribute('data-text-block');
            if (block && block === prevBlock) blocks[blocks.length - 1].push(line);
            else blocks.push([line]);
            prevBlock = block;
        });

        return blocks.map(function(b) {
            return b.filter(Boolean).join('\n');
        }).join('\n\n');
    }

    function copySettlementReceiptSlipTextButton(slipBodyEl, $btn) {
        if (!slipBodyEl || !$btn || !$btn.length) {
            return;
        }

        var originalHtml = $btn.html();
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>');

        var text = buildSettlementReceiptSlipText(slipBodyEl);
        if (!text) {
            $btn.prop('disabled', false).html(originalHtml);
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Receipt has no text to copy.', confirmButtonText: 'OK' });
            }
            return;
        }

        if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
            $btn.prop('disabled', false).html(originalHtml);
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Clipboard is not supported in this browser.', confirmButtonText: 'OK' });
            }
            return;
        }

        navigator.clipboard.writeText(text)
            .then(function() {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Copied!',
                        text: 'Receipt text copied. You can paste it anywhere.',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            })
            .catch(function(err) {
                var msg = (err && err.message) ? err.message : 'Unable to copy receipt text.';
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Copy failed', text: msg, confirmButtonText: 'OK' });
                }
            })
            .finally(function() {
                $btn.prop('disabled', false).html(originalHtml);
            });
    }

    function updateSettlementCopyButtons($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        $modal.find('.settlement-copy-row').attr('aria-hidden', 'false');
    }
    window.updateSettlementCopyButtons = updateSettlementCopyButtons;

    function formatReceiptDateTime(dateText, timeText) {
        var dateValue = String(dateText || '').trim();
        var timeValue = String(timeText || '').trim();
        var formattedDate = dateValue;
        var formattedTime = timeValue;

        if (/^\d{4}-\d{2}-\d{2}$/.test(dateValue)) {
            var dateParts = dateValue.split('-');
            formattedDate = dateParts[1] + '/' + dateParts[2] + '/' + dateParts[0];
        }

        if (/^\d{2}:\d{2}:\d{2}$/.test(timeValue)) {
            formattedTime = timeValue.slice(0, 5);
        }

        return cleanValue(formattedDate + ' ' + formattedTime);
    }

    function replaceSettlementPrintInput($clone, inputId, value, bold) {
        var $cloneInput = $clone.find('#' + inputId);
        if (!$cloneInput.length) {
            return;
        }

        var $valueSpan = $('<span class="settlement-receipt-amount settlement-receipt-print-value"></span>').text(value);
        if (bold) {
            $valueSpan.css('font-weight', '700');
        }

        var $amountWrap = $cloneInput.closest('.settlement-receipt-amount');
        if ($amountWrap.length) {
            $amountWrap.replaceWith($valueSpan);
        } else {
            $cloneInput.replaceWith($valueSpan);
        }
    }

    function buildSettlementReceiptPrintNode($modal) {
        refreshSettlementReceiptDisplay($modal);
        var $source = $modal.find('#settlement-receipt-copy-area');
        var $clone = $source.clone();
        $clone.removeAttr('id');

        replaceSettlementPrintInput($clone, 'buyIn', String($source.find('#buyIn').val() || '').trim(), false);
        $clone.find('#chipsReturn, #winLoss, #rolling').remove();
        replaceSettlementPrintInput($clone, 'rollingRate', String($source.find('#rollingRate').val() || '').trim(), false);

        $clone.find('[id]').removeAttr('id');
        return $('<div class="settlement-receipt-print-root"></div>').append($clone);
    }

    // Print uses the same receipt styles as the modal (_settlement_slip_styles.ejs), at receipt width
    function getSettlementReceiptPrintStyles() {
        var slipStylesEl = document.querySelector('style[data-settlement-slip-styles]');
        var slipStyles = slipStylesEl ? slipStylesEl.textContent : '';
        // The print iframe has no base URL — make the watermark URL absolute
        slipStyles = slipStyles.replace(/url\('\/assets\//g, "url('" + window.location.origin + '/assets/');
        return [
            '@page{size:auto;margin:8mm;}',
            'html,body{margin:0;padding:0;}',
            'body{display:flex;justify-content:center;padding:8mm 0;-webkit-print-color-adjust:exact;print-color-adjust:exact;}',
            '.settlement-receipt-print-root{width:26.25rem;border:1px solid #222;}',
            slipStyles
        ].join('');
    }

    function openReceiptPrintWindow($modal) {
        var receiptHtml = buildSettlementReceiptPrintNode($modal).prop('outerHTML');
        var iframe = document.createElement('iframe');
        iframe.style.position = 'fixed';
        iframe.style.right = '0';
        iframe.style.bottom = '0';
        iframe.style.width = '0';
        iframe.style.height = '0';
        iframe.style.border = '0';
        iframe.setAttribute('aria-hidden', 'true');
        document.body.appendChild(iframe);

        var iframeDoc = iframe.contentWindow.document;
        iframeDoc.open();
        iframeDoc.write('<!doctype html><html><head><title>Settlement Receipt</title><style>' + getSettlementReceiptPrintStyles() + '</style></head><body>' + receiptHtml + '</body></html>');
        iframeDoc.close();

        setTimeout(function() {
            iframe.contentWindow.focus();
            iframe.contentWindow.print();
            setTimeout(function() {
                if (iframe && iframe.parentNode) {
                    iframe.parentNode.removeChild(iframe);
                }
            }, 500);
        }, 300);
    }

    function syncServiceTotalAndPayment($modal) {
        var servicesTotal = 0;
        $modal.find('.settlement-service-amount').each(function () {
            servicesTotal += parseAmount($(this).val());
        });
        var settlement = parseAmount($modal.find('#rollingSettlement').val());
        var payment = settlement - servicesTotal;

        $modal.find('#fb').val(formatAmount(servicesTotal));
        $modal.find('#payment').val(formatAmount(payment));
        refreshSettlementReceiptDisplay($modal);
    }

    function formatInputWithCommas($input) {
        var raw = String($input.val() || '').replace(/,/g, '').trim();
        if (!raw) {
            $input.val('');
            return;
        }

        var allowNegative = $input.attr('data-allow-negative') === '1';
        var isNegative = allowNegative && raw.startsWith('-');
        var normalized = raw.replace(/[^\d.]/g, '');
        var firstDot = normalized.indexOf('.');
        if (firstDot !== -1) {
            normalized = normalized.slice(0, firstDot + 1) + normalized.slice(firstDot + 1).replace(/\./g, '');
        }

        if (isNegative && normalized) {
            normalized = '-' + normalized;
        }

        var num = parseFloat(normalized);
        if (isNaN(num)) {
            return;
        }

        $input.val(num.toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        }));
    }

    // Live comma formatting while typing (preserves caret by digit count)
    function formatInputWithCommasLive($input) {
        var el = $input && $input[0];
        if (!el) {
            return;
        }

        var raw = String(el.value || '');
        var caret = typeof el.selectionStart === 'number' ? el.selectionStart : raw.length;
        var digitsBeforeCaret = raw.slice(0, caret).replace(/[^\d]/g, '').length;

        formatInputWithCommas($input);

        var formatted = String(el.value || '');
        if (!formatted) {
            return;
        }

        var pos = 0;
        var seen = 0;
        while (pos < formatted.length && seen < digitsBeforeCaret) {
            if (/\d/.test(formatted.charAt(pos))) {
                seen++;
            }
            pos++;
        }
        try {
            el.setSelectionRange(pos, pos);
        } catch (e) { /* ignore */ }
    }

    function formatRollingRateInput($input) {
        var raw = String($input.val() || '').replace(/,/g, '').trim();
        if (!raw) {
            $input.val('');
            return;
        }
        var normalized = raw.replace(/[^\d.]/g, '');
        var dot = normalized.indexOf('.');
        if (dot !== -1) {
            normalized = normalized.slice(0, dot + 1) + normalized.slice(dot + 1).replace(/\./g, '');
        }
        var intPart = dot === -1 ? normalized : normalized.slice(0, dot);
        var fracPart = dot === -1 ? null : normalized.slice(dot + 1);
        if (intPart === '' && dot === -1 && (fracPart === null || fracPart === '')) {
            $input.val('');
            return;
        }
        var intNum = parseInt(intPart === '' ? '0' : intPart, 10);
        if (isNaN(intNum)) {
            intNum = 0;
        }
        var intStr = intNum.toLocaleString('en-US');
        if (dot !== -1) {
            $input.val(intStr + '.' + (fracPart === null ? '' : fracPart));
            return;
        }
        var num = parseFloat(normalized);
        if (isNaN(num)) {
            return;
        }
        $input.val(num.toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 4
        }));
    }

    function refreshSettlementEditPanelDisplay($panel) {
        if (!$panel || !$panel.length) {
            return;
        }

        var settlementVal = parseAmount($panel.data('rolling-settlement'));
        var paymentVal = parseAmount($panel.data('payment'));
        var addChargeVal = parseAmount($panel.data('add-charge'));

        var settlementDisplay = formatSettlementDueDisplay(settlementVal);
        $panel.find('[data-field="rollingSettlementDisplay"] .settlement-receipt-amount')
            .text(settlementDisplay.text)
            .toggleClass('is-negative', settlementDisplay.negative);

        var paymentDisplay = formatSettlementDueDisplay(paymentVal);
        $panel.find('[data-field="paymentDisplay"] .settlement-receipt-amount')
            .text(paymentDisplay.text)
            .toggleClass('is-negative', paymentDisplay.negative);

        // Guest types its Add Charge; Agent shows the remainder
        if (!$panel.find('[data-field="addCharge"]').length) {
            $panel.find('[data-field="addChargeDisplay"] .settlement-receipt-amount').text(formatAmount(addChargeVal));
        }

        var $rate = $panel.find('[data-field="rollingRate"]');
        if (!$rate.prop('readonly')) {
            $rate.val(formatSettlementRateDisplay($rate.val()));
        }
    }

    // Add Charge (F&B / Hotel) split: Guest keeps what is typed in its box (default: all of it),
    // Agent takes the rest, so Guest + Agent always equals the main Add Charge.
    function getSettlementPanelAddCharge($panel) {
        var $modal = $('#modal-settlement');
        var total = parseAmount($modal.find('#fb').val());
        var $guestInput = $modal.find('#settlement-edit-guest-panel [data-field="addCharge"]');
        var guestCharge = $guestInput.length ? Math.max(0, Math.min(total, parseAmount($guestInput.val()))) : total;
        return $panel.is('#settlement-edit-guest-panel') ? guestCharge : total - guestCharge;
    }

    // Panel SHARE / ROLLING %: what is typed in the panel, else the game's own split
    function getSettlementPanelSplit($panel) {
        var $share = $panel ? $panel.find('[data-field="sharePct"]') : $();
        var $rolling = $panel ? $panel.find('[data-field="rollingPct"]') : $();
        if (!$share.length || !$rolling.length) {
            return window.getReceiptRateSplit($('#modal-settlement').data('commissionRow'));
        }
        return { sharePct: parseAmount($share.val()), rollingPct: parseAmount($rolling.val()) };
    }

    function recalcSettlementEditPanelTotals($panel) {
        if (!$panel || !$panel.length) {
            return;
        }

        var rolling = parseAmount($panel.find('[data-field="rolling"]').val());
        var rate = parseAmount($panel.find('[data-field="rollingRate"]').val());
        var split = getSettlementPanelSplit($panel);
        var addCharge = getSettlementPanelAddCharge($panel);
        var winLoss = parseAmount($panel.find('[data-field="winLoss"]').val());
        var totalRolling = parseAmount($('#modal-settlement').find('#rolling').val());
        var settlement = window.computeSplitPanelSettlement(winLoss, rolling, rate, split.sharePct, split.rollingPct, totalRolling);
        var payment = settlement - addCharge;

        $panel.data('add-charge', addCharge);

        $panel.data('rolling-settlement', settlement);
        $panel.data('payment', payment);
        refreshSettlementEditPanelDisplay($panel);
    }

    function buildSettlementEditPanelReceipt($mainModal, panelKey) {
        var $source = $mainModal.find('#settlement-receipt-copy-area').clone(false);
        $source.removeAttr('id').addClass('settlement-edit-receipt-copy-area');

        // Panel copies get unique ids; data-field keeps the original id for lookups
        $source.find('[id]').each(function() {
            var oldId = this.id;
            this.id = 'settlement-' + panelKey + '-' + oldId;
            $(this).attr('data-field', oldId);
        });
        // Panel copies are not part of the settlement form
        $source.find('input[name]').removeAttr('name');

        var $panelBody = $('#settlement-edit-' + panelKey + '-body');
        $panelBody.empty().append($source);

        var $panel = $panelBody.closest('.settlement-edit-panel');
        $panel.data('rolling-settlement', parseAmount($mainModal.find('#rollingSettlement').val()));
        $panel.data('payment', parseAmount($mainModal.find('#payment').val()));

        $panel.find('[data-field="accNoPrefix"]').text($mainModal.find('#accNoPrefix').text());
        $panel.find('[data-field="accNoName"]').text(
            panelKey === 'agent' && $mainModal.data('settlementAgentName')
                ? $mainModal.data('settlementAgentName')
                : $mainModal.find('#accNoName').text()
        );
        $panel.find('[data-field="gameNo"]').text($mainModal.find('#gameNo').text());
        $panel.find('[data-field="gameNoLinked"]').text($mainModal.find('#gameNoLinked').text());
        $panel.find('[data-field="dateTime"]').text($mainModal.find('#dateTime').text());
        $panel.find('[data-field="buyIn"]').val($mainModal.find('#buyIn').val()).prop('readonly', true);
        $panel.find('[data-field="chipsReturn"]').val($mainModal.find('#chipsReturn').val()).prop('readonly', true);

        var houseWinLoss = parseAmount($mainModal.find('#winLoss').val());
        var $winLoss = $panel.find('[data-field="winLoss"]');
        $winLoss.val(formatAmount(houseWinLoss));
        renderWinLossDisplay($panel.find('[data-field="winLossDisplay"]'), houseWinLoss);

        // Rolling is editable here: swap the display for a box (the hidden form value is not needed)
        $panel.find('input[type="hidden"][data-field="rolling"]').remove();
        $panel.find('[data-field="rollingDisplay"]').removeClass('is-negative')
            .html('<input class="settlement-receipt-input" type="text" data-field="rolling" data-allow-negative="1" inputmode="decimal">');
        $panel.find('[data-field="rolling"]').val($mainModal.find('#rolling').val()).prop('readonly', false);
        var rateRaw = String($mainModal.find('#rollingRate').val() || '').replace(/%/g, '').trim();
        $panel.find('[data-field="rollingRate"]').val(rateRaw).prop('readonly', false);
        $panel.find('[data-field="sharePct"]').val($mainModal.find('#sharePct').val()).prop('readonly', false);
        $panel.find('[data-field="rollingPct"]').val($mainModal.find('#rollingPct').val()).prop('readonly', false);

        // Guest gets an Add Charge box (defaults to the full Add Charge); Agent shows the rest
        if (panelKey === 'guest') {
            $panel.find('[data-field="addChargeDisplay"] .settlement-receipt-amount')
                .html('<input class="settlement-receipt-input" type="text" data-field="addCharge" inputmode="decimal">');
            $panel.find('[data-field="addCharge"]').val(formatAmount($mainModal.find('#fb').val()));
        }

        recalcSettlementEditPanelTotals($panel);
        return $panel;
    }

    // Guest + Agent rolling always equals main Settlement rolling
    function syncCounterpartRolling($sourcePanel, clampEdited) {
        var $modal = $('#modal-settlement');
        var $guestPanel = $modal.find('#settlement-edit-guest-panel');
        var $agentPanel = $modal.find('#settlement-edit-agent-panel');
        if (!$sourcePanel || !$sourcePanel.length || !$guestPanel.length || !$agentPanel.length) {
            return;
        }

        var totalRolling = parseAmount($modal.find('#rolling').val());
        var isGuest = $sourcePanel.is('#settlement-edit-guest-panel');
        var $otherPanel = isGuest ? $agentPanel : $guestPanel;
        var $sourceInput = $sourcePanel.find('[data-field="rolling"]');
        var edited = parseAmount($sourceInput.val());

        // Each side stays between 0 and the total — works for a negative total rolling too
        edited = Math.max(Math.min(0, totalRolling), Math.min(Math.max(0, totalRolling), edited));
        if (clampEdited) {
            $sourceInput.val(formatAmount(edited));
        }

        var otherRolling = totalRolling - edited;
        $otherPanel.find('[data-field="rolling"]').val(formatAmount(otherRolling));

        recalcSettlementEditPanelTotals($sourcePanel);
        recalcSettlementEditPanelTotals($otherPanel);
    }

    function clampSplitRate(value, max) {
        var num = parseFloat(String(value == null ? '' : value).replace(/,/g, '').replace(/%/g, '').trim());
        if (isNaN(num)) {
            num = 0;
        }
        var cap = Math.max(0, parseFloat(max) || 0);
        num = Math.min(cap, Math.max(0, num));
        return Math.round(num * 10000) / 10000;
    }

    function clampSplitPct(value) {
        var num = parseFloat(String(value == null ? '' : value).replace(/,/g, '').replace(/%/g, '').trim());
        if (isNaN(num)) {
            num = 0;
        }
        return Math.min(100, Math.max(0, Math.round(num * 100) / 100));
    }

    function formatSplitPctValue(num) {
        var text = String(Math.round(Number(num || 0) * 10000) / 10000);
        return text.replace(/(\.\d*?[1-9])0+$/, '$1').replace(/\.0+$/, '');
    }

    // Strips invalid characters while typing but keeps a trailing "." so
    // decimals like "1." / ".5" can still be completed (no rounding here).
    function sanitizeSplitRaw(value) {
        var str = String(value == null ? '' : value).replace(/,/g, '').replace(/%/g, '');
        if (!/^\d*\.?\d*$/.test(str)) {
            var cleaned = str.replace(/[^\d.]/g, '');
            var dot = cleaned.indexOf('.');
            if (dot !== -1) {
                cleaned = cleaned.slice(0, dot + 1) + cleaned.slice(dot + 1).replace(/\./g, '');
            }
            str = cleaned;
        }
        return str;
    }

    // Live version used on 'input': keeps a trailing "." so decimals can still
    // be typed, but the moment the value actually exceeds max it snaps to max
    // immediately instead of waiting for blur.
    function liveClampSplitInput(value, max) {
        var raw = sanitizeSplitRaw(value);
        var num = parseFloat(raw);
        if (!isNaN(num) && num > max) {
            return formatSplitPctValue(max);
        }
        return raw;
    }

    // Casino rolling here is only ever counted in whole thousands — no
    // hundreds/tens — so apportioned Rolling splits round to the nearest 1,000.
    // The other side's share of the total rolling (same sign as the total; negative totals allowed)
    function remainderRolling(totalRolling, part) {
        var rest = totalRolling - part;
        return totalRolling >= 0 ? Math.max(0, rest) : Math.min(0, rest);
    }

    function roundToThousand(value) {
        return Math.round(Number(value || 0) / 1000) * 1000;
    }

    // Calculator SHARE / ROLLING: text on Company, a box on Guest / Agent (left alone while being typed in)
    function setSplitPctCell($cell, value) {
        if ($cell.is('input')) {
            if (!$cell.is(':focus')) $cell.val(formatSettlementPct(value));
            return;
        }
        $cell.text(formatSettlementPct(value));
    }

    function renderSplitAmountCell($cell, value) {
        var display = formatSettlementDueDisplay(value);
        $cell.text(display.text).toggleClass('is-negative', display.negative);
    }

    function refreshSettlementSplitCalculators($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        if (Number($modal.data('settlement-edit-mode')) !== 1) {
            return;
        }

        var totalRolling = parseAmount($modal.find('#rolling').val());
        var companyRate = clampSplitRate($modal.find('#calc-company-rate').val(), 100);

        // Company uses the game's SHARE / ROLLING %; Guest and Agent use what is set in their panels.
        // Share part follows each side's rolling (see computeSplitPanelSettlement).
        var splitWinLoss = parseAmount($modal.find('#winLoss').val());
        var companySplit = getSettlementPanelSplit(null);
        var guestSplit = getSettlementPanelSplit($modal.find('#settlement-edit-guest-panel'));
        var agentSplit = getSettlementPanelSplit($modal.find('#settlement-edit-agent-panel'));
        var splitSettlement = function (rollingValue, split) {
            return window.computeSplitPanelSettlement(splitWinLoss, rollingValue, companyRate, split.sharePct, split.rollingPct, totalRolling);
        };

        // Rows on all three calculators: Win/Loss, company RATE, SHARE / ROLLING
        $modal.find('.js-calc-winloss').each(function() {
            renderWinLossDisplay($(this), splitWinLoss);
        });
        $modal.find('.js-calc-company-rate-display').text(
            companyRate.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 }) + '%'
        );
        [
            ['#settlement-calc-company-panel', companySplit],
            ['#settlement-calc-guest-panel', guestSplit],
            ['#settlement-calc-agent-panel', agentSplit]
        ].forEach(function(entry) {
            var $calc = $modal.find(entry[0]);
            setSplitPctCell($calc.find('.js-calc-share-pct'), entry[1].sharePct);
            setSplitPctCell($calc.find('.js-calc-rolling-pct'), entry[1].rollingPct);
        });

        renderWinLossDisplay($modal.find('#calc-company-rate-rolling'), totalRolling);
        $modal.find('#calc-company-rate-rate-display').text(formatSplitPctValue(companyRate) + '%');
        var totalSettlement = splitSettlement(totalRolling, companySplit);
        renderSplitAmountCell($modal.find('#calc-company-rate-settlement'), totalSettlement);
        renderWinLossDisplay($modal.find('#calc-company-pct-rolling'), totalRolling);
        renderSplitAmountCell($modal.find('#calc-company-pct-settlement'), totalSettlement);

        var guestRate = clampSplitRate($modal.find('#calc-guest-rate-input').val(), companyRate);
        var agentRate = Math.max(0, Math.round((companyRate - guestRate) * 10000) / 10000);
        var guestRateRolling = companyRate > 0 ? roundToThousand((totalRolling * guestRate) / companyRate) : 0;
        var agentRateRolling = remainderRolling(totalRolling, guestRateRolling);
        // Settlement is derived from the rounded Rolling (same figure that gets
        // applied to the real fields) so the preview here always matches what
        // shows up in the actual Guest/Agent panels above.
        var guestRateSettlement = splitSettlement(guestRateRolling, guestSplit);
        var agentRateSettlement = splitSettlement(agentRateRolling, agentSplit);

        renderWinLossDisplay($modal.find('#calc-guest-rate-rolling'), guestRateRolling);
        renderSplitAmountCell($modal.find('#calc-guest-rate-settlement'), guestRateSettlement);
        renderWinLossDisplay($modal.find('#calc-agent-rate-rolling'), agentRateRolling);
        $modal.find('#calc-agent-rate-display').text(formatSplitPctValue(agentRate) + '%');
        renderSplitAmountCell($modal.find('#calc-agent-rate-settlement'), agentRateSettlement);

        var guestPct = clampSplitPct($modal.find('#calc-guest-pct-input').val());
        var agentPct = Math.round((100 - guestPct) * 100) / 100;
        var guestPctRolling = roundToThousand((totalRolling * guestPct) / 100);
        var agentPctRolling = remainderRolling(totalRolling, guestPctRolling);
        // Same as above — Settlement follows the rounded Rolling so it matches
        // what actually lands in the real Guest/Agent panels.
        var guestPctSettlement = splitSettlement(guestPctRolling, guestSplit);
        var agentPctSettlement = splitSettlement(agentPctRolling, agentSplit);

        renderWinLossDisplay($modal.find('#calc-guest-pct-rolling'), guestPctRolling);
        renderSplitAmountCell($modal.find('#calc-guest-pct-settlement'), guestPctSettlement);
        renderWinLossDisplay($modal.find('#calc-agent-pct-rolling'), agentPctRolling);
        $modal.find('#calc-agent-pct-display').text(formatSplitPctValue(agentPct) + '%');
        renderSplitAmountCell($modal.find('#calc-agent-pct-settlement'), agentPctSettlement);
    }

    function restoreOriginalSplitToEditPanels($modal) {
        var rollingVal = $modal.find('#rolling').val();
        var rateRaw = String($modal.find('#rollingRate').val() || '').replace(/%/g, '').trim();
        [$modal.find('#settlement-edit-guest-panel'), $modal.find('#settlement-edit-agent-panel')].forEach(function($panel) {
            if (!$panel.length) {
                return;
            }
            $panel.find('[data-field="rolling"]').val(rollingVal);
            $panel.find('[data-field="rollingRate"]').val(rateRaw);
            recalcSettlementEditPanelTotals($panel);
        });
    }

    function applySettlementSplitToEditPanels($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var $guestPanel = $modal.find('#settlement-edit-guest-panel');
        var $agentPanel = $modal.find('#settlement-edit-agent-panel');
        if (!$guestPanel.length || !$agentPanel.length) {
            return;
        }

        var mode = $modal.data('split-active-mode');
        var totalRolling = parseAmount($modal.find('#rolling').val());

        if (mode === 'rate') {
            var companyRate = clampSplitRate($modal.find('#calc-company-rate').val(), 100);
            var guestRate = clampSplitRate($modal.find('#calc-guest-rate-input').val(), companyRate);
            var guestRolling = companyRate > 0 ? roundToThousand((totalRolling * guestRate) / companyRate) : 0;
            var agentRolling = remainderRolling(totalRolling, guestRolling);

            // Real Rate fields stay at the company rate — only Rolling changes,
            // so Guest/Agent Settlement (rolling × rate) still sums to the total.
            $guestPanel.find('[data-field="rolling"]').val(formatAmount(guestRolling));
            $agentPanel.find('[data-field="rolling"]').val(formatAmount(agentRolling));
            recalcSettlementEditPanelTotals($guestPanel);
            recalcSettlementEditPanelTotals($agentPanel);
        } else if (mode === 'pct') {
            var guestPct = clampSplitPct($modal.find('#calc-guest-pct-input').val());
            var guestPctRolling = roundToThousand((totalRolling * guestPct) / 100);
            var agentPctRolling = remainderRolling(totalRolling, guestPctRolling);

            $guestPanel.find('[data-field="rolling"]').val(formatAmount(guestPctRolling));
            $agentPanel.find('[data-field="rolling"]').val(formatAmount(agentPctRolling));
            recalcSettlementEditPanelTotals($guestPanel);
            recalcSettlementEditPanelTotals($agentPanel);
        } else {
            restoreOriginalSplitToEditPanels($modal);
        }
    }

    function resetSettlementSplitCalculators($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        $modal.removeData('split-active-mode');
        var rateRaw = String($modal.find('#rollingRate').val() || '').replace(/%/g, '').trim();
        $modal.find('#calc-company-rate').val(rateRaw || '0');
        $modal.find('#calc-guest-rate-input, #calc-guest-pct-input').val('0');
        $modal.find('#calc-agent-rate-display, #calc-agent-pct-display').text('0%');
    }

    function syncSettlementEditPanelBeforeCopy($panel) {
        if (!$panel || !$panel.length) {
            return;
        }
        formatInputWithCommas($panel.find('[data-field="rolling"]'));
        formatRollingRateInput($panel.find('[data-field="rollingRate"]'));
        $panel.find('[data-field="sharePct"], [data-field="rollingPct"]').each(function() {
            formatSettlementPctInput($(this));
        });
        formatSettlementAddChargeInput($panel.find('[data-field="addCharge"]'));
        recalcSettlementEditPanelTotals($panel);
    }

    function formatSettlementPctInput($input) {
        if ($input.length) {
            $input.val(formatSettlementPct(clampSplitPct($input.val())));
        }
    }

    // Guest Add Charge: 0 .. main Add Charge
    function formatSettlementAddChargeInput($input) {
        if (!$input.length) {
            return;
        }
        var total = parseAmount($('#modal-settlement').find('#fb').val());
        $input.val(formatAmount(Math.max(0, Math.min(total, parseAmount($input.val())))));
    }

    function recalcSettlementEditPanels($modal) {
        recalcSettlementEditPanelTotals($modal.find('#settlement-edit-guest-panel'));
        recalcSettlementEditPanelTotals($modal.find('#settlement-edit-agent-panel'));
        refreshSettlementSplitCalculators($modal);
    }

    function getSettlementEditPanelSlipBody($panel) {
        if (!$panel || !$panel.length) {
            return null;
        }
        return $panel.find('.settlement-edit-receipt-copy-area')[0] || null;
    }

    function wireSettlementEditPanelCopyButtons($panel) {
        if (!$panel || !$panel.length) {
            return;
        }

        $panel.find('.js-copy-settlement-slip-image').off('click.settlementEditCopy').on('click.settlementEditCopy', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = $(this);
            syncSettlementEditPanelBeforeCopy($panel);
            var slipBody = getSettlementEditPanelSlipBody($panel);
            if (!slipBody) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Receipt is not ready.', confirmButtonText: 'OK' });
                }
                return;
            }
            if (typeof window.copyGameReceiptSlipImage === 'function') {
                window.copyGameReceiptSlipImage(slipBody, $btn);
                return;
            }
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Image copy is not available.', confirmButtonText: 'OK' });
            }
        });

        $panel.find('.js-copy-settlement-slip-text').off('click.settlementEditCopy').on('click.settlementEditCopy', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = $(this);
            syncSettlementEditPanelBeforeCopy($panel);
            copySettlementReceiptSlipTextButton(getSettlementEditPanelSlipBody($panel), $btn);
        });
    }

    function placeSettlementEditButton($modal, inCopyRow) {
        var $editBtn = $modal.find('#edit-settlement-btn');
        if (inCopyRow) {
            $editBtn.detach().appendTo($modal.find('.settlement-main-content .settlement-copy-row'));
            return;
        }
        $editBtn.detach().insertAfter($modal.find('#submit-settlement-btn'));
    }

    function setSettlementEditMode($modal, enabled) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var isSettled = Number($modal.data('is-settled')) === 1;
        var $editBtn = $modal.find('#edit-settlement-btn');
        var $settleBtn = $modal.find('#submit-settlement-btn');
        var $cluster = $modal.find('#settlement-modal-cluster');
        var $guestPanel = $modal.find('#settlement-edit-guest-panel');
        var $agentPanel = $modal.find('#settlement-edit-agent-panel');
        var $splitPanels = $modal.find('#settlement-calc-company-panel, #settlement-calc-guest-panel, #settlement-calc-agent-panel');

        $modal.data('settlement-edit-mode', enabled ? 1 : 0);
        $cluster.toggleClass('is-edit-mode', enabled);

        if (enabled) {
            buildSettlementEditPanelReceipt($modal, 'guest');
            buildSettlementEditPanelReceipt($modal, 'agent');
            wireSettlementEditPanelCopyButtons($guestPanel);
            wireSettlementEditPanelCopyButtons($agentPanel);
            $guestPanel.removeClass('d-none').attr('aria-hidden', 'false');
            $agentPanel.removeClass('d-none').attr('aria-hidden', 'false');
            $splitPanels.removeClass('d-none').attr('aria-hidden', 'false');
            resetSettlementSplitCalculators($modal);
            refreshSettlementSplitCalculators($modal);
            $editBtn.text('Done');
            $settleBtn.hide();
            $modal.find('#print-settlement-btn').hide();
            $modal.find('.settlement-footer-actions').hide();
            $modal.find('.deposit-cashout-row').hide();
            placeSettlementEditButton($modal, true);
        } else {
            $guestPanel.addClass('d-none').attr('aria-hidden', 'true');
            $agentPanel.addClass('d-none').attr('aria-hidden', 'true');
            $splitPanels.addClass('d-none').attr('aria-hidden', 'true');
            $modal.find('#settlement-edit-guest-body, #settlement-edit-agent-body').empty();
            resetSettlementSplitCalculators($modal);
            $editBtn.text('Edit');
            placeSettlementEditButton($modal, false);
            $modal.find('.settlement-footer-actions').show();
            $modal.find('#print-settlement-btn').show();
            $settleBtn.show();
            if (isSettled) {
                $settleBtn.prop('disabled', true).text('Settled');
            } else {
                $settleBtn.prop('disabled', false).text('Settle');
            }
            $modal.find('.deposit-cashout-row').toggle(!isSettled);
        }
    }

    function resetSettlementModalView($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        if (Number($modal.data('settlement-edit-mode')) === 1) {
            setSettlementEditMode($modal, false);
        }

        var isSettled = Number($modal.data('is-settled')) === 1;
        var $settleBtn = $modal.find('#submit-settlement-btn');

        $settleBtn.show();
        if (isSettled) {
            $settleBtn.prop('disabled', true).text('Settled');
        } else {
            $settleBtn.prop('disabled', false).text('Settle');
        }

        $modal.find('.deposit-cashout-row').toggle(!isSettled);
        $modal.find('#print-settlement-btn').show();
        $modal.find('.settlement-footer-actions').show();
        placeSettlementEditButton($modal, false);
        $modal.find('#edit-settlement-btn').text('Edit').prop('disabled', false);
        $modal.find('#buyIn, #chipsReturn, #rolling, #rollingRate').prop('readonly', true);
        $modal.find('.settlement-service-amount').prop('readonly', true);
        refreshSettlementReceiptDisplay($modal);
        updateSettlementCopyButtons($modal);
    }

    // Receipt date: when the game was settled (COMMISSION ledger, else GAME_ENDED) for settled games,
    // otherwise the moment the modal is opened.
    function setSettlementReceiptDate($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var settledDt = $modal.data('settlementSettledDt');
        var m = settledDt ? moment.utc(settledDt).utcOffset(8) : moment();
        if (!m.isValid()) m = moment();
        $modal.find('#date').text(m.format('YYYY-MM-DD'));
        $modal.find('#time').text(m.format('HH:mm'));
        syncSettlementDateTimeDisplay($modal);
    }
    window.setSettlementReceiptDate = setSettlementReceiptDate;

    $('#modal-settlement').on('show.bs.modal', function() {
        setSettlementReceiptDate($(this));
    });

    $('#modal-settlement').on('shown.bs.modal', function() {
        resetSettlementModalView($(this));
    });

    $('#modal-settlement').on('hidden.bs.modal', function() {
        resetSettlementModalView($(this));
    });

    $('#edit-settlement-btn').on('click', function() {
        var $modal = $('#modal-settlement');
        var inEditMode = Number($modal.data('settlement-edit-mode')) === 1;
        setSettlementEditMode($modal, !inEditMode);
