<style>
    #modal-settlement.show,
    #modal-settlement.showing {
        display: flex !important;
        align-items: center;
        justify-content: center;
        padding: 0.75rem;
    }

    #modal-settlement .settlement-receipt-dialog {
        --bs-modal-width: 420px;
        max-width: calc(100vw - 1.5rem);
        width: max-content;
        margin: 0 auto;
    }

    #modal-settlement .settlement-modal-cluster {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        gap: 0.75rem;
        margin: 0 auto;
    }

    #modal-settlement .settlement-main-content {
        width: 26.25rem; /* 420px */
        max-width: 100%;
        flex-shrink: 0;
    }

    #modal-settlement .settlement-edit-panel {
        width: 26.25rem; /* 420px */
        max-width: 100%;
        flex-shrink: 0;
    }

    #modal-settlement .settlement-edit-panel-card {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 0.35rem;
        box-shadow: 0 0.35rem 1rem rgba(0, 0, 0, 0.12);
        overflow: hidden;
        pointer-events: auto;
        display: flex;
        flex-direction: column;
    }

    #modal-settlement .settlement-main-content > .modal-header,
    #modal-settlement .settlement-edit-panel-card .modal-header {
        background: linear-gradient(160deg, #f1d48a 0%, #c8a24c 100%) !important;
        border-bottom: 1px solid rgba(58, 46, 18, 0.25) !important;
        padding: 0.75rem 1rem;
        min-height: 3.25rem;
        display: flex;
        align-items: center;
    }

    #modal-settlement .settlement-main-content > .modal-header .modal-title,
    #modal-settlement .settlement-edit-panel-card .modal-header .modal-title {
        color: #3a2e12 !important;
        font-size: 0.98rem;
        font-weight: 600;
        line-height: 1.3;
        /* keep "Settlement - CODE (NAME)" on one line */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
    }

    #modal-settlement .settlement-main-content > .modal-header .btn-close,
    #modal-settlement .settlement-edit-panel-card .modal-header .btn-close {
        filter: none;
        opacity: 0.65;
    }

    #modal-settlement .settlement-main-content > .modal-header .btn-close:hover,
    #modal-settlement .settlement-edit-panel-card .modal-header .btn-close:hover {
        opacity: 1;
    }

    #modal-settlement .settlement-edit-panel-body:not(.settlement-split-body) {
        flex: 1 1 auto;
        padding: 0;
    }

    #modal-settlement .settlement-edit-panel-card > .modal-footer {
        flex-shrink: 0;
        margin-top: auto;
    }

    #modal-settlement .settlement-edit-panel-card > .modal-footer .settlement-copy-row {
        margin: 0;
    }

    #modal-settlement .settlement-modal-cluster.is-edit-mode {
        max-width: calc(100vw - 1.5rem);
        overflow-x: auto;
        padding-bottom: 0.25rem;
        display: grid;
        grid-template-columns: 26.25rem 26.25rem 26.25rem;
        gap: 0.75rem;
        align-items: stretch;
    }

    #modal-settlement .settlement-modal-cluster.is-edit-mode > .settlement-main-content,
    #modal-settlement .settlement-modal-cluster.is-edit-mode > .settlement-edit-panel {
        display: flex;
        flex-direction: column;
        min-height: 0;
        width: 100%;
        max-width: 100%;
    }

    #modal-settlement .settlement-modal-cluster.is-edit-mode > .settlement-edit-panel > .settlement-edit-panel-card {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 100%;
    }

    #modal-settlement .settlement-modal-cluster.is-edit-mode .settlement-main-content > form {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    #modal-settlement .settlement-modal-cluster.is-edit-mode .settlement-footer-actions {
        display: none !important;
    }

    #modal-settlement .settlement-modal-cluster.is-edit-mode .modal-footer {
        margin-top: auto;
        flex-shrink: 0;
        padding: 0.35rem 0.65rem !important;
        gap: 0 !important;
        min-height: 2.35rem;
        justify-content: center !important;
        align-items: center !important;
    }

    #modal-settlement .settlement-modal-cluster.is-edit-mode .modal-footer > * {
        margin: 0;
        width: auto;
    }

    #modal-settlement .settlement-modal-cluster.is-edit-mode .settlement-copy-row {
        flex-wrap: nowrap;
        gap: 0.35rem;
        justify-content: center;
        width: auto;
        margin: 0 auto;
    }

    #modal-settlement .settlement-modal-cluster.is-edit-mode .settlement-main-content .settlement-copy-row #edit-settlement-btn {
        color: #fff !important;
        background: linear-gradient(135deg, #52525b 0%, #71717a 100%) !important;
        border-color: transparent !important;
        box-shadow: none !important;
    }

    #modal-settlement .settlement-modal-cluster.is-edit-mode .settlement-main-content .modal-body,
    #modal-settlement .settlement-modal-cluster.is-edit-mode .settlement-edit-panel-body {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }

    #modal-settlement .settlement-modal-cluster.is-edit-mode #settlement-receipt-copy-area,
    #modal-settlement .settlement-modal-cluster.is-edit-mode .settlement-edit-receipt-copy-area {
        flex: 1 1 auto;
        width: 100%;
    }

    .settlement-cutoff-tag {
        display: inline-block;
        color: #fff;
        font-weight: 700;
        font-size: 0.75rem;
        padding: 0.1rem 0.35rem;
        margin-right: 0.25rem;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .settlement-cutoff-tag--cutoff {
        background: #2e75b6;
    }

    .settlement-cutoff-tag--new-day {
        background: #e60000;
    }

    #modal-settlement .settlement-copy-row {
        display: flex;
        justify-content: center;
        gap: 0.35rem;
        width: 100%;
    }

    #modal-settlement .modal-footer .btn,
    #modal-settlement .settlement-copy-row .btn {
        font-size: 0.78rem;
        padding: 0.22rem 0.55rem;
        line-height: 1.25;
    }

    #modal-settlement .settlement-copy-row .btn {
        color: #fff !important;
        background: linear-gradient(135deg, #52525b 0%, #71717a 100%) !important;
        border-color: transparent !important;
        box-shadow: none !important;
    }

    #modal-settlement .modal-content,
    #modal-settlement .modal-body,
    #modal-settlement .modal-footer {
        background: #fff !important;
    }

    /* Receipt rows run edge to edge, like the game receipt cards */
    #modal-settlement .settlement-main-content .modal-body {
        position: relative;
        padding: 0;
    }

    /* The receipt's white footer strip (under PAYMENT) is the only space above this block */
    #modal-settlement .settlement-extra-opts {
        width: 100%;
        max-width: 26.25rem;
        margin: 0 auto;
        text-align: center;
    }

    #modal-settlement .settlement-extra-opts .deposit-cashout-row {
        justify-content: center;
        gap: 1.5rem;
    }

    #modal-settlement .settlement-extra-opts .deposit-cashout-row > [class*="col-"] {
        flex: 0 0 auto;
        width: auto;
        max-width: none;
    }

    #modal-settlement .settlement-extra-opts .form-check-label {
        font-size: 0.95rem;
    }

    #modal-settlement #settlement-choose-account-label {
        font-size: 0.78rem;
        line-height: 1.25;
        word-break: break-word;
        max-width: 12rem;
        margin-left: auto;
        margin-right: auto;
    }

    #modal-settlement-choose-account {
        z-index: 1065;
    }

    #modal-settlement .modal-footer {
        align-items: center !important;
        justify-content: center !important;
        gap: 0.35rem !important;
        padding: 0.5rem 1rem 0.75rem;
    }

    #modal-settlement .modal-footer > * {
        margin: 0;
    }

    #modal-settlement .settlement-main-content .modal-footer {
        padding: 0.3rem 0.75rem 0.45rem;
    }

    #modal-settlement .settlement-modal-cluster:not(.is-edit-mode) .settlement-main-content .modal-footer {
        flex-direction: row !important;
        justify-content: space-between !important;
        align-items: center !important;
        flex-wrap: nowrap;
        gap: 0.5rem !important;
    }

    #modal-settlement .settlement-modal-cluster:not(.is-edit-mode) .settlement-main-content .settlement-copy-row {
        width: auto;
        justify-content: flex-start;
        flex: 0 0 auto;
    }

    #modal-settlement .settlement-modal-cluster:not(.is-edit-mode) .settlement-main-content .settlement-footer-actions {
        display: flex;
        flex-wrap: nowrap;
        justify-content: flex-end;
        gap: 0.35rem;
        width: auto;
        flex: 0 0 auto;
    }

    #modal-settlement #settlement-service-rows {
        display: none;
    }

    @media print {
        #modal-settlement #add_settlement,
        #modal-settlement .modal-header,
        #modal-settlement .modal-footer,
        #modal-settlement .settlement-extra-opts {
            display: none !important;
        }
    }
</style>

<%- include('_settlement_slip_styles') %>

<div class="modal fade" id="modal-settlement" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" tabindex="-1" aria-labelledby="modal-settlement-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered settlement-receipt-dialog">
        <div class="settlement-modal-cluster" id="settlement-modal-cluster">
        <div class="modal-content settlement-main-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="modal-settlement-label"><%= __('modal_settlement.settlement') %> - <span id="settlement-agent-code"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="add_settlement">
                <input type="hidden" name="txtSettlementBalance" id="SettlementBalance">
                <input type="hidden" name="game_id_settle">
                <input type="hidden" name="txtAccountIDSettle">
                <input type="hidden" id="fb" name="txtFNB" value="0">
                <input type="hidden" id="rollingSettlement" name="txtRollingSettlement" value="0">
                <input type="hidden" id="payment" name="txtPayment" value="0">
                <span id="date" class="visually-hidden" aria-hidden="true"></span>
                <span id="time" class="visually-hidden" aria-hidden="true"></span>
                <span id="accNo" class="visually-hidden" aria-hidden="true"></span>
                <div id="settlement-service-rows"></div>

                <div class="modal-body">
                    <div id="settlement-receipt-copy-area" class="settlement-receipt-body settlement-slip">
                        <div class="settlement-receipt-watermark" aria-hidden="true"></div>
                        <div class="ss-header">* SETTLEMENT *</div>

                        <div class="ss-meta">
                            <div class="ss-meta-row">
                                <div class="ss-meta-tags"><span class="settlement-cutoff-tags settlement-receipt-row--cutoff" style="display: none;"></span></div>
                                <div class="ss-date" id="dateTime"></div>
                                <div class="ss-meta-spacer"></div>
                            </div>
                            <div class="ss-account" id="accNoPrefix"></div>
                            <div class="ss-guest" id="accNoName"></div>
                            <div class="ss-game"><span class="settlement-game-type" id="gameType"></span> <span class="ss-game-no" id="gameNo"></span><span class="ss-game-linked" id="gameNoLinked"></span></div>
                        </div>

                        <%# data-text-label / data-text-block: copy text (blocks print together, a new block starts after a blank line);
                            data-html2canvas-ignore: on screen only, left out of Copy image and Copy text %>
                        <div class="ss-row ss-row--buyin ss-gap" data-text-label="* BUY IN" data-text-block="totals">
                            <span class="ss-label">* BUY IN</span>
                            <span class="ss-value"><span class="settlement-receipt-amount"><input class="settlement-receipt-input" type="text" id="buyIn" name="txtBuyIn" readonly></span></span>
                        </div>
                        <div class="ss-row ss-row--cashout ss-gap" data-text-label="* CASH OUT" data-text-block="totals">
                            <span class="ss-label">* CASH OUT</span>
                            <span class="ss-value"><input class="settlement-receipt-hidden-value" type="hidden" id="chipsReturn" name="txtChipsReturn"><span class="settlement-receipt-amount" id="chipsReturnDisplay"></span></span>
                        </div>
                        <div class="ss-row ss-row--summary ss-gap" data-text-label="* WIN / LOSS" data-text-block="totals">
                            <span class="ss-label">* WIN/LOSS</span>
                            <span class="ss-value"><input class="settlement-receipt-hidden-value" type="hidden" id="winLoss" name="txtWinLoss"><span class="settlement-receipt-amount" id="winLossDisplay"></span></span>
                        </div>
                        <div class="ss-row ss-row--summary" data-text-label="* ROLLING" data-text-block="totals">
                            <span class="ss-label">* ROLLING</span>
                            <span class="ss-value"><input class="settlement-receipt-hidden-value" type="hidden" id="rolling" name="txtRolling"><span class="settlement-receipt-amount" id="rollingDisplay"></span></span>
                        </div>
                        <div class="ss-row ss-row--rate ss-gap" data-html2canvas-ignore="true">
                            <span class="ss-label">RATE</span>
                            <span class="ss-value"><span class="settlement-receipt-amount"><input class="settlement-receipt-input" type="text" id="rollingRate" name="txtRollingRate" readonly></span></span>
                        </div>
                        <div class="ss-row ss-row--split ss-gap" data-html2canvas-ignore="true">
                            <span>SHARE</span><span class="ss-split-value"><input class="settlement-receipt-input ss-pct-input" type="text" id="sharePct" value="0%" inputmode="decimal" readonly></span>
                            <span>ROLLING</span><span class="ss-split-value"><input class="settlement-receipt-input ss-pct-input" type="text" id="rollingPct" value="100%" inputmode="decimal" readonly></span>
                        </div>
                        <div class="ss-row ss-row--settle ss-gap" data-text-label="* SETTLEMENT" data-text-block="settlement">
                            <span class="ss-label">SETTLEMENT</span>
                            <span class="ss-value" id="rollingSettlementDisplay"><span class="settlement-receipt-amount"></span></span>
                        </div>
                        <div class="ss-row ss-row--charge" data-text-label="* ADD CHARGE" data-text-block="settlement">
                            <span class="ss-label">ADD CHARGE</span>
                            <span class="ss-value" id="addChargeDisplay"><span class="settlement-receipt-amount">0</span></span>
                        </div>
                        <div class="ss-row ss-row--payment" data-text-label="* PAYMENT" data-text-block="settlement">
                            <span class="ss-label">PAYMENT</span>
                            <span class="ss-value" id="paymentDisplay"><span class="settlement-receipt-amount"></span></span>
                        </div>
                    </div>

                    <div class="settlement-extra-opts">
                        <div class="row mb-2 deposit-cashout-row g-2 align-items-center">
                            <div class="col-6 col-sm-6">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" style="border-color: #20252e !important;" type="radio" value="1" id="deposit" name="txtTransType">
                                    <label class="form-check-label" for="deposit"><%= __('modal_settlement.deposit') %></label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-6">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" style="border-color: #20252e !important;" type="radio" value="choose" id="chooseAccount" name="txtTransType">
                                    <label class="form-check-label" for="chooseAccount"><%= __('modal_settlement.choose_account') %></label>
                                </div>
                                <div class="small text-muted mt-1 d-none" id="settlement-choose-account-label"></div>
                            </div>
                            <div class="col-12 d-none" id="settlement-loss-option-row">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" style="border-color: #20252e !important;" type="radio" value="loss" id="settlementToLoss" name="txtTransType">
                                    <label class="form-check-label" for="settlementToLoss">Loss Amount</label>
                                </div>
                                <div class="small text-muted mt-1" id="settlement-loss-option-label"></div>
                            </div>
                        </div>
                        <input type="hidden" id="txtChooseAccountID" name="txtChooseAccountID" value="">
                    </div>
                </div>

                <div class="modal-footer settlement-main-footer">
                    <div class="settlement-copy-row" aria-hidden="false">
                        <button type="button" class="btn btn-sm js-copy-settlement-slip-image"><%= __('modal_settlement.copy_image') %></button>
                        <button type="button" class="btn btn-sm js-copy-settlement-slip-text"><%= __('modal_settlement.copy_text') %></button>
                    </div>
                    <div class="settlement-footer-actions">
                        <button type="button" id="submit-settlement-btn" class="btn btn-sm btn-primary">Settle</button>
                        <button type="button" id="edit-settlement-btn" class="btn btn-sm btn-alt-secondary">Edit</button>
                        <button type="button" id="print-settlement-btn" class="btn btn-sm btn-alt-secondary"><%= __('modal_settlement.print') %></button>
                    </div>
                </div>
            </form>
        </div>
        <div class="settlement-edit-panel settlement-edit-panel--guest d-none" id="settlement-edit-guest-panel" aria-hidden="true">
            <div class="settlement-edit-panel-card">
                <div class="modal-header bg-primary">
                    <h5 class="modal-title text-white">Edit Mode (Guest)</h5>
                    <button type="button" class="btn-close js-settlement-edit-panel-close" aria-label="Close"></button>
                </div>
                <div class="settlement-edit-panel-body" id="settlement-edit-guest-body"></div>
                <div class="modal-footer flex-column align-items-center gap-2">
                    <div class="settlement-copy-row" aria-hidden="false">
                        <button type="button" class="btn btn-sm js-copy-settlement-slip-image"><%= __('modal_settlement.copy_image') %></button>
                        <button type="button" class="btn btn-sm js-copy-settlement-slip-text"><%= __('modal_settlement.copy_text') %></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="settlement-edit-panel settlement-edit-panel--agent d-none" id="settlement-edit-agent-panel" aria-hidden="true">
            <div class="settlement-edit-panel-card">
                <div class="modal-header bg-primary">
                    <h5 class="modal-title text-white">Edit Mode (Agent)</h5>
                    <button type="button" class="btn-close js-settlement-edit-panel-close" aria-label="Close"></button>
                </div>
                <div class="settlement-edit-panel-body" id="settlement-edit-agent-body"></div>
                <div class="modal-footer flex-column align-items-center gap-2">
                    <div class="settlement-copy-row" aria-hidden="false">
                        <button type="button" class="btn btn-sm js-copy-settlement-slip-image"><%= __('modal_settlement.copy_image') %></button>
                        <button type="button" class="btn btn-sm js-copy-settlement-slip-text"><%= __('modal_settlement.copy_text') %></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="settlement-edit-panel settlement-split-panel d-none" id="settlement-calc-company-panel" aria-hidden="true">
            <div class="settlement-edit-panel-card">
                <div class="modal-header bg-primary">
                    <h5 class="modal-title text-white">Company Rate</h5>
                </div>
                <div class="settlement-edit-panel-body settlement-split-body settlement-slip">
                    <div class="ss-row ss-row--rate">
                        <span class="ss-label">RATE</span>
                        <span class="ss-value">
                            <span class="settlement-split-input-wrap">
                                <input type="text" class="settlement-split-input" id="calc-company-rate" value="0" inputmode="decimal" aria-label="Company rate">
                                <span class="settlement-split-pct-suffix">%</span>
                            </span>
                        </span>
                    </div>
                    <div class="ss-row ss-row--split ss-gap">
                        <span>SHARE</span><span class="ss-split-value js-calc-share-pct">0%</span>
                        <span>ROLLING</span><span class="ss-split-value js-calc-rolling-pct">100%</span>
                    </div>
                    <div class="ss-calc-block ss-gap">
                        <div class="ss-calc-title">Rate</div>
                        <div>
                            <div class="ss-calc-row"><span>Win/Loss</span><span class="ss-calc-value js-calc-winloss">0</span></div>
                            <div class="ss-calc-row"><span>Rolling</span><span class="ss-calc-value" id="calc-company-rate-rolling">0</span></div>
                            <div class="ss-calc-row"><span>Rate</span><span class="ss-calc-value" id="calc-company-rate-rate-display">0%</span></div>
                            <div class="ss-calc-row"><span>Settlement</span><span class="ss-calc-value" id="calc-company-rate-settlement">0</span></div>
                        </div>
                    </div>
                    <div class="ss-calc-block ss-gap">
                        <div class="ss-calc-title">Percentage</div>
                        <div>
                            <div class="ss-calc-row"><span>Win/Loss</span><span class="ss-calc-value js-calc-winloss">0</span></div>
                            <div class="ss-calc-row"><span>Rolling</span><span class="ss-calc-value" id="calc-company-pct-rolling">0</span></div>
                            <div class="ss-calc-row"><span>Percentage</span><span class="ss-calc-value">100%</span></div>
                            <div class="ss-calc-row"><span>Settlement</span><span class="ss-calc-value" id="calc-company-pct-settlement">0</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="settlement-edit-panel settlement-split-panel d-none" id="settlement-calc-guest-panel" aria-hidden="true">
            <div class="settlement-edit-panel-card">
                <div class="modal-header bg-primary">
                    <h5 class="modal-title text-white">Edit Mode (Guest)</h5>
                </div>
                <div class="settlement-edit-panel-body settlement-split-body settlement-slip">
                    <div class="ss-row ss-row--rate">
                        <span class="ss-label">RATE</span>
                        <span class="ss-value js-calc-company-rate-display">0%</span>
                    </div>
                    <div class="ss-row ss-row--split ss-gap">
                        <span>SHARE</span><span class="ss-split-value"><input class="settlement-receipt-input ss-pct-input js-calc-share-pct" type="text" value="0%" inputmode="decimal" data-split-field="sharePct" aria-label="Share %"></span>
                        <span>ROLLING</span><span class="ss-split-value"><input class="settlement-receipt-input ss-pct-input js-calc-rolling-pct" type="text" value="100%" inputmode="decimal" data-split-field="rollingPct" aria-label="Rolling %"></span>
                    </div>
                    <div class="ss-calc-block ss-gap">
                        <div class="ss-calc-title">Rate</div>
                        <div>
                            <div class="ss-calc-row"><span>Win/Loss</span><span class="ss-calc-value js-calc-winloss">0</span></div>
                            <div class="ss-calc-row"><span>Rolling</span><span class="ss-calc-value" id="calc-guest-rate-rolling">0</span></div>
                            <div class="ss-calc-row">
                                <span>Rate</span>
                                <span class="ss-calc-value">
                                    <span class="settlement-split-input-wrap">
                                        <input type="text" class="settlement-split-input" id="calc-guest-rate-input" value="0" inputmode="decimal" aria-label="Guest rate split">
                                        <span class="settlement-split-pct-suffix">%</span>
                                    </span>
                                </span>
                            </div>
                            <div class="ss-calc-row"><span>Settlement</span><span class="ss-calc-value" id="calc-guest-rate-settlement">0</span></div>
                        </div>
                    </div>
                    <div class="ss-calc-block ss-gap">
                        <div class="ss-calc-title">Percentage</div>
                        <div>
