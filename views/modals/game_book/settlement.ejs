<div class="modal fade" id="modal-settlement" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" tabindex="-1" aria-labelledby="modal-settlement-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered settlement-receipt-dialog">
        <div class="settlement-modal-cluster" id="settlement-modal-cluster">
        <div class="modal-content settlement-main-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="modal-settlement-label"><%= __('modal_settlement.settlement') %> - <span id="settlement-agent-code"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="add_settlement">
                <input type="hidden" name="txtSettlementBalance" id="SettlementBalance">
                <input type="hidden" name="game_id_settle">
                <input type="hidden" name="txtAccountIDSettle">
                <input type="hidden" id="fb" name="txtFNB" value="0">
                <input type="hidden" id="rollingSettlement" name="txtRollingSettlement" value="0">
                <input type="hidden" id="payment" name="txtPayment" value="0">
                <span id="date" class="visually-hidden" aria-hidden="true"></span>
                <span id="time" class="visually-hidden" aria-hidden="true"></span>
                <span id="accNo" class="visually-hidden" aria-hidden="true"></span>
                <div id="settlement-service-rows"></div>

                <div class="modal-body">
                    <div id="settlement-receipt-copy-area" class="settlement-receipt-body">
                        <div class="settlement-receipt-watermark" aria-hidden="true"></div>

                        <div class="settlement-receipt-stack">
                        <div class="settlement-receipt-grid settlement-receipt-grid--meta">
            <div class="settlement-receipt-section">
                <div class="settlement-receipt-row">
                    <span class="settlement-receipt-label"><%= __('modal_settlement.acc_no') %></span>
                    <span class="settlement-receipt-colon">:</span>
                    <span class="settlement-receipt-value-col is-bold">
                        <span id="accNoPrefix"></span><span id="accNoName"></span>
                    </span>
                </div>
                <div class="settlement-receipt-row">
                    <span class="settlement-receipt-label"><%= __('modal_settlement.game_no') %></span>
                    <span class="settlement-receipt-colon">:</span>
                    <span class="settlement-receipt-value-col is-bold" id="gameNo"></span>
                </div>
                <div class="settlement-receipt-row">
                    <span class="settlement-receipt-label">Date &amp; Time</span>
                    <span class="settlement-receipt-colon">:</span>
                    <span class="settlement-receipt-value-col is-bold" id="dateTime"></span>
                </div>
            </div>
                        </div>

            <div class="settlement-receipt-divider" aria-hidden="true"></div>

            <div class="settlement-receipt-grid settlement-receipt-grid--amounts">
            <div class="settlement-receipt-section">
                <div class="settlement-receipt-row">
                    <span class="settlement-receipt-label">Buy In</span>
                    <span class="settlement-receipt-colon">:</span>
                    <span class="settlement-receipt-value-col settlement-receipt-value-col--amount">
                        <span class="settlement-receipt-prefix-ghost" aria-hidden="true"></span><span class="settlement-receipt-amount"><input class="settlement-receipt-input" type="text" id="buyIn" name="txtBuyIn" readonly></span>
                    </span>
                </div>
                <div class="settlement-receipt-row">
                    <span class="settlement-receipt-label">Cash Out</span>
                    <span class="settlement-receipt-colon">:</span>
                    <span class="settlement-receipt-value-col settlement-receipt-value-col--amount">
                        <span class="settlement-receipt-prefix-ghost" aria-hidden="true"></span><span class="settlement-receipt-amount"><input class="settlement-receipt-input" type="text" id="chipsReturn" name="txtChipsReturn" readonly></span>
                    </span>
                </div>
                <div class="settlement-receipt-row">
                    <span class="settlement-receipt-label">Win / Loss</span>
                    <span class="settlement-receipt-colon">:</span>
                    <span class="settlement-receipt-value-col settlement-receipt-value-col--amount is-bold">
                        <span class="settlement-receipt-prefix-ghost" aria-hidden="true"></span><span class="settlement-receipt-amount"><input class="settlement-receipt-input" type="text" id="winLoss" name="txtWinLoss" readonly></span>
                    </span>
                </div>
                <div class="settlement-receipt-row">
                    <span class="settlement-receipt-label">Rolling</span>
                    <span class="settlement-receipt-colon">:</span>
                    <span class="settlement-receipt-value-col settlement-receipt-value-col--amount is-bold">
