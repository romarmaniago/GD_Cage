    function openReceiptPrintWindow($modal) {
        var receiptHtml = buildSettlementReceiptPrintNode($modal).prop('outerHTML');
        var iframe = document.createElement('iframe');
        iframe.style.position = 'fixed';
        iframe.style.right = '0';
        iframe.style.bottom = '0';
        iframe.style.width = '0';
        iframe.style.height = '0';
        iframe.style.border = '0';
        iframe.setAttribute('aria-hidden', 'true');
        document.body.appendChild(iframe);

        var iframeDoc = iframe.contentWindow.document;
        iframeDoc.open();
        iframeDoc.write('<!doctype html><html><head><title>Settlement Receipt</title><style>' + getSettlementReceiptPrintStyles() + '</style></head><body>' + receiptHtml + '</body></html>');
        iframeDoc.close();

        setTimeout(function() {
            iframe.contentWindow.focus();
            iframe.contentWindow.print();
            setTimeout(function() {
                if (iframe && iframe.parentNode) {
                    iframe.parentNode.removeChild(iframe);
                }
            }, 500);
        }, 300);
    }

    function syncServiceTotalAndPayment($modal) {
        var servicesTotal = 0;
        $modal.find('.settlement-service-amount').each(function () {
            servicesTotal += parseAmount($(this).val());
        });
        var settlement = parseAmount($modal.find('#rollingSettlement').val());
        var payment = settlement - servicesTotal;

        $modal.find('#fb').val(formatAmount(servicesTotal));
        $modal.find('#payment').val(formatAmount(payment));
        refreshSettlementReceiptDisplay($modal);
    }

    function formatInputWithCommas($input) {
        var raw = String($input.val() || '').replace(/,/g, '').trim();
        if (!raw) {
            $input.val('');
            return;
        }

        var allowNegative = $input.attr('data-allow-negative') === '1';
        var isNegative = allowNegative && raw.startsWith('-');
        var normalized = raw.replace(/[^\d.]/g, '');
        var firstDot = normalized.indexOf('.');
        if (firstDot !== -1) {
            normalized = normalized.slice(0, firstDot + 1) + normalized.slice(firstDot + 1).replace(/\./g, '');
        }

        if (isNegative && normalized) {
            normalized = '-' + normalized;
        }

        var num = parseFloat(normalized);
        if (isNaN(num)) {
            return;
        }

        $input.val(num.toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        }));
    }

    // Live comma formatting while typing (preserves caret by digit count)
    function formatInputWithCommasLive($input) {
        var el = $input && $input[0];
        if (!el) {
            return;
        }

        var raw = String(el.value || '');
        var caret = typeof el.selectionStart === 'number' ? el.selectionStart : raw.length;
        var digitsBeforeCaret = raw.slice(0, caret).replace(/[^\d]/g, '').length;

        formatInputWithCommas($input);

        var formatted = String(el.value || '');
        if (!formatted) {
            return;
        }

        var pos = 0;
        var seen = 0;
        while (pos < formatted.length && seen < digitsBeforeCaret) {
            if (/\d/.test(formatted.charAt(pos))) {
                seen++;
            }
            pos++;
        }
        try {
            el.setSelectionRange(pos, pos);
        } catch (e) { /* ignore */ }
    }

    function formatRollingRateInput($input) {
        var raw = String($input.val() || '').replace(/,/g, '').trim();
        if (!raw) {
            $input.val('');
            return;
        }
        var normalized = raw.replace(/[^\d.]/g, '');
        var dot = normalized.indexOf('.');
        if (dot !== -1) {
            normalized = normalized.slice(0, dot + 1) + normalized.slice(dot + 1).replace(/\./g, '');
        }
        var intPart = dot === -1 ? normalized : normalized.slice(0, dot);
        var fracPart = dot === -1 ? null : normalized.slice(dot + 1);
        if (intPart === '' && dot === -1 && (fracPart === null || fracPart === '')) {
            $input.val('');
            return;
        }
        var intNum = parseInt(intPart === '' ? '0' : intPart, 10);
        if (isNaN(intNum)) {
            intNum = 0;
        }
        var intStr = intNum.toLocaleString('en-US');
        if (dot !== -1) {
            $input.val(intStr + '.' + (fracPart === null ? '' : fracPart));
            return;
        }
        var num = parseFloat(normalized);
        if (isNaN(num)) {
            return;
        }
        $input.val(num.toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 4
        }));
    }

    function refreshSettlementEditPanelDisplay($panel) {
        if (!$panel || !$panel.length) {
            return;
        }

        var settlementVal = parseAmount($panel.data('rolling-settlement'));
        var paymentVal = parseAmount($panel.data('payment'));
        var addChargeVal = parseAmount($panel.data('add-charge'));

        var settlementDisplay = formatSettlementDueDisplay(settlementVal);
        $panel.find('[data-field="rollingSettlementDisplay"] .settlement-receipt-amount')
            .text(settlementDisplay.text)
            .toggleClass('is-negative', settlementDisplay.negative);

        var paymentDisplay = formatSettlementDueDisplay(paymentVal);
        $panel.find('[data-field="paymentDisplay"] .settlement-receipt-amount')
            .text(paymentDisplay.text)
            .toggleClass('is-negative', paymentDisplay.negative);

        $panel.find('[data-field="addChargeDisplay"] .settlement-receipt-amount').text(formatAmount(addChargeVal));

        var $rate = $panel.find('[data-field="rollingRate"]');
        if (!$rate.prop('readonly')) {
            $rate.val(formatSettlementRateDisplay($rate.val()));
        }
    }

    function recalcSettlementEditPanelTotals($panel) {
        if (!$panel || !$panel.length) {
            return;
        }

        var rolling = parseAmount($panel.find('[data-field="rolling"]').val());
        var rate = parseAmount($panel.find('[data-field="rollingRate"]').val());
        var addCharge = parseAmount($panel.data('add-charge'));
        var settlement = Math.round((rolling * rate) / 100);
        var payment = settlement - addCharge;

        $panel.data('rolling-settlement', settlement);
        $panel.data('payment', payment);
        refreshSettlementEditPanelDisplay($panel);
    }

    function buildSettlementEditPanelReceipt($mainModal, panelKey) {
        var $source = $mainModal.find('#settlement-receipt-copy-area').clone(false);
        $source.removeAttr('id').addClass('settlement-edit-receipt-copy-area');

        $source.find('[id]').each(function() {
            var oldId = this.id;
            this.id = 'settlement-' + panelKey + '-' + oldId;
        });

        $source.find('.settlement-receipt-input').each(function() {
            var field = this.id.replace('settlement-' + panelKey + '-', '');
            $(this).attr('data-field', field);
            this.removeAttribute('name');
        });

        $source.find('#settlement-' + panelKey + '-rollingSettlementDisplay').attr('data-field', 'rollingSettlementDisplay');
        $source.find('#settlement-' + panelKey + '-addChargeDisplay').attr('data-field', 'addChargeDisplay');
        $source.find('#settlement-' + panelKey + '-paymentDisplay').attr('data-field', 'paymentDisplay');
        $source.find('#settlement-' + panelKey + '-accNoPrefix').attr('data-field', 'accNoPrefix');
        $source.find('#settlement-' + panelKey + '-accNoName').attr('data-field', 'accNoName');
        $source.find('#settlement-' + panelKey + '-gameNo').attr('data-field', 'gameNo');
        $source.find('#settlement-' + panelKey + '-dateTime').attr('data-field', 'dateTime');

        var $panelBody = $('#settlement-edit-' + panelKey + '-body');
        $panelBody.empty().append($source);

        var $panel = $panelBody.closest('.settlement-edit-panel');
        // Add Charge (F&B/Hotel) applies to Guest only — Agent always 0
        $panel.data('add-charge', panelKey === 'agent' ? 0 : parseAmount($mainModal.find('#fb').val()));
        $panel.data('rolling-settlement', parseAmount($mainModal.find('#rollingSettlement').val()));
        $panel.data('payment', parseAmount($mainModal.find('#payment').val()));

        $panel.find('[data-field="accNoPrefix"]').text($mainModal.find('#accNoPrefix').text());
        $panel.find('[data-field="accNoName"]').text($mainModal.find('#accNoName').text());
        $panel.find('[data-field="gameNo"]').text($mainModal.find('#gameNo').text());
        $panel.find('[data-field="dateTime"]').text($mainModal.find('#dateTime').text());
        $panel.find('[data-field="buyIn"]').val($mainModal.find('#buyIn').val()).prop('readonly', true);
        $panel.find('[data-field="chipsReturn"]').val($mainModal.find('#chipsReturn').val()).prop('readonly', true);

        var houseWinLoss = parseAmount($mainModal.find('#winLoss').val());
        var $winLoss = $panel.find('[data-field="winLoss"]');
        $winLoss.val(formatAmount(houseWinLoss)).prop('readonly', true).attr('data-allow-negative', '1');

        $panel.find('[data-field="rolling"]').val($mainModal.find('#rolling').val()).prop('readonly', false);
        var rateRaw = String($mainModal.find('#rollingRate').val() || '').replace(/%/g, '').trim();
        $panel.find('[data-field="rollingRate"]').val(rateRaw).prop('readonly', false);

        recalcSettlementEditPanelTotals($panel);
        return $panel;
    }

    // Guest + Agent rolling always equals main Settlement rolling
    function syncCounterpartRolling($sourcePanel, clampEdited) {
        var $modal = $('#modal-settlement');
        var $guestPanel = $modal.find('#settlement-edit-guest-panel');
        var $agentPanel = $modal.find('#settlement-edit-agent-panel');
        if (!$sourcePanel || !$sourcePanel.length || !$guestPanel.length || !$agentPanel.length) {
            return;
        }

        var totalRolling = parseAmount($modal.find('#rolling').val());
        var isGuest = $sourcePanel.is('#settlement-edit-guest-panel');
        var $otherPanel = isGuest ? $agentPanel : $guestPanel;
        var $sourceInput = $sourcePanel.find('[data-field="rolling"]');
        var edited = parseAmount($sourceInput.val());

        if (clampEdited) {
            edited = Math.max(0, Math.min(totalRolling, edited));
            $sourceInput.val(formatAmount(edited));
        } else if (edited < 0) {
            edited = 0;
        }

        var otherRolling = Math.max(0, totalRolling - Math.min(edited, totalRolling));
        $otherPanel.find('[data-field="rolling"]').val(formatAmount(otherRolling));

        recalcSettlementEditPanelTotals($sourcePanel);
        recalcSettlementEditPanelTotals($otherPanel);
    }

    function clampSplitRate(value, max) {
        var num = parseFloat(String(value == null ? '' : value).replace(/,/g, '').replace(/%/g, '').trim());
        if (isNaN(num)) {
            num = 0;
        }
        var cap = Math.max(0, parseFloat(max) || 0);
        num = Math.min(cap, Math.max(0, num));
        return Math.round(num * 10000) / 10000;
    }

    function clampSplitPct(value) {
        var num = parseFloat(String(value == null ? '' : value).replace(/,/g, '').replace(/%/g, '').trim());
        if (isNaN(num)) {
            num = 0;
        }
        return Math.min(100, Math.max(0, Math.round(num * 100) / 100));
    }

    function formatSplitPctValue(num) {
        var text = String(Math.round(Number(num || 0) * 10000) / 10000);
        return text.replace(/(\.\d*?[1-9])0+$/, '$1').replace(/\.0+$/, '');
    }

    // Strips invalid characters while typing but keeps a trailing "." so
    // decimals like "1." / ".5" can still be completed (no rounding here).
    function sanitizeSplitRaw(value) {
        var str = String(value == null ? '' : value).replace(/,/g, '').replace(/%/g, '');
        if (!/^\d*\.?\d*$/.test(str)) {
            var cleaned = str.replace(/[^\d.]/g, '');
            var dot = cleaned.indexOf('.');
            if (dot !== -1) {
                cleaned = cleaned.slice(0, dot + 1) + cleaned.slice(dot + 1).replace(/\./g, '');
            }
            str = cleaned;
        }
        return str;
    }

    // Live version used on 'input': keeps a trailing "." so decimals can still
    // be typed, but the moment the value actually exceeds max it snaps to max
    // immediately instead of waiting for blur.
    function liveClampSplitInput(value, max) {
        var raw = sanitizeSplitRaw(value);
        var num = parseFloat(raw);
        if (!isNaN(num) && num > max) {
            return formatSplitPctValue(max);
        }
        return raw;
    }

    // Casino rolling here is only ever counted in whole thousands — no
    // hundreds/tens — so apportioned Rolling splits round to the nearest 1,000.
    function roundToThousand(value) {
        return Math.round(Number(value || 0) / 1000) * 1000;
    }

    function renderSplitAmountCell($cell, value) {
        var display = formatSettlementDueDisplay(value);
        $cell.text(display.text).toggleClass('is-negative', display.negative);
    }

    function refreshSettlementSplitCalculators($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        if (Number($modal.data('settlement-edit-mode')) !== 1) {
            return;
        }

        var totalRolling = parseAmount($modal.find('#rolling').val());
        var companyRate = clampSplitRate($modal.find('#calc-company-rate').val(), 100);

        $modal.find('#calc-company-rate-rolling').text(formatAmount(totalRolling));
        $modal.find('#calc-company-rate-rate-display').text(formatSplitPctValue(companyRate) + '%');
        var totalSettlement = Math.round((totalRolling * companyRate) / 100);
        renderSplitAmountCell($modal.find('#calc-company-rate-settlement'), totalSettlement);
        $modal.find('#calc-company-pct-rolling').text(formatAmount(totalRolling));
        renderSplitAmountCell($modal.find('#calc-company-pct-settlement'), totalSettlement);

        var guestRate = clampSplitRate($modal.find('#calc-guest-rate-input').val(), companyRate);
        var agentRate = Math.max(0, Math.round((companyRate - guestRate) * 10000) / 10000);
        var guestRateRolling = companyRate > 0 ? roundToThousand((totalRolling * guestRate) / companyRate) : 0;
        var agentRateRolling = Math.max(0, totalRolling - guestRateRolling);
        // Settlement is derived from the rounded Rolling (same figure that gets
        // applied to the real fields) so the preview here always matches what
        // shows up in the actual Guest/Agent panels above.
        var guestRateSettlement = Math.round((guestRateRolling * companyRate) / 100);
        var agentRateSettlement = Math.round((agentRateRolling * companyRate) / 100);

        $modal.find('#calc-guest-rate-rolling').text(formatAmount(guestRateRolling));
        renderSplitAmountCell($modal.find('#calc-guest-rate-settlement'), guestRateSettlement);
        $modal.find('#calc-agent-rate-rolling').text(formatAmount(agentRateRolling));
        $modal.find('#calc-agent-rate-display').text(formatSplitPctValue(agentRate) + '%');
        renderSplitAmountCell($modal.find('#calc-agent-rate-settlement'), agentRateSettlement);

        var guestPct = clampSplitPct($modal.find('#calc-guest-pct-input').val());
        var agentPct = Math.round((100 - guestPct) * 100) / 100;
        var guestPctRolling = roundToThousand((totalRolling * guestPct) / 100);
        var agentPctRolling = Math.max(0, totalRolling - guestPctRolling);
        // Same as above — Settlement follows the rounded Rolling so it matches
        // what actually lands in the real Guest/Agent panels.
        var guestPctSettlement = Math.round((guestPctRolling * companyRate) / 100);
        var agentPctSettlement = Math.round((agentPctRolling * companyRate) / 100);

        $modal.find('#calc-guest-pct-rolling').text(formatAmount(guestPctRolling));
        renderSplitAmountCell($modal.find('#calc-guest-pct-settlement'), guestPctSettlement);
        $modal.find('#calc-agent-pct-rolling').text(formatAmount(agentPctRolling));
        $modal.find('#calc-agent-pct-display').text(formatSplitPctValue(agentPct) + '%');
        renderSplitAmountCell($modal.find('#calc-agent-pct-settlement'), agentPctSettlement);
    }

    function restoreOriginalSplitToEditPanels($modal) {
        var rollingVal = $modal.find('#rolling').val();
        var rateRaw = String($modal.find('#rollingRate').val() || '').replace(/%/g, '').trim();
        [$modal.find('#settlement-edit-guest-panel'), $modal.find('#settlement-edit-agent-panel')].forEach(function($panel) {
            if (!$panel.length) {
                return;
            }
            $panel.find('[data-field="rolling"]').val(rollingVal);
            $panel.find('[data-field="rollingRate"]').val(rateRaw);
            recalcSettlementEditPanelTotals($panel);
        });
    }

    function applySettlementSplitToEditPanels($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var $guestPanel = $modal.find('#settlement-edit-guest-panel');
        var $agentPanel = $modal.find('#settlement-edit-agent-panel');
        if (!$guestPanel.length || !$agentPanel.length) {
            return;
        }

        var mode = $modal.data('split-active-mode');
        var totalRolling = parseAmount($modal.find('#rolling').val());

        if (mode === 'rate') {
            var companyRate = clampSplitRate($modal.find('#calc-company-rate').val(), 100);
            var guestRate = clampSplitRate($modal.find('#calc-guest-rate-input').val(), companyRate);
            var guestRolling = companyRate > 0 ? roundToThousand((totalRolling * guestRate) / companyRate) : 0;
            var agentRolling = Math.max(0, totalRolling - guestRolling);

            // Real Rate fields stay at the company rate — only Rolling changes,
            // so Guest/Agent Settlement (rolling × rate) still sums to the total.
            $guestPanel.find('[data-field="rolling"]').val(formatAmount(guestRolling));
            $agentPanel.find('[data-field="rolling"]').val(formatAmount(agentRolling));
            recalcSettlementEditPanelTotals($guestPanel);
            recalcSettlementEditPanelTotals($agentPanel);
        } else if (mode === 'pct') {
            var guestPct = clampSplitPct($modal.find('#calc-guest-pct-input').val());
            var guestPctRolling = roundToThousand((totalRolling * guestPct) / 100);
            var agentPctRolling = Math.max(0, totalRolling - guestPctRolling);

            $guestPanel.find('[data-field="rolling"]').val(formatAmount(guestPctRolling));
            $agentPanel.find('[data-field="rolling"]').val(formatAmount(agentPctRolling));
            recalcSettlementEditPanelTotals($guestPanel);
            recalcSettlementEditPanelTotals($agentPanel);
        } else {
            restoreOriginalSplitToEditPanels($modal);
        }
    }

    function resetSettlementSplitCalculators($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        $modal.removeData('split-active-mode');
        var rateRaw = String($modal.find('#rollingRate').val() || '').replace(/%/g, '').trim();
        $modal.find('#calc-company-rate').val(rateRaw || '0');
        $modal.find('#calc-guest-rate-input, #calc-guest-pct-input').val('0');
        $modal.find('#calc-agent-rate-display, #calc-agent-pct-display').text('0%');
    }

    function syncSettlementEditPanelBeforeCopy($panel) {
        if (!$panel || !$panel.length) {
            return;
        }
        formatInputWithCommas($panel.find('[data-field="rolling"]'));
        formatRollingRateInput($panel.find('[data-field="rollingRate"]'));
        recalcSettlementEditPanelTotals($panel);
    }

    function getSettlementEditPanelSlipBody($panel) {
        if (!$panel || !$panel.length) {
            return null;
        }
        return $panel.find('.settlement-edit-receipt-copy-area')[0] || null;
    }

    function wireSettlementEditPanelCopyButtons($panel) {
        if (!$panel || !$panel.length) {
            return;
        }

        $panel.find('.js-copy-settlement-slip-image').off('click.settlementEditCopy').on('click.settlementEditCopy', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = $(this);
            syncSettlementEditPanelBeforeCopy($panel);
            var slipBody = getSettlementEditPanelSlipBody($panel);
            if (!slipBody) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Receipt is not ready.', confirmButtonText: 'OK' });
                }
                return;
            }
            if (typeof window.copyGameReceiptSlipImage === 'function') {
                window.copyGameReceiptSlipImage(slipBody, $btn);
                return;
            }
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Image copy is not available.', confirmButtonText: 'OK' });
            }
        });

        $panel.find('.js-copy-settlement-slip-text').off('click.settlementEditCopy').on('click.settlementEditCopy', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = $(this);
            syncSettlementEditPanelBeforeCopy($panel);
            copySettlementReceiptSlipTextButton(getSettlementEditPanelSlipBody($panel), $btn);
        });
    }

    function placeSettlementEditButton($modal, inCopyRow) {
        var $editBtn = $modal.find('#edit-settlement-btn');
        if (inCopyRow) {
            $editBtn.detach().appendTo($modal.find('.settlement-main-content .settlement-copy-row'));
            return;
        }
        $editBtn.detach().insertAfter($modal.find('#submit-settlement-btn'));
    }

    function setSettlementEditMode($modal, enabled) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var isSettled = Number($modal.data('is-settled')) === 1;
        var $editBtn = $modal.find('#edit-settlement-btn');
        var $settleBtn = $modal.find('#submit-settlement-btn');
        var $cluster = $modal.find('#settlement-modal-cluster');
        var $guestPanel = $modal.find('#settlement-edit-guest-panel');
        var $agentPanel = $modal.find('#settlement-edit-agent-panel');
        var $splitPanels = $modal.find('#settlement-calc-company-panel, #settlement-calc-guest-panel, #settlement-calc-agent-panel');

        $modal.data('settlement-edit-mode', enabled ? 1 : 0);
        $cluster.toggleClass('is-edit-mode', enabled);

        if (enabled) {
            buildSettlementEditPanelReceipt($modal, 'guest');
            buildSettlementEditPanelReceipt($modal, 'agent');
            wireSettlementEditPanelCopyButtons($guestPanel);
            wireSettlementEditPanelCopyButtons($agentPanel);
            $guestPanel.removeClass('d-none').attr('aria-hidden', 'false');
            $agentPanel.removeClass('d-none').attr('aria-hidden', 'false');
            $splitPanels.removeClass('d-none').attr('aria-hidden', 'false');
            resetSettlementSplitCalculators($modal);
            refreshSettlementSplitCalculators($modal);
            $editBtn.text('Done');
            $settleBtn.hide();
            $modal.find('#print-settlement-btn').hide();
            $modal.find('.settlement-footer-actions').hide();
            $modal.find('.deposit-cashout-row').hide();
            placeSettlementEditButton($modal, true);
        } else {
            $guestPanel.addClass('d-none').attr('aria-hidden', 'true');
            $agentPanel.addClass('d-none').attr('aria-hidden', 'true');
            $splitPanels.addClass('d-none').attr('aria-hidden', 'true');
            $modal.find('#settlement-edit-guest-body, #settlement-edit-agent-body').empty();
            resetSettlementSplitCalculators($modal);
            $editBtn.text('Edit');
            placeSettlementEditButton($modal, false);
            $modal.find('.settlement-footer-actions').show();
            $modal.find('#print-settlement-btn').show();
            $settleBtn.show();
            if (isSettled) {
                $settleBtn.prop('disabled', true).text('Settled');
            } else {
                $settleBtn.prop('disabled', false).text('Settle');
            }
            $modal.find('.deposit-cashout-row').toggle(!isSettled);
        }
    }

    function resetSettlementModalView($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        if (Number($modal.data('settlement-edit-mode')) === 1) {
            setSettlementEditMode($modal, false);
        }

        var isSettled = Number($modal.data('is-settled')) === 1;
        var $settleBtn = $modal.find('#submit-settlement-btn');

        $settleBtn.show();
        if (isSettled) {
            $settleBtn.prop('disabled', true).text('Settled');
        } else {
            $settleBtn.prop('disabled', false).text('Settle');
        }

        $modal.find('.deposit-cashout-row').toggle(!isSettled);
        $modal.find('#print-settlement-btn').show();
        $modal.find('.settlement-footer-actions').show();
        placeSettlementEditButton($modal, false);
        $modal.find('#edit-settlement-btn').text('Edit').prop('disabled', false);
        $modal.find('#buyIn, #chipsReturn, #winLoss, #rolling, #rollingRate').prop('readonly', true);
        $modal.find('.settlement-service-amount').prop('readonly', true);
        refreshSettlementReceiptDisplay($modal);
        updateSettlementCopyButtons($modal);
    }

    $('#modal-settlement').on('shown.bs.modal', function() {
        resetSettlementModalView($(this));
    });

    $('#modal-settlement').on('hidden.bs.modal', function() {
        resetSettlementModalView($(this));
    });

    $('#edit-settlement-btn').on('click', function() {
        var $modal = $('#modal-settlement');
        var inEditMode = Number($modal.data('settlement-edit-mode')) === 1;
        setSettlementEditMode($modal, !inEditMode);
    });

    $('#modal-settlement').on('click', '.js-settlement-edit-panel-close', function() {
        setSettlementEditMode($('#modal-settlement'), false);
    });

    $('#modal-settlement').on('input', '.settlement-edit-panel [data-field="rolling"], .settlement-edit-panel [data-field="rollingRate"]', function() {
        var $input = $(this);
        var $panel = $input.closest('.settlement-edit-panel');
        if ($input.attr('data-field') === 'rolling') {
            formatInputWithCommasLive($input);
            syncCounterpartRolling($panel, false);
            return;
        }
        recalcSettlementEditPanelTotals($panel);
    });

    $('#modal-settlement').on('blur', '.settlement-edit-panel [data-field="rolling"]', function() {
        var $input = $(this);
        var $panel = $input.closest('.settlement-edit-panel');
        formatInputWithCommas($input);
        syncCounterpartRolling($panel, true);
    });

    $('#modal-settlement').on('blur', '.settlement-edit-panel [data-field="rollingRate"]', function() {
        formatRollingRateInput($(this));
        recalcSettlementEditPanelTotals($(this).closest('.settlement-edit-panel'));
    });

    function handleCompanyRateChange($modal, finalize) {
        var $input = $modal.find('#calc-company-rate');
        var raw = finalize ? formatSplitPctValue(clampSplitRate($input.val(), 100)) : liveClampSplitInput($input.val(), 100);
        $input.val(raw);
        refreshSettlementSplitCalculators($modal);
        if ($modal.data('split-active-mode') === 'rate') {
            applySettlementSplitToEditPanels($modal);
        }
    }

    $('#modal-settlement').on('input', '#calc-company-rate', function() {
        handleCompanyRateChange($('#modal-settlement'), false);
    });

    $('#modal-settlement').on('blur', '#calc-company-rate', function() {
        handleCompanyRateChange($('#modal-settlement'), true);
    });

    // Agent's Rate/Percentage fields are readonly (auto-computed) — Guest is the
    // only side the user types into.
    function handleRateSplitChange($modal, $input, finalize) {
        var companyRate = clampSplitRate($modal.find('#calc-company-rate').val(), 100);
        var raw = finalize ? formatSplitPctValue(clampSplitRate($input.val(), companyRate)) : liveClampSplitInput($input.val(), companyRate);
        $input.val(raw);
        var guestRate = clampSplitRate(raw, companyRate);

        if (guestRate > 0) {
            $modal.data('split-active-mode', 'rate');
        } else if ($modal.data('split-active-mode') === 'rate') {
            $modal.removeData('split-active-mode');
        }

        refreshSettlementSplitCalculators($modal);
        applySettlementSplitToEditPanels($modal);
    }

    $('#modal-settlement').on('input', '#calc-guest-rate-input', function() {
        handleRateSplitChange($('#modal-settlement'), $(this), false);
    });

    $('#modal-settlement').on('blur', '#calc-guest-rate-input', function() {
        handleRateSplitChange($('#modal-settlement'), $(this), true);
    });

    function handlePctSplitChange($modal, $input, finalize) {
        var raw = finalize ? formatSplitPctValue(clampSplitPct($input.val())) : liveClampSplitInput($input.val(), 100);
        $input.val(raw);
        var guestPct = clampSplitPct(raw);

        if (guestPct > 0) {
            $modal.data('split-active-mode', 'pct');
        } else if ($modal.data('split-active-mode') === 'pct') {
            $modal.removeData('split-active-mode');
        }

        refreshSettlementSplitCalculators($modal);
        applySettlementSplitToEditPanels($modal);
    }

    $('#modal-settlement').on('input', '#calc-guest-pct-input', function() {
        handlePctSplitChange($('#modal-settlement'), $(this), false);
    });

    $('#modal-settlement').on('blur', '#calc-guest-pct-input', function() {
        handlePctSplitChange($('#modal-settlement'), $(this), true);
    });

    $('#print-settlement-btn').on('click', function() {
        var $modal = $(this).closest('.modal');
        syncServiceTotalAndPayment($modal);
        openReceiptPrintWindow($modal);
    });

    $('#modal-settlement').on('click', '.settlement-main-content .js-copy-settlement-slip-image', function(e) {
        e.preventDefault();
        var $btn = $(this);
        var slipBody = document.getElementById('settlement-receipt-copy-area');
        if (typeof window.copyGameReceiptSlipImage === 'function') {
            window.copyGameReceiptSlipImage(slipBody, $btn);
            return;
        }
        if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Image copy is not available.', confirmButtonText: 'OK' });
        }
    });

    $('#modal-settlement').on('click', '.settlement-main-content .js-copy-settlement-slip-text', function(e) {
        e.preventDefault();
        var $btn = $(this);
        var slipBody = document.getElementById('settlement-receipt-copy-area');
        copySettlementReceiptSlipTextButton(slipBody, $btn);
    });
});
</script>