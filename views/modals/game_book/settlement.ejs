<script>
$(document).ready(function() {
    var settlementDoneSwal = {
        title: 'Done',
        savedOnly: 'Done.',
        withAgent: 'Done. Telegram message sent to Agent.',
        withCage: 'Done. Telegram message sent to Cage.',
        withBoth: 'Done. Telegram message sent to Agent and Cage.'
    };

    function showSettlementDoneSuccess(agentSent, cageSent) {
        if (typeof Swal === 'undefined') {
            return;
        }
        var body = settlementDoneSwal.savedOnly;
        if (agentSent && cageSent) {
            body = settlementDoneSwal.withBoth;
        } else if (agentSent) {
            body = settlementDoneSwal.withAgent;
        } else if (cageSent) {
            body = settlementDoneSwal.withCage;
        }
        Swal.fire({
            icon: 'success',
            title: settlementDoneSwal.title,
            text: body,
            confirmButtonText: 'OK'
        });
    }

    function cleanValue(value) {
        if (value === undefined || value === null) {
            return '0';
        }

        var text = String(value).trim();
        return text.length ? text : '0';
    }

    function parseAmount(value) {
        var num = parseFloat(String(value || '').replace(/,/g, '').trim());
        return isNaN(num) ? 0 : num;
    }

    function formatAmount(value) {
        return Number(value || 0).toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });
    }

    function formatSettlementDueDisplay(value) {
        var num = parseAmount(value);
        if (!num) {
            return { text: '0', negative: false };
        }
        return {
            text: '(' + formatAmount(Math.abs(num)) + ')',
            negative: true
        };
    }

    function formatSettlementRateDisplay(value) {
        var raw = String(value == null ? '' : value).replace(/,/g, '').trim();
        if (!raw) {
            return '';
        }
        return raw.indexOf('%') !== -1 ? raw : raw + '%';
    }

    function syncSettlementDateTimeDisplay($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var dateText = cleanValue($modal.find('#date').text());
        var timeText = cleanValue($modal.find('#time').text());
        var formatted = formatReceiptDateTime(dateText, timeText);
        if (/^\d{4}-\d{2}-\d{2}$/.test(dateText) && timeText) {
            var parts = dateText.split('-');
            formatted = parts[0] + '-' + parseInt(parts[1], 10) + '-' + parseInt(parts[2], 10) + ' ' + timeText;
        }
        $modal.find('#dateTime').text(formatted);
    }
    window.syncSettlementDateTimeDisplay = syncSettlementDateTimeDisplay;

    function refreshSettlementReceiptDisplay($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        syncSettlementDateTimeDisplay($modal);

        var settlementDisplay = formatSettlementDueDisplay($modal.find('#rollingSettlement').val());
        $modal.find('#rollingSettlementDisplay .settlement-receipt-amount')
            .text(settlementDisplay.text)
            .toggleClass('is-negative', settlementDisplay.negative);

        var paymentDisplay = formatSettlementDueDisplay($modal.find('#payment').val());
        $modal.find('#paymentDisplay .settlement-receipt-amount')
            .text(paymentDisplay.text)
            .toggleClass('is-negative', paymentDisplay.negative);

        $modal.find('#addChargeDisplay .settlement-receipt-amount').text(formatAmount($modal.find('#fb').val()));

        var $rate = $modal.find('#rollingRate');
        if ($rate.prop('readonly')) {
            $rate.val(formatSettlementRateDisplay($rate.val()));
        }
    }
    window.refreshSettlementReceiptDisplay = refreshSettlementReceiptDisplay;

    function setSettlementAccountDisplay($modal, agentCode, agentName) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var code = String(agentCode == null ? '' : agentCode).trim();
        var name = String(agentName == null ? '' : agentName).trim();
        var full = code ? (code + (name ? ' - ' + name : '')) : (name || 'N/A');
        var prefix = code ? (code + ' - ') : '';
        $modal.find('#accNo').text(full);
        $modal.find('#accNoPrefix').text(prefix);
        $modal.find('#accNoName').text(name);
        $modal.find('.settlement-receipt-prefix-ghost').text(prefix);
    }
    window.setSettlementAccountDisplay = setSettlementAccountDisplay;

    function updateSettlementCopyButtons($modal) {
        $modal = $modal && $modal.length ? $modal : $('#modal-settlement');
        var show = Number($modal.data('is-settled')) === 1;
        $modal.find('.settlement-copy-row').toggleClass('is-visible', show).attr('aria-hidden', show ? 'false' : 'true');
    }
    window.updateSettlementCopyButtons = updateSettlementCopyButtons;

    function formatInputWithCommas($input) {
        var raw = String($input.val() || '').replace(/,/g, '').trim();
        if (!raw) {
            $input.val('');
            return;
        }

        var allowNegative = $input.attr('id') === 'winLoss';
        var isNegative = allowNegative && raw.startsWith('-');
        var normalized = raw.replace(/[^\d.]/g, '');
        var firstDot = normalized.indexOf('.');
        if (firstDot !== -1) {
            normalized = normalized.slice(0, firstDot + 1) + normalized.slice(firstDot + 1).replace(/\./g, '');
        }

        if (isNegative && normalized) {
            normalized = '-' + normalized;
        }

        var num = parseFloat(normalized);
        if (isNaN(num)) {
            return;
        }

        $input.val(num.toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        }));
    }

    /** Rate: huwag i-collapse ang "1." bago matapos ang decimal (iwas sa naging "1" + "3" → "13") */
    function formatRollingRateInput($input) {
        var raw = String($input.val() || '').replace(/,/g, '').trim();
        if (!raw) {
            $input.val('');
            return;
        }
        var normalized = raw.replace(/[^\d.]/g, '');
        var dot = normalized.indexOf('.');
        if (dot !== -1) {
            normalized = normalized.slice(0, dot + 1) + normalized.slice(dot + 1).replace(/\./g, '');
        }
        var intPart = dot === -1 ? normalized : normalized.slice(0, dot);
        var fracPart = dot === -1 ? null : normalized.slice(dot + 1);
        if (intPart === '' && dot === -1 && (fracPart === null || fracPart === '')) {
            $input.val('');
            return;
        }
        var intNum = parseInt(intPart === '' ? '0' : intPart, 10);
        if (isNaN(intNum)) {
            intNum = 0;
        }
        var intStr = intNum.toLocaleString('en-US');
        if (dot !== -1) {
            $input.val(intStr + '.' + (fracPart === null ? '' : fracPart));
            return;
        }
        var num = parseFloat(normalized);
        if (isNaN(num)) {
            return;
        }
        $input.val(num.toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 4
        }));
    }

    function formatReceiptDateTime(dateText, timeText) {
        var dateValue = String(dateText || '').trim();
        var timeValue = String(timeText || '').trim();
        var formattedDate = dateValue;
        var formattedTime = timeValue;

        if (/^\d{4}-\d{2}-\d{2}$/.test(dateValue)) {
            var dateParts = dateValue.split('-');
            formattedDate = dateParts[1] + '/' + dateParts[2] + '/' + dateParts[0];
        }

        if (/^\d{2}:\d{2}:\d{2}$/.test(timeValue)) {
            formattedTime = timeValue.slice(0, 5);
        }

        return cleanValue(formattedDate + ' ' + formattedTime);
    }

    function updateReceiptPrintData($modal) {
        var dateText = cleanValue($modal.find('#date').text());
        var timeText = cleanValue($modal.find('#time').text());
        var accountRaw = cleanValue($modal.find('#accNo').text());
        var accountParts = accountRaw.split('-');
        var accountCode = cleanValue(accountParts[0]);
        var accountNameFromAccount = cleanValue(accountParts.slice(1).join('-'));
        var accountName = cleanValue($modal.find('input[name="txtAccountIDSettle"]').attr('data-name') || accountNameFromAccount);

        $modal.find('#printReceiptDateTime').text(formatReceiptDateTime(dateText, timeText));
        $modal.find('#printReceiptAccount').text(accountCode);
        $modal.find('#printReceiptName').text(accountName);
        $modal.find('#printReceiptBuyIn').text(cleanValue($modal.find('#buyIn').val() || $modal.find('#buyIn').text()));
        $modal.find('#printReceiptCashOut').text(cleanValue($modal.find('#chipsReturn').val() || $modal.find('#chipsReturn').text()));
        $modal.find('#printReceiptWinLoss').text(cleanValue($modal.find('#winLoss').val() || $modal.find('#winLoss').text()));
        $modal.find('#printReceiptRolling').text(cleanValue($modal.find('#rolling').val() || $modal.find('#rolling').text()));
        $modal.find('#printReceiptSettlement').text(cleanValue($modal.find('#rollingSettlement').val() || $modal.find('#rollingSettlement').text()));
        var $printServices = $modal.find('#printReceiptServices');
        $printServices.empty();
        $modal.find('.settlement-service-row').each(function () {
            var label = $(this).find('.settlement-service-label').text().trim();
            var value = cleanValue($(this).find('.settlement-service-amount').val());
            if (!label || value === '0') {
                return;
            }
            $printServices.append(
                '<div class="receipt-row"><span>' + label + ' :</span><span>' + value + '</span></div>'
            );
        });
        $modal.find('#printReceiptIncidential').text('0');
        $modal.find('#printReceiptTotal').text(cleanValue($modal.find('#payment').val() || $modal.find('#payment').text()));
    }

    function getReceiptPrintStyles() {
        return '@page{size:auto;margin:6mm;}html,body{margin:0;padding:0;}body{font-family:Arial,sans-serif;color:#000;} .receipt-print-content{width:100%;max-width:200mm;margin:0 auto;font-size:5mm;line-height:1.3;} .receipt-brand{text-align:center;font-weight:700;font-size:7.5mm;margin:0;letter-spacing:.3px;} .receipt-subtitle{text-align:center;font-weight:700;font-size:6.4mm;margin:4mm 0 0;} .receipt-datetime{text-align:center;font-weight:700;font-size:5.6mm;margin:2mm 0 4mm;} .receipt-line{border-top:1px solid #000;width:104mm;margin:4mm auto;} .receipt-row{display:grid;grid-template-columns:42mm 42mm;justify-content:center;align-items:baseline;column-gap:18mm;width:100%;margin:1mm auto;} .receipt-row span:first-child{text-align:right;font-weight:700;white-space:nowrap;} .receipt-row span:last-child{text-align:left;font-weight:700;white-space:nowrap;} .receipt-total span{font-size:7mm;}';
    }

    function openReceiptPrintWindow($modal) {
        var receiptHtml = $modal.find('.receipt-print-only').html();
        var iframe = document.createElement('iframe');
        iframe.style.position = 'fixed';
        iframe.style.right = '0';
        iframe.style.bottom = '0';
        iframe.style.width = '0';
        iframe.style.height = '0';
        iframe.style.border = '0';
        iframe.setAttribute('aria-hidden', 'true');
        document.body.appendChild(iframe);

        var iframeDoc = iframe.contentWindow.document;
        iframeDoc.open();
        iframeDoc.write('<!doctype html><html><head><title>Settlement Receipt</title><style>' + getReceiptPrintStyles() + '</style></head><body>' + receiptHtml + '</body></html>');
        iframeDoc.close();

        setTimeout(function() {
            iframe.contentWindow.focus();
            iframe.contentWindow.print();
            setTimeout(function() {
                if (iframe && iframe.parentNode) {
                    iframe.parentNode.removeChild(iframe);
                }
            }, 500);
        }, 100);
    }

    function syncServiceTotalAndPayment($modal) {
        var servicesTotal = 0;
        $modal.find('.settlement-service-amount').each(function () {
            servicesTotal += parseAmount($(this).val());
        });
        var settlement = parseAmount($modal.find('#rollingSettlement').val());
        var payment = settlement - servicesTotal;

        $modal.find('#fb').val(formatAmount(servicesTotal));
        $modal.find('#payment').val(formatAmount(payment));
        refreshSettlementReceiptDisplay($modal);
    }

    /** Edit mode: Settlement = Rolling × (Rate ÷ 100), pareho ng commission % sa game list */
    function updateSettlementFromRollingAndRate($modal) {
        if (!Number($modal.data('edit-mode'))) {
            return;
        }
        var linkedIds = $modal.data('cutoffSettlementGameIds');
        var viewMode = $modal.data('settlementViewMode') || 'total';
        if ((Array.isArray(linkedIds) && linkedIds.length > 1) || viewMode === 'total') {
            syncServiceTotalAndPayment($modal);
            return;
        }
        var rolling = parseAmount($modal.find('#rolling').val());
        var rate = parseAmount($modal.find('#rollingRate').val());
        var settlement = Math.round((rolling * rate) / 100);
        $modal.find('#rollingSettlement').val(settlement.toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
        }));
        syncServiceTotalAndPayment($modal);
    }

    function captureSettlementSnapshot($modal) {
        var snapshot = {
            buyIn: $modal.find('#buyIn').val(),
            chipsReturn: $modal.find('#chipsReturn').val(),
            winLoss: $modal.find('#winLoss').val(),
            rolling: $modal.find('#rolling').val(),
            rollingRate: $modal.find('#rollingRate').val(),
            rollingSettlement: $modal.find('#rollingSettlement').val(),
            serviceRows: $modal.find('.settlement-service-row').map(function () {
                return {
                    label: $(this).find('.settlement-service-label').text().trim(),
                    amount: parseAmount($(this).find('.settlement-service-amount').val())
                };
            }).get(),
            payment: $modal.find('#payment').val(),
            fbHidden: $modal.find('#fb').val(),
            transType: $modal.find('input[name="txtTransType"]:checked').val() || ''
        };
        $modal.data('settlement-snapshot', snapshot);
    }

    function restoreSettlementSnapshot($modal) {
        var snapshot = $modal.data('settlement-snapshot');
        if (!snapshot) {
            return;
        }

        $modal.find('#buyIn').val(snapshot.buyIn);
        $modal.find('#chipsReturn').val(snapshot.chipsReturn);
        $modal.find('#winLoss').val(snapshot.winLoss);
        $modal.find('#rolling').val(snapshot.rolling);
        $modal.find('#rollingRate').val(snapshot.rollingRate);
        $modal.find('#rollingSettlement').val(snapshot.rollingSettlement);
        if (typeof window.renderSettlementServiceRowsFromEntries === 'function') {
            window.renderSettlementServiceRowsFromEntries(snapshot.serviceRows || []);
        }
        $modal.find('#payment').val(snapshot.payment);
        $modal.find('#fb').val(snapshot.fbHidden);
        $modal.find('input[name="txtTransType"]').prop('checked', false);
        if (snapshot.transType) {
            $modal.find('input[name="txtTransType"][value="' + snapshot.transType + '"]').prop('checked', true);
        }
        refreshSettlementReceiptDisplay($modal);
    }

    function setSettlementEditMode($modal, enabled) {
        var isSettled = Number($modal.data('is-settled')) === 1;
        var fakeActive = Number($modal.data('fake-settle-active')) === 1;
        $modal.data('edit-mode', enabled ? 1 : 0);
        var $settleBtn = $modal.find('#submit-settlement-btn');
        if (enabled) {
            $settleBtn.hide();
        } else {
            $settleBtn.show();
            if (isSettled) {
                $settleBtn.prop('disabled', true).text('Settled');
            } else {
                $settleBtn.prop('disabled', false).text('Settle');
            }
        }
        $modal.find('.deposit-cashout-row').toggle(!enabled && !isSettled);
        // Habang Edit: palaging fake slip — Agent/Cage. Unsettled + Done na may fake: show bago mag-Settle.
        $modal.find('#settlement-telegram-opts').toggle(
            enabled || (fakeActive && !isSettled && !enabled)
        );
        $modal.find('#close-settlement-btn').toggle(!enabled);
        $modal.find('#edit-settlement-btn').text(enabled ? 'Done' : 'Edit');

        if (enabled) {
            var rateRaw = String($modal.find('#rollingRate').val() || '').replace(/%/g, '').trim();
            $modal.find('#rollingRate').val(rateRaw);
        }

        $modal.find('#buyIn, #chipsReturn, #winLoss').prop('readonly', true);
        $modal.find('.settlement-service-amount').prop('readonly', true);
        $modal.find('#rolling, #rollingRate').prop('readonly', !enabled);
        refreshSettlementReceiptDisplay($modal);
        updateSettlementCopyButtons($modal);
    }

    $('#modal-settlement').on('shown.bs.modal', function() {
        $(this).removeData('settlement-snapshot');
        $(this).find('#settleSendAgent, #settleSendCage').prop('checked', false);
        setSettlementEditMode($(this), false);
        updateSettlementCopyButtons($(this));
    });

    $('#modal-settlement').on('hidden.bs.modal', function() {
        $(this).removeData('settlement-snapshot');
        setSettlementEditMode($(this), false);
        updateSettlementCopyButtons($(this));
    });

    $('#edit-settlement-btn').on('click', function() {
        var $modal = $(this).closest('.modal');
        var isEditMode = !!$modal.data('edit-mode');
        var isSettled = Number($modal.data('is-settled')) === 1;
        var gameId = $modal.find('input[name="game_id_settle"]').val();

        if (!isEditMode) {
            captureSettlementSnapshot($modal);
            setSettlementEditMode($modal, true);
            updateSettlementFromRollingAndRate($modal);
            return;
        }

        function finishDone(telegramAgent, telegramCage) {
            // Unsettled: discard edits (restore snapshot). Settled: keep on-screen values.
            if (!isSettled) {
                restoreSettlementSnapshot($modal);
            }
            setSettlementEditMode($modal, false);
            $modal.removeData('settlement-snapshot');
            showSettlementDoneSuccess(!!telegramAgent, !!telegramCage);
        }

        function putFakeSettleThenFinish(telegramAgent, telegramCage) {
            if (!gameId) {
                finishDone(false, false);
                return;
            }
            $.ajax({
                url: '/game_list/' + encodeURIComponent(gameId) + '/settlement_fake_settle',
                type: 'PUT',
                data: { fake_settle: 1 },
                success: function () {
                    if (!isSettled) {
                        $modal.data('fake-settle-active', 1);
                    }
                    finishDone(telegramAgent, telegramCage);
                },
                error: function () {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Could not save settlement status. Try again.',
                            confirmButtonText: 'OK'
                        });
                    }
                }
            });
        }

        syncServiceTotalAndPayment($modal);

        var sendAgent = $modal.find('#settleSendAgent').is(':checked');
        var sendCage = $modal.find('#settleSendCage').is(':checked');

        if (sendAgent || sendCage) {
            $.ajax({
                type: 'POST',
                url: '/settlement_slip_telegram',
                data: $('#add_settlement').serialize(),
                success: function () {
                    putFakeSettleThenFinish(sendAgent, sendCage);
                },
                error: function (xhr) {
                    var msg = 'Could not send Telegram.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: msg,
                            confirmButtonText: 'OK'
                        });
                    }
                }
            });
            return;
        }

        putFakeSettleThenFinish(false, false);
    });

    $('#modal-settlement').on('input', '.settlement-service-amount, #rollingSettlement', function() {
        var $modal = $(this).closest('.modal');
        if ($modal.data('edit-mode')) {
            syncServiceTotalAndPayment($modal);
        }
    });

    $('#rolling, #rollingRate').on('input', function() {
        var $modal = $(this).closest('.modal');
        if (!$modal.data('edit-mode')) {
            return;
        }
        if (this.id === 'rollingRate') {
            formatRollingRateInput($(this));
        } else {
            formatInputWithCommas($(this));
        }
        updateSettlementFromRollingAndRate($modal);
    });

    $('#print-settlement-btn').on('click', function() {
        var $modal = $(this).closest('.modal');
        syncServiceTotalAndPayment($modal);
        updateReceiptPrintData($modal);
        openReceiptPrintWindow($modal);
    });

    $('#modal-settlement').on('click', '.js-copy-settlement-slip-image', function(e) {
        e.preventDefault();
        var $btn = $(this);
        var slipBody = document.getElementById('settlement-receipt-copy-area');
        if (typeof window.copyGameReceiptSlipImage === 'function') {
            window.copyGameReceiptSlipImage(slipBody, $btn);
            return;
        }
        if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Image copy is not available.', confirmButtonText: 'OK' });
        }
    });

    $('#modal-settlement').on('click', '.js-copy-settlement-slip-text', function(e) {
        e.preventDefault();
        var $btn = $(this);
        var slipBody = document.getElementById('settlement-receipt-copy-area');
        if (typeof window.copyGameReceiptSlipTextButton === 'function') {
            window.copyGameReceiptSlipTextButton(slipBody, $btn);
            return;
        }
        if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'error', title: 'Copy failed', text: 'Text copy is not available.', confirmButtonText: 'OK' });
        }
    });
});
</script>