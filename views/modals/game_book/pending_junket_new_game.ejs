<div class="modal fade" id="modal-pending-junket-new-game" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white">Pending — New Game</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="pending_junket_new_game_form">
				<div class="modal-body">
					<!-- <div class="alert alert-warning mb-3" role="alert">
						<small>
							<strong>Junket absorbs</strong> the cost by opening a new game with matching buy-in.
							Roller chips on the pending game are <strong>not</strong> changed — balance stays as shown.
						</small>
					</div> -->
					<div class="alert alert-info mb-3 py-2" role="alert">
						<small>Outstanding balance: <strong id="pending-junket-balance-display">0</strong></small>
					</div>

					<input type="hidden" name="pending_game_id" id="pending_junket_pending_game_id">
					<input type="hidden" name="txtGameType" id="pending_junket_game_type" value="LIVE">
					<input type="hidden" name="txtCommisionType" id="pending_junket_commission_type" value="1">
					<input type="hidden" name="txtCommisionRate" id="pending_junket_commission_rate" value="0">
					<input type="hidden" name="totalBalanceGuest1" id="pending_junket_total_balance">
					<input type="hidden" name="required_balance" id="pending_junket_required_balance">

					<div class="row mb-3">
						<div class="col-sm-12">
							<label class="form-label mb-1">Account <span class="text-danger">*</span></label>
							<select class="form-select" id="pending_junket_txtAccount" name="txtAccountCode" style="width: 100%;" data-placeholder="Choose account...">
								<option value="">--SELECT ACCOUNT--</option>
							</select>
						</div>
					</div>

					<div class="row mb-3">
						<div class="col-sm-6">
							<label class="form-label">Buy-in NN Chips <span class="text-danger">*</span></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center" name="txtNN" id="pending_junket_txtNN" placeholder="NN Chips">
						</div>
						<div class="col-sm-6">
							<label class="form-label">Buy-in CC Chips <span class="text-danger">*</span></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center" name="txtCC" id="pending_junket_txtCC" placeholder="CC Chips">
						</div>
					</div>
					<div class="row mb-2">
						<div class="col-sm-12">
							<small class="text-muted">Total buy-in must equal the outstanding balance.</small>
						</div>
					</div>

					<div class="row mb-3">
						<div class="col-sm-12">
							<label class="form-label mb-1">Remarks</label>
							<textarea class="form-control" name="txtRemarks" id="pending_junket_txtRemarks" rows="2" maxlength="500" placeholder="Optional notes"></textarea>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="submit" id="submit-pending-junket-new-game-btn" class="btn btn-sm btn-primary">Save</button>
					<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Close</button>
				</div>
			</form>
		</div>
	</div>
</div>
