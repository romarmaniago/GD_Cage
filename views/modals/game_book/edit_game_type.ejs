<div class="modal fade" id="modal-edit-game-type" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white">Game Type - <span id="edit-game-type-agent-code"></span></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="form-edit-game-type">
				<div class="modal-body">
					<input type="hidden" id="edit-game-type-game-id" />
					<input type="hidden" id="edit-game-type-prev" />
					<label class="form-label">Type</label>
					<div class="d-flex align-items-center flex-wrap gap-3 gap-sm-4">
						<div class="form-check mb-0">
							<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="edit-game-type-live" name="editGameType" value="LIVE" required>
							<label class="form-check-label css-blue" for="edit-game-type-live"><%= __('gamelist.live') %></label>
						</div>
						<div class="form-check mb-0">
							<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="edit-game-type-telebet" name="editGameType" value="TELEBET" required>
							<label class="form-check-label css-red" for="edit-game-type-telebet"><%= __('gamelist.telebet') %></label>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="submit" id="edit-game-type-save-btn" class="btn btn-primary">Update</button>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				</div>
			</form>
		</div>
	</div>
</div>
