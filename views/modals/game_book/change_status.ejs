<div class="modal fade" id="modal-change_status" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white" id="staticBackdropLiveLabel"><%= __('modal_change_status.change_status') %> - <span id="change-status-agent-code"></span></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="edit_status">
			<div class="modal-body">
			<input type="hidden" name="txtGameId" class="txtGameId" >
			<input type="hidden" name="txtAccountCode" class="txtAccountCode" >
			<input type="hidden" name="txtCapital" class="txtCapital">
			<input type="hidden" name="txtFinalChips" class="txtFinalChips">
			<input type="hidden" name="txtTotalRolling" class="txtTotalRolling">
			<input type="hidden" name="txtWinloss" class="txtWinloss">
			<div id="change-status-normal-section">
			<div class="row mb-2">
				<div class="col-sm-12">
					<select class=" form-select" name="txtStatus" style="width: 100%;" data-placeholder="Choose a status..."
						id="status">
						<option selected disabled><%= __('modal_change_status.select_status_placeholder') %></option>
						<option value="2"><%= __('modal_change_status.on_game_option') %></option>
						<!-- <option value="3">FINISH</option> -->
						<option value="1"><%= __('modal_change_status.end_game_option') %></option>
						<option value="4"><%= __('modal_change_status.cutoff_option') %></option>
					</select>
				</div>
			</div>
			</div>

			<div id="pending-resolve-status-banner" class="alert alert-success py-2 mb-2" style="display: none;" role="alert">
				<small id="pending-resolve-status-text"></small>
			</div>

			<div id="cutoff-details-section" style="display: none;" class="mt-3 pt-3 border-top">
				<input type="hidden" name="txtCutoffUseSplit" id="txtCutoffUseSplit" value="0" />
				<input type="hidden" name="txtCutoffBuyInNN" id="txtCutoffBuyInNN" value="" />
				<input type="hidden" name="txtCutoffBuyInCC" id="txtCutoffBuyInCC" value="" />

				<table class="cutoff-excel-grid cutoff-excel-meta mb-2">
					<tbody>
						<tr>
							<td class="cutoff-excel-label"><%= __('modal_change_status.cutoff_date_label') %></td>
							<td class="cutoff-excel-input" colspan="2">
								<input type="text" class="cutoff-excel-field" name="txtCutoffProgramDate" id="txtCutoffProgramDate" autocomplete="off" placeholder="YYYY-MM-DD" />
							</td>
						</tr>
					</tbody>
				</table>

				<table class="cutoff-excel-grid cutoff-excel-chips">
					<thead>
						<tr>
							<th class="cutoff-excel-label cutoff-excel-head-spacer"></th>
							<th class="cutoff-excel-head cutoff-excel-head-nn"><span class="cutoff-chip-indicator cutoff-chip-indicator-nn" aria-hidden="true"></span><%= __('modal_new_game_list.nn_placeholder') %></th>
							<th class="cutoff-excel-head cutoff-excel-head-cc"><span class="cutoff-chip-indicator cutoff-chip-indicator-cc" aria-hidden="true"></span><%= __('modal_new_game_list.cc_placeholder') %></th>
						</tr>
					</thead>
					<tbody>
						<tr id="cutoff-remaining-row">
							<td class="cutoff-excel-label"><label class="mb-0" for="txtCutoffRemainingNN"><%= __('modal_change_status.cutoff_remaining_chips') %></label></td>
							<td class="cutoff-excel-input">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center cutoff-nn-input" name="txtCutoffRemainingNN" id="txtCutoffRemainingNN"
									placeholder="<%= __('modal_new_game_list.nn_placeholder') %>" autocomplete="off" />
							</td>
							<td class="cutoff-excel-input">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center" name="txtCutoffRemainingCC" id="txtCutoffRemainingCC"
									placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" autocomplete="off" />
							</td>
						</tr>
					</tbody>
					<tbody id="cutoff-split-rows" style="display: none;">
						<tr>
							<td class="cutoff-excel-label"><label class="mb-0" for="txtCutoffCashNN"><%= __('modal_change_status.cutoff_cash') %></label></td>
							<td class="cutoff-excel-input">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center cutoff-nn-input cutoff-split-input" name="txtCutoffCashNN" id="txtCutoffCashNN"
									placeholder="<%= __('modal_new_game_list.nn_placeholder') %>" autocomplete="off" />
							</td>
							<td class="cutoff-excel-input">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center cutoff-split-input" name="txtCutoffCashCC" id="txtCutoffCashCC"
									placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" autocomplete="off" />
							</td>
						</tr>
						<tr>
							<td class="cutoff-excel-label"><label class="mb-0" for="txtCutoffDepNN"><%= __('modal_change_status.cutoff_deposit') %></label></td>
							<td class="cutoff-excel-input">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center cutoff-nn-input cutoff-split-input" name="txtCutoffDepNN" id="txtCutoffDepNN"
									placeholder="<%= __('modal_new_game_list.nn_placeholder') %>" autocomplete="off" />
							</td>
							<td class="cutoff-excel-input">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center cutoff-split-input" name="txtCutoffDepCC" id="txtCutoffDepCC"
									placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" autocomplete="off" />
							</td>
						</tr>
						<tr>
							<td class="cutoff-excel-label"><label class="mb-0" for="txtCutoffCreditNN"><%= __('modal_change_status.cutoff_credit') %></label></td>
							<td class="cutoff-excel-input">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center cutoff-nn-input cutoff-split-input" name="txtCutoffCreditNN" id="txtCutoffCreditNN"
									placeholder="<%= __('modal_new_game_list.nn_placeholder') %>" autocomplete="off" />
							</td>
							<td class="cutoff-excel-input">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center cutoff-split-input" name="txtCutoffCreditCC" id="txtCutoffCreditCC"
									placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" autocomplete="off" />
							</td>
						</tr>
					</tbody>
					<tbody>
						<tr class="cutoff-excel-split-row">
							<td class="cutoff-excel-label cutoff-excel-split-cell">
								<div class="form-check mb-0">
									<input class="form-check-input" style="border-color: #8a92a6 !important;" type="checkbox" id="chkCutoffSplit" />
									<label class="form-check-label" for="chkCutoffSplit"><%= __('modal_change_status.cutoff_split') %></label>
								</div>
							</td>
							<td class="cutoff-excel-input"></td>
							<td class="cutoff-excel-input"></td>
						</tr>
						<tr>
							<td class="cutoff-excel-label"><label class="mb-0" for="txtCutoffTipRollerNn"><%= __('modal_change_status.cutoff_tip_roller') %></label></td>
							<td class="cutoff-excel-input">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center cutoff-nn-input" name="txtCutoffTipRollerNn" id="txtCutoffTipRollerNn"
									placeholder="<%= __('modal_new_game_list.nn_placeholder') %>" autocomplete="off" />
							</td>
							<td class="cutoff-excel-input">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center" name="txtCutoffTipRollerCc" id="txtCutoffTipRollerCc"
									placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" autocomplete="off" />
							</td>
						</tr>
						<tr>
							<td class="cutoff-excel-label"><label class="mb-0" for="txtCutoffTipDealerNn"><%= __('modal_change_status.cutoff_tip_dealer') %></label></td>
							<td class="cutoff-excel-input">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center cutoff-nn-input" name="txtCutoffTipDealerNn" id="txtCutoffTipDealerNn"
									placeholder="<%= __('modal_new_game_list.nn_placeholder') %>" autocomplete="off" />
							</td>
							<td class="cutoff-excel-input">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center" name="txtCutoffTipDealerCc" id="txtCutoffTipDealerCc"
									placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" autocomplete="off" />
							</td>
						</tr>
						<tr class="cutoff-excel-last-row">
							<td class="cutoff-excel-label"><label class="mb-0" for="txtCutoffLastRolling"><%= __('modal_change_status.cutoff_last_rolling_label') %></label></td>
							<td class="cutoff-excel-input cutoff-excel-last-input" colspan="2">
								<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
									class="cutoff-excel-field text-center" name="txtCutoffLastRolling" id="txtCutoffLastRolling"
									placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" autocomplete="off" />
							</td>
						</tr>
					</tbody>
				</table>
			</div>
			
			<!-- Roller Chips Return Section (END GAME only) -->
			<div id="roller-chips-return-section" style="display: none; margin-top: 20px; padding-top: 20px; border-top: 1px solid #dee2e6;">
				<div id="roller-chips-return-summary" class="alert alert-info" role="alert" style="padding: 10px; margin-bottom: 15px;">
				<small>
						<table style="margin-top:4px;width:100%;border-collapse:collapse;">
							<tr>
								<td style="padding:4px 0;font-weight:600;">Total ADD :</td>
								<td style="padding:4px 0;text-align:right;">
									<div>NN: <span id="required-return-total-add-nn">0</span></div>
									<div>CC: <span id="required-return-total-add-cc">0</span></div>
								</td>
							</tr>
							<tr>
								<td style="padding:4px 0;font-weight:600;">Total RETURN:</td>
								<td style="padding:4px 0;text-align:right;">
									<div>NN: <span id="required-return-total-return-nn">0</span></div>
									<div>CC: <span id="required-return-total-return-cc">0</span></div>
								</td>
							</tr>
							<tr>
								<td style="padding:4px 0;font-weight:600;color:red;">Required RETURN:</td>
								<td style="padding:4px 0;text-align:right;">
									<span id="required-return-total" style="color:red;font-weight:bold;">0</span>
								</td>
							</tr>
						</table>
					</small>
				</div>
				<div id="roller-chips-return-inputs">
				<div class="row mb-2">
					<div class="col-sm-6">
						<label class="form-label">Return NN Chips <span class="text-danger">*</span></label>
						<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" 
							class="form-control text-center txtReturnRollerNN" 
							placeholder="NN Chips" name="txtReturnRollerNN" id="txtReturnRollerNN">
						<small id="return-roller-remaining-hint" class="d-block mt-1 text-danger fw-semibold" style="display: none;"></small>
					</div>
					<div class="col-sm-6">
						<label class="form-label">Return CC Chips <span class="text-danger">*</span></label>
						<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" 
							class="form-control text-center txtReturnRollerCC" 
							placeholder="CC Chips" name="txtReturnRollerCC" id="txtReturnRollerCC">
					</div>
				</div>
				<div class="row">
					<div class="col-sm-12">
						<small class="text-info">You can return any mix of NN/CC as long as the total equals the required amount.</small>
					</div>
				</div>
				</div>

				<div id="pending-resolution-section" style="display: none;" class="mt-3 pt-3 border-top">
					<small class="text-muted d-block mb-2">Resolve outstanding balance:</small>
					<div class="row g-2">
						<div class="col-sm-6">
							<button type="button" class="btn btn-sm btn-primary w-100" id="btn-pending-guest-buyin">
								Additional Buy-in
							</button>
						</div>
						<div class="col-sm-6">
							<button type="button" class="btn btn-sm btn-warning w-100" id="btn-pending-junket-new-game">
								New Game
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="modal-footer">
			<button type="submit" class="btn btn-sm btn-primary" id="submit-status-btn">
				<%= __('modal_change_status.save') %>
			</button>
			
			
			<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
				<%= __('modal_change_status.close') %>
			</button>
		</div>
			</form>
		</div>
	</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
	var nnInput = document.querySelector('#modal-change_status .txtReturnRollerNN');
	if (!nnInput) return;

	function validateReturnNNInline() {
		var raw = (nnInput.value || '').toString().replace(/,/g, '');
		var trimmed = raw.trim();

		// Allow empty while typing
		if (!trimmed) {
			nnInput.classList.remove('is-invalid');
			return;
		}

		var value = Number(trimmed);

		if (!Number.isFinite(value) || value <= 0 || value % 1000 !== 0) {
			nnInput.classList.add('is-invalid');
		} else {
			nnInput.classList.remove('is-invalid');
		}
	}

	nnInput.addEventListener('input', validateReturnNNInline);

	var ccInput = document.querySelector('#modal-change_status .txtReturnRollerCC');
	function onReturnInputChange() {
		if (typeof updateReturnRollerRemainingHint === 'function') {
			updateReturnRollerRemainingHint();
		}
	}
	nnInput.addEventListener('input', onReturnInputChange);
	if (ccInput) {
		ccInput.addEventListener('input', onReturnInputChange);
	}
});
</script>

