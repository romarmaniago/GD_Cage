<div class="modal fade" id="modal-change_status" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white" id="staticBackdropLiveLabel"><%= __('modal_change_status.change_status') %> - <span id="change-status-agent-code"></span></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="edit_status">
			<div class="modal-body">
			<input type="hidden" name="txtGameId" class="txtGameId" >
			<input type="hidden" name="txtAccountCode" class="txtAccountCode" >
			<input type="hidden" name="txtCapital" class="txtCapital">
			<input type="hidden" name="txtFinalChips" class="txtFinalChips">
			<input type="hidden" name="txtTotalRolling" class="txtTotalRolling">
			<input type="hidden" name="txtWinloss" class="txtWinloss">
			<div id="change-status-normal-section">
			<div class="row mb-2">
				<div class="col-sm-12">
					<select class=" form-select" name="txtStatus" style="width: 100%;" data-placeholder="Choose a status..."
						id="status">
						<option selected disabled><%= __('modal_change_status.select_status_placeholder') %></option>
						<option value="2"><%= __('modal_change_status.on_game_option') %></option>
						<!-- <option value="3">FINISH</option> -->
						<option value="1"><%= __('modal_change_status.end_game_option') %></option>
						<option value="4">CUT OFF</option>
					</select>
				</div>
			</div>
			</div>

			<div id="pending-resolve-status-banner" class="alert alert-success py-2 mb-2" style="display: none;" role="alert">
				<small id="pending-resolve-status-text"></small>
			</div>

			<div id="cutoff-parent-date-section" class="row mb-2" style="display: none;">
				<div class="col-sm-12">
					<label class="form-label mb-1" for="txtCutoffParentSettlementDate"><strong>Date</strong></label>
					<input type="text" class="form-control" name="txtCutoffParentSettlementDate" id="txtCutoffParentSettlementDate" autocomplete="off" placeholder="YYYY-MM-DD" />
					
				</div>
			</div>

			<div id="cutoff-roller-auto-section" style="display: none; margin-top: 15px;" class="alert alert-info mb-0" role="alert">
				<small>
					<strong>Cut Off:</strong> Remaining roller chips will be returned on this game and automatically added to the new cut off game.
					<div class="mt-2">
						<div>Remaining: <strong id="cutoff-auto-roller-total">0</strong></div>
					</div>
				</small>
			</div>
			
			<!-- Roller Chips Return Section (END GAME only) -->
			<div id="roller-chips-return-section" style="display: none; margin-top: 20px; padding-top: 20px; border-top: 1px solid #dee2e6;">
				<div id="roller-chips-return-summary" class="alert alert-info" role="alert" style="padding: 10px; margin-bottom: 15px;">
				<small>
						<table style="margin-top:4px;width:100%;border-collapse:collapse;">
							<tr>
								<td style="padding:4px 0;font-weight:600;">Total ADD :</td>
								<td style="padding:4px 0;text-align:right;">
									<div>NN: <span id="required-return-total-add-nn">0</span></div>
									<div>CC: <span id="required-return-total-add-cc">0</span></div>
								</td>
							</tr>
							<tr>
								<td style="padding:4px 0;font-weight:600;">Total RETURN:</td>
								<td style="padding:4px 0;text-align:right;">
									<div>NN: <span id="required-return-total-return-nn">0</span></div>
									<div>CC: <span id="required-return-total-return-cc">0</span></div>
								</td>
							</tr>
							<tr>
								<td style="padding:4px 0;font-weight:600;color:red;">Required RETURN:</td>
								<td style="padding:4px 0;text-align:right;">
									<span id="required-return-total" style="color:red;font-weight:bold;">0</span>
								</td>
							</tr>
						</table>
					</small>
				</div>
				<div id="roller-chips-return-inputs">
				<div class="row mb-2">
					<div class="col-sm-6">
						<label class="form-label">Return NN Chips <span class="text-danger">*</span></label>
						<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" 
							class="form-control text-center txtReturnRollerNN" 
							placeholder="NN Chips" name="txtReturnRollerNN" id="txtReturnRollerNN">
						<small id="return-roller-remaining-hint" class="d-block mt-1 text-danger fw-semibold" style="display: none;"></small>
					</div>
					<div class="col-sm-6">
						<label class="form-label">Return CC Chips <span class="text-danger">*</span></label>
						<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" 
							class="form-control text-center txtReturnRollerCC" 
							placeholder="CC Chips" name="txtReturnRollerCC" id="txtReturnRollerCC">
					</div>
				</div>
				<div class="row">
					<div class="col-sm-12">
						<small class="text-info">You can return any mix of NN/CC as long as the total equals the required amount.</small>
					</div>
				</div>
				</div>

				<div id="pending-resolution-section" style="display: none;" class="mt-3 pt-3 border-top">
					<small class="text-muted d-block mb-2">Resolve outstanding balance:</small>
					<div class="row g-2">
						<div class="col-sm-6">
							<button type="button" class="btn btn-sm btn-primary w-100" id="btn-pending-guest-buyin">
								Additional Buy-in
							</button>
						</div>
						<div class="col-sm-6">
							<button type="button" class="btn btn-sm btn-warning w-100" id="btn-pending-junket-new-game">
								New Game
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="modal-footer">
			<button type="submit" class="btn btn-sm btn-primary" id="submit-status-btn">
				<%= __('modal_change_status.save') %>
			</button>
			
			
			<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
				<%= __('modal_change_status.close') %>
			</button>
		</div>
			</form>
		</div>
	</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
	var nnInput = document.querySelector('#modal-change_status .txtReturnRollerNN');
	if (!nnInput) return;

	function validateReturnNNInline() {
		var raw = (nnInput.value || '').toString().replace(/,/g, '');
		var trimmed = raw.trim();

		// Allow empty while typing
		if (!trimmed) {
			nnInput.classList.remove('is-invalid');
			return;
		}

		var value = Number(trimmed);

		if (!Number.isFinite(value) || value <= 0 || value % 1000 !== 0) {
			nnInput.classList.add('is-invalid');
		} else {
			nnInput.classList.remove('is-invalid');
		}
	}

	nnInput.addEventListener('input', validateReturnNNInline);

	var ccInput = document.querySelector('#modal-change_status .txtReturnRollerCC');
	function onReturnInputChange() {
		if (typeof updateReturnRollerRemainingHint === 'function') {
			updateReturnRollerRemainingHint();
		}
	}
	nnInput.addEventListener('input', onReturnInputChange);
	if (ccInput) {
		ccInput.addEventListener('input', onReturnInputChange);
	}
});
</script>

<style>
body.swal2-shown .flatpickr-calendar.change-status-parent-date-calendar {
	display: none !important;
}
body > .flatpickr-calendar.change-status-parent-date-calendar {
	z-index: 2000 !important;
}
#modal-change_status .modal-body {
	position: relative;
}
.flatpickr-calendar.change-status-parent-date-calendar .flatpickr-day.selected,
.flatpickr-calendar.change-status-parent-date-calendar .flatpickr-day.startRange,
.flatpickr-calendar.change-status-parent-date-calendar .flatpickr-day.endRange {
	background-color: #0d6efd !important;
	border-color: #0d6efd !important;
	color: #ffffff !important;
}
</style>
