							<label class="form-label mb-0" for="txtInGameCashNN"><%= __('modal_change_status.cutoff_cash') %></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input ingame-nn-input ingame-split-input" name="txtInGameCashNN" id="txtInGameCashNN"
								placeholder="NN Chips" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input ingame-split-input" name="txtInGameCashCC" id="txtInGameCashCC"
								placeholder="CC Chips" autocomplete="off" />
						</div>
						<div class="ingame-field-grid">
							<label class="form-label mb-0" for="txtInGameDepNN"><%= __('modal_change_status.cutoff_deposit') %></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input ingame-nn-input ingame-split-input" name="txtInGameDepNN" id="txtInGameDepNN"
								placeholder="NN Chips" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input ingame-split-input" name="txtInGameDepCC" id="txtInGameDepCC"
								placeholder="CC Chips" autocomplete="off" />
						</div>
						<div class="ingame-field-grid">
							<label class="form-label mb-0" for="txtInGameCreditNN"><%= __('modal_change_status.cutoff_credit') %></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input ingame-nn-input ingame-split-input" name="txtInGameCreditNN" id="txtInGameCreditNN"
								placeholder="NN Chips" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input ingame-split-input" name="txtInGameCreditCC" id="txtInGameCreditCC"
								placeholder="CC Chips" autocomplete="off" />
						</div>
					</div>

					<div class="ingame-split-toggle">
						<div class="form-check mb-0">
							<input class="form-check-input" style="border-color: #8a92a6 !important;" type="checkbox" id="chkInGameSplit" />
							<label class="form-check-label" for="chkInGameSplit"><%= __('modal_change_status.cutoff_split') %></label>
						</div>
					</div>

					<div class="ingame-section ingame-section-tips">
						<div class="ingame-tips-grid">
							<label class="form-label mb-0" for="txtInGameTipRollerNn"><%= __('modal_change_status.cutoff_tip_roller') %></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input ingame-nn-input change-status-tip-roller-input" name="txtInGameTipRollerNn" id="txtInGameTipRollerNn"
								placeholder="NN Chips" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input change-status-tip-roller-input" name="txtInGameTipRollerCc" id="txtInGameTipRollerCc"
								placeholder="CC Chips" autocomplete="off" />
							<label class="form-label mb-0" for="txtInGameTipDealerNn"><%= __('modal_change_status.cutoff_tip_dealer') %></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input ingame-nn-input change-status-tip-dealer-input" name="txtInGameTipDealerNn" id="txtInGameTipDealerNn"
								placeholder="NN Chips" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input change-status-tip-dealer-input" name="txtInGameTipDealerCc" id="txtInGameTipDealerCc"
								placeholder="CC Chips" autocomplete="off" />
						</div>
					</div>

					<div class="ingame-section ingame-section-meta">
						<div class="ingame-meta-grid">
							<label class="form-label mb-0" for="txtInGameLastRolling"><%= __('modal_change_status.cutoff_last_rolling_label') %></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input" name="txtInGameLastRolling" id="txtInGameLastRolling"
								placeholder="CC Chips" autocomplete="off" />
							<label class="form-label mb-0"><%= __('modal_change_status.ingame_expected_settlement') %></label>
							<div id="txtInGameExpectedSettlement" class="form-control text-center ingame-settlement-input ingame-expected-settlement">—</div>
						</div>
					</div>
				</div>
			</div>
			
			<!-- Roller Chips Return Section (END GAME only) -->
			<div id="roller-chips-return-section" style="display: none; margin-top: 20px; padding-top: 20px; border-top: 1px solid #dee2e6;">
				<div id="roller-chips-return-summary" class="alert alert-info" role="alert" style="padding: 10px; margin-bottom: 15px;">
				<small>
						<table style="margin-top:4px;width:100%;border-collapse:collapse;">
							<tr>
								<td style="padding:4px 0;font-weight:600;">Total ADD :</td>
								<td style="padding:4px 0;text-align:right;">
									<div>NN: <span id="required-return-total-add-nn">0</span></div>
									<div>CC: <span id="required-return-total-add-cc">0</span></div>
								</td>
							</tr>
							<tr>
								<td style="padding:4px 0;font-weight:600;">Total RETURN:</td>
								<td style="padding:4px 0;text-align:right;">
									<div>NN: <span id="required-return-total-return-nn">0</span></div>
									<div>CC: <span id="required-return-total-return-cc">0</span></div>
								</td>
							</tr>
							<tr>
								<td style="padding:4px 0;font-weight:600;color:red;">Required RETURN:</td>
								<td style="padding:4px 0;text-align:right;">
									<span id="required-return-total" style="color:red;font-weight:bold;">0</span>
								</td>
							</tr>
						</table>
					</small>
				</div>
				<div id="roller-chips-return-inputs">
				<div class="row mb-2">
					<div class="col-sm-6">
						<label class="form-label">Return NN Chips <span class="text-danger">*</span></label>
						<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" 
							class="form-control text-center txtReturnRollerNN" 
							placeholder="NN Chips" name="txtReturnRollerNN" id="txtReturnRollerNN">
						<small id="return-roller-remaining-hint" class="d-block mt-1 text-danger fw-semibold" style="display: none;"></small>
					</div>
					<div class="col-sm-6">
						<label class="form-label">Return CC Chips <span class="text-danger">*</span></label>
						<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" 
							class="form-control text-center txtReturnRollerCC" 
							placeholder="CC Chips" name="txtReturnRollerCC" id="txtReturnRollerCC">
					</div>
				</div>
				<div class="row">
					<div class="col-sm-12">
						<small class="text-info">You can return any mix of NN/CC as long as the total equals the required amount.</small>
					</div>
				</div>
				</div>

				<div id="pending-resolution-section" style="display: none;" class="mt-3 pt-3 border-top">
					<small class="text-muted d-block mb-2">Resolve outstanding balance:</small>
					<div class="row g-2">
						<div class="col-sm-6">
							<button type="button" class="btn btn-sm btn-primary w-100" id="btn-pending-guest-buyin">
								Additional Buy-in
							</button>
						</div>
						<div class="col-sm-6">
							<button type="button" class="btn btn-sm btn-warning w-100" id="btn-pending-junket-new-game">
								New Game
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="modal-footer">
			<button type="submit" class="btn btn-sm btn-primary" id="submit-status-btn">
				<%= __('modal_change_status.save') %>
			</button>
			
			
			<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
				<%= __('modal_change_status.close') %>
			</button>
		</div>
			</form>
		</div>

		<div class="change-status-side-panels change-status-side-panels-empty" id="change-status-side-panels">
			<div class="change-status-side-panel d-none" id="change-status-ingame-panel" aria-hidden="true">
				<div class="change-status-side-panel-title"><%= __('modal_change_status.ingame_settlement_title') %></div>
				<div class="change-status-panel-sheet">
					<div class="change-status-balance-head">
						<div class="change-status-balance-head-cell" id="ingame-deposit-current-label"><%= __('modal_change_status.ingame_current_balance') %></div>
