								placeholder="<%= __('modal_new_game_list.nn_placeholder') %>" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input cutoff-split-input" name="txtCutoffDepCC" id="txtCutoffDepCC"
								placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" autocomplete="off" />
						</div>
						<div class="ingame-field-grid">
							<label class="form-label mb-0" for="txtCutoffCreditNN"><%= __('modal_change_status.cutoff_credit') %></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input cutoff-nn-input cutoff-split-input" name="txtCutoffCreditNN" id="txtCutoffCreditNN"
								placeholder="<%= __('modal_new_game_list.nn_placeholder') %>" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input cutoff-split-input" name="txtCutoffCreditCC" id="txtCutoffCreditCC"
								placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" autocomplete="off" />
						</div>
					</div>

					<div class="ingame-split-toggle">
						<div class="form-check mb-0">
							<input class="form-check-input" style="border-color: #8a92a6 !important;" type="checkbox" id="chkCutoffSplit" />
							<label class="form-check-label" for="chkCutoffSplit"><%= __('modal_change_status.cutoff_split') %></label>
						</div>
					</div>

					<div class="ingame-section ingame-section-tips">
						<div class="ingame-tips-grid">
							<label class="form-label mb-0" for="txtCutoffTipRollerNn"><%= __('modal_change_status.cutoff_tip_roller') %></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input cutoff-nn-input change-status-tip-roller-input" name="txtCutoffTipRollerNn" id="txtCutoffTipRollerNn"
								placeholder="<%= __('modal_new_game_list.nn_placeholder') %>" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input change-status-tip-roller-input" name="txtCutoffTipRollerCc" id="txtCutoffTipRollerCc"
								placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" autocomplete="off" />
							<label class="form-label mb-0" for="txtCutoffTipDealerNn"><%= __('modal_change_status.cutoff_tip_dealer') %></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input cutoff-nn-input change-status-tip-dealer-input" name="txtCutoffTipDealerNn" id="txtCutoffTipDealerNn"
								placeholder="<%= __('modal_new_game_list.nn_placeholder') %>" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input change-status-tip-dealer-input" name="txtCutoffTipDealerCc" id="txtCutoffTipDealerCc"
								placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" autocomplete="off" />
						</div>
