							<label class="form-label mb-0" for="txtCutoffLastRolling"><%= __('modal_change_status.cutoff_last_rolling_label') %></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input" name="txtCutoffLastRolling" id="txtCutoffLastRolling"
								placeholder="<%= __('modal_new_game_list.cc_placeholder') %>" autocomplete="off" />
						</div>
					</div>
				</div>
			</div>

			<div id="ingame-settlement-section" style="display: none;" class="mt-3 pt-3 border-top">
