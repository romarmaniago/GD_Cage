				<input type="hidden" name="txtInGameBuyInNN" id="txtInGameBuyInNN" value="" />
				<input type="hidden" name="txtInGameBuyInCC" id="txtInGameBuyInCC" value="" />

				<div class="ingame-input-sheet">
					<div class="ingame-field-grid">
						<label class="form-label mb-0" for="txtInGameProgramDate"><%= __('modal_change_status.cutoff_date_label') %></label>
						<input type="text" class="form-control text-center ingame-settlement-input ingame-field-span-2" name="txtInGameProgramDate" id="txtInGameProgramDate" autocomplete="off" placeholder="YYYY-MM-DD" />
					</div>

					<div class="ingame-section ingame-section-chips" id="ingame-remaining-row">
						<div class="ingame-field-grid">
							<label class="form-label mb-0" for="txtInGameRemainingNN"><%= __('modal_change_status.cutoff_remaining_chips') %></label>
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
								class="form-control text-center ingame-settlement-input ingame-nn-input" name="txtInGameRemainingNN" id="txtInGameRemainingNN"
								placeholder="NN Chips" autocomplete="off" />
							<input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
