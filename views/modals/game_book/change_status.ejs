						</div>
						<div class="ingame-processing-body-row" id="ingame-processing-settlement-row" style="display: none;">
							<div class="ingame-processing-body-cell" id="ingame-processing-settlement-amount">0</div>
							<div class="ingame-processing-body-cell"><%= __('modal_change_status.ingame_txn_settlement') %></div>
							<div class="ingame-processing-body-cell" id="ingame-processing-settlement-remarks">—</div>
						</div>
						<div class="ingame-processing-body-row" id="ingame-processing-chips-row" style="display: none;">
							<div class="ingame-processing-body-cell text-amount-negative" id="ingame-processing-chips-amount">0</div>
							<div class="ingame-processing-body-cell"><%= __('modal_change_status.ingame_txn_chips_withdrawal') %></div>
							<div class="ingame-processing-body-cell" id="ingame-processing-chips-remarks">—</div>
						</div>
					</div>
					<div class="change-status-history-wrap">
