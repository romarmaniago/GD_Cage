<div class="modal fade" id="junket-table-modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered modal-md">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white">Tables</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body py-3">
        <div class="d-flex justify-content-end mb-2">
          <button type="button" class="btn btn-primary" id="btn-open-junket-table-form-modal">
            <i class="fa fa-plus me-1"></i> Add Table
          </button>
        </div>
        <div class="table-responsive">
          <table class="table table-bordered table-hover align-middle mb-0" id="junket-tables-table">
            <thead>
              <tr>
                <th>Table Name</th>
                <th style="width: 120px;" class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody id="junket-tables-tbody">
              <tr>
                <td colspan="2" class="text-center text-muted py-3">Loading tables...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
