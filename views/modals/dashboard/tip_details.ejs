<div class="modal fade" id="modal-dash-tip" tabindex="-1" aria-labelledby="modal-dash-tip-label" aria-hidden="true" data-bs-backdrop="static">
	<div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white" id="modal-dash-tip-label"><%= __('sidebar.tip') %></h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body dash-tip-page">
				<div class="dash-tip-settlement-bar mb-3">
					<div>
						<div class="dash-tip-settlement-title"><%= __('tip.settlement') %></div>
						<div class="mt-1 small text-muted">
							<%= __('tip.available_balance') %>:
							<strong id="dash-tip-available-balance">0</strong>
						</div>
					</div>
					<div class="d-flex flex-wrap gap-2 align-items-center">
						<input type="text" id="dash-tip-daterange" class="form-control form-control-sm" style="max-width: 260px;" placeholder="<%= __('tip.date_time') %>" autocomplete="off" readonly>
						<% if (typeof permissions !== 'undefined' && permissions !== 2) { %>
						<button type="button" class="btn btn-sm btn-primary" id="btn-dash-tip-in-open" data-view-only-disable>
							<%= __('tip.in') %>
						</button>
						<button type="button" class="btn btn-sm btn-primary" id="btn-dash-tip-settlement-open" data-view-only-disable>
							<%= __('tip.settle') %>
						</button>
						<% } %>
					</div>
				</div>
				<div class="marker-balance-dt-wrap marker-balance-card table-responsive">
					<table id="dash-tip-table" class="table marker-balance-tbl w-100 mb-0">
						<thead>
							<tr>
								<th rowspan="2"><%= __('tip.program_date') %></th>
								<th rowspan="2"><%= __('tip.date_time') %></th>
								<th rowspan="2"><%= __('tip.account') %></th>
								<th rowspan="2"><%= __('tip.guest') %></th>
								<th rowspan="2"><%= __('tip.game_no') %></th>
								<th rowspan="2"><%= __('tip.remarks') %></th>
								<th colspan="4" class="text-center tip-group-head tip-group-head-roller"><%= __('tip.roller') %></th>
								<th colspan="4" class="text-center tip-group-head tip-group-head-dealer"><%= __('tip.dealer') %></th>
							</tr>
							<tr>
								<th class="tip-col tip-col-roller"><%= __('tip.transaction') %></th>
								<th class="tip-col tip-col-roller"><%= __('tip.amount') %></th>
								<th class="tip-col tip-col-roller"><%= __('tip.status') %></th>
								<th class="tip-col tip-col-roller"><%= __('tip.name') %></th>
								<th class="tip-col tip-col-dealer"><%= __('tip.transaction') %></th>
								<th class="tip-col tip-col-dealer"><%= __('tip.amount') %></th>
								<th class="tip-col tip-col-dealer"><%= __('tip.status') %></th>
								<th class="tip-col tip-col-dealer"><%= __('tip.name') %></th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('tip.close') %></button>
			</div>
		</div>
	</div>
</div>

<style>
.dash-tip-page {
	--gd-marker-gold-solid: #d9b96a;
	--gd-marker-gold-text: #3a2e12;
	--gd-marker-gold-border: rgba(58, 46, 18, 0.25);
	--gd-marker-gold-hover: #faf3dc;
}

.dash-tip-settlement-bar {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	padding: 0.85rem 1rem;
	border: 1px solid var(--gd-marker-gold-border);
	border-radius: 0.5rem;
	background: linear-gradient(180deg, #faf3dc 0%, #fffdf5 100%);
}
.dash-tip-settlement-title {
	font-weight: 600;
	color: var(--gd-marker-gold-text);
}
#dash-tip-available-balance {
	color: var(--gd-marker-gold-text);
}

.dash-tip-page table.dataTable {
	border-collapse: collapse !important;
	border-spacing: 0 !important;
}
.dash-tip-page table thead tr {
	background-color: var(--gd-marker-gold-solid);
}
.dash-tip-page table thead th {
	background: transparent !important;
	background-color: transparent !important;
	border-left: 0 !important;
	border-right: 0 !important;
	border-top: 0 !important;
	box-shadow: none !important;
}
.dash-tip-page table.dataTable thead > tr > th.sorting,
.dash-tip-page table.dataTable thead > tr > th.sorting_asc,
.dash-tip-page table.dataTable thead > tr > th.sorting_desc,
.dash-tip-page table.dataTable thead > tr > th.sorting_disabled {
	background: transparent !important;
	background-color: transparent !important;
}

#dash-tip-table {
	width: 100%;
	font-size: 13px;
	border-collapse: collapse;
	border: 1px solid var(--gd-marker-gold-border);
}

#dash-tip-table_wrapper .dash-tip-controls-highlight {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	padding: 8px 12px;
	margin-bottom: -1px;
	background: #faf3dc;
	border: 1px solid var(--gd-marker-gold-border);
	border-bottom: 0;
	border-radius: 10px 10px 0 0;
}
#dash-tip-table_wrapper .dash-tip-controls-highlight .dataTables_length {
	margin-top: 4px;
}
#dash-tip-table_wrapper .dash-tip-controls-highlight .dataTables_filter {
	margin: 0 0 0 auto;
}
#dash-tip-table_wrapper #dash-tip-table_filter .dash-tip-filter-highlight {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	padding: 2px 6px;
	background: transparent;
	border: none;
	border-radius: 10px;
}
#dash-tip-table_wrapper #dash-tip-table_filter .dash-tip-filter-highlight label {
	margin: 0;
	display: inline-flex;
	align-items: center;
	gap: 0;
	font-size: 0;
	color: transparent;
}
#dash-tip-table_wrapper #dash-tip-table_filter .dash-tip-filter-highlight label input {
	margin-left: 0;
	border: none;
	outline: none;
	box-shadow: none;
	background: #fff;
	border-radius: 4px;
	padding: 6px 10px;
	font-size: 13px;
	color: #333;
	min-width: 160px;
}
#dash-tip-table_wrapper #dash-tip-table_filter .dash-tip-filter-highlight label input::placeholder {
	color: #8a92a6;
	opacity: 1;
}
#dash-tip-table_wrapper #dash-tip-table {
	margin-top: 0 !important;
}
#dash-tip-table_wrapper .dataTables_length,
#dash-tip-table_wrapper .dataTables_filter {
	padding-left: 0;
	padding-right: 0;
}
#dash-tip-table_wrapper .dataTables_length label {
	font-size: 0;
}
#dash-tip-table_wrapper .dataTables_length select {
	font-size: 12px;
}
#dash-tip-table_wrapper > .row.dash-tip-dt-top-row-empty {
	display: none !important;
	height: 0 !important;
	margin: 0 !important;
	padding: 0 !important;
	overflow: hidden !important;
	border: 0 !important;
}

#dash-tip-table thead th {
	color: var(--gd-marker-gold-text);
	font-weight: 600;
	padding: 8px 10px;
	border: none;
	border-bottom: 1px solid var(--gd-marker-gold-border);
	text-align: center;
	vertical-align: middle;
}
#dash-tip-table thead .tip-group-head,
#dash-tip-table thead .tip-col-roller,
#dash-tip-table thead .tip-col-dealer {
	color: var(--gd-marker-gold-text) !important;
	background: transparent !important;
}
#dash-tip-table tbody tr {
	border-bottom: 1px solid #eee;
}
#dash-tip-table tbody tr:nth-child(even) td {
	background-color: #fbf5e4;
}
#dash-tip-table tbody td {
	padding: 8px 10px;
	color: #666;
	vertical-align: middle;
	text-align: center;
}
#dash-tip-table tbody tr:hover,
#dash-tip-table tbody tr:hover td {
	background-color: var(--gd-marker-gold-hover) !important;
}
#dash-tip-table tbody td:nth-child(7),
#dash-tip-table tbody td:nth-child(11) {
	text-align: right;
}
#dash-tip-table .tip-amount-negative {
	color: #dc3545;
}

/* Pagination colors (Tip modal) */
.dash-tip-page .dataTables_paginate .page-link {
	border-color: var(--gd-marker-gold-border) !important;
	color: var(--gd-marker-gold-text) !important;
	background-color: #fff !important;
}

.dash-tip-page .dataTables_paginate .page-item.active .page-link {
	background-color: var(--gd-marker-gold-solid) !important;
	border-color: var(--gd-marker-gold-solid) !important;
	color: var(--gd-marker-gold-text) !important;
}

.dash-tip-page .dataTables_paginate .page-link:hover {
	background-color: var(--gd-marker-gold-hover) !important;
	border-color: var(--gd-marker-gold-border) !important;
	color: var(--gd-marker-gold-text) !important;
}

.dash-tip-page .dataTables_paginate .page-item.disabled .page-link {
	color: rgba(58, 46, 18, 0.4) !important;
	border-color: var(--gd-marker-gold-border) !important;
	background-color: #fff !important;
}
</style>

<style>
#modal-tip-in .select2-container .select2-selection--single {
	height: calc(1.5em + 0.75rem + 6px);
}
#modal-tip-in .select2-container .select2-search--inline .select2-search__field {
	margin-top: 0;
	margin: 0.25rem 0.25rem 0.25rem 0;
	height: 1.375rem;
	line-height: 1.375rem;
}
#modal-tip-in .select2-container--default .select2-selection--single {
	border-color: #eee;
}
#modal-tip-in .select2-container--default .select2-selection--single .select2-selection__rendered {
	display: flex;
	align-items: center;
	padding-left: 0.75rem;
	height: calc(1.5em + 0.75rem + 6px);
	line-height: 1.5;
}
#modal-tip-in .select2-container--default .select2-selection--single .select2-selection__arrow {
	height: calc(1.5em + 0.75rem + 6px);
}
#modal-tip-in .select2-container--default .select2-selection--single .select2-selection__placeholder {
	color: #8A92A6;
}
#modal-tip-in #tip-in-modal-guest + .select2-container .select2-selection--single,
#modal-tip-in #tip-in-modal-account + .select2-container .select2-selection--single {
	height: calc(1.5em + 0.75rem + 6px);
}
</style>
