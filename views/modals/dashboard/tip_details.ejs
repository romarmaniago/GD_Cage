<div class="modal fade" id="modal-dash-tip" tabindex="-1" aria-labelledby="modal-dash-tip-label" aria-hidden="true" data-bs-backdrop="static">
	<div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white" id="modal-dash-tip-label"><%= __('sidebar.tip') %></h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body dash-tip-page">
				<div class="dash-tip-settlement-bar mb-3">
					<div>
						<div class="dash-tip-settlement-title"><%= __('tip.settlement') %></div>
						<div class="mt-1 small text-muted">
							<%= __('tip.available_balance') %>:
							<strong id="dash-tip-available-balance">0</strong>
						</div>
					</div>
					<div class="d-flex flex-wrap gap-2 align-items-center dash-tip-date-controls">
						<div class="house-expense-daterange-wrap">
							<input type="text" id="dash-tip-daterange" class="form-control form-control-sm text-center"
								placeholder="<%= __('tip.date_time') %>" autocomplete="off" readonly>
						</div>
						<%- include('../../partials/split_daterange', {
							splitPrefix: 'dash-tip',
							splitLocaleNs: 'house_expense',
							splitWrapClass: 'dash-tip-daterange-wrap dash-tip-split-daterange house-expense-split-daterange'
						}) %>
						<% if (typeof permissions !== 'undefined' && permissions !== 2) { %>
						<button type="button" class="tip-action-icon-btn" id="btn-dash-tip-in-open" data-view-only-disable title="<%= __('tip.in') %>" aria-label="<%= __('tip.in') %>">
							<i class="fa fa-plus" aria-hidden="true"></i>
						</button>
						<button type="button" class="tip-action-icon-btn" id="btn-dash-tip-settlement-open" data-view-only-disable title="<%= __('tip.settle') %>" aria-label="<%= __('tip.settle') %>">
							<i class="fa fa-minus" aria-hidden="true"></i>
						</button>
						<% } %>
						<button type="button" id="btn-dash-tip-print" class="btn btn-sm btn-alt-success">
							<i class="fa fa-print" aria-hidden="true"></i> <%= __('tip.print') || 'Print' %>
						</button>
						<button type="button" id="btn-dash-tip-export" class="btn btn-sm btn-success">
							<i class="fa fa-file-excel" aria-hidden="true"></i> <%= __('tip.export') || 'Export' %>
						</button>
					</div>
				</div>
				<div class="marker-balance-dt-wrap marker-balance-card table-responsive">
					<table id="dash-tip-table" class="table marker-balance-tbl w-100 mb-0">
						<thead>
							<tr>
								<th rowspan="2"><%= __('tip.program_date') %></th>
								<th rowspan="2"><%= __('tip.date_time') %></th>
								<th rowspan="2"><%= __('tip.account') %></th>
								<th rowspan="2"><%= __('tip.guest') %></th>
								<th rowspan="2"><%= __('tip.game_no') %></th>
								<th rowspan="2"><%= __('tip.remarks') %></th>
								<th colspan="4" class="text-center tip-group-head tip-group-head-roller"><%= __('tip.roller') %></th>
								<th colspan="4" class="text-center tip-group-head tip-group-head-dealer"><%= __('tip.dealer') %></th>
								<th rowspan="2" class="tip-action-col-head"><%= __('tip.action') %></th>
							</tr>
							<tr>
								<th class="tip-col tip-col-roller"><%= __('tip.transaction') %></th>
								<th class="tip-col tip-col-roller"><%= __('tip.amount') %></th>
								<th class="tip-col tip-col-roller"><%= __('tip.status') %></th>
								<th class="tip-col tip-col-roller"><%= __('tip.name') %></th>
								<th class="tip-col tip-col-dealer"><%= __('tip.transaction') %></th>
								<th class="tip-col tip-col-dealer"><%= __('tip.amount') %></th>
								<th class="tip-col tip-col-dealer"><%= __('tip.status') %></th>
								<th class="tip-col tip-col-dealer"><%= __('tip.name') %></th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('tip.close') %></button>
			</div>
		</div>
	</div>
</div>

<style>
#modal-dash-tip .modal-dialog.modal-xl {
	max-width: 96vw;
	width: 1600px;
	margin-left: auto;
	margin-right: auto;
}

.dash-tip-page {
	--gd-marker-gold-solid: rgba(200, 162, 76, 0.07);
	--gd-marker-gold-text: #4a3208;
	--gd-marker-gold-border: rgba(200, 162, 76, 0.28);
	--gd-marker-gold-hover: #f6f3ec;
}

.dash-tip-settlement-bar {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	padding: 0.85rem 1rem;
	border: 1px solid var(--gd-marker-gold-border);
	border-radius: 0.5rem;
	background: linear-gradient(180deg, #f6f3ec 0%, #fdfcf8 100%);
}
.dash-tip-settlement-title {
	font-weight: 600;
	color: var(--gd-marker-gold-text);
}
.dash-tip-date-controls {
	flex-wrap: wrap;
	align-items: center;
}
.tip-action-icon-btn {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 2.25rem;
	height: 2.25rem;
	padding: 0;
	border: 1px solid transparent;
	border-radius: 50%;
	background: linear-gradient(135deg, #52525b 0%, #71717a 100%);
	color: #fff;
	line-height: 1;
	flex-shrink: 0;
	position: relative;
	z-index: 2;
	pointer-events: auto;
	cursor: pointer;
	transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease, filter 0.12s ease;
}
.tip-action-icon-btn i.fa {
	font-size: 1rem;
}
.tip-action-icon-btn:hover,
.tip-action-icon-btn:focus {
	filter: brightness(0.92);
	color: #fff;
}
.dash-tip-split-daterange {
	display: inline-flex;
	align-items: center;
	gap: 0.35rem;
	flex-shrink: 0;
	min-width: 0;
}
.dash-tip-split-daterange input.split-date-input {
	font-size: 12px !important;
	height: 30px !important;
	padding: 0.15rem 0.55rem !important;
	width: auto;
	min-width: 0;
	cursor: text;
	text-align: center;
	field-sizing: content;
}
#dash-tip-available-balance {
	color: var(--gd-marker-gold-text);
}

.dash-tip-page table.dataTable {
	border-collapse: collapse !important;
	border-spacing: 0 !important;
}
.dash-tip-page table thead tr {
	background-color: var(--gd-marker-gold-solid);
}
.dash-tip-page table thead th {
	background: transparent !important;
	background-color: transparent !important;
	border-left: 0 !important;
	border-right: 0 !important;
	border-top: 0 !important;
	box-shadow: none !important;
}
.dash-tip-page table.dataTable thead > tr > th.sorting,
.dash-tip-page table.dataTable thead > tr > th.sorting_asc,
.dash-tip-page table.dataTable thead > tr > th.sorting_desc,
.dash-tip-page table.dataTable thead > tr > th.sorting_disabled {
	background: transparent !important;
	background-color: transparent !important;
}

#dash-tip-table {
	width: 100%;
	font-size: 13px;
	border-collapse: collapse;
	border: 1px solid var(--gd-marker-gold-border);
}

#dash-tip-table_wrapper .dash-tip-controls-highlight {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	padding: 8px 12px;
	margin-bottom: -1px;
	background: #f6f3ec;
	border: 1px solid var(--gd-marker-gold-border);
	border-bottom: 0;
	border-radius: 10px 10px 0 0;
}
#dash-tip-table_wrapper .dash-tip-controls-highlight .dataTables_length {
	margin-top: 4px;
}
#dash-tip-table_wrapper .dash-tip-controls-highlight .dataTables_filter {
	margin: 0 0 0 auto;
}
#dash-tip-table_wrapper #dash-tip-table_filter .dash-tip-filter-highlight {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	padding: 2px 6px;
	background: transparent;
	border: none;
	border-radius: 10px;
}
#dash-tip-table_wrapper #dash-tip-table_filter .dash-tip-filter-highlight label {
	margin: 0;
	display: inline-flex;
	align-items: center;
	gap: 0;
	font-size: 0;
	color: transparent;
}
#dash-tip-table_wrapper #dash-tip-table_filter .dash-tip-filter-highlight label input {
	margin-left: 0;
	border: none;
	outline: none;
	box-shadow: none;
	background: #fff;
	border-radius: 4px;
	padding: 6px 10px;
	font-size: 13px;
	color: #333;
	min-width: 160px;
}
#dash-tip-table_wrapper #dash-tip-table_filter .dash-tip-filter-highlight label input::placeholder {
	color: #8a92a6;
	opacity: 1;
}
#dash-tip-table_wrapper #dash-tip-table {
	margin-top: 0 !important;
}
#dash-tip-table_wrapper .dataTables_length,
#dash-tip-table_wrapper .dataTables_filter {
	padding-left: 0;
	padding-right: 0;
}
#dash-tip-table_wrapper .dataTables_length label {
	font-size: 0;
}
#dash-tip-table_wrapper .dataTables_length select {
	font-size: 12px;
}
#dash-tip-table_wrapper > .row.dash-tip-dt-top-row-empty {
	display: none !important;
	height: 0 !important;
	margin: 0 !important;
	padding: 0 !important;
	overflow: hidden !important;
	border: 0 !important;
}

#dash-tip-table thead th {
	color: var(--gd-marker-gold-text);
	font-weight: 600;
	padding: 8px 10px;
	border: none;
	border-bottom: 1px solid var(--gd-marker-gold-border);
	text-align: center;
	vertical-align: middle;
}
#dash-tip-table thead .tip-group-head {
	color: var(--gd-marker-gold-text) !important;
	background: transparent !important;
	border-bottom: 1px solid #4a3208;
}
#dash-tip-table thead .tip-col-roller,
#dash-tip-table thead .tip-col-dealer {
	color: var(--gd-marker-gold-text) !important;
	background: transparent !important;
}

/* Roller vs Dealer group tinting — subtle, on the gold theme */
#dash-tip-table thead .tip-group-head-roller,
#dash-tip-table thead th.tip-col-roller {
	background: #efe6d2 !important;
	color: #8a6c27 !important;
}
#dash-tip-table thead .tip-group-head-roller {
	border-bottom: 2px solid rgba(198, 158, 74, 0.55);
}
#dash-tip-table thead .tip-group-head-dealer,
#dash-tip-table thead th.tip-col-dealer {
	background: #e2e7da !important;
	color: #5b6a48 !important;
}
#dash-tip-table thead .tip-group-head-dealer {
	border-bottom: 2px solid rgba(118, 133, 88, 0.55);
}
#dash-tip-table tbody td.tip-col-roller {
	background-image: linear-gradient(rgba(198, 158, 74, 0.15), rgba(198, 158, 74, 0.15));
}
#dash-tip-table tbody td.tip-col-dealer {
	background-image: linear-gradient(rgba(118, 133, 88, 0.15), rgba(118, 133, 88, 0.15));
}

#dash-tip-table thead th.tip-action-col-head,
#dash-tip-table tbody td.tip-action-col {
	text-align: center;
	white-space: nowrap;
}
#dash-tip-table td.tip-action-col .tip-action-btns {
	display: inline-flex;
	gap: 0.25rem;
	justify-content: center;
}
#dash-tip-table td.tip-action-col .btn {
	padding: 0.2rem 0.45rem;
	line-height: 1;
}

#dash-tip-table .tip-transaction-in { color: #198754; font-weight: 600; }
#dash-tip-table .tip-transaction-out { color: #dc3545; font-weight: 600; }
#dash-tip-table tbody tr {
	border-bottom: 1px solid #eee;
}
#dash-tip-table tbody tr:nth-child(even) td {
	background-color: #f4f1ea;
}
#dash-tip-table tbody td {
	padding: 8px 10px;
	color: #666;
	vertical-align: middle;
	text-align: center;
}
#dash-tip-table tbody tr:hover,
#dash-tip-table tbody tr:hover td {
	background-color: var(--gd-marker-gold-hover) !important;
}
#dash-tip-table tbody td:nth-child(7),
#dash-tip-table tbody td:nth-child(11) {
	text-align: right;
}
#dash-tip-table .tip-amount-negative {
	color: #dc3545;
}

/* Pagination colors (Tip modal) */
.dash-tip-page .dataTables_paginate .page-link {
	border-color: #dee2e6 !important;
	color: #52525b !important;
	background-color: #fff !important;
}

.dash-tip-page .dataTables_paginate .page-item.active .page-link {
	background: linear-gradient(135deg, #52525b 0%, #71717a 100%) !important;
	border-color: transparent !important;
	color: #fff !important;
}

.dash-tip-page .dataTables_paginate .page-link:hover {
	background-color: #e9ecef !important;
	border-color: #dee2e6 !important;
	color: #333 !important;
}

.dash-tip-page .dataTables_paginate .page-item.disabled .page-link {
	color: #adb5bd !important;
	border-color: #dee2e6 !important;
	background-color: #fff !important;
}
</style>

<style>
#modal-tip-in .select2-container .select2-selection--single {
	height: calc(1.5em + 0.75rem + 6px);
}
#modal-tip-in .select2-container .select2-search--inline .select2-search__field {
	margin-top: 0;
	margin: 0.25rem 0.25rem 0.25rem 0;
	height: 1.375rem;
	line-height: 1.375rem;
}
#modal-tip-in .select2-container--default .select2-selection--single {
	border-color: #eee;
}
#modal-tip-in .select2-container--default .select2-selection--single .select2-selection__rendered {
	display: flex;
	align-items: center;
	padding-left: 0.75rem;
	height: calc(1.5em + 0.75rem + 6px);
	line-height: 1.5;
}
#modal-tip-in .select2-container--default .select2-selection--single .select2-selection__arrow {
	height: calc(1.5em + 0.75rem + 6px);
}
#modal-tip-in .select2-container--default .select2-selection--single .select2-selection__placeholder {
	color: #8A92A6;
}
#modal-tip-in #tip-in-modal-guest + .select2-container .select2-selection--single,
#modal-tip-in #tip-in-modal-account + .select2-container .select2-selection--single {
	height: calc(1.5em + 0.75rem + 6px);
}
</style>

<script type="application/json" id="dash-tip-table-i18n"><%- JSON.stringify({
	title: __('sidebar.tip') || 'Tip',
	print_label: __('tip.print') || 'Print',
	export_label: __('tip.export') || 'Export',
	no_data_print: __('tip.no_data_print') || 'No data to print for the current filter.',
	no_data_export: __('tip.no_data_export') || 'No data to export for the current filter.',
	error: __('tip.export_error') || 'Export failed',
	headers: {
		program_date: __('tip.program_date') || 'Program Date',
		date_time: __('tip.date_time') || 'Date & Time',
		account: __('tip.account') || 'Account',
		guest: __('tip.guest') || 'Guest',
		game_no: __('tip.game_no') || 'Game #',
		remarks: __('tip.remarks') || 'Remarks',
		roller: __('tip.roller') || 'Roller',
		dealer: __('tip.dealer') || 'Dealer',
		transaction: __('tip.transaction') || 'Transaction',
		amount: __('tip.amount') || 'Amount',
		status: __('tip.status') || 'Status',
		name: __('tip.name') || 'Name'
	}
}) %></script>
