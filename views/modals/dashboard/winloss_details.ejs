<div class="modal fade" id="modal-winloss-details" tabindex="-1" aria-labelledby="modal-winloss-details-label" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="block-title text-white" id="modal-winloss-details-label"><%= __('modal_winloss_details.title') %></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body winloss-details-page">
        <div class="row mb-3">
          <div class="col-sm-4">
            <label class="form-label"><%= __('modal_winloss_details.date_range') %></label>
            <input type="text" id="winloss-daterange" class="form-control" placeholder="<%= __('modal_winloss_details.select_date_range') %>" readonly>
          </div>
        </div>
        <table id="winloss-details-tbl" class="table table-bordered table-responsive" style="font-size: 13px;">
          <thead>
            <tr>
              <th class="text-center"><%= __('modal_winloss_details.program_date') %></th>
              <th class="text-center"><%= __('modal_winloss_details.buy_in') %></th>
              <th class="text-center"><%= __('modal_winloss_details.cash_out') %></th>
              <th class="text-center"><%= __('modal_winloss_details.win_loss') %></th>
              <th class="text-center"><%= __('modal_winloss_details.action') %></th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
        <div class="row mt-3">
          <div class="col-12">
            <div class="card winloss-details-summary">
              <div class="card-body">
                <div class="row">
                  <div class="col-md-4">
                    <strong id="label-total-cashin"><%= __('modal_winloss_details.total_cash_in') %></strong>
                    <span id="total-cashin" class="text-success">0</span>
                  </div>
                  <div class="col-md-4">
                    <strong id="label-total-cashout"><%= __('modal_winloss_details.total_cash_out') %></strong>
                    <span id="total-cashout" class="text-danger">0</span>
                  </div>
                  <div class="col-md-4">
                    <strong id="label-total-winloss"><%= __('modal_winloss_details.total_win_loss') %></strong>
                    <span id="total-winloss" class="fw-bold">0</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('modal_winloss_details.close') %></button>
      </div>
    </div>
  </div>
</div>
<script>
window.winlossDetailsTranslations = {
	view_games: "<%= __('modal_winloss_details.view_games') %>",
	empty_table: "<%= __('modal_winloss_details.empty_table') %>",
	processing: "<%= __('modal_winloss_details.processing') %>",
	length_menu: "<%= __('modal_winloss_details.length_menu') %>",
	search: "<%= __('modal_winloss_details.search') %>",
	info: "<%= __('modal_winloss_details.info') %>",
	info_empty: "<%= __('modal_winloss_details.info_empty') %>",
	info_filtered: "<%= __('modal_winloss_details.info_filtered') %>",
	first: "<%= __('modal_winloss_details.first') %>",
	last: "<%= __('modal_winloss_details.last') %>",
	previous: "<%= __('modal_winloss_details.previous') %>",
	next: "<%= __('modal_winloss_details.next') %>"
};
</script>

<style>
.winloss-details-page {
  --gd-marker-gold-solid: rgba(200, 162, 76, 0.07);
  --gd-marker-gold-text: #4a3208;
  --gd-marker-gold-border: rgba(200, 162, 76, 0.28);
  --gd-marker-gold-hover: #f6f3ec;
}

.winloss-details-page table.dataTable {
  border-collapse: collapse !important;
  border-spacing: 0 !important;
}

.winloss-details-page table thead tr {
  background-color: var(--gd-marker-gold-solid);
}

.winloss-details-page table thead th {
  background: transparent !important;
  background-color: transparent !important;
  box-shadow: none !important;
}

.winloss-details-page table.dataTable thead > tr > th.sorting,
.winloss-details-page table.dataTable thead > tr > th.sorting_asc,
.winloss-details-page table.dataTable thead > tr > th.sorting_desc,
.winloss-details-page table.dataTable thead > tr > th.sorting_disabled {
  background: transparent !important;
  background-color: transparent !important;
}

#winloss-details-tbl {
  width: 100%;
  border-collapse: collapse;
  border: 1px solid var(--gd-marker-gold-border);
  font-size: 13px;
}

#winloss-details-tbl td {
  padding: 12px 15px;
  color: #666;
  border-bottom: 1px solid #eee;
}

#winloss-details-tbl thead th {
  background: transparent;
  color: var(--gd-marker-gold-text);
  font-weight: 600;
  border: none;
  border-bottom: 1px solid var(--gd-marker-gold-border);
  padding: 12px 15px;
}

#winloss-details-tbl tbody tr:nth-child(even) td {
  background-color: #f4f1ea;
}

#winloss-details-tbl tbody tr:hover,
#winloss-details-tbl tbody tr:hover td {
  background-color: var(--gd-marker-gold-hover) !important;
}

.winloss-details-summary {
  border: 1px solid var(--gd-marker-gold-border);
  background: linear-gradient(180deg, #f6f3ec 0%, #fdfcf8 100%);
  box-shadow: none;
}

.winloss-details-summary .card-body {
  padding: 0.85rem 1rem;
}

.winloss-details-summary strong {
  color: var(--gd-marker-gold-text);
  margin-right: 0.35rem;
}

.winloss-positive {
  color: #28a745;
  font-weight: 600;
}

.winloss-negative {
  color: #dc3545;
  font-weight: 600;
}

/* Pagination — gray colors */
.winloss-details-page .dataTables_paginate .page-link {
  border-color: #dee2e6 !important;
  color: #52525b !important;
  background-color: #fff !important;
}

.winloss-details-page .dataTables_paginate .page-item.active .page-link {
  background: linear-gradient(135deg, #52525b 0%, #71717a 100%) !important;
  border-color: transparent !important;
  color: #fff !important;
}

.winloss-details-page .dataTables_paginate .page-link:hover {
  background-color: #e9ecef !important;
  border-color: #dee2e6 !important;
  color: #333 !important;
}

.winloss-details-page .dataTables_paginate .page-item.disabled .page-link {
  color: #adb5bd !important;
  border-color: #dee2e6 !important;
  background-color: #fff !important;
}

.winloss-details-page .dataTables_length select:focus {
  border-color: var(--gd-marker-gold-solid);
  box-shadow: 0 0 0 0.15rem rgba(217, 185, 106, 0.35);
}
</style>

<script>
$(document).ready(function() {
  let winlossDataTable = null;
  const picker = flatpickr("#winloss-daterange", {
    mode: "range",
    showMonths: 3,
    onChange: function(selectedDates, dateStr) {
      if (selectedDates.length === 2) {
        loadWinlossDetails();
      }
    }
  });

  function formatAmount(value) {
    return parseFloat(value || 0).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function formatCashout(value) {
    if (window.fmtOut) return window.fmtOut(value);
    const formatted = formatCurrency(Math.abs(parseFloat(value || 0)));
    if (formatted === '0') return '0';
    return '<span style="color:#dc3545 !important;">(' + formatted + ')</span>';
  }

  function formatWinloss(value) {
    const n = parseFloat(value || 0);
    if (n < 0) {
      if (window.fmtSigned) return window.fmtSigned(n);
      const formatted = formatCurrency(Math.abs(n));
      return '<span style="color:#dc3545 !important;">(' + formatted + ')</span>';
    }
    if (n > 0) {
      return '<span class="winloss-positive">' + formatCurrency(n) + '</span>';
    }
    return '0';
  }

  function formatCurrency(value) {
    return formatAmount(value);
  }

  function loadWinlossDetails() {
    const range = $('#winloss-daterange').val();
    
    const t = window.winlossDetailsTranslations || {};
    
    const apiRange = window.MonthEndCutoffRange
      ? window.MonthEndCutoffRange.resolveRangeFromPicker(range, 'winloss-daterange')
      : (() => {
          if (!range) return { start: '', end: '' };
          let [start, end] = range.split(' to ');
          if (!end) end = start;
          return { start, end };
        })();
    const start = apiRange.start;
    const end = apiRange.end;
    if (!start || !end) return;

    if (winlossDataTable) {
      winlossDataTable.destroy();
    }

    winlossDataTable = $('#winloss-details-tbl').DataTable({
      processing: true,
      serverSide: false,
      order: [[0, 'desc']],
      ajax: {
        url: `/get_winloss_settlement_details?start_date=${start}&end_date=${end}`,
        dataSrc: function(json) {
          if (!Array.isArray(json)) return [];
          
          let totalCashin = 0;
          let totalCashout = 0;
          
          const formatted = json.map(row => {
            const cashin = parseFloat(row.cashin || 0);
            const cashout = parseFloat(row.cashout || 0);
            const winloss = cashin - cashout;
            
            totalCashin += cashin;
            totalCashout += cashout;
            
            let formattedDate = '-';
            let rawDate = null;
            let sortKey = '';
            const programDate = row.program_date || row.settlement_date;
            if (programDate) {
              const date = new Date(programDate);
              if (!isNaN(date.getTime())) {
                formattedDate = moment(date).format('YYYY-MM-DD');
                const y = date.getFullYear();
                const m = String(date.getMonth() + 1).padStart(2, '0');
                const d = String(date.getDate()).padStart(2, '0');
                rawDate = y + '-' + m + '-' + d;
                sortKey = rawDate;
              } else {
                formattedDate = programDate;
                rawDate = programDate;
                sortKey = rawDate || sortKey;
              }
            }
            
            return {
              programDateSort: sortKey,
              programDate: formattedDate,
              cashin: formatCurrency(cashin),
              cashoutValue: cashout,
              winlossValue: winloss,
              rawProgramDate: rawDate
            };
          });
          
          // Update totals
          const totalWinloss = totalCashin - totalCashout;
          $('#total-cashin').text(formatCurrency(totalCashin));
          $('#total-cashout').html(formatCashout(totalCashout));
          $('#total-winloss').html(formatWinloss(totalWinloss));
          
          return formatted;
        }
      },
      columns: [
        {
          data: 'programDateSort',
          className: 'text-center',
          render: function(data, type, row) {
            if (type === 'display' || type === 'filter') return row.programDate;
            return data;
          }
        },
        { data: 'cashin', className: 'text-end' },
        {
          data: 'cashoutValue',
          className: 'text-end',
          render: function(data, type) {
            if (type === 'sort' || type === 'type') return data || 0;
            return formatCashout(data);
          }
        },
        {
          data: 'winlossValue',
          className: 'text-center',
          render: function(data, type) {
            if (type === 'sort' || type === 'type') return data || 0;
            return formatWinloss(data);
          }
        },
        {
          data: 'rawProgramDate',
          className: 'text-center',
          render: function(data) {
            var viewGames = t.view_games || 'View Games';
            if (data) {
              return '<a href="/game_list?date=' + data + '" target="_blank" class="btn btn-sm btn-primary"><i class="fa fa-eye"></i> ' + viewGames + '</a>';
            }
            return '-';
          }
        }
      ],
      responsive: true,
      language: (function() {
        var t = window.winlossDetailsTranslations || {};
        return {
          emptyTable: t.empty_table || 'No program date data found',
          processing: t.processing || 'Loading win/loss details...',
          lengthMenu: t.length_menu || 'Show _MENU_ entries',
          search: t.search || 'Search:',
          info: t.info || 'Showing _START_ to _END_ of _TOTAL_ entries',
          infoEmpty: t.info_empty || 'Showing 0 to 0 of 0 entries',
          infoFiltered: t.info_filtered || '(filtered from _MAX_ total entries)',
          paginate: {
            first: t.first || 'First',
            last: t.last || 'Last',
            next: t.next || 'Next',
            previous: t.previous || 'Previous'
          }
        };
      })()
    });
  }


  $('#modal-winloss-details').on('shown.bs.modal', function() {
    loadWinlossDetails();
  });
});
</script>

