<div class="modal fade" id="modal-dash-junket-loss" tabindex="-1" aria-labelledby="modal-dash-junket-loss-label" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="modal-dash-junket-loss-label"><%= __('junket_loss.title') %></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="junket-loss-filter-bar junket-loss-filter-bar--modal d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <div class="junket-loss-daterange-group d-flex flex-wrap align-items-center gap-2">
            <div class="junket-loss-daterange-wrap">
              <input type="text" id="junket-loss-daterange" class="form-control form-control-sm text-center dash-junket-loss-daterange" placeholder="<%= __('junket_loss.select_date_range') || 'Select date range' %>" autocomplete="off" />
            </div>
            <%- include('../../partials/split_daterange', {
              splitPrefix: 'junket-loss',
              splitLocaleNs: 'junket_loss',
              splitWrapClass: 'junket-loss-daterange-wrap junket-loss-split-daterange house-expense-split-daterange'
            }) %>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <button type="button" id="btn-junket-loss-print" class="btn btn-sm btn-alt-success">
              <i class="fa fa-print" aria-hidden="true"></i> Print
            </button>
            <button type="button" id="btn-junket-loss-export" class="btn btn-sm btn-success">
              <i class="fa fa-file-excel" aria-hidden="true"></i> <%= __('junket_loss.export') || 'Export' %>
            </button>
            <% if (typeof permissions !== 'undefined' && permissions !== 2) { %>
            <button type="button" class="btn btn-sm btn-primary" id="btn-add-junket-loss" data-view-only-disable>
              <i class="fa fa-plus me-1"></i> <%= __('junket_loss.add') || 'Add Loss Amount' %>
            </button>
            <% } %>
          </div>
        </div>
        <%- include('../../partials/junket_loss_type_tabs') %>
        <div class="table-responsive">
          <table id="junket-loss-tbl" class="table nowrap small-text mb-0" style="width:100%">
            <thead>
              <tr>
                <th>Program Date</th>
                <th>Date &amp; Time</th>
                <th>Account</th>
                <th>Guest</th>
                <th>Amount</th>
                <th>Type</th>
                <th>Person(s) Involved</th>
                <th>Description</th>
                <%# <th>Encoded By</th> %>
                <%# <th>Action</th> %>
              </tr>
            </thead>
            <tfoot>
              <tr>
                <th colspan="4" class="text-end">Total</th>
                <th id="junket-loss-total-amount" class="text-end"></th>
                <th colspan="3"></th>
              </tr>
            </tfoot>
            <tbody></tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-junket-loss" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="junket-loss-modal-title">Add Loss Amount</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="junket-loss-form">
        <div class="modal-body">
          <%- include('../../partials/junket_loss_form_fields') %>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary" id="junket-loss-save-btn" data-view-only-disable>Save</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  #modal-dash-junket-loss .junket-loss-filter-bar--modal {
    padding-left: 0;
    padding-right: 0;
  }

  #modal-dash-junket-loss .dash-junket-loss-daterange {
    max-width: none;
  }

  #modal-dash-junket-loss .junket-loss-daterange-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  #modal-dash-junket-loss #junket-loss-tbl thead th {
    background: #f4f6fa;
    color: #495057;
    font-weight: 600;
    padding: 10px 12px;
    border-bottom: 2px solid #dee2e6;
  }

  #modal-dash-junket-loss #junket-loss-tbl thead th:nth-child(5),
  #modal-dash-junket-loss #junket-loss-tbl tbody td:nth-child(5),
  #modal-dash-junket-loss #junket-loss-tbl tfoot th:nth-child(2) {
    text-align: right !important;
    padding-right: 16px;
  }

  #modal-dash-junket-loss #junket-loss-tbl thead th:nth-child(6),
  #modal-dash-junket-loss #junket-loss-tbl tbody td:nth-child(6) {
    text-align: center;
  }

  #modal-dash-junket-loss #junket-loss-tbl tfoot th {
    background: #f4f6fa;
    font-weight: 700;
    padding: 10px 12px;
    border-top: 2px solid #dee2e6;
  }

  #modal-dash-junket-loss #junket-loss-tbl .text-dash-neg {
    color: #dc3545;
  }

  #modal-dash-junket-loss .junket-loss-type-tabs .nav-link {
    font-size: 0.875rem;
    color: #8a92a6;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.5rem 0.75rem;
    background: transparent;
  }

  #modal-dash-junket-loss .junket-loss-type-tabs .nav-link:hover {
    color: #6b4f14;
  }

  #modal-dash-junket-loss .junket-loss-type-tabs .nav-link.active {
    color: #6b4f14;
    font-weight: 500;
    border-bottom-color: #6b4f14;
    background: transparent;
  }

  #modal-dash-junket-loss #junket-loss-tbl tbody td {
    padding: 10px 12px;
    vertical-align: middle;
  }
</style>
