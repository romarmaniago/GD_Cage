<script>
$(document).ready(function() {
  // 1) Permissions
  const permissions = parseInt($('#user-role').data('permissions')) || 0;
  if (permissions === 2) {
    $('#add_junket_total_chips button[type="submit"]').prop('disabled', true);
  }

  function ensureTotalChipsProgramDatePicker() {
    const el = document.getElementById('totalChipsProgramDate');
    if (!el || typeof flatpickr === 'undefined') return;
    if (el._flatpickr) {
      el._flatpickr.destroy();
    }
    flatpickr(el, {
      enableTime: false,
      dateFormat: 'Y-m-d',
      altInput: true,
      altFormat: 'M j, Y',
      defaultDate: new Date(),
      allowInput: true,
      disableMobile: true
    });
  }

  window.openTotalChipsModal = function(mode) {
    $('#nnChips').val('').removeClass('is-invalid');
    $('#ccChips').val('').removeClass('is-invalid');
    $('#totalChips').val('');
    $('input[name="optBuyinReturn"]').prop('checked', false);
    ensureTotalChipsProgramDatePicker();

    if (mode === 'buyin') {
      $('#add').prop('checked', true);
    } else if (mode === 'rolling') {
      $('#rolling').prop('checked', true);
    } else if (mode === 'cashout') {
      $('#deduct').prop('checked', true);
    }

    if (typeof updatetypeDescription === 'function') {
      updatetypeDescription();
    } else if (typeof syncChipsInputsForTransactionMode === 'function') {
      syncChipsInputsForTransactionMode();
    }

    const modalEl = document.getElementById('modal-new-total-chips');
    if (modalEl && typeof bootstrap !== 'undefined') {
      bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }
  };

  function syncChipsInputsForTransactionMode() {
    const selected = $('input[name="optBuyinReturn"]:checked').val();
    if (selected === '1') {
      $('#ccChips').prop('disabled', true).val('').removeClass('is-invalid');
      $('#nnChips').prop('disabled', false);
    } else if (selected === '3') {
      $('#nnChips').prop('disabled', true).val('').removeClass('is-invalid');
      $('#ccChips').prop('disabled', false);
    } else {
      $('#nnChips').prop('disabled', false);
      $('#ccChips').prop('disabled', false);
    }
    calculateTotalChips();
  }

  // 2) Update typedescription on radio change
  window.updatetypeDescription = function() {
    const isBuyin = document.getElementById('add').checked;
    const isReturn = document.getElementById('deduct').checked;
    const isRolling = document.getElementById('rolling').checked;
    document.getElementById('typedescription').value = isBuyin
      ? '<span class="css-red">Chips Buy-in</span>'
      : (isReturn
        ? '<span class="css-red">Chips Cashout</span>'
        : (isRolling
          ? '<span class="css-red">Chips Rolling</span>'
          : '<span class="css-red">Chips Buy-in</span>'));
    syncChipsInputsForTransactionMode();
  }

  // 3) Only number key
  window.onlyNumberKey = function(evt) {
    let charCode = (evt.which) ? evt.which : evt.keyCode;
    if (charCode > 31 && (charCode < 48 || charCode > 57)) {
      return false;
    }
    return true;
  }

  // 4) Format numbers with commas
  window.formatNumberWithCommas = function(x) {
    return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
  }

  // 5) validateChips — Buy-in: NN only, ≤ cash. Cash-out / rolling: caps; amounts any positive value (not restricted to ×1000).
  window.validateChips = function() {
    const selected = $('input[name="optBuyinReturn"]:checked').val(); // "1" buy-in, "2" cash-out, "3" rolling

    const nnChipsRaw = (($('#nnChips').val() || '') + '').replace(/,/g, '');
    const ccChipsRaw = (($('#ccChips').val() || '') + '').replace(/,/g, '');
    const nnChips    = parseFloat(nnChipsRaw || '0') || 0;
    const ccChips    = parseFloat(ccChipsRaw || '0') || 0;
    const nnbalance  = parseFloat(($('#nnbalance').val()  || '0').toString().replace(/,/g, '')) || 0;
    const ccbalance  = parseFloat(($('#ccbalance').val()  || '0').toString().replace(/,/g, '')) || 0;
    const cashBalanceLimit = parseFloat(($('#total-chips-cash-balance').val() || '0').toString().replace(/,/g, '')) || 0;

    const nnTrimmed = nnChipsRaw.trim();
    const ccTrimmed = ccChipsRaw.trim();

    // BUY-IN — NN only; amount > 0, ≤ Cash Balance (any positive amount, not limited to thousands)
    if (selected === "1") {
      if (ccChips > 0 || ccTrimmed !== '') {
        Swal.fire({
          icon: 'error',
          title: 'Chips Buy-in',
          text: 'Buy-in allows NN chips only. CC is not used for buy-in.'
        });
        return false;
      }
      if (!nnTrimmed || !Number.isFinite(nnChips) || nnChips <= 0) {
        Swal.fire({
          icon: 'error',
          title: 'NN amount required',
          text: 'Enter a valid positive NN chips amount for buy-in.'
        });
        return false;
      }
      if (nnChips > cashBalanceLimit) {
        Swal.fire({
          icon: 'error',
          title: 'Insufficient Cash Balance',
          text: 'NN Chips Buy-in cannot exceed the current Cash Balance of ' + formatNumberWithCommas(cashBalanceLimit) + '.'
        });
        return false;
      }
      return true;
    }

    // CHIPS CASH-OUT
    if (selected === "2") {
      if (nnTrimmed && (!Number.isFinite(nnChips) || nnChips <= 0)) {
        Swal.fire({
          icon: 'error',
          title: 'Invalid NN Chips amount',
          text: 'Enter a valid positive NN amount, or leave blank if cashing out CC only.'
        });
        return false;
      }

      if (nnChips <= 0 && ccChips <= 0) {
        Swal.fire({
          icon: 'error',
          title: 'Amount required',
          text: 'Enter NN chips and/or CC chips to cash out.'
        });
        return false;
      }

      if (ccTrimmed && (!Number.isFinite(ccChips) || ccChips <= 0)) {
        Swal.fire({
          icon: 'error',
          title: 'Invalid CC Chips amount',
          text: 'Enter a valid positive CC amount, or leave blank if cashing out NN only.'
        });
        return false;
      }

      if (nnChips > nnbalance) {
        Swal.fire({
          icon: 'error',
          title: 'Exceeds NN balance',
          text: 'NN chips cash-out cannot exceed the current NN balance of ' + formatNumberWithCommas(nnbalance) + '.'
        });
        return false;
      }

      if (ccChips > ccbalance) {
        Swal.fire({
          icon: 'error',
          title: 'Exceeds CC balance',
          text: 'CC chips cash-out cannot exceed the current CC balance of ' + formatNumberWithCommas(ccbalance) + '.'
        });
        return false;
      }
      return true;
    }

    // ROLLING — CC only; must not exceed NN balance nor CC balance
    if (selected === "3") {
      if (nnTrimmed !== '' || nnChips > 0) {
        Swal.fire({
          icon: 'error',
          title: 'Chips Rolling',
          text: 'Rolling allows CC chips only. NN is not used for rolling.'
        });
        return false;
      }
      if (!ccTrimmed || !Number.isFinite(ccChips) || ccChips <= 0) {
        Swal.fire({
          icon: 'error',
          title: 'CC amount required',
          text: 'Enter a valid positive CC chips amount for rolling.'
        });
        return false;
      }
      if (ccChips > ccbalance) {
        Swal.fire({
          icon: 'error',
          title: 'Exceeds CC balance',
          text: 'CC rolling cannot exceed the current CC balance of ' + formatNumberWithCommas(ccbalance) + '.'
        });
        return false;
      }
      if (ccChips > nnbalance) {
        Swal.fire({
          icon: 'error',
          title: 'Exceeds NN balance',
          text: 'CC rolling cannot exceed the current NN balance of ' + formatNumberWithCommas(nnbalance) + '.'
        });
        return false;
      }
    }

    return true;
  }

  // 6) Calculate total chips on input
  window.calculateTotalChips = function() {
    const nnChips = parseFloat((($('#nnChips').val() || '') + '').replace(/,/g, '')) || 0;
    const ccChips = parseFloat((($('#ccChips').val() || '') + '').replace(/,/g, '')) || 0;
    const totalChips = nnChips + ccChips;
    $('#totalChips').val(totalChips.toLocaleString('en-US'));
  }

  // Disable Chips Buy-in when CC Chips has value
  function toggleBuyInRadioByCcChips() {
    const ccRawValue = ($('#ccChips').val() || '').toString().replace(/,/g, '').trim();
    const hasCcValue = ccRawValue !== '' && parseFloat(ccRawValue) > 0;
    const $buyInRadio = $('#add');

    $buyInRadio.prop('disabled', hasCcValue);

    // If currently selected and becomes disabled, move selection to Cashout
    if (hasCcValue && $buyInRadio.is(':checked')) {
      $('#deduct').prop('checked', true);
      updatetypeDescription();
    }
  }

  // Disable Rolling when NN Chips has value
  function toggleRollingRadioByNnChips() {
    const nnRawValue = ($('#nnChips').val() || '').toString().replace(/,/g, '').trim();
    const hasNnValue = nnRawValue !== '' && parseFloat(nnRawValue) > 0;
    const $rollingRadio = $('#rolling');

    $rollingRadio.prop('disabled', hasNnValue);

    // If currently selected and becomes disabled, move selection to Cashout
    if (hasNnValue && $rollingRadio.is(':checked')) {
      $('#deduct').prop('checked', true);
      updatetypeDescription();
    }
  }

  function validateCcChipsInline() {
    const $input = $('#ccChips');
    const raw = (($input.val() || '') + '').replace(/,/g, '');
    const trimmed = raw.trim();

    if (!trimmed) {
      $input.removeClass('is-invalid');
      return;
    }

    const value = parseFloat(trimmed);
    if (!Number.isFinite(value) || value <= 0) {
      $input.addClass('is-invalid');
    } else {
      $input.removeClass('is-invalid');
    }
  }

  function validateNnChipsInline() {
    const $input = $('#nnChips');
    const raw = (($input.val() || '') + '').replace(/,/g, '');
    const trimmed = raw.trim();

    if (!trimmed) {
      $input.removeClass('is-invalid');
      return;
    }

    const value = parseFloat(trimmed);
    if (!Number.isFinite(value) || value <= 0) {
      $input.addClass('is-invalid');
    } else {
      $input.removeClass('is-invalid');
    }
  }

  $('#nnChips').on('input', function() {
    calculateTotalChips();
    validateNnChipsInline();
    toggleRollingRadioByNnChips();
  });
  $('#ccChips').on('input', function() {
    calculateTotalChips();
    validateCcChipsInline();
    toggleBuyInRadioByCcChips();
  });

  ensureTotalChipsProgramDatePicker();
  $('#modal-new-total-chips').on('shown.bs.modal', ensureTotalChipsProgramDatePicker);

  // 7) Spinner logic on form submit
  $('#add_junket_total_chips').on('submit', function(e) {
    e.preventDefault();
    if (typeof validateChips === 'function' && !validateChips()) {
      return false;
    }

    const programDateEl = document.getElementById('totalChipsProgramDate');
    const programDateVal = (programDateEl && programDateEl.value ? programDateEl.value : '').trim();
    if (!/^\d{4}-\d{2}-\d{2}$/.test(programDateVal)) {
      Swal.fire({
        icon: 'warning',
        title: 'Program Date required',
        text: 'Select a valid Program Date before saving.',
        confirmButtonText: 'OK'
      });
      return;
    }

    const nnChips = parseFloat($('#nnChips').val().replace(/,/g, '')) || 0;
    const ccChips = parseFloat($('#ccChips').val().replace(/,/g, '')) || 0;
    const totalAmount = (nnChips + ccChips).toLocaleString('en-US');
    const labelMap = {
      '1': {text: '<span class="badge-cashin">Chips Buy-in</span>', type: 'Buy-in'},
      '2': {text: '<span class="badge-cashout">Chips Cashout</span>', type: 'Cashout'},
      '3': {text: '<span class="badge-rolling">Chips Rolling</span>', type: 'Rolling'}
    };
    const value = $('input[name="optBuyinReturn"]:checked').val() || '1';
    const chosen = labelMap[value] || labelMap['1'];

    SwalConfirm.fire({
      title: 'Confirm transaction',
      rows: [
        ['Program Date', programDateVal],
        ['Type', chosen.text],
        ['Amount', '₱ ' + totalAmount]
      ],
      confirmButtonText: 'Yes, save'
    }).then((result) => {
      if (!result.isConfirmed) {
        return;
      }

      const $btn = $(this).find("button[type='submit']");
      $btn.prop('disabled', true).html(`
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        Loading...
      `);

      setTimeout(() => {
        this.submit();
      }, 1000);
    });
  });

  // 8) Combined NN and CC Chips History
  function loadTotalChipsHistory() {
    const dateRange = $('#total-chips-daterange').val();
    console.log('Total Chips History Date Range:', dateRange);

    const resolved = window.MonthEndCutoffRange
      ? window.MonthEndCutoffRange.resolveRangeFromPicker(dateRange, 'total-chips-daterange')
      : null;

    let startNorm;
    let endNorm;
    let endDisplay;
    if (resolved) {
      startNorm = resolved.start;
      endNorm = resolved.end;
      endDisplay = resolved.endDisplay;
    } else {
      if (!dateRange) {
        alert('Please select a date range.');
        return;
      }
      let startDate;
      let endDate;
      if (dateRange.indexOf(" to ") > -1) {
        [startDate, endDate] = dateRange.split(" to ");
      } else {
        startDate = dateRange;
        endDate = dateRange;
      }
      startNorm = window.parseToYmd(startDate) || (startDate || '').trim();
      endNorm = window.parseToYmd(endDate) || (endDate || '').trim();
      endDisplay = endNorm;
    }

    if (!startNorm || !endNorm) {
      alert('Please select a date range.');
      return;
    }
    console.log('Total Chips History Start:', startNorm, 'End:', endNorm);

    // Destroy existing DataTable instance if it exists
    if ($.fn.DataTable.isDataTable('#total-chips-history-tbl')) {
      $('#total-chips-history-tbl').DataTable().destroy();
    }

    // Fetch NN, CC chips data and month_settle for this period (if any)
    Promise.all([
      $.ajax({ url: `/nn_chips_history?start_date=${startNorm}&end_date=${endNorm}&` + new Date().getTime(), type: "GET" }),
      $.ajax({ url: `/cc_chips_history?start_date=${startNorm}&end_date=${endNorm}&` + new Date().getTime(), type: "GET" }),
      $.ajax({ url: `/month_settle_for_period?start_date=${startNorm}&end_date=${endNorm}&` + new Date().getTime(), type: "GET" })
    ]).then(function([nnData, ccData, periodSettle]) {
      console.log('Raw NN Chips Data:', nnData);
      console.log('Raw CC Chips Data:', ccData);
      console.log('periodSettle (nn_cashout to less):', periodSettle);

      // Process NN Chips data (from nn_chips_history - only junket_total_chips rows)
      // Formula: NN Buy-in + NN Rolling (Cashout and Monthly Settle displayed but excluded from total)
      const nnFiltered = (Array.isArray(nnData) ? nnData : []).map(function(row) {
        const isChipsBuyIn = row.TRANSACTION_ID == 1;
        const isChipsCashout = row.TRANSACTION_ID == 2;
        const isChipsMonthlySettle = row.TRANSACTION_ID == 4;
        const nnChips = parseFloat(row.NN_CHIPS) || 0;
        const amount = nnChips.toLocaleString('en-US');
        const type = isChipsBuyIn
            ? '<span class="badge-cashin">NN Chips Buy-in</span>'
            : (isChipsCashout
                ? '<span class="badge-cashout">NN Chips Cashout</span>'
                : (isChipsMonthlySettle
                    ? '<span class="badge-cashout">NN Chips Monthly Settle</span>'
                    : '<span class="badge-rolling">Chips Rolling</span>'));
        // NN Cashout and Monthly Settle displayed but excluded from total (amountRaw = 0)
        const amountRaw = (isChipsCashout || isChipsMonthlySettle) ? 0 : nnChips;

        return {
          encodedBy: row.ENCODED_BY_NAME || 'N/A',
          amount: amount,
          amountRaw: amountRaw, // Buy-in and Rolling added; Cashout = 0 (display only)
          type: type,
          remarks: row.REMARKS ? row.REMARKS + (row.GAME_ID ? ` GAME-${row.GAME_ID}` : '') : '',
          recordId: row.IDNo,
          remarksRaw: row.REMARKS || '',
          date: window.formatEncodedDate(row.ENCODED_DT),
          action: (typeof getActionButton === 'function' ? getActionButton(row.IDNo) : ''),
          sortDate: new Date(row.ENCODED_DT)
        };
      });

      // Process CC Chips data - Buy-in, Rolling, and Cashout (display all; Cashout excluded from total)
      const ccFiltered = (Array.isArray(ccData) ? ccData : []).map(function(row) {
        const isChipsBuyIn = row.TRANSACTION_ID == 1;
        const isChipsCashout = row.TRANSACTION_ID == 2;
        const isChipsMonthlySettle = row.TRANSACTION_ID == 4;
        const ccChips = parseFloat(row.CC_CHIPS) || 0;
        const amount = ccChips.toLocaleString('en-US');
        const type = isChipsBuyIn
            ? '<span class="badge-cashin">CC Chips Buy-in</span>'
            : (isChipsCashout
                ? '<span class="badge-cashout">CC Chips Cashout</span>'
                : (isChipsMonthlySettle
                    ? '<span class="badge-cashout">CC Chips Monthly Settle</span>'
                    : '<span class="badge-rolling">Chips Rolling</span>'));
        // CC Cashout and Monthly Settle displayed but not included in total (amountRaw = 0)
        const amountRaw = (isChipsCashout || isChipsMonthlySettle) ? 0 : ccChips;

        return {
          encodedBy: row.ENCODED_BY_NAME || 'N/A',
          amount: amount,
          amountRaw: amountRaw, // Buy-in and Rolling added; Cashout = 0 (display only)
          type: type,
          remarks: row.REMARKS || '',
          recordId: row.IDNo,
          remarksRaw: row.REMARKS || '',
          date: window.formatEncodedDate(row.ENCODED_DT),
          action: (typeof getActionButton === 'function' ? getActionButton(row.IDNo) : ''),
          sortDate: new Date(row.ENCODED_DT)
        };
      });

      // Combine and sort by date descending
      const combinedData = [...nnFiltered, ...ccFiltered].sort((a, b) => b.sortDate - a.sortDate);

      // Convert to DataTable format with raw amount stored for total calculation
      const tableData = combinedData.map((row, index) => {
        const rowArray = [
          row.encodedBy,
          row.amount,
          row.type,
          row.remarks,
          row.date,
          row.action
        ];
        // Store raw amount as a property on the row array for easy access
        rowArray._rawAmount = row.amountRaw;
        rowArray._sortDate = row.sortDate instanceof Date && !isNaN(row.sortDate.getTime()) ? row.sortDate.getTime() : 0;
        rowArray._recordId = row.recordId;
        rowArray._remarksRaw = row.remarksRaw != null ? row.remarksRaw : '';
        rowArray._remarksDisplay = row.remarks != null ? row.remarks : '';
        return rowArray;
      });

      console.log('Combined Total Chips History Data:', tableData);

      // Initialize DataTable
      const table = $('#total-chips-history-tbl').DataTable({
        processing: false,
        serverSide: false,
        data: tableData,
        order: [[4, 'desc']], // Sort by date descending
        columnDefs: [{
          targets: 3,
          render: function (data, type, row) {
            var display = row._remarksDisplay != null ? row._remarksDisplay : (data || '');
            if (type !== 'display') return display;
            if (!window.RemarksEditor || !row._recordId) return display;
            return window.RemarksEditor.renderCell(row._remarksRaw || '', {
              source: 'junket_total_chips',
              recordId: row._recordId,
              displayText: display
            });
          }
        }],
        columns: [
          { "className": "text-center" },
          { "className": "text-end" },
          { "className": "text-center" },
          { "className": "text-center" },
          {
            "className": "text-center",
            "render": function(data, type, row) {
              if (type === 'sort' || type === 'type') return row && row._sortDate ? row._sortDate : 0;
              return data;
            }
          },
          { "className": "text-center", "orderable": false }
        ],
        responsive: true,
        language: {
          "emptyTable": "No chips transactions found",
          "processing": "Loading chips transactions..."
        },
        drawCallback: function(settings) {
          $('[data-bs-toggle="tooltip"]').tooltip();
        },
        footerCallback: function(row, data, start, end, display) {
          // Calculate total of all filtered data (Buy-in + Rolling)
          let total = 0;
          const api = this.api();
          api.rows({ search: 'applied' }).every(function() {
            const rowData = this.data();
            if (rowData._rawAmount !== undefined) {
              total += parseFloat(rowData._rawAmount) || 0;
            }
          });
          // Ibawas ang nn_cashout kung period tapos na (end <= today) at may month_settle record
          const isPeriodEnded = endDisplay && window.isDateSameOrBefore(endDisplay);
          const nnSettle = parseFloat(periodSettle && periodSettle.nn_cashout) || 0;
          const netTotal = isPeriodEnded ? Math.max(0, total - nnSettle) : total;
          $('#total-chips-amount-sum').text(netTotal.toLocaleString('en-US'));
        }
      });
    }).catch(function(error) {
      console.error('Error loading chips history:', error);
    });
  }

  // Initialize date picker and load history when modal is shown
  let totalChipsPicker = null;

  function refreshTotalChipsRefBalances() {
    fetch('/dashboard_house_balances', { credentials: 'same-origin' })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (!data || data.message) return;
        const cash = Math.round(Number(data.cashBalance) || 0);
        const nn = Math.round(Number(data.nnChipsBalance) || 0);
        const cc = Math.round(Number(data.ccChipsBalance) || 0);
        $('#total-chips-cash-balance-display').text(cash.toLocaleString('en-US'));
        $('#total-chips-cash-balance').val(cash.toLocaleString('en-US'));
        $('#nnbalance-display').text(nn.toLocaleString('en-US'));
        $('#nnbalance').val(nn.toLocaleString('en-US'));
        $('#ccbalance-display').text(cc.toLocaleString('en-US'));
        $('#ccbalance').val(cc.toLocaleString('en-US'));
      })
      .catch(function(err) {
        console.error('refreshTotalChipsRefBalances:', err);
      });
  }

  $('#modal-new-total-chips').on('shown.bs.modal', function () {
    console.log('Total Chips Modal shown');
    refreshTotalChipsRefBalances();
    
    const jumpTotalChipsRangeToCurrentThreeMonths = function(instance) {
      if (!instance) return;
      const current = new Date();
      instance.jumpToDate(new Date(current.getFullYear(), current.getMonth() - 2, 1), false);
    };
    
    if ($('#total-chips-daterange').length > 0) {
      if (!totalChipsPicker || !$('#total-chips-daterange').hasClass('flatpickr-input')) {
        totalChipsPicker = flatpickr("#total-chips-daterange", {
          mode: "range",
          showMonths: 3,
          onReady: function(selectedDates, dateStr, instance) {
            jumpTotalChipsRangeToCurrentThreeMonths(instance);
          },
          onOpen: function(selectedDates, dateStr, instance) {
            jumpTotalChipsRangeToCurrentThreeMonths(instance);
          },
          onChange: function(selectedDates, dateStr) {
            console.log('Total Chips History Date changed:', dateStr);
            if (selectedDates.length === 2) {
              loadTotalChipsHistory();
            }
          }
        });
      }
      
      // Initial load of combined chips history data
      loadTotalChipsHistory();
      const sel = $('input[name="optBuyinReturn"]:checked').val();
      if (sel) {
        syncChipsInputsForTransactionMode();
      } else {
        $('#nnChips').prop('disabled', false);
        $('#ccChips').prop('disabled', false);
      }
      toggleBuyInRadioByCcChips();
      toggleRollingRadioByNnChips();
    } else {
      console.error('total-chips-daterange element not found');
    }
  });
});
</script>
