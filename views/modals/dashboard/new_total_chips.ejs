<!-- Modal -->
<div class="modal fade" id="modal-new-total-chips" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="staticBackdropLiveLabel"><%= __('dashboard_total_chips.total_chips') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <div class="row mb-2 g-2 align-items-center total-chips-top-date-row">
          <div class="col-auto total-chips-history-date-wrap">
            <input type="text" id="total-chips-daterange" name="total-chips-daterange" class="form-control"
              placeholder="Select date range" autocomplete="off" />
          </div>
          <div class="col-auto total-chips-program-date-wrap">
            <input
              type="text"
              id="totalChipsProgramDate"
              name="txtProgramDate"
              form="add_junket_total_chips"
              class="form-control input-program-date"
              placeholder="<%= __('dashboard_total_chips.program_date') %>"
              autocomplete="off"
              required
            />
          </div>
        </div>

        <form id="add_junket_total_chips" action="/add_junket_total_chips" method="POST">
          <%
            function sumServiceTotals(rows) {
              if (!rows || !rows.length) return 0;
              return rows.reduce(function(sum, row) { return sum + (+row.TOTAL || 0); }, 0);
            }
            const refCcBal = (+sqlCCChipsBuyin[0].CCChipsBuyin || 0) -
              (+sqlCCChipsCashout[0].CCChipsCashout || 0) +
              (+sqlTotalRealRolling[0].TOTAL_REAL_ROLLING || 0) -
              (+sqlCCChipsRolling[0].CCChipsRolling || 0) -
              (+sqlNNChipsRolling[0].NNChipsRolling || 0) +
              (+sqlAccountCCChipsReturn[0].CC_CHIPS_RETURN || 0) -
              (+sqlCCChipsBuyinGame[0].TOTAL_CC || 0) +
              (+sqlCCBuyin[0].CCBuyin || 0) -
              (+sqlCCReturn[0].CCReturn || 0) -
              (+sqlRollerCCSubtract[0].ROLLER_CC_SUBTRACT || 0) +
              (+sqlRollerCCAdd[0].ROLLER_CC_ADD || 0) -
              (+sqlCCChipsMonthlySettle[0].CCChipsMonthlySettle || 0);
            const refNnBal = (+sqlNNChipsBuyin[0].NNChipsBuyin || 0) -
              (+sqlNNChipsCashout[0].NNChipsCashout || 0) -
              (+sqlAccountNNChips[0].TOTAL_NN || 0) +
              (+sqlTotalCashOutRolling[0].TOTAL_CASHOUT || 0) -
              (+sqlTotalRealRolling[0].TOTAL_REAL_ROLLING || 0) +
              (+sqlNNChipsRolling[0].NNChipsRolling || 0) +
              (+sqlCCChipsRolling[0].CCChipsRolling || 0) +
              (+sqlNNBuyin[0].NNBuyin || 0) -
              (+sqlNNReturn[0].NNReturn || 0) -
              (+sqlRollerNNSubtract[0].ROLLER_NN_SUBTRACT || 0) +
              (+sqlRollerNNAdd[0].ROLLER_NN_ADD || 0) -
              (+sqlNNChipsMonthlySettle[0].NNChipsMonthlySettle || 0);
            let refCashBal = typeof cashBalance !== 'undefined' ? cashBalance : 0;
            if (typeof sqlCashDeposit !== 'undefined' && sqlCashDeposit && sqlCashDeposit[0]) {
              const refCashInTotal =
                (+sqlCashDeposit[0].CASH_DEPOSIT || 0) +
                (+sqlAccountDeposit[0].ACCOUNT_DEPOSIT || 0) +
                (+sqlSettlementDepositAmount[0].SETTLEMENT_DEPOSIT || 0) +
                (+sqlTotalChipsCashout[0].TotalChipsCashout || 0) +
                (+sqlNNChipsAccountCash[0].TOTAL_NN_CASH || 0) +
                (+sqlCCChipsBuyinCashOnly[0].CC_CHIPS_BUYIN_CASH_ONLY || 0) +
                sumServiceTotals(sqlServiceCashGuest) +
                sumServiceTotals(sqlServiceDepositGuest) +
                (+sqlMArkerReturnCash[0].MARKER_RETURN_CASH || 0) +
                (+sqlRollerTipCashOut[0].ROLLER_TIP_CASHIN || 0) +
                (+sqlRollerTipIn[0].TIP_IN_CASHIN || 0);
              const refCashOutTotal =
                (+sqlCCChipsBuyin[0].CCChipsBuyin || 0) +
                (+sqlCashWithdraw[0].CASH_WITHDRAW || 0) +
                (+sqlJunketExpense[0].JUNKET_EXPENSE || 0) +
                (+sqlNNChipsBuyin[0].NNChipsBuyin || 0) +
                (+sqlAccountWithdraw[0].ACCOUNT_WITHDRAW || 0) +
                (+sqlTotalCashOut[0].TOTAL_CASHOUT || 0) +
                (+sqlAccountSettlement[0].ACCOUNT_SETTLEMENT || 0) +
                (+sqlAccountServicesDeduct[0].ACCOUNT_DEDUCT_SERVICES || 0) +
                (+sqlMarkerIssueAccount[0].TOTAL_ISSUE_RECORD || 0) +
                sumServiceTotals(sqlServiceCashJunket) +
                sumServiceTotals(sqlServiceDepositJunket) +
                (+sqlAccountTransfer[0].ACCOUNT_TRANSFER || 0) +
                (+sqlManualBalancing[0].MANUAL_BALANCING || 0) +
                (+sqlJunketLoss[0].JUNKET_LOSS || 0) +
                (+sqlTipSettlement[0].TIP_SETTLEMENT || 0);
              refCashBal = refCashInTotal - refCashOutTotal + (+sqlMxCashNet[0].MX_CASH_NET || 0);
            }
            const refCcBalStr = refCcBal.toLocaleString('en-US');
            const refNnBalStr = refNnBal.toLocaleString('en-US');
            const refCashBalStr = refCashBal.toLocaleString('en-US');
          %>

          <div class="row mb-3 g-2 total-chips-ref-balances">
            <div class="col-md-4">
              <div class="total-chips-ref-card rounded-3 p-3 h-100">
                <div class="total-chips-ref-label">Cash balance</div>
                <div class="total-chips-ref-value total-chips-ref-value--cash" id="total-chips-cash-balance-display"><%= refCashBalStr %></div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="total-chips-ref-card rounded-3 p-3 h-100">
                <div class="total-chips-ref-label">NN Chips</div>
                <div class="total-chips-ref-value total-chips-ref-value--nn" id="nnbalance-display"><%= refNnBalStr %></div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="total-chips-ref-card rounded-3 p-3 h-100">
                <div class="total-chips-ref-label">CC Chips</div>
                <div class="total-chips-ref-value total-chips-ref-value--cc" id="ccbalance-display"><%= refCcBalStr %></div>
              </div>
            </div>
          </div>

          <!-- NN Chips -->
          <div class="row mb-2">
            <div class="col-sm-12">
              <input 
                type="text"
                class="form-control"
                placeholder="<%= __('dashboard_total_chips.nn_chips') %>"
                id="nnChips"
                name="txtNNChips"
                onkeypress="return onlyNumberKey(event)"
                data-type="number"
                autocomplete="off" 
              />
            </div>
          </div>

          <!-- CC Chips -->
          <div class="row mb-2">
            <div class="col-sm-12">
              <input
                type="text"
                class="form-control"
                placeholder="<%= __('dashboard_total_chips.cc_chips') %>"
                id="ccChips"
                name="txtCCChips"
                onkeypress="return onlyNumberKey(event)"
                data-type="number"
                autocomplete="off"
              />
            </div>
          </div>

          <!-- Total Chips (read-only) -->
          <div class="row mb-2">
            <div class="col-sm-12">
              <input 
                type="text"
                placeholder="<%= __('dashboard_total_chips.total_chips') %>"
                class="form-control"
                id="totalChips"
                name="txtTotalChips"
                disabled
              />
            </div>
          </div>

          <!-- Hidden fields for balances (IDs kept for validateChips / limits) -->
          <input type="hidden" value="<%= refCcBalStr %>" id="ccbalance" name="txtccbalance" />
          <input type="hidden" value="<%= refNnBalStr %>" id="nnbalance" name="txtnnbalance" />
          <input type="hidden" value="<%= refCashBalStr %>" id="total-chips-cash-balance" name="txtcashbal" />

                        <input type="hidden" name="typedescription" id="typedescription" value="Chips Buy-in">

          <!-- Radio Buttons -->
          <div class="row mb-2 align-items-center d-flex justify-content-center">
            <div class="col-sm-4 d-flex justify-content-center">
              <div class="form-check">
                <input 
                  class="form-check-input" style="border-color: #8a92a6 !important;"
                  type="radio"
                  id="add"
                  name="optBuyinReturn"
                  value="1"
                  onclick="updatetypeDescription()"
                  required
                >
                <label class="form-check-label" for="add"><%= __('dashboard_total_chips.chips_buyin') %></label>
              </div>
            </div>
            <div class="col-sm-4 d-flex justify-content-center">
              <div class="form-check">
                <input
                  class="form-check-input" style="border-color: #8a92a6 !important;"
                  type="radio"
                  id="deduct"
                  name="optBuyinReturn"
                  value="2"
                  onclick="updatetypeDescription()"
                  required
                >
                <label class="form-check-label" for="deduct"><%= __('dashboard_total_chips.chips_cashout') %></label>
              </div>
            </div>
            <div class="col-sm-4 d-flex justify-content-center">
              <div class="form-check">
                <input
                  class="form-check-input" style="border-color: #8a92a6 !important;"
                  type="radio"
                  id="rolling"
                  name="optBuyinReturn"
                  value="3"
                  onclick="updatetypeDescription()"
                  required
                >
                <label class="form-check-label" for="rolling"><%= __('dashboard_total_chips.rolling') %></label>
              </div>
            </div>
          </div>

          <!-- Modal Footer -->
          <div class="modal-footer">
            <!-- NOTE: Removed onclick from here -->
            <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-check-circle me-1"></i>
              <%= __('dashboard_total_chips.save') %>
            </button>
            <button
              type="button"
              class="btn btn-sm btn-alt-secondary"
              data-bs-dismiss="modal"
            >
              <%= __('dashboard_total_chips.close') %>
            </button>
          </div>

        </form>

        <hr style="border: none; border-top: 0.2rem solid black; margin-top: 20px; margin-bottom: 20px;">
        
        <table id="total-chips-history-tbl" class="table table-bordered table-responsive"
            style="font-size: 13px !important;">
          <thead>
            <tr>
              <th><%= __('dashboard_total_chips.encoded_by') %></th>
              <th><%= __('dashboard_total_chips.amount') %></th>
              <th><%= __('dashboard_total_chips.type') %></th>
              <th><%= __('dashboard_total_chips.remarks') %></th>
              <th><%= __('dashboard_total_chips.date') %></th>
              <th><%= __('dashboard_total_chips.action') %></th>
            </tr>
          </thead>
          <tbody>
          </tbody>
          <tfoot>
            <tr>
              <th colspan="1" style="text-align: right; font-weight: 600;">Total:</th>
              <th id="total-chips-amount-sum" style="text-align: right; font-weight: 600;">0</th>
              <th colspan="4"></th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script>
  // Ensure moment available for modal (load order can vary)
  window.ensureMoment = function(fn) {
    if (typeof moment !== 'undefined') return fn();
    const s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js';
    s.onload = fn;
    document.head.appendChild(s);
  };
  // Parse date to YYYY-MM-DD (works without moment)
  window.parseToYmd = function(str) {
    if (window.MonthEndCutoffRange) {
      return window.MonthEndCutoffRange.toApiDate(str);
    }
    if (!str || !str.trim()) return '';
    const d = new Date(str.trim());
    if (isNaN(d.getTime())) return '';
    const y = d.getFullYear(), m = d.getMonth() + 1, day = d.getDate();
    return y + '-' + String(m).padStart(2, '0') + '-' + String(day).padStart(2, '0');
  };
  window.isDateSameOrBefore = function(dateStr, refDate) {
    const d = new Date(dateStr), r = refDate || new Date();
    if (isNaN(d.getTime())) return false;
    d.setHours(0,0,0,0); r.setHours(0,0,0,0);
    return d.getTime() <= r.getTime();
  };
  window.formatEncodedDate = function(dt) {
    if (!dt) return 'N/A';
    if (typeof moment !== 'undefined') return moment.utc(dt).utcOffset(8).format('YYYY-MM-DD HH:mm');
    const d = new Date(dt);
    return isNaN(d.getTime()) ? 'N/A' : (window.fmtDtUtc8 ? window.fmtDtUtc8(d, 'N/A') : 'N/A');
  };
</script>
