<div class="modal fade" id="modal-cash-balance-history" tabindex="-1" aria-labelledby="modal-cash-balance-label" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
        <div class="modal-header bg-primary ">
            <h5 class="block-title text-white" id="modal-cash-balance-label">Cash Balance History</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="cash-balance-date-range" value="">
            <div class="row mb-2">
          <div class="col-12">
            <div id="cash-balance-filter" class="filter-breadcrumb">
              <a href="#" class="filter-link active" data-type="all">All</a>
              <a href="#" class="filter-link" data-type="1">Cash-in</a>
              <a href="#" class="filter-link" data-type="2">Cash-out</a>
            </div>
          </div>
        </div>
        <div class="row mb-3">
          <div class="col-sm-5">
            <input type="text" id="cash-balance-daterange" class="form-control" placeholder="Select date range" readonly>
          </div>
        </div>
        <table id="cash-balance-history-tbl" class="table table-bordered table-responsive" style="font-size: 13px;">
          <thead>
            <tr>
              <th>Type</th>
              <th>Amount</th>
              <th>Remarks</th>
              <th>Encoded By</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<style>
.filter-breadcrumb {
  margin-top: 0.5rem;
  display: flex;
  gap: 0.5rem;
}
.filter-breadcrumb .filter-link {
  padding: 0.3rem 0.9rem;
  border-radius: 999px;
  border: 1px solid #6b4a12;
  color: #6b4a12;
  text-decoration: none;
  font-size: 0.85rem;
}
.filter-breadcrumb .filter-link.active {
  background: var(--gd-dash-jade, #6b4a12);
  border-color: var(--gd-dash-jade, #6b4a12);
  color: #fff;
}
#cash-balance-history-tbl td {
  padding: 12px 15px;
}
#cash-balance-history-tbl thead th {
  background: rgba(200, 162, 76, 0.07);
        background-image: none;
        color: #5c5346;
  font-weight: 500;
  border: none;
}
#cash-balance-history-tbl {
  width: 100%;
  border-collapse: collapse;
}
</style>

<script>
$(document).ready(function() {
  function jumpCashBalanceRangeToCurrentThreeMonths(instance) {
    if (!instance) return;
    const current = new Date();
    instance.jumpToDate(new Date(current.getFullYear(), current.getMonth() - 2, 1), false);
  }

  const picker = flatpickr("#cash-balance-daterange", {
    mode: "range",
    showMonths: 3,
    onReady: function(selectedDates, dateStr, instance) {
      jumpCashBalanceRangeToCurrentThreeMonths(instance);
    },
    onOpen: function(selectedDates, dateStr, instance) {
      jumpCashBalanceRangeToCurrentThreeMonths(instance);
    },
    onChange: function(selectedDates, dateStr) {
      if (selectedDates.length === 2) {
        loadCashBalanceHistory(getSelectedType());
      }
    }
  });

  function getSelectedType() {
    const selectedType = $('#cash-balance-filter .filter-link.active').data('type');
    return selectedType == null ? 'all' : String(selectedType);
  }

  function formatAmount(value, typeValue) {
    const n = parseFloat(value || 0);
    if (window.AmountFormat) {
      if (parseInt(typeValue, 10) === 2) {
        return window.AmountFormat.formatDirectionalAmount(n, 'out', { html: true });
      }
      if (parseInt(typeValue, 10) === 1) {
        return window.AmountFormat.formatCommas(n);
      }
      return window.AmountFormat.formatSignedAmount(n, { html: true });
    }
    return n.toLocaleString('en-US');
  }

  function getServiceCategories() {
    const categories = [];
    const $serviceOptions = $('#services-type option');
    if ($serviceOptions.length) {
      $serviceOptions.each(function () {
        const val = ($(this).val() || '').toString().trim();
        if (val) categories.push(val.toLowerCase());
      });
    }
    if (categories.length) return categories;
    return ['fnb', 'hotel', 'delivery'];
  }

  function loadCashBalanceHistory(type) {
    const range = $('#cash-balance-daterange').val();
    const apiRange = window.MonthEndCutoffRange
      ? window.MonthEndCutoffRange.resolveRangeFromPicker(range, 'cash-balance-daterange')
      : (() => {
          if (!range) return { start: '', end: '' };
          let [start, end] = range.split(' to ');
          if (!end) end = start;
          return { start, end };
        })();
    const start = apiRange.start;
    const end = apiRange.end;
    if (!start || !end) return;
    if ($.fn.DataTable.isDataTable('#cash-balance-history-tbl')) {
      $('#cash-balance-history-tbl').DataTable().destroy();
    }
    $('#cash-balance-history-tbl').DataTable({
      processing: false,
      serverSide: false,
      order: [[4, 'desc']],
      ajax: function(data, callback) {
        const urls = [];
        const ts = new Date().getTime();

        if (type === 'all' || type === '1') {
          urls.push(`/cash_in_details?start_date=${start}&end_date=${end}&${ts}`);
        }
        if (type === 'all' || type === '2') {
          urls.push(`/cash_out_details?start_date=${start}&end_date=${end}&${ts}`);
        }

        if (urls.length === 0) {
          callback({ data: [] });
          return;
        }

        const requests = urls.map(url =>
          $.getJSON(url).catch(err => {
            console.error('Failed to load cash details from', url, err);
            return [];
          })
        );

        Promise.all(requests)
          .then(results => {
            let combined = [];
            results.forEach(arr => {
              if (Array.isArray(arr)) combined = combined.concat(arr);
            });

            combined.sort((a, b) => {
              const aTime = a.ENCODED_DT ? new Date(a.ENCODED_DT).getTime() : 0;
              const bTime = b.ENCODED_DT ? new Date(b.ENCODED_DT).getTime() : 0;
              return bTime - aTime;
            });

            const mapped = combined.map(row => ({
              typeText: row.CATEGORY || (row.TYPE == 1 ? 'Cash-in' : 'Cash-out'),
              rawCategory: row.CATEGORY || '',
              amount: formatAmount(row.AMOUNT, row.TYPE),
              remarks: row.REMARKS || '',
              remarksEdit: row.REMARKS_EDIT != null ? row.REMARKS_EDIT : (row.REMARKS || ''),
              remarksSource: row.REMARKS_SOURCE || '',
              recordId: row.IDNo,
              encodedBy: row.ENCODED_BY_NAME || 'N/A',
              date: moment.utc(row.ENCODED_DT).utcOffset(8).format('YYYY-MM-DD HH:mm'),
              sortDate: row.ENCODED_DT ? moment.utc(row.ENCODED_DT).valueOf() : 0,
              typeValue: parseInt(row.TYPE, 10),
              serviceTransactionId: row.SERVICE_TRANSACTION_ID != null
                ? parseInt(row.SERVICE_TRANSACTION_ID, 10)
                : null
            }));

            callback({ data: mapped });
          })
          .catch(err => {
            console.error('Error loading cash balance history:', err);
            callback({ data: [] });
          });
      },
      columns: [
        { data: 'typeText', className: 'text-center' },
        { data: 'amount', className: 'text-end' },
        {
          data: 'remarks',
          className: 'text-start',
          render: function(data, type, row) {
            if (type !== 'display') return data;
            if (!window.RemarksEditor || !row.remarksSource || !row.recordId) return data || '';
            return window.RemarksEditor.renderCell(row.remarksEdit != null ? row.remarksEdit : (data || ''), {
              source: row.remarksSource,
              recordId: row.recordId,
              displayText: data || ''
            });
          }
        },
        { data: 'encodedBy', className: 'text-center' },
        {
          data: 'date',
          className: 'text-center',
          render: function(data, type, row) {
            if (type === 'sort' || type === 'type') return row && row.sortDate ? row.sortDate : 0;
            return data;
          }
        }
      ],
      createdRow(row, data) {
        const category = (data.rawCategory || data.typeText || '').toLowerCase().trim();
        const hasServiceTxnId = Number.isFinite(data.serviceTransactionId);
        if (hasServiceTxnId) {
          if (data.serviceTransactionId === 3) {
            $('td:eq(0), td:eq(1)', row).addClass('text-primary');
            return;
          }
          // game_services cash (1) / deposit (2): same coloring as other cash-in / cash-out rows
          if (data.typeValue === 1) {
            $('td:eq(0), td:eq(1)', row).addClass('text-success');
          } else if (data.typeValue === 2) {
            $('td:eq(0), td:eq(1)', row).addClass('text-danger');
          }
          return;
        }
        if (getServiceCategories().includes(category)) {
          if (data.typeValue === 1) {
            $('td:eq(0), td:eq(1)', row).addClass('text-success');
          } else if (data.typeValue === 2) {
            $('td:eq(0), td:eq(1)', row).addClass('text-danger');
          }
          return;
        }
        if (data.typeValue === 1) {
          $('td:eq(0), td:eq(1)', row).addClass('text-success');
        } else if (data.typeValue === 2) {
          $('td:eq(0), td:eq(1)', row).addClass('text-danger');
        }
      },
      responsive: true,
      language: {
        emptyTable: 'No cash transactions found',
        processing: 'Loading cash transactions...'
      }
    });
  }

  $(document).on('click', '#cash-balance-filter .filter-link', function(e) {
    e.preventDefault();
    $('#cash-balance-filter .filter-link').removeClass('active');
    $(this).addClass('active');
    loadCashBalanceHistory(getSelectedType());
  });

  $('#modal-cash-balance-history').on('shown.bs.modal', function() {
    loadCashBalanceHistory(getSelectedType());
  });
});
</script>

