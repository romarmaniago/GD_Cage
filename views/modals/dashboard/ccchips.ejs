<div class="modal fade" id="modal-new-cc-chips" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="modal-default-popout" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white"><%= __('modal_cc_chips_history.title') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-4">
                        <input type="text" id="ccchips-daterange" name="ccchips-daterange" class="form-control"
                            placeholder="<%= __('modal_cc_chips_history.select_date_range') %>" autocomplete="off" />
                    </div>
                </div>

                <hr style="border: none; border-top: 0.2rem solid black;">
                
                <table id="cc-chips-tbl" class="table table-bordered table-responsive"
                    style="font-size: 13px !important;">
                    <thead>
                        <tr>
                            <th><%= __('dashboard_total_chips.encoded_by') %></th>
                            <th><%= __('dashboard_total_chips.amount') %></th>
                            <th><%= __('dashboard_total_chips.type') %></th>
                            <th><%= __('dashboard_total_chips.remarks') %></th>
                            <th><%= __('dashboard_total_chips.date') %></th>
                            <th><%= __('dashboard_total_chips.action') %></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('dashboard_total_chips.close') %></button>
            </div>
        </div>
    </div>
</div>
<script>
window.ccChipsHistoryTranslations = {
	please_select_date_range: "<%= __('modal_cc_chips_history.please_select_date_range') %>",
	empty_table: "<%= __('modal_cc_chips_history.empty_table') %>",
	processing: "<%= __('modal_cc_chips_history.processing') %>",
	length_menu: "<%= __('modal_cc_chips_history.length_menu') %>",
	search: "<%= __('modal_cc_chips_history.search') %>",
	info: "<%= __('modal_cc_chips_history.info') %>",
	info_empty: "<%= __('modal_cc_chips_history.info_empty') %>",
	info_filtered: "<%= __('modal_cc_chips_history.info_filtered') %>",
	first: "<%= __('modal_cc_chips_history.first') %>",
	last: "<%= __('modal_cc_chips_history.last') %>",
	previous: "<%= __('modal_cc_chips_history.previous') %>",
	next: "<%= __('modal_cc_chips_history.next') %>"
};
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>

<style>
    .modal-lg {
        max-width: 50% !important;
        /* Adjust percentage as needed */
    }

    #cc-chips-tbl {
        width: 100%;
        font-size: 13px;
        border-collapse: collapse;
    }

    /* Header styles */
    #cc-chips-tbl thead th {
        background: #f0dfa8;
        color: #6b4f14;
        font-weight: 500;
        padding: 12px 15px;
        text-align: left;
        border: none;
    }

    /* Row styles */
    #cc-chips-tbl tbody tr {
        border-bottom: 1px solid #eee;
    }

    /* Cell styles */
    #cc-chips-tbl td {
        padding: 12px 15px;
        color: #666;
    }

    #cc-chips-tbl tbody tr:hover {
        background-color: #f5f5f5 !important;
    }

    /* Balance column */
    #cc-chips-tbl td:last-child {
        text-align: right;
        color: #333;
    }

    /* Footer total row */
    #cc-chips-tbl tfoot th {
        padding: 10px;
        font-weight: 600;
        color: #333;
        background-color: #f4f6fa;
        border-top: 2px solid #dee2e6;
    }
</style>
