<div class="modal fade" id="modal-new-cc-chips" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="modal-default-popout" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white"><%= __('modal_cc_chips_history.title') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="house-expense-daterange-wrap mb-3">
                    <input type="text" id="ccchips-daterange" name="ccchips-daterange"
                        class="form-control form-control-sm text-center"
                        placeholder="<%= __('modal_cc_chips_history.select_date_range') %>" autocomplete="off" />
                </div>

                <hr style="border: none; border-top: 0.2rem solid black;">
                
                <table id="cc-chips-tbl" class="table table-bordered table-responsive"
                    style="font-size: 13px !important;">
                    <thead>
                        <tr>
                            <th><%= __('dashboard_total_chips.encoded_by') %></th>
                            <th><%= __('dashboard_total_chips.amount') %></th>
                            <th><%= __('dashboard_total_chips.type') %></th>
                            <th><%= __('dashboard_total_chips.remarks') %></th>
                            <th><%= __('dashboard_total_chips.date') %></th>
                            <th><%= __('dashboard_total_chips.action') %></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('dashboard_total_chips.close') %></button>
            </div>
        </div>
    </div>
</div>
<script>
window.ccChipsHistoryTranslations = {
	please_select_date_range: "<%= __('modal_cc_chips_history.please_select_date_range') %>",
	empty_table: "<%= __('modal_cc_chips_history.empty_table') %>",
	processing: "<%= __('modal_cc_chips_history.processing') %>",
	length_menu: "<%= __('modal_cc_chips_history.length_menu') %>",
	search: "<%= __('modal_cc_chips_history.search') %>",
	info: "<%= __('modal_cc_chips_history.info') %>",
	info_empty: "<%= __('modal_cc_chips_history.info_empty') %>",
	info_filtered: "<%= __('modal_cc_chips_history.info_filtered') %>",
	first: "<%= __('modal_cc_chips_history.first') %>",
	last: "<%= __('modal_cc_chips_history.last') %>",
	previous: "<%= __('modal_cc_chips_history.previous') %>",
	next: "<%= __('modal_cc_chips_history.next') %>"
};
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>

<style>
    .modal-lg {
        max-width: 50% !important;
    }

    #modal-new-cc-chips {
        --gd-marker-gold-solid: rgba(200, 162, 76, 0.07);
        --gd-marker-gold-text: #4a3208;
        --gd-marker-gold-border: rgba(200, 162, 76, 0.28);
        --gd-marker-gold-hover: #f6f3ec;
    }

    #cc-chips-tbl {
        width: 100%;
        font-size: 13px;
        border-collapse: collapse;
        border: 1px solid var(--gd-marker-gold-border);
    }

    /* Cream controls bar (length + search) */
    #cc-chips-tbl_wrapper > .row:has(.dataTables_length),
    #cc-chips-tbl_wrapper > .row:has(.dataTables_filter) {
        background: var(--gd-marker-gold-hover);
        border: 1px solid var(--gd-marker-gold-border);
        border-bottom: 0;
        border-radius: 10px 10px 0 0;
        padding: 8px 12px;
        margin-left: 0;
        margin-right: 0;
        margin-bottom: -1px;
        align-items: center;
    }

    #cc-chips-tbl_wrapper #cc-chips-tbl {
        margin-top: 0 !important;
    }

    /* Header styles */
    #cc-chips-tbl thead tr {
        background-color: var(--gd-marker-gold-solid);
    }
    #cc-chips-tbl thead th {
        background: transparent !important;
        color: var(--gd-marker-gold-text) !important;
        font-weight: 600;
        padding: 12px 15px;
        text-align: left;
        border: none;
        border-bottom: 1px solid var(--gd-marker-gold-border);
        box-shadow: none !important;
    }

    #cc-chips-tbl.dataTable thead > tr > th.sorting,
    #cc-chips-tbl.dataTable thead > tr > th.sorting_asc,
    #cc-chips-tbl.dataTable thead > tr > th.sorting_desc,
    #cc-chips-tbl.dataTable thead > tr > th.sorting_disabled {
        background: transparent !important;
        background-color: transparent !important;
    }

    /* Row styles */
    #cc-chips-tbl tbody tr {
        border-bottom: 1px solid #eee;
    }

    #cc-chips-tbl tbody tr:nth-child(even) td {
        background-color: #f4f1ea;
    }

    /* Cell styles */
    #cc-chips-tbl td {
        padding: 12px 15px;
        color: #666;
    }

    #cc-chips-tbl tbody tr:hover,
    #cc-chips-tbl tbody tr:hover td {
        background-color: var(--gd-marker-gold-hover) !important;
    }

    /* Balance column */
    #cc-chips-tbl td:last-child {
        text-align: right;
        color: #333;
    }

    /* Footer total row */
    #cc-chips-tbl tfoot th {
        padding: 10px;
        font-weight: 600;
        color: var(--gd-marker-gold-text);
        background-color: transparent;
        border-top: 2px solid var(--gd-marker-gold-border);
        border-bottom: 1px solid var(--gd-marker-gold-border);
    }

    /* Pagination colors */
    #modal-new-cc-chips .dataTables_paginate .page-link {
        border-color: var(--gd-marker-gold-border) !important;
        color: var(--gd-marker-gold-text) !important;
        background-color: #fff !important;
    }
    #modal-new-cc-chips .dataTables_paginate .page-item.active .page-link {
        background-color: var(--gd-marker-gold-solid) !important;
        border-color: var(--gd-marker-gold-solid) !important;
        color: var(--gd-marker-gold-text) !important;
    }
    #modal-new-cc-chips .dataTables_paginate .page-link:hover {
        background-color: var(--gd-marker-gold-hover) !important;
        border-color: var(--gd-marker-gold-border) !important;
        color: var(--gd-marker-gold-text) !important;
    }
    #modal-new-cc-chips .dataTables_paginate .page-item.disabled .page-link {
        color: rgba(200, 162, 76, 0.4) !important;
        border-color: var(--gd-marker-gold-border) !important;
        background-color: #fff !important;
    }
</style>
