<div class="modal fade" id="modal-dash-hotel" tabindex="-1" aria-labelledby="modal-dash-hotel-label" aria-hidden="true" data-bs-backdrop="static">
	<div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white" id="modal-dash-hotel-label"><%= __('fnb_hotel.hotel') %></h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body dash-service-modal-body">
				<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
					<input type="text" id="dash-hotel-daterange" class="form-control form-control-sm dash-service-daterange" placeholder="<%= __('fnb_hotel.date') %>" autocomplete="off" readonly>
				</div>
				<div class="table-responsive dash-service-table-panel">
					<%- include('../../partials/dash_service_add_button', { buttonId: 'btn-dash-hotel-new-record', title: __('fnb_hotel.new_record') }) %>
					<table id="dash-hotel-table" class="table nowrap small-text mb-0 dash-service-tbl" style="width:100%">
						<thead>
							<tr>
								<th><%= __('fnb_hotel.program_date') || 'Program Date' %></th>
								<th><%= __('fnb_hotel.date') %></th>
								<th><%= __('fnb_hotel.agent') %></th>
								<th><%= __('fnb_hotel.guest') || 'Guest' %></th>
								<th><%= __('fnb_hotel.type') || 'Type' %></th>
								<th><%= __('fnb_hotel.amount') %></th>
								<th><%= __('fnb_hotel.payment') %></th>
								<th><%= __('fnb_hotel.remarks') %></th>
								<th><%= __('fnb_hotel.action') %></th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('fnb_hotel.close') %></button>
			</div>
		</div>
	</div>
</div>
