<div class="modal fade" id="modal-dash-wl-remarks" tabindex="-1" aria-labelledby="modal-dash-wl-remarks-label" aria-hidden="true" data-bs-backdrop="static" data-bs-focus="false">
   <div class="modal-dialog modal-dialog-centered modal-md">
      <div class="modal-content">
         <div class="modal-header bg-primary py-2">
            <h5 class="modal-title text-white mb-0" id="modal-dash-wl-remarks-label">W/L Remarks</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
         </div>
         <form id="dash-wl-remarks-form">
            <div class="modal-body py-3">
               <input type="hidden" id="dash-wl-remarks-date-iso">
               <div class="mb-3">
                  <label for="dash-wl-remarks-date" class="form-label small text-muted mb-1">Date</label>
                  <input type="text" class="form-control form-control-sm dash-wl-remarks-date-display" id="dash-wl-remarks-date" readonly tabindex="-1" value="—">
               </div>
               <div class="mb-0">
                  <label for="dash-wl-remarks-text" class="form-label small text-muted mb-1">Remarks</label>
                  <textarea class="form-control form-control-sm" id="dash-wl-remarks-text" rows="3" maxlength="500" placeholder="Enter remarks..."></textarea>
               </div>
            </div>
            <div class="modal-footer py-2">
               <button type="submit" class="btn btn-sm btn-primary">Save</button>
               <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
         </form>
      </div>
   </div>
</div>
