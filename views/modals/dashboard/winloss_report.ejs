<div class="modal fade" id="modal-dash-winloss-report" tabindex="-1" aria-labelledby="modal-dash-winloss-report-label" aria-hidden="true" data-bs-backdrop="static" data-report-mode="winloss">
  <div class="modal-dialog modal-xl modal-dialog-centered dash-winloss-report-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary py-2">
        <h5 class="modal-title text-white mb-0" id="modal-dash-winloss-report-label">Winloss Report</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0">
        <div class="daily-report-winloss-panel">
          <div class="daily-report-winloss-toolbar border-bottom px-3 py-2 d-flex justify-content-end align-items-center flex-wrap gap-2">
            <%- include('../../partials/daily_report_winloss_toolbar') %>
          </div>
          <div class="daily-report-winloss-body card-body pt-2 pb-3">
            <%- include('../../partials/daily_report_winloss_body') %>
          </div>
        </div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
