<div class="modal fade" id="modal-dash-soa-fnb-hotel" tabindex="-1" aria-labelledby="modal-dash-soa-fnb-hotel-label" aria-hidden="true" data-bs-backdrop="static" data-bs-focus="false">
  <div class="modal-dialog modal-dialog-centered modal-dash-soa-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary py-2">
        <h5 class="modal-title text-white mb-0" id="modal-dash-soa-fnb-hotel-label">SOA (F&amp;B, Hotel)</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form id="dash-soa-fnb-hotel-form">
        <div class="modal-body py-3">
          <input type="hidden" id="dash-soa-date-from">
          <input type="hidden" id="dash-soa-date-to">

          <div class="soa-add-row mb-3">
            <div class="soa-add-field soa-add-program-date">
              <label for="dash-soa-program-date" class="form-label small text-muted mb-1">Program Date</label>
              <input type="text" class="form-control form-control-sm" id="dash-soa-program-date" placeholder="YYYY/MM/DD" autocomplete="off" spellcheck="false" required>
            </div>
            <div class="soa-add-field soa-add-category">
              <label for="dash-soa-category" class="form-label small text-muted mb-1">Service Category</label>
              <input type="text" class="form-control form-control-sm" id="dash-soa-category" placeholder="e.g. F&amp;B, Hotel" maxlength="100" autocomplete="off" required>
            </div>
            <div class="soa-add-field soa-add-amount">
              <label for="dash-soa-amount" class="form-label small text-muted mb-1">Amount</label>
              <input type="text" class="form-control form-control-sm" id="dash-soa-amount" placeholder="0" inputmode="numeric" autocomplete="off" required>
            </div>
            <div class="soa-add-field soa-add-remarks">
              <label for="dash-soa-remarks" class="form-label small text-muted mb-1">Remarks</label>
              <input type="text" class="form-control form-control-sm soa-remarks-input" id="dash-soa-remarks" name="soa_remarks" placeholder="Any remarks" maxlength="500" autocomplete="off" spellcheck="true">
            </div>
            <div class="soa-add-field soa-add-save">
              <label class="form-label small text-muted mb-1">&nbsp;</label>
              <button type="submit" class="btn btn-sm btn-primary" id="btn-dash-soa-save">Save</button>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-sm table-bordered table-striped mb-0" id="dash-soa-history-tbl">
              <thead>
                <tr>
                  <th class="soa-col-program-date">Program Date</th>
                  <th class="soa-col-category">Service Category</th>
                  <th class="soa-col-amount text-end">Amount</th>
                  <th class="soa-col-remarks">Remarks</th>
                  <th class="soa-col-action text-center">Action</th>
                </tr>
              </thead>
              <tbody id="dash-soa-history-body">
                <tr>
                  <td colspan="5" class="text-muted text-center py-3">Loading...</td>
                </tr>
              </tbody>
              <tfoot id="dash-soa-history-foot">
                <tr class="soa-total-row">
                  <th colspan="2" class="soa-total-label">TOTAL</th>
                  <th class="soa-col-amount text-end" id="dash-soa-history-total">0</th>
                  <th colspan="2" class="soa-total-rest"></th>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

        <div class="modal-footer py-2">
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-dash-soa-fnb-hotel-edit" tabindex="-1" aria-labelledby="modal-dash-soa-fnb-hotel-edit-label" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header bg-primary py-2">
        <h5 class="modal-title text-white mb-0" id="modal-dash-soa-fnb-hotel-edit-label">Edit SOA Entry</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="dash-soa-edit-form">
        <div class="modal-body py-3">
          <input type="hidden" id="dash-soa-edit-id">
          <div class="mb-2">
            <label for="dash-soa-edit-program-date" class="form-label small text-muted mb-1">Program Date</label>
            <input type="text" class="form-control form-control-sm" id="dash-soa-edit-program-date" placeholder="YYYY/MM/DD" autocomplete="off" spellcheck="false" required>
          </div>
          <div class="mb-2">
            <label for="dash-soa-edit-category" class="form-label small text-muted mb-1">Service Category</label>
            <input type="text" class="form-control form-control-sm" id="dash-soa-edit-category" placeholder="e.g. F&amp;B, Hotel" maxlength="100" autocomplete="off" required>
          </div>
          <div class="mb-2">
            <label for="dash-soa-edit-amount" class="form-label small text-muted mb-1">Amount</label>
            <input type="text" class="form-control form-control-sm" id="dash-soa-edit-amount" placeholder="0" inputmode="numeric" autocomplete="off" required>
          </div>
          <div>
            <label for="dash-soa-edit-remarks" class="form-label small text-muted mb-1">Remarks</label>
            <input type="text" class="form-control form-control-sm soa-remarks-input" id="dash-soa-edit-remarks" name="soa_edit_remarks" placeholder="Any remarks" maxlength="500" autocomplete="off" spellcheck="true">
          </div>
        </div>
        <div class="modal-footer py-2">
          <button type="submit" class="btn btn-sm btn-primary">Save</button>
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>
