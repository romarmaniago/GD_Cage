<div class="modal fade" id="modal-dash-soa-fnb-hotel" tabindex="-1" aria-labelledby="modal-dash-soa-fnb-hotel-label" aria-hidden="true" data-bs-backdrop="static" data-bs-focus="false">
  <div class="modal-dialog modal-dialog-centered soa-sheet-dialog">
    <div class="modal-content soa-sheet-content">
      <%# Everything inside #dash-soa-sheet is what "Copy image" captures. %>
      <div class="soa-sheet" id="dash-soa-sheet">
        <div class="soa-sheet-header">
          <span id="modal-dash-soa-fnb-hotel-label">SOA (F&amp;B, HOTEL)</span>
          <button type="button" class="soa-sheet-close" data-bs-dismiss="modal" aria-label="Close">X</button>
        </div>
        <table class="soa-sheet-table" id="dash-soa-history-tbl">
          <colgroup>
            <col class="soa-c-label">
            <col class="soa-c-amount">
            <col class="soa-c-remarks">
          </colgroup>
          <tbody>
            <tr class="soa-pd-row">
              <td colspan="3" class="soa-pd-cell">
                <span class="soa-pd-label">Program Date:</span>
                <span class="soa-pd-value" id="dash-soa-period-label"></span>
              </td>
            </tr>
            <tr class="soa-band-row">
              <td colspan="3">SOA (F&amp;B, HOTEL, INCIDENTAL)</td>
            </tr>
          </tbody>
          <tbody id="dash-soa-history-body">
            <tr class="soa-msg-row"><td colspan="3">Loading...</td></tr>
          </tbody>
          <tbody>
            <tr class="soa-total-row">
              <td class="soa-label">TOTAL</td>
              <td class="soa-amount" id="dash-soa-history-total">0</td>
              <td class="soa-remarks">TOTAL</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="soa-sheet-actions">
        <button type="button" class="btn soa-sheet-copy-btn" id="btn-dash-soa-copy-image">Copy Image</button>
        <button type="button" class="btn soa-sheet-copy-btn" id="btn-dash-soa-copy-text">Copy Text</button>
      </div>
    </div>
  </div>
</div>
