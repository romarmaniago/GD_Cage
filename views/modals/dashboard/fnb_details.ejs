<div class="modal fade" id="modal-dash-fnb" tabindex="-1" aria-labelledby="modal-dash-fnb-label" aria-hidden="true" data-bs-backdrop="static">
	<div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white" id="modal-dash-fnb-label"><%= __('fnb_hotel.fnb') %></h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body dash-service-modal-body">
				<div class="dash-service-daterange-group d-flex flex-wrap align-items-center gap-2 mb-3">
					<div class="dash-service-daterange-wrap">
						<input type="text" id="dash-fnb-daterange" class="form-control form-control-sm dash-service-daterange text-center" placeholder="<%= __('fnb_hotel.date') %>" autocomplete="off" readonly>
					</div>
					<%- include('../../partials/split_daterange', {
						splitPrefix: 'dash-fnb',
						splitLocaleNs: 'house_expense',
						splitWrapClass: 'dash-service-daterange-wrap dash-service-split-daterange house-expense-split-daterange'
					}) %>
				</div>
				<div class="table-responsive dash-service-table-panel">
					<%- include('../../partials/dash_service_add_button', { buttonId: 'btn-dash-fnb-new-record', title: __('fnb_hotel.new_record'), servicePreset: 'F & B' }) %>
					<table id="dash-fnb-table" class="table nowrap small-text mb-0 dash-service-tbl" style="width:100%">
						<thead>
							<tr>
								<th><%= __('fnb_hotel.program_date') || 'Program Date' %></th>
								<th><%= __('fnb_hotel.date') %></th>
								<th><%= __('fnb_hotel.agent') %></th>
								<th><%= __('fnb_hotel.guest') || 'Guest' %></th>
								<th><%= __('fnb_hotel.type') || 'Type' %></th>
								<th><%= __('fnb_hotel.amount') %></th>
								<th><%= __('fnb_hotel.payment') %></th>
								<th><%= __('fnb_hotel.remarks') %></th>
								<th><%= __('fnb_hotel.action') %></th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('fnb_hotel.close') %></button>
			</div>
		</div>
	</div>
</div>

<style>
.dash-service-modal-body {
	--gd-marker-gold-solid: rgba(200, 162, 76, 0.07);
	--gd-marker-gold-text: #4a3208;
	--gd-marker-gold-border: rgba(200, 162, 76, 0.28);
	--gd-marker-gold-hover: #f6f3ec;
}
.dash-service-daterange {
	max-width: 260px;
	background: #fff;
	border: 1px solid rgba(200, 162, 76, 0.22);
	border-radius: 8px;
	text-align: center;
}
.dash-service-table-panel {
	border: 1px solid var(--gd-marker-gold-border);
	border-radius: 10px;
	overflow: hidden;
}
.dash-service-tbl {
	border-collapse: collapse !important;
}
.dash-service-tbl thead tr {
	background-color: var(--gd-marker-gold-solid);
}
.dash-service-tbl thead th {
	background: transparent !important;
	color: var(--gd-marker-gold-text);
	font-weight: 600;
	padding: 10px 12px;
	border: none !important;
	border-bottom: 1px solid var(--gd-marker-gold-border) !important;
	box-shadow: none !important;
}
.dash-service-tbl thead th:nth-child(6),
.dash-service-tbl tbody td:nth-child(6) {
	text-align: right !important;
	padding-right: 16px;
}
.dash-service-tbl tbody td {
	padding: 10px 12px;
	vertical-align: middle;
	color: #666;
	border-bottom: 1px solid #eee;
}
.dash-service-tbl tbody tr:nth-child(even) td {
	background-color: #f4f1ea;
}
.dash-service-tbl tbody tr:hover,
.dash-service-tbl tbody tr:hover td {
	background-color: var(--gd-marker-gold-hover) !important;
}

/* Action column header centered */
#modal-dash-fnb #dash-fnb-table thead th:nth-child(9) {
	text-align: center;
}

/* Action column: drop button backgrounds, colour the icons instead */
#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.3rem;
	flex-wrap: nowrap;
}

#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn,
#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn:hover,
#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn:focus,
#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn:focus-visible,
#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn:active,
#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn.bg-info-subtle,
#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn.bg-danger-subtle,
#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn.bg-warning-subtle {
	background: transparent !important;
	background-color: transparent !important;
	background-image: none !important;
	border-color: transparent !important;
	box-shadow: none !important;
	outline: none !important;
	color: inherit !important;
	margin: 0;
	padding: 0.15rem 0.1rem;
	--bs-btn-bg: transparent;
	--bs-btn-hover-bg: transparent;
	--bs-btn-active-bg: transparent;
	--bs-btn-border-color: transparent;
}

#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn i.fa {
	font-size: 1.2rem;
	color: #64748b;
	transition: color 0.15s ease, transform 0.15s ease;
}

#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn:hover i.fa {
	transform: translateY(-1px);
	filter: brightness(0.82);
}

#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn i.fa-receipt {
	color: #212529;
}

#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn i.fa-pencil-alt {
	color: #d97706;
}

#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn i.fa-trash-alt {
	color: #dc2626;
}

#modal-dash-fnb #dash-fnb-table tbody td:last-child .btn-group .btn i.fa-info-circle {
	color: #d97706;
}

/* Remarks: truncate long text, full text via hover tooltip */
#modal-dash-fnb #dash-fnb-table thead th:nth-child(8),
#modal-dash-fnb #dash-fnb-table tbody td:nth-child(8) {
	max-width: 240px;
}

#modal-dash-fnb #dash-fnb-table tbody td:nth-child(8) .remarks-editor-cell,
#modal-dash-fnb #dash-fnb-table tbody td:nth-child(8) .remarks-editor-text {
	display: block;
	max-width: 240px;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.remarks-editor-tip .tooltip-inner {
	max-width: 380px;
	font-size: 0.8125rem;
	line-height: 1.35;
	text-align: left;
	padding: 0.4rem 0.6rem;
	white-space: pre-wrap;
}
</style>
