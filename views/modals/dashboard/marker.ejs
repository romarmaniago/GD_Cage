<div class="modal fade" id="modal-new-marker" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg2" role="document">
        <div class="modal-content">
        <div class="modal-header bg-primary">
            <h5 class="modal-title text-white" id="staticBackdropLiveLabel"><%= __('dashboard_marker.title') %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="add_marker_settlement" action="/" method="POST">
        <div class="modal-body">
             <div class="marker-history-layout">
                <div class="marker-history-sidebar">
                <div id="core-container">
                <input type="hidden" id="AgentBalance" name="AgentBalance">
                <input type="hidden" id="txtTotalBalanceGuest" name="totalBalanceGuest" />
                <input type="hidden" id="optFormModeHidden" name="optFormMode" value="" />
                <input type="hidden" id="optTransTypeHidden" name="optTransType" value="" />
                <div id="marker-form-fields-wrap">
                <div id="marker-return-source-wrap" class="d-none" aria-hidden="true">
                    <input type="radio" name="optReturnSource" id="return-source-credit" value="credit" />
                    <input type="radio" name="optReturnSource" id="return-source-buyin" value="buyin" />
                </div>
                <div class="mb-2">
                    <label class="form-label text-muted small mb-1"><%= __('dashboard_marker.program_date') %></label>
                    <input type="text" class="form-control" name="txtProgramDate" id="txtCreditProgramDate" required autocomplete="off" placeholder="YYYY-MM-DD" style="width: 100%;" />
                </div>
                <div class="mb-2">
                    <label class="form-label text-muted small"><%= __('dashboard_marker.account') %></label>
                    <select class="js-select2 form-select" name="txtAccountMarker" id="txtAccountMarker" style="width: 100%;" data-placeholder="<%= __('dashboard_marker.choose_account') %>">
                        <option value=""><%= __('dashboard_marker.choose_account') %></option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label text-muted small"><%= __('dashboard_marker.guest') %></label>
                    <select class="js-select2 form-select" name="txtGuestId" id="txtGuestMarker" style="width: 100%;" data-placeholder="<%= __('dashboard_marker.select_guest_optional') %>" disabled>
                        <option value=""><%= __('dashboard_marker.select_guest_optional') %></option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label text-muted small" id="lbl-marker-amount"><%= __('dashboard_marker.amount') %></label>
                    <input type="text" class="form-control" name="txtMarkerReturn" id="txtMarkerReturn" required autocomplete="off" inputmode="decimal" />
                </div>
                <div class="mb-2">
                    <label class="form-label text-muted small" for="txtGuarantor"><%= __('dashboard_marker.guarantor') %></label>
                    <input type="text" class="form-control" name="txtGuarantor" id="txtGuarantor" required autocomplete="off" placeholder="<%= __('dashboard_marker.guarantor') %>" />
                </div>
                <div class="mb-2">
                    <label class="form-label text-muted small d-block"><%= __('dashboard_marker.credit_action') %></label>
                    <div class="d-flex flex-wrap align-items-center gap-3 gap-md-4 pt-1" id="marker-credit-action-wrap">
                        <div class="form-check mb-0">
                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="credit-action-return-deposit-modal" name="optCreditAction" value="return_deposit" />
                            <label class="form-check-label" for="credit-action-return-deposit-modal"><%= __('dashboard_marker.credit_action_return_deposit') %></label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="credit-action-game-credit-modal" name="optCreditAction" value="game_credit" />
                            <label class="form-check-label" for="credit-action-game-credit-modal"><%= __('dashboard_marker.credit_action_game_credit') %></label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="credit-action-return-cash-modal" name="optCreditAction" value="return_cash" />
                            <label class="form-check-label" for="credit-action-return-cash-modal"><%= __('dashboard_marker.credit_action_return_cash') %></label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="credit-action-cash-credit-modal" name="optCreditAction" value="cash_credit" />
                            <label class="form-check-label" for="credit-action-cash-credit-modal"><%= __('dashboard_marker.credit_action_cash_credit') %></label>
                        </div>
                    </div>
                </div>
                <div class="d-none" id="marker-issue-balance-row" aria-hidden="true">
                    <div id="marker-issue-field-wrap">
                        <input type="hidden" name="txtMarkerIssue" id="txtMarkerIssue" />
                    </div>
                    <div id="marker-balance-field-wrap">
                        <input type="hidden" name="txtMarkerBalance" id="txtMarkerBalance" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label text-muted small"><%= __('dashboard_marker.remarks_optional') %></label>
                    <input type="text" class="form-control" name="remarks" id="txtRemarks" maxlength="500" autocomplete="off" />
                </div>
                <div id="marker-return-trans-type-wrap" class="d-none" aria-hidden="true"></div>
                <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
                    <div class="d-flex justify-content-start align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-success d-none" id="btn-credits-game-start">
                            <%= __('dashboard_marker.game_start') %>
                        </button>
                        <button id="submit_marker_settlement" type="submit" class="btn btn-sm btn-primary">
                            <%= __('dashboard_marker.save') %>
                        </button>
                    </div>
                </div>
                </div>
            </div>
                </div>

                <div class="marker-history-main">
            <div id="marker-history-wrapper" class="mb-3">
                <div class="marker-credit-card marker-credit-card--wide">
                    <div class="marker-history-toolbar" id="marker-history-toolbar">
                        <div class="marker-history-toolbar-left">
                            <span id="marker-history-length-slot" class="marker-history-length-slot"></span>
                            <div class="marker-date-nav" id="marker-date-nav">
                                <input type="text" id="marker-date-picker" class="marker-date-nav-input" autocomplete="off" />
                            </div>
                            <div class="marker-status-toggle" id="marker-status-toggle">
                                <button type="button" id="btn-marker-status-oncredit" class="marker-status-toggle-btn" data-status="on_credit"><%= __('dashboard_marker.on_credit') %></button>
                                <button type="button" id="btn-marker-status-finished" class="marker-status-toggle-btn" data-status="finished"><%= __('dashboard_marker.finished_credit') %></button>
                            </div>
                        </div>
                        <div class="marker-history-toolbar-right">
                            <button type="button" class="btn btn-sm marker-history-btn-print marker-credit-export" title="Print">Print</button>
                            <button type="button" id="export-excel" class="btn btn-sm marker-credit-export"><%= __('dashboard_marker.export') %></button>
                            <span id="marker-history-search-slot" class="marker-history-search-slot"></span>
                        </div>
                    </div>
                <div class="marker-history-dt-wrap marker-history-card table-responsive">
                <table id="marker-tbl" class="table marker-history-table w-100 mb-0">
                <thead>
                    <tr>
                        <th class="d-none d-sm-table-cell text-center"><%= __('dashboard_marker.date_time') %></th>
                        <th class="d-none d-sm-table-cell"><%= __('dashboard_marker.account') %></th>
                        <th class="d-none d-sm-table-cell"><%= __('dashboard_marker.name') %></th>
                        <th class="d-none d-sm-table-cell text-end marker-history-col-amount"><%= __('dashboard_marker.credit') %></th>
                        <th class="d-none d-sm-table-cell text-end marker-history-col-amount"><%= __('dashboard_marker.credit_total') %></th>
                        <th class="d-none d-sm-table-cell"><%= __('dashboard_marker.guarantor') %></th>
                        <th class="d-none d-sm-table-cell text-end marker-history-col-amount"><%= __('dashboard_marker.balance') %></th>
                        <th class="d-none d-sm-table-cell text-center"><%= __('dashboard_marker.action') %></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
                </table>
                </div>
                </div>
            </div>
                </div>

                <div class="marker-history-summary">
                    <div class="marker-credit-card">
                        <div class="marker-history-summary-head">
                            <span><%= __('dashboard_marker.total_credit_title') %></span>
                            <span class="marker-history-summary-grand-total" id="marker-credit-summary-grand-total">0</span>
                            <button type="button" class="btn btn-sm marker-credit-export marker-history-summary-copy-btn" id="btn-marker-credit-summary-copy" title="Copy as image">Copy</button>
                        </div>
                        <div class="marker-balance-dt-wrap table-responsive">
                            <table class="table nowrap small-text mb-0" id="marker-credit-summary-tbl">
                                <thead>
                                    <tr>
                                        <th><%= __('dashboard_marker.account') %></th>
                                        <th><%= __('dashboard_marker.name') %></th>
                                        <th class="text-end marker-history-col-amount"><%= __('dashboard_marker.credit') %></th>
                                        <th><%= __('dashboard_marker.remarks') %></th>
                                    </tr>
                                </thead>
                                <tbody id="marker-credit-summary-body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </form>
    </div>
    </div>

    <style>
        /* GD gold table theme — match Credit History page */
        #modal-new-marker {
            --gd-marker-gold-solid: rgba(200, 162, 76, 0.07);
            --gd-marker-gold-text: #4a3208;
            --gd-marker-gold-border: rgba(200, 162, 76, 0.28);
            --gd-marker-gold-hover: #f6f3ec;
        }

        .modal-lg2 {
            max-width: min(99vw, 130rem) !important;
            width: 100%;
            margin-left: auto;
            margin-right: auto;
        }

        #modal-new-marker .modal-body {
            min-width: 0;
        }

        #modal-new-marker #marker-history-wrapper {
            min-width: 0;
            max-width: 100%;
        }

        /* Sidebar (Add/Return Credit form) + main (toolbar + table) + summary (Total Credit) layout */
        #modal-new-marker .marker-history-layout {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }
        #modal-new-marker .marker-history-sidebar {
            flex: 0 0 280px;
            max-width: 280px;
        }
        #modal-new-marker .marker-history-main {
            flex: 1 1 auto;
            min-width: 0;
        }
        #modal-new-marker .marker-history-summary {
            flex: 0 0 520px;
            max-width: 520px;
        }
        @media (max-width: 1200px) {
            #modal-new-marker .marker-history-layout {
                flex-wrap: wrap;
            }
            #modal-new-marker .marker-history-summary {
                flex: 1 1 100%;
                max-width: 100%;
                order: 3;
            }
        }
        @media (max-width: 900px) {
            #modal-new-marker .marker-history-layout {
                flex-direction: column;
            }
            #modal-new-marker .marker-history-sidebar {
                flex: 1 1 auto;
                max-width: 100%;
            }
        }

        #modal-new-marker .marker-history-summary-head {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.15rem;
            padding: 0.6rem 0.75rem;
            background: linear-gradient(180deg, #f7f4ec 0%, #efe6d2 100%);
            border-bottom: 2px solid #c8a24c;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            color: #4a3208;
        }
        #modal-new-marker .marker-history-summary-grand-total {
            font-size: 1.35rem;
            font-weight: 700;
            color: #dc3545;
            font-variant-numeric: tabular-nums;
            text-transform: none;
            letter-spacing: normal;
        }
        #modal-new-marker .marker-history-summary-copy-btn {
            position: absolute;
            top: 0.5rem;
            right: 0.6rem;
            margin-top: 0;
        }
        #modal-new-marker #marker-credit-summary-tbl thead th {
            color: #555 !important;
            font-weight: 600;
            font-size: 0.7rem;
            letter-spacing: 0.02em;
            text-transform: uppercase;
            padding: 0.5rem 0.6rem;
            text-align: left;
            border-bottom: 1px solid #e0e0e0 !important;
            background: #f5f5f5 !important;
            white-space: nowrap;
        }
        #modal-new-marker #marker-credit-summary-tbl tbody td {
            padding: 0.5rem 0.6rem;
            color: #666;
            border-bottom: 1px solid #eee;
            white-space: nowrap;
            font-size: 0.95rem;
        }
        #modal-new-marker #marker-credit-summary-tbl tbody tr:nth-child(even) td {
            background-color: #f4f1ea;
        }
        #modal-new-marker #marker-credit-summary-tbl tbody tr:hover td {
            background-color: #f6f3ec;
        }

        #modal-new-marker .marker-history-dt-wrap {
            max-width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        /* Card shell around the history table + DataTables UI */
        #modal-new-marker .marker-history-card {
            border-radius: 0.5rem;
            border: 1px solid rgba(15, 23, 42, 0.08);
            background: linear-gradient(180deg, #fafbfc 0%, #ffffff 48px);
            box-shadow:
                0 1px 2px rgba(15, 23, 42, 0.04),
                0 4px 12px rgba(15, 23, 42, 0.06);
            padding: 0.65rem 0.30rem 0.5rem 0.75rem;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_wrapper {
            width: 100% !important;
            max-width: 100%;
            min-width: 0;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_wrapper > .row:first-child {
            margin-bottom: 0.65rem !important;
            padding: 0.5rem 0 0.5rem 0.55rem;
            align-items: center;
            justify-content: space-between;
            --bs-gutter-x: 0;
            background: #fff;
            border: 1px solid #e8ecf1;
            border-radius: 0.375rem;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_wrapper > .row:first-child > div:last-child {
            padding-right: 0 !important;
            padding-left: 0 !important;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_wrapper > .row:last-child {
            margin-top: 0.65rem !important;
            padding: 0.55rem 0.35rem 0.15rem;
            border-top: 1px solid #eef2f7;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_info {
            font-size: 0.8125rem;
            color: #64748b;
            padding-top: 0.35rem !important;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_paginate {
            overflow-x: auto;
            max-width: 100%;
            white-space: nowrap;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 0.25rem;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_paginate .pagination {
            margin-bottom: 0;
            gap: 0.2rem;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_paginate .page-link {
            font-size: 0.8125rem;
            padding: 0.3rem 0.55rem;
            border-radius: 0.3rem;
            border-color: #e2e8f0;
            color: #475569;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_paginate .page-item.active .page-link {
            background: linear-gradient(135deg, #52525b 0%, #71717a 100%);
            border-color: transparent;
            color: #fff;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_paginate .page-link:hover {
            background: #e9ecef;
            border-color: #dee2e6;
            color: #333;
        }

        /* Solid gold bar on full header/footer row */
        #modal-new-marker table.dataTable {
            border-collapse: collapse !important;
            border-spacing: 0 !important;
        }
        #modal-new-marker table thead tr,
        #modal-new-marker table tfoot tr {
            background-color: var(--gd-marker-gold-solid);
        }
        #modal-new-marker table thead th,
        #modal-new-marker table tfoot th {
            background: transparent !important;
            background-color: transparent !important;
            border-left: 0 !important;
            border-right: 0 !important;
            border-top: 0 !important;
            box-shadow: none !important;
        }
        #modal-new-marker table.dataTable thead > tr > th.sorting,
        #modal-new-marker table.dataTable thead > tr > th.sorting_asc,
        #modal-new-marker table.dataTable thead > tr > th.sorting_desc,
        #modal-new-marker table.dataTable thead > tr > th.sorting_disabled {
            background: transparent !important;
            background-color: transparent !important;
        }

        /* History card shell */
        #modal-new-marker .marker-credit-card {
            display: flex;
            flex-direction: column;
            height: 100%;
            border-radius: 0.6rem;
            border: 1px solid var(--gd-marker-gold-border);
            background: #fff;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05), 0 8px 22px rgba(15, 23, 42, 0.07);
            overflow: hidden;
        }
        #modal-new-marker .marker-credit-card--wide { height: auto; }
        #modal-new-marker .marker-credit-export {
            display: inline-flex;
            align-items: center;
            background: linear-gradient(135deg, #52525b 0%, #71717a 100%);
            border: 0;
            color: #fff;
            font-weight: 600;
            font-size: 0.72rem;
            line-height: 1;
            padding: 0.34rem 0.7rem;
            border-radius: 0.4rem;
            white-space: nowrap;
            transition: filter 0.15s ease;
        }
        #modal-new-marker .marker-credit-export:hover,
        #modal-new-marker .marker-credit-export:focus {
            color: #fff;
            filter: brightness(1.1);
        }
        #modal-new-marker .marker-history-btn-print {
            border-color: transparent;
        }

        /* New toolbar above the history table */
        #modal-new-marker .marker-history-toolbar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.65rem;
            padding: 0.6rem 0.75rem;
            background: linear-gradient(180deg, #f7f4ec 0%, #efe6d2 100%);
            border-bottom: 2px solid #c8a24c;
        }
        #modal-new-marker .marker-history-toolbar-left,
        #modal-new-marker .marker-history-toolbar-right {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.5rem;
        }
        #modal-new-marker .marker-history-length-slot .dataTables_length label {
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.8125rem;
            color: #6b4f14;
        }
        #modal-new-marker .marker-history-search-slot .dataTables_filter {
            margin: 0 !important;
        }
        #modal-new-marker .marker-history-search-slot .dataTables_filter label {
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.8125rem;
            color: #6b4f14;
        }
        #modal-new-marker .marker-history-search-slot .dataTables_filter input {
            width: 8rem;
            font-size: 0.8125rem;
            padding: 0.25rem 0.5rem;
            border: 1px solid var(--gd-marker-gold-border);
            border-radius: 0.35rem;
        }
        #modal-new-marker .marker-date-nav {
            display: inline-flex;
            align-items: stretch;
            border: 1px solid var(--gd-marker-gold-border);
            border-radius: 0.4rem;
            overflow: hidden;
            background: #fff;
        }
        #modal-new-marker .marker-date-nav-input {
            border: 0;
            text-align: center;
            font-size: 0.8125rem;
            font-weight: 600;
            color: #4a3208;
            width: 13rem;
            padding: 0.3rem 0.6rem;
            background: #fff;
        }
        #modal-new-marker .marker-date-nav-input:focus {
            outline: none;
        }
        #modal-new-marker .marker-status-toggle {
            display: inline-flex;
            border: 1px solid var(--gd-marker-gold-border);
            border-radius: 0.4rem;
            overflow: hidden;
        }
        #modal-new-marker .marker-status-toggle-btn {
            border: 0;
            background: #fff;
            padding: 0.32rem 0.85rem;
            font-size: 0.78rem;
            font-weight: 600;
            color: #6b4f14;
            cursor: pointer;
            transition: background 0.15s ease, color 0.15s ease;
            white-space: nowrap;
        }
        #modal-new-marker .marker-status-toggle-btn + .marker-status-toggle-btn {
            border-left: 1px solid var(--gd-marker-gold-border);
        }
        #modal-new-marker .marker-status-toggle-btn.active {
            background: linear-gradient(135deg, #d9ac4a 0%, #c8a24c 100%);
            color: #3a2e12;
        }

        /* History table — match Credit tab alignment/width */
  #modal-new-marker #marker-tbl.dataTable.marker-history-table {
    width: 100% !important;
    max-width: 100% !important;
    font-size: 0.95rem;
    line-height: 1.45;
    border: 1px solid var(--gd-marker-gold-border);
  }

  #modal-new-marker #marker-tbl thead th,
  #modal-new-marker #marker-tbl tbody td {
    box-sizing: border-box;
    white-space: nowrap;
    vertical-align: middle;
    border-color: #eee !important;
  }

  #modal-new-marker #marker-tbl tbody td.marker-history-col-remarks {
    white-space: normal;
    min-width: 8rem;
    max-width: 14rem;
    vertical-align: top;
  }

  #modal-new-marker #marker-tbl .marker-history-remarks-actions .btn {
    padding: 0.2rem 0.45rem;
  }

  #modal-new-marker #marker-tbl .marker-row-actions .btn-icon-plain {
    background: transparent !important;
    border-color: transparent !important;
    box-shadow: none !important;
    padding: 0.2rem 0.4rem;
    color: #6c757d;
    font-size: 1.05rem;
  }
  #modal-new-marker #marker-tbl .marker-row-actions .btn-icon-plain-danger {
    color: #dc3545;
  }
  #modal-new-marker #marker-tbl .marker-row-actions .btn-icon-plain:hover,
  #modal-new-marker #marker-tbl .marker-row-actions .btn-icon-plain:focus {
    background: transparent !important;
    border-color: transparent !important;
    color: #000;
  }
  #modal-new-marker #marker-tbl .marker-row-actions .btn-icon-plain-danger:hover,
  #modal-new-marker #marker-tbl .marker-row-actions .btn-icon-plain-danger:focus {
    color: #b02a37;
  }

  #modal-new-marker #marker-tbl thead th {
    color: var(--gd-marker-gold-text) !important;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 0.65rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--gd-marker-gold-border) !important;
  }

  #modal-new-marker #marker-tbl thead th.text-center,
  #modal-new-marker #marker-tbl tbody td.text-center {
    text-align: center !important;
  }

  #modal-new-marker #marker-tbl thead th.text-end,
