<div class="modal fade" id="modal-new-marker" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg2" role="document">
        <div class="modal-content">
        <div class="modal-header bg-primary">
            <h5 class="modal-title text-white" id="staticBackdropLiveLabel"><%= __('dashboard_marker.title') %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="add_marker_settlement" action="/" method="POST">
        <div class="modal-body">
             <div id="core-container">
                <div class="row mb-3 d-flex justify-content-center">
                    <span class="section-header text-center"><%= __('dashboard_marker.total_credits_issue') %></span>
                     <input  type="hidden"  id="AgentBalance" name="AgentBalance">
                    <div class="col-sm-12 mb-3">
                        <input type="text" class="form-control text-center" name="txtTotalMarkerIssue" id="txtTotalMarkerIssue" 
                        value="<%- Number((sqlJunketCredit && sqlJunketCredit[0] && sqlJunketCredit[0].JUNKET_CREDIT) || 0).toLocaleString('en-US') %>" readonly/>    
                    </div>
                </div>
                <div class="row mb-1">
                    <div class="col-sm-6">
                        <label class="form-label text-muted small mb-1 text-center">Total Cash Credit</label>
                        <input type="text" class="form-control text-center" id="txtTotalJunketCredit" readonly />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small mb-1 text-center">Total Game Credit</label>
                        <input type="text" class="form-control text-center" id="txtTotalGameCredit" readonly />
                    </div>
                </div>

                <input type="hidden" id="txtTotalBalanceGuest" name="totalBalanceGuest" />
                <input type="hidden" id="optFormModeHidden" name="optFormMode" value="" />
                <input type="hidden" id="optTransTypeHidden" name="optTransType" value="" />
                <div id="marker-form-fields-wrap">
                <div id="marker-return-source-wrap" class="d-none" aria-hidden="true">
                    <input type="radio" name="optReturnSource" id="return-source-credit" value="credit" />
                    <input type="radio" name="optReturnSource" id="return-source-buyin" value="buyin" />
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3">
                        <label class="form-label text-muted small mb-1"><%= __('dashboard_marker.program_date') %></label>
                        <input type="text" class="form-control form-control-sm" name="txtProgramDate" id="txtCreditProgramDate" required autocomplete="off" placeholder="YYYY-MM-DD" style="width: 100%;" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4">
                        <label class="form-label text-muted small"><%= __('dashboard_marker.account') %></label>
                        <select class="js-select2 form-select" name="txtAccountMarker" id="txtAccountMarker" style="width: 100%;" data-placeholder="<%= __('dashboard_marker.choose_account') %>">
                            <option value=""><%= __('dashboard_marker.choose_account') %></option>
                        </select>
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label text-muted small"><%= __('dashboard_marker.guest') %></label>
                        <select class="js-select2 form-select" name="txtGuestId" id="txtGuestMarker" style="width: 100%;" data-placeholder="<%= __('dashboard_marker.select_guest_optional') %>" disabled>
                            <option value=""><%= __('dashboard_marker.select_guest_optional') %></option>
                        </select>
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label text-muted small"><%= __('dashboard_marker.guarantor') %></label>
                        <input type="text" class="form-control" name="txtGuarantor" id="txtGuarantor" maxlength="255" autocomplete="off" required placeholder="<%= __('dashboard_marker.guarantor') %>" />
                    </div>
                </div>
                <div class="row mb-2 align-items-end">
                    <div class="col-sm-4">
                        <label class="form-label text-muted small" id="lbl-marker-amount"><%= __('dashboard_marker.amount') %></label>
                        <input type="text" class="form-control" name="txtMarkerReturn" id="txtMarkerReturn" required autocomplete="off" inputmode="decimal" />
                    </div>
                    <div class="col-sm-8">
                        <label class="form-label text-muted small d-block"><%= __('dashboard_marker.credit_action') %></label>
                        <div class="d-flex flex-wrap align-items-center gap-3 gap-md-4 pt-1" id="marker-credit-action-wrap">
                            <div class="form-check mb-0">
                                <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="credit-action-return-deposit-modal" name="optCreditAction" value="return_deposit" />
                                <label class="form-check-label" for="credit-action-return-deposit-modal"><%= __('dashboard_marker.credit_action_return_deposit') %></label>
                            </div>
                            <div class="form-check mb-0">
                                <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="credit-action-game-credit-modal" name="optCreditAction" value="game_credit" />
                                <label class="form-check-label" for="credit-action-game-credit-modal"><%= __('dashboard_marker.credit_action_game_credit') %></label>
                            </div>
                            <div class="form-check mb-0">
                                <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="credit-action-return-cash-modal" name="optCreditAction" value="return_cash" />
                                <label class="form-check-label" for="credit-action-return-cash-modal"><%= __('dashboard_marker.credit_action_return_cash') %></label>
                            </div>
                            <div class="form-check mb-0">
                                <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="credit-action-cash-credit-modal" name="optCreditAction" value="cash_credit" />
                                <label class="form-check-label" for="credit-action-cash-credit-modal"><%= __('dashboard_marker.credit_action_cash_credit') %></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="d-none" id="marker-issue-balance-row" aria-hidden="true">
                    <div id="marker-issue-field-wrap">
                        <input type="hidden" name="txtMarkerIssue" id="txtMarkerIssue" />
                    </div>
                    <div id="marker-balance-field-wrap">
                        <input type="hidden" name="txtMarkerBalance" id="txtMarkerBalance" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-12">
                        <label class="form-label text-muted small"><%= __('dashboard_marker.remarks_optional') %></label>
                        <input type="text" class="form-control" name="remarks" id="txtRemarks" maxlength="500" autocomplete="off" />
                    </div>
                </div>
                <div id="marker-return-trans-type-wrap" class="d-none" aria-hidden="true"></div>
                <div class="row d-flex justify-content-between align-items-center mt-3 mb-2">
                    <div class="col-auto d-flex justify-content-start align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-success d-none" id="btn-credits-game-start">
                            <%= __('dashboard_marker.game_start') %>
                        </button>
                        <button id="submit_marker_settlement" type="submit" class="btn btn-sm btn-primary">
                            <%= __('dashboard_marker.save') %>
                        </button>
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
                            <%= __('dashboard_marker.close') %>
                        </button>
                    </div>
                </div>
                </div>
            </div>

            <hr style="border: none; border-top: 0.2rem solid black;">

            <!-- 4 Tabs: Total Credit (default), Cash Credit, Game Credit, History -->
            <ul class="nav nav-tabs marker-balance-tabs mb-2" id="marker-balance-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-total-credit" data-tab="total" type="button" role="tab"><%= __('dashboard_marker.tab_total_credit') %></button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-credit-balance" data-tab="credit" type="button" role="tab"><%= __('dashboard_marker.tab_credit') %></button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-buyin-balance" data-tab="buyin" type="button" role="tab"><%= __('dashboard_marker.tab_buyin') %></button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-marker-history" data-tab="marker-history" type="button" role="tab"><%= __('dashboard_marker.marker_history') %></button>
                </li>
            </ul>

            <div id="marker-accounts-total-wrapper" class="marker-tab-panel mb-3" data-panel="total">
                <div class="marker-balance-dt-wrap marker-balance-card table-responsive">
                    <table id="marker-accounts-total-tbl" class="table marker-balance-tbl marker-total-table w-100 mb-0">
                        <thead>
                            <tr>
                                <th><%= __('dashboard_marker.program_date') %></th>
                                <th><%= __('dashboard_marker.date_time') %></th>
                                <th><%= __('dashboard_marker.account') %></th>
                                <th><%= __('dashboard_marker.agent') %></th>
                                <th><%= __('dashboard_marker.debtor') %></th>
                                <th class="text-end"><%= __('dashboard_marker.amount') %></th>
                                <th><%= __('dashboard_marker.type') %></th>
                                <th><%= __('dashboard_marker.guarantor') %></th>
                                <th><%= __('dashboard_marker.remarks') %></th>
                                <th class="text-center"><%= __('dashboard_marker.action') %></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div id="marker-history-wrapper" class="marker-tab-panel mb-3" data-panel="marker-history" style="display: none;">
                <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mb-2 marker-history-export-row">
                    <button type="button" id="export-excel" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1 px-3 shadow-sm">
                        <i class="fa fa-file-excel opacity-90"></i><span><%= __('dashboard_marker.export') %></span>
                    </button>
                </div>
                <div class="marker-history-dt-wrap marker-history-card table-responsive">
                <table id="marker-tbl" class="table marker-history-table w-100 mb-0">
                <thead>
                    <tr>
                        <th class="d-none d-sm-table-cell"><%= __('dashboard_marker.account_name') %></th>
                        <th class="d-none d-sm-table-cell text-center marker-history-col-amount"><%= __('dashboard_marker.amount') %></th>
                        <th class="d-none d-sm-table-cell"><%= __('dashboard_marker.transaction_type') %></th>
                        <th class="d-none d-sm-table-cell text-center"><%= __('dashboard_marker.date') %></th>
                        <th class="d-none d-sm-table-cell"><%= __('dashboard_marker.remarks') %></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
                </table>
                </div>
            </div>

            <div id="marker-accounts-credit-wrapper" class="marker-tab-panel mb-3" data-panel="credit" style="display: none;">
                <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mb-2 marker-history-export-row">
                    <button type="button" id="export-excel-credit" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1 px-3 shadow-sm">
                        <i class="fa fa-file-excel opacity-90"></i><span><%= __('dashboard_marker.export') %></span>
                    </button>
                </div>
                <div class="marker-balance-dt-wrap marker-balance-card table-responsive">
                    <table id="marker-accounts-credit-tbl" class="table marker-balance-tbl marker-balance-table w-100 mb-0">
                        <thead>
                            <tr>
                                <th><%= __('dashboard_marker.account_name') %></th>
                                <th class="text-end marker-balance-col-amount"><%= __('dashboard_marker.balance') %></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot><tr><th></th><th class="text-end marker-balance-col-amount"></th></tr></tfoot>
                    </table>
                </div>
            </div>

            <div id="marker-accounts-buyin-wrapper" class="marker-tab-panel mb-3" data-panel="buyin" style="display: none;">
                <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mb-2 marker-history-export-row">
                    <button type="button" id="export-excel-buyin" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1 px-3 shadow-sm">
                        <i class="fa fa-file-excel opacity-90"></i><span><%= __('dashboard_marker.export') %></span>
                    </button>
                </div>
                <div class="marker-balance-dt-wrap marker-balance-card table-responsive">
                    <table id="marker-accounts-buyin-tbl" class="table marker-balance-tbl marker-balance-table w-100 mb-0">
                        <thead>
                            <tr>
                                <th><%= __('dashboard_marker.account_name') %></th>
                                <th class="text-end marker-balance-col-amount"><%= __('dashboard_marker.balance') %></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot><tr><th></th><th class="text-end marker-balance-col-amount"></th></tr></tfoot>
                    </table>
                </div>
            </div>
        </div>
        </form>
    </div>
    </div>

    <style>
        .modal-lg2 {
            max-width: min(98vw, 85rem) !important;
            width: 100%;
            margin-left: auto;
            margin-right: auto;
        }

        #modal-new-marker .modal-body {
            min-width: 0;
        }

        #modal-new-marker #marker-history-wrapper {
            min-width: 0;
            max-width: 100%;
        }

        #modal-new-marker .marker-history-export-row {
            padding: 0 0.125rem;
        }

        #modal-new-marker .marker-history-dt-wrap,
        #modal-new-marker .marker-balance-dt-wrap,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap {
            max-width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        /* Card shell around history + Junket/Game credit tables + DataTables UI */
        #modal-new-marker .marker-history-card,
        #modal-new-marker .marker-balance-card,
        #marker-accounts-credit-wrapper .marker-balance-card,
        #marker-accounts-buyin-wrapper .marker-balance-card {
            border-radius: 0.5rem;
            border: 1px solid rgba(15, 23, 42, 0.08);
            background: linear-gradient(180deg, #fafbfc 0%, #ffffff 48px);
            box-shadow:
                0 1px 2px rgba(15, 23, 42, 0.04),
                0 4px 12px rgba(15, 23, 42, 0.06);
            padding: 0.65rem 0.30rem 0.5rem 0.75rem;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_wrapper,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_wrapper,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_wrapper,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_wrapper {
            width: 100% !important;
            max-width: 100%;
            min-width: 0;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_wrapper > .row:first-child,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_wrapper > .row:first-child,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_wrapper > .row:first-child,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_wrapper > .row:first-child {
            margin-bottom: 0.65rem !important;
            padding: 0.5rem 0 0.5rem 0.55rem;
            align-items: center;
            justify-content: space-between;
            --bs-gutter-x: 0;
            background: #fff;
            border: 1px solid #e8ecf1;
            border-radius: 0.375rem;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_wrapper > .row:first-child > div:last-child,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_wrapper > .row:first-child > div:last-child,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_wrapper > .row:first-child > div:last-child,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_wrapper > .row:first-child > div:last-child {
            padding-right: 0 !important;
            padding-left: 0 !important;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_length,
        #modal-new-marker .marker-history-dt-wrap .dataTables_filter,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_length,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_filter,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_length,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_filter,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_length,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_filter {
            max-width: 100%;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_filter,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_filter,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_filter,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_filter {
            margin-right: 0 !important;
            margin-left: 0;
            flex: 0 0 auto;
            text-align: right;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_length label,
        #modal-new-marker .marker-history-dt-wrap .dataTables_filter label,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_length label,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_filter label,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_length label,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_filter label,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_length label,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_filter label {
            font-size: 0.8125rem;
            color: #64748b;
            font-weight: 500;
            gap: 0.35rem;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_filter label,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_filter label,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_filter label,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_filter label {
            justify-content: flex-end;
            width: 100%;
        }

        @media (min-width: 768px) {
            #modal-new-marker .marker-history-dt-wrap .dataTables_filter label,
            #modal-new-marker .marker-balance-dt-wrap .dataTables_filter label,
            #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_filter label,
            #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_filter label {
                width: auto;
            }
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_length select,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_length select,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_length select,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_length select {
            display: inline-block;
            min-width: 4.25rem;
            padding: 0.3rem 2rem 0.3rem 0.55rem;
            font-size: 0.8125rem;
            line-height: 1.4;
            color: #334155;
            background-color: #fff;
            border: 1px solid #cbd5e1;
            border-radius: 0.375rem;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_filter input,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_filter input,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_filter input,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_filter input {
            max-width: 100%;
            width: 100% !important;
            box-sizing: border-box;
            margin-left: 0.35rem !important;
            padding: 0.4rem 0.65rem;
            font-size: 0.8125rem;
            border: 1px solid #cbd5e1;
            border-radius: 0.375rem;
            background: #fff;
            color: #334155;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_filter input:focus,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_filter input:focus,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_filter input:focus,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_filter input:focus {
            outline: none;
            border-color: var(--bs-primary);
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
        }

        @media (min-width: 768px) {
            #modal-new-marker .marker-history-dt-wrap .dataTables_filter input,
            #modal-new-marker .marker-balance-dt-wrap .dataTables_filter input,
            #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_filter input,
            #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_filter input {
                width: auto !important;
                min-width: 11rem;
                max-width: 17rem;
            }
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_wrapper > .row:last-child,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_wrapper > .row:last-child,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_wrapper > .row:last-child,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_wrapper > .row:last-child {
            margin-top: 0.65rem !important;
            padding: 0.55rem 0.35rem 0.15rem;
            border-top: 1px solid #eef2f7;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_info,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_info,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_info,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_info {
            font-size: 0.8125rem;
            color: #64748b;
            padding-top: 0.35rem !important;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_paginate,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_paginate,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_paginate,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_paginate {
            overflow-x: auto;
            max-width: 100%;
            white-space: nowrap;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 0.25rem;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_paginate .pagination,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_paginate .pagination,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_paginate .pagination,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_paginate .pagination {
            margin-bottom: 0;
            gap: 0.2rem;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        #modal-new-marker .marker-history-dt-wrap .dataTables_paginate .page-link,
        #modal-new-marker .marker-balance-dt-wrap .dataTables_paginate .page-link,
        #marker-accounts-credit-wrapper .marker-balance-dt-wrap .dataTables_paginate .page-link,
        #marker-accounts-buyin-wrapper .marker-balance-dt-wrap .dataTables_paginate .page-link {
            font-size: 0.8125rem;
            padding: 0.3rem 0.55rem;
            border-radius: 0.3rem;
            border-color: #e2e8f0;
            color: #475569;
        }

