<div class="modal fade" id="modal-new-return-money" role="dialog" aria-labelledby="modal-default-popout"
    aria-hidden="true" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h5 class="block-title text-white">Add Return Money</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="add_return_money" novalidate>
                    <div class="row mb-3">
                        <div class="col-sm-12 form-floating-outline">
                            <label class="form-label" for="returnMoneyNewProgramDate"><%= __('house_expense.program_date') %></label>
                            <input type="text" class="form-control input-program-date" name="txtProgramDate" id="returnMoneyNewProgramDate" autocomplete="off" placeholder="YYYY-MM-DD" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-12 form-floating-outline">
                            <label class="form-label">Amount</label>
                            <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
                                class="form-control" name="txtAmount" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-12 form-floating-outline">
                            <label class="form-label">In Charge</label>
                            <input type="text" class="form-control" name="txtInCharge" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-12 form-floating-outline">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" name="txtDescription" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button id="btn-save-new-return-money" type="submit" class="btn btn-sm btn-success" data-original-text="Save">
                            Save
                        </button>
                        <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
                            Close
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
