<div class="modal fade" id="modal-new-house-expense" role="dialog" aria-labelledby="modal-default-popout"
    aria-hidden="true" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">




            <div class="modal-header bg-primary">
                <h5 class="block-title text-white"><%= __('modal_new_house_expense.add_house_expense') %></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="add_junket_house_expense" novalidate>

                    <input type="hidden" id="house-expense-new-expense-category-id" value="" />
                    <div class="row mb-3 d-none" id="house-expense-new-cat-preset-wrap">
                        <div class="col-sm-12 form-floating-outline">
                            <label class="form-label"><%= __('modal_new_house_expense.category_placeholder') || 'Category' %></label>
                            <div id="house-expense-new-cat-preset-label" class="form-control bg-light text-primary fw-semibold"></div>
                        </div>
                    </div>
                    <div class="row mb-3" id="house-expense-new-cat-select-wrap">
                        <div class="col-sm-12 form-floating-outline">
                            <label class="form-label"><%= __('modal_new_house_expense.category_placeholder') || 'Category' %></label>
                            <select class="select2 form-select" id="expense-category-select" name="txtCategory" style="width: 100%;" data-placeholder="" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-12 form-floating-outline">
                            <label class="form-label"><%= __('modal_new_house_expense.receipt_photo') || 'Receipt Photo' %></label>
                            <input type="file" name="photo" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-12 form-floating-outline">
                            <label class="form-label"><%= __('modal_new_house_expense.receipt_no') %></label>
                            <textarea class="form-control" name="txtReceiptNo" id="txtReceiptNo" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-6 form-floating-outline">
                            <label class="form-label"><%= __('modal_new_house_expense.description') %></label>
                            <input type="text" class="form-control" name="txtDescription" id="txtNewExpenseInCharge" />
                        </div>
                        <div class="col-sm-6 form-floating-outline">
                            <label class="form-label"><%= __('modal_new_house_expense.receiver') || 'Receiver' %></label>
                            <input type="text" class="form-control" name="txtReceiver" id="txtNewExpenseReceiver" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-12 form-floating-outline">
                            <label class="form-label"><%= __('modal_new_house_expense.amount') %></label>
                            <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
                                class="form-control" name="txtAmount" required />
                        </div>
                    </div>
              

                    <div class="modal-footer">
                        <button id="btn-save-new-expense" type="submit" class="btn btn-sm btn-primary" data-original-text="<%= __('modal_edit_house_expense.save') %>">
                            <%= __('modal_edit_house_expense.save') %>
                        </button>
                        <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
                            <%= __('modal_new_house_expense.close') %>
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>