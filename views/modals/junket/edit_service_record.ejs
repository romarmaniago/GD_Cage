<div class="modal fade" id="modal-services-edit-record" tabindex="-1" aria-labelledby="modal-services-edit-record-label" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="modal-services-edit-record-label"><%= __('fnb_hotel.edit_service_record') %></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="edit-services-id" />
        <input type="hidden" id="edit-services-agent-id" />
        <input type="hidden" id="edit-services-type-value" value="" />
        <input type="hidden" id="edit-services-transaction-id" value="" />

        <div class="row mb-3">
          <div class="col-sm-6">
            <label for="edit-services-program-date" class="form-label"><%= __('fnb_hotel.program_date') || 'Program Date' %></label>
            <input type="text" id="edit-services-program-date" class="form-control" autocomplete="off" placeholder="YYYY-MM-DD" required />
          </div>
          <div class="col-sm-6">
            <label for="edit-transaction-type" class="form-label"><%= __('fnb_hotel.transaction_type') %></label>
            <select id="edit-transaction-type" class="form-control">
              <option value="" selected disabled><%= __('fnb_hotel.select_transaction') %></option>
              <option value="JUNKET"><%= __('fnb_hotel.junket_payment') %></option>
              <option value="GUEST"><%= __('fnb_hotel.guest_payment') %></option>
            </select>
          </div>
        </div>

        <div class="row mb-3" id="edit-services-account-wrapper">
          <div class="col-sm-6">
            <label for="edit-services-account" class="form-label"><%= __('fnb_hotel.account') %></label>
            <select id="edit-services-account" class="js-select2 form-control" style="width: 100%;" data-placeholder="<%= __('fnb_hotel.choose_account') %>" disabled>
              <option value=""><%= __('fnb_hotel.choose_account') %></option>
            </select>
          </div>
          <div class="col-sm-6">
            <label for="edit-services-guest" class="form-label"><%= __('fnb_hotel.guest') %></label>
            <select id="edit-services-guest" class="js-select2 form-control" style="width: 100%;" data-placeholder="<%= __('fnb_hotel.select_guest_optional') %>" disabled>
              <option value=""><%= __('fnb_hotel.select_guest_optional') %></option>
            </select>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-6">
            <label for="edit-services-amount" class="form-label"><%= __('fnb_hotel.amount') %></label>
            <input type="text" id="edit-services-amount" class="form-control" data-type="number" placeholder="<%= __('fnb_hotel.enter_amount') %>" />
            <div id="edit-deposit-balance" class="text-muted small mt-1" style="display:none">
              <%= __('fnb_hotel.available_balance') %> <span id="edit-deposit-balance-value">0</span>
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label"><%= __('fnb_hotel.service_type') %></label>
          <div id="edit-services-type-list" class="edit-services-type-list" role="group" aria-label="<%= __('fnb_hotel.service_type') %>">
            <span class="edit-services-type-placeholder text-muted small"><%= __('fnb_hotel.select_service') %></span>
          </div>
        </div>

        <div class="mb-1">
          <label for="edit-services-remarks" class="form-label"><%= __('fnb_hotel.remarks') %></label>
          <textarea id="edit-services-remarks" class="form-control" rows="2" placeholder="<%= __('fnb_hotel.optional_remarks') %>"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" id="edit-services-save" class="btn btn-sm btn-primary"><%= __('fnb_hotel.update') %></button>
        <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('fnb_hotel.close') %></button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Keep modal-lg size even when dashboard pages override .modal-lg globally */
  #modal-services-edit-record .modal-dialog.modal-lg {
    max-width: 800px !important;
  }

  #modal-services-edit-record .select2-container {
    display: block;
    width: 100% !important;
  }

  #modal-services-edit-record .select2-container .select2-selection--single {
    height: calc(1.5em + 0.75rem + 2px);
    min-height: calc(1.5em + 0.75rem + 2px);
  }

  #modal-services-edit-record .select2-container--default .select2-selection--single {
    position: relative;
    border: 1px solid var(--bs-border-color, #dee2e6);
    border-radius: 0.375rem;
    background-color: #fff;
  }

  #modal-services-edit-record .select2-container--default.select2-container--focus .select2-selection--single,
  #modal-services-edit-record .select2-container--default.select2-container--open .select2-selection--single {
    border-color: #86b7fe;
    outline: 0;
    box-shadow: 0 0 0 0.25rem rgba(200, 162, 76, 0.25);
  }

  #modal-services-edit-record .select2-container--default .select2-selection--single .select2-selection__rendered {
    display: block;
    padding-left: 0.75rem;
    padding-right: 3.25rem;
    height: calc(1.5em + 0.75rem + 2px);
    min-height: calc(1.5em + 0.75rem + 2px);
    line-height: calc(1.5em + 0.75rem + 2px);
    color: var(--bs-body-color, #212529);
    font-size: 1rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #modal-services-edit-record .select2-container--default .select2-selection--single .select2-selection__arrow {
    height: calc(1.5em + 0.75rem + 2px);
    min-height: calc(1.5em + 0.75rem + 2px);
    right: 0.35rem;
  }

  #modal-services-edit-record .select2-container--default .select2-selection--single .select2-selection__placeholder {
    color: #8A92A6;
  }

  #modal-services-edit-record .select2-container--default .select2-selection--single .select2-selection__clear {
    position: absolute;
    right: 1.75rem;
    top: 50%;
    transform: translateY(-50%);
    float: none;
    margin: 0;
    padding: 0 0.25rem;
    line-height: 1;
    font-size: 1rem;
    color: #8a92a6;
    z-index: 2;
  }

  #modal-services-edit-record .select2-container--default .select2-selection--single .select2-selection__clear:hover {
    color: #495057;
  }

  #modal-services-edit-record .select2-container--default.select2-container--disabled .select2-selection--single {
    background-color: #e9ecef;
    cursor: not-allowed;
  }

  #modal-services-edit-record .edit-services-type-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.25rem 1rem;
    align-items: stretch;
    min-height: calc(1.5em + 0.75rem + 2px);
    padding: 0.75rem 1rem;
    border: 1px solid var(--bs-border-color, #dee2e6);
    border-radius: 0.375rem;
    background-color: #fff;
    overflow: hidden;
    box-sizing: border-box;
  }

  #modal-services-edit-record .edit-services-type-list .form-check,
  #modal-services-edit-record .edit-services-type-list .form-check-inline {
    display: grid;
    grid-template-columns: 1.125rem minmax(0, 1fr);
    align-items: center;
    column-gap: 0.45rem;
    width: 100%;
    min-width: 0;
    min-height: 2rem;
    margin: 0;
    padding: 0.3rem 0;
    float: none;
  }

  #modal-services-edit-record .edit-services-type-list .form-check-input {
    float: none !important;
    grid-column: 1;
    width: 1.125rem;
    height: 1.125rem;
    margin: 0 !important;
    position: static;
    border-color: #8a92a6 !important;
  }

  #modal-services-edit-record .edit-services-type-list .form-check-label {
    grid-column: 2;
    margin: 0;
    padding: 0;
    min-width: 0;
    line-height: 1.3;
    cursor: pointer;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #modal-services-edit-record .edit-services-type-placeholder {
    grid-column: 1 / -1;
    line-height: calc(1.5em + 0.75rem + 2px);
  }

  @media (max-width: 575.98px) {
    #modal-services-edit-record .edit-services-type-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.15rem 0.75rem;
    }
  }
</style>

