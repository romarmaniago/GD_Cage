<div class="modal fade" id="modal-edit-capital" role="dialog" aria-labelledby="modal-edit-capital-title" aria-hidden="true"
	data-keyboard="false" data-bs-backdrop="static">
	<div class="modal-dialog modal-dialog-centered modal-lg" role="document">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white" id="modal-edit-capital-title"><%= __('dashboard_new_capital.edit_title') %></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="edit_junket_capital">
				<div class="modal-body">
					<input type="hidden" name="id" id="edit-capital-id" value="">
					<input type="hidden" name="optWithdrawDeposit" id="edit-capital-txn" value="">
					<input type="hidden" name="description" id="edit-capital-description" value="">

					<div class="row mb-2">
						<div class="col-sm-6">
							<label class="form-label" for="edit-capital-program-date"><%= __('dashboard_new_capital.program_date') %></label>
							<input type="text" id="edit-capital-program-date" name="txtProgramDate" class="form-control form-control-sm" placeholder="<%= __('dashboard_new_capital.program_date') %>" autocomplete="off" required>
						</div>
						<div class="col-sm-6">
							<label class="form-label" for="edit-capital-amount"><%= __('dashboard_new_capital.junket_balance_amount') %></label>
							<input type="text" id="edit-capital-amount" name="txtAmount" class="form-control form-control-sm hb-field-amount" placeholder="+ / - Amount" title="Use + for dagdag, - for bawas" onkeypress="return onlyCapitalSignedAmountKey(event)" data-type="signed-amount" autocomplete="off" required>
						</div>
					</div>

					<div class="row mb-2">
						<div class="col-12">
							<label class="form-label" for="edit-capital-remarks"><%= __('dashboard_new_capital.remarks_placeholder') %></label>
							<textarea class="form-control form-control-sm" name="Remarks" id="edit-capital-remarks" placeholder="<%= __('dashboard_new_capital.remarks_placeholder') %>" rows="2"></textarea>
						</div>
					</div>

					<div class="hb-type-grid mb-1" role="group" aria-label="Transaction type">
						<div class="form-check">
							<input class="form-check-input edit-hb-type-check" style="border-color: #8a92a6 !important;" type="checkbox" id="editHbTypeTransfer" value="Transfer" data-txn="2">
							<label class="form-check-label" for="editHbTypeTransfer"><%= __('dashboard_new_capital.type_transfer') %></label>
						</div>
						<div class="form-check">
							<input class="form-check-input edit-hb-type-check" style="border-color: #8a92a6 !important;" type="checkbox" id="editHbTypeDeposit" value="Deposit" data-txn="1">
							<label class="form-check-label" for="editHbTypeDeposit"><%= __('dashboard_new_capital.type_deposit') %></label>
						</div>
						<div class="form-check">
							<input class="form-check-input edit-hb-type-check" style="border-color: #8a92a6 !important;" type="checkbox" id="editHbTypeWithdrawal" value="Withdrawal" data-txn="2">
							<label class="form-check-label" for="editHbTypeWithdrawal"><%= __('dashboard_new_capital.type_withdrawal') %></label>
						</div>
						<div class="form-check">
							<input class="form-check-input edit-hb-type-check" style="border-color: #8a92a6 !important;" type="checkbox" id="editHbTypeLossAmount" value="Loss Amount" data-txn="2">
							<label class="form-check-label" for="editHbTypeLossAmount"><%= __('dashboard_new_capital.type_loss_amount') %></label>
						</div>
						<div class="form-check">
							<input class="form-check-input edit-hb-type-check" style="border-color: #8a92a6 !important;" type="checkbox" id="editHbTypeSettlement" value="Settlement" data-txn="2">
							<label class="form-check-label" for="editHbTypeSettlement"><%= __('dashboard_new_capital.type_settlement') %></label>
						</div>
						<div class="form-check">
							<input class="form-check-input edit-hb-type-check" style="border-color: #8a92a6 !important;" type="checkbox" id="editHbTypeFnb" value="F&B" data-txn="2">
							<label class="form-check-label" for="editHbTypeFnb"><%= __('dashboard_new_capital.type_fnb') %></label>
						</div>
						<div class="form-check">
							<input class="form-check-input edit-hb-type-check" style="border-color: #8a92a6 !important;" type="checkbox" id="editHbTypeHotel" value="Hotel" data-txn="2">
							<label class="form-check-label" for="editHbTypeHotel"><%= __('dashboard_new_capital.type_hotel') %></label>
						</div>
						<div class="form-check">
							<input class="form-check-input edit-hb-type-check" style="border-color: #8a92a6 !important;" type="checkbox" id="editHbTypeIncidental" value="Incidental" data-txn="2">
							<label class="form-check-label" for="editHbTypeIncidental"><%= __('dashboard_new_capital.type_incidental') %></label>
						</div>
						<div class="form-check">
							<input class="form-check-input edit-hb-type-check" style="border-color: #8a92a6 !important;" type="checkbox" id="editHbTypeExpenses" value="Expenses" data-txn="2">
							<label class="form-check-label" for="editHbTypeExpenses"><%= __('dashboard_new_capital.type_expenses') %></label>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="submit" class="btn btn-sm btn-primary" id="edit-capital-save-btn" data-view-only-disable>
						<i class="fa fa-check-circle me-1"></i><%= __('dashboard_new_capital.save') %>
					</button>
					<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('dashboard_new_capital.close') %></button>
				</div>
			</form>
		</div>
	</div>
</div>

<style>
	#modal-edit-capital .hb-type-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, auto));
		column-gap: 1.25rem;
		row-gap: 0.5rem;
		align-items: center;
	}
	#modal-edit-capital .hb-type-grid .form-check {
		margin: 0;
		min-height: 0;
		padding-left: 1.4rem;
		white-space: nowrap;
	}
	#modal-edit-capital .hb-type-grid .form-check-input {
		margin-top: 0.2rem;
	}
</style>
