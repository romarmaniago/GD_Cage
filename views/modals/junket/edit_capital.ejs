<div class="modal fade" id="modal-edit-capital" role="dialog" aria-labelledby="modal-edit-capital-title" aria-hidden="true"
	data-keyboard="false" data-bs-backdrop="static" data-i18n-title="<%= __('dashboard_new_capital.edit_title') %>">
	<div class="modal-dialog modal-dialog-centered modal-lg" role="document">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="modal-title text-white" id="modal-edit-capital-title"><%= __('dashboard_new_capital.edit_title') %></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="edit_junket_capital">
				<div class="modal-body">
					<%# Type is not editable; Program Date, Amount, Remarks (and the account for a Transfer) are %>
					<input type="hidden" name="id" id="edit-capital-id" value="">

					<div class="hb-entry-grid">
						<div class="hb-entry-field hb-entry-date">
							<label class="form-label" for="edit-capital-program-date"><%= __('dashboard_new_capital.program_date') %></label>
							<input type="text" id="edit-capital-program-date" name="txtProgramDate" class="form-control" placeholder="<%= __('dashboard_new_capital.program_date') %>" autocomplete="off" required>
						</div>
						<div class="hb-entry-field hb-entry-account d-none" id="edit-capital-transfer-account-wrap">
							<label class="form-label" for="edit-capital-transfer-account"><%= __('dashboard_new_capital.choose_an_account') %></label>
							<select id="edit-capital-transfer-account" name="txtAccountId" class="form-control" style="width: 100%;" data-placeholder="<%= __('dashboard_new_capital.choose_an_account') %>">
								<option value=""><%= __('dashboard_new_capital.choose_an_account') %></option>
							</select>
						</div>
						<div class="hb-entry-field hb-entry-amount">
							<label class="form-label" for="edit-capital-amount" id="edit-capital-amount-label"><%= __('dashboard_new_capital.deposit_withdrawal') %></label>
							<input type="text" id="edit-capital-amount" name="txtAmount" class="form-control hb-field-amount" placeholder="+ / - Amount" onkeypress="return onlyCapitalSignedAmountKey(event)" data-type="signed-amount" autocomplete="off" required>
						</div>
						<div class="hb-entry-field hb-entry-remarks">
							<label class="form-label" for="edit-capital-remarks"><%= __('dashboard_new_capital.remarks_placeholder') %></label>
							<input type="text" class="form-control" name="Remarks" id="edit-capital-remarks" placeholder="<%= __('dashboard_new_capital.remarks_placeholder') %>" autocomplete="off">
						</div>
					</div>

				</div>
				<div class="modal-footer">
					<button type="submit" class="btn btn-sm btn-primary" id="edit-capital-save-btn" data-view-only-disable>
						<i class="fa fa-check-circle me-1"></i><%= __('dashboard_new_capital.save') %>
					</button>
					<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('dashboard_new_capital.close') %></button>
				</div>
			</form>
		</div>
	</div>
</div>

<style>
	#modal-edit-capital .hb-entry-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		gap: 0.75rem;
	}
	#modal-edit-capital .hb-entry-grid .hb-entry-date { grid-column: 1; grid-row: 1; }
	#modal-edit-capital .hb-entry-grid .hb-entry-amount { grid-column: 1; grid-row: 2; }
	#modal-edit-capital .hb-entry-grid .hb-entry-remarks { grid-column: 2; grid-row: 2; }
	/* Transfer: account on its own line under Program Date */
	#modal-edit-capital .hb-entry-grid .hb-entry-account { grid-column: 1; grid-row: 2; }
	#modal-edit-capital.is-transfer .hb-entry-grid .hb-entry-amount { grid-row: 3; }
	#modal-edit-capital.is-transfer .hb-entry-grid .hb-entry-remarks { grid-row: 3; }
	#modal-edit-capital .hb-entry-field .form-label {
		margin-bottom: 0.25rem;
	}
	#modal-edit-capital .hb-entry-field .flatpickr-input.form-control {
		width: 100%;
	}
	@media (max-width: 575.98px) {
		#modal-edit-capital .hb-entry-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		#modal-edit-capital .hb-entry-grid .hb-entry-field,
		#modal-edit-capital.is-transfer .hb-entry-grid .hb-entry-field {
			grid-column: auto;
			grid-row: auto;
		}
	}
</style>
