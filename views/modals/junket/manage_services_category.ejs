<div class="modal fade" id="modal-manage-services-category" role="dialog" aria-labelledby="modal-manage-services-category-title"
	aria-hidden="true" data-keyboard="false" data-bs-backdrop="static">
	<div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable" role="document">
		<div class="modal-content">
			<div class="modal-header d-flex justify-content-between align-items-center" style="background: linear-gradient(180deg, #f6f3ec 0%, #efe9db 100%); border-bottom: 1px solid rgba(200, 162, 76, 0.25);">
				<h5 class="block-title mb-0" style="color: #555; font-weight: 600;" id="modal-manage-services-category-title"><%= __('services_category.services_category') %></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<button
					type="button"
					class="expense-cat-panel-add-btn d-none"
					id="btn-add-services-category"
					title="<%= __('services_category.new_category') %>"
					aria-label="<%= __('services_category.new_category') %>"
					onclick="addServicesCategory()"
					data-view-only-disable
				>
					<i class="fa fa-plus" aria-hidden="true"></i>
				</button>
				<div class="table-responsive">
					<table id="services-category-tbl" class="table nowrap small-text" style="width:100%">
						<thead>
							<tr>
								<th class="d-none d-sm-table-cell"><%= __('services_category.category') %></th>
								<th class="d-none d-sm-table-cell" style="width: 150px;"><%= __('services_category.status') %></th>
								<th class="d-none d-sm-table-cell" style="width: 100px;"><%= __('services_category.action') %></th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	#modal-manage-services-category .modal-body { overflow-x: auto; }
	#services-category-tbl { width: 100%; font-size: 13px; border-collapse: collapse; border: 1px solid #e0e0e0; }
	#services-category-tbl thead tr { background-color: #f5f5f5; }
	#services-category-tbl thead th {
		background: #f5f5f5 !important;
		color: #555;
		font-weight: 600;
		padding: 12px 15px;
		text-align: left;
		border: none;
		border-bottom: 1px solid #e0e0e0;
		box-shadow: none !important;
	}
	#services-category-tbl tbody tr { border-bottom: 1px solid #eee; }
	#services-category-tbl tbody tr:nth-child(even) td { background-color: #f4f1ea; }
	#services-category-tbl tbody tr:nth-child(odd) td { background-color: #fff; }
	#services-category-tbl td { padding: 12px 15px; color: #666; }
	#services-category-tbl tbody tr:hover, #services-category-tbl tbody tr:hover td { background-color: #f6f3ec !important; }
	#services-category-tbl th,
	#services-category-tbl td { white-space: nowrap; }
	#modal-new-services-category,
	#modal-edit-services-category { z-index: 1060 !important; }

	#btn-add-services-category.expense-cat-panel-add-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: linear-gradient(135deg, #52525b 0%, #71717a 100%);
		color: #fff;
		line-height: 1;
		flex-shrink: 0;
		position: relative;
		z-index: 2;
		cursor: pointer;
		transition: filter 0.12s ease;
	}
	#btn-add-services-category.expense-cat-panel-add-btn i.fa {
		font-size: 1rem;
		line-height: 1;
		pointer-events: none;
	}
	#btn-add-services-category.expense-cat-panel-add-btn:hover:not(:disabled) {
		filter: brightness(0.92);
	}

	#services-category-tbl_wrapper .services-category-controls-highlight {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 8px 12px;
		margin-bottom: -1px;
		background: #f6f3ec;
		border: 1px solid rgba(200, 162, 76, 0.28);
		border-bottom: 0;
		border-radius: 10px 10px 0 0;
	}
	#services-category-tbl_wrapper .services-category-controls-highlight .dataTables_length {
		margin-top: 4px;
	}
	#services-category-tbl_wrapper .services-category-controls-highlight .dataTables_filter {
		margin: 0 0 0 auto;
	}
	#services-category-tbl_wrapper #services-category-tbl_filter .services-category-filter-highlight {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 2px 6px;
		background: rgba(255, 255, 255, 0.35);
		border: none;
		border-radius: 10px;
	}
	#services-category-tbl_wrapper #services-category-tbl_filter .services-category-filter-highlight label {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 0;
		font-size: 0;
		color: transparent;
	}
	#services-category-tbl_wrapper #services-category-tbl_filter .services-category-filter-highlight label input {
		margin-left: 0;
		border: none;
		outline: none;
		box-shadow: none;
		background: #fff;
		border-radius: 4px;
		padding: 6px 10px;
		font-size: 13px;
		color: #333;
		min-width: 160px;
	}
	#services-category-tbl_wrapper #services-category-tbl_filter .services-category-filter-highlight label input::placeholder {
		color: #8a92a6;
		opacity: 1;
	}
	#services-category-tbl_wrapper #services-category-tbl {
		margin-top: 0 !important;
	}
</style>
