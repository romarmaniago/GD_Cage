<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script>
	$(document).ready(function() {
		// Retrieve the permissions value from the data attribute
		const permissions = parseInt($('#user-role').data('permissions'));

		// Disable the submit button if permissions are 2
		if (permissions === 2) {
			$('#add_junket_capital button[type="submit"]').prop('disabled', true);
		}

		function refreshHouseBalanceCashLimit() {
			fetch('/dashboard_house_balances', { credentials: 'same-origin' })
				.then(function(res) { return res.json(); })
				.then(function(data) {
					if (!data || data.message) return;
					const cash = Math.round(Number(data.cashBalance) || 0);
					$('#cashbal').val(cash.toLocaleString('en-US'));
				})
				.catch(function(err) {
					console.error('refreshHouseBalanceCashLimit:', err);
				});
		}

		function fitCapitalProgramDatePicker(instance) {
			if (window.MonthEndCutoffRange && typeof window.MonthEndCutoffRange.fitSingleDatePickerInstance === 'function') {
				window.MonthEndCutoffRange.fitSingleDatePickerInstance(instance);
			}
		}

		function ensureCapitalProgramDatePicker() {
			var el = document.getElementById('capitalProgramDate');
			if (!el || typeof flatpickr === 'undefined') return;
			if (el._flatpickr) {
				el._flatpickr.destroy();
			}
			flatpickr(el, {
				enableTime: false,
				dateFormat: 'Y-m-d',
				altInput: true,
				altFormat: 'M j, Y',
				defaultDate: new Date(),
				allowInput: true,
				disableMobile: true,
				onReady: function (_selectedDates, _dateStr, instance) {
					fitCapitalProgramDatePicker(instance);
				},
				onChange: function (_selectedDates, _dateStr, instance) {
					fitCapitalProgramDatePicker(instance);
				},
				onClose: function (_selectedDates, _dateStr, instance) {
					fitCapitalProgramDatePicker(instance);
				}
			});
		}

		ensureCapitalProgramDatePicker();
		$('#modal-new-capital').on('shown.bs.modal', function() {
			ensureCapitalProgramDatePicker();
			setTimeout(function () {
				var el = document.getElementById('capitalProgramDate');
				if (el && el._flatpickr) fitCapitalProgramDatePicker(el._flatpickr);
			}, 0);
		});

		$('#modal-new-capital').on('shown.bs.modal', refreshHouseBalanceCashLimit);

		var HOUSE_BALANCE_ACTIVE_TYPES = {
			'Deposit': true,
			'Withdrawal': true
		};

		function isHouseBalanceTypeActive(label) {
			return !!(label && HOUSE_BALANCE_ACTIVE_TYPES[String(label)]);
		}

		function getSelectedCapitalType() {
			const $checked = $('#add_junket_capital .hb-type-check:checked');
			if (!$checked.length) return null;
			return {
				label: $checked.val(),
				txn: String($checked.data('txn') || ''),
			};
		}

		function updateCapitalTypeFields() {
			const selected = getSelectedCapitalType();
			if (!selected) {
				$('#optWithdrawDeposit').val('');
				$('#description').val('');
				return;
			}
			$('#optWithdrawDeposit').val(selected.txn);
			$('#description').val('<span class="css-blue">' + selected.label + '</span>');
		}

		$('#add_junket_capital').on('change', '.hb-type-check', function () {
			if (this.checked) {
				$('#add_junket_capital .hb-type-check').not(this).prop('checked', false);
			}
			updateCapitalTypeFields();
		});

		$('#add_junket_capital').on('submit', function(e) {
			e.preventDefault();

			const $form = $(this);

			function formatNumberWithCommas(x) {
				return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
			}

			const rawAmount = ($('#txtAmount').val() || '').toString().replace(/,/g, '').trim();
			const txtAmount = rawAmount === '' ? NaN : parseFloat(rawAmount);
			const cashbal = parseFloat(($('#cashbal').val() || '0').toString().replace(/,/g, '')) || 0;

			if (!Number.isFinite(txtAmount) || txtAmount <= 0) {
				Swal.fire({
					icon: 'warning',
					title: 'Amount required',
					text: 'Enter a valid amount greater than zero in Junket Balance Amount.',
					confirmButtonText: 'OK'
				});
				return;
			}

			const programDateEl = document.getElementById('capitalProgramDate');
			const programDateVal = (programDateEl && programDateEl.value ? programDateEl.value : '').trim();
			if (!/^\d{4}-\d{2}-\d{2}$/.test(programDateVal)) {
				Swal.fire({
					icon: 'warning',
					title: 'Program Date required',
					text: 'Select a valid Program Date before saving.',
					confirmButtonText: 'OK'
				});
				return;
			}

			const selectedType = getSelectedCapitalType();
			if (!selectedType) {
				Swal.fire({ icon: 'warning', title: 'Transaction type', text: 'Select a transaction type.' });
				return;
			}
			/* Only Deposit / Withdrawal are live; other types are on process for now */
			if (!isHouseBalanceTypeActive(selectedType.label)) {
				Swal.fire({
					icon: 'info',
					title: 'On process',
					text: 'on process',
					confirmButtonText: 'OK'
				});
				return;
			}
			updateCapitalTypeFields();

			const isCashOutSelected = selectedType.txn === "2";

			if (isCashOutSelected && txtAmount > cashbal) {
				Swal.fire({
					icon: 'error',
					title: 'Insufficient Balance',
					text: 'The amount exceeds the available cash balance of ' + formatNumberWithCommas(cashbal) + '.',
					confirmButtonText: 'OK'
				});
				return;
			}

			const typeLabel = selectedType.label;
			const amountStr = formatNumberWithCommas(txtAmount);

			SwalConfirm.fire({
				title: 'Confirm transaction',
				rows: [
					['Program Date', programDateVal],
					['Type', typeLabel],
					['Amount', amountStr]
				],
				message: 'Save this house balance record?',
				confirmButtonText: 'Yes'
			}).then(function(result) {
				if (!result.isConfirmed) {
					return;
				}
				var $btn = $form.find("button[type='submit']");
				$btn.prop('disabled', true).html(
					'<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Loading...'
				);
				setTimeout(function() {
					if ($form[0] && typeof $form[0].submit === 'function') {
						$form[0].submit();
					}
				}, 0);
			});
		});
	});

	function updateDescription() {
		const $checked = $('#add_junket_capital .hb-type-check:checked');
		if (!$checked.length) {
			$('#description').val('');
			$('#optWithdrawDeposit').val('');
			return;
		}
		$('#optWithdrawDeposit').val(String($checked.data('txn') || ''));
		$('#description').val('<span class="css-blue">' + $checked.val() + '</span>');
	}
</script>


<script>
	$(document).ready(function () {
		$("input[data-type='number']").keyup(function (event) {
			// skip for arrow keys
			if (event.which >= 37 && event.which <= 40) {
				event.preventDefault();
			}
			var $this = $(this);
			var num = $this.val().replace(/,/gi, "");
			var num2 = num.split(/(?=(?:\d{3})+$)/).join(",");
			$this.val(num2);
		});
	});

	function onlyNumberKey(evt) {
		let ASCIICode = (evt.which) ? evt.which : evt.keyCode;
		if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57))
			return false;
		return true;
	}
</script>
