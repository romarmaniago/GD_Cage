#modal-new-capital .hb-entry-field .form-label {
	margin-bottom: 0.25rem;
}

/* Category cells — each opens the category popup */
#modal-new-capital .hb-category-grid {
	display: grid;
	grid-template-columns: repeat(7, minmax(0, 1fr));
	gap: 0.5rem;
}

#modal-new-capital .hb-category-btn {
