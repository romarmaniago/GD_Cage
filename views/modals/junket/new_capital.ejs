	<div class="modal fade" id="modal-new-capital" role="dialog" aria-labelledby="modal-default-popout" aria-hidden="true"
		data-keyboard="false" data-bs-backdrop="static">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				
					<div class="modal-header bg-primary ">
						<h5 class="block-title text-white"><%= __('dashboard_new_capital.house_balance') %></h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="loading-overlay" style="display: none;">
						<div class="progress-container">
							<div class="progress-bar"></div>
							<p><%= __('dashboard_new_capital.loading_house_balance') %></p>
						</div>
					</div>
				
					
					<div class="modal-body">
						<form id="add_junket_capital" action="/add_junket_capital" method="POST">
							<%# Manager (11): table only, no entry panel %>
							<div class="house-balance-entry-panel<%= String(permissions) === '11' ? ' d-none' : '' %>">
								<div class="hb-entry-grid">
									<div class="hb-entry-field hb-entry-date">
										<label for="capitalProgramDate" class="form-label"><%= __('dashboard_new_capital.program_date') %></label>
										<input type="text" id="capitalProgramDate" name="txtProgramDate" class="form-control input-program-date" placeholder="<%= __('dashboard_new_capital.program_date') %>" autocomplete="off" required/>
									</div>
									<div class="hb-entry-field hb-entry-amount">
										<label for="txtAmount" class="form-label"><%= __('dashboard_new_capital.deposit_withdrawal') %></label>
										<input type="text" id="txtAmount" name="txtAmount" class="form-control hb-field-amount" placeholder="+ / - Amount" title="+ Deposit, - Withdrawal" onkeypress="return onlyCapitalSignedAmountKey(event)" data-type="signed-amount" autocomplete="off"/>
									</div>
									<div class="hb-entry-field hb-entry-remarks">
										<label for="capitalRemarks" class="form-label"><%= __('dashboard_new_capital.remarks_placeholder') %></label>
										<input type="text" class="form-control" id="capitalRemarks" name="Remarks" placeholder="<%= __('dashboard_new_capital.remarks_placeholder') %>" autocomplete="off"/>
									</div>
								</div>

								<%# Each opens the category modal (multi-row entry); only Transfer has an account column %>
								<div class="hb-category-grid" role="group" aria-label="Category">
									<button type="button" class="hb-category-btn" data-category="Transfer" data-title="<%= __('dashboard_new_capital.type_transfer') %>"><%= __('dashboard_new_capital.choose_an_account') %></button>
									<button type="button" class="hb-category-btn" data-category="Credit" data-title="<%= __('dashboard_new_capital.type_credit') %>"><%= __('dashboard_new_capital.type_credit') %></button>
									<button type="button" class="hb-category-btn" data-category="Expenses" data-title="<%= __('dashboard_new_capital.type_expenses') %>"><%= __('dashboard_new_capital.type_expenses') %></button>
									<button type="button" class="hb-category-btn" data-category="Loss Amount" data-title="<%= __('dashboard_new_capital.type_loss_amount') %>"><%= __('dashboard_new_capital.type_loss_amount') %></button>
									<button type="button" class="hb-category-btn" data-category="Add Charge" data-title="<%= __('dashboard_new_capital.type_add_charge') %>"><%= __('dashboard_new_capital.type_add_charge') %></button>
									<button type="button" class="hb-category-btn" data-category="Settlement (Commission)" data-title="<%= __('dashboard_new_capital.type_settlement_commission') %>"><%= __('dashboard_new_capital.type_settlement_commission') %></button>
									<button type="button" class="hb-category-btn" data-category="Settlement (Additional)" data-title="<%= __('dashboard_new_capital.type_settlement_additional') %>"><%= __('dashboard_new_capital.type_settlement_additional') %></button>
								</div>

								<div class="house-balance-form-actions">
									<button type="submit" class="btn btn-sm btn-primary" data-view-only-disable><i class="fa fa-check-circle me-1"></i><%= __('dashboard_new_capital.save') %></button>
								</div>
							</div>

							<%
								function sumHouseBalanceServiceTotals(rows) {
									if (!rows || !rows.length) return 0;
									return rows.reduce(function(sum, row) { return sum + (+row.TOTAL || 0); }, 0);
								}
								let refCashBal = (typeof cashBalance !== 'undefined' && cashBalance !== null) ? Number(cashBalance) : 0;
								if (typeof sqlCashDeposit !== 'undefined' && sqlCashDeposit && sqlCashDeposit[0]) {
									const refCashInTotal =
										(+sqlCashDeposit[0].CASH_DEPOSIT || 0) +
										(+sqlAccountDepositCashIn[0].ACCOUNT_DEPOSIT || 0) +
										(+sqlSettlementDepositAmount[0].SETTLEMENT_DEPOSIT || 0) +
										(+sqlTotalChipsCashout[0].TotalChipsCashout || 0) +
										(+sqlNNChipsAccountCash[0].TOTAL_NN_CASH || 0) +
										(+sqlCCChipsBuyinCashOnly[0].CC_CHIPS_BUYIN_CASH_ONLY || 0) +
										sumHouseBalanceServiceTotals(sqlServiceCashGuest) +
										sumHouseBalanceServiceTotals(sqlServiceDepositGuest) +
										(+sqlMArkerReturnCash[0].MARKER_RETURN_CASH || 0) +
										(+sqlRollerTipCashOut[0].ROLLER_TIP_CASHIN || 0) +
										(+sqlRollerTipIn[0].TIP_IN_CASHIN || 0);
									const refCashOutTotal =
										(+sqlCCChipsBuyin[0].CCChipsBuyin || 0) +
										(+sqlCashWithdraw[0].CASH_WITHDRAW || 0) +
										(+sqlJunketExpense[0].JUNKET_EXPENSE || 0) +
										(+sqlNNChipsBuyin[0].NNChipsBuyin || 0) +
										(+sqlAccountWithdraw[0].ACCOUNT_WITHDRAW || 0) +
										(+sqlTotalCashOut[0].TOTAL_CASHOUT || 0) +
										(+sqlAccountSettlement[0].ACCOUNT_SETTLEMENT || 0) +
										(+sqlAccountServicesDeduct[0].ACCOUNT_DEDUCT_SERVICES || 0) +
										(+sqlMarkerIssueAccount[0].TOTAL_ISSUE_RECORD || 0) +
										sumHouseBalanceServiceTotals(sqlServiceCashJunket) +
										sumHouseBalanceServiceTotals(sqlServiceDepositJunket) +
										(+sqlAccountTransfer[0].ACCOUNT_TRANSFER || 0) +
										(+sqlManualBalancing[0].MANUAL_BALANCING || 0) +
										(+sqlJunketLoss[0].JUNKET_LOSS_CASH || 0) +
										(+sqlTipSettlement[0].TIP_SETTLEMENT || 0);
									refCashBal = refCashInTotal - refCashOutTotal + (+sqlMxCashNet[0].MX_CASH_NET || 0);
								}
								// Prefer the dashboard's balancing PHP figure (Balance Total - NN - CC - RC)
								// so the SSR value matches the live /dashboard_house_balances refresh and
								// the capital-withdraw limit reconciles with the Cage Balance card.
								const refCashDisplay = (typeof housePhpDisplay !== 'undefined' && housePhpDisplay !== null)
									? Number(housePhpDisplay)
									: Number(refCashBal || 0);
								const refCashBalStr = refCashDisplay.toLocaleString('en-US');
							%>
							<input type="hidden" value="<%= refCashBalStr %>" id="cashbal" name="txtcashbal"/>

							<hr class="my-2<%= String(permissions) === '11' ? ' d-none' : '' %>" style="border-color: #dee2e6;">
							<div class="custom-datatable-entries">
							<div class="capital-daterange-slot" id="capital-daterange-slot">
								<div class="hb-field-daterange-wrap">
									<input
										type="text"
										id="capital-daterange"
										class="form-control form-control-sm"
										placeholder="<%= __('fnb_hotel.date') %>"
										autocomplete="off"
										readonly
									>
								</div>
								<%- include('../../partials/split_daterange', {
									splitPrefix: 'capital',
									splitLocaleNs: 'house_expense',
									splitWrapClass: 'capital-split-daterange house-expense-split-daterange'
								}) %>
							</div>
							<div class="hb-print-export-actions" id="capital-print-export-slot">
								<button type="button" id="btn-capital-print" class="btn btn-sm">
									<i class="fa fa-print" aria-hidden="true"></i><span><%= __('dashboard_new_capital.print') %></span>
								</button>
								<button type="button" id="btn-capital-export" class="btn btn-sm">
									<i class="fa fa-file-excel" aria-hidden="true"></i><span><%= __('dashboard_new_capital.export') %></span>
								</button>
							</div>
							<div class="table-responsive capital-tbl-scroll">
							<table
								id="capital-tbl"
								class="table table-bordered table-hover"
								style="width:100%"
							>
								<thead>
									<tr>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.program_date_col') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.date_time') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.amount') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.type') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.remarks') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.encoded_by') %></th>
										<th class="d-none d-sm-table-cell text-center"><%= __('dashboard_new_capital.action') %></th>
									</tr>
								</thead>
								<tbody>
								</tbody>
							</table>
							</div>
							</div>
						</form>
					</div>
					
					<div class="modal-footer">
						<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('dashboard_new_capital.close') %></button>
					</div>
				
		</div>
	</div>
</div>

