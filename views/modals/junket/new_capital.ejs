	}

	#modal-new-capital .hb-field-daterange-wrap input,
	#modal-new-capital .hb-field-daterange-wrap .flatpickr-alt-input,
	#modal-new-capital .hb-field-daterange-wrap .flatpickr-input.form-control {
		width: auto;
		min-width: 10rem;
		max-width: none;
		font-size: 0.875rem;
		overflow: visible;
		text-overflow: clip;
		white-space: nowrap;
		box-sizing: border-box;
	}

	#modal-new-capital .hb-field-program-date-wrap input,
	#modal-new-capital .hb-field-program-date-wrap .flatpickr-alt-input,
	#modal-new-capital .hb-field-program-date-wrap .flatpickr-input.form-control {
		width: auto;
		min-width: 0;
		max-width: none;
		font-size: 0.875rem;
		overflow: visible;
		text-overflow: clip;
		white-space: nowrap;
		box-sizing: border-box;
		text-align: center;
		field-sizing: content;
	}

	#capital-tbl {
width: 100%;
font-size: 13px;
border-collapse: collapse;
table-layout: fixed;
}

/* Header styles */
#capital-tbl thead th {
background: var(--bs-primary-bg-subtle);
color: var(--bs-primary);
font-weight: 500;
padding: 12px 15px;
text-align: left;
border: none;
}

/* Row styles */
#capital-tbl tbody tr {
border-bottom: 1px solid #eee;
}

/* Cell styles */
#capital-tbl td {
	padding: 12px 15px;
	color: #666;
	vertical-align: top;
}

#capital-tbl tbody tr:hover {
background-color: #f5f5f5 !important;
}



/* Balance column */
#capital-tbl td:last-child {
text-align: right;
color: #333;
}

#capital-tbl col.col-encoded {
	width: 14%;
}

#capital-tbl col.col-amount {
	width: 24%;
}

#capital-tbl col.col-type {
	width: 12%;
}

#capital-tbl col.col-remarks {
	width: 26%;
}

#capital-tbl col.col-date {
	width: 16%;
}

#capital-tbl col.col-action {
	width: 8%;
}

#capital-tbl th,
#capital-tbl td {
	overflow: visible;
	text-overflow: unset;
}

#capital-tbl th,
#capital-tbl td:not(:nth-child(4)) {
	white-space: nowrap;
	word-break: normal;
}

#capital-tbl td:nth-child(4) {
	white-space: normal;
	word-break: break-word;
}


/* Footer total row */


#capital-tbl tfoot th {
padding: 10px;
font-weight: 600;

color: #333;
background-color: #f4f6fa;
border-top: 2px solid #dee2e6;
}




</style>

	<div class="modal fade" id="modal-new-capital" role="dialog" aria-labelledby="modal-default-popout" aria-hidden="true"
		data-keyboard="false" data-bs-backdrop="static">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				
					<div class="modal-header bg-primary ">
						<h5 class="block-title text-white"><%= __('dashboard_new_capital.house_balance') %></h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="loading-overlay" style="display: none;">
						<div class="progress-container">
							<div class="progress-bar"></div>
							<p><%= __('dashboard_new_capital.loading_house_balance') %></p>
						</div>
					</div>
				
					
					<div class="modal-body">
						<form id="add_junket_capital" action="/add_junket_capital" method="POST">
							<div class="row house-balance-filter-row">
								<div class="col-12">
									<div class="house-balance-date-controls">
										<div class="hb-field-daterange-wrap">
											<input type="text" id="main-daterange" name="daterange" class="form-control form-control-sm input-daterange" placeholder="<%= __('dashboard_new_capital.select_date_range') %>" autocomplete="off"/>
										</div>
										<div class="hb-field-program-date-wrap">
											<input type="text" id="capitalProgramDate" name="txtProgramDate" class="form-control form-control-sm input-program-date" placeholder="<%= __('dashboard_new_capital.program_date') %>" autocomplete="off" required/>
										</div>
									</div>
								</div>
							</div>
							<div class="row g-2 align-items-center house-balance-form-row">
								<div class="col-auto">
									<input type="text" id="txtAmount" name="txtAmount" class="form-control form-control-sm hb-field-amount" placeholder="<%= __('dashboard_new_capital.junket_balance_amount') %>" onkeypress="return onlyNumberKey(event)" data-type="number" autocomplete="off"/>
								</div>
								<div class="col-12">
									<textarea class="form-control form-control-sm" name="Remarks" placeholder="<%= __('dashboard_new_capital.remarks_placeholder') %>" rows="2"></textarea>
								</div>
							</div>
							
							<div class="row mb-2 align-items-center mt-2 justify-content-end g-2">
								<div class="col-auto">
									<div class="form-check">
										<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="deposit" name="optWithdrawDeposit" value="1" onclick="updateDescription()" required>
										<label class="form-check-label" for="deposit"><%= __('dashboard_new_capital.cash_in') %></label>
									</div>
								</div>
								<div class="col-auto">
									<div class="form-check">
										<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="withdraw" name="optWithdrawDeposit" value="2" onclick="updateDescription()" required>
										<label class="form-check-label" for="withdraw"><%= __('dashboard_new_capital.cash_out') %></label>
									</div>
								</div>
								<div class="col-auto">
									<button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-check-circle me-1"></i><%= __('dashboard_new_capital.save') %></button>
								</div>
							</div>
							
							<%
								function sumHouseBalanceServiceTotals(rows) {
									if (!rows || !rows.length) return 0;
									return rows.reduce(function(sum, row) { return sum + (+row.TOTAL || 0); }, 0);
								}
								let refCashBal = (typeof cashBalance !== 'undefined' && cashBalance !== null) ? Number(cashBalance) : 0;
								if (typeof sqlCashDeposit !== 'undefined' && sqlCashDeposit && sqlCashDeposit[0]) {
									const refCashInTotal =
										(+sqlCashDeposit[0].CASH_DEPOSIT || 0) +
										(+sqlAccountDeposit[0].ACCOUNT_DEPOSIT || 0) +
										(+sqlSettlementDepositAmount[0].SETTLEMENT_DEPOSIT || 0) +
										(+sqlTotalChipsCashout[0].TotalChipsCashout || 0) +
										(+sqlNNChipsAccountCash[0].TOTAL_NN_CASH || 0) +
										(+sqlCCChipsBuyinCashOnly[0].CC_CHIPS_BUYIN_CASH_ONLY || 0) +
										sumHouseBalanceServiceTotals(sqlServiceCashGuest) +
										sumHouseBalanceServiceTotals(sqlServiceDepositGuest) +
										(+sqlMArkerReturnCash[0].MARKER_RETURN_CASH || 0) +
										(+sqlRollerTipCashOut[0].ROLLER_TIP_CASHIN || 0) +
										(+sqlRollerTipIn[0].TIP_IN_CASHIN || 0);
									const refCashOutTotal =
										(+sqlCCChipsBuyin[0].CCChipsBuyin || 0) +
										(+sqlCashWithdraw[0].CASH_WITHDRAW || 0) +
										(+sqlJunketExpense[0].JUNKET_EXPENSE || 0) +
										(+sqlNNChipsBuyin[0].NNChipsBuyin || 0) +
										(+sqlAccountWithdraw[0].ACCOUNT_WITHDRAW || 0) +
										(+sqlTotalCashOut[0].TOTAL_CASHOUT || 0) +
										(+sqlAccountSettlement[0].ACCOUNT_SETTLEMENT || 0) +
										(+sqlAccountServicesDeduct[0].ACCOUNT_DEDUCT_SERVICES || 0) +
										(+sqlMarkerIssueAccount[0].TOTAL_ISSUE_RECORD || 0) +
										sumHouseBalanceServiceTotals(sqlServiceCashJunket) +
										sumHouseBalanceServiceTotals(sqlServiceDepositJunket) +
										(+sqlAccountTransfer[0].ACCOUNT_TRANSFER || 0) +
										(+sqlManualBalancing[0].MANUAL_BALANCING || 0) +
										(+sqlJunketLoss[0].JUNKET_LOSS || 0) +
										(+sqlTipSettlement[0].TIP_SETTLEMENT || 0);
									refCashBal = refCashInTotal - refCashOutTotal + (+sqlMxCashNet[0].MX_CASH_NET || 0);
								}
								const refCashBalStr = Number(refCashBal || 0).toLocaleString('en-US');
							%>
							<input type="hidden" value="<%= refCashBalStr %>" id="cashbal" name="txtcashbal"/>
							
							<input type="hidden" name="description" id="description" value="Cash-in">
							
							<hr class="my-2" style="border-color: #dee2e6;">
							<div class="custom-datatable-entries">
							<table
								id="capital-tbl"
								class="table table-bordered table-hover"
								style="width:100%"
							>
								<colgroup>
									<col class="col-encoded">
									<col class="col-amount">
									<col class="col-type">
									<col class="col-remarks">
									<col class="col-date">
									<col class="col-action">
								</colgroup>
								<thead>
									<tr>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.encoded_by') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.amount') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.type') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.remarks') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.date') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.action') %></th>
									</tr>
								</thead>
								<tbody>
								</tbody>
							</table>
						</form>
					</div>
					</div>
					
					<div class="modal-footer">
						<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('dashboard_new_capital.close') %></button>
					</div>
				
		</div>
	</div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script>
	$(document).ready(function() {
		// Retrieve the permissions value from the data attribute
		const permissions = parseInt($('#user-role').data('permissions'));

		// Disable the submit button if permissions are 2
		if (permissions === 2) {
			$('#add_junket_capital button[type="submit"]').prop('disabled', true);
		}

		function refreshHouseBalanceCashLimit() {
			fetch('/dashboard_house_balances', { credentials: 'same-origin' })
				.then(function(res) { return res.json(); })
				.then(function(data) {
					if (!data || data.message) return;
					const cash = Math.round(Number(data.cashBalance) || 0);
					$('#cashbal').val(cash.toLocaleString('en-US'));
				})
				.catch(function(err) {
					console.error('refreshHouseBalanceCashLimit:', err);
				});
		}

		function fitCapitalProgramDatePicker(instance) {
			if (window.MonthEndCutoffRange && typeof window.MonthEndCutoffRange.fitSingleDatePickerInstance === 'function') {
				window.MonthEndCutoffRange.fitSingleDatePickerInstance(instance);
			}
		}

		function ensureCapitalProgramDatePicker() {
			var el = document.getElementById('capitalProgramDate');
			if (!el || typeof flatpickr === 'undefined') return;
			if (el._flatpickr) {
				el._flatpickr.destroy();
			}
			flatpickr(el, {
				enableTime: false,
				dateFormat: 'Y-m-d',
				altInput: true,
				altFormat: 'M j, Y',
				defaultDate: new Date(),
				allowInput: true,
				disableMobile: true,
				onReady: function (_selectedDates, _dateStr, instance) {
					fitCapitalProgramDatePicker(instance);
				},
				onChange: function (_selectedDates, _dateStr, instance) {
					fitCapitalProgramDatePicker(instance);
				},
				onClose: function (_selectedDates, _dateStr, instance) {
					fitCapitalProgramDatePicker(instance);
				}
			});
		}

		ensureCapitalProgramDatePicker();
		$('#modal-new-capital').on('shown.bs.modal', function() {
			ensureCapitalProgramDatePicker();
			setTimeout(function () {
				var el = document.getElementById('capitalProgramDate');
				if (el && el._flatpickr) fitCapitalProgramDatePicker(el._flatpickr);
			}, 0);
		});

		$('#modal-new-capital').on('shown.bs.modal', refreshHouseBalanceCashLimit);

		$('#add_junket_capital').on('submit', function(e) {
			e.preventDefault();

			const $form = $(this);

			function formatNumberWithCommas(x) {
				return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
			}

			const rawAmount = ($('#txtAmount').val() || '').toString().replace(/,/g, '').trim();
			const txtAmount = rawAmount === '' ? NaN : parseFloat(rawAmount);
			const cashbal = parseFloat(($('#cashbal').val() || '0').toString().replace(/,/g, '')) || 0;

			if (!Number.isFinite(txtAmount) || txtAmount <= 0) {
				Swal.fire({
					icon: 'warning',
					title: 'Amount required',
					text: 'Enter a valid amount greater than zero in Junket Balance Amount.',
					confirmButtonText: 'OK'
				});
				return;
			}

			const programDateEl = document.getElementById('capitalProgramDate');
			const programDateVal = (programDateEl && programDateEl.value ? programDateEl.value : '').trim();
			if (!/^\d{4}-\d{2}-\d{2}$/.test(programDateVal)) {
				Swal.fire({
					icon: 'warning',
					title: 'Program Date required',
					text: 'Select a valid Program Date before saving.',
					confirmButtonText: 'OK'
				});
				return;
			}

			const checkedRadio = document.querySelector('input[name="optWithdrawDeposit"]:checked');
			if (!checkedRadio) {
				Swal.fire({ icon: 'warning', title: 'Transaction type', text: 'Select Cash-in or Cash-out.' });
				return;
			}

			const isCashOutSelected = checkedRadio.value === "2";

			if (isCashOutSelected && txtAmount > cashbal) {
				Swal.fire({
					icon: 'error',
					title: 'Insufficient Balance',
					text: 'The amount exceeds the available cash balance of ' + formatNumberWithCommas(cashbal) + '.',
					confirmButtonText: 'OK'
				});
				return;
			}

			const typeLabel = isCashOutSelected ? 'Cash-out' : 'Cash-in';
			const amountStr = formatNumberWithCommas(txtAmount);

			SwalConfirm.fire({
				title: 'Confirm transaction',
				rows: [
					['Program Date', programDateVal],
					['Type', typeLabel],
					['Amount', amountStr]
				],
				message: 'Save this house balance record?',
				confirmButtonText: 'Yes'
			}).then(function(result) {
				if (!result.isConfirmed) {
					return;
				}
				var $btn = $form.find("button[type='submit']");
				$btn.prop('disabled', true).html(
					'<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Loading...'
				);
				setTimeout(function() {
					if ($form[0] && typeof $form[0].submit === 'function') {
						$form[0].submit();
					}
				}, 0);
			});
		});
	});

	function updateDescription() {
	  const isCashIn = document.getElementById('deposit').checked;
	  document.getElementById('description').value = isCashIn ? 
	  '<span class="css-blue">Cash-in</span>' 
	  : '<span class="css-blue">Cash-out</span>';
	}
</script>


<script>
	$(document).ready(function () {
		$("input[data-type='number']").keyup(function (event) {
			// skip for arrow keys
			if (event.which >= 37 && event.which <= 40) {
				event.preventDefault();
			}
			var $this = $(this);
			var num = $this.val().replace(/,/gi, "");
			var num2 = num.split(/(?=(?:\d{3})+$)/).join(",");
			$this.val(num2);
		});
	});

	function onlyNumberKey(evt) {
		let ASCIICode = (evt.which) ? evt.which : evt.keyCode;
		if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57))
			return false;
		return true;
	}
</script>
