	gap: 0.75rem;
	margin-bottom: 0.75rem;
}

/* Program Date on its own line; Deposit / Withdrawal + Remarks below */
#modal-new-capital .hb-entry-grid .hb-entry-date {
	grid-column: 1;
	grid-row: 1;
}

#modal-new-capital .hb-entry-grid .hb-entry-amount {
	grid-column: 1;
	grid-row: 2;
}

#modal-new-capital .hb-entry-grid .hb-entry-remarks {
	grid-column: 2;
	grid-row: 2;
}

/* Negative house-balance amount while typing: red (1,000) */
