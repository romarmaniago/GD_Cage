							</div>
							<div class="hb-print-export-actions" id="capital-print-export-slot">
								<button type="button" id="btn-capital-print" class="btn btn-sm">
									<i class="fa fa-print" aria-hidden="true"></i><span><%= __('dashboard_new_capital.print') %></span>
								</button>
								<button type="button" id="btn-capital-export" class="btn btn-sm">
									<i class="fa fa-file-excel" aria-hidden="true"></i><span><%= __('dashboard_new_capital.export') %></span>
								</button>
							</div>
							<div class="table-responsive capital-tbl-scroll">
							<table
								id="capital-tbl"
								class="table table-bordered table-hover"
								style="width:100%"
							>
								<thead>
									<tr>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.program_date_col') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.date_time') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.amount') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.type') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.remarks') %></th>
										<th class="d-none d-sm-table-cell"><%= __('dashboard_new_capital.encoded_by') %></th>
										<th class="d-none d-sm-table-cell text-center"><%= __('dashboard_new_capital.action') %></th>
									</tr>
								</thead>
								<tbody>
								</tbody>
							</table>
							</div>
							</div>
						</form>
					</div>
					
					<div class="modal-footer">
						<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('dashboard_new_capital.close') %></button>
					</div>
				
		</div>
	</div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script>
	$(document).ready(function() {
		// Retrieve the permissions value from the data attribute
		const permissions = parseInt($('#user-role').data('permissions'));

		// Disable the submit button if permissions are 2
		if (permissions === 2) {
			$('#add_junket_capital button[type="submit"]').prop('disabled', true);
		}

		function refreshHouseBalanceCashLimit() {
			fetch('/dashboard_house_balances', { credentials: 'same-origin' })
				.then(function(res) { return res.json(); })
				.then(function(data) {
					if (!data || data.message) return;
					// Mirror the dashboard PHP figure (Balance Total - NN - CC - RC) so the
					// capital-withdraw limit reconciles with the Cage Balance card.
					const cash = Math.round(Number(data.php_display != null ? data.php_display : data.cashBalance) || 0);
					$('#cashbal').val(cash.toLocaleString('en-US'));
				})
				.catch(function(err) {
					console.error('refreshHouseBalanceCashLimit:', err);
				});
		}

		function ensureCapitalProgramDatePicker() {
			var el = document.getElementById('capitalProgramDate');
			if (!el || typeof flatpickr === 'undefined') return;
			if (el._flatpickr) {
				el._flatpickr.destroy();
			}
			flatpickr(el, {
				enableTime: false,
				dateFormat: 'Y-m-d',
				altInput: true,
				altFormat: 'M j, Y',
				defaultDate: new Date(),
				allowInput: true,
				disableMobile: true,
				closeOnSelect: true
			});
		}

		ensureCapitalProgramDatePicker();
		$('#modal-new-capital').on('shown.bs.modal', function() {
			ensureCapitalProgramDatePicker();
		});

		$('#modal-new-capital').on('shown.bs.modal', refreshHouseBalanceCashLimit);

		var HOUSE_BALANCE_ACTIVE_TYPES = {
			'Transfer': true,
			'Deposit': true,
			'Withdrawal': true,
			'Loss Amount': true,
			'Settlement': true,
			'F&B': true,
			'Hotel': true,
			'Incidental': true,
			'Expenses': true
		};

		function isHouseBalanceTypeActive(label) {
			return !!(label && HOUSE_BALANCE_ACTIVE_TYPES[String(label)]);
		}

		function getSelectedCapitalType() {
			const $checked = $('#add_junket_capital .hb-type-check:checked');
			if (!$checked.length) return null;
			return {
				label: $checked.val(),
				txn: String($checked.data('txn') || ''),
			};
		}

		function updateCapitalTypeFields() {
			const selected = getSelectedCapitalType();
			if (!selected) {
				$('#optWithdrawDeposit').val('');
				$('#description').val('');
				return;
			}
			$('#optWithdrawDeposit').val(selected.txn);
			$('#description').val('<span class="css-blue">' + selected.label + '</span>');
		}

		$('#add_junket_capital').on('change', '.hb-type-check', function () {
			if (this.checked) {
				$('#add_junket_capital .hb-type-check').not(this).prop('checked', false);
			}
			updateCapitalTypeFields();
			if (typeof syncCapitalTransferUi === 'function') {
				syncCapitalTransferUi('#add_junket_capital', '#capital-transfer-account-wrap', '#capital-transfer-account');
			}
		});

		if (typeof initCapitalTransferAccountUi === 'function') {
			initCapitalTransferAccountUi({
				modalSelector: '#modal-new-capital',
				wrapSelector: '#capital-transfer-account-wrap',
				selectSelector: '#capital-transfer-account',
				hintSelector: '#capital-transfer-account-hint',
				typeCheckSelector: '#add_junket_capital .hb-type-check'
			});
		}

		$('#add_junket_capital').on('submit', function(e) {
			e.preventDefault();

			const $form = $(this);
			const parsedAmount = (typeof parseCapitalSignedAmount === 'function')
				? parseCapitalSignedAmount($('#txtAmount').val())
				: { ok: false };
			const cashbal = parseFloat(($('#cashbal').val() || '0').toString().replace(/,/g, '')) || 0;

			if (!parsedAmount.ok) {
				Swal.fire({
					icon: 'warning',
					title: 'Amount required',
					text: 'Enter a valid amount with + (dagdag) or - (bawas), e.g. +5,000 or -5,000.',
					confirmButtonText: 'OK'
				});
				return;
			}

			const programDateEl = document.getElementById('capitalProgramDate');
			const programDateVal = (programDateEl && programDateEl.value ? programDateEl.value : '').trim();
			if (!/^\d{4}-\d{2}-\d{2}$/.test(programDateVal)) {
				Swal.fire({
					icon: 'warning',
					title: 'Program Date required',
					text: 'Select a valid Program Date before saving.',
					confirmButtonText: 'OK'
				});
				return;
			}

			const selectedType = getSelectedCapitalType();
			if (!selectedType || !isHouseBalanceTypeActive(selectedType.label)) {
				Swal.fire({ icon: 'warning', title: 'Transaction type', text: 'Select a transaction type.' });
				return;
			}
			if (selectedType.label === 'Transfer') {
				const accountId = ($('#capital-transfer-account').val() || '').trim();
				if (!accountId) {
					Swal.fire({ icon: 'warning', title: 'Account required', text: 'Select an account for transfer.' });
					return;
				}
				const transferCheck = (typeof validateCapitalTransferAmount === 'function')
					? validateCapitalTransferAmount('#capital-transfer-account', parsedAmount)
					: { ok: true };
				if (!transferCheck.ok) {
					Swal.fire({
						icon: 'error',
						title: 'Insufficient Account Balance',
						text: transferCheck.message,
						confirmButtonText: 'OK'
					});
					return;
				}
			}
			updateCapitalTypeFields();
			// Amount +/- drives Capital In (1) / Out (2); category checkbox is the type label only
			$('#optWithdrawDeposit').val(parsedAmount.txn);

			if (parsedAmount.isOut && parsedAmount.abs > cashbal) {
				Swal.fire({
					icon: 'error',
					title: 'Insufficient Balance',
					text: 'The amount exceeds the available cash balance of ' + cashbal.toLocaleString('en-US') + '.',
					confirmButtonText: 'OK'
				});
				return;
			}

			const typeLabel = selectedType.label;
			const confirmRows = [
				['Program Date', programDateVal],
				['Type', typeLabel],
				['Amount', parsedAmount.display]
			];
			if (typeLabel === 'Transfer') {
				const accountLabel = $('#capital-transfer-account option:selected').text() || '-';
				confirmRows.splice(2, 0, ['Account', accountLabel]);
			}

			SwalConfirm.fire({
				title: 'Confirm transaction',
				rows: confirmRows,
				message: 'Save this house balance record?',
				confirmButtonText: 'Yes'
			}).then(function(result) {
				if (!result.isConfirmed) {
					return;
				}
				// Backend stores absolute amount; direction is TRANSACTION_ID from sign
				$('#txtAmount').val(parsedAmount.abs);
				$('#optWithdrawDeposit').val(parsedAmount.txn);
				var $btn = $form.find("button[type='submit']");
				$btn.prop('disabled', true).html(
					'<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Loading...'
				);
				setTimeout(function() {
					if ($form[0] && typeof $form[0].submit === 'function') {
						$form[0].submit();
					}
				}, 0);
			});
		});
	});

	function updateDescription() {
		const $checked = $('#add_junket_capital .hb-type-check:checked');
		if (!$checked.length) {
			$('#description').val('');
			$('#optWithdrawDeposit').val('');
			return;
		}
		$('#optWithdrawDeposit').val(String($checked.data('txn') || ''));
		$('#description').val('<span class="css-blue">' + $checked.val() + '</span>');
	}
</script>


<script>
	$(document).ready(function () {
		$(document).on('keyup input', 'input[data-type="signed-amount"], #txtAmount.hb-field-amount, #edit-capital-amount', function () {
			var $this = $(this);
			var formatted = (typeof formatCapitalSignedAmountInput === 'function')
				? formatCapitalSignedAmountInput($this.val())
				: $this.val();
			if ($this.val() !== formatted) {
				$this.val(formatted);
			}
		});
	});

	function onlyNumberKey(evt) {
		let ASCIICode = (evt.which) ? evt.which : evt.keyCode;
		if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57))
			return false;
		return true;
	}
</script>
