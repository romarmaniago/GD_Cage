<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>

<script>
	$(document).ready(function () {
		<%# House-balance amounts (.hb-field-amount) show negatives as red (1,000) — handled in capital.js %>
		$(document).on('keyup input', 'input[data-type="signed-amount"]:not(.hb-field-amount)', function () {
			var $this = $(this);
			var formatted = (typeof formatCapitalSignedAmountInput === 'function')
				? formatCapitalSignedAmountInput($this.val())
				: $this.val();
			if ($this.val() !== formatted) {
				$this.val(formatted);
			}
		});
	});

	function onlyNumberKey(evt) {
		let ASCIICode = (evt.which) ? evt.which : evt.keyCode;
		if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57))
			return false;
		return true;
	}
</script>
