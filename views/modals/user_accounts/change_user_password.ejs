<div class="modal fade" id="modal-change_password" role="dialog" aria-labelledby="modal-change-password" aria-hidden="true"
	data-keyboard="false" data-bs-backdrop="static">
	<div class="modal-dialog modal-dialog-centered" role="document">
		<div class="modal-content">
			<div class="modal-header bg-primary">
				<h5 class="block-title text-white"><%= __('modal_change_user_password.change_password') %></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="form_change_password" novalidate>
				<div class="modal-body">
					<p class="mb-3 text-muted"><%= __('modal_change_user_password.user') %>: <strong id="change_password_username"></strong></p>
					<div class="row mb-2">
						<div class="col-sm-12">
							<input type="password" class="form-control" name="txtPassword" placeholder="<%= __('modal_change_user_password.password_placeholder') %>"
								id="change_password_new" required>
						</div>
					</div>
					<div class="row mb-2">
						<div class="col-sm-12">
							<input type="password" class="form-control" name="txtPassword2"
								placeholder="<%= __('modal_change_user_password.confirm_password_placeholder') %>" id="change_password_confirm" required>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" id="btn_save_change_password" class="btn btn-sm btn-primary"><%= __('modal_change_user_password.save') %></button>
					<button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal"><%= __('modal_change_user_password.close') %></button>
				</div>
			</form>
		</div>
	</div>
</div>
