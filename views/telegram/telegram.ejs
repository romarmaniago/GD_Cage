				var panelLog = document.getElementById('telegram-panel-log');
				var telegramPath = '/telegramAPI';

				function syncUrl(which) {
					if (which === 'log') {
						history.replaceState(null, '', telegramPath + '#message-log');
					} else {
						history.replaceState(null, '', telegramPath);
					}
				}

				function showTab(which) {
					var isLog = which === 'log';
					panelSettings.classList.toggle('d-none', isLog);
					panelLog.classList.toggle('d-none', !isLog);
					tabSettings.classList.toggle('active', !isLog);
					tabLog.classList.toggle('active', isLog);
					tabSettings.setAttribute('aria-selected', isLog ? 'false' : 'true');
					tabLog.setAttribute('aria-selected', isLog ? 'true' : 'false');
					syncUrl(which);
					if (isLog && typeof window.__telegramMessageLogShow === 'function') {
						window.__telegramMessageLogShow();
					}
				}

				tabSettings.addEventListener('click', function (e) {
					e.preventDefault();
					showTab('settings');
				});
				tabLog.addEventListener('click', function (e) {
					e.preventDefault();
					showTab('log');
				});

				window.addEventListener('hashchange', function () {
					if (window.location.hash === '#message-log') {
						showTab('log');
					} else {
						showTab('settings');
					}
				});

				if (window.location.hash === '#message-log') {
					showTab('log');
				} else {
					showTab('settings');
				}
			})();
			</script>
