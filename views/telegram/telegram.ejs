		<style>
			/* Cream/light-gray theme */
			.card {
				background: linear-gradient(180deg, #f6f3ec 0%, #efe9db 100%) !important;
				border: 1px solid rgba(200, 162, 76, 0.4) !important;
			}
			.card-header {
				background: linear-gradient(180deg, #f6f3ec 0%, #efe9db 100%) !important;
				border-bottom: 1px solid rgba(200, 162, 76, 0.25) !important;
			}
			.marker-balance-card {
				background: linear-gradient(180deg, #fafbfc 0%, #ffffff 48px) !important;
				border: 1px solid rgba(15, 23, 42, 0.08) !important;
				border-radius: 12px !important;
				box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04) !important;
				padding: 0 !important;
			}

			.telegram-settings-page table.table-vcenter {
				border: 1px solid #e0e0e0 !important;
				border-collapse: collapse;
			}
			.telegram-settings-page table.table-vcenter thead tr {
				background-color: #f5f5f5 !important;
			}
			.telegram-settings-page table.table-vcenter thead th {
				background: #f5f5f5 !important;
				color: #555 !important;
				font-weight: 600;
				border: none;
				border-bottom: 1px solid #e0e0e0 !important;
				padding: 0.5rem 0.5rem;
			}
			.telegram-settings-page table.table-vcenter tbody tr:nth-child(even) td {
				background-color: #f4f1ea !important;
			}
			.telegram-settings-page table.table-vcenter tbody tr:nth-child(odd) td {
				background-color: #fff !important;
			}
			.telegram-settings-page table.table-vcenter tbody tr:hover td {
				background-color: #f6f3ec !important;
			}

			.table-vcenter td:nth-child(3) {
				word-wrap: break-word;
				word-break: break-word;
				overflow-wrap: break-word;
			}
			.table-vcenter tbody td {
				padding: 0.35rem 0.5rem;
				vertical-align: middle;
				line-height: 1.3;
			}
			.table-vcenter .btn-sm {
				padding: 0.2rem 0.4rem;
				font-size: 0.75rem;
				line-height: 1.2;
			}
			.table-vcenter .btn-sm i {
				font-size: 0.7rem;
			}
			.bot-section {
				border: 1px solid rgba(15, 23, 42, 0.08);
				border-radius: 0.375rem;
				padding: 1.5rem;
				margin-bottom: 2rem;
				background-color: #fafbfc;
			}
			.bot-section h4 {
				color: #555;
				margin-bottom: 1rem;
				padding-bottom: 0.5rem;
				border-bottom: 2px solid #e0e0e0;
			}
			#telegram-page-tabs a[role="tab"] {
				cursor: pointer;
				user-select: none;
			}
			.notify-toggle-switch.form-check-input {
				width: 2.15rem;
				height: 1.1rem;
				min-height: 1.1rem;
				cursor: pointer;
			}
			.notify-toggle-switch.form-check-input:not(:checked) {
				background-color: #dee2e6;
				border: 1px solid #adb5bd;
				--bs-form-switch-bg: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='%2364748b'/%3e%3c/svg%3e");
			}
			.notify-toggle-switch.form-check-input:checked {
				background-color: var(--bs-primary);
				border-color: var(--bs-primary);
			}
		</style>

