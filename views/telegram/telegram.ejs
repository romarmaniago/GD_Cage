			<!-- Modal: Add / Edit Chat ID -->
			<div class="modal fade" id="modal-chat-id" tabindex="-1" aria-labelledby="modal-chat-id-label" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content">
						<div class="modal-header">
							<h5 class="modal-title" id="modal-chat-id-label"><%= __('telegram_api.add_chat_id') %></h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>
						<div class="modal-body">
							<input type="hidden" id="modal-chat-id-user-type">
							<div class="mb-2">
								<label for="input-chat-id" class="form-label"><%= __('telegram_api.chat_id') %></label>
								<input type="text" class="form-control" id="input-chat-id">
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-primary" id="btn-save-chat-id"><%= __('telegram_api.save') %></button>
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('telegram_api.cancel') %></button>
						</div>
					</div>
				</div>
			</div>

			<!-- Modal: Add / Edit Agent Chat ID -->
