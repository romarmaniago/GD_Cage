<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<link rel="stylesheet" href="/assets/js/plugins/select2/css/select2.min.css">

<div class="container-fluid content-inner py-0">
  <div class="row">
    <div class="col-sm-12">
      <div class="card">
        <div id="user-role" data-permissions="<%= permissions %>"></div>
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <h3 class="card-title mb-0">
            <div class="breadcrumb1 flat">
              <a href="/dashboard"><span class="fa fa-home"></span></a>
              <a href="/game_information"><%= __('sidebar.game_information') %></a>
              <a href="/categorize_group" class="active"><%= __('game_information.categorize_group') %></a>
            </div>
          </h3>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <%- include('../partials/gi_print_export_toolbar', { printBtnId: 'btn-cg-summary-print', exportBtnId: 'btn-cg-summary-export' }) %>
          </div>
        </div>

        <div class="card-body categorize-group-page">
          <h5 class="cg-section-title mb-3"><%= __('categorize_group.agent_groups') %></h5>
          <div class="marker-balance-dt-wrap marker-balance-card table-responsive mb-4">
            <% if (typeof permissions !== 'undefined' && permissions !== 2) { %>
            <button
              type="button"
              class="expense-cat-panel-add-btn"
              id="btn-add-gi-agent-group"
              title="<%= __('categorize_group.new_group') %>"
              aria-label="<%= __('categorize_group.new_group') %>"
              data-view-only-disable
            >
              <i class="fa fa-plus" aria-hidden="true"></i>
            </button>
            <% } %>
            <table id="gi-agent-groups-tbl" class="table marker-balance-tbl marker-total-table w-100 mb-0">
              <thead>
                <tr>
                  <th><%= __('categorize_group.group_name') %></th>
                  <th><%= __('categorize_group.agents') %></th>
                  <% if (typeof permissions !== 'undefined' && permissions !== 2) { %>
                  <th class="text-center"><%= __('categorize_group.action') %></th>
                  <% } %>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>

          <h5 class="cg-section-title mb-3"><%= __('categorize_group.group_summary') %></h5>
          <div class="marker-balance-dt-wrap marker-balance-card table-responsive">
            <div id="cg-daterange-mount" class="cg-daterange-mount">
              <div id="cg-program-date-wrapper" class="cg-daterange-wrap house-expense-daterange-wrap">
                <input type="text" id="cg-program-date-range-picker" class="form-control form-control-sm text-center" placeholder="Program date range" autocomplete="off" />
              </div>
              <%- include('../partials/split_daterange', {
                splitPrefix: 'categorize-group',
                splitLocaleNs: 'game_information',
                splitWrapClass: 'cg-daterange-wrap cg-split-daterange junket-loss-split-daterange house-expense-split-daterange'
              }) %>
            </div>
            <table id="gi-group-summary-tbl" class="table marker-balance-tbl marker-total-table w-100 mb-0">
              <thead>
                <tr>
                  <th><%= __('categorize_group.group_name') %></th>
                  <th><%= __('categorize_group.agents') %></th>
                  <th class="text-center"><%= __('categorize_group.games') %></th>
                  <th class="text-center"><%= __('gamelist.buyin') %></th>
                  <th class="text-center"><%= __('gamelist.cash_out') %></th>
                  <th class="text-center"><%= __('gamelist.win_loss') %></th>
                  <th class="text-center"><%= __('gamelist.real_rolling') %></th>
                  <th class="text-center"><%= __('gamelist.commission') %></th>
                  <th class="text-center">ADD CHG</th>
                  <th class="text-center">TOTAL SETTLE</th>
                </tr>
              </thead>
              <tbody class="text-center"></tbody>
              <tfoot>
                <tr>
                  <th colspan="3" class="fw-semibold text-end"><%= __('gamelist.grand_total') %></th>
                  <th class="text-center fw-semibold" id="CG_GRAND_BUYIN">0.00</th>
                  <th class="text-center fw-semibold" id="CG_GRAND_CASHOUT">0.00</th>
                  <th class="text-center fw-semibold" id="CG_GRAND_WINLOSS">0.00</th>
                  <th class="text-center fw-semibold" id="CG_GRAND_ROLLING">0.00</th>
                  <th class="text-center fw-semibold" id="CG_GRAND_COMMISSION">0.00</th>
                  <th class="text-center fw-semibold" id="CG_GRAND_ADD_CHG">0.00</th>
                  <th class="text-center fw-semibold" id="CG_GRAND_SETTLE">0.00</th>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/permission_view_only_script') %>
<%- include('../partials/footer') %>

