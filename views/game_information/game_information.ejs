<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="container-fluid content-inner py-0">
  <div class="row">
    <div class="col-sm-12">
      <div class="card">
        <div id="user-role" data-permissions="<%= permissions %>"></div>
        <div class="card-header d-flex justify-content-between align-items-center">
          <h3 class="card-title">
            <div class="breadcrumb1 flat">
              <a href="/dashboard"><span class="fa fa-home"></span></a>
              <a href="/game_information" class="active"><%= __('sidebar.game_information') %></a>
              <a href="/categorize_group"><%= __('game_information.categorize_group') %></a>
            </div>
          </h3>
        </div>

        <div class="card-body game-information-page">
          <div class="row mb-2">
            <div class="col-12 col-lg-6">
              <div id="gi-program-date-wrapper" class="day-selector-wrapper mb-3">
                <%
                  const now = new Date();
                  const pad = value => value.toString().padStart(2, '0');
                  const todayStr = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
                %>
                <div class="program-date-picker-row">
                  <div class="input-group gi-program-date-group" data-today="<%= todayStr %>" data-initial-program-date="<%= todayStr %>">
                    <input type="text" id="gi-program-date-range-picker" class="form-control text-center" placeholder="Program date range" autocomplete="off" />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="marker-balance-dt-wrap marker-balance-card table-responsive">
            <table id="game_information-tbl" class="table marker-balance-tbl marker-total-table w-100 mb-0">
              <thead>
                <tr>
                  <th><%= __('gamelist.program_date_col') %></th>
                  <th><%= __('gamelist.game_start') %></th>
                  <th class="text-center"><%= __('gamelist.type') %></th>
                  <th class="text-center"><%= __('gamelist.game#') %></th>
                  <th class="text-center"><%= __('gamelist.acct_no') %></th>
                  <th class="text-center"><%= __('gamelist.guest') %></th>
                  <th class="text-center"><%= __('gamelist.buyin') %></th>
                  <th class="text-center"><%= __('gamelist.cash_out') %></th>
                  <th class="text-center"><%= __('gamelist.win_loss') %></th>
                  <th class="text-center"><%= __('gamelist.real_rolling') %></th>
                  <th class="text-center"><%= __('gamelist.game_rate') %></th>
                  <th class="text-center"><%= __('gamelist.commission') %></th>
                  <th class="text-center">ADD CHG</th>
                  <th class="text-center">TOTAL SETTLE</th>
                  <th class="text-center"><%= __('gamelist.game_end') %></th>
                </tr>
              </thead>
              <tbody class="text-center"></tbody>
              <tfoot>
                <tr>
                  <th colspan="6" class="fw-semibold text-end"><%= __('gamelist.grand_total') %></th>
                  <th class="text-center fw-semibold" id="GI_GRAND_BUYIN">0.00</th>
                  <th class="text-center fw-semibold" id="GI_GRAND_CASHOUT">0.00</th>
                  <th class="text-center fw-semibold" id="GI_GRAND_WINLOSS">0.00</th>
                  <th class="text-center fw-semibold" id="GI_GRAND_ROLLING">0.00</th>
                  <th></th>
                  <th class="text-center fw-semibold" id="GI_GRAND_COMMISSION">0.00</th>
                  <th class="text-center fw-semibold" id="GI_GRAND_ADD_CHG">0.00</th>
                  <th class="text-center fw-semibold" id="GI_GRAND_SETTLE">0.00</th>
                  <th></th>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/permission_view_only_script') %>
<%- include('../partials/footer') %>

<style>
.game-information-page {
	--gd-marker-gold-solid: #d9b96a;
	--gd-marker-gold-border: rgba(58, 46, 18, 0.25);
	--gd-marker-gold-text: #3a2e12;
	--gd-marker-gold-hover: #faf3dc;
}

.game-information-page .gi-program-date-group {
	width: 14.75rem;
	max-width: 14.75rem;
}
.game-information-page .gi-program-date-group .flatpickr-wrapper,
.game-information-page .gi-program-date-group .form-control,
.game-information-page .gi-program-date-group .flatpickr-input,
.game-information-page .gi-program-date-group .flatpickr-alt-input {
	width: 14.75rem !important;
	max-width: 14.75rem !important;
	min-width: 0 !important;
	font-size: 0.8125rem;
	padding: 0.4rem 0.5rem;
	height: 2.35rem;
	line-height: 1.35;
}

.game-information-page table.dataTable {
	border-collapse: collapse !important;
	border-spacing: 0 !important;
}
.game-information-page table thead tr,
.game-information-page table tfoot tr {
	background-color: var(--gd-marker-gold-solid);
}
.game-information-page table thead th,
.game-information-page table tfoot th {
	background: transparent !important;
	background-color: transparent !important;
	border-left: 0 !important;
	border-right: 0 !important;
	border-top: 0 !important;
	box-shadow: none !important;
}
.game-information-page table.dataTable thead > tr > th.sorting,
.game-information-page table.dataTable thead > tr > th.sorting_asc,
.game-information-page table.dataTable thead > tr > th.sorting_desc,
.game-information-page table.dataTable thead > tr > th.sorting_disabled {
	background: transparent !important;
	background-color: transparent !important;
}

.game-information-page .marker-balance-tbl {
	width: 100%;
	font-size: 13px;
	border-collapse: collapse;
	border: 1px solid var(--gd-marker-gold-border);
}
.game-information-page .marker-balance-tbl thead th {
	color: var(--gd-marker-gold-text);
	font-weight: 600;
	padding: 12px 15px;
	border: none;
	border-bottom: 1px solid var(--gd-marker-gold-border);
}
.game-information-page .marker-balance-tbl tbody tr { border-bottom: 1px solid #eee; }
.game-information-page .marker-balance-tbl tbody tr:last-child td,
.game-information-page .marker-balance-tbl tbody td.dataTables_empty {
	border-bottom: 1px solid var(--gd-marker-gold-border);
}
.game-information-page .marker-balance-tbl tfoot tr th {
	border-top: 2px solid var(--gd-marker-gold-border);
	border-bottom: 1px solid var(--gd-marker-gold-border);
	color: var(--gd-marker-gold-text);
	font-weight: 600;
	padding: 10px 15px;
}
.game-information-page .marker-balance-tbl td { padding: 12px 15px; color: #666; }
.game-information-page .marker-balance-tbl tbody tr:hover { background-color: var(--gd-marker-gold-hover) !important; }

.game-information-page .marker-balance-dt-wrap,
.game-information-page .marker-balance-card {
	max-width: 100%;
	overflow-x: auto;
	-webkit-overflow-scrolling: touch;
}
#game_information-tbl.dataTable.marker-total-table,
#game_information-tbl.marker-total-table {
	width: 100% !important;
}
.game-information-page .marker-total-table thead th,
.game-information-page .marker-total-table tbody td {
	white-space: nowrap;
	vertical-align: middle;
	font-size: 0.875rem;
}
.game-information-page .marker-total-table thead th {
	color: var(--gd-marker-gold-text) !important;
	font-weight: 600;
	border-bottom: 1px solid var(--gd-marker-gold-border) !important;
}
.game-information-page .marker-total-table tbody tr:nth-child(even) td {
	background-color: #fbf5e4;
}
.game-information-page .marker-total-table tbody tr:hover td {
	background-color: var(--gd-marker-gold-hover) !important;
}
.game-information-page .marker-total-table tfoot tr th {
	border-top: 2px solid var(--gd-marker-gold-border);
	border-bottom: 1px solid var(--gd-marker-gold-border);
	color: var(--gd-marker-gold-text);
	font-weight: 600;
	padding: 10px 15px;
}
.game-information-page .marker-total-table thead th.sorting,
.game-information-page .marker-total-table thead th.sorting_asc,
.game-information-page .marker-total-table thead th.sorting_desc {
	color: var(--gd-marker-gold-text) !important;
}

/* Cream Show / Search bar */
#game_information-tbl_wrapper .gi-controls-highlight {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	padding: 8px 12px;
	margin-bottom: -1px;
	background: var(--gd-marker-gold-hover);
	border: 1px solid var(--gd-marker-gold-border);
	border-bottom: 0;
	border-radius: 10px 10px 0 0;
}
#game_information-tbl_wrapper .gi-controls-highlight .dataTables_length {
	margin-top: 4px;
}
#game_information-tbl_wrapper .gi-controls-highlight .dataTables_filter {
	margin: 0 0 0 auto;
}
#game_information-tbl_wrapper #game_information-tbl_filter .gi-filter-highlight {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	padding: 2px 6px;
	background: transparent;
	border: none;
	border-radius: 10px;
}
#game_information-tbl_wrapper #game_information-tbl_filter .gi-filter-highlight label {
	margin: 0;
	display: inline-flex;
	align-items: center;
	gap: 0;
	font-size: 0;
	color: transparent;
}
#game_information-tbl_wrapper #game_information-tbl_filter .gi-filter-highlight label input {
	margin-left: 0;
	border: none;
	outline: none;
	box-shadow: none;
	background: #fff;
	border-radius: 4px;
	padding: 6px 10px;
	font-size: 13px;
	color: #333;
	min-width: 160px;
}
#game_information-tbl_wrapper #game_information-tbl_filter .gi-filter-highlight label input::placeholder {
	color: #8a92a6;
	opacity: 1;
}
#game_information-tbl_wrapper #game_information-tbl {
	margin-top: 0 !important;
}
#game_information-tbl_wrapper .dataTables_length,
#game_information-tbl_wrapper .dataTables_filter {
	padding-left: 0;
	padding-right: 0;
}
</style>

<script type="application/json" id="game-information-i18n"><%- JSON.stringify({
  onGame: __('gamelist.on_game'),
  endGame: __('gamelist.end_game'),
  live: __('gamelist.live'),
  telebet: __('gamelist.telebet'),
  emptyTable: __('game_information.empty_table')
}) %></script>
<script>
(function () {
	function applyGiControlsLayout() {
		var wrapper = document.getElementById('game_information-tbl_wrapper');
		var lengthWrap = document.getElementById('game_information-tbl_length');
		var filterWrap = document.getElementById('game_information-tbl_filter');
		var searchLabel = filterWrap ? filterWrap.querySelector('label') : null;
		var searchInput = searchLabel ? searchLabel.querySelector('input') : null;
		var controlsHighlight;
		var filterHighlight;

		if (!wrapper || !lengthWrap || !filterWrap || !searchLabel) return;

		controlsHighlight = wrapper.querySelector('.gi-controls-highlight');
		if (!controlsHighlight) {
			controlsHighlight = document.createElement('div');
			controlsHighlight.className = 'gi-controls-highlight';
			wrapper.insertBefore(controlsHighlight, wrapper.firstChild);
		}
		if (lengthWrap.parentElement !== controlsHighlight) {
			controlsHighlight.appendChild(lengthWrap);
		}
		if (filterWrap.parentElement !== controlsHighlight) {
			controlsHighlight.appendChild(filterWrap);
		}

		filterHighlight = filterWrap.querySelector('.gi-filter-highlight');
		if (!filterHighlight) {
			filterHighlight = document.createElement('div');
			filterHighlight.className = 'gi-filter-highlight';
			filterWrap.appendChild(filterHighlight);
		}
		if (searchLabel.parentElement !== filterHighlight) {
			filterHighlight.appendChild(searchLabel);
		}
		if (searchInput) {
			searchInput.setAttribute('placeholder', 'Search...');
			Array.prototype.slice.call(searchLabel.childNodes).forEach(function (node) {
				if (node.nodeType === 3) searchLabel.removeChild(node);
			});
		}
	}

	if (window.jQuery) {
		$(document).on('init.dt draw.dt', '#game_information-tbl', applyGiControlsLayout);
		$(applyGiControlsLayout);
	} else {
		document.addEventListener('DOMContentLoaded', function () {
			setTimeout(applyGiControlsLayout, 0);
		});
	}
})();
</script>
<script src="/assets/js/functions/game_information.js"></script>
