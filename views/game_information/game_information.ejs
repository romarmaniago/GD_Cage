<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="container-fluid content-inner py-0">
  <div class="row">
    <div class="col-sm-12">
      <div class="card">
        <div id="user-role" data-permissions="<%= permissions %>"></div>
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <h3 class="card-title mb-0">
            <div class="breadcrumb1 flat">
              <a href="/dashboard"><span class="fa fa-home"></span></a>
              <a href="/game_information" class="active"><%= __('sidebar.game_information') %></a>
              <a href="/categorize_group"><%= __('game_information.categorize_group') %></a>
            </div>
          </h3>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <%- include('../partials/gi_print_export_toolbar', { printBtnId: 'btn-gi-print', exportBtnId: 'btn-gi-export' }) %>
          </div>
        </div>

        <div class="card-body game-information-page">
          <div id="gi-daterange-mount" class="gi-daterange-mount">
            <div id="gi-program-date-wrapper" class="gi-daterange-wrap house-expense-daterange-wrap">
              <input type="text" id="gi-program-date-range-picker" class="form-control form-control-sm text-center" placeholder="Program date range" autocomplete="off" />
            </div>
            <%- include('../partials/split_daterange', {
              splitPrefix: 'game-information',
              splitLocaleNs: 'game_information',
              splitWrapClass: 'gi-daterange-wrap gi-split-daterange junket-loss-split-daterange house-expense-split-daterange'
            }) %>
          </div>

          <div class="marker-balance-dt-wrap marker-balance-card table-responsive">
            <% if (typeof permissions !== 'undefined' && permissions !== 2) { %>
            <button
              type="button"
              class="expense-cat-panel-add-btn"
              id="btn-add-gi-manual-game"
              title="<%= __('game_information.add_game') %>"
              aria-label="<%= __('game_information.add_game') %>"
              data-view-only-disable
            >
              <i class="fa fa-plus" aria-hidden="true"></i>
            </button>
            <% } %>
            <table id="game_information-tbl" class="table marker-balance-tbl marker-total-table w-100 mb-0">
              <thead>
                <tr>
                  <th><%= __('gamelist.program_date_col') %></th>
                  <th><%= __('gamelist.game_start') %></th>
                  <th class="text-center"><%= __('gamelist.type') %></th>
                  <th class="text-center"><%= __('gamelist.game#') %></th>
                  <th class="text-center"><%= __('gamelist.acct_no') %></th>
                  <th class="text-center"><%= __('gamelist.guest') %></th>
                  <th class="text-center"><%= __('gamelist.buyin') %></th>
                  <th class="text-center"><%= __('gamelist.cash_out') %></th>
                  <th class="text-center"><%= __('gamelist.win_loss') %></th>
                  <th class="text-center"><%= __('gamelist.real_rolling') %></th>
                  <th class="text-center"><%= __('gamelist.game_rate') %></th>
                  <th class="text-center"><%= __('gamelist.commission') %></th>
                  <th class="text-center">ADD CHG</th>
                  <th class="text-center">TOTAL SETTLE</th>
                  <th class="text-center"><%= __('gamelist.game_end') %></th>
                  <% if (typeof permissions !== 'undefined' && permissions !== 2) { %>
                  <th class="text-center"><%= __('gamelist.action') %></th>
                  <% } %>
                </tr>
              </thead>
              <tbody class="text-center"></tbody>
              <tfoot>
                <tr>
                  <th colspan="6" class="fw-semibold text-end"><%= __('gamelist.grand_total') %></th>
                  <th class="text-center fw-semibold" id="GI_GRAND_BUYIN">0.00</th>
                  <th class="text-center fw-semibold" id="GI_GRAND_CASHOUT">0.00</th>
                  <th class="text-center fw-semibold" id="GI_GRAND_WINLOSS">0.00</th>
                  <th class="text-center fw-semibold" id="GI_GRAND_ROLLING">0.00</th>
                  <th></th>
                  <th class="text-center fw-semibold" id="GI_GRAND_COMMISSION">0.00</th>
                  <th class="text-center fw-semibold" id="GI_GRAND_ADD_CHG">0.00</th>
                  <th class="text-center fw-semibold" id="GI_GRAND_SETTLE">0.00</th>
                  <th></th>
                  <% if (typeof permissions !== 'undefined' && permissions !== 2) { %>
                  <th></th>
                  <% } %>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/permission_view_only_script') %>
<%- include('../partials/footer') %>

<style>
/* Cream/light-gray theme */
.card {
	background: linear-gradient(180deg, #f6f3ec 0%, #efe9db 100%) !important;
	border: 1px solid rgba(200, 162, 76, 0.4) !important;
}
.card-header {
	background: linear-gradient(180deg, #f6f3ec 0%, #efe9db 100%) !important;
	border-bottom: 1px solid rgba(200, 162, 76, 0.25) !important;
}
.marker-balance-card {
	background: linear-gradient(180deg, #fafbfc 0%, #ffffff 48px) !important;
	border: 1px solid rgba(15, 23, 42, 0.08) !important;
	border-radius: 12px !important;
	box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04) !important;
	padding: 0 !important;
}

.gi-daterange-wrap {
	width: auto;
	min-width: 0;
	max-width: none;
	flex: 0 0 auto;
	display: inline-block;
}

.gi-daterange-wrap .flatpickr-wrapper {
	display: inline-block;
	width: auto;
	min-width: 0;
}

.gi-daterange-wrap input.form-control,
.gi-daterange-wrap .flatpickr-input.form-control {
	display: inline-block !important;
	position: static !important;
	left: auto !important;
	top: auto !important;
	width: auto !important;
	min-width: 10rem;
	max-width: none !important;
	margin: 0;
	overflow: visible;
	text-overflow: clip;
	white-space: nowrap;
	box-sizing: border-box;
	text-align: center;
	cursor: pointer;
	background: #fff;
	border: 1px solid #e0e0e0;
	border-radius: 999px;
	height: 34px;
	padding-left: 0.9rem;
	padding-right: 0.9rem;
	font-size: 13px;
	box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}

.gi-daterange-wrap input.form-control:focus,
.gi-daterange-wrap .flatpickr-input.form-control:focus {
	border-color: #bbb;
	outline: none;
	box-shadow: 0 0 0 0.15rem rgba(0, 0, 0, 0.08);
}

.gi-daterange-mount {
	display: none;
}

#game_information-tbl_wrapper .gi-controls-highlight .gi-daterange-mount.is-placed {
	display: inline-flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 8px;
	margin-left: 8px;
}

.gi-split-daterange,
.gi-split-daterange .house-expense-daterange-separator {
	display: inline-flex;
	align-items: center;
	flex-wrap: nowrap;
	gap: 6px;
}

.gi-split-daterange input.split-date-input {
	display: inline-block !important;
	width: auto !important;
	min-width: 7.5rem;
	max-width: none !important;
	text-align: center;
	cursor: text;
	background: #fff;
	border: 1px solid #e0e0e0;
	border-radius: 999px;
	height: 34px;
	padding-left: 0.9rem;
	padding-right: 0.9rem;
	font-size: 13px;
	box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}

#game_information-tbl_wrapper .gi-controls-highlight .gi-split-daterange input.split-date-input:focus {
	border-color: #c8a24c;
	box-shadow: 0 0 0 0.15rem rgba(200, 162, 76, 0.25);
}

.game-information-page table.dataTable {
	border-collapse: collapse !important;
	border-spacing: 0 !important;
}
.game-information-page table thead tr,
.game-information-page table tfoot tr {
	background-color: #f5f5f5 !important;
}
.game-information-page table thead th,
.game-information-page table tfoot th {
	background: #f5f5f5 !important;
	background-color: #f5f5f5 !important;
	border-left: 0 !important;
	border-right: 0 !important;
	border-top: 0 !important;
	box-shadow: none !important;
}
.game-information-page table.dataTable thead > tr > th.sorting,
.game-information-page table.dataTable thead > tr > th.sorting_asc,
.game-information-page table.dataTable thead > tr > th.sorting_desc,
.game-information-page table.dataTable thead > tr > th.sorting_disabled {
	background: #f5f5f5 !important;
	background-color: #f5f5f5 !important;
}

.game-information-page .marker-balance-tbl {
	width: 100%;
	font-size: 13px;
	border-collapse: collapse;
	border: 1px solid #e0e0e0 !important;
}
.game-information-page .marker-balance-tbl thead th {
	color: #555 !important;
	font-weight: 600;
	padding: 12px 15px;
	border: none;
	border-bottom: 1px solid #e0e0e0 !important;
}
.game-information-page .marker-balance-tbl tbody tr { border-bottom: 1px solid #eee; }
.game-information-page .marker-balance-tbl tbody tr:last-child td,
.game-information-page .marker-balance-tbl tbody td.dataTables_empty {
	border-bottom: 1px solid #e0e0e0;
}
.game-information-page .marker-balance-tbl tfoot tr th {
	border-top: 1px solid #e0e0e0 !important;
	border-bottom: 1px solid #e0e0e0 !important;
	background: #f5f5f5 !important;
	color: #555 !important;
	font-weight: 600;
	padding: 10px 15px;
}
.game-information-page .marker-balance-tbl td { padding: 12px 15px; color: #666; }
.game-information-page .marker-balance-tbl tbody tr:hover { background-color: #f6f3ec !important; }

.game-information-page .marker-balance-dt-wrap,
.game-information-page .marker-balance-card {
	max-width: 100%;
	overflow-x: auto;
	-webkit-overflow-scrolling: touch;
}
#game_information-tbl.dataTable.marker-total-table,
#game_information-tbl.marker-total-table {
	width: 100% !important;
}
.game-information-page .marker-total-table thead th,
.game-information-page .marker-total-table tbody td {
	white-space: nowrap;
	vertical-align: middle;
	font-size: 0.875rem;
}
.game-information-page .marker-total-table thead th {
	color: #555 !important;
	font-weight: 600;
	border-bottom: 1px solid #e0e0e0 !important;
}
.game-information-page .marker-total-table tbody tr:nth-child(even) td {
	background-color: #f4f1ea !important;
}
.game-information-page .marker-total-table tbody tr:nth-child(odd) td {
	background-color: #fff !important;
}
.game-information-page .marker-total-table tbody tr:hover td {
	background-color: #f6f3ec !important;
}
.game-information-page .marker-total-table tfoot tr th {
	border-top: 1px solid #e0e0e0 !important;
	border-bottom: 1px solid #e0e0e0 !important;
	background: #f5f5f5 !important;
	color: #555 !important;
	font-weight: 600;
	padding: 10px 15px;
}

/* Commission type badge (R / S / L) in Game Rate column */
.game-information-page .commission-badge {
	display: inline-block;
	padding: 2px 6px;
	margin-left: 4px;
	font-size: 0.65rem;
	font-weight: 600;
	border-radius: 8px;
	vertical-align: middle;
	line-height: 1.2;
}
.game-information-page .commission-badge-r {
	background-color: #e3f2fd;
	color: #1565c0;
	border: 1px solid #90caf9;
}
.game-information-page .commission-badge-s {
	background-color: #fff3e0;
	color: #ef6c00;
	border: 1px solid #ffcc80;
}
.game-information-page .commission-badge-l {
	background-color: #e8f5e9;
	color: #2e7d32;
	border: 1px solid #a5d6a7;
}

.game-information-page .marker-total-table thead th.sorting,
.game-information-page .marker-total-table thead th.sorting_asc,
.game-information-page .marker-total-table thead th.sorting_desc {
	color: #555 !important;
}

/* White Show / Search bar */
#game_information-tbl_wrapper .gi-controls-highlight {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	padding: 8px 12px;
	margin-bottom: -1px;
	background: #fff;
	border: 1px solid #e8ecf1;
	border-bottom: 0;
	border-radius: 10px 10px 0 0;
}
#game_information-tbl_wrapper .gi-controls-highlight .dataTables_length {
	margin-top: 4px;
}
#game_information-tbl_wrapper .gi-controls-highlight .dataTables_filter {
	margin: 0 0 0 auto;
}
#game_information-tbl_wrapper #game_information-tbl_filter .gi-filter-highlight {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	padding: 2px 6px;
	background: transparent;
	border: none;
	border-radius: 10px;
}
#game_information-tbl_wrapper #game_information-tbl_filter .gi-filter-highlight .expense-cat-panel-add-btn {
	flex-shrink: 0;
}
#game_information-tbl_wrapper #game_information-tbl_filter .gi-filter-highlight label {
	margin: 0;
	display: inline-flex;
	align-items: center;
	gap: 0;
	font-size: 0;
	color: transparent;
}
#game_information-tbl_wrapper #game_information-tbl_filter .gi-filter-highlight label input {
	margin-left: 0;
	border: none;
	outline: none;
	box-shadow: none;
	background: #fff;
	border-radius: 4px;
	padding: 6px 10px;
	font-size: 13px;
	color: #333;
	min-width: 160px;
}
#game_information-tbl_wrapper #game_information-tbl_filter .gi-filter-highlight label input::placeholder {
	color: #8a92a6;
	opacity: 1;
}
#game_information-tbl_wrapper #game_information-tbl {
	margin-top: 0 !important;
}
#game_information-tbl_wrapper .dataTables_length,
#game_information-tbl_wrapper .dataTables_filter {
	padding-left: 0;
	padding-right: 0;
}

#btn-add-gi-manual-game.expense-cat-panel-add-btn {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 2.25rem;
	height: 2.25rem;
	padding: 0;
	border: none;
	border-radius: 50%;
	background: linear-gradient(135deg, #52525b 0%, #71717a 100%);
	color: #fff;
	line-height: 1;
	cursor: pointer;
}

#btn-add-gi-manual-game.expense-cat-panel-add-btn i.fa {
	font-size: 1rem;
	line-height: 1;
	pointer-events: none;
}

.gi-manual-actions {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 6px;
}

.gi-manual-actions .btn {
	padding: 2px 8px;
	line-height: 1.2;
}
</style>

<script type="application/json" id="game-information-i18n"><%- JSON.stringify({
  onGame: __('gamelist.on_game'),
  endGame: __('gamelist.end_game'),
  live: __('gamelist.live'),
  telebet: __('gamelist.telebet'),
  emptyTable: __('game_information.empty_table'),
  addGame: __('game_information.add_game'),
  editGame: __('game_information.edit_game'),
  deleteGame: __('game_information.delete_game'),
  deleteConfirm: __('game_information.delete_confirm'),
  saved: __('game_information.add_success'),
  updated: __('game_information.update_success'),
  deleted: __('game_information.delete_success'),
  saveFailed: __('game_information.add_failed'),
  accountRequired: __('game_information.account_required'),
  cancel: __('game_information.cancel'),
  print: __('game_information.print'),
  export: __('game_information.export'),
  noData: __('game_information.no_data')
}) %></script>
<%- include('../modals/game_information/manual_game') %>
<script>
(function () {
	function applyGiControlsLayout() {
		var wrapper = document.getElementById('game_information-tbl_wrapper');
		var lengthWrap = document.getElementById('game_information-tbl_length');
		var filterWrap = document.getElementById('game_information-tbl_filter');
		var dateMount = document.getElementById('gi-daterange-mount');
		var searchLabel = filterWrap ? filterWrap.querySelector('label') : null;
		var searchInput = searchLabel ? searchLabel.querySelector('input') : null;
		var controlsHighlight;
		var filterHighlight;

		if (!wrapper || !lengthWrap || !filterWrap || !searchLabel) return;

		controlsHighlight = wrapper.querySelector('.gi-controls-highlight');
		if (!controlsHighlight) {
			controlsHighlight = document.createElement('div');
			controlsHighlight.className = 'gi-controls-highlight';
			wrapper.insertBefore(controlsHighlight, wrapper.firstChild);
		}
		if (lengthWrap.parentElement !== controlsHighlight) {
			controlsHighlight.appendChild(lengthWrap);
		}
		if (dateMount) {
			if (dateMount.parentElement !== controlsHighlight || dateMount.previousElementSibling !== lengthWrap) {
				if (lengthWrap.nextSibling) {
					controlsHighlight.insertBefore(dateMount, lengthWrap.nextSibling);
				} else {
					controlsHighlight.appendChild(dateMount);
				}
			}
			dateMount.classList.add('is-placed');
		}
		if (filterWrap.parentElement !== controlsHighlight) {
			controlsHighlight.appendChild(filterWrap);
		}

		filterHighlight = filterWrap.querySelector('.gi-filter-highlight');
		if (!filterHighlight) {
			filterHighlight = document.createElement('div');
			filterHighlight.className = 'gi-filter-highlight';
			filterWrap.appendChild(filterHighlight);
		}
		if (searchLabel.parentElement !== filterHighlight) {
			filterHighlight.appendChild(searchLabel);
		}
		var addBtn = document.getElementById('btn-add-gi-manual-game');
		if (addBtn && filterHighlight && searchLabel) {
			if (addBtn.parentElement !== filterHighlight || addBtn.nextElementSibling !== searchLabel) {
				filterHighlight.insertBefore(addBtn, searchLabel);
			}
		}
		if (searchInput) {
			searchInput.setAttribute('placeholder', 'Search...');
			Array.prototype.slice.call(searchLabel.childNodes).forEach(function (node) {
				if (node.nodeType === 3) searchLabel.removeChild(node);
			});
		}

		if (window.fitGiSplitDateWidths) {
			window.fitGiSplitDateWidths();
		}
		if (window.MonthEndCutoffRange && typeof window.MonthEndCutoffRange.fitRangePickerInstance === 'function') {
			var pickerEl = document.getElementById('gi-program-date-range-picker');
			if (pickerEl && pickerEl._flatpickr) {
				window.MonthEndCutoffRange.fitRangePickerInstance(pickerEl._flatpickr);
			}
		}
	}

	if (window.jQuery) {
		$(document).on('init.dt draw.dt', '#game_information-tbl', applyGiControlsLayout);
		$(applyGiControlsLayout);
	} else {
		document.addEventListener('DOMContentLoaded', function () {
			setTimeout(applyGiControlsLayout, 0);
		});
	}
})();
</script>
<script src="/assets/js/functions/game_information.js"></script>
