<%- include ('../partials/header'); -%>
<%- include ('../partials/loader'); -%>
	<%- include ('../partials/sidebar'); -%>
		<%- include ('../partials/topbar'); -%>

			<head>

			</head>

			<body>
				<div class="container-fluid content-inner mt-4">
					<div class="row">
						<div class="col-sm-12">
							<div class="card">
								<div id="user-role" data-permissions="<%= permissions %>"></div>
								<div class="card-header d-flex justify-content-between align-items-center">
									<h3 class="card-title"><div class="breadcrumb1 flat">
										<a href="/dashboard" ><span class="fa fa-home"></span></a>
										
										<a href="/agency"class="active">Line</a>
									</div></h3>
								</div>
								<div class="card-body">
									<div class="d-none mb-3" id="selection-summary-row">
										<span class="selection-summary-chip me-2" id="selected-line-chip">
											<strong>LINE:</strong> <span id="selected-line-name">-</span>
										</span>
										<span class="selection-summary-chip" id="selected-agent-chip">
											<strong>AGENT:</strong> <span id="selected-agent-name">-</span>
										</span>
									</div>
									<div class="row g-3 mb-4 agency-line-stats" id="line-stat-row">
										<div class="col-6 col-lg" id="line-stat-card-line">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Line</div>
												<div class="agency-stat-value" id="line-stat-total-line">—</div>
											</div>
										</div>
										<div class="col-6 col-lg" id="line-stat-card-agent">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Agent</div>
												<div class="agency-stat-value" id="line-stat-total-agent">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Rolling</div>
												<div class="agency-stat-value" id="line-stat-total-rolling">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Winloss</div>
												<div class="agency-stat-value" id="line-stat-total-winloss">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Commission</div>
												<div class="agency-stat-value" id="line-stat-total-commission">—</div>
											</div>
										</div>
									</div>
									<div class="row g-3 mb-3 agency-line-stats d-none" id="agent-stat-row">
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Guest</div>
												<div class="agency-stat-value" id="agent-stat-total-guest">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Games</div>
												<div class="agency-stat-value" id="agent-stat-total-games">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Rolling</div>
												<div class="agency-stat-value" id="agent-stat-total-rolling">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Winloss</div>
												<div class="agency-stat-value" id="agent-stat-total-winloss">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Commission</div>
												<div class="agency-stat-value" id="agent-stat-total-commission">—</div>
											</div>
										</div>
									</div>
									<div class="row g-3 agency-panels">
										<div class="col-12 col-xl-2-5">
											<div class="panel-box h-100">
												<div class="panel-header d-flex align-items-center justify-content-between">
													<div class="panel-title">LINE</div>
													<button class="btn btn-sm btn-primary" id="btn-line-panel-add" data-bs-toggle="modal" data-bs-target="#modal-new-agency">
														<i class="fa fa-plus"></i>
													</button>
												</div>
												<div class="panel-body">
													<div id="agency-grid" class="row gx-2 gy-2"></div>
												</div>
											</div>
										</div>

										<div class="col-12 col-xl-2-5">
											<div class="panel-box h-100">
												<div class="panel-header d-flex align-items-center justify-content-between">
													<div class="panel-title">AGENT</div>
													<div class="d-flex align-items-center gap-1">
														<button type="button" class="btn btn-sm btn-outline-primary" id="btn-agent-panel-transfer" title="Transfer Agent">
															<i class="fa fa-exchange-alt"></i>
														</button>
														<button type="button" class="btn btn-sm btn-primary" id="btn-agent-panel-add-guest" data-bs-toggle="modal" data-bs-target="#modal-new-agent" title="New Guest">
															<i class="fa fa-plus"></i>
														</button>
													</div>
												</div>
												<div class="panel-body" id="agent-panel-body">
													<div class="panel-empty-state" id="agent-panel-empty">
														Select LINE to load agent list.
													</div>
													<div id="agent-list" class="panel-list d-none"></div>
												</div>
											</div>
										</div>

										<div class="col-12 col-xl-7">
											<div class="panel-box h-100">
												<div class="panel-header d-flex align-items-center justify-content-between">
													<div class="panel-title">GUEST</div>
													<button type="button" class="btn btn-sm btn-primary" id="btn-guest-panel-add">
														<i class="fa fa-plus"></i>
													</button>
												</div>
												<div class="panel-body" id="guest-panel-body">
													<div class="panel-empty-state" id="guest-panel-empty">
														Open an agency to view guests.
													</div>
													<div id="guest-list" class="panel-list d-none"></div>
												</div>
											</div>
										</div>
									</div>
									<nav id="pagination-container" class="mt-3 d-flex justify-content-center">
										<ul class="pagination flex-wrap"></ul>
									</nav>
								</div>
							</div>
						</div>
					</div>
				</div>
				<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
			</body>
			<%- include ('../modals/accounts/new_agency'); -%>
				<%- include ('../modals/accounts/edit_agency'); -%>
				<%- include ('../modals/accounts/account_ledger_modal'); -%>
				<%- include ('../modals/accounts/account_details'); %>
				<%- include ('../modals/accounts/transfer_account'); %>
				<%- include ('../modals/accounts/new_agent') %>
				<%- include ('../modals/accounts/edit_agent') %>
				<%- include ('../modals/game_book/new_game_list') %>
				<div class="modal fade" id="modal-add-guest-table" tabindex="-1" aria-labelledby="modal-add-guest-table-label" aria-hidden="true">
					<div class="modal-dialog modal-dialog-centered">
						<div class="modal-content">
							<div class="modal-header bg-primary">
								<h5 class="modal-title text-white" id="modal-add-guest-table-label">Add Guest</h5>
								<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>
							<form id="add_guest_form">
								<div class="modal-body">
									<input type="hidden" id="guest_agent_id" name="txtAgentId">
									<div class="mb-2 text-muted small">
										Agent: <strong id="guest_agent_display">-</strong>
									</div>
									<div class="mb-0">
										<label for="guest_name_input" class="form-label">Guest Name</label>
										<input type="text" class="form-control" id="guest_name_input" name="txtGuestName" required maxlength="150">
									</div>
								</div>
								<div class="modal-footer">
									<button type="submit" class="btn btn-primary btn-sm" id="btn-save-guest-table">Save</button>
									<button type="button" class="btn btn-alt-secondary btn-sm" data-bs-dismiss="modal">Close</button>
								</div>
							</form>
						</div>
					</div>
				</div>
				<%- include ('../partials/permission_view_only_script') %>
					<%- include ('../partials/footer'); -%>
						<!-- <script src="assets/js/datatables/agency_tables_datatables.min.js"></script> -->
						<script src="/assets/js/functions/agency.js"></script>
						<script src="/assets/js/functions/account.js"></script>
						<script src="/assets/js/functions/agent.js"></script>
						<script src="/assets/js/functions/game_list.js"></script>

<style>



.agency-card {
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  transition: none;
  position: relative;
}

.agency-card:hover {
  transform: none;
  box-shadow: none;
}

.agency-card.is-selected {
  background: #f3f7ff;
}

.agency-list-item {
  border: 0;
  border-bottom: 1px solid #edf0f7;
  border-radius: 0;
  min-height: 54px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 0;
  background: transparent;
  justify-content: flex-start;
  padding-right: 56px;
}

#agency-grid {
  border-top: 1px solid #edf0f7;
}

.agency-panels .panel-box {
  background: #fff;
  border: 1px solid #edf0f7;
  border-radius: 14px;
  overflow: hidden;
}

.panel-header {
  border-bottom: 1px solid #edf0f7;
  padding: 12px 14px;
}

.panel-title {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.6px;
  color: #1f2937;
}

.panel-body {
  padding: 14px;
  min-height: 520px;
}

.panel-empty-state {
  min-height: 460px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 12px;
  color: #9ca3af;
  border: 1px dashed #dbe2ef;
  border-radius: 10px;
  background: #fafbfd;
}

.panel-list {
  border-top: 1px solid #edf0f7;
  border-bottom: 1px solid #edf0f7;
}

.panel-list-item {
  min-height: 54px;
  border-bottom: 1px solid #edf0f7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 10px 8px;
}

.panel-list-item:last-child {
  border-bottom: 0;
}

.agency-guest-table thead th {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  color: #64748b;
  border-bottom: 1px solid #edf0f7;
  padding: 10px 8px;
  white-space: nowrap;
  text-align: center;
}

.agency-guest-table tbody td {
  font-size: 12px;
  color: #334155;
  border-bottom: 1px solid #edf0f7;
  padding: 10px 8px;
  vertical-align: middle;
  text-align: center;
}

.agency-guest-table tbody tr:last-child td {
  border-bottom: 0;
}

.agency-guest-plus-btn {
  color: #2f5bea !important;
  text-decoration: none !important;
  font-size: 13px;
  line-height: 1;
}

.agency-guest-plus-btn:hover,
.agency-guest-plus-btn:focus {
  color: #173ea5 !important;
}

.panel-list-label {
  font-size: 13px;
  color: #44506a;
  font-weight: 600;
  text-transform: uppercase;
  text-decoration: none;
}

.panel-list-agent-link {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6px;
  flex: 1;
  min-width: 0;
  font-size: 13px;
  color: #44506a;
  text-decoration: none;
  text-transform: uppercase;
}

.panel-list-agent-link:hover {
  color: #2f5bea;
}

.panel-list-code {
  font-weight: 700;
  color: #1f2937;
  letter-spacing: 0.02em;
}

.panel-list-sep {
  color: #9ca3af;
  font-weight: 400;
}

.panel-list-name {
  font-weight: 600;
  color: #44506a;
}

.panel-row-actions {
  display: flex;
  align-items: center;
}

.panel-row-actions .btn {
  width: 28px;
  height: 28px;
  padding: 0;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0 !important;
  background: transparent !important;
}

.agency-row-actions .btn {
  border: 0 !important;
  background: transparent !important;
}

.agency-row-actions .btn.btn-outline-secondary,
.panel-row-actions .btn.btn-outline-secondary {
  color: #0b2f6d !important;
}

.agency-row-actions .btn.btn-outline-danger,
.panel-row-actions .btn.btn-outline-danger {
  color: #dc3545 !important;
}

.agency-row-actions .btn.btn-outline-primary,
.panel-row-actions .btn.btn-outline-primary {
  color: #2f5bea !important;
}

.agency-row-actions .btn:hover,
.agency-row-actions .btn:focus,
.panel-row-actions .btn:hover,
.panel-row-actions .btn:focus {
  background: transparent !important;
  color: inherit !important;
  box-shadow: none !important;
}

#btn-agent-panel-transfer,
#btn-agent-panel-add-guest,
#btn-guest-panel-add,
#btn-line-panel-add {
  width: 32px;
  height: 32px;
  padding: 0;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.panel-list-item.is-active {
  background: #f3f7ff;
}

.agency-card-body {
  min-height: auto;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 16px;
}



.agency-row-actions {
  position: absolute;
  top: 50%;
  right: 10px;
  transform: translateY(-50%);
  display: flex;
  gap: 6px;
}

.agency-row-actions .btn {
  width: 28px;
  height: 28px;
  padding: 0;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.agency-name {
  font-weight: 600;
  font-size: 13px;
  color: #5a6474;
  text-decoration: none;
  line-height: 1.3;
}

.agency-name:hover {
  color: #2f5bea;
}

/* fractional xl col (Bootstrap walang col-xl-2.5): LINE + AGENT = 2.5 + 2.5; GUEST = native col-xl-7 */
@media (min-width: 1200px) {
  .agency-panels > .col-xl-2-5 {
    flex: 0 0 auto;
    width: 20.8333333333%;
  }
}

.agency-line-stats .agency-stat-card {
  background: #fff;
  border: 1px solid #edf0f7;
  border-radius: 14px;
  padding: 14px 16px;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
}

.agency-stat-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: #6b7280;
  margin-bottom: 6px;
}

.agency-stat-value {
  font-size: 1.35rem;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.agency-line-stats-hint {
  margin-top: -0.25rem;
}

.selection-summary-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: #334155;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 999px;
  padding: 6px 12px;
}

.swal2-timer-progress-bar {
  background: #2f5bea !important;
}





</style>

<script>
   
  
    // Kung kailangan mo ng select2 init:
  
      $('.js-select2').select2({
        placeholder: 'Select an option',
        dropdownParent: '#modal-transfer_account'
      });
      $('.js-select2').select2({
        placeholder: 'Select an option',
        dropdownParent: '#modal-add-account-details'
      });
	    $('.js-select2').select2({
            dropdownParent: '#modal-new-agent'
          });
    
          $('.edit_agency').select2({
            dropdownParent: '#modal-edit-agent'
          });
  

  </script>