			<head>

			</head>

			<body>
				<div class="container-fluid content-inner py-0">
					<div class="row">
						<div class="col-sm-12">
							<div class="card">
								<div id="user-role" data-permissions="<%= permissions %>"></div>
								<div class="card-header d-flex justify-content-between align-items-center">
									<h3 class="card-title"><div class="breadcrumb1 flat">
										<a href="/dashboard" ><span class="fa fa-home"></span></a>
										
										<a href="/agency"class="active">Line</a>
									</div></h3>
								</div>
								<div class="card-body agency-page">
									<div class="d-none mb-3" id="selection-summary-row">
										<span class="selection-summary-chip me-2" id="selected-line-chip">
											<strong>LINE:</strong> <span id="selected-line-name">-</span>
										</span>
										<span class="selection-summary-chip" id="selected-agent-chip">
											<strong>AGENT:</strong> <span id="selected-agent-name">-</span>
										</span>
									</div>
									<div class="row g-3 mb-4 agency-line-stats" id="line-stat-row">
										<div class="col-6 col-lg" id="line-stat-card-scope">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label" id="line-stat-scope-label">Total Line</div>
												<div class="agency-stat-value" id="line-stat-scope-value">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Balance</div>
												<div class="agency-stat-value" id="line-stat-total-balance">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Credit</div>
												<div class="agency-stat-value" id="line-stat-total-credit">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Winloss</div>
												<div class="agency-stat-value" id="line-stat-total-winloss">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Rolling</div>
												<div class="agency-stat-value" id="line-stat-total-rolling">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Commission</div>
												<div class="agency-stat-value" id="line-stat-total-commission">—</div>
											</div>
										</div>
									</div>
									<div class="row g-3 mb-3 agency-line-stats d-none" id="agent-stat-row">
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Guest</div>
												<div class="agency-stat-value" id="agent-stat-total-guest">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Games</div>
												<div class="agency-stat-value" id="agent-stat-total-games">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Rolling</div>
												<div class="agency-stat-value" id="agent-stat-total-rolling">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Winloss</div>
												<div class="agency-stat-value" id="agent-stat-total-winloss">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Commission</div>
												<div class="agency-stat-value" id="agent-stat-total-commission">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Balance</div>
												<div class="agency-stat-value" id="agent-stat-total-balance">—</div>
											</div>
										</div>
										<div class="col-6 col-lg">
											<div class="agency-stat-card h-100">
												<div class="agency-stat-label">Total Credit</div>
												<div class="agency-stat-value" id="agent-stat-total-credit">—</div>
											</div>
										</div>
									</div>
									<div class="row g-3 agency-panels">
										<div class="col-12 col-xl-2-5">
											<div class="panel-box h-100">
												<div class="panel-header d-flex align-items-center justify-content-between">
													<button type="button" class="panel-title panel-title-sortable" id="btn-sort-line-panel" title="Click to sort" aria-label="Sort LINE list">
														LINE <span class="panel-title-sort-indicator" aria-hidden="true">▲</span>
													</button>
													<div class="d-flex align-items-center gap-1">
														<button type="button" class="btn btn-sm agency-toolbar-btn agency-toolbar-btn-muted" id="btn-line-panel-export" title="Download Excel" aria-label="Download Excel">
															<i class="fa fa-download" aria-hidden="true"></i>
														</button>
														<button type="button" class="btn btn-sm agency-toolbar-btn agency-toolbar-btn-primary bg-gradient-primary" id="btn-line-panel-add" data-bs-toggle="modal" data-bs-target="#modal-new-agency">
															<i class="fa fa-plus"></i>
														</button>
													</div>
												</div>
												<div class="panel-body">
													<div id="agency-grid" class="row gx-2 gy-2"></div>
												</div>
											</div>
										</div>

										<div class="col-12 col-xl-2-5">
											<div class="panel-box h-100">
												<div class="panel-header d-flex align-items-center justify-content-between">
													<button type="button" class="panel-title panel-title-sortable" id="btn-sort-agent-panel" title="Click to sort" aria-label="Sort AGENT list">
														AGENT <span class="panel-title-sort-indicator" aria-hidden="true">▲</span>
													</button>
													<div class="d-flex align-items-center gap-1">
														<button type="button" class="btn btn-sm agency-toolbar-btn agency-toolbar-btn-muted" id="btn-agent-panel-transfer" title="Transfer LINE">
															<i class="fa fa-exchange-alt"></i>
														</button>
														<button type="button" class="btn btn-sm agency-toolbar-btn agency-toolbar-btn-muted" id="btn-agent-panel-export" title="Download Excel" aria-label="Download Excel">
															<i class="fa fa-download" aria-hidden="true"></i>
														</button>
														<button type="button" class="btn btn-sm agency-toolbar-btn agency-toolbar-btn-primary bg-gradient-primary" id="btn-agent-panel-add-guest" data-bs-toggle="modal" data-bs-target="#modal-new-agent" title="Add Agent">
															<i class="fa fa-plus"></i>
														</button>
													</div>
												</div>
												<div class="panel-body" id="agent-panel-body">
													<div class="panel-empty-state" id="agent-panel-empty">
														Select LINE to load LINE list.
													</div>
													<div id="agent-list" class="panel-list d-none"></div>
												</div>
											</div>
										</div>

										<div class="col-12 col-xl-7">
											<div class="panel-box h-100">
												<div class="panel-header d-flex align-items-center justify-content-between flex-wrap gap-2">
													<div class="panel-title">GUEST</div>
													<div class="d-flex align-items-center gap-2 ms-auto">
														<div class="agency-guest-search-wrap">
															<i class="fa fa-search agency-guest-search-icon" aria-hidden="true"></i>
															<input
																type="search"
																class="form-control form-control-sm agency-guest-search-input"
																id="guest-panel-search"
																placeholder="Search all guests..."
																autocomplete="off">
														</div>
														<button type="button" class="btn btn-sm agency-toolbar-btn agency-toolbar-btn-primary bg-gradient-primary" id="btn-guest-panel-add">
															<i class="fa fa-plus"></i>
														</button>
													</div>
												</div>
												<div class="panel-body" id="guest-panel-body">
													<div class="panel-empty-state" id="guest-panel-empty">
														Open an agency to view guests.
													</div>
													<div id="guest-list" class="panel-list d-none"></div>
												</div>
											</div>
										</div>
									</div>
									<nav id="pagination-container" class="mt-3 d-flex justify-content-center">
										<ul class="pagination flex-wrap"></ul>
									</nav>
								</div>
							</div>
						</div>
					</div>
				</div>
				<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
			</body>
			<%- include ('../modals/accounts/new_agency'); -%>
				<%- include ('../modals/accounts/edit_agency'); -%>
				<%- include ('../modals/accounts/account_ledger_modal'); -%>
				<%- include ('../modals/accounts/account_details'); %>
				<%- include ('../modals/accounts/transfer_account'); %>
				<%- include ('../modals/accounts/new_agent') %>
				<%- include ('../modals/accounts/edit_agent') %>
				<%- include ('../modals/accounts/add_guest') %>
				<div class="modal fade" id="modal-edit-guest-table" tabindex="-1" aria-labelledby="modal-edit-guest-table-label" aria-hidden="true">
					<div class="modal-dialog modal-dialog-centered">
						<div class="modal-content">
							<div class="modal-header bg-primary">
								<h5 class="modal-title text-white" id="modal-edit-guest-table-label">Edit Guest</h5>
								<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>
							<form id="edit_guest_form">
								<div class="modal-body">
									<input type="hidden" id="edit_guest_id" name="txtGuestId">
									<div class="mb-0">
										<label for="edit_guest_name_input" class="form-label">Guest Name</label>
										<input type="text" class="form-control" id="edit_guest_name_input" name="txtGuestName" required maxlength="150">
									</div>
									<div class="mt-2 mb-0">
										<label for="edit_guest_membership_input" class="form-label">Membership No</label>
										<input type="text" class="form-control" id="edit_guest_membership_input" name="txtMembershipNo" inputmode="numeric" autocomplete="off" placeholder="8–10 digits">
									</div>
									<div class="mt-2 mb-0">
										<label for="edit_guest_remarks_input" class="form-label">Remarks</label>
										<textarea class="form-control" id="edit_guest_remarks_input" name="txtRemarks" rows="2" maxlength="500"></textarea>
									</div>
								</div>
								<div class="modal-footer">
									<button type="button" class="btn btn-outline-primary btn-sm me-auto" id="btn-open-transfer-from-edit-guest">Change LINE</button>
									<button type="submit" class="btn btn-primary btn-sm" id="btn-update-guest-table">Update</button>
									<button type="button" class="btn btn-alt-secondary btn-sm" data-bs-dismiss="modal">Close</button>
								</div>
							</form>
						</div>
					</div>
				</div>
				<div class="modal fade" id="modal-transfer-guest-table" tabindex="-1" aria-labelledby="modal-transfer-guest-table-label" aria-hidden="true">
					<div class="modal-dialog modal-dialog-centered">
						<div class="modal-content">
							<div class="modal-header bg-primary">
								<h5 class="modal-title text-white" id="modal-transfer-guest-table-label">Change Guest LINE</h5>
								<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>
							<form id="transfer_guest_form">
								<div class="modal-body">
									<input type="hidden" id="transfer_guest_id" name="txtGuestId">
									<div class="mb-2">
										<label class="form-label">Guest</label>
										<input type="text" class="form-control" id="transfer_guest_display" readonly disabled>
									</div>
									<div class="mb-2">
										<label class="form-label">Current LINE</label>
										<input type="text" class="form-control" id="transfer_guest_current_line" readonly disabled>
									</div>
									<div class="mt-2 mb-2">
										<label for="transfer_guest_agency_id" class="form-label">Transfer To LINE</label>
										<select class="form-select" id="transfer_guest_agency_id" required>
											<option value="">Select LINE</option>
										</select>
									</div>
									<div class="mb-0">
										<label for="transfer_guest_agent_id" class="form-label">Transfer To Agent</label>
										<select class="form-select" id="transfer_guest_agent_id" name="targetAgentId" required disabled>
											<option value="">Select Agent</option>
										</select>
									</div>
								</div>
								<div class="modal-footer">
									<button type="submit" class="btn btn-primary btn-sm" id="btn-transfer-guest-table">Transfer</button>
									<button type="button" class="btn btn-alt-secondary btn-sm" data-bs-dismiss="modal">Close</button>
								</div>
							</form>
						</div>
					</div>
				</div>
				<%- include ('../partials/permission_view_only_script') %>
					<%- include ('../partials/footer'); -%>
