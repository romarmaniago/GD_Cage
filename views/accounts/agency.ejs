  height: 28px;
  padding: 0;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0 !important;
  background: transparent !important;
}

.agency-row-actions .btn {
  border: 0 !important;
  background: transparent !important;
}

.agency-row-actions .btn.btn-outline-secondary,
.panel-row-actions .btn.btn-outline-secondary {
  color: #0b2f6d !important;
}

.agency-row-actions .btn.btn-outline-danger,
.panel-row-actions .btn.btn-outline-danger {
  color: #dc3545 !important;
}

.agency-row-actions .btn.btn-outline-primary,
.panel-row-actions .btn.btn-outline-primary {
  color: #2f5bea !important;
}

.agency-row-actions .btn:hover,
.agency-row-actions .btn:focus,
.panel-row-actions .btn:hover,
.panel-row-actions .btn:focus {
  background: transparent !important;
  color: inherit !important;
  box-shadow: none !important;
}

#btn-agent-panel-transfer,
#btn-agent-panel-export,
#btn-agent-panel-add-guest,
#btn-guest-panel-add,
#btn-line-panel-export,
#btn-line-panel-add {
  width: 32px;
  height: 32px;
  padding: 0;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.panel-list-item.is-active {
  background: #f3f7ff;
}

.agency-card-body {
  min-height: auto;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 16px;
}



.agency-row-actions {
  position: absolute;
  top: 50%;
  right: 10px;
  transform: translateY(-50%);
  display: flex;
  gap: 6px;
}

.agency-row-actions .btn {
  width: 28px;
  height: 28px;
