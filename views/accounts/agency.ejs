<style>



.agency-card {
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  transition: none;
  position: relative;
}

.agency-card:hover {
  transform: none;
  box-shadow: none;
}

.agency-card.is-selected {
  background: #f3f7ff;
}

.agency-card.is-search-match {
  background: #eef3ff;
}

.agency-card.is-search-dim {
  opacity: 0.35;
}

.panel-list-item.is-search-match {
  background: #eef3ff;
}

.panel-list-item.is-search-dim {
  opacity: 0.35;
}

.panel-list-agency-hint {
  display: block;
  font-size: 10px;
  color: #94a3b8;
  margin-top: 1px;
  letter-spacing: 0.2px;
}

.agency-list-item {
  border: 0;
  border-bottom: 1px solid #edf0f7;
  border-radius: 0;
  min-height: 54px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 0;
  background: transparent;
  justify-content: flex-start;
  padding-right: 84px;
}

#agency-grid {
  border-top: 1px solid #edf0f7;
}

.agency-panels .panel-box {
  background: #fff;
  border: 1px solid #edf0f7;
  border-radius: 14px;
  overflow: hidden;
}

.panel-header {
  border-bottom: 1px solid #edf0f7;
  padding: 12px 14px;
}

.panel-title {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.6px;
  color: #1f2937;
}

button.panel-title-sortable {
  border: 0;
  background: transparent;
  padding: 0;
  cursor: pointer;
  text-align: left;
}

button.panel-title-sortable:hover,
button.panel-title-sortable:focus {
  color: #2f5bea;
  outline: none;
}

.panel-title-sort-indicator {
  font-size: 10px;
  margin-left: 4px;
  color: #6c757d;
}

button.panel-title-sortable:hover .panel-title-sort-indicator,
button.panel-title-sortable:focus .panel-title-sort-indicator {
  color: #2f5bea;
}

.panel-body {
  padding: 14px;
  min-height: 520px;
}

.panel-empty-state {
  min-height: 460px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 12px;
  color: #9ca3af;
  border: 1px dashed #dbe2ef;
  border-radius: 10px;
  background: #fafbfd;
}

.panel-list {
  border-top: 1px solid #edf0f7;
  border-bottom: 1px solid #edf0f7;
}

.panel-list-item {
  min-height: 54px;
  border-bottom: 1px solid #edf0f7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 10px 8px;
}

.panel-list-item:last-child {
  border-bottom: 0;
}

.agency-guest-table thead th {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  color: #64748b;
  border-bottom: 1px solid #edf0f7;
  padding: 10px 8px;
  white-space: nowrap;
  text-align: center;
}

.agency-guest-table tbody td {
  font-size: 12px;
  color: #334155;
  border-bottom: 1px solid #edf0f7;
  padding: 10px 8px;
  vertical-align: middle;
  text-align: center;
}

.agency-guest-table tbody tr:last-child td {
  border-bottom: 0;
}

.agency-guest-table thead th.agency-guest-col,
.agency-guest-table tbody td.agency-guest-col,
.agency-guest-table thead th.agency-guest-membership-col,
.agency-guest-table tbody td.agency-guest-membership-col {
  text-align: left;
}

.agency-guest-table thead th.sortable-col {
  cursor: pointer;
  user-select: none;
}

.agency-guest-table thead th.sortable-col:hover,
.agency-guest-table thead th.sortable-col.is-sorted {
  color: #2f5bea;
  background: #dfe6ff;
}

.agency-guest-table .sort-indicator {
  font-size: 10px;
  margin-left: 4px;
  color: #6c757d;
}

.agency-guest-table thead th.sortable-col.is-sorted .sort-indicator {
  color: #2f5bea;
}

.agency-guest-table tbody td.agency-guest-membership-col {
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.agency-guest-search-wrap {
  position: relative;
  min-width: 160px;
  width: 200px;
  max-width: 42vw;
}

.agency-guest-search-icon {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 11px;
  color: #94a3b8;
  pointer-events: none;
}

.agency-guest-search-input {
  padding-left: 30px;
}

.agency-guest-line-hint {
  font-size: 10px;
  margin-top: 2px;
  letter-spacing: 0.2px;
}

.agency-guest-plus-btn {
  color: #2f5bea !important;
  text-decoration: none !important;
  font-size: 13px;
  line-height: 1;
}

.agency-guest-plus-btn:hover,
.agency-guest-plus-btn:focus {
  color: #173ea5 !important;
}

.agency-guest-remarks-link {
  font: inherit;
  color: #2f5bea  !important;
  font-weight: inherit !important;
  text-decoration: none !important;
  background: transparent;
  border: 0;
  padding: 0;
}

.agency-guest-remarks-link:hover,
.agency-guest-remarks-link:focus {
  color: #2f5bea  !important;
}

.panel-list-label {
  font-size: 13px;
  color: #44506a;
  font-weight: 600;
  text-transform: uppercase;
  text-decoration: none;
}

.panel-list-agent-link {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6px;
  flex: 1;
  min-width: 0;
  font-size: 13px;
  color: #44506a;
  text-decoration: none;
  text-transform: uppercase;
}

.panel-list-agent-link:hover {
  color: #2f5bea;
}

.panel-list-code {
  font-weight: 700;
  color: #1f2937;
  letter-spacing: 0.02em;
}

.panel-list-sep {
  color: #9ca3af;
  font-weight: 400;
}

.panel-list-name {
  font-weight: 600;
  color: #44506a;
}

.panel-row-actions {
  display: flex;
  align-items: center;
}

.panel-row-actions .btn {
