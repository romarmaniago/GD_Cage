<div class="modal fade" id="modal-additional-commission" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="additional-commission-modal-title">Add Additional Commission</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="additional-commission-form">
        <input type="hidden" id="additional-commission-id" value="" />
        <div class="modal-body">
          <div class="mb-3">
            <label for="additional-commission-program-date" class="form-label">Program Date</label>
            <input type="text" id="additional-commission-program-date" class="form-control" autocomplete="off" placeholder="YYYY-MM-DD" required />
          </div>
          <div class="mb-3">
            <label for="additional-commission-agent" class="form-label">Account</label>
            <select id="additional-commission-agent" class="js-select2 form-select" style="width: 100%;" data-placeholder="Select account" required>
              <option value="">Select account</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label d-block">Type</label>
            <div class="d-flex flex-wrap gap-3">
              <div class="form-check">
                <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="2" id="additional-commission-type-cashout" name="additional-commission-type" />
                <label class="form-check-label" for="additional-commission-type-cashout">Cash-out</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="1" id="additional-commission-type-deposit" name="additional-commission-type" />
                <label class="form-check-label" for="additional-commission-type-deposit">Deposit</label>
              </div>
            </div>
          </div>
          <div class="mb-3">
            <label for="additional-commission-amount" class="form-label">Amount</label>
            <input type="text" id="additional-commission-amount" class="form-control" inputmode="decimal" autocomplete="off" />
          </div>
          <div class="mb-3">
            <label for="additional-commission-remarks" class="form-label">Remarks</label>
            <textarea id="additional-commission-remarks" class="form-control" rows="3"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary" id="additional-commission-save-btn">Save</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </form>
    </div>
  </div>
</div>
