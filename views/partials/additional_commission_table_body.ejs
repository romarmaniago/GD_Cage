<div class="marker-balance-dt-wrap marker-balance-card table-responsive">
  <%- include('additional_commission_toolbar') %>
  <table id="additional-commission-tbl" class="table marker-balance-tbl w-100 mb-0">
    <thead>
      <tr>
        <th class="sortable-col" data-sort-key="programDate">Program Date <span class="sort-indicator">▼</span></th>
        <th class="sortable-col" data-sort-key="date">Date <span class="sort-indicator"></span></th>
        <th class="sortable-col" data-sort-key="account">Account # / Name <span class="sort-indicator"></span></th>
        <th class="sortable-col text-end" data-sort-key="amount">Amount <span class="sort-indicator"></span></th>
        <th class="sortable-col" data-sort-key="type">Type <span class="sort-indicator"></span></th>
        <th class="sortable-col col-remarks" data-sort-key="remarks">Remarks <span class="sort-indicator"></span></th>
        <th class="text-center">Action</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td colspan="7" class="text-center text-muted">Loading...</td>
      </tr>
    </tbody>
    <tfoot>
      <tr>
        <th colspan="3" class="text-end fw-bold">Total</th>
        <th id="additional-commission-total-amount" class="text-end fw-bold">0</th>
        <th colspan="3"></th>
      </tr>
    </tfoot>
  </table>
</div>
