<style>
  #loader-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    transition: opacity 0.8s ease, filter 0.8s ease, transform 0.8s ease;
  }

  #loader-container.loader-exit {
    opacity: 0;
    filter: blur(6px);
    transform: scale(0.98);
    pointer-events: none;
  }

  #loader-container .nav {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    background: linear-gradient(180deg, #0f0d0a 0%, #0b0b0b 45%, #000000 100%);
    text-align: center;
    padding: 0 2em;
    position: relative;
    overflow: hidden;
  }

  #loader-container .loader-stage {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #loader-container .loader-logo {
    display: block;
    width: min(38vw, 168px);
    height: auto;
    object-fit: contain;
    position: relative;
    z-index: 2;
    animation: gdLogoZoom 2s ease-in-out infinite alternate;
  }

  @keyframes gdLogoZoom {
    from { transform: scale(0.92); }
    to   { transform: scale(1.05); }
  }

  #loader-container .loader-text {
    margin: 1.75rem 0 0;
    color: #c8a24c;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  #loader-container .loader-progress {
    width: min(55vw, 200px);
    height: 2px;
    margin-top: 1.25rem;
    background: rgba(200, 162, 76, 0.15);
    border-radius: 2px;
    overflow: hidden;
  }

  #loader-container .loader-progress-bar {
    height: 100%;
    width: 45%;
    border-radius: 2px;
    background: linear-gradient(90deg, #6b4a12, #c8a24c, #f1d48a, #c8a24c);
    animation: gdProgressSlide 1.6s ease-in-out infinite;
  }

  @keyframes gdProgressSlide {
    0%   { transform: translateX(-110%); }
    100% { transform: translateX(260%); }
  }
</style>

<div id="loader-container">
  <section class="nav">
    <div class="loader-stage">
      <img src="/assets/images/GD-logo.png" alt="Golden Dragon" class="loader-logo">
      <p class="loader-text">Loading CageX</p>
      <div class="loader-progress" aria-hidden="true">
        <div class="loader-progress-bar"></div>
      </div>
    </div>
  </section>
</div>

<script>
  window.addEventListener('load', function () {
    setTimeout(function () {
      var loader = document.getElementById('loader-container');
      if (!loader) return;
      loader.classList.add('loader-exit');
      setTimeout(function () {
        loader.style.display = 'none';
      }, 800);
    }, 600);
  });
</script>
