<main class="main-content">
  <style>
    .iq-header-img::before {
      display: none;
    }

    /* Pare-parehong top spacing sa LAHAT ng pages (dashboard = standard) */
    .iq-banner .iq-navbar-header,
    .iq-navbar-header {
      height: 90px !important;
    }
    .iq-banner .iq-navbar-header .iq-container {
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
    .iq-banner .iq-navbar-header .iq-header-img {
      height: 180px !important;
    }
    /* Kanselahin ang -3rem pull-up ng hope-ui (safe lang yun noong 215px pa ang band).
       Wala nang negative margin kahit saan — header height lang ang kumokontrol. */
    .iq-banner:not(.hide) + .content-inner,
    .iq-banner:not(.hide) + .content-inner.dash-grid-wrap {
      margin-top: 0 !important;
    }
    /* Ang transparent/stretched na navbar ay huwag humarang sa mga control sa
       ilalim nito (hal. "September 2026" filter sa dashboard).
       Ang totoong nav items lang ang clickable. */
    .iq-navbar,
    .iq-navbar .navbar-inner,
    .iq-navbar .navbar-collapse {
      pointer-events: none;
    }
    .iq-navbar .navbar-brand,
    .iq-navbar .sidebar-toggle,
    .iq-navbar .navbar-toggler,
    .iq-navbar .navbar-nav,
    .iq-navbar .navbar-nav *,
    .iq-navbar .dropdown-menu,
    .iq-navbar .dropdown-menu * {
      pointer-events: auto;
    }
    /* Siguraduhing nasa ibabaw ng navbar ang dashboard date filter */
    .dash-rolling-daterange-toolbar {
      z-index: 1050 !important;
    }
    @media (max-width: 767.98px) {
      .iq-banner .iq-navbar-header,
      .iq-navbar-header {
        height: 60px !important;
      }
    }
  </style>
