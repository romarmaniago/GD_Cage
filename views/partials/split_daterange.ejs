<%
  const now = new Date();
  const monthAbbr = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const formatRangeDisplayDate = (d) => `${monthAbbr[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
  // Manual split inputs stay empty by default — placeholder only (no prefilled dates).
  const splitStart = typeof splitRangeStartValue !== 'undefined' ? String(splitRangeStartValue || '') : '';
  const splitEnd = typeof splitRangeEndValue !== 'undefined' ? String(splitRangeEndValue || '') : '';
  const prefix = typeof splitPrefix !== 'undefined' ? splitPrefix : 'split';
  const ns = typeof splitLocaleNs !== 'undefined' ? splitLocaleNs : 'house_expense';
  const wrapClass = typeof splitWrapClass !== 'undefined'
    ? splitWrapClass
    : 'house-expense-daterange-wrap house-expense-split-daterange';
  const startLabelRaw = typeof __ === 'function' ? __(`${ns}.start_date`) : '';
  const endLabelRaw = typeof __ === 'function' ? __(`${ns}.end_date`) : '';
  const startLabel = (!startLabelRaw || startLabelRaw === `${ns}.start_date` || /start_date$/i.test(startLabelRaw))
    ? 'Start'
    : startLabelRaw;
  const endLabel = (!endLabelRaw || endLabelRaw === `${ns}.end_date` || /end_date$/i.test(endLabelRaw))
    ? 'End'
    : endLabelRaw;
  const placeholderText = typeof splitPlaceholder !== 'undefined' && String(splitPlaceholder).trim()
    ? String(splitPlaceholder).trim()
    : 'Date';
  const startPlaceholder = typeof splitStartPlaceholder !== 'undefined' && String(splitStartPlaceholder).trim()
    ? String(splitStartPlaceholder).trim()
    : placeholderText;
  const endPlaceholder = typeof splitEndPlaceholder !== 'undefined' && String(splitEndPlaceholder).trim()
    ? String(splitEndPlaceholder).trim()
    : placeholderText;
  const sampleHint = formatRangeDisplayDate(now);
%>
<div id="<%= prefix %>-split-daterange-wrapper" class="<%= wrapClass %>" data-range-start="<%= splitStart %>" data-range-end="<%= splitEnd %>">
  <input type="text" id="<%= prefix %>-start-date" class="form-control form-control-sm text-center split-date-input house-expense-split-date-input" value="" placeholder="<%= startPlaceholder %>" title="Type date, e.g. <%= sampleHint %>" autocomplete="off" spellcheck="false" aria-label="<%= startLabel %>" />
  <span class="house-expense-daterange-separator" aria-hidden="true">to</span>
  <input type="text" id="<%= prefix %>-end-date" class="form-control form-control-sm text-center split-date-input house-expense-split-date-input" value="" placeholder="<%= endPlaceholder %>" title="Type date, e.g. <%= sampleHint %>" autocomplete="off" spellcheck="false" aria-label="<%= endLabel %>" />
</div>
