<div id="additional-commission-daterange-mount" class="additional-commission-daterange-mount">
  <div class="additional-commission-daterange-wrap">
    <input
      type="text"
      id="additional-commission-daterange"
      class="form-control form-control-sm text-center"
      placeholder="Select date range"
      autocomplete="off"
    />
  </div>
  <%- include('split_daterange', {
    splitPrefix: 'additional-commission',
    splitLocaleNs: 'commission',
    splitWrapClass: 'additional-commission-daterange-wrap additional-commission-split-daterange junket-loss-split-daterange house-expense-split-daterange'
  }) %>
</div>
<%# Moved next to the Add button by additional_commission.js (layoutAdditionalCommissionControls). %>
<button type="button" id="btn-additional-commission-settle" class="btn btn-sm btn-primary d-none additional-commission-settle-btn" data-view-only-disable>
  <%= __('house_expense.settle') || 'Settle' %>
</button>
<button
  type="button"
  class="expense-cat-panel-add-btn js-additional-commission-add d-none"
  id="btn-add-additional-commission"
  title="Add additional commission"
  aria-label="Add additional commission"
  data-view-only-disable
>
  <i class="fa fa-plus" aria-hidden="true"></i>
</button>
