      failed_to_insert_history: "<%= __('monthly_reset.failed_to_insert_history') %>",
      error: "<%= __('monthly_reset.error') %>"
    };
  </script>
  <script src="/assets/js/functions/reset.js"></script>
  
  <script>
    // Monthly Settle from Sidebar
    document.addEventListener('DOMContentLoaded', function() {
        // Delete Test Data from Sidebar
        const sidebarDeleteTestData = document.getElementById('sidebarDeleteTestData');
      if (sidebarDeleteTestData) {
        sidebarDeleteTestData.addEventListener('click', async function(e) {
          e.preventDefault();

          const confirmDelete = await SwalConfirm.fire({
            title: 'Delete Test Data',
            message: `
              <p>This is for testing only.</p>
              <p class="text-muted small">Current data will be reset to 0.</p>
            `,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, delete data'
          });

          if (!confirmDelete.isConfirmed) return;

          try {
            Swal.fire({
              title: 'Processing...',
              text: 'Deleting data...',
              allowOutsideClick: false,
              didOpen: () => {
                Swal.showLoading();
              }
            });

            const resetResponse = await fetch('/delete-test-data', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
            });

            if (!resetResponse.ok) throw new Error('Failed to delete data');

            Swal.fire({
              icon: 'success',
              title: 'Done',
              text: 'Data has been delete successfully.',
              confirmButtonText: 'OK'
            }).then(() => {
              window.location.reload();
            });
          } catch (error) {
            console.error('Delete data error:', error);
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: error.message || 'Failed to delete data.',
              confirmButtonText: 'OK'
            });
          }
        });
      }
    // Monthly Settle from Sidebar
      const sidebarSettleLink = document.getElementById('sidebarMonthlySettle');
      if (sidebarSettleLink) {
        sidebarSettleLink.addEventListener('click', async function(e) {
          e.preventDefault();

          // Dapat nasa Dashboard page (kung saan nanggagaling ang Commission, Win/Loss, etc.)
          const isOnDashboard = window.location.pathname === '/dashboard' || window.location.pathname === '/dashboard/';
          if (!isOnDashboard) {
            Swal.fire({
              icon: 'warning',
              title: 'Dashboard Required',
              text: 'You must be on the Dashboard page to perform Monthly Settle.',
              confirmButtonText: 'OK'
            });
            return;
          }

          // Pre-check: show error immediately if cannot settle (bago pa ang confirmation)
          try {
            const checkRes = await fetch('/monthly-settle-check');
            const check = await checkRes.json();
            if (!check.canSettle) {
              Swal.fire({
                icon: 'error',
                title: 'Error',
                text: check.message || 'Cannot settle at this time.',
                confirmButtonText: 'OK'
              });
              return;
            }
          } catch (err) {
            console.error('monthly-settle-check failed:', err);
          }
          
          // Confirmation dialog
          const confirmSettle = await Swal.fire({
            title: 'Monthly Settle',
            html: `
              <p>Are you sure you want to settle the month?</p>
              <p class="text-muted small">
                • NN Chips, CC Chips, Commission, Win/Loss and Rolling will become 0<br>
              </p>
            `,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, settle now',
            cancelButtonText: 'Cancel'
          });
          
          if (!confirmSettle.isConfirmed) return;
          
          try {
            // Show loading
            Swal.fire({
              title: 'Processing...',
              text: 'Settling data...',
              allowOutsideClick: false,
              didOpen: () => {
                Swal.showLoading();
              }
            });
            
            // Get current values from dashboard (if on dashboard page)
            const commissionValue = document.querySelector('input[name="COMMISSION_HISTORY"]')?.value || '0';
            const winlossValue = document.querySelector('input[name="WINLOSS_HISTORY"]')?.value || '0';
            const totalRollingValue = document.querySelector('input[name="TOTAL_ROLLING_HISTORY"]')?.value || '0';
            const houseRollingValue = document.querySelector('input[name="HOUSE_ROLLING_HISTORY"]')?.value || '0';
            const expenseValue = document.querySelector('input[name="EXPENSE_HISTORY"]')?.value || '0';
            const nnCashoutValue = document.querySelector('input[name="NN_CASHOUT"]')?.value ?? '';
            const ccCashoutValue = document.querySelector('input[name="CC_CASHOUT"]')?.value ?? '';
            
            // Step 1: Save to history
            const historyResponse = await fetch('/insert-dash-history', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                COMMISSION_HISTORY: commissionValue,
                WINLOSS_HISTORY: winlossValue,
                EXPENSE_HISTORY: expenseValue,
                TOTAL_ROLLING_HISTORY: totalRollingValue,
                HOUSE_ROLLING_HISTORY: houseRollingValue,
                NN_CASHOUT: nnCashoutValue,
                CC_CASHOUT: ccCashoutValue
              })
            });
            
            if (!historyResponse.ok) {
              const errData = await historyResponse.json().catch(() => ({}));
              throw new Error(errData.message || 'Failed to save history');
            }
            const historyData = await historyResponse.json().catch(() => ({}));
            
            // Step 2: Reset the values (set RESET = 0) at i-tag ang MONTH_SETTLE_ID para sa undo
            const resetResponse = await fetch('/reset-main-cage-balance', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                month_settle_id: historyData.month_settle_id
              })
            });
            
            if (!resetResponse.ok) throw new Error('Failed to reset balances');
            
            // Success!
            Swal.fire({
              icon: 'success',
              title: 'Monthly Settle Successful!',
              text: 'NN Chips, CC Chips, Commission, Win/Loss and Rolling have been saved to history and reset to 0.',
              confirmButtonText: 'OK'
            }).then(() => {
              // Reload the page to show updated values
              window.location.reload();
            });
            
          } catch (error) {
            console.error('Monthly settle error:', error);
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: error.message || 'An error occurred during settlement. Please try again.',
              confirmButtonText: 'OK'
            });
          }
        });
      }
    });
  </script>
</aside> 
