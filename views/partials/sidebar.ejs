
<style>
/* Golden Dragon sidebar — light gold body, matches dashboard card theme */
aside.sidebar.gd-sidebar {
    --gd-sidebar-bg-top: #fbf0d4;
    --gd-sidebar-bg-bottom: #f6e4b8;
    --gd-sidebar-gold: #c8a24c;
    --gd-sidebar-gold-dark: #6b4f14;
    --gd-sidebar-text: #262019;
    --gd-sidebar-text-muted: #4a4238;
    --gd-sidebar-text-subtle: #7a6a4a;
    --gd-sidebar-border: rgba(154, 113, 26, 0.3);
    --gd-sidebar-gold-gradient: linear-gradient(160deg, #f1d48a 0%, #c8a24c 100%);
    --gd-sidebar-hover-bg: rgba(154, 113, 26, 0.14);
    display: flex;
    flex-direction: column;
    height: 100vh;
    min-height: 100vh;
    overflow: visible;
    background: linear-gradient(180deg, var(--gd-sidebar-bg-top) 0%, var(--gd-sidebar-bg-bottom) 100%) !important;
    border-right: 1px solid var(--gd-sidebar-border);
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.12);
    color: var(--gd-sidebar-text-muted);
}

aside.sidebar.gd-sidebar .sidebar-header {
    position: relative;
    overflow: visible;
    flex-shrink: 0;
    background: transparent;
    border-bottom: 1px solid var(--gd-sidebar-border);
}

aside.sidebar.gd-sidebar .sidebar-toggle {
    z-index: 1001;
    background: var(--gd-sidebar-gold-gradient) !important;
    color: #1a1205 !important;
    box-shadow: 0 2px 8px rgba(200, 162, 76, 0.35) !important;
}

aside.sidebar.gd-sidebar .sidebar-toggle:hover {
    color: #1a1205 !important;
    filter: brightness(1.08);
}

aside.sidebar.gd-sidebar .sidebar-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    max-height: none !important;
    scrollbar-width: none;
    -ms-overflow-style: none;
}

aside.sidebar.gd-sidebar .sidebar-body::-webkit-scrollbar {
    width: 0;
    display: none;
}

aside.sidebar.gd-sidebar .sidebar-footer {
    margin-top: auto;
    flex-shrink: 0;
    border-top: 1px solid var(--gd-sidebar-border);
    color: var(--gd-sidebar-text-subtle) !important;
}

aside.sidebar.gd-sidebar .sidebar-footer .text-muted {
    color: var(--gd-sidebar-gold-dark) !important;
    letter-spacing: 0.08em;
}

aside.sidebar.gd-sidebar .sidebar-list {
    padding-bottom: 1rem;
}

aside.sidebar.gd-sidebar .hr-horizontal {
    border: 0;
    height: 1px;
    margin: 0.75rem 1rem;
    background: linear-gradient(90deg, transparent, rgba(154, 113, 26, 0.55), transparent);
    opacity: 1;
}

aside.sidebar.gd-sidebar .nav-link {
    color: var(--gd-sidebar-text-muted) !important;
    transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
}

aside.sidebar.gd-sidebar .nav-link .icon,
aside.sidebar.gd-sidebar .nav-link .right-icon {
    color: inherit;
}

aside.sidebar.gd-sidebar .nav-link .item-name,
aside.sidebar.gd-sidebar .nav-link.static-item .default-icon {
    color: inherit;
}

aside.sidebar.gd-sidebar .nav-item.static-item .nav-link.static-item {
    color: var(--gd-sidebar-gold-dark) !important;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.95;
}

aside.sidebar.gd-sidebar .nav-link:hover,
aside.sidebar.gd-sidebar .nav-link:focus {
    color: var(--gd-sidebar-gold-dark) !important;
    background: var(--gd-sidebar-hover-bg) !important;
    box-shadow: inset 3px 0 0 rgba(154, 113, 26, 0.6) !important;
}

aside.sidebar.gd-sidebar .nav-link.active,
aside.sidebar.gd-sidebar .nav-link.open,
aside.sidebar.gd-sidebar .nav-link[aria-expanded="true"],
aside.sidebar.gd-sidebar .nav-link.bg-gradient-primary {
    color: #1a1205 !important;
    background: var(--gd-sidebar-gold-gradient) !important;
    box-shadow: 0 4px 12px rgba(200, 162, 76, 0.28) !important;
}

aside.sidebar.gd-sidebar .nav-link.active .icon,
aside.sidebar.gd-sidebar .nav-link.open .icon,
aside.sidebar.gd-sidebar .nav-link[aria-expanded="true"] .icon,
aside.sidebar.gd-sidebar .nav-link.bg-gradient-primary .icon,
aside.sidebar.gd-sidebar .nav-link.active .right-icon,
aside.sidebar.gd-sidebar .nav-link.open .right-icon,
aside.sidebar.gd-sidebar .nav-link[aria-expanded="true"] .right-icon {
    color: #1a1205 !important;
}

aside.sidebar.gd-sidebar .sub-nav .nav-link {
    color: var(--gd-sidebar-text-subtle) !important;
}

aside.sidebar.gd-sidebar .sub-nav .nav-link:hover,
aside.sidebar.gd-sidebar .sub-nav .nav-link:focus {
    color: var(--gd-sidebar-gold-dark) !important;
    background: rgba(154, 113, 26, 0.1) !important;
    box-shadow: inset 3px 0 0 rgba(154, 113, 26, 0.45) !important;
}

aside.sidebar.gd-sidebar .sub-nav .nav-link.active,
aside.sidebar.gd-sidebar .sub-nav .nav-link.bg-gradient-primary {
    color: var(--gd-sidebar-gold-dark) !important;
    background: rgba(154, 113, 26, 0.1) !important;
    box-shadow: inset 3px 0 0 rgba(154, 113, 26, 0.45) !important;
}

/* Pag nasa History page, hindi i-highlight ang Monthly Settle parent */
aside.sidebar.gd-sidebar .nav-item.monthly-settle-parent > .nav-link {
    background: transparent !important;
    color: var(--gd-sidebar-text-muted) !important;
    box-shadow: none !important;
}

/* Extra breathing room above gapped items — single-direction so consecutive gapped items don't stack margins */
aside.sidebar.gd-sidebar .nav-item-gapped {
    margin-top: 0.5rem;
}

/* Space between a dropdown's sub-items and the next menu item */
aside.sidebar.gd-sidebar .sub-nav {
    margin-bottom: 0.5rem !important;
}
</style>

