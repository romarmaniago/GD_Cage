<script>
  $(function () {
    if (typeof window.houseExpenseInitCategoryAddUi === 'function') {
      window.houseExpenseInitCategoryAddUi();
    }
    if (typeof window.houseExpenseInitVehicleUi === 'function') {
      window.houseExpenseInitVehicleUi();
    }

    $(document).on('click', '.js-house-expense-add-main-cat', function (e) {
      e.preventDefault();
      e.stopPropagation();
      if (typeof window.addHouseExpenseMainCategory === 'function') {
        window.addHouseExpenseMainCategory();
      } else if ($('#modal-house-expense-add-category').length) {
        window.houseExpenseAddCategoryMode = 'main';
        $('#modal-house-expense-add-category').appendTo('body').modal('show');
      }
    });

    $(document).on('click', '.js-house-expense-add-sub-cat', function (e) {
      e.preventDefault();
      e.stopPropagation();
      if ($(this).prop('disabled')) return;
      if (typeof window.addHouseExpenseSubCategory === 'function') {
        window.addHouseExpenseSubCategory();
      } else if ($('#modal-house-expense-add-category').length) {
        window.houseExpenseAddCategoryMode = 'sub';
        $('#modal-house-expense-add-category').appendTo('body').modal('show');
      }
    });

    $(document).on('click', '.js-house-expense-add-item', function (e) {
      e.preventDefault();
      e.stopPropagation();
      if ($(this).prop('disabled')) return;
      if (typeof window.addHouseExpenseFromExplorer === 'function') {
        window.addHouseExpenseFromExplorer();
      } else if (typeof window.addHouseExpense === 'function') {
        window.addHouseExpense();
      }
    });

    var dashHouseExpenseModal = document.getElementById('modal-dash-house-expense');
    if (dashHouseExpenseModal) {
      window.openDashboardHouseExpenseModal = function () {
        bootstrap.Modal.getOrCreateInstance(dashHouseExpenseModal).show();
      };
      dashHouseExpenseModal.addEventListener('shown.bs.modal', function () {
        if (typeof window.reloadData === 'function') {
          window.reloadData();
        }
      });
    }
  });
</script>
