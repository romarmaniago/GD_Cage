<link rel="stylesheet" href="/assets/css/daily_report_winloss.css">
<link rel="stylesheet" href="/assets/css/dash_service_table.css">
<link rel="stylesheet" href="/assets/css/commission.css">
<link rel="stylesheet" href="/assets/css/additional_commission.css">
<!-- Loaded last so modal th / gold vars override panel-specific table themes -->
<link rel="stylesheet" href="/assets/css/dashboard_grid.css">

<div class="conatiner-fluid content-inner py-3 dash-grid-wrap">
   <div id="user-role" data-permissions="<%= permissions %>"></div>

   <%
      function fmtAmt(n) {
         const v = Math.round(Number(n) || 0);
         if (v < 0) return '<span class="text-dash-neg">(' + Math.abs(v).toLocaleString('en-US') + ')</span>';
         return v.toLocaleString('en-US');
      }
      function fmtNeg(n) {
         const v = Math.round(Number(n) || 0);
         if (!v) return '0';
         return '<span class="text-dash-neg">(' + Math.abs(v).toLocaleString('en-US') + ')</span>';
      }

      function matchServiceCategory(serviceType, category) {
         var raw = String(serviceType || '').trim().toLowerCase();
         if (!raw) return false;
         if (category === 'fnb') {
            if (raw === 'fnb' || raw === 'f & b') return true;
            var compact = raw.replace(/\s+/g, '').replace(/&/g, '');
            return compact === 'fb' || compact === 'fnb' || raw.indexOf('f&b') !== -1 || raw.indexOf('f & b') !== -1;
         }
         if (category === 'hotel') return raw === 'hotel' || raw.indexOf('hotel') !== -1;
         if (category === 'delivery') {
            if (raw === 'incidental' || raw.indexOf('incidental') !== -1) return false;
            return raw === 'delivery' || raw.indexOf('delivery') !== -1;
         }
         if (category === 'incidental') return raw === 'incidental' || raw.indexOf('incidental') !== -1;
         return raw === String(category || '').trim().toLowerCase();
      }

      function sumServiceRows(rows, category) {
         if (!rows || !rows.length) return 0;
         var total = 0;
         rows.forEach(function (row) {
            if (matchServiceCategory(row.SERVICE_TYPE, category)) total += (+row.TOTAL || 0);
         });
         return total;
      }

      function signedServiceBalance(category) {
         var guestIn = sumServiceRows(sqlServiceCashGuest, category) + sumServiceRows(sqlServiceDepositGuest, category);
         var junketOut = sumServiceRows(sqlServiceCashJunket, category) + sumServiceRows(sqlServiceDepositJunket, category);
         return guestIn - junketOut;
      }

      function junketServiceOut(category) {
         return sumServiceRows(sqlServiceCashJunket, category) + sumServiceRows(sqlServiceDepositJunket, category);
      }

      function sumAllServiceRows(rows) {
         if (!rows || !rows.length) return 0;
         return rows.reduce((sum, row) => sum + (+row.TOTAL || 0), 0);
      }

      function pickCurrency(rows, code) {
         if (!rows || !rows.length) return 0;
         const row = rows.find((r) => String(r.CODE || '').toUpperCase() === String(code).toUpperCase());
         return row ? (+row.PENDING || 0) : 0;
      }

      var nnChipsBalance =
         (+sqlNNChipsBuyin[0].NNChipsBuyin || 0) -
         (+sqlNNChipsCashout[0].NNChipsCashout || 0) -
         (+sqlAccountNNChips[0].TOTAL_NN || 0) +
         (+sqlTotalCashOutRolling[0].TOTAL_CASHOUT || 0) -
         (+sqlTotalRealRolling[0].TOTAL_REAL_ROLLING || 0) +
         (+sqlNNChipsRolling[0].NNChipsRolling || 0) +
         (+sqlCCChipsRolling[0].CCChipsRolling || 0) +
         (+sqlNNBuyin[0].NNBuyin || 0) -
         (+sqlNNReturn[0].NNReturn || 0) -
         (+sqlRollerNNSubtract[0].ROLLER_NN_SUBTRACT || 0) +
         (+sqlRollerNNAdd[0].ROLLER_NN_ADD || 0) -
         (+sqlNNChipsMonthlySettle[0].NNChipsMonthlySettle || 0);

      var ccChipsBalance =
         (+sqlCCChipsBuyin[0].CCChipsBuyin || 0) -
         (+sqlCCChipsCashout[0].CCChipsCashout || 0) +
         (+sqlTotalRealRolling[0].TOTAL_REAL_ROLLING || 0) -
         (+sqlCCChipsRolling[0].CCChipsRolling || 0) -
         (+sqlNNChipsRolling[0].NNChipsRolling || 0) +
         (+sqlAccountCCChipsReturn[0].CC_CHIPS_RETURN || 0) -
         (+sqlCCChipsBuyinGame[0].TOTAL_CC || 0) +
         (+sqlCCBuyin[0].CCBuyin || 0) -
         (+sqlCCReturn[0].CCReturn || 0) -
         (+sqlRollerCCSubtract[0].ROLLER_CC_SUBTRACT || 0) +
         (+sqlRollerCCAdd[0].ROLLER_CC_ADD || 0) -
         (+sqlCCChipsMonthlySettle[0].CCChipsMonthlySettle || 0);

      var totalChipsBalance = nnChipsBalance + ccChipsBalance;
      var rcChipsBalance = (+sqlUnreturnedRollerChips[0].TOTAL_UNRETURNED || 0);
      var additionalCommissionSettlement = Math.round(+sqlAdditionalCommission || 0);

      var cashInTotal =
         (+sqlCashDeposit[0].CASH_DEPOSIT || 0) +
         (+sqlAccountDepositCashIn[0].ACCOUNT_DEPOSIT || 0) +
         (+sqlSettlementDepositAmount[0].SETTLEMENT_DEPOSIT || 0) +
         (+sqlTotalChipsCashout[0].TotalChipsCashout || 0) +
         (+sqlNNChipsAccountCash[0].TOTAL_NN_CASH || 0) +
         (+sqlCCChipsBuyinCashOnly[0].CC_CHIPS_BUYIN_CASH_ONLY || 0) +
         sumAllServiceRows(sqlServiceCashGuest) +
         sumAllServiceRows(sqlServiceDepositGuest) +
         (+sqlMArkerReturnCash[0].MARKER_RETURN_CASH || 0) +
         (+sqlRollerTipCashOut[0].ROLLER_TIP_CASHIN || 0) +
         (+sqlRollerTipIn[0].TIP_IN_CASHIN || 0);

      var cashOutTotal =
         (+sqlCCChipsBuyin[0].CCChipsBuyin || 0) +
         (+sqlCashWithdraw[0].CASH_WITHDRAW || 0) +
         (+sqlJunketExpense[0].JUNKET_EXPENSE || 0) +
         (+sqlNNChipsBuyin[0].NNChipsBuyin || 0) +
         (+sqlAccountWithdraw[0].ACCOUNT_WITHDRAW || 0) +
         (+sqlTotalCashOut[0].TOTAL_CASHOUT || 0) +
         (+sqlAccountSettlement[0].ACCOUNT_SETTLEMENT || 0) +
         (+sqlAccountServicesDeduct[0].ACCOUNT_DEDUCT_SERVICES || 0) +
         (+sqlMarkerIssueAccount[0].TOTAL_ISSUE_RECORD || 0) +
         sumAllServiceRows(sqlServiceCashJunket) +
         sumAllServiceRows(sqlServiceDepositJunket) +
         (+sqlAccountTransfer[0].ACCOUNT_TRANSFER || 0) +
         (+sqlManualBalancing[0].MANUAL_BALANCING || 0) +
         (+sqlJunketLoss[0].JUNKET_LOSS || 0) +
         (+sqlTipSettlement[0].TIP_SETTLEMENT || 0) +
         additionalCommissionSettlement;

      var mxCashNet = (+sqlMxCashNet[0].MX_CASH_NET || 0);
      var cashBalance = cashInTotal - cashOutTotal + mxCashNet;

      var guestBalance = Math.round(
         (+sqlAccountDeposit[0].ACCOUNT_DEPOSIT || 0) +
         (+sqlSettlementDepositAmount[0].SETTLEMENT_DEPOSIT || 0) -
         (+sqlAccountWithdraw[0].ACCOUNT_WITHDRAW || 0) -
         (+sqlAccountDeduct[0].ACCOUNT_DEDUCT || 0) -
         (+sqlAccountServicesDeduct[0].ACCOUNT_DEDUCT_SERVICES || 0) -
         (+sqlMArkerReturnDeposit[0].MARKER_RETURN_DEPOSIT || 0)
      );

      var houseBalance = cashBalance + totalChipsBalance;
      var netJunketMoney = houseBalance - guestBalance;
      var netJunketCash = cashBalance - guestBalance;

      var winLossTotal = parseFloat(
         (+sqlWinLossReset[0].RESET_CASHIN || 0) -
         (+sqlTotalCashOutReset[0].CASHOUT_RESET || 0) +
         (+sqlWinlossManual[0].WINLOSS || 0)
      );

      var totalRollingAmount =
         (+sqlTotalRollingReset[0].RESET_ROLLING || 0) -
         (+sqlTotalCashOutRollingReset[0].RESET_CASHOUT || 0) +
         (+sqlTotalRollingManual[0].TOTAL_ROLLING || 0) +
         (+sqlReturnRollerCCChips[0].RETURN_ROLLER_CC || 0) -
         (+sqlCCChipsBuyinGameReset[0].TOTAL_CC || 0);

      var houseRollingAmount = (+sqlHouseRollingReset[0].HouseRollingChips || 0);
      var commissionSettlement = Math.round(+sqlCommissionSettlement || 0);
      var expenseReset = (+sqlJunketExpenseReset[0].RESET_EXPENSE || 0);
      var junketLossAmount = (+sqlJunketLoss[0].JUNKET_LOSS || 0);
      var junketCreditAmount = (+sqlJunketCredit[0].JUNKET_CREDIT || 0);
      var tipSettlementAmount = (+sqlTipSettlement[0].TIP_SETTLEMENT || 0);
      var tipRollerGross = (+sqlRollerTipGross[0].ROLLER_TIP_GROSS || 0);
      var tipAvailableBalance = Math.max(0, tipRollerGross - tipSettlementAmount);
      var serviceSettleTotal = (sqlServiceSettle && sqlServiceSettle[0] ? (+sqlServiceSettle[0].TOTAL || 0) : 0);

      var creditTotal =
         (+sqlMarkerIssueGame[0].TOTAL_ISSUE_GAME || 0) +
         (+sqlMarkerIssueAccount[0].TOTAL_ISSUE_RECORD || 0) -
         (+sqlNNChipsAccountMarker[0].TOTAL_NN_MARKER || 0) -
         (+sqlMArkerReturnCash[0].MARKER_RETURN_CASH || 0) -
         (+sqlMArkerReturnDeposit[0].MARKER_RETURN_DEPOSIT || 0) -
         (+sqlChipsReturnMarker[0].CHIPS_RETURN_MARKER || 0);

      function escHtml(value) {
         return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
      }

      var dashServiceCategoryRows = Array.isArray(serviceCategoryRows) ? serviceCategoryRows : [];
      if (!dashServiceCategoryRows.length) {
         dashServiceCategoryRows = [
            { key: 'fnb', label: 'F & B', balance: signedServiceBalance('fnb'), junketOut: junketServiceOut('fnb'), modalId: 'modal-dash-fnb' },
            { key: 'hotel', label: 'Hotel', balance: signedServiceBalance('hotel'), junketOut: junketServiceOut('hotel'), modalId: 'modal-dash-hotel' },
            { key: 'incidental', label: 'Incidental', balance: signedServiceBalance('incidental'), junketOut: junketServiceOut('incidental'), modalId: 'modal-dash-incidental' },
            { key: 'delivery', label: 'Delivery', balance: signedServiceBalance('delivery'), junketOut: junketServiceOut('delivery'), modalId: 'modal-dash-delivery' }
         ];
      }

      var serviceJunketOutTotal = dashServiceCategoryRows.reduce(function (sum, cat) {
         return sum + (+cat.junketOut || 0);
      }, 0);

      var wlSharePct = typeof dashboardWlSharePct === 'number' ? dashboardWlSharePct : (dashboardWlShareDefault || 65);
      var wlSettlement = Math.round(winLossTotal * (wlSharePct / 100));
      var casinoAnticipatedTotal = wlSettlement - serviceSettleTotal;
      var canEditWlRate = (permissions === 0 || permissions === '0');

      var companyExpenseBase =
         expenseReset +
         junketLossAmount +
         commissionSettlement +
         additionalCommissionSettlement;
      var companyExpenseTotal = companyExpenseBase + serviceJunketOutTotal;

      var grandAnticipatedProfit = casinoAnticipatedTotal - companyExpenseTotal;

      var usdBalance = pickCurrency(sqlCurrencyPending, 'USD');
      var gcashBalance = pickCurrency(sqlCurrencyPending, 'GCASH');
      var phpBalance = cashBalance;
      var cageBalanceTotal = usdBalance + gcashBalance + phpBalance + totalChipsBalance;
      var cageBalanceDiff = houseBalance - cageBalanceTotal;

      var nowStamp = new Date();
      var pad2 = function(n) { return (n < 10 ? '0' : '') + n; };
      var fmtMd = function(d) { return (d.getMonth() + 1) + '/' + d.getDate(); };
      var monthStart = dashboardCutoffRange.startAt;
      var monthEnd = dashboardCutoffRange.endAt;
      var dashPeriodLabel = fmtMd(monthStart) + ' \u2013 ' + fmtMd(monthEnd);
      var nowStampDisplay = nowStamp.getFullYear() + '-' + pad2(nowStamp.getMonth() + 1) + '-' + pad2(nowStamp.getDate()) + ' ' + pad2(nowStamp.getHours()) + ':' + pad2(nowStamp.getMinutes());
      var dashboardDateFrom = monthStart.getFullYear() + '-' + pad2(monthStart.getMonth() + 1) + '-' + pad2(monthStart.getDate());
      var dashboardDateTo = monthEnd.getFullYear() + '-' + pad2(monthEnd.getMonth() + 1) + '-' + pad2(monthEnd.getDate());
   %>

   <form id="expense-form" action="/insert-dash-history" method="POST">
      <input type="hidden" name="EXPENSE_HISTORY" value="<%- expenseReset %>">
      <input type="hidden" name="COMMISSION_HISTORY" value="<%- commissionSettlement %>">
      <input type="hidden" name="WINLOSS_HISTORY" value="<%- winLossTotal %>">
      <input type="hidden" name="WINLOSS_HISTORY1" value="0">
      <input type="hidden" name="TOTAL_ROLLING_HISTORY" value="<%- totalRollingAmount %>">
      <input type="hidden" name="HOUSE_ROLLING_HISTORY" value="<%- houseRollingAmount %>">
      <input type="hidden" name="NN_CASHOUT" value="<%- nnChipsBalance %>">
      <input type="hidden" name="CC_CASHOUT" value="<%- ccChipsBalance %>">
      <input type="hidden" id="dash-date-from" value="<%= dashboardDateFrom %>">
      <input type="hidden" id="dash-date-to" value="<%= dashboardDateTo %>">

      <div class="row g-3 mb-3 dash-top-row">
         <!-- Cage Balance + Main -->
         <div class="col-xl-2 col-lg-3 align-self-start">
            <div class="dash-card-stack" id="dash-cage-main-panel">
               <div class="card dash-card dash-panel-narrow gd-dash-panel is-light-body">
                  <div class="card-header dash-card-header-compact d-flex justify-content-between align-items-center">
                     <a href="/activity_log">Cage Balance</a>
                     <span class="dash-card-meta"><%= nowStampDisplay %></span>
                  </div>
                  <div class="card-body">
                     <div class="dash-kv-group-title is-warn">Cash</div>
                     <div class="dash-kv"><span class="dash-kv-label">USD $</span><span class="dash-kv-value"><%- fmtAmt(usdBalance) %></span></div>
                     <div class="dash-kv"><span class="dash-kv-label">GCASH</span><span class="dash-kv-value"><%- fmtAmt(gcashBalance) %></span></div>
                     <div class="dash-kv"><span class="dash-kv-label">PHP ₱</span><span class="dash-kv-value"><%- fmtAmt(phpBalance) %></span></div>
                     <div class="dash-kv-group-title is-warn">Chips</div>
                     <div class="dash-kv"><span class="dash-kv-label"><a href="#modal-new-nn-chips" data-bs-toggle="modal" data-view-only-disable>NN</a></span><span class="dash-kv-value"><%- fmtAmt(nnChipsBalance) %></span></div>
                     <div class="dash-kv"><span class="dash-kv-label"><a href="#modal-new-cc-chips" data-bs-toggle="modal" data-view-only-disable>CC</a></span><span class="dash-kv-value"><%- fmtAmt(ccChipsBalance) %></span></div>
                     <div class="dash-kv"><span class="dash-kv-label">RC</span><span class="dash-kv-value"><%- fmtAmt(rcChipsBalance) %></span></div>
                     <div class="dash-kv-group-title is-warn">Balance Total</div>
                     <div class="dash-kv is-total dash-kv-balance-total"><span class="dash-kv-value" id="dash-cage-balance-total"><%- fmtAmt(houseBalance) %></span></div>
                  </div>
               </div>

               <div class="dash-cage-balance-diff">
                  <span class="dash-kv-label">The difference</span>
                  <span class="dash-kv-value"><%- fmtAmt(cageBalanceDiff) %></span>
               </div>

               <div class="card dash-card dash-panel-narrow gd-dash-panel is-light-body">
                  <div class="card-header dash-card-header-compact d-flex align-items-center is-center">
                     <span>Main</span>
                  </div>
                  <div class="card-body">
                     <div class="dash-kv dash-kv-company"><span class="dash-kv-label">Company</span><span class="dash-kv-value"><a href="#" data-bs-toggle="modal" data-bs-target="#modal-new-capital" data-view-only-disable class="dash-card-link" id="dash-company-balance-total"><%- fmtAmt(houseBalance) %></a></span></div>
                     <div class="dash-kv-group-title is-warn">Liabilities</div>
                     <div class="dash-kv"><span class="dash-kv-label"><a href="#" data-bs-toggle="modal" data-bs-target="#modal-new-marker" data-view-only-disable class="dash-card-link">Credit</a></span><span class="dash-kv-value" id="dash-utang-total"><%- fmtNeg(junketCreditAmount) %></span></div>
                     <div class="dash-kv"><span class="dash-kv-label"><a href="#" data-bs-toggle="modal" data-bs-target="#modal-dash-house-expense" data-view-only-disable class="dash-card-link">Expenses</a></span><span class="dash-kv-value" id="dash-expenses-total"><%- fmtNeg(expenseReset) %></span></div>
                     <div class="dash-kv"><span class="dash-kv-label"><a href="#" class="dash-card-link js-open-dash-junket-loss">Loss Amount</a></span><span class="dash-kv-value"><a href="#" class="dash-card-link js-open-dash-junket-loss" id="dash-junket-loss-total"><%- fmtNeg(junketLossAmount) %></a></span></div>
                     <div class="dash-kv-group-title is-warn">Settlement</div>
                     <div class="dash-kv"><span class="dash-kv-label"><a href="#" data-bs-toggle="modal" data-bs-target="#modal-dash-commission" data-view-only-disable class="dash-card-link">Commission</a></span><span class="dash-kv-value"><%- fmtNeg(commissionSettlement) %></span></div>
                     <div class="dash-kv"><span class="dash-kv-label"><a href="#" data-bs-toggle="modal" data-bs-target="#modal-dash-additional-commission" data-view-only-disable class="dash-card-link">Additional</a></span><span class="dash-kv-value" id="dash-additional-commission-total"><%- fmtNeg(additionalCommissionSettlement) %></span></div>
                     <div class="dash-kv-group-title is-muted">Add Charge</div>
                     <div id="dash-service-category-rows-main">
                     <% dashServiceCategoryRows.forEach(function (cat) { %>
                     <div class="dash-kv dash-service-category-row" data-category="<%= cat.key %>">
                        <span class="dash-kv-label"><a href="#" class="js-open-dash-service-category" data-category="<%= cat.key %>" data-label="<%= escHtml(cat.label) %>" data-modal-id="<%= cat.modalId || 'modal-dash-service-category' %>"><%= cat.label %></a></span>
                        <span class="dash-kv-value dash-service-balance" data-category="<%= cat.key %>"><%- fmtAmt(cat.balance) %></span>
                     </div>
                     <% }); %>
                     </div>
                     <div class="dash-kv-group-title is-warn">Etc (Tip)</div>
                     <div class="dash-kv"><span class="dash-kv-label"><a href="#" data-bs-toggle="modal" data-bs-target="#modal-dash-tip">Tip Balance</a></span><span class="dash-kv-value" id="dash-tip-balance-value"><%- fmtAmt(tipAvailableBalance) %></span></div>
                     <div class="dash-kv-group-title is-warn">Deposit Of Guests</div>
                     <div class="dash-kv"><span class="dash-kv-label">Line</span><span class="dash-kv-value"><a href="#" data-bs-toggle="modal" data-bs-target="#modal-guestAccount" data-view-only-disable class="dash-card-link"><%- fmtAmt(guestBalance) %></a></span></div>
                     <div class="dash-card-actions">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#modal-guest-summary-quick-view" class="btn btn-sm btn-primary-subtle">Quick View</a>
                        <a href="/agency" target="_blank" class="btn btn-sm btn-outline-primary">Go to Page</a>
                     </div>
                  </div>
               </div>
            </div>
         </div>

         <!-- Anticipated Profit + Actual Check -->
         <div class="col-xl-2 col-lg-3 align-self-start">
            <div class="dash-card-stack" id="dash-anticipated-panel"
               data-win-loss="<%= winLossTotal %>"
               data-service-settle="<%= serviceSettleTotal %>"
               data-company-expense="<%= companyExpenseTotal %>"
               data-company-expense-base="<%= companyExpenseBase %>"
               data-additional-commission="<%= additionalCommissionSettlement %>"
               data-month-key="<%= dashboardMonthKey || '' %>"
               data-wl-rate="<%= wlSharePct %>"
               data-wl-default="<%= dashboardWlShareDefault || 65 %>">
               <div class="card dash-card dash-panel-narrow gd-dash-panel is-light-body">
                  <div class="card-header dash-card-header-compact d-flex align-items-center is-center">
                     <span>Current Time W/L</span>
                  </div>
                  <div class="card-body">
                     <div class="dash-kv"><span class="dash-kv-label">Buy In</span><span class="dash-kv-value" id="dash-actual-buyin">—</span></div>
                     <div class="dash-kv"><span class="dash-kv-label">Cash Out</span><span class="dash-kv-value text-dash-neg" id="dash-actual-cashout">—</span></div>
                     <div class="dash-kv"><span class="dash-kv-label">Chips</span><span class="dash-kv-value"><%- fmtAmt(totalChipsBalance) %></span></div>
                     <div class="dash-kv-group-title is-muted">Win / Lose</div>
                     <div class="dash-kv"><span class="dash-kv-label">Cage</span><span class="dash-kv-value" id="dash-actual-wl">—</span></div>
                     <div class="dash-kv"><span class="dash-kv-label">Gaming Acc.</span><span class="dash-kv-value" id="dash-actual-gaming-wl">—</span></div>
                  </div>
               </div>

               <div class="dash-cage-balance-diff">
                  <span class="dash-kv-label">The difference</span>
                  <span class="dash-kv-value">0</span>
               </div>

               <div class="card dash-card dash-panel-narrow gd-dash-panel is-light-body">
                  <div class="card-header dash-card-header-compact d-flex align-items-center is-center">
                     <span>Current Time Rolling</span>
                  </div>
                  <div class="card-body">
                     <div class="dash-kv"><span class="dash-kv-label">Main Cage</span><span class="dash-kv-value" id="dash-actual-rolling">—</span></div>
                     <div class="dash-kv"><span class="dash-kv-label">NN Chips</span><span class="dash-kv-value"><%- fmtAmt(nnChipsBalance) %></span></div>
                     <div class="dash-kv"><span class="dash-kv-label">Actual Rolling</span><span class="dash-kv-value"><%- fmtAmt(totalRollingAmount) %></span></div>
                     <div class="dash-kv"><span class="dash-kv-label">Gaming Acc.</span><span class="dash-kv-value" id="dash-actual-gaming-rolling">—</span></div>
                  </div>
               </div>

               <div class="dash-cage-balance-diff">
                  <span class="dash-kv-label">The difference</span>
                  <span class="dash-kv-value">0</span>
               </div>

               <div class="card dash-card dash-panel-narrow gd-dash-panel is-light-body is-headerless">
                  <div class="card-body">
                     <div class="dash-kv-group-title is-warn d-flex justify-content-between align-items-center">
                        <span>On Game</span>
                        <span id="dash-on-game-count">—</span>
                     </div>
                     <div id="dash-on-game-summary">
                        <div class="dash-kv"><span class="dash-kv-label">Total B/I</span><span class="dash-kv-value">—</span></div>
                        <div class="dash-kv"><span class="dash-kv-label">Total C/O</span><span class="dash-kv-value">—</span></div>
                        <div class="dash-kv"><span class="dash-kv-label">Total Rolling</span><span class="dash-kv-value">—</span></div>
                     </div>
                     <div class="dash-card-actions">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#modal-on-game-details" class="btn btn-sm btn-primary-subtle">Quick View</a>
                        <a href="/game_list" target="_blank" class="btn btn-sm btn-outline-primary">Go to Page</a>
                     </div>
                  </div>
               </div>

               <div class="card dash-card dash-panel-narrow gd-dash-panel is-light-body">
                  <div class="card-header dash-card-header-compact d-flex justify-content-between align-items-center flex-wrap gap-1">
                     <span>Anticipated Profit</span>
                     <span class="dash-card-meta"><%= dashPeriodLabel %></span>
                  </div>
                  <div class="card-body">
                     <div class="dash-kv-group-title is-warn">Casino</div>
                     <div class="dash-kv"><span class="dash-kv-label"><a href="#" data-bs-toggle="modal" data-bs-target="#modal-winloss-details">W/L</a></span><span class="dash-kv-value" id="winloss"><%- fmtAmt(winLossTotal) %></span></div>
                     <div class="dash-kv">
                        <span class="dash-kv-label">W/L Rate</span>
                        <span class="dash-kv-value">
