<script>
(function () {
	var TABLE_IDS = [
		'marker-accounts-total-tbl',
		'marker-history-tbl',
		'marker-accounts-credit-tbl',
		'marker-accounts-buyin-tbl'
	];

	function applyMarkerHistoryControlsLayout(tableId) {
		var wrapper = document.getElementById(tableId + '_wrapper');
		var lengthWrap = document.getElementById(tableId + '_length');
		var filterWrap = document.getElementById(tableId + '_filter');
		var searchLabel = filterWrap ? filterWrap.querySelector('label') : null;
		var controlsHighlight;
		var filterHighlight;

		if (!wrapper || !lengthWrap || !filterWrap || !searchLabel) return;

		controlsHighlight = wrapper.querySelector('.marker-history-controls-highlight');
		if (!controlsHighlight) {
			controlsHighlight = document.createElement('div');
			controlsHighlight.className = 'marker-history-controls-highlight';
			wrapper.insertBefore(controlsHighlight, wrapper.firstChild);
		}
		if (lengthWrap.parentElement !== controlsHighlight) {
			controlsHighlight.appendChild(lengthWrap);
		}
		if (filterWrap.parentElement !== controlsHighlight) {
			controlsHighlight.appendChild(filterWrap);
		}

		filterHighlight = filterWrap.querySelector('.marker-history-filter-highlight');
		if (!filterHighlight) {
			filterHighlight = document.createElement('div');
			filterHighlight.className = 'marker-history-filter-highlight';
			filterWrap.appendChild(filterHighlight);
		}
		if (searchLabel.parentElement !== filterHighlight) {
			filterHighlight.appendChild(searchLabel);
		}

		Array.prototype.forEach.call(wrapper.children, function (row) {
			if (!row.classList || !row.classList.contains('row')) return;
			if (row.classList.contains('dt-row') || row.querySelector('table')) return;
			if (!row.querySelector('.dataTables_length, .dataTables_filter, .dataTables_info, .dataTables_paginate')) {
				row.classList.add('marker-history-dt-top-row-empty');
			}
		});
	}

	function applyAllMarkerHistoryControls() {
		TABLE_IDS.forEach(applyMarkerHistoryControlsLayout);
	}

	if (window.jQuery) {
		TABLE_IDS.forEach(function (id) {
			$(document).on('init.dt draw.dt', '#' + id, function () {
				applyMarkerHistoryControlsLayout(id);
			});
		});
		$(applyAllMarkerHistoryControls);
	} else {
		document.addEventListener('DOMContentLoaded', function () {
			setTimeout(applyAllMarkerHistoryControls, 0);
		});
	}
})();
</script>
