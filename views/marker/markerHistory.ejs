<script>
$(document).ready(function() {
	window.MarkerCommon.init({
		tableSelector: '#marker-history-tbl',
		exportBtnSelector: '#export-excel',
		withForm: true,
		formOptions: {
			formSelector: '#add_marker_settlement_page',
			accountSelectSelector: '#txtAccountMarker',
			guestSelectSelector: '#txtGuestMarker',
			guestPlaceholder: '<%= __("dashboard_marker.select_guest_optional") %>',
			markerIssueSelector: '#txtMarkerIssue',
			markerReturnSelector: '#txtMarkerReturn',
			markerBalanceSelector: '#txtMarkerBalance',
			remarksSelector: '#txtRemarks',
			programDateSelector: '#txtCreditProgramDate',
			guarantorSelector: '#txtGuarantor',
			submitBtnSelector: '#submit_marker_settlement',
			agentBalanceSelector: '#AgentBalance',
			optTransTypeName: 'optTransType',
			optReturnSourceName: 'optReturnSource',
			selectPlaceholder: '<%= __("dashboard_marker.choose_account") %>',
			dropdownParent: 'body',
			populateAccountsOnInit: true,
			supportAddCredit: true,
			useCreditActionRadios: true,
			optCreditActionName: 'optCreditAction',
			optFormModeName: 'optFormMode',
			formModeHiddenSelector: '#optFormModeHidden',
			transTypeHiddenSelector: '#optTransTypeHidden',
			formFieldsWrapSelector: '#marker-form-fields-wrap',
			returnTransTypeWrapSelector: '#marker-return-trans-type-wrap',
			amountLabelSelector: '#lbl-marker-amount',
			issueFieldWrapSelector: '#marker-issue-field-wrap',
			balanceFieldWrapSelector: '#marker-balance-field-wrap',
			issueBalanceRowSelector: '#marker-issue-balance-row',
			returnSourceWrapSelector: '#marker-return-source-wrap',
			balanceLabelSelector: '#lbl-marker-balance',
			totalBalanceGuestSelector: '#txtTotalBalanceGuest'
		},
		disableSaveExportByPermission: true
	});
});
</script>

<style>
.select2-container .select2-search--inline .select2-search__field {
	margin-top: 0;
	margin: 0.25rem 0.25rem 0.25rem 0;
	height: 1.375rem;
	line-height: 1.375rem;
}
.select2-container--default .select2-selection--single {
	border-color: #cfcfcf;
}
.select2-container--default .select2-selection--single .select2-selection__placeholder {
	color: #8A92A6;
}
.select2-container--default .select2-selection--multiple .select2-selection__rendered {
	padding-right: 0.75rem;
	padding-left: 0.75rem;
}
#add_marker_settlement_page .select2-container--default .select2-selection--single .select2-selection__clear {
	position: absolute;
	right: 1.5rem;
	top: 50%;
	transform: translateY(-50%);
	float: none;
	margin: 0;
	padding: 0 0.25rem;
	line-height: 1;
	font-size: 1rem;
	color: #8a92a6;
	z-index: 2;
}
#add_marker_settlement_page .select2-container--default .select2-selection--single .select2-selection__clear:hover {
	color: #495057;
}

.select2-results__options {
	scrollbar-width: none;
	-ms-overflow-style: none;
}
.select2-results__options::-webkit-scrollbar {
	display: none;
}

.card-body { overflow-x: auto; }

.card {
	background: linear-gradient(180deg, #f6f3ec 0%, #efe9db 100%) !important;
	border: 1px solid rgba(200, 162, 76, 0.4) !important;
	border-radius: 0.85rem;
	overflow: hidden;
}

.card-header {
	background: #f6f3ec !important;
	border-bottom: 2px solid #c8a24c;
}

.card-header .card-title {
	color: #3a2e12 !important;
}

.marker-history-page .marker-balance-card {
	border-radius: 0.5rem;
	border: 1px solid rgba(15, 23, 42, 0.08);
	background: linear-gradient(180deg, #fafbfc 0%, #ffffff 48px);
	box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 4px 12px rgba(15, 23, 42, 0.06);
	padding: 0.65rem 0.30rem 0.5rem 0.75rem;
}

.marker-history-page {
	--gd-marker-gold-solid: rgba(200, 162, 76, 0.07);
	--gd-marker-gold-text: #4a3208;
	--gd-marker-gold-border: rgba(200, 162, 76, 0.28);
	--gd-marker-gold-hover: #f6f3ec;
}

.marker-history-btn-print {
	background: linear-gradient(135deg, #52525b 0%, #71717a 100%);
	border-color: transparent;
	color: #fff;
	font-weight: 600;
	font-size: 0.8rem;
}

.marker-history-form-panel {
	max-width: 100%;
	background: transparent;
}
#add_marker_settlement_page .select2-container .select2-selection--single {
	height: calc(1.5em + 0.75rem + 6px) !important;
	min-height: calc(1.5em + 0.75rem + 6px) !important;
}
#add_marker_settlement_page .select2-container--default .select2-selection--single .select2-selection__rendered {
	display: block;
	height: calc(1.5em + 0.75rem + 6px) !important;
	line-height: calc(1.5em + 0.75rem + 6px) !important;
	padding-left: 0.75rem;
	padding-right: 2.5rem;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
#add_marker_settlement_page .select2-container--default .select2-selection--single .select2-selection__arrow {
	height: calc(1.5em + 0.75rem + 6px) !important;
}
#add_marker_settlement_page .select2-container--default .select2-selection--single {
	position: relative;
}

.marker-history-btn-save {
	background: linear-gradient(135deg, #52525b 0%, #71717a 100%) !important;
	border-color: transparent !important;
	color: #fff !important;
	font-weight: 700 !important;
	font-size: 0.85rem !important;
	padding: 0.3rem 0.9rem !important;
	min-width: 5rem;
}
.marker-history-btn-save:hover,
.marker-history-btn-save:focus {
	filter: brightness(0.92);
}
.marker-history-btn-save-check {
	font-weight: 700;
	margin-right: 0.25rem;
}

/* Tables — GD gold theme (match dashboard modal white card) */
.marker-history-page table.dataTable {
	border-collapse: collapse !important;
	border-spacing: 0 !important;
}

.marker-history-page table thead tr {
	background-color: #f5f5f5 !important;
}

.marker-history-page table thead th {
	background: transparent !important;
	background-color: transparent !important;
	border-left: 0 !important;
	border-right: 0 !important;
	border-top: 0 !important;
	box-shadow: none !important;
}

.marker-history-page table.dataTable thead > tr > th.sorting,
.marker-history-page table.dataTable thead > tr > th.sorting_asc,
.marker-history-page table.dataTable thead > tr > th.sorting_desc,
.marker-history-page table.dataTable thead > tr > th.sorting_disabled {
	background: transparent !important;
	background-color: transparent !important;
}

#marker-history-tbl,
.marker-balance-tbl {
	width: 100%;
	font-size: 0.95rem;
	border-collapse: collapse;
	border: 1px solid rgba(200, 162, 76, 0.28);
}

#marker-history-tbl thead th,
.marker-balance-tbl thead th,
.marker-history-page table.dataTable thead > tr > th {
	color: #555 !important;
	font-weight: 600;
	font-size: 0.75rem;
	letter-spacing: 0.02em;
	text-transform: uppercase;
	padding: 0.65rem 0.75rem;
	text-align: left;
	border: none !important;
	border-bottom: 1px solid #e0e0e0 !important;
	box-shadow: none !important;
	background: #f5f5f5 !important;
	background-color: #f5f5f5 !important;
	white-space: nowrap;
	vertical-align: middle;
}

#marker-history-tbl thead th.text-center,
#marker-history-tbl tbody td.text-center {
	text-align: center !important;
}

