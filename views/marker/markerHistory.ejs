	// Pass translations to JavaScript
	window.markerTranslations = {
		account_name: "<%= __('dashboard_marker.account_name') %>",
		amount: "<%= __('dashboard_marker.amount') %>",
		transaction_type_col: "<%= __('dashboard_marker.transaction_type_col') %>",
		date: "<%= __('dashboard_marker.date') %>",
		remarks: "<%= __('dashboard_marker.remarks') %>",
		balance: "<%= __('dashboard_marker.balance') %>",
		export_sheet_junket_credit: "<%= __('dashboard_marker.tab_credit') %>",
		export_sheet_game_credit: "<%= __('dashboard_marker.tab_buyin') %>",
		export: "<%= __('dashboard_marker.export') %>",
		no_data_export: "<%= __('dashboard_marker.no_data_export') %>",
		export_error: "<%= __('dashboard_marker.export_error') %>",
		showing_entries: "<%= __('dashboard_marker.showing_entries') %>",
		save: "<%= __('dashboard_marker.save') %>",
		edit_remarks: "<%= __('dashboard_marker.edit_remarks') %>",
		remarks_updated: "<%= __('dashboard_marker.remarks_updated') %>",
		error_update_remarks: "<%= __('dashboard_marker.error_update_remarks') %>",
		delete: "<%= __('dashboard_marker.delete') %>",
		confirm_delete: "<%= __('dashboard_marker.confirm_delete') %>",
		yes_delete: "<%= __('dashboard_marker.yes_delete') %>",
		info_empty: "<%= __('dashboard_marker.info_empty') %>",
		info_filtered: "<%= __('dashboard_marker.info_filtered') %>",
		length_menu: "<%= __('dashboard_marker.length_menu') %>",
		first: "<%= __('dashboard_marker.first') %>",
		last: "<%= __('dashboard_marker.last') %>",
		previous: "<%= __('dashboard_marker.previous') %>",
		next: "<%= __('dashboard_marker.next') %>",
		search: "<%= __('dashboard_marker.search') %>",
		no_data_available: "<%= __('account_dashboard.no_data_available') %>",
		total: "<%= __('dashboard_marker.total') %>"
	};
</script>
<script src="/assets/js/functions/marker_common.js"></script>
<script>
$(document).ready(function() {
	window.MarkerCommon.init({
		tableSelector: '#marker-history-tbl',
		exportBtnSelector: '#export-excel',
		withForm: true,
		formOptions: {
			formSelector: '#add_marker_settlement_page',
			accountSelectSelector: '#txtAccountMarker',
			markerIssueSelector: '#txtMarkerIssue',
			markerReturnSelector: '#txtMarkerReturn',
			markerBalanceSelector: '#txtMarkerBalance',
			remarksSelector: '#txtRemarks',
			submitBtnSelector: '#submit_marker_settlement',
			agentBalanceSelector: '#AgentBalance',
			optTransTypeName: 'optTransType',
			optReturnSourceName: 'optReturnSource',
			selectPlaceholder: '<%= __("dashboard_marker.choose_account") %>',
			dropdownParent: 'body',
			populateAccountsOnInit: true,
			onSuccess: function() {
				// Table reload is done inside common script
			}
		},
		disableSaveExportByPermission: true
	});
});
</script>

<style>

.select2-container .select2-selection--single {
							height: calc(1.5em + 0.75rem + 6px);
						}

						.select2-container .select2-search--inline .select2-search__field {
							margin-top: 0;
							margin: 0.25rem 0.25rem 0.25rem 0;
							height: 1.375rem;
							line-height: 1.375rem;
						}

						.select2-container--default .select2-selection--single {
							border-color: #eee;

						}

						.select2-container--default .select2-selection--single .select2-selection__rendered {
							display: flex;
							align-items: center;
							padding-left: 0.75rem;
							height: calc(1.5em + 0.75rem + 6px);
							line-height: 1.5;
						}

						.select2-container--default .select2-selection--single .select2-selection__arrow {
							height: calc(1.5em + 0.75rem + 6px);
						}

						.select2-container--default .select2-selection--single .select2-selection__placeholder {
							color: #8A92A6;
						}

						.select2-container--default .select2-selection--multiple .select2-selection__rendered {
							padding-right: 0.75rem;
							padding-left: 0.75rem;
						}
.card-body { overflow-x: auto; }
.marker-save-gap { display: inline-block; width: 2.5rem; }
#marker-history-tbl {
	width: 100%;
	font-size: 13px;
	border-collapse: collapse;
}
#marker-history-tbl thead th {
	background: var(--bs-primary-bg-subtle);
	color: var(--bs-primary);
	font-weight: 500;
	padding: 12px 15px;
	text-align: left;
	border: none;
}
#marker-history-tbl tbody tr { border-bottom: 1px solid #eee; }
#marker-history-tbl td { padding: 12px 15px; color: #666; }
#marker-history-tbl tbody tr:hover { background-color: #f5f5f5 !important; }
.dataTables_length label { font-size: 0; }
.dataTables_length select { font-size: 12px; }

.marker-balance-tabs .nav-link {
	font-size: 0.875rem;
	color: #8a92a6;
	border: none;
	border-bottom: 2px solid transparent;
	padding: 0.5rem 0.75rem;
}
.marker-balance-tabs .nav-link:hover { color: var(--bs-primary); }
.marker-balance-tabs .nav-link.active {
	color: var(--bs-primary);
	font-weight: 500;
	border-bottom-color: var(--bs-primary);
	background: transparent;
}
.marker-balance-tbl {
	width: 100%;
	font-size: 13px;
	border-collapse: collapse;
	border: 1px solid #dee2e6;
}
.marker-balance-tbl thead th {
	background: var(--bs-primary-bg-subtle);
	color: var(--bs-primary);
	font-weight: 500;
	padding: 12px 15px;
	text-align: left;
	border: none;
}
.marker-balance-tbl thead tr th { border-bottom: 1px solid #dee2e6; }
.marker-balance-tbl tbody tr { border-bottom: 1px solid #eee; }
.marker-balance-tbl tbody tr:last-child td,
.marker-balance-tbl tbody td.dataTables_empty { border-bottom: 1px solid #dee2e6; }
.marker-balance-tbl tfoot tr th {
	border-top: 2px solid #dee2e6;
	border-bottom: 1px solid #dee2e6;
	background-color: #f4f6fa;
	padding: 10px 15px;
}
.marker-balance-tbl td { padding: 12px 15px; color: #666; }
.marker-balance-tbl tbody tr:hover { background-color: #f5f5f5 !important; }
.marker-balance-tbl tr.marker-balance-total-row td {
	border-top: 2px solid #dee2e6;
	background-color: #f4f6fa;
	padding: 10px 15px;
}
#marker-history-tbl tbody td.marker-history-col-remarks { vertical-align: top; }
#marker-history-tbl .marker-history-remarks-actions .btn { padding: 0.2rem 0.45rem; }

/* Cash / Game Credit — right-align balance */
#marker-accounts-credit-wrapper .marker-balance-table thead th.marker-balance-col-amount,
#marker-accounts-credit-wrapper .marker-balance-table tbody td.marker-balance-col-amount,
#marker-accounts-credit-wrapper .marker-balance-table tfoot th.marker-balance-col-amount,
#marker-accounts-buyin-wrapper .marker-balance-table thead th.marker-balance-col-amount,
#marker-accounts-buyin-wrapper .marker-balance-table tbody td.marker-balance-col-amount,
#marker-accounts-buyin-wrapper .marker-balance-table tfoot th.marker-balance-col-amount {
	text-align: right !important;
	padding-right: 1.5rem !important;
	font-variant-numeric: tabular-nums;
}

/* Total Credit tab */
#marker-accounts-total-wrapper .marker-balance-dt-wrap,
#marker-accounts-total-wrapper .marker-balance-card {
	max-width: 100%;
	overflow-x: auto;
	-webkit-overflow-scrolling: touch;
}
#marker-accounts-total-tbl.dataTable.marker-total-table,
#marker-accounts-total-tbl.marker-total-table {
	width: 100% !important;
	table-layout: fixed;
}
#marker-accounts-total-wrapper .marker-total-table thead th.marker-total-col-account,
#marker-accounts-total-wrapper .marker-total-table tbody td.marker-total-col-account,
#marker-accounts-total-wrapper .marker-total-table tfoot th:first-child {
	width: 34%;
	max-width: 12.5rem;
	min-width: 8rem;
	text-align: left;
	white-space: normal;
	word-wrap: break-word;
	overflow-wrap: break-word;
}
#marker-accounts-total-wrapper .marker-total-table thead th.marker-total-col-junket,
#marker-accounts-total-wrapper .marker-total-table tbody td.marker-total-col-junket,
#marker-accounts-total-wrapper .marker-total-table tfoot th.marker-total-col-junket {
	width: 18%;
	max-width: 7rem;
	min-width: 5.5rem;
}
#marker-accounts-total-wrapper .marker-total-table thead th.marker-total-col-game,
#marker-accounts-total-wrapper .marker-total-table tbody td.marker-total-col-game,
#marker-accounts-total-wrapper .marker-total-table tfoot th.marker-total-col-game {
	width: 18%;
	max-width: 7rem;
	min-width: 5.5rem;
}
#marker-accounts-total-wrapper .marker-total-table thead th.marker-total-col-sum,
#marker-accounts-total-wrapper .marker-total-table tbody td.marker-total-col-sum,
#marker-accounts-total-wrapper .marker-total-table tfoot th.marker-total-col-sum {
	width: 30%;
	max-width: 9rem;
	min-width: 6rem;
}
#marker-accounts-total-wrapper .marker-total-table thead th.marker-balance-col-amount,
#marker-accounts-total-wrapper .marker-total-table tbody td.marker-balance-col-amount,
#marker-accounts-total-wrapper .marker-total-table tfoot th.marker-balance-col-amount {
	padding-left: 0.4rem;
	font-variant-numeric: tabular-nums;
	text-align: right !important;
}
#marker-accounts-total-wrapper .marker-total-table thead th.marker-total-col-junket,
#marker-accounts-total-wrapper .marker-total-table tbody td.marker-total-col-junket,
#marker-accounts-total-wrapper .marker-total-table tfoot th.marker-total-col-junket,
#marker-accounts-total-wrapper .marker-total-table thead th.marker-total-col-game,
#marker-accounts-total-wrapper .marker-total-table tbody td.marker-total-col-game,
#marker-accounts-total-wrapper .marker-total-table tfoot th.marker-total-col-game,
#marker-accounts-total-wrapper .marker-total-table thead th.marker-total-col-sum,
#marker-accounts-total-wrapper .marker-total-table tbody td.marker-total-col-sum,
#marker-accounts-total-wrapper .marker-total-table tfoot th.marker-total-col-sum {
	padding-right: 1.5rem !important;
}
#marker-accounts-total-wrapper .marker-total-table tbody tr:nth-child(even) td {
	background-color: #fafbfd;
}
#marker-accounts-total-wrapper .marker-total-table tbody tr:hover td {
	background-color: #f0f6ff !important;
}
</style>


