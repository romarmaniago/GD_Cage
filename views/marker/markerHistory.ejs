<script>
$(document).ready(function() {
	window.MarkerCommon.init({
		tableSelector: '#marker-history-tbl',
		exportBtnSelector: '#export-excel',
		withForm: true,
		formOptions: {
			formSelector: '#add_marker_settlement_page',
			accountSelectSelector: '#txtAccountMarker',
			guestSelectSelector: '#txtGuestMarker',
			guestPlaceholder: '<%= __("dashboard_marker.select_guest_optional") %>',
			markerIssueSelector: '#txtMarkerIssue',
			markerReturnSelector: '#txtMarkerReturn',
			markerBalanceSelector: '#txtMarkerBalance',
			remarksSelector: '#txtRemarks',
			programDateSelector: '#txtCreditProgramDate',
			guarantorSelector: '#txtGuarantor',
			submitBtnSelector: '#submit_marker_settlement',
			agentBalanceSelector: '#AgentBalance',
			optTransTypeName: 'optTransType',
			optReturnSourceName: 'optReturnSource',
			selectPlaceholder: '<%= __("dashboard_marker.choose_account") %>',
			dropdownParent: 'body',
			populateAccountsOnInit: true,
			supportAddCredit: true,
			useCreditActionRadios: true,
			optCreditActionName: 'optCreditAction',
			optFormModeName: 'optFormMode',
			formModeHiddenSelector: '#optFormModeHidden',
			transTypeHiddenSelector: '#optTransTypeHidden',
			formFieldsWrapSelector: '#marker-form-fields-wrap',
			returnTransTypeWrapSelector: '#marker-return-trans-type-wrap',
			amountLabelSelector: '#lbl-marker-amount',
			issueFieldWrapSelector: '#marker-issue-field-wrap',
			balanceFieldWrapSelector: '#marker-balance-field-wrap',
			issueBalanceRowSelector: '#marker-issue-balance-row',
			returnSourceWrapSelector: '#marker-return-source-wrap',
			balanceLabelSelector: '#lbl-marker-balance',
			totalBalanceGuestSelector: '#txtTotalBalanceGuest',
			onSuccess: function() {
				// Table reload is done inside common script
			}
		},
		disableSaveExportByPermission: true
	});
});
</script>

<style>

.select2-container .select2-selection--single {
							height: calc(1.5em + 0.75rem + 6px);
						}

						.select2-container .select2-search--inline .select2-search__field {
							margin-top: 0;
							margin: 0.25rem 0.25rem 0.25rem 0;
							height: 1.375rem;
							line-height: 1.375rem;
						}

						.select2-container--default .select2-selection--single {
							border-color: #eee;

						}

						.select2-container--default .select2-selection--single .select2-selection__rendered {
							display: block;
							align-items: center;
							padding-left: 0.75rem;
							padding-right: 2.5rem;
							height: calc(1.5em + 0.75rem + 6px);
							line-height: calc(1.5em + 0.75rem + 6px);
							overflow: hidden;
							text-overflow: ellipsis;
							white-space: nowrap;
						}

						.select2-container--default .select2-selection--single .select2-selection__arrow {
							height: calc(1.5em + 0.75rem + 6px);
						}

						#add_marker_settlement_page .select2-container--default .select2-selection--single .select2-selection__clear {
							position: absolute;
							right: 1.75rem;
							top: 50%;
							transform: translateY(-50%);
							float: none;
							margin: 0;
							padding: 0 0.25rem;
							line-height: 1;
							font-size: 1rem;
							color: #8a92a6;
							z-index: 2;
						}

						#add_marker_settlement_page .select2-container--default .select2-selection--single .select2-selection__clear:hover {
							color: #495057;
						}

						.select2-container--default .select2-selection--single .select2-selection__placeholder {
							color: #8A92A6;
						}

						.select2-container--default .select2-selection--multiple .select2-selection__rendered {
							padding-right: 0.75rem;
							padding-left: 0.75rem;
						}
.card-body { overflow-x: auto; }
#marker-history-tbl {
	width: 100%;
	font-size: 13px;
	border-collapse: collapse;
}
#marker-history-tbl thead th {
	background: var(--bs-primary-bg-subtle);
	color: var(--bs-primary);
	font-weight: 500;
	padding: 12px 15px;
	text-align: left;
	border: none;
}
#marker-history-tbl tbody tr { border-bottom: 1px solid #eee; }
#marker-history-tbl td { padding: 12px 15px; color: #666; }
#marker-history-tbl tbody tr:hover { background-color: #f5f5f5 !important; }
.dataTables_length label { font-size: 0; }
.dataTables_length select { font-size: 12px; }

.marker-balance-tabs .nav-link {
	font-size: 0.875rem;
	color: #8a92a6;
	border: none;
	border-bottom: 2px solid transparent;
	padding: 0.5rem 0.75rem;
}
.marker-balance-tabs .nav-link:hover { color: var(--bs-primary); }
.marker-balance-tabs .nav-link.active {
	color: var(--bs-primary);
	font-weight: 500;
	border-bottom-color: var(--bs-primary);
	background: transparent;
}
.marker-balance-tbl {
	width: 100%;
	font-size: 13px;
	border-collapse: collapse;
	border: 1px solid #dee2e6;
}
.marker-balance-tbl thead th {
	background: var(--bs-primary-bg-subtle);
	color: var(--bs-primary);
	font-weight: 500;
	padding: 12px 15px;
	text-align: left;
	border: none;
}
.marker-balance-tbl thead tr th { border-bottom: 1px solid #dee2e6; }
.marker-balance-tbl tbody tr { border-bottom: 1px solid #eee; }
.marker-balance-tbl tbody tr:last-child td,
.marker-balance-tbl tbody td.dataTables_empty { border-bottom: 1px solid #dee2e6; }
.marker-balance-tbl tfoot tr th {
	border-top: 2px solid #dee2e6;
	border-bottom: 1px solid #dee2e6;
	background-color: #f4f6fa;
