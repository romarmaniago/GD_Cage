<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="container-fluid content-inner py-0">
	<div class="row">
		<div class="col-sm-12">
			<div class="card">
				<div id="user-role" data-permissions="<%= permissions %>"></div>
				<div class="card-header d-flex justify-content-between align-items-center">
					<h3 class="card-title">
						<div class="breadcrumb1 flat">
							<a href="/dashboard"><span class="fa fa-home"></span></a>
							<a href="/markerHistory" class="active"><%= __('sidebar.credit_history') %></a>
						</div>
					</h3>
				</div>
				<div class="card-body">
					<!-- Total Credits Issue -->
					<div class="row mb-3 d-flex justify-content-center">
						<span class="section-header text-center"><%= __('dashboard_marker.total_credits_issue') %></span>
						<div class="col-sm-12 mb-3">
							<input type="text" class="form-control text-center" name="txtTotalMarkerIssue" id="txtTotalMarkerIssue" 
							value="<%- ( (+sqlMarkerIssueGame[0].TOTAL_ISSUE_GAME || 0) +
							(+sqlMarkerIssueAccount[0].TOTAL_ISSUE_RECORD || 0) -
							(+sqlNNChipsAccountMarker[0].TOTAL_NN_MARKER || 0) -
							(+sqlMArkerReturnCash[0].MARKER_RETURN_CASH || 0) -
							(+sqlMArkerReturnDeposit[0].MARKER_RETURN_DEPOSIT || 0) -
							(+sqlChipsReturnMarker[0].CHIPS_RETURN_MARKER || 0) ).toLocaleString('en-US') %>" readonly/>
						</div>
					</div>
					<div class="row mb-1">
						<div class="col-sm-6">
							<label class="form-label text-muted small mb-1 text-center">Total Cash Credit</label>
							<input type="text" class="form-control text-center" id="txtTotalJunketCredit" readonly />
						</div>
						<div class="col-sm-6">
							<label class="form-label text-muted small mb-1 text-center">Total Game Credit</label>
							<input type="text" class="form-control text-center" id="txtTotalGameCredit" readonly />
						</div>
					</div>

					<!-- Marker return form (same logic as dashboard modal) -->
					<form id="add_marker_settlement_page" action="#" method="POST" class="mb-4">
						<input type="hidden" id="AgentBalance" name="AgentBalance" />
						<div class="row mb-2">
							<div class="col-sm-12">
								
							</div>
						</div>
						<div class="row mb-3 align-items-center">
							<div class="col-sm-12 d-flex flex-wrap align-items-center gap-4">
								<div class="form-check mb-0">
									<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="return-source-credit-page" name="optReturnSource" value="credit" />
									<label class="form-check-label" for="return-source-credit-page"><%= __('dashboard_marker.tab_credit') %></label>
								</div>
								<div class="form-check mb-0">
									<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="return-source-buyin-page" name="optReturnSource" value="buyin" />
									<label class="form-check-label" for="return-source-buyin-page"><%= __('dashboard_marker.tab_buyin') %></label>
								</div>
							</div>
						</div>
						<div class="row mb-2">
							<div class="col-sm-6">
								<label class="form-label text-muted small"><%= __('dashboard_marker.account') %></label>
								<select class="js-select2 form-select" name="txtAccountMarker" id="txtAccountMarker" style="width: 100%;" data-placeholder="<%= __('dashboard_marker.choose_account') %>">
									<option value=""><%= __('dashboard_marker.choose_account') %></option>
								</select>
							</div>
							<div class="col-sm-6">
								<label class="form-label text-muted small"><%= __('dashboard_marker.credits_issue') %></label>
								<input type="text" class="form-control" name="txtMarkerIssue" id="txtMarkerIssue" readonly />
							</div>
						</div>
						<div class="row mb-2">
							<div class="col-sm-6">
								<label class="form-label text-muted small"><%= __('dashboard_marker.credits_return') %></label>
								<input type="text" class="form-control" name="txtMarkerReturn" id="txtMarkerReturn" required autocomplete="off" />
							</div>
							<div class="col-sm-6">
								<label class="form-label text-muted small"><%= __('dashboard_marker.balance') %></label>
								<input type="text" class="form-control" name="txtMarkerBalance" id="txtMarkerBalance" readonly style="color: #0665d0;" />
							</div>
						</div>
						<div class="row mb-2">
							<div class="col-sm-12">
								<label class="form-label text-muted small"><%= __('dashboard_marker.remarks_optional') %></label>
								<input type="text" class="form-control" name="remarks" id="txtRemarks" maxlength="500" autocomplete="off" />
							</div>
						</div>
						<div class="row mb-2">
							<div class="col-sm-12">
								<label class="form-label text-muted small"><%= __('dashboard_marker.transaction_type') %></label>
							</div>
						</div>
						<div class="row mb-3 align-items-center">
							<div class="col-sm-12 d-flex flex-wrap align-items-center gap-4">
								<div class="form-check mb-0">
									<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="cash_page" name="optTransType" value="11" />
									<label class="form-check-label" for="cash_page"><%= __('dashboard_marker.cash') %></label>
								</div>
								<div class="form-check mb-0">
									<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="deposit_page" name="optTransType" value="12" />
									<label class="form-check-label" for="deposit_page"><%= __('dashboard_marker.deposit') %></label>
								</div>
								<button type="button" class="btn btn-sm btn-success" id="btn-credits-game-start"><%= __('dashboard_marker.game_start') %></button>
								<span class="marker-save-gap"></span>
								<button type="submit" id="submit_marker_settlement" class="btn btn-sm btn-primary"><%= __('dashboard_marker.save') %></button>
							</div>
						</div>
					</form>

					<hr class="my-3" />

					<!-- 4 Tabs: Total Credit (default), Cash Credit, Game Credit, History -->
					<ul class="nav nav-tabs marker-balance-tabs mb-2" id="marker-balance-tabs" role="tablist">
						<li class="nav-item" role="presentation">
							<button class="nav-link active" id="tab-total-credit" data-tab="total" type="button" role="tab"><%= __('dashboard_marker.tab_total_credit') %></button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="tab-credit-balance" data-tab="credit" type="button" role="tab"><%= __('dashboard_marker.tab_credit') %></button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="tab-buyin-balance" data-tab="buyin" type="button" role="tab"><%= __('dashboard_marker.tab_buyin') %></button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="tab-marker-history" data-tab="marker-history" type="button" role="tab"><%= __('dashboard_marker.marker_history') %></button>
						</li>
					</ul>

					<div id="marker-accounts-total-wrapper" class="marker-tab-panel mb-3" data-panel="total">
						<div class="marker-balance-dt-wrap marker-balance-card table-responsive">
							<table id="marker-accounts-total-tbl" class="table marker-balance-tbl marker-total-table w-100 mb-0">
								<thead>
									<tr>
										<th class="marker-total-col-account"><%= __('dashboard_marker.account_name') %></th>
										<th class="text-end marker-balance-col-amount marker-total-col-junket"><%= __('dashboard_marker.tab_credit') %></th>
										<th class="text-end marker-balance-col-amount marker-total-col-game"><%= __('dashboard_marker.tab_buyin') %></th>
										<th class="text-end marker-balance-col-amount marker-total-col-sum"><%= __('dashboard_marker.total') %></th>
									</tr>
								</thead>
								<tbody></tbody>
								<tfoot><tr><th></th><th class="text-end marker-balance-col-amount marker-total-col-junket"></th><th class="text-end marker-balance-col-amount marker-total-col-game"></th><th class="text-end marker-balance-col-amount marker-total-col-sum"></th></tr></tfoot>
							</table>
						</div>
					</div>

					<div id="marker-history-wrapper" class="marker-tab-panel mb-3" data-panel="marker-history" style="display: none;">
						<div class="d-flex justify-content-between align-items-center mb-2">
							<span class="text-muted small"><%= __('dashboard_marker.marker_history') %></span>
							<button type="button" id="export-excel" class="btn btn-sm btn-success-subtle"><%= __('dashboard_marker.export') %></button>
						</div>
						<table id="marker-history-tbl" class="table table-bordered table-responsive" style="width:100%">
						<thead>
							<tr>
								<th class="d-none d-sm-table-cell"><%= __('dashboard_marker.account_name') %></th>
								<th class="d-none d-sm-table-cell"><%= __('dashboard_marker.amount') %></th>
								<th class="d-none d-sm-table-cell"><%= __('dashboard_marker.transaction_type_col') %></th>
								<th class="d-none d-sm-table-cell" style="width: 200px;"><%= __('dashboard_marker.date') %></th>
								<th class="d-none d-sm-table-cell"><%= __('dashboard_marker.remarks') %></th>
							</tr>
						</thead>
						<tbody></tbody>
						</table>
					</div>

					<div id="marker-accounts-credit-wrapper" class="marker-tab-panel mb-3" data-panel="credit" style="display: none;">
						<div class="d-flex justify-content-between align-items-center mb-2">
							<span class="text-muted small"><%= __('dashboard_marker.tab_credit') %></span>
							<button type="button" id="export-excel-credit" class="btn btn-sm btn-success-subtle"><%= __('dashboard_marker.export') %></button>
						</div>
						<div class="marker-balance-dt-wrap marker-balance-card table-responsive">
							<table id="marker-accounts-credit-tbl" class="table marker-balance-tbl marker-balance-table w-100 mb-0">
								<thead>
									<tr>
										<th><%= __('dashboard_marker.account_name') %></th>
										<th class="text-end marker-balance-col-amount"><%= __('dashboard_marker.balance') %></th>
									</tr>
								</thead>
								<tbody></tbody>
								<tfoot><tr><th></th><th class="text-end marker-balance-col-amount"></th></tr></tfoot>
							</table>
						</div>
					</div>

					<div id="marker-accounts-buyin-wrapper" class="marker-tab-panel mb-3" data-panel="buyin" style="display: none;">
						<div class="d-flex justify-content-between align-items-center mb-2">
							<span class="text-muted small"><%= __('dashboard_marker.tab_buyin') %></span>
							<button type="button" id="export-excel-buyin" class="btn btn-sm btn-success-subtle"><%= __('dashboard_marker.export') %></button>
						</div>
						<div class="marker-balance-dt-wrap marker-balance-card table-responsive">
							<table id="marker-accounts-buyin-tbl" class="table marker-balance-tbl marker-balance-table w-100 mb-0">
								<thead>
									<tr>
										<th><%= __('dashboard_marker.account_name') %></th>
										<th class="text-end marker-balance-col-amount"><%= __('dashboard_marker.balance') %></th>
									</tr>
								</thead>
								<tbody></tbody>
								<tfoot><tr><th></th><th class="text-end marker-balance-col-amount"></th></tr></tfoot>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<%- include ('../modals/game_book/new_game_list') %>
<%- include ('../partials/permission_view_only_script') %>
<%- include('../partials/footer') %>
