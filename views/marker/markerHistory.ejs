<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="container-fluid content-inner py-0">
	<div class="row">
		<div class="col-sm-12">
			<div class="card">
				<div id="user-role" data-permissions="<%= permissions %>"></div>
				<div class="card-header d-flex justify-content-between align-items-center">
					<h3 class="card-title">
						<div class="breadcrumb1 flat">
							<a href="/dashboard"><span class="fa fa-home"></span></a>
							<a href="/markerHistory" class="active"><%= __('sidebar.credit_history') %></a>
						</div>
					</h3>
				</div>
				<div class="card-body marker-history-page">
					<div class="marker-history-layout">
						<div class="marker-history-sidebar">
							<div class="marker-history-form-panel mb-3">
								<form id="add_marker_settlement_page" action="#" method="POST" class="mb-0">
									<input type="hidden" id="AgentBalance" name="AgentBalance" />
									<input type="hidden" id="txtTotalBalanceGuest" name="totalBalanceGuest" />
									<input type="hidden" id="optFormModeHidden" name="optFormMode" value="" />
									<input type="hidden" id="optTransTypeHidden" name="optTransType" value="" />
									<div id="marker-form-fields-wrap">
										<div id="marker-return-source-wrap" class="d-none" aria-hidden="true">
											<input type="radio" name="optReturnSource" id="return-source-credit-page" value="credit" />
											<input type="radio" name="optReturnSource" id="return-source-buyin-page" value="buyin" />
										</div>

										<div class="mb-2">
											<label class="form-label text-muted small mb-1" for="txtCreditProgramDate"><%= __('dashboard_marker.program_date') %></label>
											<input type="text" class="form-control" name="txtProgramDate" id="txtCreditProgramDate" required autocomplete="off" placeholder="YYYY-MM-DD" style="width: 100%;" />
										</div>

										<div class="mb-2">
											<label class="form-label text-muted small" for="txtAccountMarker"><%= __('dashboard_marker.account') %></label>
											<select class="js-select2 form-select" name="txtAccountMarker" id="txtAccountMarker" style="width: 100%;" data-placeholder="<%= __('dashboard_marker.choose_account') %>">
												<option value=""><%= __('dashboard_marker.choose_account') %></option>
											</select>
										</div>
										<div class="mb-2">
											<label class="form-label text-muted small" for="txtGuestMarker"><%= __('dashboard_marker.guest') %></label>
											<select class="js-select2 form-select" name="txtGuestId" id="txtGuestMarker" style="width: 100%;" data-placeholder="<%= __('dashboard_marker.select_guest_optional') %>" disabled>
												<option value=""><%= __('dashboard_marker.select_guest_optional') %></option>
											</select>
										</div>

										<div class="mb-2">
											<label class="form-label text-muted small" id="lbl-marker-amount" for="txtMarkerReturn"><%= __('dashboard_marker.amount') %></label>
											<input type="text" class="form-control" name="txtMarkerReturn" id="txtMarkerReturn" required autocomplete="off" inputmode="decimal" />
										</div>

										<div class="mb-2">
											<label class="form-label text-muted small" for="txtGuarantor"><%= __('dashboard_marker.guarantor') %></label>
											<input type="text" class="form-control" name="txtGuarantor" id="txtGuarantor" required autocomplete="off" placeholder="<%= __('dashboard_marker.guarantor') %>" />
										</div>

										<div class="mb-2">
											<label class="form-label text-muted small d-block"><%= __('dashboard_marker.credit_action') %></label>
											<div class="d-flex flex-wrap align-items-center gap-3 gap-md-4 pt-1" id="marker-credit-action-wrap">
												<div class="form-check mb-0">
													<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="credit-action-return-deposit" name="optCreditAction" value="return_deposit" />
													<label class="form-check-label" for="credit-action-return-deposit"><%= __('dashboard_marker.credit_action_return_deposit') %></label>
												</div>
												<div class="form-check mb-0">
													<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="credit-action-game-credit" name="optCreditAction" value="game_credit" />
													<label class="form-check-label" for="credit-action-game-credit"><%= __('dashboard_marker.credit_action_game_credit') %></label>
												</div>
												<div class="form-check mb-0">
													<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="credit-action-return-cash" name="optCreditAction" value="return_cash" />
													<label class="form-check-label" for="credit-action-return-cash"><%= __('dashboard_marker.credit_action_return_cash') %></label>
												</div>
												<div class="form-check mb-0">
													<input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="credit-action-cash-credit" name="optCreditAction" value="cash_credit" />
													<label class="form-check-label" for="credit-action-cash-credit"><%= __('dashboard_marker.credit_action_cash_credit') %></label>
												</div>
											</div>
										</div>

										<div class="d-none" id="marker-issue-balance-row" aria-hidden="true">
											<div id="marker-issue-field-wrap">
												<input type="hidden" name="txtMarkerIssue" id="txtMarkerIssue" />
											</div>
											<div id="marker-balance-field-wrap">
												<input type="hidden" name="txtMarkerBalance" id="txtMarkerBalance" />
											</div>
										</div>

										<div class="mb-2">
											<label class="form-label text-muted small" for="txtRemarks"><%= __('dashboard_marker.remarks_optional') %></label>
											<input type="text" class="form-control" name="remarks" id="txtRemarks" maxlength="500" autocomplete="off" />
										</div>

										<div id="marker-return-trans-type-wrap" class="d-none" aria-hidden="true"></div>

										<div class="d-flex justify-content-start align-items-center gap-2 mt-3 mb-2">
											<button type="button" class="btn btn-sm btn-success d-none" id="btn-credits-game-start"><%= __('dashboard_marker.game_start') %></button>
											<button type="submit" id="submit_marker_settlement" class="btn marker-history-btn-save">
												<%= __('dashboard_marker.save') %>
											</button>
										</div>
									</div>
								</form>
							</div>
						</div>

						<div class="marker-history-main">
							<div id="marker-history-wrapper" class="mb-3">
								<div class="marker-credit-card marker-credit-card--wide">
									<div class="marker-history-toolbar" id="marker-history-toolbar">
										<div class="marker-history-toolbar-left">
											<span id="marker-history-length-slot" class="marker-history-length-slot"></span>
											<div class="marker-date-nav" id="marker-date-nav">
												<input type="text" id="marker-date-picker" class="marker-date-nav-input" autocomplete="off" />
											</div>
											<div class="marker-status-toggle" id="marker-status-toggle">
												<button type="button" id="btn-marker-status-oncredit" class="marker-status-toggle-btn" data-status="on_credit"><%= __('dashboard_marker.on_credit') %></button>
												<button type="button" id="btn-marker-status-finished" class="marker-status-toggle-btn" data-status="finished"><%= __('dashboard_marker.finished_credit') %></button>
											</div>
										</div>
										<div class="marker-history-toolbar-right">
											<button type="button" class="btn btn-sm marker-history-btn-print marker-credit-export" title="Print">Print</button>
											<button type="button" id="export-excel" class="btn btn-sm marker-credit-export"><%= __('dashboard_marker.export') %></button>
											<span id="marker-history-search-slot" class="marker-history-search-slot"></span>
										</div>
									</div>
									<div class="marker-balance-dt-wrap marker-balance-card table-responsive">
										<table id="marker-history-tbl" class="table nowrap small-text mb-0" style="width:100%">
										<thead>
											<tr>
												<th class="d-none d-sm-table-cell text-center"><%= __('dashboard_marker.date_time') %></th>
												<th class="d-none d-sm-table-cell"><%= __('dashboard_marker.account') %></th>
												<th class="d-none d-sm-table-cell"><%= __('dashboard_marker.name') %></th>
												<th class="d-none d-sm-table-cell text-end marker-history-col-amount"><%= __('dashboard_marker.credit') %></th>
												<th class="d-none d-sm-table-cell text-end marker-history-col-amount"><%= __('dashboard_marker.credit_total') %></th>
												<th class="d-none d-sm-table-cell"><%= __('dashboard_marker.guarantor') %></th>
												<th class="d-none d-sm-table-cell text-end marker-history-col-amount"><%= __('dashboard_marker.balance') %></th>
												<th class="d-none d-sm-table-cell text-center"><%= __('dashboard_marker.action') %></th>
											</tr>
										</thead>
										<tbody></tbody>
										</table>
									</div>
								</div>
							</div>
						</div>

						<div class="marker-history-summary">
							<div class="marker-credit-card">
								<div class="marker-history-summary-head">
									<span><%= __('dashboard_marker.total_credit_title') %></span>
									<span class="marker-history-summary-grand-total" id="marker-credit-summary-grand-total">0</span>
									<button type="button" class="btn btn-sm marker-credit-export marker-history-summary-copy-btn" id="btn-marker-credit-summary-copy" title="Copy as image">Copy</button>
								</div>
								<div class="marker-balance-dt-wrap table-responsive">
									<table class="table nowrap small-text mb-0" id="marker-credit-summary-tbl">
										<thead>
											<tr>
												<th><%= __('dashboard_marker.account') %></th>
												<th><%= __('dashboard_marker.name') %></th>
												<th class="text-end marker-history-col-amount"><%= __('dashboard_marker.credit') %></th>
												<th><%= __('dashboard_marker.remarks') %></th>
											</tr>
										</thead>
										<tbody id="marker-credit-summary-body"></tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
