<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>
<style>
  .daily-report-matrix {
    table-layout: fixed;
    width: 100%;
  }
  /* Override theme nowrap on thead/cells so long table names wrap */
  .daily-report-matrix thead {
    white-space: normal;
  }
  .daily-report-matrix th,
  .daily-report-matrix td {
    padding: 0.35rem 0.5rem;
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
    vertical-align: middle;
    line-height: 1.25;
  }
  .daily-report-matrix .daily-report-total-col,
  .daily-report-matrix .daily-report-total-row td {
    background-color: #fff3cd;
    font-weight: 700;
  }
  .daily-report-matrix tbody td:not(:first-child) {
    text-align: right !important;
    padding-right: 20px;
  }
  .daily-report-list-daterange-wrap {
    display: inline-block;
    max-width: 100%;
  }
  .daily-report-list-daterange-wrap .form-control,
  .daily-report-list-daterange-wrap input.flatpickr-alt-input {
    width: 15rem;
    max-width: 100%;
    border-radius: 0.5rem;
    text-align: center;
  }
  #daily-report-modal .daily-report-entries-table {
    table-layout: fixed;
    width: 100%;
  }
  #daily-report-modal .daily-report-entries-table thead th,
  #daily-report-modal .daily-report-entries-table tbody td {
    width: 50%;
    text-align: center;
    vertical-align: middle;
  }
  #daily-report-modal .daily-report-entries-table .form-control {
    text-align: center;
  }
</style>

<div class="container-fluid content-inner py-0">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <h3 class="card-title mb-0">
            <div class="breadcrumb1 flat">
              <a href="/dashboard"><span class="fa fa-home"></span></a>
              <a href="/table_daily_report">Table Daily Report</a>
              <a href="/table_daily_report_winloss" class="active">Winloss</a>
            </div>
          </h3>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-sm btn-alt-success d-inline-flex align-items-center gap-1" id="btn-print-daily-report-matrix">
              <i class="fa fa-print opacity-90"></i><span>Print</span>
            </button>
            <button type="button" class="btn btn-sm btn-warning d-inline-flex align-items-center gap-1" id="btn-export-daily-report-matrix">
              <i class="fa fa-file-excel opacity-90"></i><span>Export</span>
            </button>
            <button type="button" class="btn btn-sm btn-success" id="btn-add-daily-report">
              <i class="fa fa-plus me-1"></i> Add Report
            </button>
           
            <button type="button" class="btn btn-sm btn-primary" id="btn-open-add-junket-table">
              <i class="fa fa-table me-1"></i> Manage Tables
            </button>
          </div>
        </div>
        <div class="card-body">
          <hr class="my-3">
          <div class="d-flex justify-content-start mb-2">
            <div class="daily-report-list-daterange-wrap">
              <input type="text" class="form-control form-control-sm" id="daily-report-list-daterange" placeholder="Date range">
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-bordered table-sm text-center align-middle mb-0 daily-report-matrix" id="daily-report-view-table">
              <thead id="daily-report-list-thead">
                <tr><th>Date</th><th>Total</th></tr>
              </thead>
              <tbody id="daily-report-list-tbody">
                <tr>
                  <td colspan="2" class="text-center text-muted py-3">Loading reports...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../modals/daily_reports/manage_table') %>
<%- include('../modals/daily_reports/add_table') %>
<%- include('../modals/daily_reports/add_report_winloss') %>

<%- include('../partials/footer') %>
<script src="/assets/js/functions/table_daily_report.js"></script>
