<%
function matchServiceCategory(serviceType, category) {
   var raw = String(serviceType || '').trim().toLowerCase();
   if (!raw) return false;
   if (category === 'fnb') {
      if (raw === 'fnb' || raw === 'f & b') return true;
      var compact = raw.replace(/\s+/g, '').replace(/&/g, '');
      return compact === 'fb' || compact === 'fnb' || raw.indexOf('f&b') !== -1 || raw.indexOf('f & b') !== -1;
   }
   if (category === 'hotel') return raw === 'hotel' || raw.indexOf('hotel') !== -1;
   if (category === 'delivery') {
      if (raw === 'incidental' || raw.indexOf('incidental') !== -1) return false;
      return raw === 'delivery' || raw.indexOf('delivery') !== -1;
   }
   if (category === 'incidental') return raw === 'incidental' || raw.indexOf('incidental') !== -1;
   return raw.indexOf(String(category || '').toLowerCase()) !== -1;
}

function sumServiceRows(rows, category) {
   if (!rows || !rows.length) return 0;
   var total = 0;
   rows.forEach(function (row) {
      if (matchServiceCategory(row.SERVICE_TYPE, category)) total += (+row.TOTAL || 0);
   });
   return total;
}

function signedServiceBalance(category) {
   var guestIn = sumServiceRows(sqlServiceCashGuest, category) + sumServiceRows(sqlServiceDepositGuest, category);
   var junketOut = sumServiceRows(sqlServiceCashJunket, category) + sumServiceRows(sqlServiceDepositJunket, category);
   return guestIn - junketOut;
}

function junketServiceOut(category) {
   return sumServiceRows(sqlServiceCashJunket, category) + sumServiceRows(sqlServiceDepositJunket, category);
}

function sumAllServiceRows(rows) {
   if (!rows || !rows.length) return 0;
   return rows.reduce((sum, row) => sum + (+row.TOTAL || 0), 0);
}

function pickCurrency(rows, code) {
   if (!rows || !rows.length) return 0;
   const row = rows.find((r) => String(r.CODE || '').toUpperCase() === String(code).toUpperCase());
   return row ? (+row.PENDING || 0) : 0;
}

