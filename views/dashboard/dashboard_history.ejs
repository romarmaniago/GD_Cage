<%- include ('../partials/header'); -%>
<%- include('../partials/loader') %>
    <%- include ('../partials/sidebar'); -%>
        <%- include ('../partials/topbar'); -%>



            <!-- Main Container -->
            <div class="container-fluid content-inner py-0">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">

                                <h3 class="card-title">
									<div class="breadcrumb1 flat">
										<a href="/dashboard"><span class="fa fa-home"></span></a>
										<a href="/dashboard_history" class=" active"><%= __('dashboard_history.reset_history') %></a>
									</div>
								</h3>
                            </div>

                            <div class="card-body dashboard-history-page">
                                <div class="marker-balance-dt-wrap marker-balance-card table-responsive">
                                <table id="dashboardhistory-tbl" class="table marker-balance-tbl nowrap small-text w-100 mb-0">
                                    <thead>
                                        <tr>
                                            <th>Period</th>
                                            <th><%= __('dashboard_history.commission') %></th>
                                            <th><%= __('dashboard_history.total_rolling') %></th>
                                            <th><%= __('dashboard_history.house_rolling') %></th>
                                            <th><%= __('dashboard_history.win_loss') %></th>
                                            <th>NN Chips</th>
                                            <th>CC Chips</th>
                                            <th><%= __('dashboard_history.reset_by') %></th>
                                            <th>Date Settled</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        
                                    </tbody>
                                </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <%- include ('../partials/footer'); -%>
<style>
    .card-body {
  overflow-x: auto;
}

/* Cream/light-gray theme */
.card {
    background: linear-gradient(180deg, #f6f3ec 0%, #efe9db 100%) !important;
    border: 1px solid rgba(200, 162, 76, 0.4) !important;
}
.card-header {
    background: linear-gradient(180deg, #f6f3ec 0%, #efe9db 100%) !important;
    border-bottom: 1px solid rgba(200, 162, 76, 0.25) !important;
}
.marker-balance-card {
    background: linear-gradient(180deg, #fafbfc 0%, #ffffff 48px) !important;
    border: 1px solid rgba(15, 23, 42, 0.08) !important;
    border-radius: 12px !important;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04) !important;
    padding: 0 !important;
}

.dashboard-history-page table.dataTable {
    border-collapse: collapse !important;
    border-spacing: 0 !important;
}

.dashboard-history-page table.dataTable thead > tr > th.sorting,
.dashboard-history-page table.dataTable thead > tr > th.sorting_asc,
.dashboard-history-page table.dataTable thead > tr > th.sorting_desc,
.dashboard-history-page table.dataTable thead > tr > th.sorting_disabled {
    background: #f5f5f5 !important;
    background-color: #f5f5f5 !important;
    box-shadow: none !important;
}

/* Base table styles */
#dashboardhistory-tbl {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
    border: 1px solid #e0e0e0 !important;
}

/* Header styles */
#dashboardhistory-tbl thead tr {
    background-color: #f5f5f5 !important;
}
#dashboardhistory-tbl thead th {
    background: #f5f5f5 !important;
    color: #555 !important;
    font-weight: 600;
    padding: 14px 20px;
    text-align: center;
    border: none;
    border-bottom: 1px solid #e0e0e0 !important;
}

#dashboardhistory-tbl_wrapper .dashboard-history-controls-highlight {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    margin-bottom: -1px;
    background: #fff;
    border: 1px solid #e8ecf1;
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
}
#dashboardhistory-tbl_wrapper .dashboard-history-controls-highlight .dataTables_length {
    margin-top: 4px;
}
#dashboardhistory-tbl_wrapper .dashboard-history-controls-highlight .dataTables_filter {
    margin: 0 0 0 auto;
}
#dashboardhistory-tbl_wrapper #dashboardhistory-tbl_filter .dashboard-history-filter-highlight {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 2px 6px;
    background: transparent;
    border: none;
    border-radius: 10px;
}
#dashboardhistory-tbl_wrapper #dashboardhistory-tbl_filter .dashboard-history-filter-highlight label {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0;
    font-size: 0;
    color: transparent;
}
#dashboardhistory-tbl_wrapper #dashboardhistory-tbl_filter .dashboard-history-filter-highlight label input {
    margin-left: 0;
    border: none;
    outline: none;
    box-shadow: none;
    background: #fff;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
    color: #333;
    min-width: 160px;
}
#dashboardhistory-tbl_wrapper #dashboardhistory-tbl_filter .dashboard-history-filter-highlight label input::placeholder {
    color: #8a92a6;
    opacity: 1;
}
#dashboardhistory-tbl_wrapper #dashboardhistory-tbl {
    margin-top: 0 !important;
}
#dashboardhistory-tbl_wrapper .dataTables_length,
#dashboardhistory-tbl_wrapper .dataTables_filter {
    padding-left: 0;
    padding-right: 0;
}

/* Row styles */
#dashboardhistory-tbl tbody tr {
    border-bottom: 1px solid #eee;
}

/* Cell styles - centered with improved spacing */
#dashboardhistory-tbl td {
    padding: 14px 20px;
    color: #666;
    text-align: center;
}

#dashboardhistory-tbl tbody tr:nth-child(even) td {
    background-color: #f4f1ea !important;
}
#dashboardhistory-tbl tbody tr:nth-child(odd) td {
    background-color: #fff !important;
}

#dashboardhistory-tbl tbody tr:hover,
#dashboardhistory-tbl tbody tr:hover td {
    background-color: #f6f3ec !important;
}



/* Balance column */
#dashboardhistory-tbl td:last-child {
   
    color: #333;
}


/* Footer total row */


#dashboardhistory-tbl tfoot th {
    padding: 14px 20px;
    font-weight: 600;
    text-align: center;
    background: #f5f5f5 !important;
    color: #555 !important;
    border-top: 1px solid #e0e0e0 !important;
    border-bottom: 1px solid #e0e0e0 !important;
}
@media (max-width: 768px) {
    #dashboardhistory-tbl {
        font-size: 10px; /* Mas maliit sa mobile */
    }

    #dashboardhistory-tbl th,
    #dashboardhistory-tbl td {
        padding: 10px 12px;
    }
}
							/* Itago ang text na "Show" at "entries" sa DataTables */
							.dataTables_length label {
								font-size: 0; /* Itatago ang text */
							}
							
							/* Panatilihin ang dropdown na nakikita */
							.dataTables_length select {
								font-size: 12px; /* Ibalik ang font size ng dropdown */
							}
							
							
							
								/* Adjust spacing and alignment for date range picker */
							.dataTables_wrapper .row {
								margin-bottom: 15px;
								font-size: 12px; /* Pareho sa commission-tbl */
							}
							
							/* Flexbox layout for the date range picker */
							.input-daterange {
								display: flex;
								justify-content: space-between;
								position: relative;
								left: 7.5rem;
								top: 4rem;
								max-width: 300px;
								font-size: 12px; /* Pareho sa commission-tbl */
							}
							
							/* Styling for form controls */
							.input-daterange .form-control {
								flex: 1;
								margin-right: 5px;
								max-width: 120px;
								font-size: 12px; /* Pareho sa commission-tbl */
								padding: 8px; /* Pareho sa cell padding ng table */
							}
							
							/* Remove margin from the last input */
							.input-daterange .form-control:last-child {
								margin-right: 0;
							}
							
							/* Responsive tweaks */
							@media (max-width: 768px) {
								.dataTables_wrapper .row,
								.input-daterange,
								.input-daterange .form-control {
									font-size: 10px; /* Mas maliit sa mobile */
								}
							
								.input-daterange .form-control {
									padding: 5px; /* Mas maliit na padding */
								}
							}
</style>
                <script>
                    // Pass translations to JavaScript
                    window.dashboardHistoryTranslations = {
                        search: "<%= __('dashboard_history.search') %>",
                        showing_entries: "<%= __('dashboard_history.showing_entries') %>",
                        previous: "<%= __('dashboard_history.previous') %>",
                        next: "<%= __('dashboard_history.next') %>",
                        no_data_available: "<%= __('dashboard_history.no_data_available') %>",
                        invalid_date: "<%= __('dashboard_history.invalid_date') %>"
                    };

                    (function () {
                        function applyDashboardHistoryControlsLayout() {
                            var wrapper = document.getElementById('dashboardhistory-tbl_wrapper');
                            var lengthWrap = document.getElementById('dashboardhistory-tbl_length');
                            var filterWrap = document.getElementById('dashboardhistory-tbl_filter');
                            var searchLabel = filterWrap ? filterWrap.querySelector('label') : null;
                            var searchInput = searchLabel ? searchLabel.querySelector('input') : null;
                            var controlsHighlight;
                            var filterHighlight;
                            var searchPlaceholder = (window.dashboardHistoryTranslations && window.dashboardHistoryTranslations.search)
                                ? String(window.dashboardHistoryTranslations.search).replace(/\s*:?\s*$/, '') + '...'
                                : 'Search...';

                            if (!wrapper || !lengthWrap || !filterWrap || !searchLabel) return;

                            controlsHighlight = wrapper.querySelector('.dashboard-history-controls-highlight');
                            if (!controlsHighlight) {
                                controlsHighlight = document.createElement('div');
                                controlsHighlight.className = 'dashboard-history-controls-highlight';
                                wrapper.insertBefore(controlsHighlight, wrapper.firstChild);
                            }
                            if (lengthWrap.parentElement !== controlsHighlight) {
                                controlsHighlight.appendChild(lengthWrap);
                            }
                            if (filterWrap.parentElement !== controlsHighlight) {
                                controlsHighlight.appendChild(filterWrap);
                            }

                            filterHighlight = filterWrap.querySelector('.dashboard-history-filter-highlight');
                            if (!filterHighlight) {
                                filterHighlight = document.createElement('div');
                                filterHighlight.className = 'dashboard-history-filter-highlight';
                                filterWrap.appendChild(filterHighlight);
                            }
                            if (searchLabel.parentElement !== filterHighlight) {
                                filterHighlight.appendChild(searchLabel);
                            }
                            if (searchInput) {
                                searchInput.setAttribute('placeholder', searchPlaceholder);
                                Array.prototype.slice.call(searchLabel.childNodes).forEach(function (node) {
                                    if (node.nodeType === 3) searchLabel.removeChild(node);
                                });
                            }
                        }

                        if (window.jQuery) {
                            $(document).on('init.dt draw.dt', '#dashboardhistory-tbl', applyDashboardHistoryControlsLayout);
                            $(applyDashboardHistoryControlsLayout);
                        } else {
                            document.addEventListener('DOMContentLoaded', applyDashboardHistoryControlsLayout);
                        }
                    })();

                    $(document).ready(function () {
                        const translations = window.dashboardHistoryTranslations || {};
                        $('#dashboardhistory-tbl').DataTable({
                            "processing": true,
                            "serverSide": false,
                            "ajax": {
                                "url": "/get-dashboard-history",
                                "type": "GET",
                                "dataSrc": function (json) {
                                    console.log("Raw Data Loaded:", json);
                                    return json.map(function (row) {
                                        if (row.ENCODED_DT) {
                                            row.ENCODED_DT_RAW = moment.utc(row.ENCODED_DT, 'YYYY-MM-DD HH:mm:ss').format('YYYY-MM-DD HH:mm:ss'); // Use raw format for sorting
                                            row.ENCODED_DT = moment.utc(row.ENCODED_DT, 'YYYY-MM-DD HH:mm:ss').local().format('YYYY-MM-DD HH:mm'); // Convert to local time for display
                                        } else {
                                            row.ENCODED_DT = translations.invalid_date || 'Invalid Date';
                                        }
                                        return row;
                                    });
                                }
                            },
                            "language": {
                                "search": translations.search || "Search:",
                                "info": translations.showing_entries || "Showing _START_ to _END_ of _TOTAL_ entries",
                                "paginate": {
                                    "previous": translations.previous || "Previous",
                                    "next": translations.next || "Next"
                                },
                                "emptyTable": translations.no_data_available || "No data available in table"
                            },
                            "order": [[8, 'desc']], // Sort by Date Settled (last column)
                            "columns": [
                                { "data": "PERIOD_LABEL", "defaultContent": "-" },
                                { "data": "COMMISSION_HISTORY", "render": data => data ? parseFloat(data).toLocaleString('en-US') : '-' },
                                { "data": "TOTAL_ROLLING_HISTORY", "render": data => data ? parseFloat(data).toLocaleString('en-US') : '-' },
                                { "data": "HOUSE_ROLLING_HISTORY", "render": data => data ? parseFloat(data).toLocaleString('en-US') : '-' },
                                { "data": "WINLOSS_HISTORY", "render": data => data ? parseFloat(data).toLocaleString('en-US') : '-' },
                                { "data": "NN_CASHOUT", "render": data => data != null ? parseFloat(data).toLocaleString('en-US') : '-' },
                                { "data": "CC_CASHOUT", "render": data => data != null ? parseFloat(data).toLocaleString('en-US') : '-' },
                                { "data": "FIRSTNAME" },
                                {
                                    "data": "ENCODED_DT",
                                    "type": "date",
                                    "render": function (data, type, row) {
                                        return type === 'sort' ? row.ENCODED_DT_RAW : row.ENCODED_DT;
                                    }
                                },
                                {
                                    "data": null,
                                    "orderable": false,
                                    "searchable": false,
                                    "render": function (data, type, row) {
                                        if (!row.MONTH_SETTLE_ID || Number(row.IS_LATEST_SETTLE) !== 1) return '-';
                                        return `
                                            <button class="btn btn-sm btn-outline-danger undo-month-settle-btn" data-id="${row.MONTH_SETTLE_ID}">
                                                Undo
                                            </button>
                                        `;
                                    }
                                }
                            ]
                        });

                        $('#dashboardhistory-tbl').on('click', '.undo-month-settle-btn', async function () {
                            const monthSettleId = $(this).data('id');
                            const confirmRes = await SwalConfirm.fire({
                                title: 'Undo monthly settle?',
                                message: 'This will delete the selected settle.',
                                confirmButtonText: 'Yes, undo'
                            });
                            if (!confirmRes.isConfirmed) return;

                            try {
                                const response = await fetch('/undo-month-settle', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ month_settle_id: monthSettleId })
                                });
                                const result = await response.json().catch(() => ({}));
                                if (!response.ok || !result.success) {
                                    throw new Error(result.message || 'Failed to undo monthly settle');
                                }

                                await Swal.fire({
                                    icon: 'success',
                                    title: 'Undo successful'
                                });
                                $('#dashboardhistory-tbl').DataTable().ajax.reload(null, false);
                            } catch (error) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: error.message || 'An error occurred while undoing monthly settle.'
                                });
                            }
                        });
                    });

                </script>