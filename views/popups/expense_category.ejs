<%- include('../partials/header') %>
<%- include('../partials/loader') %>
	<%- include('../partials/sidebar') %>

		<%- include('../partials/topbar') %>



			<div class="container-fluid content-inner py-0">
				<div class="row">
					<div class="col-sm-12">
						<div class="card">
							<div id="user-role" data-permissions="<%= permissions %>"></div>
							<div class="card-header d-flex justify-content-between align-items-center">

								<h3 class="card-title"><div class="breadcrumb1 flat">
									<a href="/dashboard" ><span class="fa fa-home"></span></a>
									<a href="/expense_category"class="active"><%= __('expense_category.expense_category') %></a>
								</div></h3>
								<button type="button" class="btn btn-primary" onclick="addExpenseCategory()">
									<i class="fa fa-plus" aria-hidden="true"></i> <%= __('expense_category.new_category') %>
								</button>

							</div>



							<div class="card-body settings-page">
								<!-- DataTables init on table by adding .js-dataTable-responsive class, functionality is initialized in js/pages/be_tables_datatables.min.js which was auto compiled from _js/pages/be_tables_datatables.js -->
								<div class="marker-balance-dt-wrap marker-balance-card table-responsive">
								<table id="expense-category-tbl" class="table marker-balance-tbl w-100 mb-0">
									<thead>
									<tr>
										<th class="d-none d-sm-table-cell"><%= __('expense_category.category') %></th>
										<th class="d-none d-sm-table-cell">Main / Parent</th>
										<th class="d-none d-sm-table-cell"><%= __('expense_category.type') %></th>
										<th class="d-none d-sm-table-cell" style="width: 150px;"><%= __('expense_category.status') %></th>
										<th class="d-none d-sm-table-cell text-center" style="width: 100px;"><%= __('expense_category.action') %></th>
									</tr>
									</thead>
									<tbody>
									</tbody>
								</table>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>




			<%- include ('../modals/popups/new_expense_category') %>
				<%- include ('../modals/popups/edit_expense_category') %>
				<%- include ('../partials/permission_view_only_script') %>
					<%- include ('../partials/footer') %>

					<script>
						// Pass translations to JavaScript
						window.expenseCategoryTranslations = {
							search: "<%= __('expense_category.search') %>",
							showing_entries: "<%= __('expense_category.showing_entries') %>",
							previous: "<%= __('expense_category.previous') %>",
							next: "<%= __('expense_category.next') %>",
							active: "<%= __('expense_category.active') %>",
							inactive: "<%= __('expense_category.inactive') %>",
							type: "<%= __('expense_category.type') %>",
							goods_label: "<%= __('expense_category.goods') %>",
							non_goods_label: "<%= __('expense_category.non_goods') %>"
						};
					</script>

			
						<script src="/assets/js/functions/expense_category.js"></script>

						<style>
							.card-body {
  overflow-x: auto;
}

.settings-page {
	--gd-marker-gold-solid: #d9b96a;
	--gd-marker-gold-text: #3a2e12;
	--gd-marker-gold-border: rgba(58, 46, 18, 0.25);
	--gd-marker-gold-hover: #faf3dc;
}
.settings-page table.dataTable {
	border-collapse: collapse !important;
	border-spacing: 0 !important;
}
.settings-page table thead tr,
.settings-page table tfoot tr {
	background-color: var(--gd-marker-gold-solid);
}
.settings-page table thead th,
.settings-page table tfoot th {
	background: transparent !important;
	background-color: transparent !important;
	box-shadow: none !important;
}
.settings-page table.dataTable thead > tr > th.sorting,
.settings-page table.dataTable thead > tr > th.sorting_asc,
.settings-page table.dataTable thead > tr > th.sorting_desc,
.settings-page table.dataTable thead > tr > th.sorting_disabled {
	background: transparent !important;
	background-color: transparent !important;
}

								#expense-category-tbl {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
    border: 1px solid var(--gd-marker-gold-border);
}

/* Header styles — gold bg only; keep original text color */
#expense-category-tbl thead th {
    color: var(--bs-primary);
    font-weight: 500;
    padding: 12px 15px;
    text-align: left;
    border: none;
    border-bottom: 1px solid var(--gd-marker-gold-border);
}

/* Row styles */
		#expense-category-tbl tbody tr {
    border-bottom: 1px solid #eee;
}

#expense-category-tbl tbody tr:nth-child(even) td {
	background-color: #fbf5e4;
}

/* Cell styles */
#expense-category-tbl td {
    padding: 12px 15px;
    color: #666;
}

#expense-category-tbl tbody tr:hover,
#expense-category-tbl tbody tr:hover td {
  background-color: var(--gd-marker-gold-hover) !important;
}



/* Balance column */
#expense-category-tbl td:last-child {
    text-align: center;
    color: #333;
}


/* Footer total row */


#expense-category-tbl tfoot th {
    padding: 10px;
    font-weight: 600;
    color: #333;
    border-top: 2px solid var(--gd-marker-gold-border);
    border-bottom: 1px solid var(--gd-marker-gold-border);
}
@media (max-width: 768px) {
    #expense-category-tbl {
        font-size: 10px; /* Mas maliit sa mobile */
    }

    #expense-category-tbl th,
    #expense-category-tbl td {
        padding: 5px;
    }
}
							/* Itago ang text na "Show" at "entries" sa DataTables */
							.dataTables_length label {
								font-size: 0; /* Itatago ang text */
							}
							
							/* Panatilihin ang dropdown na nakikita */
							.dataTables_length select {
								font-size: 12px; /* Ibalik ang font size ng dropdown */
							}
							
							
							
								/* Adjust spacing and alignment for date range picker */
							.dataTables_wrapper .row {
								margin-bottom: 15px;
								font-size: 12px; /* Pareho sa commission-tbl */
							}
							
							/* Flexbox layout for the date range picker */
							.input-daterange {
								display: flex;
								justify-content: space-between;
								position: relative;
								left: 7.5rem;
								top: 3.5rem;
								max-width: 300px;
								font-size: 12px; /* Pareho sa commission-tbl */
							}
							
							/* Styling for form controls */
							.input-daterange .form-control {
								flex: 1;
								margin-right: 5px;
								max-width: 120px;
								font-size: 12px; /* Pareho sa commission-tbl */
								padding: 8px; /* Pareho sa cell padding ng table */
							}
							
							/* Remove margin from the last input */
							.input-daterange .form-control:last-child {
								margin-right: 0;
							}
							
							/* Responsive tweaks */
							@media (max-width: 768px) {
								.dataTables_wrapper .row,
								.input-daterange,
								.input-daterange .form-control {
									font-size: 10px; /* Mas maliit sa mobile */
								}
							
								.input-daterange .form-control {
									padding: 5px; /* Mas maliit na padding */
								}
							}
							#expense-category-tbl th,
							#expense-category-tbl td {
								white-space: nowrap;
							}
							#expense-category-tbl th:nth-child(1),
							#expense-category-tbl td:nth-child(1) {
								width: 30%;
							}
							#expense-category-tbl th:nth-child(2),
							#expense-category-tbl td:nth-child(2) {
								width: 30%;
							}
						</style>