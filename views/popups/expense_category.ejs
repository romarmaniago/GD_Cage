						</style>
						<script>
							(function () {
								function applyExpenseCategoryControlsLayout() {
									var wrapper = document.getElementById('expense-category-tbl_wrapper');
									var lengthWrap = document.getElementById('expense-category-tbl_length');
									var filterWrap = document.getElementById('expense-category-tbl_filter');
									var searchLabel = filterWrap ? filterWrap.querySelector('label') : null;
									var searchInput = searchLabel ? searchLabel.querySelector('input') : null;
									var controlsHighlight;
									var filterHighlight;
									var searchPlaceholder = (window.expenseCategoryTranslations && window.expenseCategoryTranslations.search)
										? String(window.expenseCategoryTranslations.search).replace(/\s*:?\s*$/, '') + '...'
										: 'Search...';

								if (!wrapper || !lengthWrap || !filterWrap || !searchLabel) return;

								controlsHighlight = wrapper.querySelector('.expense-category-controls-highlight');
								if (!controlsHighlight) {
									controlsHighlight = document.createElement('div');
									controlsHighlight.className = 'expense-category-controls-highlight';
									wrapper.insertBefore(controlsHighlight, wrapper.firstChild);
								}
								if (lengthWrap.parentElement !== controlsHighlight) {
									controlsHighlight.appendChild(lengthWrap);
								}
								if (filterWrap.parentElement !== controlsHighlight) {
									controlsHighlight.appendChild(filterWrap);
								}

								if (!controlsHighlight.querySelector('#btn-add-expense-category')) {
									var addBtn = document.createElement('button');
									addBtn.type = 'button';
									addBtn.id = 'btn-add-expense-category';
									addBtn.className = 'expense-cat-panel-add-btn';
									addBtn.title = '<%= __("expense_category.new_category") %>';
									addBtn.setAttribute('aria-label', '<%= __("expense_category.new_category") %>');
									addBtn.onclick = function () { addExpenseCategory(); };
									addBtn.innerHTML = '<i class="fa fa-plus" aria-hidden="true"></i>';
									filterWrap.insertBefore(addBtn, filterWrap.firstChild);
								}

								filterHighlight = filterWrap.querySelector('.expense-category-filter-highlight');
								if (!filterHighlight) {
									filterHighlight = document.createElement('div');
									filterHighlight.className = 'expense-category-filter-highlight';
									filterWrap.appendChild(filterHighlight);
								}
								if (searchLabel.parentElement !== filterHighlight) {
									filterHighlight.appendChild(searchLabel);
								}
									if (searchInput) {
										searchInput.setAttribute('placeholder', searchPlaceholder);
										Array.prototype.slice.call(searchLabel.childNodes).forEach(function (node) {
											if (node.nodeType === 3) searchLabel.removeChild(node);
										});
									}
								}

								if (window.jQuery) {
									$(document).on('init.dt draw.dt', '#expense-category-tbl', applyExpenseCategoryControlsLayout);
									$(applyExpenseCategoryControlsLayout);
								} else {
									document.addEventListener('DOMContentLoaded', applyExpenseCategoryControlsLayout);
								}
							})();
						</script>