<%- include('./partials/header') %>
<body class="gd-login-page">
<section class="login-content gd-login-content">
    <div class="gd-login-center-wrap">
      <div class="gd-login-card">
            <div class="text-center mb-4">
              <img src="/assets/images/GD-logo.png" alt="Golden Dragon" class="gd-login-logo mb-3">
              <h2 class="gd-login-title mb-1">Sign In</h2>
              <p class="gd-login-subtitle mb-0">Golden Dragon CageX</p>
            </div>

            <% 
              var hasError = messages.error && messages.error.length > 0;
              var errorMsg = hasError ? messages.error[0] : null;
            %>
            <% if (hasError && errorMsg !== 'ACCOUNT_CONFLICT' && errorMsg !== 'KICKED') { %>
              <div class="alert alert-danger text-center mb-4 d-flex align-items-center justify-content-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span><%= errorMsg %></span>
              </div>
            <% } %>

            <% if ((hasError && errorMsg === 'KICKED') || (typeof showKickedMessage !== 'undefined' && showKickedMessage)) { %>
              <script>
                document.addEventListener('DOMContentLoaded', function () {
                  if (typeof Swal !== 'undefined') {
                    Swal.fire({
                      title: 'Session disconnected',
                      text: 'Your account was logged in from another device. This session has been disconnected.',
                      icon: 'info',
                      confirmButtonText: 'OK'
                    });
                  }
                });
              </script>
            <% } %>

            <form class="login100-form validate-form" id="login" action="/login" method="POST">
              <div class="mb-3">
                <label for="username" class="form-label gd-form-label">Username</label>
                <input type="text" class="form-control gd-form-control" id="username" name="username" placeholder="Enter username" autocomplete="username">
              </div>
              <div class="mb-3">
                <label for="password" class="form-label gd-form-label">Password</label>
                <input type="password" class="form-control gd-form-control" id="password" name="password" placeholder="Enter password" autocomplete="current-password">
              </div>
              <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                  <input type="checkbox" class="form-check-input gd-form-check" id="rememberMe" name="remember-me">
                  <label class="form-check-label gd-form-label" for="rememberMe">Remember Me</label>
                </div>
                <a href="#" class="gd-login-link">Forgot Password?</a>
              </div>
              <div class="d-grid">
                <button type="submit" class="btn btn-lg bg-gradient-gold gd-login-btn">Sign In</button>
              </div>
            </form>
      </div>
    </div>
</section>

<style>
  .btn-setting {
    display: none !important;
  }

  .gd-login-page {
    background: #0b0b0b;
  }

  .gd-login-content {
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #0f0d0a 0%, #0b0b0b 45%, #000000 100%);
  }

  .gd-login-content::before {
    content: "";
    position: absolute;
    right: 26%;
    top: 50%;
    transform: translateY(-50%);
    width: min(72vw, 650px);
    height: min(72vw, 650px);
    background: url("/assets/images/gd-background-logo.png") center center / contain no-repeat;
    opacity: 0.08;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 50%, #000 50%, #000 100%);
    mask-image: linear-gradient(to right, transparent 0%, transparent 50%, #000 50%, #000 100%);
  }

  .gd-login-center-wrap {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .gd-login-card {
    width: 100%;
    max-width: 420px;
    padding: 2.25rem 2rem;
    border-radius: 1rem;
    background: linear-gradient(160deg, #121212 0%, #0a0a0a 100%);
    border: 1px solid rgba(200, 162, 76, 0.35);
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(255, 255, 255, 0.03) inset;
  }

  .gd-login-logo {
    width: min(72vw, 180px);
    height: auto;
    object-fit: contain;
  }

  .gd-login-title {
    color: #f5f0e6;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .gd-login-subtitle {
    color: #c8a24c;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gd-form-label {
    color: #d8d0c0;
    font-size: 0.9rem;
  }

  .gd-form-control {
    background: #161616;
    border: 1px solid rgba(200, 162, 76, 0.25);
    color: #f5f0e6;
    border-radius: 0.5rem;
    padding: 0.7rem 0.9rem;
    color-scheme: dark;
  }

  .gd-form-control:-webkit-autofill,
  .gd-form-control:-webkit-autofill:hover,
  .gd-form-control:-webkit-autofill:focus,
  .gd-form-control:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 1000px #161616 inset !important;
    box-shadow: 0 0 0 1000px #161616 inset !important;
    -webkit-text-fill-color: #f5f0e6 !important;
    caret-color: #f5f0e6;
    border: 1px solid rgba(200, 162, 76, 0.25);
    transition: background-color 9999s ease-out 0s;
  }

  .gd-form-control:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #1a1a1a inset, 0 0 0 0.2rem rgba(200, 162, 76, 0.2) !important;
    box-shadow: 0 0 0 1000px #1a1a1a inset, 0 0 0 0.2rem rgba(200, 162, 76, 0.2) !important;
    border-color: #c8a24c;
  }

  .gd-form-control::placeholder {
    color: #7a7268;
  }

  .gd-form-control:focus {
    background: #1a1a1a;
    border-color: #c8a24c;
    color: #fff;
    box-shadow: 0 0 0 0.2rem rgba(200, 162, 76, 0.2);
  }

  .gd-form-check {
    background-color: #161616;
    border-color: rgba(200, 162, 76, 0.45);
  }

  .gd-form-check:checked {
    background-color: #c8a24c;
    border-color: #c8a24c;
  }

  .gd-login-link {
    color: #eacc90;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .gd-login-link:hover {
    color: #f1d48a;
    text-decoration: underline;
  }

  .gd-login-btn {
    color: #1a1205 !important;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: none;
    box-shadow: 0 8px 20px rgba(200, 162, 76, 0.25);
  }

  .gd-login-btn:hover,
  .gd-login-btn:focus {
    color: #0f0a02 !important;
    transform: translateY(-1px);
  }
</style>
</body>
  <script src="/assets/js/core/libs.min.js"></script>
  <script src="/assets/js/core/external.min.js"></script>
  <script src="/assets/js/charts/widgetcharts.js"></script>
  <script src="/assets/js/charts/vectore-chart.js"></script>
  <script src="/assets/js/charts/dashboard.js"></script>
  <script src="/assets/js/plugins/fslightbox.js"></script>
  <script src="/assets/js/plugins/setting.js"></script>
  <script src="/assets/js/plugins/slider-tabs.js"></script>
  <script src="/assets/js/plugins/form-wizard.js"></script>
  <script src="/assets/vendor/aos/dist/aos.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/assets/js/hope-ui.js" defer></script>
