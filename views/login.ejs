<%- include('./partials/header') %>
<body class="gd-login-page">
<section class="login-content gd-login-content">
    <div class="gd-login-layout">
      <aside class="gd-login-panel-left">
        <div class="gd-login-form-wrap">
          <div class="gd-login-card">
            <div class="gd-login-card-shine" aria-hidden="true"></div>
            <div class="gd-login-card-frame" aria-hidden="true"></div>
            <div class="gd-login-card-inner">
            <div class="text-center mb-4">
              <img src="/assets/images/GD-logo.png" alt="Golden Dragon" class="gd-login-logo mb-3">
              <h2 class="gd-login-title mb-1">Sign In</h2>
              <p class="gd-login-subtitle mb-0">Golden Dragon CageX</p>
            </div>

            <% 
              var hasError = messages.error && messages.error.length > 0;
              var errorMsg = hasError ? messages.error[0] : null;
            %>
            <% if (hasError && errorMsg !== 'ACCOUNT_CONFLICT' && errorMsg !== 'KICKED') { %>
              <div class="alert alert-danger text-center mb-4 d-flex align-items-center justify-content-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span><%= errorMsg %></span>
              </div>
            <% } %>

            <% if ((hasError && errorMsg === 'KICKED') || (typeof showKickedMessage !== 'undefined' && showKickedMessage)) { %>
              <script>
                document.addEventListener('DOMContentLoaded', function () {
                  if (typeof Swal !== 'undefined') {
                    Swal.fire({
                      title: 'Session disconnected',
                      text: 'Your account was logged in from another device. This session has been disconnected.',
                      icon: 'info',
                      confirmButtonText: 'OK'
                    });
                  }
                });
              </script>
            <% } %>

            <form class="login100-form validate-form" id="login" action="/login" method="POST">
              <div class="mb-3">
                <label for="username" class="form-label gd-form-label">Username</label>
                <input type="text" class="form-control gd-form-control" id="username" name="username" placeholder="Enter username" autocomplete="username">
              </div>
              <div class="mb-3">
                <label for="password" class="form-label gd-form-label">Password</label>
                <input type="password" class="form-control gd-form-control" id="password" name="password" placeholder="Enter password" autocomplete="current-password">
              </div>
              <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                  <input type="checkbox" class="form-check-input gd-form-check" id="rememberMe" name="remember-me">
                  <label class="form-check-label gd-form-label" for="rememberMe">Remember Me</label>
                </div>
                <a href="#" class="gd-login-link">Forgot Password?</a>
              </div>
              <div class="d-grid">
                <button type="submit" class="btn btn-lg bg-gradient-gold gd-login-btn">Sign In</button>
              </div>
            </form>
            </div>
          </div>
        </div>
      </aside>

      <div class="gd-login-panel-right">
        <div class="gd-login-brand">
          <p class="gd-login-hero-sub">developed by <strong>3Core Leaderstech</strong></p>
          <h1 class="gd-login-hero-title">
            <span class="gd-login-hero-line">Cage Management</span>
            <span class="gd-login-hero-line">System</span>
          </h1>
        </div>
      </div>
    </div>
</section>

<style>
  .btn-setting {
    display: none !important;
  }

  .gd-login-page {
    margin: 0;
    min-height: 100vh;
    min-height: 100dvh;
    background: #0b0b0b;
  }

  .gd-login-content {
    min-height: 100vh;
    min-height: 100dvh;
    width: 100%;
    position: relative;
    overflow: hidden;
    background: #0b0b0b;
  }

  .gd-login-content::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url("/assets/images/gd-background-logo.png") center center / cover no-repeat;
    pointer-events: none;
  }

  .gd-login-content::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  .gd-login-layout {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    min-height: 100vh;
    min-height: 100dvh;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem clamp(1.5rem, 5vw, 4rem);
    box-sizing: border-box;
  }

  .gd-login-panel-left {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0;
  }

  .gd-login-form-wrap {
    width: 100%;
    max-width: 420px;
  }

  .gd-login-panel-right {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0;
    position: relative;
  }

  .gd-login-panel-right::before {
    content: "";
    position: absolute;
    left: calc(clamp(2rem, 5vw, 5rem) / -2);
    top: 8%;
    height: 84%;
    width: 1px;
    transform: translateX(-50%);
    background: linear-gradient(180deg, transparent, rgba(200, 162, 76, 0.35), transparent);
  }

  .gd-login-brand {
    max-width: min(520px, 100%);
    transform: translateY(clamp(-6.25rem, -13vh, -10rem));
  }

  .gd-login-hero-sub {
    margin: 0 0 0.85rem;
    font-size: clamp(0.7rem, 1.2vw, 0.85rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.04em;
    color: rgba(245, 240, 230, 0.78);
  }

  .gd-login-hero-sub strong {
    color: #eacc90;
    font-weight: 600;
  }

  .gd-login-hero-title {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.08em;
    font-size: clamp(2.75rem, 4.8vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #faf6ee;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.5);
  }

  .gd-login-hero-line {
    display: block;
    white-space: nowrap;
  }

  @media (max-width: 991.98px) {
    .gd-login-layout {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding: 2rem 1.5rem 2.5rem;
    }

    .gd-login-panel-left,
    .gd-login-panel-right {
      justify-content: center;
      width: 100%;
    }

    .gd-login-panel-right {
      order: -1;
    }

    .gd-login-panel-right::before {
      display: none;
    }

    .gd-login-brand {
      max-width: 100%;
      text-align: center;
      transform: none;
    }

    .gd-login-hero-title {
      font-size: clamp(2rem, 8vw, 2.75rem);
      align-items: center;
    }

    .gd-login-form-wrap {
      max-width: 440px;
      margin: 0 auto;
    }
  }

  .gd-login-card {
    position: relative;
    width: 100%;
    min-width: 0;
    padding: 3px;
    border-radius: 1.35rem;
    background: linear-gradient(145deg, rgba(241, 212, 138, 0.95) 0%, rgba(138, 109, 47, 0.85) 38%, rgba(212, 175, 90, 0.9) 68%, rgba(90, 68, 24, 0.95) 100%);
    box-shadow:
      0 28px 60px rgba(0, 0, 0, 0.55),
      0 0 48px rgba(200, 162, 76, 0.14);
    overflow: hidden;
  }

  .gd-login-card-shine {
    display: none;
  }

  .gd-login-card-frame {
    position: absolute;
    inset: 10px;
    border-radius: 0.95rem;
    border: 1px solid rgba(212, 175, 90, 0.22);
    pointer-events: none;
    z-index: 1;
  }

  .gd-login-card-frame::before,
  .gd-login-card-frame::after {
    content: "";
    position: absolute;
    width: 28px;
    height: 28px;
    border-color: rgba(241, 212, 138, 0.75);
    border-style: solid;
    pointer-events: none;
  }

  .gd-login-card-frame::before {
    top: -1px;
    left: -1px;
    border-width: 2px 0 0 2px;
    border-radius: 0.55rem 0 0 0;
  }

  .gd-login-card-frame::after {
    bottom: -1px;
    right: -1px;
    border-width: 0 2px 2px 0;
    border-radius: 0 0 0.55rem 0;
  }

  .gd-login-card-inner {
    position: relative;
    z-index: 2;
    padding: 2.35rem 2rem 2.15rem;
    border-radius: 1.15rem;
    background: linear-gradient(160deg, #121212 0%, #0a0a0a 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .gd-login-card-inner::before,
  .gd-login-card-inner::after {
    content: "";
    position: absolute;
    width: 28px;
    height: 28px;
    border-color: rgba(241, 212, 138, 0.75);
    border-style: solid;
    pointer-events: none;
  }

  .gd-login-card-inner::before {
    top: 10px;
    right: 10px;
    border-width: 2px 2px 0 0;
    border-radius: 0 0.55rem 0 0;
  }

  .gd-login-card-inner::after {
    bottom: 10px;
    left: 10px;
    border-width: 0 0 2px 2px;
    border-radius: 0 0 0 0.55rem;
  }

  .gd-login-card-inner > .text-center {
    position: relative;
    padding-bottom: 1.35rem;
    margin-bottom: 1.5rem !important;
  }

  .gd-login-card-inner > .text-center::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: min(72%, 220px);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(212, 175, 90, 0.75), transparent);
  }

  .gd-login-logo {
    width: min(72vw, 180px);
    height: auto;
    object-fit: contain;
  }

  .gd-login-title {
    color: #f5f0e6;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .gd-login-subtitle {
    color: #c8a24c;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gd-form-label {
    color: #d8d0c0;
    font-size: 0.9rem;
  }

  .gd-form-control {
    background: #161616;
    border: 1px solid rgba(200, 162, 76, 0.25);
    color: #f5f0e6;
    border-radius: 0.5rem;
    padding: 0.7rem 0.9rem;
    color-scheme: dark;
  }

  .gd-form-control:-webkit-autofill,
  .gd-form-control:-webkit-autofill:hover,
  .gd-form-control:-webkit-autofill:focus,
  .gd-form-control:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 1000px #161616 inset !important;
    box-shadow: 0 0 0 1000px #161616 inset !important;
    -webkit-text-fill-color: #f5f0e6 !important;
    caret-color: #f5f0e6;
    border: 1px solid rgba(200, 162, 76, 0.25);
    transition: background-color 9999s ease-out 0s;
  }

  .gd-form-control:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #1a1a1a inset, 0 0 0 0.2rem rgba(200, 162, 76, 0.2) !important;
    box-shadow: 0 0 0 1000px #1a1a1a inset, 0 0 0 0.2rem rgba(200, 162, 76, 0.2) !important;
    border-color: #c8a24c;
  }

  .gd-form-control::placeholder {
    color: #7a7268;
  }

  .gd-form-control:focus {
    background: #1a1a1a;
    border-color: #c8a24c;
    color: #fff;
    box-shadow: 0 0 0 0.2rem rgba(200, 162, 76, 0.2);
  }

  .gd-form-check {
    background-color: #161616;
    border-color: rgba(200, 162, 76, 0.45);
  }

  .gd-form-check:checked {
    background-color: #c8a24c;
    border-color: #c8a24c;
  }

  .gd-login-link {
    color: #eacc90;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .gd-login-link:hover {
    color: #f1d48a;
    text-decoration: underline;
  }

  .gd-login-btn {
    color: #1a1205 !important;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: none;
    box-shadow: 0 8px 20px rgba(200, 162, 76, 0.25);
  }

  .gd-login-btn:hover,
  .gd-login-btn:focus {
    color: #0f0a02 !important;
    transform: translateY(-1px);
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var REMEMBER_KEY = 'gd_cage_remember_login';
    var LEGACY_USERNAME_KEY = 'gd_cage_remember_username';
    var usernameInput = document.getElementById('username');
    var passwordInput = document.getElementById('password');
    var rememberCheckbox = document.getElementById('rememberMe');
    var loginForm = document.getElementById('login');

    if (!usernameInput || !passwordInput || !rememberCheckbox || !loginForm) return;

    function loadRememberedLogin() {
      var saved = localStorage.getItem(REMEMBER_KEY);
      if (saved) {
        try {
          var data = JSON.parse(saved);
          if (data.username) usernameInput.value = data.username;
          if (data.password) passwordInput.value = data.password;
          rememberCheckbox.checked = true;
          return;
        } catch (e) {
          localStorage.removeItem(REMEMBER_KEY);
        }
      }

      var legacyUsername = localStorage.getItem(LEGACY_USERNAME_KEY);
      if (legacyUsername) {
        usernameInput.value = legacyUsername;
        rememberCheckbox.checked = true;
        localStorage.removeItem(LEGACY_USERNAME_KEY);
      }
    }

    loadRememberedLogin();

    loginForm.addEventListener('submit', function () {
      var username = usernameInput.value.trim();
      var password = passwordInput.value;

      if (rememberCheckbox.checked && username) {
        localStorage.setItem(REMEMBER_KEY, JSON.stringify({
          username: username,
          password: password
        }));
      } else {
        localStorage.removeItem(REMEMBER_KEY);
        localStorage.removeItem(LEGACY_USERNAME_KEY);
      }
    });
  });
</script>
</body>
