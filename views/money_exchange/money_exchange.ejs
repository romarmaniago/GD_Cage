<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="container-fluid content-inner py-0">
  <div class="row">
    <div class="col-sm-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <h3 class="card-title mb-0">
            <div class="breadcrumb1 flat">
              <a href="/dashboard"><span class="fa fa-home"></span></a>
              <a href="/money_exchange" class="active">Money Exchange</a>
            </div>
          </h3>
          <button type="button" class="btn btn-outline-primary" id="btn-currency-master">
            <i class="fa fa-coins me-1"></i> Currency
          </button>
        </div>
        <div class="card-body">
          <div class="money-exchange-board<% if (typeof permissions !== 'undefined' && Number(permissions) === 0) { %> mx-superadmin-history<% } %>">
            <% if (typeof permissions !== 'undefined') { %>
            <div id="user-role" class="d-none" data-permissions="<%= permissions %>"></div>
            <% } %>
            <div class="exchange-title exchange-title-blue">
              DEPOSIT
            </div>

            <div class="row g-3 mt-1">
              <div class="col-md-3">
                <label class="form-label fw-bold" for="mx-account">Account</label>
                <select class="js-select2 form-select" id="mx-account" name="mxAccount" style="width: 100%;" data-placeholder="No account" autocomplete="off">
                  <option value="">No account</option>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold" for="mx-guest-name">Name</label>
                <input type="text" class="form-control" id="mx-guest-name" maxlength="255" placeholder="Guest Name" autocomplete="off" />
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold" for="mx-remark">Remark</label>
                <input type="text" class="form-control" id="mx-remark" maxlength="500" placeholder="Remark" autocomplete="off" />
              </div>
            </div>

            <div class="row g-3 mt-1">
              <div class="col-12 col-md-6">
                <label class="form-label fw-bold text-nowrap" for="in-currency">In Currency</label>
                <select class="form-select" name="IN_CURRENCY_ID" id="in-currency" autocomplete="off">
                  <option value="" selected disabled>Select currency</option>
                  <% if (typeof currencies !== 'undefined' && currencies && currencies.length) { %>
                    <% currencies.forEach(function (c) { %>
                      <option value="<%= c.id %>"><%= c.code %></option>
                    <% }); %>
                  <% } %>
                </select>
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label fw-bold text-nowrap" for="mx-amount-in">Amount</label>
                <input type="text" class="form-control" id="mx-amount-in" inputmode="numeric" placeholder="0" />
              </div>
            </div>
            <div class="row row-cols-1 row-cols-md-3 g-3 mt-1">
              <div class="col">
                <label class="form-label fw-bold text-nowrap" for="exchange-currency" title="Exchange currency">Exchange Currency</label>
                <select class="form-select" name="EXCHANGE_CURRENCY_ID" id="exchange-currency" autocomplete="off">
                  <option value="" selected disabled>Select currency</option>
                  <% if (typeof currencies !== 'undefined' && currencies && currencies.length) { %>
                    <% currencies.forEach(function (c) { %>
                      <option value="<%= c.id %>"><%= c.code %></option>
                    <% }); %>
                  <% } %>
                </select>
              </div>
              <div class="col">
                <label class="form-label fw-bold text-nowrap" for="mx-rate-percent">Rate</label>
                <input type="number" class="form-control" id="mx-rate-percent" inputmode="decimal" step="0.01" placeholder="0.00" />
              </div>
              <div class="col">
                <label class="form-label fw-bold text-nowrap" for="mx-exchange-amount" title="Auto-calculated from amount and rate; you may override">Exchange Amount</label>
                <input type="text" class="form-control" id="mx-exchange-amount" inputmode="decimal" placeholder="0.00" autocomplete="off" />
              </div>
            </div>

            <div class="row mt-2">
              <div class="col-12 text-end">
                <button type="button" class="btn btn-primary px-4" id="btn-mx-save-deposit">
                  <i class="fa fa-save me-1"></i> Save Deposit
                </button>
              </div>
            </div>

            <div class="exchange-title exchange-title-orange mt-4">
              RETURN
            </div>
            <input type="hidden" id="mx-source-deposit-id" value="" />
            <div id="mx-source-deposit-note" class="small text-muted mt-2 mb-1">
              Select a deposit to return.
            </div>

            <div class="row g-3 mt-1">
              <div class="col-12 col-md-3">
                <label class="form-label fw-bold" for="mx-return-amount">Return Amount</label>
                <input type="text" class="form-control" id="mx-return-amount" inputmode="numeric" placeholder="0" disabled />
              </div>
              <div class="col-12 col-md-3">
                <label class="form-label fw-bold" for="mx-margin-return">Margin</label>
                <input type="text" class="form-control" id="mx-margin-return" inputmode="numeric" placeholder="0" disabled readonly tabindex="-1" />
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label fw-bold" for="mx-return-remark">Remark</label>
                <input type="text" class="form-control" id="mx-return-remark" maxlength="500" placeholder="Remark" autocomplete="off" disabled />
              </div>
            </div>

            <div class="row mt-2">
              <div class="col-12 text-end">
                <button type="button" class="btn btn-primary px-4" id="btn-mx-save-return" style="background-color: #E89149; border-color: #d67d35;" disabled>
                  <i class="fa fa-save me-1"></i> Save Return
                </button>
              </div>
            </div>

            <div class="exchange-history mt-4">
              <div class="mb-2 fw-bold text-primary">Deposit History</div>
              <div id="deposit-history-pane"> 
                <div class="marker-history-dt-wrap marker-history-card table-responsive">
                  <table id="mx-deposit-history-tbl" class="table table-bordered table-hover align-middle cage-modal-data-table mx-history-table mb-0">
                    <thead>
                      <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Account</th>
                        <th>Name</th>
                        <th>In Cur</th>
                        <th>Amount</th>
                        <th>Exch Cur</th>
                        <th>Rate</th>
                        <th>Exch Amount</th>
                        <th>Status</th>
                        <th>Remark</th>
                        <% if (typeof permissions !== 'undefined' && Number(permissions) === 0) { %>
                        <th class="text-center mx-history-col-actions">Actions</th>
                        <% } %>
                      </tr>
                    </thead>
                    <tbody id="mx-deposit-history-tbody">
                      <tr>
                        <td colspan="<%= typeof permissions !== 'undefined' && Number(permissions) === 0 ? 12 : 11 %>" class="text-center text-muted py-3">Loading…</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-mx-return-details" tabindex="-1" aria-labelledby="modal-mx-return-details-label" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <div>
          <h5 class="modal-title text-white mb-0" id="modal-mx-return-details-label">Return History</h5>
          <div class="mx-ret-header-meta text-white-50" id="mx-ret-header-meta">Deposit #— | —</div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body mx-return-details-body">
        <div class="mx-ret-row">
          <div class="mx-ret-label">Return Date/Time</div>
          <div class="mx-ret-value" id="mx-ret-detail-datetime">—</div>
        </div>
        <div class="mx-ret-row">
          <div class="mx-ret-label">Return Amount</div>
          <div class="mx-ret-value" id="mx-ret-detail-amount">—</div>
        </div>
        <div class="mx-ret-row">
          <div class="mx-ret-label">Margin</div>
          <div class="mx-ret-value" id="mx-ret-detail-margin">—</div>
        </div>
        <div class="mx-ret-row">
          <div class="mx-ret-label">Remark</div>
          <div class="mx-ret-value mx-ret-remark" id="mx-ret-detail-remark">—</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-mx-edit-txn" tabindex="-1" aria-labelledby="modal-mx-edit-txn-label" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="modal-mx-edit-txn-label">Edit transaction</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="form-mx-edit-txn">
        <div class="modal-body">
          <input type="hidden" id="mx-edit-txn-id" />
          <input type="hidden" id="mx-edit-trans-type" />
          <input type="hidden" id="mx-edit-source-deposit-id" />
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold" for="mx-edit-account">Account</label>
              <select class="js-select2 form-select" id="mx-edit-account" style="width: 100%;" data-placeholder="No account" autocomplete="off">
                <option value="">No account</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold" for="mx-edit-guest-name">Name</label>
              <input type="text" class="form-control" id="mx-edit-guest-name" maxlength="255" placeholder="Guest name" autocomplete="off" />
            </div>
          </div>
          <div class="mb-3 mt-2">
            <label class="form-label fw-bold" for="mx-edit-remark">Remark</label>
            <input type="text" class="form-control" id="mx-edit-remark" maxlength="500" placeholder="Remark" autocomplete="off" />
          </div>
          <div id="mx-edit-deposit-fields" class="d-none">
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <label class="form-label fw-bold text-nowrap" for="mx-edit-in-currency">In Currency</label>
                <select class="form-select" id="mx-edit-in-currency" autocomplete="off">
                  <option value="" selected disabled>Select currency</option>
                </select>
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label fw-bold text-nowrap" for="mx-edit-amount-in">Amount</label>
                <input type="number" class="form-control" id="mx-edit-amount-in" inputmode="decimal" min="0" step="1" placeholder="0" />
              </div>
            </div>
            <div class="row row-cols-1 row-cols-md-3 g-3 mt-1">
              <div class="col">
                <label class="form-label fw-bold text-nowrap" for="mx-edit-exchange-currency" title="Exchange currency">Exch. Curr.</label>
                <select class="form-select" id="mx-edit-exchange-currency" autocomplete="off">
                  <option value="" selected disabled>Select currency</option>
                </select>
              </div>
              <div class="col">
                <label class="form-label fw-bold text-nowrap" for="mx-edit-rate-percent">Rate</label>
                <input type="number" class="form-control" id="mx-edit-rate-percent" inputmode="decimal" step="0.01" placeholder="0.00" />
              </div>
              <div class="col">
                <label class="form-label fw-bold text-nowrap" for="mx-edit-exchange-amount" title="Auto-calculated from amount and rate; you may override">Exch. Amt.</label>
                <input type="text" class="form-control" id="mx-edit-exchange-amount" inputmode="decimal" placeholder="0.00" autocomplete="off" />
              </div>
            </div>
          </div>
          <div id="mx-edit-return-fields" class="d-none">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-bold" for="mx-edit-return-amount">Return Amount</label>
                <input type="number" class="form-control" id="mx-edit-return-amount" inputmode="decimal" min="0" step="1" placeholder="0" />
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold" for="mx-edit-margin-return">Margin</label>
                <input type="number" class="form-control" id="mx-edit-margin-return" inputmode="decimal" min="0" step="1" placeholder="0" />
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-primary" id="btn-mx-edit-txn-save">
            <i class="fa fa-save me-1"></i> Save
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-currency-master" tabindex="-1" aria-labelledby="modal-currency-master-label" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered modal-currency-master-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="modal-currency-master-label">Currency master</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mb-3">
          <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1 px-3 shadow-sm" id="btn-open-add-currency">
            <i class="fa fa-plus"></i><span>Add Currency</span>
          </button>
        </div>
        <div class="currency-master-dt-wrap table-responsive">
          <table class="table currency-master-table w-100 mb-0" id="currency-master-table">
            <thead>
              <tr>
                <th>Code</th>
                <th>Name</th>
                <th class="text-center">Status</th>
                <th class="text-end currency-master-col-actions">Actions</th>
              </tr>
            </thead>
            <tbody id="currency-master-tbody">
              <tr>
                <td colspan="4" class="text-center text-muted py-4">Open this dialog to load currencies.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-add-currency" tabindex="-1" aria-labelledby="modal-add-currency-label" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="modal-add-currency-label">Add currency</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="form-add-currency">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label" for="add-currency-code">Code</label>
            <input type="text" class="form-control" id="add-currency-code" name="txtCode" maxlength="10" placeholder="e.g. USD" autocomplete="off" required />
          </div>
          <div class="mb-3">
            <label class="form-label" for="add-currency-name">Name</label>
            <input type="text" class="form-control" id="add-currency-name" name="txtName" maxlength="64" placeholder="Display name" required />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-primary" id="btn-add-currency-save">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-edit-currency" tabindex="-1" aria-labelledby="modal-edit-currency-label" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="modal-edit-currency-label">Edit currency</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="form-edit-currency">
        <input type="hidden" id="edit-currency-id" value="" />
        <div class="modal-body">
          <input type="hidden" name="txtActive" id="edit-currency-txt-active" value="1" />
          <div class="mb-3">
            <label class="form-label" for="edit-currency-code">Code</label>
            <input type="text" class="form-control" id="edit-currency-code" name="txtCode" maxlength="10" placeholder="e.g. USD" autocomplete="off" required />
          </div>
          <div class="mb-3">
            <label class="form-label" for="edit-currency-name">Name</label>
            <input type="text" class="form-control" id="edit-currency-name" name="txtName" maxlength="64" placeholder="Display name" required />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-primary" id="btn-edit-currency-save">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  /* Child modals (Add/Edit) above parent Currency master when both are open */
  #modal-add-currency.modal.show,
  #modal-edit-currency.modal.show {
    z-index: 1060;
  }

  .modal-currency-master-dialog {
    max-width: min(96vw, 52rem);
  }

  /* Currency master table — aligned with marker / dashboard modal tables */
  #modal-currency-master .currency-master-dt-wrap {
    border-radius: 0.375rem;
  }

  #modal-currency-master .currency-master-table {
    font-size: 0.8125rem;
    line-height: 1.45;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    border: 1px solid #e2e8f0;
    border-radius: 0.375rem;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
  }

  #modal-currency-master .currency-master-table thead th {
    background: linear-gradient(180deg, #eef4ff 0%, #e8efff 100%);
    color: #1e3a5f;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid #d5e0f0 !important;
    border-color: #eef2f7 !important;
    vertical-align: middle;
  }

  #modal-currency-master .currency-master-table tbody td {
    padding: 0.65rem 0.75rem;
    color: #334155;
    border-color: #eef2f7 !important;
    vertical-align: middle;
  }

  #modal-currency-master .currency-master-table tbody td.currency-master-col-code {
    color: #0f172a;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  #modal-currency-master .currency-master-table tbody tr:nth-child(even) td {
    background-color: #fafbfd;
  }

  #modal-currency-master .currency-master-table tbody tr:nth-child(odd) td {
    background-color: #fff;
  }

  #modal-currency-master .currency-master-table tbody tr:hover td {
    background-color: #f0f6ff !important;
  }

  #modal-currency-master .currency-master-table tbody tr:hover td:first-child {
    box-shadow: inset 3px 0 0 var(--bs-primary);
  }

  #modal-currency-master .currency-master-table .currency-master-col-actions {
    white-space: nowrap;
  }

  #modal-currency-master .currency-master-table .currency-master-col-actions .btn {
    padding: 0.2rem 0.45rem;
  }

  .money-exchange-board .exchange-title {
    color: #fff;
    text-align: center;
    font-weight: 700;
    letter-spacing: 0.5px;
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 1.7rem;
  }

  .money-exchange-board .exchange-title-blue {
    background-color: #4682b4;
  }

  .money-exchange-board .exchange-title-orange {
    background-color: #E89149;
  }

  .money-exchange-board .form-label {
    margin-bottom: 6px;
  }

  /* Keep return inputs visually white even when disabled */
  .money-exchange-board #mx-return-amount:disabled,
  .money-exchange-board #mx-margin-return:disabled,
  .money-exchange-board #mx-return-remark:disabled {
    background-color: #fff;
    opacity: 1;
  }

  .money-exchange-board .exchange-history-tabs {
    border-bottom: 1px solid #e6e9f2;
  }

  .money-exchange-board .exchange-history-tabs .nav-link {
    border: none;
    color: #7f8aa3;
    font-weight: 600;
    background: transparent;
    padding: 8px 4px;
    margin-right: 24px;
    border-bottom: 2px solid transparent;
    border-radius: 0;
  }

  .money-exchange-board .exchange-history-tabs .nav-link.active {
    color: #2d5bff;
    border-bottom-color: #2d5bff;
  }

  /* History tables — base look (scoped to this page only) */
  .money-exchange-board .cage-modal-table-wrap.table-responsive {
    border-radius: 0.375rem;
  }

  .money-exchange-board table.table.cage-modal-data-table {
    font-size: 0.8125rem;
    line-height: 1.45;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: auto;
    width: 100%;
    border: 1px solid #e2e8f0;
    border-radius: 0.375rem;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
    margin-bottom: 0;
  }

  .money-exchange-board table.table.cage-modal-data-table thead th {
    background: linear-gradient(180deg, #eef4ff 0%, #e8efff 100%);
    color: #1e3a5f;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 0.65rem 0.75rem;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid #d5e0f0 !important;
    border-color: #eef2f7 !important;
  }

  .money-exchange-board table.table.cage-modal-data-table thead th.text-end,
  .money-exchange-board table.table.cage-modal-data-table tbody td.text-end {
    text-align: right !important;
    font-variant-numeric: tabular-nums;
  }

  .money-exchange-board table.table.cage-modal-data-table thead th.text-center {
    text-align: center !important;
  }

  .money-exchange-board table.table.cage-modal-data-table tbody td {
    padding: 0.65rem 0.75rem;
    color: #334155;
    border-color: #eef2f7 !important;
    vertical-align: middle;
  }

  .money-exchange-board table.table.cage-modal-data-table tbody tr:nth-child(even) td {
    background-color: #fafbfd;
  }

  .money-exchange-board table.table.cage-modal-data-table tbody tr:nth-child(odd) td {
    background-color: #fff;
  }

  .money-exchange-board table.table.cage-modal-data-table tbody tr:hover td {
    background-color: #f0f6ff !important;
  }

  /* Select2 — match dashboard marker modal */
  .money-exchange-board .select2-container .select2-selection--single {
    height: calc(1.5em + 0.75rem + 6px);
  }

  .money-exchange-board .select2-container .select2-search--inline .select2-search__field {
    margin-top: 0;
