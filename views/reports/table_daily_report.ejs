<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="container-fluid content-inner mt-4">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <h4 class="card-title mb-0">Junket Tables</h4>
          <button type="button" class="btn btn-primary" id="btn-open-add-junket-table">
            <i class="fa fa-plus me-1"></i> Add Table
          </button>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0" id="junket-tables-table">
              <thead>
                <tr>
                  <th style="width: 80px;">ID</th>
                  <th>Table Name</th>
                  <th style="width: 120px;">Status</th>
                  <th style="width: 220px;">Updated</th>
                  <th style="width: 170px;" class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody id="junket-tables-tbody">
                <tr>
                  <td colspan="5" class="text-center text-muted py-3">Loading tables...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="junket-table-modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="junket-table-modal-title">Add Table</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="junket-table-form">
        <div class="modal-body">
          <input type="hidden" id="junket-table-id" value="">
          <div class="mb-0">
            <label for="junket-table-name" class="form-label">Table Name</label>
            <input type="text" class="form-control" id="junket-table-name" maxlength="120" placeholder="Example: Table 1" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-primary" id="btn-save-junket-table">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/assets/js/functions/table_daily_report.js"></script>