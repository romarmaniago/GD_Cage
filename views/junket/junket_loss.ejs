<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="container-fluid content-inner mt-4">
  <div class="row">
    <div class="col-sm-12">
      <div class="card">
        <div id="user-role" data-permissions="<%= permissions %>"></div>
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <h3 class="card-title mb-0">
            <div class="breadcrumb1 flat">
              <a href="/dashboard"><span class="fa fa-home"></span></a>
              <a href="#"><%= __('junket_loss.junket') %></a>
              <a href="/junket_loss" class="active"><%= __('junket_loss.title') %></a>
            </div>
          </h3>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="button" id="btn-junket-loss-print" class="btn btn-sm btn-alt-success">
              <i class="fa fa-print" aria-hidden="true"></i> Print
            </button>
            <button type="button" id="btn-junket-loss-export" class="btn btn-sm btn-success">
              <i class="fa fa-file-excel" aria-hidden="true"></i> <%= __('junket_loss.export') || 'Export' %>
            </button>
            <button type="button" class="btn btn-sm btn-primary" id="btn-add-junket-loss">
              <i class="fa fa-plus me-1"></i> <%= __('junket_loss.add') || 'Add Junket Loss' %>
            </button>
          </div>
        </div>
        <div class="dataTables_wrapper">
          <div class="row mb-2">
            <div class="col-sm-4">
              <input type="text" id="junket-loss-daterange" class="input-daterange input-group" placeholder="Select date range" autocomplete="off" />
            </div>
          </div>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table id="junket-loss-tbl" class="table nowrap small-text" style="width:100%">
              <thead>
                <tr>
                  <th>Description</th>
                  <th>Amount</th>
                  <th>In-charge</th>
                  <th>Encoded By</th>
                  <th>Date &amp; Time</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-junket-loss" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="junket-loss-modal-title">Add Junket Expense</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="junket-loss-form">
        <div class="modal-body">
          <input type="hidden" id="junket-loss-id" />
          <div class="mb-3">
            <label for="junket-loss-description" class="form-label">Description</label>
            <textarea id="junket-loss-description" class="form-control" rows="3" required></textarea>
          </div>
          <div class="mb-3">
            <label for="junket-loss-amount" class="form-label">Amount</label>
            <input type="text" id="junket-loss-amount" class="form-control" inputmode="decimal" autocomplete="off" required />
          </div>
          <div class="mb-3">
            <label for="junket-loss-incharge" class="form-label">In-charge</label>
            <input type="text" id="junket-loss-incharge" class="form-control" maxlength="150" required />
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary" id="junket-loss-save-btn">Save</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include ('../partials/permission_view_only_script') %>
<%- include('../partials/footer') %>

<script>
  window.junketLossTranslations = {
    export_label: "<%= __('junket_loss.export') || 'Export' %>",
    no_data: "<%= __('junket_loss.no_data_export') || 'No data to export for the current filter.' %>",
    error: "<%= __('junket_loss.export_error') || 'Export failed' %>"
  };
</script>
<script src="/assets/js/functions/junket_loss.js"></script>

<style>
  .card-body {
    overflow-x: auto;
  }

  #junket-loss-tbl {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
  }

  #junket-loss-tbl thead th {
    background: var(--bs-primary-bg-subtle);
    color: var(--bs-primary);
    font-weight: 500;
    padding: 12px 15px;
    border: none;
  }

  #junket-loss-tbl thead th:nth-child(1),
  #junket-loss-tbl thead th:nth-child(3),
  #junket-loss-tbl thead th:nth-child(4),
  #junket-loss-tbl thead th:nth-child(5) {
    text-align: left;
    padding-left: 20px;
  }

  #junket-loss-tbl thead th:nth-child(2) {
    text-align: right;
    padding-right: 20px;
  }

  #junket-loss-tbl thead th:nth-child(6) {
    text-align: center;
  }

  #junket-loss-tbl tbody tr {
    border-bottom: 1px solid #eee;
  }

  #junket-loss-tbl td {
    padding: 12px 15px;
    color: #666;
    vertical-align: middle;
  }

  #junket-loss-tbl tbody td:nth-child(1),
  #junket-loss-tbl tbody td:nth-child(3),
  #junket-loss-tbl tbody td:nth-child(4),
  #junket-loss-tbl tbody td:nth-child(5) {
    text-align: left;
    padding-left: 20px;
  }

  #junket-loss-tbl tbody td:nth-child(2) {
    text-align: right;
    padding-right: 20px;
  }

  #junket-loss-tbl tbody tr:hover {
    background-color: #f5f5f5 !important;
  }

  #junket-loss-tbl td:last-child {
    text-align: center;
    color: #333;
  }

  .dataTables_length label {
    font-size: 0;
  }

  .dataTables_length select {
    font-size: 12px;
  }

  .dataTables_wrapper .row {
    margin-bottom: 15px;
    font-size: 12px;
  }

  .input-daterange {
    display: flex;
    justify-content: space-between;
    position: relative;
    left: 9rem;
    top: 4rem;
    max-width: 220px;
    font-size: 12px;
  }

  .input-daterange .form-control {
    flex: 1;
    margin-right: 5px;
    max-width: 100px;
    font-size: 12px;
    padding: 8px;
    text-align: center;
  }

  .input-daterange .form-control:last-child {
    margin-right: 0;
  }

  @media (max-width: 768px) {
    #junket-loss-tbl {
      font-size: 10px;
    }

    .dataTables_wrapper .row,
    .input-daterange,
    .input-daterange .form-control {
      font-size: 10px;
    }

    .input-daterange .form-control {
      padding: 5px;
    }

    #junket-loss-tbl th,
    #junket-loss-tbl td {
      padding: 5px;
    }
  }
</style>
