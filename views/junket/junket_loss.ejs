<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="container-fluid content-inner py-0">
  <div class="row">
    <div class="col-sm-12">
      <div class="card">
        <div id="user-role" data-permissions="<%= permissions %>"></div>
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <h3 class="card-title mb-0">
            <div class="breadcrumb1 flat">
              <a href="/dashboard"><span class="fa fa-home"></span></a>
              <a href="#"><%= __('junket_loss.junket') %></a>
              <a href="/loss_amount" class="active"><%= __('junket_loss.title') %></a>
            </div>
          </h3>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="button" id="btn-junket-loss-print" class="btn btn-sm btn-alt-success">
              <i class="fa fa-print" aria-hidden="true"></i> Print
            </button>
            <button type="button" id="btn-junket-loss-export" class="btn btn-sm btn-success">
              <i class="fa fa-file-excel" aria-hidden="true"></i> <%= __('junket_loss.export') || 'Export' %>
            </button>
            <button
              type="button"
              class="expense-cat-panel-add-btn js-house-expense-add-sub-cat d-none"
              id="btn-add-junket-loss"
              title="<%= __('junket_loss.add') || 'Add Loss Amount' %>"
              aria-label="<%= __('junket_loss.add') || 'Add Loss Amount' %>"
            >
              <i class="fa fa-plus" aria-hidden="true"></i>
            </button>
          </div>
        </div>
        <div class="junket-loss-filter-bar">
          <div class="junket-loss-daterange-group d-flex flex-wrap align-items-center gap-2">
            <div class="junket-loss-daterange-wrap">
              <input type="text" id="junket-loss-daterange" class="form-control form-control-sm text-center" placeholder="<%= __('junket_loss.select_date_range') || 'Select date range' %>" autocomplete="off" />
            </div>
            <%- include('../partials/split_daterange', {
              splitPrefix: 'junket-loss',
              splitLocaleNs: 'junket_loss',
              splitWrapClass: 'junket-loss-daterange-wrap junket-loss-split-daterange house-expense-split-daterange'
            }) %>
          </div>
        </div>
        <div class="card-body pt-2">
          <div class="table-responsive">
            <table id="junket-loss-tbl" class="table nowrap small-text" style="width:100%">
              <thead>
                <tr>
                  <th>Program Date</th>
                  <th>Date &amp; Time</th>
                  <th>Account</th>
                  <th>Guest</th>
                  <th>Amount</th>
                  <th>Type</th>
                  <th>Person Involved</th>
                  <th>Description</th>
                  <%# <th>Encoded By</th> %>
                  <%# <th>Action</th> %>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-junket-loss" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="junket-loss-modal-title">Add Loss Amount</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="junket-loss-form">
        <div class="modal-body">
          <%- include('../partials/junket_loss_form_fields') %>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary" id="junket-loss-save-btn">Save</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include ('../partials/permission_view_only_script') %>
<%- include('../partials/footer') %>

<script>
  window.junketLossTranslations = {
    export_label: "<%= __('junket_loss.export') || 'Export' %>",
    no_data: "<%= __('junket_loss.no_data_export') || 'No data to export for the current filter.' %>",
    error: "<%= __('junket_loss.export_error') || 'Export failed' %>"
  };
</script>
<script src="/assets/js/functions/junket_loss.js"></script>

<style>
  .card-body {
    overflow-x: auto;
  }

  #junket-loss-tbl {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
  }

  #junket-loss-tbl thead th {
    background: var(--bs-primary-bg-subtle);
    color: var(--bs-primary);
    font-weight: 500;
    padding: 12px 15px;
    border: none;
  }

  #junket-loss-tbl thead th:nth-child(5),
  #junket-loss-tbl tbody td:nth-child(5) {
    text-align: right;
    padding-right: 20px;
  }

  #junket-loss-tbl thead th:nth-child(6),
  #junket-loss-tbl tbody td:nth-child(6) {
    text-align: center;
  }

  /* Action column (when restored):
  #junket-loss-tbl thead th:nth-child(10),
  #junket-loss-tbl tbody td:nth-child(10) {
    text-align: center;
  }
  */

  #junket-loss-tbl tbody tr {
    border-bottom: 1px solid #eee;
  }

  #junket-loss-tbl td {
    padding: 12px 15px;
    color: #666;
    vertical-align: middle;
  }

  #junket-loss-tbl tbody tr:hover {
    background-color: #f5f5f5 !important;
  }

  #junket-loss-tbl td:last-child {
    text-align: left;
    color: #666;
  }

  .dataTables_length label {
    font-size: 0;
  }

  .dataTables_length select {
    font-size: 12px;
  }

  .dataTables_wrapper .row {
    margin-bottom: 15px;
    font-size: 12px;
  }

  .junket-loss-filter-bar {
    padding: 0.75rem var(--bs-card-spacer-x, 1.25rem) 0;
  }

  .junket-loss-filter-bar--modal {
    padding: 0;
  }

  .junket-loss-daterange-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .junket-loss-daterange-wrap {
    width: auto;
    min-width: 0;
    max-width: none;
    flex: 0 0 auto;
    display: inline-block;
  }

  .junket-loss-daterange-wrap .flatpickr-wrapper {
    display: inline-block;
    width: auto;
    min-width: 0;
  }

  .junket-loss-daterange-wrap input.form-control,
  .junket-loss-daterange-wrap .flatpickr-input.form-control {
    display: inline-block !important;
    position: static !important;
    left: auto !important;
    top: auto !important;
    width: auto !important;
    min-width: 10rem;
    max-width: none !important;
    margin: 0;
    overflow: visible;
    text-overflow: clip;
    white-space: nowrap;
    box-sizing: border-box;
    text-align: center;
    cursor: pointer;
  }

  .junket-loss-split-daterange,
  .house-expense-split-daterange {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    min-width: 0;
    gap: 0.5rem;
    flex-wrap: nowrap;
  }

  .junket-loss-split-daterange .flatpickr-wrapper,
  .house-expense-split-daterange .flatpickr-wrapper {
    display: inline-block;
    width: auto;
    min-width: 0;
  }

  .junket-loss-split-daterange input.split-date-input,
  .junket-loss-split-daterange .flatpickr-input.form-control,
  .house-expense-split-daterange input.split-date-input,
  .house-expense-split-daterange .flatpickr-input.form-control {
    display: inline-block;
    position: static;
    left: auto;
    top: auto;
    width: auto;
    min-width: 0;
    padding-left: 8px;
    padding-right: 8px;
    max-width: none;
    margin: 0;
    overflow: visible;
    text-overflow: clip;
    white-space: nowrap;
    box-sizing: border-box;
    cursor: pointer;
    text-align: center;
    field-sizing: content;
  }

  #btn-add-junket-loss.expense-cat-panel-add-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: #fff;
    color: var(--bs-primary);
    line-height: 1;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }

  #btn-add-junket-loss.expense-cat-panel-add-btn i.fa {
    font-size: 1rem;
  }

  #btn-add-junket-loss.expense-cat-panel-add-btn:hover:not(:disabled) {
    background: var(--bs-primary);
    color: #fff;
  }

  #junket-loss-tbl_wrapper .junket-loss-controls-highlight {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    margin-bottom: -1px;
    background: #E8EAFB;
    border: 1px solid #D5DAF6;
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
  }

  #junket-loss-tbl_wrapper .junket-loss-controls-highlight .dataTables_length {
    margin-top: 4px;
  }

  #junket-loss-tbl_wrapper .junket-loss-controls-highlight .dataTables_filter {
    margin: 0 0 0 auto;
  }

  #junket-loss-tbl_wrapper #junket-loss-tbl_filter .junket-loss-filter-highlight {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 2px 6px;
    background: rgba(255, 255, 255, 0.35);
    border: none;
    border-radius: 10px;
  }

  #junket-loss-tbl_wrapper #junket-loss-tbl_filter .junket-loss-filter-highlight label {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  #junket-loss-tbl_wrapper #junket-loss-tbl_filter .junket-loss-filter-highlight label input {
    margin-left: 0;
    border: none;
    outline: none;
    box-shadow: none;
    background: #fff;
  }

  #junket-loss-tbl_wrapper #junket-loss-tbl {
    margin-top: 0 !important;
  }

  .flatpickr-calendar .cur-month {
    cursor: pointer;
  }

  .flatpickr-calendar .cur-month:hover {
    text-decoration: underline;
  }

  #junket-loss-tbl_wrapper .dataTables_length,
  #junket-loss-tbl_wrapper .dataTables_filter {
    padding-left: 0;
    padding-right: 0;
  }

  @media (max-width: 768px) {
    #junket-loss-tbl {
      font-size: 10px;
    }

    .dataTables_wrapper .row,
    .junket-loss-daterange-wrap input.form-control {
      font-size: 10px;
    }

    #junket-loss-tbl th,
    #junket-loss-tbl td {
      padding: 5px;
    }
  }
</style>

<script>
  (function () {
    function applyJunketLossControlsLayout() {
      var wrapper = document.getElementById('junket-loss-tbl_wrapper');
      var lengthWrap = document.getElementById('junket-loss-tbl_length');
      var filterWrap = document.getElementById('junket-loss-tbl_filter');
      var searchLabel = filterWrap ? filterWrap.querySelector('label') : null;
      var addBtn = document.getElementById('btn-add-junket-loss');
      var controlsHighlight;
      var filterHighlight;

      if (!wrapper || !lengthWrap || !filterWrap || !searchLabel) return;

      controlsHighlight = wrapper.querySelector('.junket-loss-controls-highlight');
      if (!controlsHighlight) {
        controlsHighlight = document.createElement('div');
        controlsHighlight.className = 'junket-loss-controls-highlight';
        wrapper.insertBefore(controlsHighlight, wrapper.firstChild);
      }
      if (lengthWrap.parentElement !== controlsHighlight) {
        controlsHighlight.appendChild(lengthWrap);
      }
      if (filterWrap.parentElement !== controlsHighlight) {
        controlsHighlight.appendChild(filterWrap);
      }

      filterHighlight = filterWrap.querySelector('.junket-loss-filter-highlight');
      if (!filterHighlight) {
        filterHighlight = document.createElement('div');
        filterHighlight.className = 'junket-loss-filter-highlight';
        filterWrap.appendChild(filterHighlight);
      }

      if (addBtn && addBtn.parentElement !== filterHighlight) {
        filterHighlight.appendChild(addBtn);
      }
      if (searchLabel.parentElement !== filterHighlight) {
        filterHighlight.appendChild(searchLabel);
      }
      if (addBtn) addBtn.classList.remove('d-none');
    }

    if (window.jQuery) {
      $(document).on('init.dt draw.dt', '#junket-loss-tbl', applyJunketLossControlsLayout);
      $(applyJunketLossControlsLayout);
    } else {
      document.addEventListener('DOMContentLoaded', function () {
        setTimeout(applyJunketLossControlsLayout, 0);
      });
    }
  })();
</script>
