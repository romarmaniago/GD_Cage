<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="container-fluid content-inner mt-4">
  <div class="row">
    <div class="col-sm-12">
      <div class="card">
        <div id="user-role" data-permissions="<%= permissions %>"></div>
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <h3 class="card-title mb-0">
            <div class="breadcrumb1 flat">
              <a href="/dashboard"><span class="fa fa-home"></span></a>
              <a href="/multipurpose_ledger" class="active">Multipurpose Ledger</a>
            </div>
          </h3>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="button" class="btn btn-sm btn-primary" id="btn-add-jfl">
              <i class="fa fa-plus me-1"></i> New Record
            </button>
            <button type="button" id="btn-jfl-print" class="btn btn-sm btn-alt-success">
              <i class="fa fa-print" aria-hidden="true"></i> Print
            </button>
            <button type="button" id="btn-jfl-export" class="btn btn-sm btn-success">
              <i class="fa fa-file-excel" aria-hidden="true"></i> Export
            </button>
           
          </div>
        </div>
        <div class="card-body pb-0">
          <div class="row g-3 mb-3">
            <div class="col-md-5 col-lg-3">
              <div class="jfl-balance-banner text-center">
                <div class="jfl-balance-label">Junket funds balance</div>
                <div class="jfl-balance-value" id="jfl-funds-balance">—</div>
              </div>
            </div>
          </div>
        </div>
        <div class="card-body pt-0">
          <div class="table-responsive">
            <table id="jfl-tbl" class="table nowrap small-text" style="width:100%">
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Account</th>
                  <th>Amount</th>
                  <th>In charge</th>
                  <th>Remarks</th>
                  <th>Processed by</th>
                  <th>Date &amp; time</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-jfl" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-md">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="jfl-modal-title">New Record</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="jfl-form">
        <div class="modal-body">
          <input type="hidden" id="jfl-id" />
          <div class="row g-3">
            <div class="col-12">
              <div class="jfl-balance-banner text-center">
                <div class="jfl-balance-label">Available junket funds balance</div>
                <div class="jfl-balance-value" id="jfl-modal-balance">—</div>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">Transaction</label>
              <div class="d-flex flex-wrap gap-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="jfl-trans-type" id="jfl-type-deposit" value="1" />
                  <label class="form-check-label" for="jfl-type-deposit">Deposit</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="jfl-trans-type" id="jfl-type-withdrawal" value="2" />
                  <label class="form-check-label" for="jfl-type-withdrawal">Withdrawal</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="jfl-trans-type" id="jfl-type-transfer" value="transfer" />
                  <label class="form-check-label" for="jfl-type-transfer">Transfer</label>
                </div>
              </div>
            </div>
            <div class="col-12 d-none" id="jfl-account-wrap">
              <label for="jfl-account" class="form-label">Account</label>
              <select id="jfl-account" class="form-select" data-placeholder="Select account"></select>
            </div>
            <div class="col-12">
              <label for="jfl-amount" class="form-label">Amount</label>
              <input type="text" id="jfl-amount" class="form-control" inputmode="decimal" autocomplete="off" required />
            </div>
            <div class="col-12">
              <label for="jfl-incharge" class="form-label">In charge</label>
              <input type="text" id="jfl-incharge" class="form-control" maxlength="150" required placeholder="Person in charge" />
            </div>
            <div class="col-12">
              <label for="jfl-remarks" class="form-label">Remarks</label>
              <textarea id="jfl-remarks" class="form-control" rows="2" maxlength="2000" required></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary" id="jfl-save-btn">Save</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include ('../partials/permission_view_only_script') %>
<%- include('../partials/footer') %>

<script>
  window.jflTranslations = {
    export_label: 'Export',
    no_data: 'No data to export for the current filter.',
    error: 'Export failed',
    add: 'New Entry'
  };
</script>
<script src="/assets/js/functions/multipurpose_ledger.js"></script>

<style>
  #jfl-tbl {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
  }
  #jfl-tbl thead th {
    background: var(--bs-primary-bg-subtle);
    color: var(--bs-primary);
    font-weight: 500;
    padding: 12px 15px;
    border: none;
  }
  #jfl-tbl tbody tr {
    border-bottom: 1px solid #eee;
  }
  #jfl-tbl td {
    padding: 12px 15px;
    color: #666;
    vertical-align: top;
  }
  #jfl-tbl tbody tr:hover {
    background-color: #f5f5f5 !important;
  }
  .jfl-amount-in {
    color: #198754;
    font-weight: 600;
  }
  .jfl-amount-out {
    color: #dc3545;
    font-weight: 600;
  }
  .jfl-amount-transfer {
    color: #0d6efd;
    font-weight: 600;
  }
  .jfl-balance-banner {
    background: var(--bs-primary-bg-subtle);
    border: 1px solid rgba(var(--bs-primary-rgb), 0.25);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
  }
  .jfl-balance-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--bs-primary);
    opacity: 0.9;
    margin-bottom: 0.35rem;
  }
  .jfl-balance-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--bs-primary);
    line-height: 1.2;
    letter-spacing: 0.02em;
  }
  #modal-jfl .select2-container .select2-selection--single {
    height: calc(1.5em + 0.75rem + 2px);
    min-height: calc(1.5em + 0.75rem + 2px);
  }
  #modal-jfl .select2-container--default .select2-selection--single {
    border-color: #dee2e6;
    border-radius: 0.375rem;
  }
  #modal-jfl .select2-container--default .select2-selection--single .select2-selection__rendered {
    display: flex;
    align-items: center;
    padding-left: 0.75rem;
    height: calc(1.5em + 0.75rem + 2px);
    line-height: 1.5;
  }
  #modal-jfl .select2-container--default .select2-selection--single .select2-selection__arrow {
    height: calc(1.5em + 0.75rem + 2px);
  }
  #modal-jfl .select2-container--default .select2-selection--single .select2-selection__placeholder {
    color: #8a92a6;
  }
</style>
