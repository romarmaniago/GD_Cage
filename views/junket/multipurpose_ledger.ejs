<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>
<% var jflPhpCur = (typeof currencies !== 'undefined' && currencies) ? currencies.find(function (c) { return String(c.code || '').toUpperCase() === 'PHP'; }) : null; %>

<div class="container-fluid content-inner mt-4">
  <div class="row">
    <div class="col-sm-12">
      <div class="card">
        <div id="user-role" data-permissions="<%= permissions %>" data-php-currency-id="<%= jflPhpCur ? jflPhpCur.id : '' %>"></div>
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <h3 class="card-title mb-0">
            <div class="breadcrumb1 flat">
              <a href="/dashboard"><span class="fa fa-home"></span></a>
              <a href="/multipurpose_ledger" class="active">Multipurpose Ledger</a>
            </div>
          </h3>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="button" class="btn btn-sm" id="btn-jfl-money-exchange" style="background-color:#E89149;border-color:#d67d35;color:#fff;">
              <i class="fa fa-exchange me-1"></i> Money Exchange
            </button>
            <button type="button" id="btn-jfl-print" class="btn btn-sm btn-alt-success">
              <i class="fa fa-print" aria-hidden="true"></i> Print
            </button>
            <button type="button" id="btn-jfl-export" class="btn btn-sm btn-success">
              <i class="fa fa-file-excel" aria-hidden="true"></i> Export
            </button>
          </div>
        </div>
        <div class="card-body pb-0">
          <div class="row g-4 mb-3" id="jfl-balance-row">
            <div class="col-12 text-muted small py-2">Loading balances…</div>
          </div>
        </div>
        <div class="card-body pt-0 jfl-page">
          <div class="marker-balance-dt-wrap marker-balance-card table-responsive">
            <button
              type="button"
              class="expense-cat-panel-add-btn js-jfl-add d-none"
              id="btn-add-jfl"
              title="New Record"
              aria-label="New Record"
              data-view-only-disable
            >
              <i class="fa fa-plus" aria-hidden="true"></i>
            </button>
            <table id="jfl-tbl" class="table marker-balance-tbl w-100 mb-0">
              <thead>
                <tr>
                  <th>Date and Time</th>
                  <th>Account</th>
                  <th>Guest</th>
                  <th>Type</th>
                  <th>Currency</th>
                  <th>Amount</th>
                  <th>Approved By</th>
                  <th>Remarks</th>
                  <th class="text-center">Action</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-jfl" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-md">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <h5 class="modal-title text-white" id="jfl-modal-title">New Record</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="jfl-form">
        <div class="modal-body">
          <input type="hidden" id="jfl-id" />
          <div class="row g-3">
            <div class="col-12">
              <div class="jfl-balance-banner text-center">
                <div class="jfl-balance-label">Available Balance</div>
                <div class="jfl-modal-balance-list" id="jfl-modal-balance">—</div>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">Transaction</label>
              <div class="d-flex flex-wrap gap-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="jfl-trans-type" id="jfl-type-deposit" value="1" />
                  <label class="form-check-label" for="jfl-type-deposit">Deposit</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="jfl-trans-type" id="jfl-type-withdrawal" value="2" />
                  <label class="form-check-label" for="jfl-type-withdrawal">Withdrawal</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="jfl-trans-type" id="jfl-type-transfer" value="3" />
                  <label class="form-check-label" for="jfl-type-transfer">Transfer</label>
                </div>
              </div>
            </div>
            <div class="col-12 d-none" id="jfl-currency-wrap">
              <label class="form-label">Currency</label>
              <div class="d-flex flex-wrap gap-3">
                <% if (typeof currencies !== 'undefined' && currencies && currencies.length) { %>
                  <% currencies.forEach(function (c) { %>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="jfl-currency" id="jfl-currency-<%= c.id %>" value="<%= c.id %>" data-code="<%= c.code %>" />
                      <label class="form-check-label" for="jfl-currency-<%= c.id %>"><%= c.code %></label>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>
            <div class="col-12 d-none" id="jfl-account-wrap">
              <label for="jfl-account" class="form-label">Account</label>
              <select id="jfl-account" class="form-select" data-placeholder="Select account"></select>
            </div>
            <div class="col-12">
              <label for="jfl-amount" class="form-label">Amount</label>
              <input type="text" id="jfl-amount" class="form-control" inputmode="decimal" autocomplete="off" required />
            </div>
            <div class="col-12">
              <label for="jfl-incharge" class="form-label">Approved By</label>
              <input type="text" id="jfl-incharge" class="form-control" maxlength="150" required placeholder="Approved by" />
            </div>
            <div class="col-12">
              <label for="jfl-remarks" class="form-label">Remarks</label>
              <textarea id="jfl-remarks" class="form-control" rows="2" maxlength="2000" required></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary" id="jfl-save-btn">Save</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-jfl-exchange" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <div>
          <h5 class="modal-title text-white mb-0">Money Exchange</h5>
          <div class="text-white-50 small">Multipurpose Ledger</div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body jfl-exchange-board">
        <div class="jfl-balance-banner text-center mb-3">
          <div class="jfl-balance-label">Available Balance (In Currency)</div>
          <div class="jflx-balance-list" id="jflx-modal-balance">—</div>
        </div>

        <div class="exchange-title exchange-title-blue">DEPOSIT</div>
        <div class="row g-3 mt-1">
          <div class="col-md-3">
            <label class="form-label fw-bold" for="jflx-account">Account</label>
            <select class="form-select" id="jflx-account" data-placeholder="No account">
              <option value="">No account</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold" for="jflx-guest-name">Guest</label>
            <select class="form-select" id="jflx-guest-name" data-placeholder="Select guest">
              <option value="">Select guest</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold" for="jflx-incharge">Approved By</label>
            <input type="text" class="form-control" id="jflx-incharge" maxlength="150" placeholder="Approved by" required />
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold" for="jflx-remark">Remark</label>
            <input type="text" class="form-control" id="jflx-remark" maxlength="500" placeholder="Remark" autocomplete="off" />
          </div>
        </div>
        <div class="row g-3 mt-1">
          <div class="col-md-6">
            <label class="form-label fw-bold" for="jflx-in-currency">In Currency</label>
            <select class="form-select" id="jflx-in-currency">
              <option value="" selected disabled>Select currency</option>
              <% if (typeof currencies !== 'undefined' && currencies && currencies.length) { %>
                <% currencies.forEach(function (c) { %>
                  <option value="<%= c.id %>"><%= c.code %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold" for="jflx-amount-in">Amount</label>
            <input type="text" class="form-control" id="jflx-amount-in" inputmode="numeric" placeholder="0" />
          </div>
        </div>
        <div class="row row-cols-1 row-cols-md-3 g-3 mt-1">
          <div class="col">
            <label class="form-label fw-bold" for="jflx-exchange-currency">Exchange Currency</label>
            <select class="form-select" id="jflx-exchange-currency">
              <option value="" selected disabled>Select currency</option>
              <% if (typeof currencies !== 'undefined' && currencies && currencies.length) { %>
                <% currencies.forEach(function (c) { %>
                  <option value="<%= c.id %>"><%= c.code %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="col">
            <label class="form-label fw-bold" for="jflx-rate-percent">Rate</label>
            <input type="number" class="form-control" id="jflx-rate-percent" inputmode="decimal" step="0.01" placeholder="0.00" />
          </div>
          <div class="col">
            <label class="form-label fw-bold" for="jflx-exchange-amount">Exchange Amount</label>
            <input type="text" class="form-control" id="jflx-exchange-amount" inputmode="decimal" placeholder="0.00" autocomplete="off" />
          </div>
        </div>
        <div class="row mt-2">
          <div class="col-12 text-end">
            <button type="button" class="btn btn-primary px-4" id="btn-jflx-save-deposit">
              <i class="fa fa-save me-1"></i> Save Deposit
            </button>
          </div>
        </div>

        <div class="exchange-title exchange-title-orange mt-4">RETURN</div>
        <input type="hidden" id="jflx-source-deposit-id" value="" />
        <div id="jflx-source-deposit-note" class="small text-muted mt-2 mb-1">Select a deposit to return.</div>
        <div class="row g-3 mt-1">
          <div class="col-md-3">
            <label class="form-label fw-bold" for="jflx-return-amount">Return Amount</label>
            <input type="text" class="form-control" id="jflx-return-amount" inputmode="numeric" placeholder="0" disabled />
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold" for="jflx-margin-return">Margin</label>
            <input type="text" class="form-control" id="jflx-margin-return" placeholder="0" disabled readonly tabindex="-1" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold" for="jflx-return-remark">Remark</label>
            <input type="text" class="form-control" id="jflx-return-remark" maxlength="500" placeholder="Remark" disabled />
          </div>
        </div>
        <div class="row mt-2">
          <div class="col-12 text-end">
            <button type="button" class="btn btn-primary px-4" id="btn-jflx-save-return" style="background-color:#E89149;border-color:#d67d35;" disabled>
              <i class="fa fa-save me-1"></i> Save Return
            </button>
          </div>
        </div>

        <div class="exchange-history mt-4 jfl-page">
          <div class="mb-2 fw-bold" style="color:var(--gd-marker-gold-text,#3a2e12);">Deposit History</div>
          <div class="marker-balance-dt-wrap marker-balance-card table-responsive">
            <table id="jflx-deposit-history-tbl" class="table marker-balance-tbl w-100 mb-0 align-middle jflx-history-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Date</th>
                  <th>Account</th>
                  <th>Name</th>
                  <th>In Cur</th>
                  <th>Amount</th>
                  <th>Exch Cur</th>
                  <th>Rate</th>
                  <th>Exch Amount</th>
                  <th>Status</th>
                  <th>Remark</th>
                </tr>
              </thead>
              <tbody id="jflx-deposit-history-tbody">
                <tr><td colspan="11" class="text-center text-muted py-3">Loading…</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-jflx-return-details" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary">
        <div>
          <h5 class="modal-title text-white mb-0">Return History</h5>
          <div class="text-white-50 small" id="jflx-ret-header-meta">Deposit #—</div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-2"><strong>Return Date/Time</strong><div id="jflx-ret-detail-datetime">—</div></div>
        <div class="mb-2"><strong>Return Amount</strong><div id="jflx-ret-detail-amount">—</div></div>
        <div class="mb-2"><strong>Margin</strong><div id="jflx-ret-detail-margin">—</div></div>
        <div class="mb-0"><strong>Remark</strong><div id="jflx-ret-detail-remark">—</div></div>
      </div>
    </div>
  </div>
</div>

<%- include ('../partials/permission_view_only_script') %>
<%- include('../partials/footer') %>

<script>
  window.jflTranslations = {
    export_label: 'Export',
    no_data: 'No data to export for the current filter.',
    error: 'Export failed',
    add: 'New Record'
  };
  (function () {
    var el = document.getElementById('user-role');
    var raw = el && el.getAttribute('data-php-currency-id');
    window.jflPhpCurrencyId = raw ? Number(raw) : null;
  })();
</script>
<script src="/assets/js/functions/multipurpose_ledger.js"></script>
<script src="/assets/js/functions/multipurpose_ledger_exchange.js"></script>

<style>
  /* GD gold table theme — matches markerHistory */
  .jfl-page {
    --gd-marker-gold-solid: #d9b96a;
    --gd-marker-gold-text: #3a2e12;
    --gd-marker-gold-border: rgba(58, 46, 18, 0.25);
    --gd-marker-gold-hover: #faf3dc;
  }

  .jfl-page table.dataTable {
    border-collapse: collapse !important;
    border-spacing: 0 !important;
  }
  .jfl-page table thead tr,
  .jfl-page table tfoot tr {
    background-color: var(--gd-marker-gold-solid);
  }
  .jfl-page table thead th,
  .jfl-page table tfoot th {
    background: transparent !important;
    background-color: transparent !important;
    border-left: 0 !important;
    border-right: 0 !important;
    border-top: 0 !important;
    box-shadow: none !important;
  }
  .jfl-page table.dataTable thead > tr > th.sorting,
  .jfl-page table.dataTable thead > tr > th.sorting_asc,
  .jfl-page table.dataTable thead > tr > th.sorting_desc,
  .jfl-page table.dataTable thead > tr > th.sorting_disabled {
    background: transparent !important;
    background-color: transparent !important;
  }

  #jfl-tbl {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
    border: 1px solid var(--gd-marker-gold-border);
  }
  #jfl-tbl thead th {
    color: var(--gd-marker-gold-text);
    font-weight: 600;
    padding: 12px 15px;
    border: none;
    border-bottom: 1px solid var(--gd-marker-gold-border);
  }
  #jfl-tbl tbody tr {
    border-bottom: 1px solid #eee;
  }
  #jfl-tbl tbody tr:nth-child(even) td {
    background-color: #fbf5e4;
  }
  #jfl-tbl td {
    padding: 12px 15px;
    color: #666;
    vertical-align: top;
  }
  #jfl-tbl tbody tr:hover,
  #jfl-tbl tbody tr:hover td {
    background-color: var(--gd-marker-gold-hover) !important;
  }
  .jfl-amount-in {
    color: #198754;
    font-weight: 600;
  }
  .jfl-amount-out {
    color: #dc3545;
    font-weight: 600;
  }
  .jfl-amount-transfer {
    color: #0d6efd;
    font-weight: 600;
  }
  .jfl-amount-exchange {
    color: #e89149;
    font-weight: 600;
  }
  .jfl-exchange-amounts {
    line-height: 1.35;
    white-space: nowrap;
  }
  .jfl-balance-banner {
    background: var(--bs-primary-bg-subtle);
    border: 1px solid rgba(var(--bs-primary-rgb), 0.25);
    border-radius: 0.5rem;
    padding: 0.85rem 1rem;
    height: 100%;
  }
  .jfl-balance-card .jfl-balance-value {
    font-size: 1.35rem;
  }
  #jfl-balance-row .jfl-page-balance-strip {
    padding: 1rem 1.75rem;
  }
  #jfl-balance-row .jfl-page-balance-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: flex-start;
    width: 100%;
    gap: 1.25rem 4rem;
  }
  #jfl-balance-row .jfl-page-balance-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.35rem 1.25rem;
    min-width: 8rem;
  }
  #jfl-balance-row .jfl-page-balance-code {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--bs-primary);
    opacity: 0.9;
    margin-bottom: 0.45rem;
  }
  #jfl-balance-row .jfl-page-balance-amt {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--bs-primary);
    line-height: 1.25;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .jfl-balance-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--bs-primary);
    opacity: 0.9;
    margin-bottom: 0.35rem;
  }
  .jfl-balance-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--bs-primary);
    line-height: 1.2;
    letter-spacing: 0.02em;
  }
  #modal-jfl .jfl-modal-balance-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;
    width: 100%;
    gap: 1rem 3rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--bs-primary);
    line-height: 1.35;
    padding: 0.25rem 0.75rem 0;
  }
  #modal-jfl .jfl-modal-balance-item {
    white-space: nowrap;
    letter-spacing: 0.02em;
    padding: 0 0.5rem;
  }
  #modal-jfl .select2-container .select2-selection--single {
    height: calc(1.5em + 0.75rem + 2px);
    min-height: calc(1.5em + 0.75rem + 2px);
  }
  #modal-jfl .select2-container--default .select2-selection--single {
    border-color: #dee2e6;
    border-radius: 0.375rem;
  }
  #modal-jfl .select2-container--default .select2-selection--single .select2-selection__rendered {
    display: flex;
    align-items: center;
    padding-left: 0.75rem;
    height: calc(1.5em + 0.75rem + 2px);
    line-height: 1.5;
  }
  #modal-jfl .select2-container--default .select2-selection--single .select2-selection__arrow {
    height: calc(1.5em + 0.75rem + 2px);
  }
  #modal-jfl .select2-container--default .select2-selection--single .select2-selection__placeholder {
    color: #8a92a6;
  }
  #modal-jfl-exchange .modal-dialog {
    max-width: 1320px;
  }
  #modal-jfl-exchange .jflx-balance-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;
    width: 100%;
    gap: 1rem 4rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--bs-primary);
    line-height: 1.35;
    padding: 0.35rem 1.5rem 0.15rem;
  }
  #modal-jfl-exchange .jflx-balance-item {
    white-space: nowrap;
    letter-spacing: 0.02em;
    padding: 0 0.75rem;
  }
  #modal-jfl-exchange .jfl-balance-label {
    font-size: 0.75rem;
  }
  .jfl-exchange-board .exchange-title {
    color: #fff;
    text-align: center;
    font-weight: 700;
    letter-spacing: 0.5px;
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 1.25rem;
  }
  .jfl-exchange-board .exchange-title-blue {
    background-color: #4682b4;
  }
  .jfl-exchange-board .exchange-title-orange {
    background-color: #E89149;
  }
  .jfl-exchange-board #jflx-return-amount:disabled,
  .jfl-exchange-board #jflx-margin-return:disabled,
  .jfl-exchange-board #jflx-return-remark:disabled {
    background-color: #fff;
    opacity: 1;
  }
  .jflx-history-table {
    border: 1px solid var(--gd-marker-gold-border, rgba(58, 46, 18, 0.25));
    font-size: 13px;
  }
  .jflx-history-table thead th {
    color: var(--gd-marker-gold-text, #3a2e12);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 12px 15px;
    border: none;
    border-bottom: 1px solid var(--gd-marker-gold-border, rgba(58, 46, 18, 0.25));
  }
  .jflx-history-table tbody tr {
    border-bottom: 1px solid #eee;
  }
  .jflx-history-table tbody tr:nth-child(even) td {
    background-color: #fbf5e4;
  }
  .jflx-history-table tbody td {
    padding: 12px 15px;
    color: #666;
  }
  .jflx-history-table tbody tr:hover,
  .jflx-history-table tbody tr:hover td {
    background-color: var(--gd-marker-gold-hover, #faf3dc) !important;
  }
  .jflx-status-returned {
    background: #e89149;
    color: #fff;
    border: none;
    border-radius: 0.375rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.75rem;
  }
  #modal-jfl-exchange .select2-container .select2-selection--single {
    height: calc(1.5em + 0.75rem + 2px);
    min-height: calc(1.5em + 0.75rem + 2px);
  }
  #modal-jfl-exchange #jflx-guest-name + .select2-container .select2-selection--single {
    height: calc(1.5em + 0.75rem + 2px);
