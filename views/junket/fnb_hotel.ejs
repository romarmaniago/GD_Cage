	color: #fff;
	border-color: var(--bs-primary);
}

#btn-fnb-hotel-new-record.expense-cat-panel-add-btn:disabled {
	opacity: 0.45;
	cursor: not-allowed;
}

#fnb-hotel-table_wrapper .fnb-hotel-controls-highlight {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	padding: 8px 12px;
	margin-bottom: 0;
