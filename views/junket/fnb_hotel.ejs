	padding: 2px 6px;
	background: rgba(255, 255, 255, 0.35);
	border: 1px solid rgba(213, 218, 246, 0.9);
	border-radius: 10px;
}

#fnb-hotel-table_filter .fnb-hotel-filter-highlight label {
	margin: 0;
	display: inline-flex;
	align-items: center;
}

#fnb-hotel-table_filter .fnb-hotel-filter-highlight label input {
	margin-left: 0;
}

</style>
