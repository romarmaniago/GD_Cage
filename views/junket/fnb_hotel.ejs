<script>
	(function () {
		function moveNewRecordButtonBesideSearch() {
			var wrapper = document.getElementById('fnb-hotel-table_wrapper');
			var lengthWrap = document.getElementById('fnb-hotel-table_length');
			var filterWrap = document.getElementById('fnb-hotel-table_filter');
			var searchLabel = filterWrap ? filterWrap.querySelector('label') : null;
			var addBtn = document.getElementById('btn-fnb-hotel-new-record');
			var controlsHighlight;
			var highlightBox;
			if (!wrapper || !lengthWrap || !filterWrap || !searchLabel) return;

			controlsHighlight = wrapper.querySelector('.fnb-hotel-controls-highlight');
			if (!controlsHighlight) {
				controlsHighlight = document.createElement('div');
				controlsHighlight.className = 'fnb-hotel-controls-highlight';
				wrapper.insertBefore(controlsHighlight, wrapper.firstChild);
			}
			if (lengthWrap.parentElement !== controlsHighlight || controlsHighlight.firstElementChild !== lengthWrap) {
				controlsHighlight.insertBefore(lengthWrap, controlsHighlight.firstChild);
			}
			if (filterWrap.parentElement !== controlsHighlight) {
				controlsHighlight.appendChild(filterWrap);
			}

			highlightBox = filterWrap.querySelector('.fnb-hotel-filter-highlight');
			if (!highlightBox) {
				highlightBox = document.createElement('div');
				highlightBox.className = 'fnb-hotel-filter-highlight';
				filterWrap.appendChild(highlightBox);
			}
			if (addBtn && (addBtn.parentElement !== highlightBox || highlightBox.firstElementChild !== addBtn)) {
				highlightBox.insertBefore(addBtn, highlightBox.firstChild);
				addBtn.classList.remove('d-none');
			}
			if (searchLabel.parentElement !== highlightBox) {
				highlightBox.appendChild(searchLabel);
			}
		}

		if (window.jQuery) {
			$(document).on('init.dt draw.dt', '#fnb-hotel-table', moveNewRecordButtonBesideSearch);
			$(moveNewRecordButtonBesideSearch);
		} else {
			document.addEventListener('DOMContentLoaded', function () {
				setTimeout(moveNewRecordButtonBesideSearch, 0);
			});
		}
	})();
</script>
