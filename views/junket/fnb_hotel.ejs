#fnb-hotel-table_wrapper .dataTables_scroll,
#fnb-hotel-table_wrapper .dataTables_scrollHead,
#fnb-hotel-table_wrapper .dataTables_scrollHeadInner,
#fnb-hotel-table_wrapper table.dataTable {
