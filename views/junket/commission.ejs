							<a href="/commission" class="active"><%= __('commission.commission') %></a>
							<!-- <a href="/commission_settlement"><%= __('commission_settlement.title') %></a> -->
							<a href="/commission_analytics">Analytics</a>
							
						</div>
					</h3>
					<div class="d-flex flex-wrap gap-2 align-items-center">
						<%- include('../partials/commission_toolbar') %>
					</div>
				</div>
				<div class="card-body pt-2 commission-panel-body">
					<%- include('../partials/commission_table_body') %>
