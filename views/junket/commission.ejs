<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include ('../partials/sidebar'); -%>
<%- include ('../partials/topbar'); -%>


  <!-- Include jQuery -->
 
<!-- Main Container -->		
	<div class="container-fluid content-inner py-0">
		<div class="row">
			<div class="col-sm-12">
				<div class="card">
					<div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
						<h3 class="card-title mb-0">
							<div class="breadcrumb1 flat">
							<a href="/dashboard" ><span class="fa fa-home"></span></a>
							<a href="#" ><%= __('commission.junket') %></a>
							<a href="/commission"class="active"><%= __('commission.commission') %></a>
							<a href="/commission_analytics">Analytics</a>
							</div>
						</h3>
						<div class="d-flex flex-wrap gap-2 align-items-center">
							<button type="button" id="btn-commission-print" class="btn btn-sm btn-alt-success">
								<i class="fa fa-print" aria-hidden="true"></i> Print
							</button>
							<button type="button" id="btn-commission-export" class="btn btn-sm btn-success">
								<i class="fa fa-file-excel" aria-hidden="true"></i> <%= __('commission.export') || 'Export' %>
							</button>
						</div>
					</div>
					<div class="commission-page-filters px-3 pb-0">
						<div id="commission-compare-bar" class="commission-compare-bar d-none mt-2 mb-2">
							<div class="d-flex flex-wrap align-items-center gap-2">
								<span class="small text-muted commission-compare-label"><%= __('commission.compare_selected') %>:</span>
								<div id="commission-compare-chips" class="d-flex flex-wrap gap-1"></div>
								<div class="ms-auto d-flex flex-wrap gap-2">
									<button type="button" id="btn-commission-compare-clear" class="btn btn-sm btn-outline-secondary"><%= __('commission.compare_clear') %></button>
									<button type="button" id="btn-commission-compare-confirm" class="btn btn-sm btn-primary" disabled><%= __('commission.compare_confirm') %></button>
								</div>
							</div>
							<p class="small text-muted mb-0 mt-1"><%= __('commission.compare_hint') %></p>
						</div>
					</div>
					<div class="card-body pt-2">
						<div id="commission-daterange-mount" class="commission-daterange-mount">
							<div class="commission-daterange-wrap">
								<input type="text" id="daterange" class="form-control form-control-sm" placeholder="<%= __('commission.select_date_range') %>" autocomplete="off"/>
							</div>
						</div>
								<!-- DataTables init on table by adding .js-dataTable-responsive class, functionality is initialized in js/pages/be_tables_datatables.min.js which was auto compiled from _js/pages/be_tables_datatables.js -->
								<table id="commission-tbl" class="table  nowrap small-text" style="width:100%">
									<thead>
										<tr>
										<th class="commission-compare-col text-center" style="width: 42px;" title="<%= __('commission.compare_hint') %>">
											<i class="fa fa-check-square-o" aria-hidden="true"></i>
										</th>
										<th class="d-none d-sm-table-cell" style="width: 75px;"><%= __('commission.game_no') %></th>
										<th class="d-none d-sm-table-cell"><%= __('commission.account_name') %></th>
										<th class="d-none d-sm-table-cell"><%= __('commission.total_buyin') %></th>
										<th class="d-none d-sm-table-cell"><%= __('commission.chips_return') %></th>
										<th class="d-none d-sm-table-cell"><%= __('commission.win_loss') %></th>
										<th class="d-none d-sm-table-cell"><%= __('commission.total_rolling') %></th>
										<th class="d-none d-sm-table-cell"><%= __('commission.rolling_rate') %></th>
										<th class="d-none d-sm-table-cell"><%= __('commission.settlement') %></th>
										<th class="d-none d-sm-table-cell"><%= __('commission.fb') %></th>
										<th class="d-none d-sm-table-cell"><%= __('commission.payment') %></th>
										<th class="d-none d-sm-table-cell commission-date-sort-col"><%= __('commission.date_time') %></th>
										</tr>
									</thead>
									<tbody>
									</tbody>
									<tfoot>
										<tr>
										<th></th>
										<th></th>
										<th><%= __('commission.grand_total') %></th>
										<th id="GRAND_TOTAL_AMOUNT">0.00</th>
										<th id="GRAND_CHIPS_RETURN">0.00</th>
										<th id="GRAND_WIN_LOSS">0.00</th>
										<th id="GRAND_TOTAL_ROLLING">0.00</th>
										<th></th>
										<th id="GRAND_ROLLING_SETTLEMENT">0.00</th>
										<th id="GRAND_FNB">0.00</th>
										<th id="GRAND_PAYMENT">0.00</th>
										<th></th>
										</tr>
									</tfoot>
								</table>
								
							</div>
				</div>
			</div>
		</div>
	</div>
		<div class="modal fade" id="modal-commission-compare" tabindex="-1" aria-hidden="true">
			<div class="modal-dialog modal-dialog-scrollable modal-commission-compare-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title mb-0"><%= __('commission.compare_modal_title') %></h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						<div class="small mb-2 commission-compare-modal-range" id="commission-compare-modal-range"></div>
						<div class="commission-compare-modal-wrap">
							<table id="commission-compare-modal-tbl" class="table nowrap small-text" style="width:100%">
								<thead>
									<tr>
										<th style="width: 75px;"><%= __('commission.game_no') %></th>
										<th><%= __('commission.account_name') %></th>
										<th><%= __('commission.total_buyin') %></th>
										<th><%= __('commission.chips_return') %></th>
										<th><%= __('commission.win_loss') %></th>
										<th><%= __('commission.total_rolling') %></th>
										<th><%= __('commission.rolling_rate') %></th>
										<th><%= __('commission.settlement') %></th>
										<th><%= __('commission.fb') %></th>
										<th><%= __('commission.payment') %></th>
										<th><%= __('commission.date_time') %></th>
									</tr>
								</thead>
								<tbody id="commission-compare-modal-body"></tbody>
								<tfoot>
									<tr>
										<th></th>
										<th><%= __('commission.grand_total') %></th>
										<th id="commission-compare-total-buyin">0</th>
										<th id="commission-compare-total-return">0</th>
										<th id="commission-compare-total-winloss">0</th>
										<th id="commission-compare-total-rolling">0</th>
										<th></th>
										<th id="commission-compare-total-settlement">0</th>
										<th id="commission-compare-total-fnb">0</th>
										<th id="commission-compare-total-payment">0</th>
										<th></th>
									</tr>
								</tfoot>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="modal fade" id="modal-commission-rate-preview" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
			<div class="modal-dialog modal-sm modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header py-2">
						<h5 class="modal-title mb-0"><%= __('commission.rolling_rate') %></h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						<div class="input-group">
							<input type="text" id="commission-rate-preview-input" class="form-control" inputmode="decimal" autocomplete="off" placeholder="0.00">
							<span class="input-group-text">%</span>
						</div>
					</div>
					<div class="modal-footer py-2">
						<button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
						<button type="button" id="btn-commission-rate-preview" class="btn btn-primary btn-sm"><%= __('commission.compare_preview') %></button>
					</div>
				</div>
			</div>
		</div>

		<%- include ('../modals/junket/edit_commission') %>

		<%- include ('../partials/footer'); -%>

		<script>
			// Pass translations to JavaScript (must load before commission.js)
			window.commissionTranslations = {
				select_date_range: "<%= __('commission.select_date_range') %>",
				invalid_date: "<%= __('commission.invalid_date') %>",
				search: "<%= __('commission.search') %>",
				showing_entries: "<%= __('commission.showing_entries') %>",
				previous: "<%= __('commission.previous') %>",
				next: "<%= __('commission.next') %>",
				please_select_date_range: "<%= __('commission.please_select_date_range') %>",
				no_data_found: "<%= __('commission.no_data_found') %>",
				export_label: "<%= __('commission.export') || 'Export' %>",
				compare_hint: "<%= __('commission.compare_hint') %>",
				compare_confirm: "<%= __('commission.compare_confirm') %>",
				compare_clear: "<%= __('commission.compare_clear') %>",
				compare_max: "<%= __('commission.compare_max_accounts') %>",
				compare_select_one: "<%= __('commission.compare_select_one') %>",
				compare_selected: "<%= __('commission.compare_selected') %>",
				compare_modal_title: "<%= __('commission.compare_modal_title') %>",
				rolling_rate: "<%= __('commission.rolling_rate') %>",
				compare_preview: "<%= __('commission.compare_preview') %>",
				cancel: "Cancel"
			};
		</script>
		<script src="/assets/js/functions/commission.js"></script>
		
		
		
		<style>
.card-body {
  overflow-x: auto;
}


#modal-commission-compare .modal-commission-compare-dialog {
	max-width: min(98vw, 1680px);
	width: 98vw;
	margin-left: auto;
	margin-right: auto;
}

 /* Base table styles — main + compare modal */
 #commission-tbl,
 #commission-compare-modal-tbl {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
}

/* Header styles */
#commission-tbl thead th,
#commission-compare-modal-tbl thead th {
    background: var(--bs-primary-bg-subtle);
    color: var(--bs-primary);
    font-weight: 500;
    padding: 12px 15px;
    text-align: left;
    border: none;
}

.commission-page-filters {
	position: relative;
	z-index: 1;
}

.commission-daterange-mount {
	display: none;
	align-items: center;
	gap: 8px;
	margin-left: 12px;
	vertical-align: middle;
}

.commission-daterange-mount.is-placed {
	display: inline-flex;
}

.commission-daterange-wrap {
	width: auto;
	min-width: 220px;
	max-width: 300px;
}

#commission-tbl_wrapper .dataTables_length {
	display: inline-flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 4px;
}

#commission-tbl thead th.commission-date-sort-col {
	cursor: pointer;
}

.commission-daterange-wrap .flatpickr-wrapper {
	display: block;
	width: 100%;
}

.commission-daterange-wrap input.form-control,
.commission-daterange-wrap .flatpickr-input.form-control {
	display: block !important;
	position: static !important;
	left: auto !important;
	top: auto !important;
	width: 100% !important;
	max-width: 100%;
	margin: 0;
}

.commission-compare-bar {
	background: #f0f4ff;
	border: 1px solid #dbe2f3;
	border-radius: 8px;
	padding: 10px 12px;
	clear: both;
	position: relative;
	z-index: 2;
}

.commission-compare-bar .badge {
	font-weight: 500;
	font-size: 12px;
}

#commission-tbl thead th:nth-child(1) {
	text-align: center;
}

#commission-tbl thead th:nth-child(3),
#commission-tbl thead th:nth-child(12) {
    text-align: left;
    padding-left: 20px;
}

#commission-tbl thead th:nth-child(4),
#commission-tbl thead th:nth-child(5),
#commission-tbl thead th:nth-child(6),
#commission-tbl thead th:nth-child(7),
#commission-tbl thead th:nth-child(8),
#commission-tbl thead th:nth-child(9),
#commission-tbl thead th:nth-child(10),
#commission-tbl thead th:nth-child(11) {
    text-align: right;
    padding-right: 20px;
}

/* Win/Loss sign colors */
.commission-winloss-positive,
#commission-tbl tfoot #GRAND_WIN_LOSS.commission-winloss-positive,
#commission-compare-modal-tbl tfoot #commission-compare-total-winloss.commission-winloss-positive {
    color: #16a34a !important;
    font-weight: 600;
}

.commission-winloss-negative,
#commission-tbl tfoot #GRAND_WIN_LOSS.commission-winloss-negative,
#commission-compare-modal-tbl tfoot #commission-compare-total-winloss.commission-winloss-negative {
    color: #dc2626 !important;
    font-weight: 600;
}

/* Row styles */
#commission-tbl tbody tr,
#commission-compare-modal-tbl tbody tr {
    border-bottom: 1px solid #eee;
}

/* Cell styles */
#commission-tbl td,
#commission-compare-modal-tbl td {
    padding: 12px 15px;
    color: #666;
}

#commission-tbl tbody td.commission-compare-cell {
	text-align: center;
	vertical-align: middle;
}

#commission-tbl thead th.commission-compare-col .fa {
	color: var(--bs-primary);
}

#commission-tbl .commission-compare-cb.form-check-input {
	width: 1.15rem;
	height: 1.15rem;
	margin: 0;
	cursor: pointer;
	border: 2px solid var(--bs-primary, #0d6efd);
	background-color: #fff;
}

#commission-tbl .commission-compare-cb.form-check-input:checked {
	background-color: var(--bs-primary, #0d6efd);
	border-color: var(--bs-primary, #0d6efd);
}

#commission-tbl .commission-compare-cb.form-check-input:focus {
	border-color: var(--bs-primary, #0d6efd);
	box-shadow: 0 0 0 0.2rem rgba(var(--bs-primary-rgb, 13, 110, 253), 0.25);
}

#commission-tbl tbody td:nth-child(3),
#commission-tbl tbody td:nth-child(12) {
    text-align: left;
    padding-left: 20px;
}

#commission-tbl tbody td:nth-child(4),
#commission-tbl tbody td:nth-child(5),
#commission-tbl tbody td:nth-child(6),
#commission-tbl tbody td:nth-child(7),
#commission-tbl tbody td:nth-child(8),
#commission-tbl tbody td:nth-child(9),
#commission-tbl tbody td:nth-child(10),
#commission-tbl tbody td:nth-child(11),
#commission-tbl tfoot th:nth-child(n+4) {
    text-align: right;
    padding-right: 20px;
}

#commission-tbl tbody tr:hover,
#commission-compare-modal-tbl tbody tr:hover {
  background-color: #f5f5f5 !important;
}

/* Compare modal — same alignment as main table (no checkbox column) */
#commission-compare-modal-tbl thead th:nth-child(2),
#commission-compare-modal-tbl tbody td:nth-child(2),
#commission-compare-modal-tbl tfoot th:nth-child(2),
#commission-compare-modal-tbl thead th:nth-child(11),
#commission-compare-modal-tbl tbody td:nth-child(11) {
    text-align: left;
    padding-left: 20px;
}

#commission-compare-modal-tbl thead th:nth-child(3),
#commission-compare-modal-tbl thead th:nth-child(4),
#commission-compare-modal-tbl thead th:nth-child(5),
#commission-compare-modal-tbl thead th:nth-child(6),
#commission-compare-modal-tbl thead th:nth-child(7),
#commission-compare-modal-tbl thead th:nth-child(8),
#commission-compare-modal-tbl thead th:nth-child(9),
#commission-compare-modal-tbl thead th:nth-child(10),
#commission-compare-modal-tbl tbody td:nth-child(3),
#commission-compare-modal-tbl tbody td:nth-child(4),
#commission-compare-modal-tbl tbody td:nth-child(5),
#commission-compare-modal-tbl tbody td:nth-child(6),
#commission-compare-modal-tbl tbody td:nth-child(7),
#commission-compare-modal-tbl tbody td:nth-child(8),
#commission-compare-modal-tbl tbody td:nth-child(9),
#commission-compare-modal-tbl tbody td:nth-child(10),
#commission-compare-modal-tbl tfoot th:nth-child(n+3) {
    text-align: right;
    padding-right: 20px;
}

.commission-compare-modal-range,
#commission-compare-modal-range {
	color: #000;
	font-weight: 500;
}

#commission-compare-modal-tbl tbody tr.commission-compare-first-row {
	cursor: pointer;
}

#modal-commission-rate-preview {
	z-index: 1070;
}

#modal-commission-rate-preview .modal-backdrop,
.modal-backdrop.show:nth-of-type(2) {
	z-index: 1065;
}

#commission-rate-preview-input {
	font-size: 1rem;
}

.commission-compare-modal-wrap {
	max-width: 100%;
	overflow-x: auto;
}

#modal-commission-compare .modal-body {
	padding: 1rem 1.25rem;
}

/* Date column — main + compare modal */
#commission-tbl td:last-child,
#commission-compare-modal-tbl td:last-child {
    text-align: left;
    padding-left: 20px;
    color: #333;
}

/* Footer total row */
#commission-tbl tfoot th,
#commission-compare-modal-tbl tfoot th {
    padding: 10px;
    font-weight: 600;
    color: #333;
    background-color: #f4f6fa;
    border-top: 2px solid #dee2e6;
}

@media (max-width: 768px) {
    #commission-tbl,
    #commission-compare-modal-tbl {
        font-size: 10px;
    }

    #commission-tbl th,
    #commission-tbl td,
    #commission-compare-modal-tbl th,
    #commission-compare-modal-tbl td {
        padding: 5px;
    }
}
/* Itago ang text na "Show" at "entries" sa DataTables */
.dataTables_length label {
    font-size: 0; /* Itatago ang text */
}

/* Panatilihin ang dropdown na nakikita */
.dataTables_length select {
    font-size: 12px; /* Ibalik ang font size ng dropdown */
}



	/* Adjust spacing and alignment for date range picker */
.dataTables_wrapper .row {
    margin-bottom: 15px;
    font-size: 12px; /* Pareho sa commission-tbl */
}

/* Legacy DataTables date offset — do not apply to commission-page-filters */
.dataTables_wrapper .input-daterange {
    display: flex;
    justify-content: space-between;
    position: relative;
    left: 7.5rem;
    top: 4rem;
    max-width: 300px;
    font-size: 12px;
}

.dataTables_wrapper .input-daterange .form-control {
    flex: 1;
    margin-right: 5px;
    max-width: 120px;
    font-size: 12px;
    padding: 8px;
}

.dataTables_wrapper .input-daterange .form-control:last-child {
    margin-right: 0;
}

.flatpickr-calendar .cur-month {
    cursor: pointer;
}

.flatpickr-calendar .cur-month:hover {
    text-decoration: underline;
}

@media (max-width: 768px) {
    .dataTables_wrapper .row,
    .dataTables_wrapper .input-daterange,
    .dataTables_wrapper .input-daterange .form-control {
        font-size: 10px;
    }

    .dataTables_wrapper .input-daterange .form-control {
        padding: 5px;
    }
}

		 </style>
