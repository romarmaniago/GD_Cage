<%- include('../partials/header') %>
<%- include('../partials/loader') %>
<%- include ('../partials/sidebar'); -%>
<%- include ('../partials/topbar'); -%>


<link rel="stylesheet" href="/assets/css/commission.css">

<style>
.card {
    background: linear-gradient(180deg, #f6f3ec 0%, #efe9db 100%) !important;
    border: 1px solid rgba(200, 162, 76, 0.4) !important;
    border-radius: 0.85rem;
    overflow: hidden;
}
.card-header {
    background: #f6f3ec !important;
    border-bottom: 2px solid #c8a24c;
}
.card-header .card-title {
    color: #3a2e12 !important;
}

.commission-panel-body table thead tr,
.commission-panel-body table tfoot tr {
    background-color: #f5f5f5 !important;
}
.commission-panel-body table thead th {
    background: #f5f5f5 !important;
    background-color: #f5f5f5 !important;
    color: #555 !important;
    border-bottom: 1px solid #e0e0e0 !important;
}
.commission-panel-body table.dataTable thead > tr > th.sorting,
.commission-panel-body table.dataTable thead > tr > th.sorting_asc,
.commission-panel-body table.dataTable thead > tr > th.sorting_desc,
.commission-panel-body table.dataTable thead > tr > th.sorting_disabled {
    background: #f5f5f5 !important;
    background-color: #f5f5f5 !important;
}
#commission-tbl thead th.sorting:hover,
#commission-tbl thead th.sorting_asc:hover,
#commission-tbl thead th.sorting_desc:hover,
#commission-tbl thead th.commission-date-sort-col:hover {
    background: #ececec !important;
}
#commission-tbl thead th.sorting_asc,
#commission-tbl thead th.sorting_desc,
#commission-tbl thead th.commission-date-sort-col.sorting_asc,
#commission-tbl thead th.commission-date-sort-col.sorting_desc {
    background: #ececec !important;
    color: #333 !important;
}
.commission-panel-body table tfoot th {
    background: #f5f5f5 !important;
    background-color: #f5f5f5 !important;
    color: #555 !important;
    border-top: 1px solid #e0e0e0 !important;
    border-bottom: 1px solid #e0e0e0 !important;
}
#commission-tbl tbody tr:nth-child(even) td {
    background-color: #f4f1ea !important;
}
#commission-tbl tbody tr:nth-child(odd) td {
    background-color: #fff !important;
}
#commission-tbl tbody tr:hover td {
    background-color: #f6f3ec !important;
}

#commission-tbl_wrapper .commission-panel-shell {
    border: 1px solid #e0e0e0 !important;
    background: #fff !important;
}
#commission-tbl_wrapper .commission-controls-highlight {
    background: #fff !important;
    border-bottom: 1px solid #e0e0e0 !important;
}

#commission-tbl thead th.col-buyin,
#commission-tbl thead th.col-total-rolling,
#commission-tbl thead th.col-winloss {
    color: #555 !important;
}
</style>

<div class="container-fluid content-inner py-0">
	<div class="row">
		<div class="col-sm-12">
			<div class="card">
				<div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
					<h3 class="card-title mb-0">
						<div class="breadcrumb1 flat">
							<a href="/dashboard"><span class="fa fa-home"></span></a>
						
							<a href="/commission" class="active"><%= __('commission.commission') %></a>
							<!-- <a href="/commission_settlement"><%= __('commission_settlement.title') %></a> -->
                            <a href="/additional_commission">Additional</a>
							<a href="/commission_analytics">Analytics</a>
							
						</div>
					</h3>
					<div class="d-flex flex-wrap gap-2 align-items-center">
						<%- include('../partials/commission_toolbar') %>
					</div>
				</div>
				<div class="card-body pt-2 commission-panel-body">
					<%- include('../partials/commission_table_body') %>
				</div>
			</div>
		</div>
	</div>
</div>

<%- include('../partials/commission_compare_modals') %>
<%- include('../modals/junket/edit_commission') %>

		<%- include ('../partials/footer'); -%>

