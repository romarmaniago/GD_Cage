<style>
/* Page-only: the /commission page's own card wrapper. The table's own
   theme (header, zebra rows, panel shell, controls bar) now lives in
   commission.css so it renders identically here and in the dashboard modal. */
.card {
    background: linear-gradient(180deg, #f6f3ec 0%, #efe9db 100%) !important;
    border: 1px solid rgba(200, 162, 76, 0.4) !important;
    border-radius: 0.85rem;
    overflow: hidden;
}
.card-header {
    background: #f6f3ec !important;
    border-bottom: 2px solid #c8a24c;
}
.card-header .card-title {
    color: #3a2e12 !important;
}
</style>

