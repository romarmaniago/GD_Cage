        <script src="/assets/js/functions/house_expense.js"></script>
        <script>
            /* Category modals — wired like #modal-new-house-expense (see $(document).ready in house_expense.js) */
            $(function () {
                if (typeof window.houseExpenseInitCategoryAddUi === 'function') {
                    window.houseExpenseInitCategoryAddUi();
                }
                if (typeof window.houseExpenseInitVehicleUi === 'function') {
                    window.houseExpenseInitVehicleUi();
                }

                $(document).on('click', '#modal-dash-house-expense .js-house-expense-add-main-cat, .expense-explorer-row .js-house-expense-add-main-cat', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (typeof window.addHouseExpenseMainCategory === 'function') {
                        window.addHouseExpenseMainCategory();
                    } else if ($('#modal-house-expense-add-category').length) {
                        window.houseExpenseAddCategoryMode = 'main';
                        var $m = $('#modal-house-expense-add-category').appendTo('body');
                        $m.modal('show');
                    }
                });

                $(document).on('click', '#modal-dash-house-expense .js-house-expense-add-sub-cat, .expense-explorer-row .js-house-expense-add-sub-cat', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if ($(this).prop('disabled')) return;
                    if (typeof window.addHouseExpenseSubCategory === 'function') {
                        window.addHouseExpenseSubCategory();
                    } else if ($('#modal-house-expense-add-category').length) {
                        window.houseExpenseAddCategoryMode = 'sub';
                        var $m2 = $('#modal-house-expense-add-category').appendTo('body');
                        $m2.modal('show');
                    }
                });

                $(document).on('click', '#modal-dash-house-expense .js-house-expense-add-item, .expense-explorer-row .js-house-expense-add-item', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if ($(this).prop('disabled')) return;
                    if (typeof window.addHouseExpenseFromExplorer === 'function') {
                        window.addHouseExpenseFromExplorer();
                    } else if (typeof window.addHouseExpense === 'function') {
                        window.addHouseExpense();
                    }
                });
            });
        </script>

