        <!-- Main Container -->
        <div class="container-fluid content-inner mt-4">

            <div class="row">
                <div class="col-sm-12">
                    <div class="card">
                        <div id="user-role" data-permissions="<%= permissions %>"></div>
                        <div class="card-header border-bottom-0 d-flex flex-wrap justify-content-between align-items-center">
                            <div class="mb-2 mb-md-0">
                                <div class="breadcrumb1 flat">
                                    <a href="/dashboard"><span class="fa fa-home"></span></a>
                                    <a href="/house_expense" class="active"><%= __('house_expense.junket_expenses') %></a>
                                    <a href="#" id="btn-daily-settle"><%= __('house_expense.settle') || 'Settle' %></a>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <button type="button" id="btn-house-expense-export" class="btn btn-sm btn-warning">
                                    <i class="fa fa-file-excel" aria-hidden="true"></i> <%= __('house_expense.export') || 'Export' %>
                                </button>
                                <button type="button" class="btn btn-sm btn-primary" onclick="addHouseExpense()">
                                    <i class="fa fa-plus" aria-hidden="true"></i> <%= __('house_expense.new_expense') %>
                                </button>
                                <button type="button" class="btn btn-sm btn-success" onclick="returnMoney()">
                                    <i class="fa fa-undo" aria-hidden="true"></i> <%= __('house_expense.return_money') %>
                                </button>
                            </div>
                        </div>
       
                        <div class="card-body">
                            <%
                                const now = new Date();
                                const pad = value => value.toString().padStart(2, '0');
                                const todayStrValue = typeof todayStr !== 'undefined' ? todayStr : `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
                                const initialDate = typeof defaultSettlementDate !== 'undefined' ? defaultSettlementDate : todayStrValue;
                                const maxPickerDate = typeof maxSettlementDate !== 'undefined' ? maxSettlementDate : initialDate;
                            %>

                            <div id="house-expense-dashboard" class="mb-3 house-expense-dashboard-shell">
                                <div class="row g-3 align-items-stretch" id="house-expense-kpi-row">
                                    <div class="col-12 d-flex align-items-stretch" id="expense-kpi-stack-col">
                                        <div class="row g-3 flex-grow-1 w-100 mx-0">
                                            <div class="col-12 col-md-6" id="expense-kpi-col-grand">
                                                <div class="expense-dash-kpi expense-dash-kpi-grand h-100 d-flex align-items-center">
                                                    <div class="expense-dash-kpi-icon flex-shrink-0"><i class="fa fa-wallet"></i></div>
                                                    <div class="expense-dash-kpi-text">
                                                        <div class="expense-dash-kpi-label"><%= __('house_expense.total_expenses') || 'Grand total expenses' %></div>
                                                        <div class="expense-dash-kpi-value" id="expense-kpi-grand-amount">₱0</div>
                                                        <div class="expense-dash-kpi-meta small" id="expense-kpi-grand-range">—</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-12 col-md-6" id="expense-kpi-col-selected">
                                                <div class="expense-dash-kpi expense-dash-kpi-selected h-100 d-flex align-items-center">
                                                    <div class="expense-dash-kpi-icon expense-dash-kpi-icon-alt flex-shrink-0"><i class="fa fa-filter"></i></div>
                                                    <div class="expense-dash-kpi-text">
                                                        <div class="expense-dash-kpi-label">Selected total</div>
                                                        <div class="expense-dash-kpi-value" id="expense-kpi-selected-amount">₱0</div>
                                                        <div class="expense-dash-kpi-meta small" id="expense-kpi-selected-pct-row">
                                                            <span id="expense-kpi-pct-grand">—</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-7 col-xl-8 d-none" id="expense-graph-race-column">
                                        <div class="expense-dash-graph w-100 h-100 d-flex flex-column">
                                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1 flex-shrink-0">
                                                <div>
                                                    <div class="expense-dash-graph-title">Expense breakdown</div>
                                                    <div class="expense-dash-graph-subtitle text-muted small" id="expense-graph-subtitle">By category</div>
                                                </div>
                                            </div>
                                            <div class="expense-dash-graph-body flex-grow-1 d-flex flex-column" id="expense-graph-race-body">
                                                <div class="text-muted small py-2">No expense data yet.</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 expense-explorer-row align-items-stretch">
                                <div class="col-12 expense-explorer-cat-col order-2 order-lg-1 d-flex">
                                    <div class="expense-cat-panel h-100 w-100 d-flex flex-column">
                                        <div class="expense-cat-panel-head d-flex justify-content-between align-items-center flex-shrink-0">
                                            <span>Main category</span>
                                        </div>
                                        <div class="expense-cat-panel-body flex-grow-1 expense-cat-panel-body-scroll" id="expense-main-cat-list">
                                            <div class="text-muted small p-2">No data</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 expense-explorer-table-col order-1 order-lg-2 d-flex">
                                    <div class="expense-table-panel h-100 w-100 d-flex flex-column">
                                        <div class="expense-table-panel-head d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <span class="expense-table-panel-title"><%= __('house_expense.junket_expenses') || 'Expenses' %></span>
                                        </div>
                                        <div class="expense-table-panel-body flex-grow-1 min-w-0">
                            <%# Moved beside row-count via DataTables dom + initComplete in house_expense.js; restored before destroy. %>
                            <div id="house-expense-filter-shell" class="house-expense-filter-shell d-flex flex-column align-items-start gap-2">
                                <div class="filter-mode-container mb-0 w-100">
                                    <div class="d-flex align-items-center gap-3 flex-wrap">
                                        <label class="mb-0">
                                            <input type="radio" name="filter-mode" value="settlement" checked id="filter-settlement">
                                            <span class="ms-1">Settlement Date</span>
                                        </label>
                                        <label class="mb-0">
                                            <input type="radio" name="filter-mode" value="daterange" id="filter-daterange">
                                            <span class="ms-1">Date Range</span>
                                        </label>
                                    </div>
                                </div>

                                <div id="settlement-date-wrapper" class="day-selector-wrapper">
                                    <div class="input-group" data-today="<%= todayStrValue %>" data-default-settlement-date="<%= initialDate %>" data-max-settlement-date="<%= maxPickerDate %>" data-settled-dates='<%= typeof settledDatesForMonth !== "undefined" ? JSON.stringify(settledDatesForMonth) : "[]" %>'>
                                        <button type="button" id="btn-settlement-prev" class="btn btn-outline-secondary" title="Previous Date">
                                            <i class="fa fa-chevron-left"></i>
                                        </button>
                                        <input type="text" id="settlement-date-picker" class="form-control text-center" placeholder="YYYY-MM-DD" value="<%= initialDate %>" readonly />
                                        <button type="button" id="btn-settlement-next" class="btn btn-outline-secondary" title="Next Date">
                                            <i class="fa fa-chevron-right"></i>
                                        </button>
                                    </div>
                                </div>

                                <div id="daterange-wrapper" class="day-selector-wrapper" style="display: none;">
                                    <div class="input-group">
                                        <input type="text" id="daterange-picker" class="form-control text-center" placeholder="Select date range" autocomplete="off" />
                                    </div>
                                </div>
                            </div>

                            <table id="expense-tbl" class="table  nowrap small-text" style="width:100%"> 
                                <thead>
                                    <tr>
                                        <th><%= __('house_expense.name') %></th>
                                        <!-- Type column hidden per request
                                        <th><%= __('house_expense.type') %></th>
                                        -->
                                        <th><%= __('house_expense.receipt_no') %></th>
                                        <th><%= __('house_expense.description') %></th>
                                        <th><%= __('house_expense.amount') %></th>
                                        <th><%= __('house_expense.encoded_by') %></th>
                                        <th><%= __('house_expense.date_time') %></th>
                                        <th><%= __('house_expense.action') %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="1"><%= __('house_expense.total_expenses') || 'TOTAL EXPENSES' %></th>
                                        <th id="TOTAL_EXPENSE_AMOUNT">₱0.00</th>
                                        <th colspan="5"></th>
                                    </tr>
                                    <tr>
                                        <th colspan="1"><%= __('house_expense.total_return_money') || 'TOTAL RETURN MONEY' %></th>
                                        <th id="TOTAL_RETURN_MONEY_AMOUNT">₱0.00</th>
                                        <th colspan="5"></th>
                                    </tr>
                                    <tr>
                                        <th colspan="1"><%= __('house_expense.total_net_expenses') || 'TOTAL NET EXPENSES' %></th>
                                        <th id="TOTAL_NET_EXPENSES_AMOUNT">₱0.00</th>
                                        <th colspan="5"></th>
                                    </tr>
                                </tfoot>
                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
       
                            
       
                        </div>
                    </div>
                </div>
            </div>
        </div>
            
        
