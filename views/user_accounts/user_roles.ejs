											<th class="d-none d-sm-table-cell text-center" style="width: 100px;"><%= __('user_roles.action') %></th>
										</tr>
									</thead>
									<tbody>

									</tbody>
								</table>
								</div>

							</div>
						</div>
					</div>
				</div>
			</div>


					<%- include ('../modals/user_accounts/new_user_role'); %>
						<%- include ('../modals/user_accounts/edit_user_role'); %>
<%- include ('../partials/permission_view_only_script') %>
							<%- include ('../partials/footer'); -%>

							<script>
								// Pass translations to JavaScript
								window.userRolesTranslations = {
