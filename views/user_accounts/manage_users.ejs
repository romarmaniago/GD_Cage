.settings-page {
	--gd-marker-gold-solid: #d9b96a;
	--gd-marker-gold-text: #3a2e12;
	--gd-marker-gold-border: rgba(58, 46, 18, 0.25);
	--gd-marker-gold-hover: #faf3dc;
}
.settings-page table.dataTable {
	border-collapse: collapse !important;
	border-spacing: 0 !important;
}
.settings-page table thead tr,
.settings-page table tfoot tr {
	background-color: var(--gd-marker-gold-solid);
}
.settings-page table thead th,
.settings-page table tfoot th {
	background: transparent !important;
	background-color: transparent !important;
	box-shadow: none !important;
}
.settings-page table.dataTable thead > tr > th.sorting,
.settings-page table.dataTable thead > tr > th.sorting_asc,
.settings-page table.dataTable thead > tr > th.sorting_desc,
.settings-page table.dataTable thead > tr > th.sorting_disabled {
	background: transparent !important;
	background-color: transparent !important;
}

#usersTable {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
    border: 1px solid var(--gd-marker-gold-border);
}

/* Circular + beside search — same as User Roles */
#btn-add-user.expense-cat-panel-add-btn {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 2.25rem;
	height: 2.25rem;
	padding: 0;
	border: 1px solid rgba(58, 46, 18, 0.25);
	border-radius: 50%;
	background: linear-gradient(135deg, #6b4a12 0%, #c8a24c 50%, #f1d48a 100%);
	color: #1a1205;
	box-shadow: none;
	line-height: 1;
	flex-shrink: 0;
	position: relative;
	z-index: 2;
	cursor: pointer;
	transition: background 0.12s ease, color 0.12s ease;
}
#btn-add-user.expense-cat-panel-add-btn i.fa {
	font-size: 1rem;
}
#btn-add-user.expense-cat-panel-add-btn:hover:not(:disabled) {
	background: linear-gradient(135deg, #5a3d0f 0%, #b8923f 50%, #e6c97a 100%);
	color: #0f0a02;
}
#btn-add-user.expense-cat-panel-add-btn:disabled {
	opacity: 0.45;
	cursor: not-allowed;
}

#usersTable_wrapper .manage-users-controls-highlight {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	padding: 8px 12px;
	margin-bottom: -1px;
	background: var(--gd-marker-gold-hover);
	border: 1px solid var(--gd-marker-gold-border);
	border-bottom: 0;
	border-radius: 10px 10px 0 0;
}
#usersTable_wrapper .manage-users-controls-highlight .dataTables_length {
	margin-top: 4px;
}
#usersTable_wrapper .manage-users-controls-highlight .dataTables_filter {
	margin: 0 0 0 auto;
}
#usersTable_wrapper #usersTable_filter .manage-users-filter-highlight {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	padding: 2px 6px;
	background: transparent;
	border: none;
	border-radius: 10px;
}
#usersTable_wrapper #usersTable_filter .manage-users-filter-highlight label {
	margin: 0;
	display: inline-flex;
	align-items: center;
	gap: 0;
	font-size: 0;
	color: transparent;
}
#usersTable_wrapper #usersTable_filter .manage-users-filter-highlight label input {
	margin-left: 0;
	border: none;
	outline: none;
	box-shadow: none;
	background: #fff;
	border-radius: 4px;
	padding: 6px 10px;
	font-size: 13px;
	color: #333;
	min-width: 160px;
}
#usersTable_wrapper #usersTable_filter .manage-users-filter-highlight label input::placeholder {
	color: #8a92a6;
	opacity: 1;
}
#usersTable_wrapper #usersTable {
	margin-top: 0 !important;
}
#usersTable_wrapper .dataTables_length,
#usersTable_wrapper .dataTables_filter {
	padding-left: 0;
	padding-right: 0;
}

/* Header styles — gold bg */
#usersTable thead th {
    color: var(--gd-marker-gold-text);
    font-weight: 600;
    padding: 12px 15px;
    text-align: left;
    border: none;
    border-bottom: 1px solid var(--gd-marker-gold-border);
}

/* Row styles */
	#usersTable tbody tr {
    border-bottom: 1px solid #eee;
}

#usersTable tbody tr:nth-child(even) td {
	background-color: #fbf5e4;
}

/* Cell styles */
#usersTable td {
    padding: 12px 15px;
    color: #666;
}

#usersTable tbody tr:hover,
#usersTable tbody tr:hover td {
  background-color: var(--gd-marker-gold-hover) !important;
}



/* Balance column */
#usersTable td:last-child {
    text-align: center;
    color: #333;
}


/* Footer total row */


#usersTable tfoot th {
    padding: 10px;
    font-weight: 600;
    color: #333;
    border-top: 2px solid var(--gd-marker-gold-border);
    border-bottom: 1px solid var(--gd-marker-gold-border);
}
@media (max-width: 768px) {
    #usersTable {
        font-size: 10px; /* Mas maliit sa mobile */
    }

    #usersTable th,
    #usersTable td {
        padding: 5px;
    }
}
