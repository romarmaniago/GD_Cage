<%- include('../partials/header') %>
	<%- include('../partials/loader') %>
		<%- include ('../partials/sidebar'); -%>
			<%- include ('../partials/topbar'); -%>


				<!-- Main Container -->
				<div class="container-fluid content-inner py-0">
					<div class="row">
						<div class="col-sm-12">
							<div class="card">
								<div id="user-role" data-permissions="<%= permissions %>"></div>
								<div class="card-header border-bottom-0 d-flex flex-wrap justify-content-between align-items-center">
									<div class="mb-2 mb-md-0">
									  <div class="breadcrumb1 flat">
										<a href="/dashboard"><span class="fa fa-home"></span></a>
										<a href="/game_list" class="active"><%= __('gamelist.game_book') %></a>
										<a href="#"  onclick="addGameList()"><span class="fa fa-plus me-2"></span><%= __('gamelist.new_game') %></a>
									  </div>								 
									</div>
									<div class="mb-2 mb-md-0 ms-auto flex-shrink-0 d-flex align-items-center gap-2">
										<button type="button" id="btn-merge-settle-game-list" class="btn btn-primary btn-sm d-none">
											<i class="fa fa-compress me-1"></i>Merge Settle
										</button>
										<button type="button" id="btn-game-list-print" class="btn btn-sm btn-alt-success"><i class="fa fa-print me-1"></i>Print</button>
										<a href="#" id="btn-game-list-export" class="btn btn-sm btn-success"><i class="fa fa-download me-1"></i><%= __('gamelist.export') || 'Export' %></a>
									</div>
								</div>

								<div class="dataTables_wrapper">
									<div class="row mb-2">
										<div class="col-12 col-lg-6">
											<!-- Filter: program date only (game start filter hidden) -->
											<div class="filter-mode-container d-none">
												<div class="d-flex align-items-center gap-3">
													<label class="mb-0">
														<input type="radio" name="filter-mode" value="program" checked id="filter-program">
														<span class="ms-1"><%= __('gamelist.program_date') %></span>
													</label>
													<label class="mb-0">
														<input type="radio" name="filter-mode" value="daterange" id="filter-daterange">
														<span class="ms-1"><%= __('gamelist.filter_game_start') %></span>
													</label>
												</div>
											</div>
											
											<!-- Program Date Picker -->
											<div id="program-date-wrapper" class="day-selector-wrapper game-list-program-date-wrap">
											<%
												const now = new Date();
												const pad = value => value.toString().padStart(2, '0');
												const todayStr = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
												const initialDate = typeof initialProgramDate !== 'undefined' ? initialProgramDate : todayStr;
											%>
												<div class="program-date-picker-row">
													<div class="input-group" data-today="<%= todayStr %>" data-initial-program-date="<%= initialDate %>">
														<button type="button" id="btn-program-date-prev" class="btn btn-outline-secondary" title="Previous Date">
															<i class="fa fa-chevron-left"></i>
														</button>
														<input type="text" id="program-date-range-picker" class="form-control form-control-sm text-center" placeholder="Program date range" autocomplete="off" />
														<button type="button" id="btn-program-date-next" class="btn btn-outline-secondary" title="Next Date">
															<i class="fa fa-chevron-right"></i>
														</button>
													</div>
												</div>
											</div>
											
											<!-- Game Start Picker -->
											<div id="daterange-wrapper" class="day-selector-wrapper game-list-daterange-wrap house-expense-daterange-wrap" style="display: none;">
												<input type="text" id="daterange-picker" class="form-control form-control-sm text-center" placeholder="<%= __('gamelist.select_date') %>" autocomplete="off" />
											</div>
										</div>
									</div>
								</div>
								<div class="card-body game-list-page">
									<div class="marker-balance-dt-wrap marker-balance-card table-responsive">
									<table id="game_list-tbl" class="table marker-balance-tbl w-100 mb-0">

										<thead>
											<tr>
												<th class="d-none d-sm-table-cell text-start col-program-date program-date-th">
													<span class="game-list-select-all-slot">
														<input type="checkbox" id="game-list-select-all" class="game-list-select-all-cb" />
													</span>
													<span class="program-date-th-label"><%= __('gamelist.program_date_col') %></span>
												</th>
												<th class="d-none d-sm-table-cell text-start game-start-th col-game-start">
													<span class="game-start-th-label"><%= __('gamelist.game_start') %></span>
												</th>
												<th class="d-none d-sm-table-cell text-center col-type">
													<%= __('gamelist.type') %>
												</th>
												<th class="d-none d-sm-table-cell text-center">
													<%= __('gamelist.game#') %>
												</th>
											<th class="d-none d-sm-table-cell text-center col-acct-no">
												<%= __('gamelist.acct_no') %>
											</th>
											<th class="d-none d-sm-table-cell text-center col-guest">
												<%= __('gamelist.guest') %>
											</th>
											<th class="d-none d-sm-table-cell text-center col-buyin">
												<%= __('gamelist.buyin') %>
											</th>
											<th class="d-none d-sm-table-cell text-center col-cashout">
												<%= __('gamelist.cash_out') %>
											</th>
											<th class="d-none d-sm-table-cell text-center col-winloss" >
												<%= __('gamelist.win_loss') %>
											</th>
											<th class="d-none d-sm-table-cell text-center col-total-rolling" >
												<%= __('gamelist.real_rolling') %>
											</th>
												<th class="d-none d-sm-table-cell text-center col-game-rate">
													<%= __('gamelist.game_rate') %>
												</th>
												<th class="d-none d-sm-table-cell text-center col-commission">
													<%= __('gamelist.commission') %>
												</th>
												<th class="d-none d-sm-table-cell text-center">
													ADD CHG
												</th>
												<th class="d-none d-sm-table-cell text-center">
													TOTAL SETTLE
												</th>
												<th class="d-none d-sm-table-cell text-center col-game-end">
													<%= __('gamelist.game_end') %>
												</th>
												<th class="d-none d-sm-table-cell text-center col-roller-chips">
													<%= __('gamelist.roller_chips') %>
												</th>
												<th class="d-none d-sm-table-cell text-start col-action">
													<%= __('gamelist.action') %>
												</th>
											</tr>
										</thead>
										<tbody class="text-center">
											<!-- Data will be populated here -->
										</tbody>
										<tfoot>
											<tr>
											<th colspan="6">
												<%= __('gamelist.grand_total') %>
											</th>
											<th class="d-none d-sm-table-cell text-center col-buyin" id="GRAND_TOTAL_AMOUNT">0.00</th>
											<th class="d-none d-sm-table-cell text-center col-cashout" id="GRAND_CHIPS_RETURN">
												0.00</th>
											<th class="d-none d-sm-table-cell text-center col-winloss" id="GRAND_WIN_LOSS">0.00
											</th>
											<th class="d-none d-sm-table-cell text-center col-total-rolling" id="GRAND_TOTAL_ROLLING">
												0.00</th>
											<th class="col-game-rate"></th>
											<th class="d-none d-sm-table-cell text-center col-commission" id="GRAND_COMMISSION">0.00</th>
											<th class="d-none d-sm-table-cell text-center" id="GRAND_ADD_CHG">0.00</th>
											<th class="d-none d-sm-table-cell text-center col-total-settle" id="GRAND_TOTAL_SETTLE">0.00</th>
											<th class="col-game-end"></th>
											<th class="d-none d-sm-table-cell text-center col-roller-chips" id="GRAND_ROLLER_CHIPS">0.00</th>
											<th class="col-action"></th>
											</tr>
										</tfoot>
									</table>
									</div>

								</div>
							</div>
						</div>
					</div>
				</div>

				<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
				<script>
					document.addEventListener('DOMContentLoaded', () => {
						const wrapper = document.querySelector('#program-date-wrapper .input-group');
						const todayStr = wrapper ? wrapper.getAttribute('data-today') : '';
						const initialPickerDate = wrapper
							? (wrapper.getAttribute('data-initial-program-date') || wrapper.getAttribute('data-today') || '')
							: '';
						window.selectedProgramDate = initialPickerDate || todayStr || '';
					});
				</script>


				<%- include ('../partials/footer'); -%>


					<style>

/* Filter Mode Radio Buttons Container */
.filter-mode-container {
	position: absolute;
	top: 125px;      /* Position above day-selector-wrapper */
	left: 160px;    /* Same left position as day-selector-wrapper */
	z-index: 10;
}

.filter-mode-container label {
	font-size: 14px;
}

.filter-mode-container label span {
	font-size: 14px;
	text-transform: none;
}

/* Day selector — aligned inline with DataTables length via layoutGameListControls() */
.day-selector-wrapper,
.game-list-daterange-wrap {
	width: auto;
	max-width: none;
	min-width: 0;
	box-sizing: border-box;
	margin-bottom: 0;
}

.game-list-daterange-wrap .flatpickr-wrapper {
	display: inline-block;
	width: auto;
	min-width: 0;
}

#daterange-wrapper.game-list-daterange-wrap input.form-control,
#daterange-wrapper.game-list-daterange-wrap .flatpickr-input.form-control {
	display: inline-block !important;
	position: static !important;
	left: auto !important;
	top: auto !important;
	width: auto !important;
	min-width: 10rem;
	max-width: none !important;
	margin: 0;
	overflow: visible;
	text-overflow: clip;
	white-space: nowrap;
	box-sizing: border-box;
	text-align: center;
	cursor: pointer;
	background: #fff;
	border: 1px solid rgba(58, 46, 18, 0.18);
	border-radius: 999px;
	height: 34px;
	padding-left: 0.9rem;
	padding-right: 0.9rem;
	font-size: 13px;
	box-shadow: 0 1px 2px rgba(58, 46, 18, 0.04);
}

#daterange-wrapper.game-list-daterange-wrap input.form-control:focus,
#daterange-wrapper.game-list-daterange-wrap .flatpickr-input.form-control:focus {
	border-color: rgba(58, 46, 18, 0.35);
	outline: none;
	box-shadow: 0 0 0 0.15rem rgba(217, 185, 106, 0.35);
}

/* Source mount for date picker — children moved into #game_list-tbl_wrapper by JS */
.card > .dataTables_wrapper:not(#game_list-tbl_wrapper) {
	display: none;
}

#game_list-tbl_wrapper .game-list-controls-highlight {
	display: flex;
	align-items: center;
	justify-content: space-between;
	flex-wrap: wrap;
	gap: 12px;
	padding: 8px 12px;
	margin: 0;
	background: #faf3dc;
	border: 1px solid var(--gd-marker-gold-border, rgba(58, 46, 18, 0.25));
	border-bottom: 0;
	border-radius: 10px 10px 0 0;
}

#game_list-tbl_wrapper .game-list-controls-left {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 12px;
}

#game_list-tbl_wrapper .game-list-controls-highlight .dataTables_length {
	display: inline-flex;
	align-items: center;
	margin: 0;
	margin-top: 4px;
}

#game_list-tbl_wrapper .game-list-controls-highlight .dataTables_length select {
	height: 34px;
}

#game_list-tbl_wrapper .game-list-controls-highlight .dataTables_filter {
	margin: 0;
	margin-left: auto;
}

#game_list-tbl_wrapper .dataTables_scroll,
#game_list-tbl_wrapper .dataTables_scrollHead,
#game_list-tbl_wrapper .dataTables_scrollHeadInner,
#game_list-tbl_wrapper table.dataTable,
#game_list-tbl_wrapper #game_list-tbl {
	margin-top: 0 !important;
	border-top: 0 !important;
	border-top-left-radius: 0;
	border-top-right-radius: 0;
}

#game_list-tbl_wrapper > .row:has(.dataTables_info),
#game_list-tbl_wrapper > .row:has(.dataTables_paginate) {
	display: flex !important;
	margin-top: 12px;
	margin-bottom: 0;
}

#game_list-tbl_wrapper .dataTables_info,
#game_list-tbl_wrapper .dataTables_paginate {
	display: block;
}

#program-date-wrapper.is-placed,
#daterange-wrapper.is-placed {
	position: static;
	top: auto;
	left: auto;
	right: auto;
	bottom: auto;
	display: inline-flex;
	align-items: center;
	vertical-align: middle;
}

#program-date-wrapper .program-date-picker-row {
	display: inline-flex;
	align-items: center;
	min-width: 0;
}

/* Program date: prev | date | next unified pill */
#program-date-wrapper.game-list-program-date-wrap {
	width: auto;
	max-width: none;
	min-width: 0;
}

#program-date-wrapper .input-group {
	display: inline-flex;
	align-items: center;
	flex-wrap: nowrap;
	gap: 0;
	height: 34px;
	min-width: 0;
	border: 1px solid rgba(58, 46, 18, 0.18);
	border-radius: 999px;
	background: #fff;
	box-shadow: 0 1px 2px rgba(58, 46, 18, 0.04);
	overflow: hidden;
}

#program-date-wrapper .input-group > input[type="hidden"] {
	display: none !important;
	position: absolute !important;
	width: 0 !important;
	height: 0 !important;
	padding: 0 !important;
	margin: 0 !important;
	border: 0 !important;
	opacity: 0 !important;
	pointer-events: none !important;
}

#program-date-wrapper .input-group > .flatpickr-wrapper {
	flex: 0 0 auto;
	width: auto !important;
	min-width: 0 !important;
	max-width: none !important;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	margin: 0;
	padding: 0;
}

#program-date-wrapper #btn-program-date-prev,
#program-date-wrapper #btn-program-date-next {
	flex: 0 0 32px;
	width: 32px;
	min-width: 32px;
	height: 34px;
	padding: 0;
	margin: 0;
	border: none;
	border-radius: 0;
	background: transparent;
	color: #5c4a1f;
	font-size: 0.7rem;
	line-height: 1;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	box-shadow: none;
	transition: background 0.15s ease, color 0.15s ease;
}

#program-date-wrapper #btn-program-date-prev {
	border-right: 1px solid rgba(58, 46, 18, 0.1);
}

#program-date-wrapper #btn-program-date-next {
	border-left: 1px solid rgba(58, 46, 18, 0.1);
}

#program-date-wrapper #btn-program-date-prev:hover:not(:disabled),
#program-date-wrapper #btn-program-date-next:hover:not(:disabled) {
	filter: brightness(0.92);
}

#program-date-wrapper #btn-program-date-prev:active:not(:disabled),
#program-date-wrapper #btn-program-date-next:active:not(:disabled) {
	filter: brightness(0.85);
}

#program-date-wrapper #btn-program-date-prev:focus,
#program-date-wrapper #btn-program-date-next:focus {
	outline: none;
	box-shadow: none;
}

#program-date-wrapper #btn-program-date-prev:disabled,
#program-date-wrapper #btn-program-date-next:disabled {
	opacity: 0.35;
	background: transparent;
	color: #adb5bd;
}

#program-date-wrapper #program-date-range-picker,
#program-date-wrapper .input-group input.flatpickr-input.form-control,
#program-date-wrapper .input-group input.flatpickr-alt-input {
	flex: 0 0 auto;
	display: inline-block !important;
	position: static !important;
	width: auto !important;
	min-width: 0 !important;
	max-width: none !important;
	height: 34px;
	margin: 0;
	padding: 0 0.9rem;
	border: none !important;
	border-radius: 0;
	background: transparent !important;
	box-shadow: none !important;
	text-align: center;
	font-size: 13px;
	font-weight: 500;
	color: #333;
	cursor: pointer;
	overflow: visible;
	text-overflow: clip;
	white-space: nowrap;
	box-sizing: border-box;
}

#program-date-wrapper #program-date-range-picker:focus,
#program-date-wrapper .input-group input.flatpickr-alt-input:focus {
	outline: none;
	box-shadow: none !important;
	border-color: transparent !important;
}

/* Multi-day range: hide nav arrows, full pill like other pages */
#program-date-wrapper.program-date-multi-day-search #btn-program-date-prev,
#program-date-wrapper.program-date-multi-day-search #btn-program-date-next {
	display: none !important;
}

#program-date-wrapper.program-date-multi-day-search .input-group > .flatpickr-wrapper {
	flex: 0 0 auto;
	min-width: 0;
}

#program-date-wrapper.program-date-multi-day-search .input-group input.flatpickr-alt-input {
	padding-left: 0.9rem;
	padding-right: 0.9rem;
}

.game-list-roller-chips-banner {
	background: #e0f2fe;
	border: 1px solid #7dd3fc;
	color: #0369a1;
}

.game-list-roller-chips-banner .btn-outline-secondary {
	border-color: #38bdf8;
	color: #0369a1;
}

.game-list-roller-chips-banner .btn-outline-secondary:hover {
	background: #bae6fd;
	border-color: #0ea5e9;
	color: #0c4a6e;
}

.breadcrumb1.flat a.breadcrumb-crumb-armed,
.breadcrumb1.flat a.breadcrumb-crumb-armed::after {
	background-color: var(--bs-primary) !important;
	color: #fff !important;
	font-weight: 600;
	border-color: #28a745 !important;
}

#btn-merge-settle-game-list.merge-settle-active {
	box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.35);
}

.daily-settle-checkbox-wrap,
.merge-settle-checkbox-wrap {
	display: none;
	align-items: center;
	justify-content: center;
	margin-right: 6px;
	margin-bottom: 0;
}

body.daily-settle-select-mode .daily-settle-checkbox-wrap {
	display: inline-flex;
}

body.merge-settle-mode .merge-settle-checkbox-wrap {
	display: inline-flex;
}

#game_list-tbl th.col-program-date,
#game_list-tbl td.col-program-date,
#game_list-tbl th.col-game-start,
#game_list-tbl td.col-game-start {
	text-align: left !important;
	width: 1%;
	white-space: nowrap;
	padding-left: 10px !important;
}

/* Data cells: tight right padding */
#game_list-tbl td.col-program-date,
#game_list-tbl td.col-game-start {
	padding-right: 6px !important;
}

/* Header: reserve space for DataTables sort arrows (default needs 26px) */
#game_list-tbl th.col-program-date,
#game_list-tbl th.col-game-start {
	padding-right: 26px !important;
}

#game_list-tbl .program-date-link {
	cursor: pointer;
	text-decoration: none !important;
}

#game_list-tbl .program-date-link:hover,
#game_list-tbl .program-date-link:focus {
