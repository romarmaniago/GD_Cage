					<script>
						// Pass translations to JavaScript - MUST be before game_list.js loads
						window.gamelistTranslations = {
							on_game: "<%= __('gamelist.on_game') %>",
							end_game: "<%= __('gamelist.end_game') %>",
							search: "<%= __('gamelist.search') %>",
							showing_entries: "<%= __('gamelist.showing_entries') %>",
							previous: "<%= __('gamelist.previous') %>",
							next: "<%= __('gamelist.next') %>",
							cash: "<%= __('gamelist.cash') %>",
							deposit: "<%= __('gamelist.deposit') %>",
							marker: "<%= __('gamelist.marker') %>"
						};
					</script>
					<script>
						$(document).ready(function () {
							function initializeDataTable() {
								if ($.fn.DataTable.isDataTable('#game_list-tbl')) {
									$('#game_list-tbl').DataTable().destroy();
								}

								const translations = window.gamelistTranslations || {};
								$('#game_list-tbl').DataTable({
									"ajax": {
										"url": "/game_list_data",
										"dataSrc": function (json) {
											console.log("Data received from server:", json);
											return json.data || []; // Default to empty array if no data
										}
									},
									"columns": [
										{ "data": "game_start_date" },
										{ "data": "game_type" },
										{ "data": "game_no" },
										{ "data": "acct_no" },
										{ "data": "buy_in" },
										{ "data": "chips_return" },
										{ "data": "win_loss" },
										{ "data": "real_rolling" },
										{ "data": "total_rolling" },
										{ "data": "game_rate" },
										{ "data": "commission" },
										{ "data": "add_chg", "defaultContent": "-" },
										{ "data": "total_settle", "defaultContent": "-" },
										{ "data": "game_end_date_time" },
										{ "data": "roller_chips" },
										{ "data": "history" }
									],
									"language": {
										"search": translations.search || "Search:",
										"info": translations.showing_entries || "Showing _START_ to _END_ of _TOTAL_ entries",
										"paginate": {
											"previous": translations.previous || "Previous",
											"next": translations.next || "Next"
										}
									},
									"drawCallback": function () {
										calculateTotal();
										var hasAccountSearch = ($('#input-account-search').val() || '').trim().length > 0;
										$('#game_list-tbl').toggleClass('account-search-only', !!hasAccountSearch);
									}
								});
							}


							initializeDataTable();

							// Set default "From" date to the 1st day of the current month
							var currentDate = new Date();
							var firstDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
							var today = new Date();

							// Function to format the date as "dd mmm yyyy" (e.g., 01 Sept 2024)
							var formatDate = function (date) {
								var day = ("0" + date.getDate()).slice(-2); // Add leading zero for day
								var monthNames = ["Jan,", "Feb,", "Mar,", "Apr,", "May,", "Jun,", "Jul,", "Aug,", "Sep,", "Oct,", "Nov,", "Dec,"];
								var month = monthNames[date.getMonth()]; // Get the month abbreviation
								var year = date.getFullYear(); // Get the full year
								return day + ' ' + month + ' ' + year; // Return the formatted date as "dd mmm yyyy"
							};

							// Set default values to date inputs
							$('#from-date').val(formatDate(firstDayOfMonth));
							$('#to-date').val(formatDate(today));

							// Custom filtering function which will filter data based on the "From" and "To" dates
							$.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
								// Get the values from the "From" and "To" date inputs
								var minDate = $('#from-date').val() ? new Date($('#from-date').val()) : null;
								var maxDate = $('#to-date').val() ? new Date($('#to-date').val()) : null;

								// Get the game start date from the table data (Column index for "GAME START")
								var gameStartDate = new Date(data[0]); // Assuming GAME START is the first column (index 0)

								// Get the game end date from the table data (Column index for "GAME END DATE & TIME")
								var gameEndDate = new Date(data[0]); // Assuming GAME END DATE & TIME is column 13

								// Strip the time portion of the date by setting time to midnight (for date-only comparison)
								if (minDate !== null) {
									minDate.setHours(0, 0, 0, 0); // Set minDate to midnight
								}
								if (maxDate !== null) {
									maxDate.setHours(23, 59, 59, 999); // Set maxDate to the end of the day
								}
								gameStartDate.setHours(0, 0, 0, 0); // Strip the time portion of the gameStartDate
								gameEndDate.setHours(0, 0, 0, 0); // Strip the time portion of the gameEndDate

								// Apply the date filtering logic for both GAME START and GAME END DATE
								if ((minDate === null && maxDate === null) || // No date filtering
									(minDate === null && (gameStartDate <= maxDate || gameEndDate <= maxDate)) || // Only max date is provided
									(minDate <= gameStartDate && maxDate === null) || // Only min date is provided
									(minDate <= gameStartDate && gameStartDate <= maxDate) || // Both dates are within range (GAME START)
									(minDate <= gameEndDate && gameEndDate <= maxDate)) { // Both dates are within range (GAME END)
									return true; // If within range or no date filter, include the row
								}
								return false; // Exclude the row if it doesn't match the filter
							});

							// Account Search is handled in game_list.js: when value is entered, table shows one row per account with totals (not each game)

							// Re-draw the DataTable whenever the date inputs change
							$('#from-date, #to-date').change(function () {
								$('#game_list-tbl').DataTable().draw();
							});

							// Re-draw when Account Search input changes
							$(document).on('keyup input', '#input-account-search', function () {
								if ($.fn.DataTable.isDataTable('#game_list-tbl')) {
									$('#game_list-tbl').DataTable().draw();
								}
							});

							// Trigger the initial draw to apply the default date filtering on page load
							$('#game_list-tbl').DataTable().draw();


							function calculateTotal() {
								var totalAmount = 0;
								var totalRolling = 0;
								var totalChipsReturn = 0;
								var totalWinLoss = 0;
								var totalRollerChips = 0;
								var totalRealRolling = 0;
								var totalCommission = 0;
								var totalAddChg = 0;
								var totalSettle = 0;

								var table = $('#game_list-tbl').DataTable();

								// Process only the rows on the current page
								table.rows({ page: 'current' }).every(function () {
									var data = this.data();
									// console.log("Processing object:", data);

									// Adjust these indices based on your columns configuration
									var amountIndex = 4; // "BUY-IN" is at index 4
									var rollingIndex = 8; // "TOTAL ROLLING" is at index 8
									var rollerChipsIndex = 14; // "ROLLER CHIPS" is at index 14
									var chipsReturnIndex = 5; // "CASH-OUT" is at index 5
									var winLossIndex = 6; // "WIN/LOSS" is at index 6
									var realRollingIndex = 7; // "REAL ROLLING" is at index 7
									var commissionIndex = 10; // "COMMISSION" is at index 10
									var addChgIndex = 11; // "ADD CHG" is at index 11
									var totalSettleIndex = 12; // "TOTAL SETTLE" is at index 12

									var amountValue = data[amountIndex] || '0';
									var rollingValue = data[rollingIndex] || '0';
									var rollerChipsValue = data[rollerChipsIndex] || '0';
									var chipsReturnValue = data[chipsReturnIndex] || '0';
									var realRollingValue = data[realRollingIndex] || '0';
									var commissionValue = data[commissionIndex] || '0';
									var addChgValue = data[addChgIndex] || '0';
									var totalSettleValue = data[totalSettleIndex] || '0';
									var winLossValue = data[winLossIndex] || '0';

									// Extract text content from HTML (handles buttons and plain text)
									// Create a temporary div to parse HTML and extract text
									var tempDiv = $('<div>').html(amountValue);
									var amountText = tempDiv.text().trim() || amountValue;
									
									tempDiv = $('<div>').html(rollerChipsValue);
									var rollerChipsText = tempDiv.text().trim() || rollerChipsValue;
									
									tempDiv = $('<div>').html(chipsReturnValue);
									var chipsReturnText = tempDiv.text().trim() || chipsReturnValue;
									
									tempDiv = $('<div>').html(realRollingValue);
									var realRollingText = tempDiv.text().trim() || realRollingValue;

									// Remove HTML tags and clean values
									var cleanedAmountValue = parseFloat(amountText.replace(/[^0-9.-]/g, '')) || 0;
									var cleanedRollingValue = parseFloat(rollingValue.replace(/[^0-9.-]/g, '')) || 0;
									var cleanedRollerChipsValue = parseFloat(rollerChipsText.replace(/[^0-9.-]/g, '')) || 0;
									var cleanedChipsReturnValue = parseFloat(chipsReturnText.replace(/[^0-9.-]/g, '')) || 0;
									var cleanedRealRollingValue = parseFloat(realRollingText.replace(/[^0-9.-]/g, '')) || 0;
									var cleanedCommissionValue = parseFloat(commissionValue.replace(/[^0-9.-]/g, '')) || 0;
									var cleanedAddChgValue = parseFloat(addChgValue.replace(/[^0-9.-]/g, '')) || 0;
									var cleanedTotalSettleValue = parseFloat(totalSettleValue.replace(/[^0-9.-]/g, '')) || 0;
									var cleanedWinLossValue = parseFloat(winLossValue.replace(/[^0-9.-]/g, '')) || 0;

									totalAmount += cleanedAmountValue;
									totalRolling += cleanedRollingValue;
									totalRollerChips += cleanedRollerChipsValue;
									totalChipsReturn += cleanedChipsReturnValue;
									totalRealRolling += cleanedRealRollingValue;
									totalCommission += cleanedCommissionValue;
									totalAddChg += cleanedAddChgValue;
									totalSettle += cleanedTotalSettleValue;
									totalWinLoss += cleanedWinLossValue;
								});

								// Format the totals
								var formattedAmount = totalAmount.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
								var formattedRolling = totalRolling.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
								var formattedRollerChips = totalRollerChips.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
								var formattedChipsReturn = totalChipsReturn.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
								var formattedRealRolling = totalRealRolling.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
								var formattedCommission = totalCommission.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
								var formattedAddChg = totalAddChg.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
								var formattedTotalSettle = totalSettle.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
								var formattedWinLoss = totalWinLoss.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });

								// Update the footer content for the current page's totals (removed peso sign)
								$('#game_list-tbl tfoot #GRAND_TOTAL_AMOUNT').text(formattedAmount);
								$('#game_list-tbl tfoot #GRAND_TOTAL_ROLLING').text(formattedRolling);
								$('#game_list-tbl tfoot #GRAND_ROLLER_CHIPS').text(formattedRollerChips);
								$('#game_list-tbl tfoot #GRAND_CHIPS_RETURN').text(formattedChipsReturn);
								$('#game_list-tbl tfoot #GRAND_REAL_ROLLING').text(formattedRealRolling);
								$('#game_list-tbl tfoot #GRAND_COMMISSION').text(formattedCommission);
								$('#game_list-tbl tfoot #GRAND_ADD_CHG').text(formattedAddChg);
								$('#game_list-tbl tfoot #GRAND_TOTAL_SETTLE').text(formattedTotalSettle);
								$('#game_list-tbl tfoot #GRAND_WIN_LOSS').text(formattedWinLoss);

								// Apply red font color if the total is negative
								applyNegativeStyle('#GRAND_TOTAL_AMOUNT', totalAmount);
								applyNegativeStyle('#GRAND_TOTAL_ROLLING', totalRolling);
								applyNegativeStyle('#GRAND_ROLLER_CHIPS', totalRollerChips);
								applyNegativeStyle('#GRAND_CHIPS_RETURN', totalChipsReturn);
								applyNegativeStyle('#GRAND_REAL_ROLLING', totalRealRolling);
								applyNegativeStyle('#GRAND_COMMISSION', totalCommission);
								applyNegativeStyle('#GRAND_ADD_CHG', totalAddChg);
								applyNegativeStyle('#GRAND_TOTAL_SETTLE', totalSettle);
								applyNegativeStyle('#GRAND_WIN_LOSS', totalWinLoss);
							}

							// Attach events to recalculate totals on search and draw
							$('#game_list-tbl').on('search.dt draw.dt', function () {
								// console.log("Search or draw event triggered");
								calculateTotal();
							});
						});
						function applyNegativeStyle(selector, value) {
							var element = $('#game_list-tbl tfoot ' + selector);
							if (value < 0) {
								element.css('color', 'red');
							} else {
								element.css('color', ''); // Reset to default color
							}
						}


						const permissions = parseInt($('#user-role').data('permissions'));

						if (permissions === 2) {
							$('.wrap .button').prop('disabled', true);
						} else {
							$('.wrap .button').prop('disabled', false);
						}
					</script>

