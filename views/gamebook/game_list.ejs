				<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
				<script>
					document.addEventListener('DOMContentLoaded', () => {
						const wrapper = document.querySelector('#settlement-date-wrapper .input-group');
						const todayStr = wrapper ? wrapper.getAttribute('data-today') : '';
						const defaultDate = wrapper ? wrapper.getAttribute('data-default-settlement-date') : '';
						const maxPickerDate = wrapper ? wrapper.getAttribute('data-max-settlement-date') : (defaultDate || todayStr);
						window.selectedSettlementDate = defaultDate || todayStr || '';
						var settledDates = [];
						try {
							var raw = wrapper ? wrapper.getAttribute('data-settled-dates') : '';
							settledDates = (raw ? JSON.parse(raw) : []).map(function (d) { return String(d).slice(0, 10); });
							window.settledDatesForMonth = settledDates;
						} catch (e) {}
						function dayDateStr(dayElem) {
							if (!dayElem || !dayElem.dateObj) return '';
							var d = dayElem.dateObj;
							return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
						}
						const pickerEl = document.getElementById('settlement-date-picker');
						if (pickerEl && typeof flatpickr !== 'undefined') {
							// Calculate earliest settlement date (when settlements started)
							var earliestSettlementDate = null;
							if (settledDates.length > 0) {
								var sortedDates = settledDates.slice().sort();
								earliestSettlementDate = sortedDates[0];
							} else {
								// If no settled dates, allow navigation back to January 1 of previous year
								var now = new Date();
								var pad = function(n) { return String(n).padStart(2, '0'); };
								var earliestAllowed = new Date(now.getFullYear() - 1, 0, 1);
								earliestSettlementDate = earliestAllowed.getFullYear() + '-' + pad(earliestAllowed.getMonth() + 1) + '-' + pad(earliestAllowed.getDate());
							}
							
							flatpickr(pickerEl, {
								dateFormat: 'Y-m-d',
								altInput: true,
								altFormat: 'F d, Y',
								defaultDate: defaultDate || todayStr,
								minDate: earliestSettlementDate,
								maxDate: maxPickerDate || defaultDate || todayStr,
								allowInput: false,
								onDayCreate: function (dayElem) {
									var dStr = dayDateStr(dayElem);
									if (dStr && settledDates.indexOf(dStr) !== -1) dayElem.classList.add('settled-day');
								},
								onOpen: function (selectedDates, dateStr, instance) {
									setTimeout(function () {
										if (!instance.calendarContainer) return;
										var days = instance.calendarContainer.querySelectorAll('.flatpickr-day');
										days.forEach(function (el) {
											el.classList.remove('settled-day');
											var dStr = dayDateStr(el);
											if (dStr && settledDates.indexOf(dStr) !== -1) el.classList.add('settled-day');
										});
									}, 0);
								},
								onChange: function (selectedDates, dateStr) {
									window.selectedSettlementDate = dateStr || '';
									if (typeof window.updateNavigationButtons === 'function') window.updateNavigationButtons();
									if (typeof window.updateSettleButtonState === 'function') window.updateSettleButtonState();
									if (typeof window.reloadGameListBySettlementDate === 'function') window.reloadGameListBySettlementDate();
								},
								onMonthChange: function (selectedDates, dateStr, instance) {
									setTimeout(function () {
										if (!instance.calendarContainer) return;
										var days = instance.calendarContainer.querySelectorAll('.flatpickr-day');
										days.forEach(function (el) {
											el.classList.remove('settled-day');
											var dStr = dayDateStr(el);
											if (dStr && settledDates.indexOf(dStr) !== -1) el.classList.add('settled-day');
										});
									}, 0);
								}
							});
						}
					});
				</script>


