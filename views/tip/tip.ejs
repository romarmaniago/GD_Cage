<%- include('../partials/header') %>

<%- include('../partials/loader') %>

<%- include('../partials/sidebar') %>

<%- include('../partials/topbar') %>



<div class="container-fluid content-inner py-0">

  <div class="row">

    <div class="col-sm-12">

      <div class="card">

        <div id="user-role" data-permissions="<%= permissions %>"></div>

        <div class="card-header d-flex justify-content-between align-items-center">

          <h3 class="card-title">

            <div class="breadcrumb1 flat">

              <a href="/dashboard"><span class="fa fa-home"></span></a>

              <a href="/tip" class="active"><%= __('sidebar.tip') %></a>

            </div>

          </h3>

        </div>

        <div class="card-body tip-page">

          <div class="tip-settlement-bar mb-3" id="tip-settlement-bar">
            <div class="tip-settlement-info">
              <div class="tip-settlement-balance">
                <%= __('tip.available_balance') %>:
                <strong id="tip-roller-available-balance">0</strong>
              </div>
            </div>
            <div class="tip-settlement-actions">
              <button type="button" class="btn btn-success btn-sm" id="btn-tip-in-open"><%= __('tip.in') %></button>
              <button type="button" class="btn btn-primary btn-sm" id="btn-tip-settlement-open"><%= __('tip.settle') %></button>
            </div>
          </div>

          <div class="marker-balance-dt-wrap marker-balance-card table-responsive">
          <table id="tip-tbl" class="table marker-balance-tbl w-100 mb-0">

            <thead>

              <tr>

                <th rowspan="2"><%= __('tip.program_date') %></th>

                <th rowspan="2"><%= __('tip.date_time') %></th>

                <th rowspan="2"><%= __('tip.account') %></th>

                <th rowspan="2"><%= __('tip.guest') %></th>

                <th rowspan="2"><%= __('tip.game_no') %></th>

                <th rowspan="2"><%= __('tip.remarks') %></th>

                <th colspan="4" class="tip-group-head tip-group-head-roller"><%= __('tip.roller') %></th>

                <th colspan="4" class="tip-group-head tip-group-head-dealer"><%= __('tip.dealer') %></th>

              </tr>

              <tr>

                <th class="tip-col tip-col-roller"><%= __('tip.transaction') %></th>

                <th class="tip-col tip-col-roller"><%= __('tip.amount') %></th>

                <th class="tip-col tip-col-roller"><%= __('tip.status') %></th>

                <th class="tip-col tip-col-roller"><%= __('tip.name') %></th>

                <th class="tip-col tip-col-dealer"><%= __('tip.transaction') %></th>

                <th class="tip-col tip-col-dealer"><%= __('tip.amount') %></th>

                <th class="tip-col tip-col-dealer"><%= __('tip.status') %></th>

                <th class="tip-col tip-col-dealer"><%= __('tip.name') %></th>

              </tr>

            </thead>

            <tbody></tbody>
            <tfoot>
              <tr>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th><%= __('tip.total') || 'TOTAL' %></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th><%= __('tip.total') || 'TOTAL' %></th>
                <th></th>
                <th></th>
                <th></th>
              </tr>
            </tfoot>
          </table>
          </div>

        </div>

      </div>

    </div>

  </div>

</div>



<%- include('../modals/tip/tip_in') %>
<%- include('../modals/tip/tip_settlement') %>

<%- include ('../partials/permission_view_only_script') %>

<%- include('../partials/footer') %>



<script type="application/json" id="tip-in-i18n"><%- JSON.stringify({
  invalidAmount: __('tip.in_invalid_amount'),
  missingStatus: __('tip.settlement_missing_status'),
  missingName: __('tip.settlement_missing_name'),
  missingProgramDate: __('tip.missing_program_date'),
  saved: __('tip.in_saved')
}) %></script>
<script type="application/json" id="tip-settlement-i18n"><%- JSON.stringify({
  invalidAmount: __('tip.settlement_invalid_amount'),
  exceedsBalance: __('tip.settlement_exceeds_balance'),
  missingStatus: __('tip.settlement_missing_status'),
  missingName: __('tip.settlement_missing_name'),
  missingProgramDate: __('tip.missing_program_date'),
  saved: __('tip.settlement_saved')
}) %></script>
<script src="/assets/js/functions/credit_guarantor_autocomplete.js"></script>
<script src="/assets/js/functions/tip.js"></script>



<style>

  .card-body {
    overflow-x: auto;
  }

  /* Cream/light-gray theme */
  .card {
    background: linear-gradient(180deg, #f6f3ec 0%, #efe9db 100%) !important;
    border: 1px solid rgba(200, 162, 76, 0.4) !important;
  }
  .card-header {
    background: linear-gradient(180deg, #f6f3ec 0%, #efe9db 100%) !important;
    border-bottom: 1px solid rgba(200, 162, 76, 0.25) !important;
  }
  .marker-balance-card {
    background: linear-gradient(180deg, #fafbfc 0%, #ffffff 48px) !important;
    border: 1px solid rgba(15, 23, 42, 0.08) !important;
    border-radius: 12px !important;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04) !important;
    padding: 0 !important;
  }

  .tip-settlement-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 0.5rem;
    background: linear-gradient(180deg, #fafbfc 0%, #ffffff 100%);
  }

  .tip-settlement-balance {
    font-weight: 600;
    color: #555;
    font-size: 1.05rem;
  }

  .tip-settlement-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  #modal-tip-settlement .form-control.is-invalid {
    border-color: #dc3545;
  }

  #modal-tip-in .select2-container .select2-selection--single {
    height: calc(1.5em + 0.75rem + 6px);
  }

  #modal-tip-in .select2-container .select2-search--inline .select2-search__field {
    margin-top: 0;
    margin: 0.25rem 0.25rem 0.25rem 0;
    height: 1.375rem;
    line-height: 1.375rem;
  }

  #modal-tip-in .select2-container--default .select2-selection--single {
    border-color: #eee;
  }

  #modal-tip-in .select2-container--default .select2-selection--single .select2-selection__rendered {
    display: flex;
    align-items: center;
    padding-left: 0.75rem;
    height: calc(1.5em + 0.75rem + 6px);
    line-height: 1.5;
  }

  #modal-tip-in .select2-container--default .select2-selection--single .select2-selection__arrow {
    height: calc(1.5em + 0.75rem + 6px);
  }

  #modal-tip-in .select2-container--default .select2-selection--single .select2-selection__placeholder {
    color: #8A92A6;
  }

  #modal-tip-in #tip-in-modal-guest + .select2-container .select2-selection--single,
  #modal-tip-in #tip-in-modal-account + .select2-container .select2-selection--single {
    height: calc(1.5em + 0.75rem + 6px);
  }

  .tip-page table.dataTable {
    border-collapse: collapse !important;
    border-spacing: 0 !important;
  }
  .tip-page table thead tr,
  .tip-page table tfoot tr {
    background-color: #f5f5f5 !important;
  }
  .tip-page table thead th,
  .tip-page table tfoot th {
    background: #f5f5f5 !important;
    background-color: #f5f5f5 !important;
    border-left: 0 !important;
    border-right: 0 !important;
    border-top: 0 !important;
    box-shadow: none !important;
  }
  .tip-page table.dataTable thead > tr > th.sorting,
  .tip-page table.dataTable thead > tr > th.sorting_asc,
  .tip-page table.dataTable thead > tr > th.sorting_desc,
  .tip-page table.dataTable thead > tr > th.sorting_disabled {
    background: #f5f5f5 !important;
    background-color: #f5f5f5 !important;
  }

  #tip-tbl {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
    border: 1px solid #e0e0e0 !important;
  }

  #tip-tbl thead th {
    background: #f5f5f5 !important;
    background-color: #f5f5f5 !important;
    color: #555 !important;
    font-weight: 600;
    padding: 12px 15px;
    border: none;
    border-bottom: 1px solid #e0e0e0 !important;
    text-align: center;
    vertical-align: middle;
  }

  #tip-tbl thead .tip-group-head {
    text-align: center !important;
    font-weight: 600;
    color: #555 !important;
    background: #f5f5f5 !important;
    border-bottom: 1px solid #ccc;
  }

  #tip-tbl thead .tip-group-head-dealer {
    text-align: center !important;
    padding-left: 2.5rem;
    padding-right: 2.5rem;
  }

  #tip-tbl thead .tip-col-roller,
  #tip-tbl thead .tip-col-dealer {
    color: #555 !important;
    background: #f5f5f5 !important;
  }

  #tip-tbl tbody tr:nth-child(even) td {
    background-color: #f4f1ea !important;
  }
  #tip-tbl tbody tr:nth-child(odd) td {
    background-color: #fff !important;
  }

  #tip-tbl thead tr:nth-child(2) th.tip-col-roller:nth-child(2),
  #tip-tbl thead tr:nth-child(2) th.tip-col-dealer:nth-child(6),
  #tip-tbl tbody td.tip-col-roller:nth-child(8),
  #tip-tbl tbody td.tip-col-dealer:nth-child(12),
  #tip-tbl tfoot th:nth-child(8),
  #tip-tbl tfoot th:nth-child(12) {
    text-align: right;
  }

  #tip-tbl tfoot .tip-roller-total,
  #tip-tbl tfoot .tip-dealer-total {
    color: #555;
    font-weight: 600;
  }

  #tip-tbl tfoot th {
    padding: 10px 15px;
    font-weight: 600;
    background: #f5f5f5 !important;
    color: #555 !important;
    border-top: 1px solid #e0e0e0 !important;
    border-bottom: 1px solid #e0e0e0 !important;
    text-align: center;
    vertical-align: middle;
  }

  #tip-tbl tbody tr {
    border-bottom: 1px solid #eee;
  }

  #tip-tbl td {
    padding: 12px 15px;
    color: #666;
    vertical-align: middle;
    text-align: center;
  }

  #tip-tbl td.remarks-editor-td {
    text-align: left;
    max-width: 220px;
  }

  #tip-tbl td.remarks-editor-td .remarks-editor-clickable {
    cursor: pointer;
  }

  #tip-tbl td.remarks-editor-td:hover .remarks-editor-clickable {
    background: #f6f3ec;
    border-radius: 4px;
  }

  #tip-tbl tbody tr:hover,
  #tip-tbl tbody tr:hover td {
    background-color: #f6f3ec !important;
  }

  #tip-tbl .tip-amount-negative {
    color: #dc3545;
    font-weight: 600;
  }

  #tip-tbl tfoot .tip-amount {
    color: #198754;
    font-weight: 600;
  }

  #tip-tbl tfoot .tip-amount-negative {
    color: #dc3545;
    font-weight: 600;
  }

  .dataTables_length label {
    font-size: 0;
  }

  .dataTables_length select {
    font-size: 12px;
  }

  .dataTables_wrapper .row {
    margin-bottom: 15px;
    font-size: 12px;
  }

  @media (max-width: 768px) {
    #tip-tbl {
      font-size: 10px;
    }

    #tip-tbl th,
    #tip-tbl td {
      padding: 5px;
    }

    .dataTables_wrapper .row {
      font-size: 10px;
    }
  }

</style>

