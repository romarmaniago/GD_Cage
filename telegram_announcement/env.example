# --- MTProto USER (Pyrogram) para sa guest broadcast mula sa Cage UI ---
# Pwede dito O sa project root .env (GD_Cage/.env) — parehong babasahin ng scripts/send_broadcast_user.py
# Kumuha sa https://my.telegram.org (API development tools)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# One-time: .venv\Scripts\python scripts\export_string_session.py
# Pagkatapos i-paste ang string (USER account, hindi bot):
TELEGRAM_STRING_SESSION=
#
# Panatilihin ang broadcast_mtproto.session sa folder na ito kung kailangan mong mag-broadcast gamit ang numeric
# chat/user ID. String-only = walang persisted peer cache sa bawat Node/Python run.

# HINDI kailangan sa .env kung guest broadcast lang sa Cage UI — ang routes/broadcast.js ay kumukuha na
# ng GUEST TELEGRAM_API sa DB at ipinapasa bilang guest_bot_token sa Python (walang duplicate token dito).
# Ilagay lang TELEGRAM_GUEST_BOT_TOKEN kung tatakbo ka ng send_broadcast_user.py nang direkta (walang Node).
# TELEGRAM_GUEST_BOT_TOKEN=

# --- Opsiyonal: Streamlit tool (bot) — hiwalay sa broadcast ---
# TELEGRAM_BOT_TOKEN=...
# GUEST_CHAT_IDS_FILE=guests.txt
