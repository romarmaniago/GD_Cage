DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gdcage
DB_PORT=3306
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SESSION_SECRET=your_secret_key
PORT=4000

SCANNER_API_KEY=your-scanner-api-key

# Vertex AI (passport OCR) — service account JSON via Application Default Credentials
# Note: Vertex uses Gemini *models*, but it does NOT use a GEMINI_API_KEY (that's for the direct Gemini API).
GCP_PROJECT_ID=passport-scanner-v1
GCP_LOCATION=us-central1
# Publisher model id (e.g. gemini-2.5-flash, gemini-2.0-flash-001)
GCP_VERTEX_MODEL=gemini-2.5-flash
# Relative to GD_Cage cwd when you run `node app`, or use a full Windows path
GOOGLE_APPLICATION_CREDENTIALS=./config/passport-scanner-v1-1aae56e7c08c.json
